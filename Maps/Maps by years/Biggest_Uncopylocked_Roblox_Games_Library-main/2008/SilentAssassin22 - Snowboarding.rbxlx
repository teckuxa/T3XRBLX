					<string name="Source">while true do
script.Parent.Name = &quot;Welcome. This is the list of items currently in the Lost and Found:&quot;
wait(6)
script.Parent.Name = &quot;1. A custom snowboard.&quot;
wait(3)
script.Parent.Name = &quot;2. A backpack.&quot;
wait(3)
script.Parent.Name = &quot;3. An identification card.&quot;
wait(3)
script.Parent.Name = &quot;4. A wallet.&quot;
wait(3)
script.Parent.Name = &quot;5. A basket full of food.&quot;
wait(3)
script.Parent.Name = &quot;That&apos;s everything. Have a nice day!&quot;
wait(5)
script.Parent.Name = &quot; &quot;
wait(15)
end
</string>
