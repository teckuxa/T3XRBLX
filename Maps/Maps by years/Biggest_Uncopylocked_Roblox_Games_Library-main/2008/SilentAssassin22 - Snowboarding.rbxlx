				<Item class="Script" referent="RBX4319">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<string name="Source">off = false

function tuch(h)
if off == false then
off = true
	if h.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil then
	c = script.Parent.Parent.Tools:getChildren()
	for i = 1, #c do
		if c[i].className == &quot;HopperBin&quot; or &quot;Tool&quot; then
		c[i]:clone().Parent = game.Players:findFirstChild(h.Parent.Name).Backpack
		wait(1)
		off = false
		end
	end
	end
end
end

script.Parent.touched:connect(tuch)</string>
