				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<string name="Source">function onTouched(part)
	local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if h~=nil then
		h.Health = h.Health +10 ---Change This to whatever damage you want it to cause.It can also add health by using the + sign.
	end
end

script.Parent.Touched:connect(onTouched)
</string>
