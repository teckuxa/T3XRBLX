				<Item class="Script" referent="RBX6332">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Hat</string>
						<string name="Source">debounce = true

function onTouched(hit)
	if (hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil and debounce == true) then
		local g = script.Parent.Parent:findFirstChild(&quot;Battle Droid&quot;)
		debounce = false
		wait(0.2)
		h = Instance.new(&quot;Hat&quot;)
		p = Instance.new(&quot;Part&quot;)
		h.Name = &quot;Head&quot;
		p.Parent = h
		p.Position = hit.Parent:findFirstChild(&quot;Head&quot;).Position
		p.Name = &quot;Head&quot; 
		p.formFactor = 0
		p.Size = Vector3.new(2, 1, 1) 
		p.BottomSurface = 0 
		p.TopSurface = 0 
		p.Locked = true 
		p.BrickColor = BrickColor.new(5)
		g.HAT.Mesh:clone().Parent = p
		h.Parent = hit.Parent
		h.AttachmentPos = Vector3.new(0, -0.4, 0)
		wait(0.8)
		debounce = true
	end
end

script.Parent.Touched:connect(onTouched)</string>
