								<Properties>
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">Reload</string>
									<string name="Source">print(&quot;Ammo Clip Loaded&quot;)

while true do
	if (script.Parent.Value == 0) and (script.Parent.Parent.Ammo.Value &gt;= 3) then
		wait(4)
		script.Parent.Value = 3
		script.Parent.Parent.Ammo.Value = script.Parent.Parent.Ammo.Value - 3
	end
	if (script.Parent.Value == 0) and (script.Parent.Parent.Ammo.Value &lt;= 3) then
		wait(4)
		script.Parent.Value = script.Parent.Parent.Ammo.Value
		script.Parent.Parent.Ammo.Value = 0
	end
	wait(0)
end
