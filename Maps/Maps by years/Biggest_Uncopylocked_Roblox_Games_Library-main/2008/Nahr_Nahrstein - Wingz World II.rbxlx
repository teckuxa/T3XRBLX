							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">WeldScript</string>
							<string name="Source">local w1 = Instance.new(&quot;Weld&quot;)
	w1.Parent = script.Parent.Handle -- This is the original Handle.
	w1.Part0 = w1.Parent
	w1.Part1 = script.Parent.Handle2 -- Change PARTNAME to your second part&apos;s name.
	w1.C1 = CFrame.fromEulerAnglesXYZ(0, 0, 0) * CFrame.new(0, -0.5, 0.6)
	
	local w2 = Instance.new(&quot;Weld&quot;)
	w2.Parent = script.Parent.Handle
	w2.Part0 = w1.Parent
	w2.Part1 = script.Parent.Handle3 -- Change to the third part&apos;s name.
	w2.C1 = CFrame.fromEulerAnglesXYZ(0, 0, 0) * CFrame.new(0, -0.1, 1)

	local w3 = Instance.new(&quot;Weld&quot;)
	w3.Parent = script.Parent.Handle
	w3.Part0 = w1.Parent
	w3.Part1 = script.Parent.Handle4 -- Change to the third part&apos;s name.
	w3.C1 = CFrame.fromEulerAnglesXYZ(6.2, 0, 0) * CFrame.new(0, 0.2, 1)

	local w4 = Instance.new(&quot;Weld&quot;)
	w4.Parent = script.Parent.Handle
	w4.Part0 = w1.Parent
	w4.Part1 = script.Parent.Handle5 -- Change to the third part&apos;s name.
	w4.C1 = CFrame.fromEulerAnglesXYZ(0, 0, 9.4) * CFrame.new(0, -0.2,-1.4)

	local w5 = Instance.new(&quot;Weld&quot;)
	w5.Parent = script.Parent.Handle
	w5.Part0 = w1.Parent
	w5.Part1 = script.Parent.Handle6 -- Change to the third part&apos;s name.
	w5.C1 = CFrame.fromEulerAnglesXYZ(4.7, 0, 0) * CFrame.new(0, -0.6,1.2)

	local w6 = Instance.new(&quot;Weld&quot;)
	w6.Parent = script.Parent.Handle
	w6.Part0 = w1.Parent
	w6.Part1 = script.Parent.Handle7 -- Change to the third part&apos;s name.
	w6.C1 = CFrame.fromEulerAnglesXYZ(0, 0, 0) * CFrame.new(0, -1,0.6)
	
	local w7 = Instance.new(&quot;Weld&quot;)
	w7.Parent = script.Parent.Handle
	w7.Part0 = w1.Parent
	w7.Part1 = script.Parent.Handle8 -- Change to the third part&apos;s name.
	w7.C1 = CFrame.fromEulerAnglesXYZ(0, 0,3.5) * CFrame.new(0.3, 0.2, 2.5)
	
	local w8 = Instance.new(&quot;Weld&quot;)
	w8.Parent = script.Parent.Handle
	w8.Part0 = w1.Parent
	w8.Part1 = script.Parent.Handle9 -- Change to the third part&apos;s name.
	w8.C1 = CFrame.fromEulerAnglesXYZ(0, 0,5.9) * CFrame.new(-0.3, 0.2, 2.5)

	local w9 = Instance.new(&quot;Weld&quot;)
	w9.Parent = script.Parent.Handle
	w9.Part0 = w1.Parent
	w9.Part1 = script.Parent.Handle10 -- Change to the third part&apos;s name.
	w9.C1 = CFrame.fromEulerAnglesXYZ(4.7, 0, 0) * CFrame.new(0, -1.3,0.6)

	local w10 = Instance.new(&quot;Weld&quot;)
	w10.Parent = script.Parent.Handle
	w10.Part0 = w1.Parent
	w10.Part1 = script.Parent.Handle11 -- Change to the third part&apos;s name.
	w10.C1 = CFrame.fromEulerAnglesXYZ(0, 0, 0) * CFrame.new(0, 0.1,0.6)</string>
