							<Item class="Sound" referent="RBX8070">
								<Properties>
									<bool name="Looped">false</bool>
									<string name="Name">GunSound</string>
									<float name="Pitch">1</float>
									<int name="PlayCount">47</int>
									<bool name="PlayOnRemove">false</bool>
									<Content name="SoundId"><url>rbxasset://sounds\Rocket shot.wav</url></Content>
									<float name="Volume">0.200000003</float>
									<bool name="archivable">true</bool>
								</Properties>
							</Item>
							<Item class="Script" referent="RBX8071">
								<Properties>
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">FireGun</string>
									<string name="Source">local switch = script.Parent
local gunBarrelOne = script.Parent.Parent.GunBarrel.One

local debounce = false
local gunOne = true

local cannonBall = Instance.new(&quot;Part&quot;)
cannonBall.Size = Vector3.new(2,2,2)
cannonBall.BrickColor = BrickColor.new(199) -- red
cannonBall.Shape = 0
cannonBall.BottomSurface = 0
cannonBall.TopSurface = 0
cannonBall.Name = &quot;Cannon Shot&quot;
cannonBall.Elasticity = .1
cannonBall.Reflectance = .05
cannonBall.Friction = 1
cannonBall.CanCollide = false

function getPlayer(humanoid)
	-- find the owning player of a humanoid.
	local players = game.Players:children()
	for i = 1, #players do
		if players[i].Character ~= nil then
			if players[i].Character.Humanoid == humanoid then return players[i] end
		end
	end
	return nil
end

function fire(player)

	local sound = script.Parent:findFirstChild(&quot;GunSound&quot;)
	if sound == nil then
		sound = Instance.new(&quot;Sound&quot;)
		sound.Name = &quot;GunSound&quot;
		sound.SoundId = &quot;rbxasset://sounds\\Rocket shot.wav&quot;
		sound.Volume = 1
		sound.Parent = script.Parent
	end
	sound:play()



	
	local missile = Instance.new(&quot;Part&quot;)


	if gunOne == true then
		barrel = gunBarrelOne
		gunOne = false

	end
	

	local spawnPos = barrel.CFrame * Vector3.new(6, 0, 0)

	local dx = math.random(-10,10)
	local dy = math.random(-10,10)
	local dz = math.random(-50,-30)
	local mag = math.random(1000,1100)

	local v = barrel.CFrame:vectorToWorldSpace(Vector3.new(mag + dx,dy,dz))
	
	local missile = cannonBall:clone()

	missile.Position = spawnPos
	missile.Velocity = v


	
	local new_script = script.Parent.CannonBall:clone()
	new_script.Disabled = false
	new_script.Parent = missile

	local creator_tag = Instance.new(&quot;ObjectValue&quot;)
	creator_tag.Value = player
	creator_tag.Name = &quot;creator&quot;
	creator_tag.Parent = missile
	


	missile.Parent = game.Workspace

end

function clicked()
                if debounce == false then
		debounce = true
		switch.BrickColor = BrickColor.new(21)
		-- let slip the dogs of war
		fire(player) --fire the cannonball
                script.Parent.Parent.Cannon.CannonBarrel.Main.Reflectance = 0.1
                wait(0.1)
                script.Parent.Parent.Cannon.CannonBarrel.Main.Reflectance = 0.2
                wait(0.1)
                script.Parent.Parent.Cannon.CannonBarrel.Main.Reflectance = 0.3
                wait(0.1)
                script.Parent.Parent.Cannon.CannonBarrel.Main.Reflectance = 0.4
                wait(0.1)
                script.Parent.Parent.Cannon.CannonBarrel.Main.Reflectance = 0.5
                wait(0.1)
                script.Parent.Parent.Cannon.CannonBarrel.Main.Reflectance = 0.6
                wait(0.1)
                script.Parent.Parent.Cannon.CannonBarrel.Main.Reflectance = 0.7
                wait(0.1)
                script.Parent.Parent.Cannon.CannonBarrel.Main.Reflectance = 0.8
                wait(0.1)
                script.Parent.Parent.Cannon.CannonBarrel.Main.Reflectance = 0.9
                wait(0.1)
                script.Parent.Parent.Cannon.CannonBarrel.Main.Reflectance = 1
                wait(0.1)
                script.Parent.Parent.Cannon.CannonBarrel.Main.Reflectance = 0.9
                wait(0.1)
                script.Parent.Parent.Cannon.CannonBarrel.Main.Reflectance = 0.8
                wait(0.1)
                script.Parent.Parent.Cannon.CannonBarrel.Main.Reflectance = 0.7
                wait(0.1)
                script.Parent.Parent.Cannon.CannonBarrel.Main.Reflectance = 0.6
                wait(0.1)
