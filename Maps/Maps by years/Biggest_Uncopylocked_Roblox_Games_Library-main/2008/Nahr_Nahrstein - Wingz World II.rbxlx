				<Item class="Script" referent="RBX5702">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<string name="Source">local bounce = 0

while true do
	if bounce == 0 then
		script.Parent.TopParamB = .03
		wait(.5)
		script.Parent.TopParamB = -.03
		wait(1)
		bounce = 1
	end
	if bounce == 1 then
		script.Parent.TopParamB = .03
		wait(1)
		script.Parent.TopParamB = -.03
		wait(1)
	end
end

</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
