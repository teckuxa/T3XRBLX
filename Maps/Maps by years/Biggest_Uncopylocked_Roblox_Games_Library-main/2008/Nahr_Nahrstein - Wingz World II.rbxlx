w3.Part0 = w3.Parent


w3.Part1 = script.Parent.Handle4


w3.C1 = CFrame.new(-0, 0.8, 0.2)





local w4 = Instance.new(&quot;Weld&quot;)


w4.Parent = script.Parent.Handle


w4.Part0 = w4.Parent


w4.Part1 = script.Parent.Handle5


w4.C1 = CFrame.new(-0, 1.4, 0.2)


</string>
