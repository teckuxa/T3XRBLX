				<string name="Source">model = game.Workspace.cessnagrandcaravan -- First you change &quot;obbycourse&quot; to whatever model you want to regen&quot; (It can&apos;t have spaces) 
backup = model:clone() 

function onChatted(msg, recipient, speaker) 

local source = string.lower(speaker.Name) 
msg = string.lower(msg) 

if (msg == &quot;caravan&quot;) then -- change &quot;regen&quot; to what ever you want to say to regenerate a model. 
model:remove() 
model = backup:clone() 
model.Parent = game.Workspace 
model:makeJoints() 
end 

end 

