							<string name="Name">ShellFunction</string>
							<string name="Source">local shell = script.Parent
local debounce = false
print(&quot;Shell Loaded&quot;)

function onTouch(hit)
	if (hit.CanCollide == true) and (hit.Name ~= shell.Name) and (debounce == false) then
		debounce = true
		shell.Anchored = false
		shell.CanCollide = true
		connection:disconnect()
	end
end

connection = shell.Touched:connect(onTouch)
