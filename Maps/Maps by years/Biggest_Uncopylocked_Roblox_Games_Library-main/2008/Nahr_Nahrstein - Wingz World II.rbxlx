						<string name="Name">FaceRemover</string>
						<string name="Source">debounce = true

function onTouched(hit)
	if (hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil and debounce == true) then
		debounce = false
		if (hit.Parent.Head.face ~= nil) and (hit.Parent.Head.Mesh ~= nil)  then
			hit.Parent.Head.face:remove()
			hit.Parent.Head.Mesh:remove()
		end
		wait(1)
		debounce = true
	end
end

script.Parent.Touched:connect(onTouched)</string>
