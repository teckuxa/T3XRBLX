			<Item class="Script" referent="RBX822">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<string name="Source">--Robloxian radar script by chess123mate -- Copyright &#169; 2008
--FEEL FREE TO DISTRIBUTE THIS CODE, BUT DO NOT CLAIM IT TO BE YOURS! Thanks
--NOTE: Much of this script is customizable/editable. Read carefully!
--**IMPORTANT** You MUST add a model named &quot;RadarM&quot; if one didn&apos;t come with it! You can change the name of
--- the model needed by modifying the &quot;folder&quot; variable. The folder is not generated, you must provide it.

frequency=0.2 --how often to update. Decrease for better quality, increase to reduce lag.
searchInPeople=true --editable; search for &quot;name&quot; in the characters of players?
search=game.Workspace --editable, put &quot;nil&quot; if you only want to search in the people. Where do you want to search for &quot;name&quot;?
folder=game.Workspace.RadarM --where all the radar blips are put. THIS SHOULD BE A UNIQUE FOLDER/MODEL!
name={&quot;*&quot;, &quot;Plane&quot;, &quot;Helicopter&quot;} --editable. &quot;*&quot;==players.
color={1, BrickColor.new(&quot;Bright yellow&quot;), BrickColor.new(&quot;Black&quot;)} --0 == team colour, 1 == colour of &quot;find&quot; brick.
--NOTE: Team colour never updates, 1 does, but may create a slight lag increase [won&apos;t likely notice it though]
transparency={0,0,0} --more parallel tables; what should the transparency or reflectance be for that object?
reflectance={0,0,0}
humanoid={true, false, false} --what to use humanoids for.
includeHealth={true, false, false} --if true, will search for a humanoid and duplicate its health.
allowDeleteEverything=true
--!!!!!!!!!!!!!!!!!!WARNING!!!!!!!!!!!!!!!!!!!--
--If you make &quot;allowDeleteEverything&quot; == true, MAKE SURE THE FOLDER IS NOT THE WORKSPACE!
--folder MUST equal a special radar folder that has absolutely nothing in it! ex. game.Workspace.MyRadarFolder
--NOTE: Unless you script your own scripting to remove excessive bricks, radar bricks with humanoids will
--not be deleted automatically. That is why you should use allowDeleteEverything if you have humanoid radars.
find={&quot;Torso&quot;, &quot;Brick&quot;, &quot;Brick&quot;} --the name of the actual BRICK to search for to read position.
--If NAME isn&apos;t a model, simply put &quot;&quot; in for find. If you don&apos;t have a brick in particular, &quot;*&quot; uses the first brick the
---program finds.
--NOTE: name + color + find tables MUST have the same number of objects in each.
brick=Instance.new(&quot;Part&quot;) --modify &quot;brick&quot; in any way you like (unless I say so otherwise)
brick.Reflectance=0.1
brick.formFactor=0
brick.Size=Vector3.new(1,1,1)
brick.Name=&quot;RadarBrick&quot; --MAKE SURE YOU AREN&apos;T SEARCHING FOR SOMETHING WITH THE SAME NAME AS THIS!!!
brick.Anchored=true --leave the same
brick.CanCollide=false --leave the same

m=Instance.new(&quot;SpecialMesh&quot;)--the mesh; can also modify it
m.MeshType=3
m.Scale=Vector3.new(0.5,0.5,0.5)
m.Parent=brick

worldCenter=Vector3.new(8601.5,0,-501.5) --editable; center of the world (where the center of the scannning area is)
--worldCenter=script.Parent.Position --see line above
--another method: &quot;worldCenter=script.Parent.Position&quot;
--the y coordinate of World center is actually the bottom of the scanning area.
worldWidth=10240 --x coordinate
worldHeight=2000 --y coordinate
worldDepth=10240 --z coordinate
--all world___ variables editable. They represent how much of your world is scanned.

radarHeight=7 --the only special variable; editable. Says max height of an object withing range of worldHeight.

------------------------------------------------------------------------------------------------------------------------------------------------
-----------------------------------------DO NOT EDIT ANYTHING BELOW THIS POINT!!!---------------------------------------------
------------------------------------------------------------------------------------------------------------------------------------------------
if folder==game.Workspace and allowDeleteEverything then allowDeleteEverything=false print(&quot;Read the rules! Bad setup in the radar script!&quot;) end --safeguard
ch=folder:getChildren()
if not allowDeleteEverything then
	for i = 1, #ch do if ch[i].Name==brick.Name then ch[i]:Remove() end end
else
	for i = 1, #ch do ch[i]:Remove() end
end
r=script.Parent
s=r.Size
p=r.Position
radarWidth=s.x
radarDepth=s.z
originX=p.x
originY=p.y+s.y/2
originZ=p.z
origin=Vector3.new(originX,originY,originZ)

confirm={}
objects={} --radar bricks
references={} --what the objects refer to
inWorkspace={} --or are we out of range of the radar?
parent={} --if we ARE out of range, we need to know what parent to use (incase of humanoid)
function inObjects(what)
	for j = 1, #references do
		if references[j].Parent==what then return true end
	end
	return false
end
function want(string) --look through names of what we are finding... do we want to track it?
	for j = 1, #name do
		if name[j]==string then return true end
	end
	return false
end
searchPeople=false
for i = 1, #name do
	if name[i]==&quot;*&quot; then searchPeople=true spi = i end
end
function addRef(what, index)
	wh=what:findFirstChild(find[index])
	if wh==nil and (what.className==&quot;Part&quot; or what.className==&quot;SpawnLocation&quot; or what.className==&quot;Seat&quot;) then wh=what end
	if wh==nil and #what:getChildren() &gt; 0 then
		wh=what:getChildren()[1]
	end
	if wh==nil or (wh.className~=&quot;Part&quot; and wh.className~=&quot;SpawnLocation&quot; and wh.className~=&quot;Seat&quot;) then return end --can&apos;t find a suitable brick to track it with, so no position -- no tracking!
	n=#objects+1 --new index
	objects[n]=brick:clone()
	if color[index]==0 then objects[n].BrickColor=game.Players:findFirstChild(what.Name).TeamColor
	elseif color[index]==1 then objects[n].BrickColor=wh.BrickColor
	else objects[n].BrickColor=color[index] 
	end
	objects[n].Transparency=transparency[index]
	objects[n].Reflectance=reflectance[index]
	if humanoid[index] then
		hum=Instance.new(&quot;Humanoid&quot;)
		if not includeHealth[index] then hum.MaxHealth=0 hum.Health=0 end
		mod=Instance.new(&quot;Model&quot;)
		mod.Name=what.Name
		hum.Parent=objects[n] --so that uncompression is possible
		mod.Parent=folder
		parent[n]=mod
		--objects[n].Parent=mod
		objects[n].Name=&quot;Head&quot;
	else
		--objects[n].Parent=folder
		parent[n]=folder
	end
	references[n]=wh
	confirm[n]=true
	inWorkspace[n]=false
end
function getIndex(string) --from name
	for j = 1, #name do if name[j]==string then return j end
	if name[j]==&quot;*&quot; then if game.Players:findFirstChild(string)~=nil then return j end end
	end
	return nil
end
function confirmIt(what)
	for j = 1, #references do
		if references[j].Parent==what then confirm[j]=true return end
	end
end
function clearConfirm()
	for i = 1, #confirm do confirm[i]=false end
end
function getHumanoid(folder) --find the first humanoid in &quot;folder&quot;, or &quot;nil&quot; if it can&apos;t find any.
	local i = 0
	local ch=folder:GetChildren()
	for i = 1, #ch do
		if ch[i].className==&quot;Humanoid&quot; then return ch[i] end
	end
	return nil
end
function checkHumanoids() --confirms if all humanoids exist (if applicable).
	local i = 0
	for i = 1, #references do
		if confirm[i] then
			id=getIndex(references[i].Parent.Name)
			if humanoid[id] then
				local h=getHumanoid(references[i].Parent)
				if h==nil then confirm[i]=false end --the humanoid doesn&apos;t exist anymore! Delete!				
			end			
		end
	end
end
function cleanUp()
	checkHumanoids()
	local i = 0
	for i = #objects, 1, -1 do 
		if confirm[i]==false or references[i]==nil then 
			table.remove(confirm, i) 
			table.remove(references, i) 
			if parent[i].Name~=folder.Name then 
				if inWorkspace[i] then objects[i].Parent:Remove() 
				else objects[i].Parent=parent[i] objects[i].Parent:Remove() end
			else 
				objects[i]:Remove() 
			end
			table.remove(objects, i)
			table.remove(inWorkspace, i)
			table.remove(parent, i)
		end
	end
end
function ffind()
	clearConfirm()
	if search~=nil then
		ch=search:GetChildren()
		for i = 1, #ch do
			if want(ch[i].Name) then
				if not inObjects(ch[i]) then
					addRef(ch[i], getIndex(ch[i].Name))
				else
					confirmIt(ch[i])
				end
			end
		end
	end
	if searchPeople then --spi == name index for colour scheme
		ch=game.Players:getChildren()
		local rem={}
		for i = 1, #ch do if ch[i].Character==nil then table.insert(rem, i) end end
		local c=0
		for i=1, #rem do table.remove(ch, rem[i]-c) c=c+1 end
		for i = 1, #ch do ch[i]=ch[i].Character end
		for i = 1, #ch do
			if not inObjects(ch[i]) then
				addRef(ch[i], spi)
			else
				confirmIt(ch[i])
			end
		end		
	end
	if searchInPeople then
		cha=game.Players:getChildren()
		for m = 1, #cha do
			ch=cha[m].Character
			if ch~=nil then
				ch=ch:getChildren()
				for i = 1, #ch do
					if want(ch[i].Name) then
						if not inObjects(ch[i]) then
							addRef(ch[i], getIndex(ch[i].Name))
						else
							confirmIt(ch[i])
						end
					end
				end
			end
		end
	end
	cleanUp()
end
x=radarWidth/worldWidth
z=radarDepth/worldDepth
y=radarHeight/worldHeight
factor=Vector3.new(x,y,z)
function transform(pos) --transform real-life object into radar coordinates
	x=(pos.x-worldCenter.x)*factor.x+originX
	y=(pos.y-worldCenter.y)*factor.y+originY
	z=(pos.z-worldCenter.z)*factor.z+originZ
	return Vector3.new(x,y,z)
end
function inRange(pos) --this pos MUST be the object[] pos, ie. where it should be on the radar.
	if pos.x&lt;originX-radarWidth/2 or pos.x &gt; originX+radarWidth/2 or pos.z&lt;originZ-radarDepth/2 or pos.z &gt; originZ+radarDepth/2 or pos.y&lt;originY or pos.y&gt;originY+radarHeight then
		return false
	else
		return true
	end
end

function update()
	for i = 1, #objects do
		objects[i].CFrame=CFrame.new(transform(references[i].Position))
		id=getIndex(references[i].Parent.Name)
		if inWorkspace[i] then
			if humanoid[id] then objects[i].Parent.Name=references[i].Parent.Name if includeHealth[id] then zh=getHumanoid(references[i].Parent) if zh~=nil then objects[i].Parent.Humanoid.Health=zh.Health objects[i].Parent.Humanoid.MaxHealth=zh.MaxHealth end end end
			if color[getIndex(references[i].Parent.Name)]==1 then objects[i].BrickColor=references[i].BrickColor end
			if not inRange(objects[i].Position) then
				if humanoid[id] then objects[i].Parent.Humanoid.Parent=objects[i] end --compress it!
				objects[i].Parent=nil
				inWorkspace[i]=false
			end
		else
			if inRange(objects[i].Position) then
				objects[i].Parent=parent[i]
				inWorkspace[i]=true
				if humanoid[id] then objects[i].Humanoid.Parent=objects[i].Parent end --uncompress it!
			end
		end
	end
end
while true do
	wait(frequency)
	ffind() --updates radar brick list
	update() --updates positions on radar brick list
end
