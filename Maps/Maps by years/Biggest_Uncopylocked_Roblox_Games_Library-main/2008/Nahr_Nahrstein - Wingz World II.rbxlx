							<CoordinateFrame name="Value">
								<X>-50.4953918</X>
								<Y>1.38946533</Y>
								<Z>-2.50805068</Z>
								<R00>-1</R00>
								<R01>8.67352981e-007</R01>
								<R02>5.93983932e-005</R02>
								<R10>8.67132314e-007</R10>
								<R11>1</R11>
								<R12>-3.71580722e-006</R12>
								<R20>-5.93983932e-005</R20>
								<R21>-3.71575584e-006</R21>
								<R22>-1</R22>
							</CoordinateFrame>
