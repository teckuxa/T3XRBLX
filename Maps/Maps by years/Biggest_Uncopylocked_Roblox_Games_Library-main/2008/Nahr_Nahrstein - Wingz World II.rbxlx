							<string name="Source">local bounce = 0

while true do
	if bounce == 0 then
		script.Parent.TopParamB = .03
		wait(.5)
		script.Parent.TopParamB = -.03
		wait(1)
		bounce = 1
	end
	if bounce == 1 then
		script.Parent.TopParamB = .03
		wait(1)
		script.Parent.TopParamB = -.03
		wait(1)
	end
end

</string>
