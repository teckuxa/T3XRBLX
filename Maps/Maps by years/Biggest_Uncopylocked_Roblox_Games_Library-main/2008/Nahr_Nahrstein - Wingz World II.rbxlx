							<string name="Source">function RemoveHat(hit)
	local name = hit.Parent.className
	if (name == &quot;Hat&quot;) then
		local human = hit.Parent.Parent:findFirstChild(&quot;Humanoid&quot;)
		if (human ~= nil) then
			hit.Parent:remove()
		end
	end
end

