		<Item class="Script" referent="RBX891">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Commands Script</string>
				<string name="Source">----------------------------------------------------------------------------------------------------------------------------------------
---------------------------------------------------------brandonhare---------------------------------------------------------------
----------------------------------------------------------------------------------------------------------------------------------------
print(&quot;brandonhare&apos;s commands script V5 loaded succsessfully!&quot;)

admins = { &quot;NearmissTFW&quot;,&quot;CarolinasFinest&quot;,&quot;TonyAir&quot;,&quot;Aerialfire&quot;,&quot;Yobloxb29&quot;,&quot;Banana5&quot;,&quot;cooldude20&quot;,&quot;paintballer4lyfe&quot;,&quot;Tegdif123&quot;,&quot;Frostymcburn&quot;,&quot;Captaincoolness&quot;,&quot;Armymen3do1&quot;,&quot;sparttan&quot; }--Add admins here.
owner = &quot;NearmissTFW&quot; --change brandonhare to your name

commands = { &quot;Lighting: Time/#&quot;, &quot;Lighting: Day&quot;, &quot;Lighting: Night&quot;, &quot;Lighting: Normal&quot;, &quot;Lighting: Red&quot;, &quot;Lighting: Yellow&quot;, &quot;Lighting: Green&quot;,&quot;Lighting: Blue&quot;, &quot;Lighting: Neon&quot;, &quot;Lighting: Betaish&quot;, &quot;Lighting: Black&quot;, &quot;Lighting: White&quot;, &quot;Lighting: Disco&quot;, &quot;Other: Suicide&quot;, &quot;Other: No Messages&quot;, &quot;Other: Regen&quot;, &quot;Other: Admins&quot;, &quot;Other: Banned&quot;, &quot;Other: Rename/newname&quot; } -- Don&apos;t touch this
adminCommands = { &quot;Shout (message): M/(text)&quot;, &quot;Shout (hint): H/(text)&quot;, &quot;Flying: Float/#&quot;, &quot;Flying: Summon/Me, All, Name&quot;, &quot;Flying: 2D/Me, All, Name&quot;, &quot;Flying: Land/Me, All, Name&quot;, &quot;Flying: Restart/Me, All, Name&quot;, &quot;Killing: Zeeky boogy doog&quot;, &quot;Killing: Gleeg Snag Zip&quot;, &quot;Physical: Sit/Me, All, Name&quot;, &quot;Physical: Unsit/Me, All, Name&quot;, &quot;Physical: Ghost/Me, All, Name&quot;, &quot;Physical: Unghost/Me, All, Name&quot;, &quot;Physical: Trip/Me, All, Name&quot;, &quot;Physical: Jumpy/Me, All, Name&quot;, &quot;Physical: Freeze/Me, All, Name&quot;, &quot;Physical: Thaw/Me, All, Name&quot;, &quot;Other: Listen&quot;, &quot;Other: Disconnect -- CRASHES SERVER!! DON&apos;T USE!!&quot;, &quot;Other: Admin/Me, All, Name&quot;, &quot;Other: Deadmin/Me, All, Name&quot;, &quot;Other: Kick/Name&quot;, &quot;Other: Ban/Name&quot;, &quot;Other: Antimessage&quot;, &quot;Other: MaxPlayers/#&quot;, &quot;Fun: Immortal/(self)&quot;} --Or this

ban = { &quot;Not You Apparently&quot; } --Put people you want to ban in here.
regen = { }  --Dont touch this
stuff = game.Workspace:GetChildren()

for i = 1, #stuff do
	if (stuff[i].className == &quot;Model&quot;) then
		table.insert(regen, stuff[i]:clone())
	end
end

function checkIfAdmin(name) --Check for admins
	for i = 1,#admins do
		if (string.lower(name) == string.lower(admins[i])) then return true end
	end
	return false
end

function putInPos(player)
	if (player.Character ~= nil and player.Character:findFirstChild(&quot;Torso&quot;) ~= nil) then
		local pos = Instance.new(&quot;BodyPosition&quot;)
		pos.Name = &quot;BodyPosition&quot;
		pos.maxForce = Vector3.new(0,0,0)
		pos.Parent = player.Character.Torso
	end
end

function explode(part)
	local e = Instance.new(&quot;Explosion&quot;)
	e.Position = part.Position
	e.Parent = game.Workspace
end

function showMessage(what, where, when)
	local message = Instance.new(&quot;Message&quot;)
	message.Text = what
	message.Parent = where
	wait(when)
	message:remove()
end

function showHint(what, where, when)
	local hint = Instance.new(&quot;Hint&quot;)
	hint.Text = what
	hint.Parent = where
	wait(when)
	hint:remove()
end

function checkIfBanned(name) --NO PLACE FOR YOU!!!
	if (#ban == 0) then return false end
	for i = 1, #ban do
		if (string.upper(name) == string.upper(ban[i])) then return true end
	end
	return false
end

function onPlayerRespawned(newPlayer) --Give admins weps, and put a bodyposition in them.
	while true do --Don&apos;t crash
		if (newPlayer.Character~= nil) then break end
		wait(0.1)
	end
	if (#ban ~= 0) then
		for i = 1, #ban do
			if (string.lower(newPlayer.Name) == string.lower(ban[i])) then newPlayer:remove() end
		end
	end
	putInPos(newPlayer)
	if checkIfAdmin(newPlayer.Name) then
		newPlayer.Character.Humanoid.MaxHealth = 100 --Did I mention lots of health?
		newPlayer.Character.Humanoid.Health = 100
		if (newPlayer.Character:findFirstChild(&quot;Health&quot;) ~= nil) then newPlayer.Character.Health:remove() end
		local health = Instance.new(&quot;Script&quot;)
		health.Source = [[
human = script.Parent:findFirstChild(&quot;Humanoid&quot;)
if (human == nil) then script:remove() end

while true do
	wait(1)
	human.Health = human.MaxHealth
end
]]
		health.Parent = newPlayer.Character
		health.Disabled = false
		local c = game.Lighting.vipstuff:GetChildren()
		for i = 1, #c do
			if (c[i].className == &quot;HopperBin&quot; or c[i].className == &quot;Tool&quot;) then --Any tools in the lighting get given to them.
				c[i]:clone().Parent = newPlayer.Backpack
			end
		end
	end
	showHint(&quot;Welcome to Wingz World&quot;, newPlayer, 3)
end

function onChatted(msg, recipient, speaker)

	--Don&apos;t write the commands with any capitals or it won&apos;t work.

	local source = string.lower(speaker.Name)
	msg = string.lower(msg)


	if not (checkIfAdmin(source)) then return end  --If you want all commands to be admin commands, remove the -- at the start of this line.


	if string.sub(msg, 1,7) == &quot;rename/&quot; then
		if (speaker.Character ~= nil) then speaker.Character.Name = string.sub(msg, 8) end
	end

	if string.match(msg, &quot;admincummands&quot;) or string.match(msg, &quot;admin commands&quot;) then
		showHint(&quot;~Admin Commands~&quot;, speaker, 2)
		for i = 1, #adminCommands do
			showHint(adminCommands[i], speaker, 2)
		end
		showHint(&quot;~End~&quot;, speaker, 2)
	return end

	if string.match(msg, &quot;cummands&quot;) then
		showHint(&quot;~Commands~&quot;, speaker, 2)
		for i = 1, #commands do
			showHint(commands[i], speaker, 2)
		end
		showHint(&quot;~End~&quot;, speaker, 2)
	end

	if (string.sub(msg, 1,5) == &quot;time/&quot;) then game.Lighting.TimeOfDay = string.sub(msg, 6) end

	if (msg == &quot;day&quot;) then game.Lighting.TimeOfDay = &quot;14:00:00&quot; end

	if (msg == &quot;night&quot;) then game.Lighting.TimeOfDay = &quot;00:00:00&quot; end

	if (msg == &quot;regen&quot;) then
		if (#regen == 0 or oktoregen == false) then return end
		oktoregen = false
		showHint(&quot;Starting to regen&quot;, game.Workspace, 0.1)
		stuff = game.Workspace:GetChildren()
		for i = 1, #stuff do
			for o = 1, #regen do
				if (stuff[i].Name == regen[o].Name) then
					wait(0.1)
					showHint(&quot;Removing &quot;..stuff[i].Name&quot;...&quot;,game.Workspace, 0.1)
					stuff[i]:remove()
				end
			end
		end
		for i = 1, #regen do
			wait(0.1)
			thing = regen[i]:clone()
			showHint(&quot;Regenerating &quot;..thing.Name..&quot;...&quot;,game.Workspace,0.1)
			thing.Parent = game.Workspace
			thing:makeJoints()
		end
		showHint(&quot;Finished regen&quot;,game.Workspace,1)
		oktoregen = true
	end

	if (msg == &quot;admins&quot;) then
		showHint(&quot;~Admins~&quot;, speaker, 2)
		for i = 1, #admins do	
			showHint(admins[i], speaker, 2)
		end
		showHint(&quot;~End~&quot;, speaker, 2)
	end

	if (msg == &quot;banned&quot;) then
		showHint(&quot;~Banned people~&quot;, speaker, 2)
		if (#ban == 0) then
			showHint(&quot;No banned people&quot;, speaker, 2)
			wait(2)
			showHint(&quot;~End~&quot;, speaker, 2)
			wait(2)
			return
		end
		for i = 1, #ban do	
			showHint(ban[i], speaker, 2)
		end
		showHint(&quot;~End~&quot;, speaker, 2)
		return
	end

	if (msg == &quot;normal&quot;) then
		game.Lighting.Ambient = Color3.new(131,131,131)
		game.Lighting.ColorShift_Bottom = Color3.new(0,0,0)
		game.Lighting.ColorShift_Top = Color3.new(0,0,0)
		game.Lighting.ShadowColor = Color3.new(133,133,133)
		game.Lighting.TimeOfDay = &quot;00:00:00&quot;
		game.Lighting.TimeOfDay = &quot;14:00:00&quot;
	end

	if (msg == &quot;neon&quot;) then
		game.Lighting.Ambient = Color3.new(0,255,255)
		game.Lighting.ColorShift_Bottom = Color3.new(0,255,255)
		game.Lighting.ColorShift_Top = Color3.new(0,255,255)
		game.Lighting.ShadowColor = Color3.new(0,255,255)

	end

	if (msg == &quot;red&quot;) then
		game.Lighting.Ambient = Color3.new(255,0,0)
		game.Lighting.ColorShift_Bottom = Color3.new(255,0,0)
		game.Lighting.ColorShift_Top = Color3.new(255,0,0)
		game.Lighting.ShadowColor = Color3.new(255,0,0)
	end

	if (msg == &quot;yellow&quot;) then

		game.Lighting.Ambient = Color3.new(255,255,0)
		game.Lighting.ColorShift_Bottom = Color3.new(255,255,0)
		game.Lighting.ColorShift_Top = Color3.new(255,255,0)
		game.Lighting.ShadowColor = Color3.new(255,255,0)

	end

	if (msg == &quot;green&quot;) then

		game.Lighting.Ambient = Color3.new(0,255,0)
		game.Lighting.ColorShift_Bottom = Color3.new(0,255,0)
		game.Lighting.ColorShift_Top = Color3.new(0,255,0)
		game.Lighting.ShadowColor = Color3.new(0,255,0)

	end

	if (msg == &quot;blue&quot;) then

		game.Lighting.Ambient = Color3.new(0,0,255)
		game.Lighting.ColorShift_Bottom = Color3.new(0,0,255)
		game.Lighting.ColorShift_Top = Color3.new(0,0,255)
		game.Lighting.ShadowColor = Color3.new(0,0,255)

	end

	if (msg == &quot;black&quot;) then

		game.Lighting.TimeOfDay = &quot;00:00:00&quot;
		game.Lighting.Ambient = Color3.new(0,0,0)
		game.Lighting.ColorShift_Bottom = Color3.new(0,0,0)
		game.Lighting.ColorShift_Top = Color3.new(0,0,0)
		game.Lighting.ShadowColor = Color3.new(0,0,0)

	end

	if (msg == &quot;betaish&quot;) then
		game.Lighting.TimeOfDay = &quot;00:00:00&quot;
		game.Lighting.Ambient = Color3.new(0,0,0)
		game.Lighting.ColorShift_Bottom = Color3.new(0,0,0)
		game.Lighting.ColorShift_Top = Color3.new(0,0,0)
		game.Lighting.ShadowColor = Color3.new(0,0,0)
		game.Lighting.TimeOfDay = &quot;14:00:00&quot;
	end

	if (msg == &quot;white&quot;) then

		game.Lighting.Ambient = Color3.new(255,255,255)
		game.Lighting.ColorShift_Bottom = Color3.new(255,255,255)
		game.Lighting.ColorShift_Top = Color3.new(255,255,255)
		game.Lighting.ShadowColor = Color3.new(255,255,255)

	end

	if (msg == &quot;disco&quot;) then
		for a = 1, 20 do
			wait(0.5)
			game.Lighting.Ambient = Color3.new(math.random(0,255),math.random(0,255),math.random(0,255))
			game.Lighting.ColorShift_Bottom = Color3.new(math.random(0,255),math.random(0,255),math.random(0,255))
			game.Lighting.ColorShift_Top = Color3.new(math.random(0,255),math.random(0,255),math.random(0,255))
			game.Lighting.ShadowColor = Color3.new(math.random(0,255),math.random(0,255),math.random(0,255))
		end
		game.Lighting.Ambient = Color3.new(131,131,131)
		game.Lighting.ColorShift_Bottom = Color3.new(0,0,0)
		game.Lighting.ColorShift_Top = Color3.new(0,0,0)
		game.Lighting.ShadowColor = Color3.new(133,133,133)
		game.Lighting.TimeOfDay = &quot;00:00:00&quot;
		game.Lighting.TimeOfDay = &quot;14:00:00&quot;
	end

	if (msg == &quot;suicide&quot;) then
		speaker.Character.Humanoid.Health = 0
	end

	if (msg == &quot;no messages&quot;) then
		local c = speaker:GetChildren()
		for i = 1, #c do
			if (c[i].className == &quot;Message&quot; or c[i].className == &quot;Hint&quot;) then c[i]:remove() end
		end
	end


-------------------------------Only admin commands past this point------------------------------

	if not (checkIfAdmin(source)) then return end	--If you want anyone to be able to use admin commands, remove this line.

	if (string.sub(msg, 1, 2) == &quot;m/&quot;) then
		showMessage(string.sub(msg, 3), game.Workspace, 3)
	end

	if (string.sub(msg, 1,2) == &quot;h/&quot;) then
		showHint(string.sub(msg, 3), game.Workspace, 3)
	end

	if (string.sub(msg, 1,6) == &quot;float/&quot;) then
		if (speaker.Character == nil or speaker.Character:findFirstChild(&quot;Torso&quot;) == nil) then return end
		if (speaker.Character.Torso:findFirstChild(&quot;BodyPosition&quot;) == nil) then putInPos(speaker) end
		speaker.Character.Torso.BodyPosition.position = Vector3.new(0,string.sub(msg,7),0)
		speaker.Character.Torso.BodyPosition.maxForce = Vector3.new(0,1e+006,0)
	end

	if string.sub(msg,1,11) == &quot;maxplayers/&quot; then
		game.Players.MaxPlayers = string.sub(msg,12)
	end


	if string.match(msg, &quot;kihl&quot;) then

		if (string.match(msg, &quot;me&quot;)) then
			if (speaker.Character ~= nil and speaker.Character:findFirstChild(&quot;Humanoid&quot;) ~= nil) then
				speaker.Character.Humanoid.Health = 0
			end
		end

		if (string.match(msg, &quot;all&quot;)) then
			local c = game.Players:GetChildren()
			for i = 1, #c do
				if (c[i] ~= speaker and c[i].Character ~= nil and c[i].Character:findFirstChild(&quot;Humanoid&quot;) ~= nil) then
					c[i].Character.Humanoid.Health = 0
				end
			end
		end

		local c = game.Players:GetChildren()
		for i = 1, #c do
			if (string.match(msg, string.lower(c[i].Name))) then
				if (c[i].Character ~= nil and c[i].Character:findFirstChild(&quot;Humanoid&quot;) ~= nil) then
					c[i].Character.Humanoid.Health = 0
				end
			end
		end
        end

	if string.match(msg, &quot;asplode&quot;) then

		if (string.match(msg, &quot;me&quot;)) then
			if (speaker.Character ~= nil and speaker.Character:findFirstChild(&quot;Torso&quot;) ~= nil) then
				local e = Instance.new(&quot;Explosion&quot;)
				e.Position = speaker.Character.Torso.Position
				e.Parent = game.Workspace
			end
		end

		if (string.match(msg, &quot;all&quot;)) then
			local c = game.Players:GetChildren()
			for i = 1, #c do
				if (c[i] ~= speaker and c[i].Character ~= nil and c[i].Character:findFirstChild(&quot;Torso&quot;) ~= nil) then
					local e = Instance.new(&quot;Explosion&quot;)
					e.Position = c[i].Character.Torso.Position
					e.Parent = game.Workspace
				end
			end
		end

		local c = game.Players:GetChildren()
		for i = 1, #c do
			if (string.match(msg, string.lower(c[i].Name))) then
				if (c[i].Character ~= nil and c[i].Character:findFirstChild(&quot;Torso&quot;) ~= nil) then
					local e = Instance.new(&quot;Explosion&quot;)
					e.Position = c[i].Character.Torso.Position
					e.Parent = game.Workspace
				end
			end
		end
        end

	if string.match(msg, &quot;2d&quot;) then

		if (string.match(msg, &quot;me&quot;)) then
			if (speaker.Character ~= nil and speaker.Character:findFirstChild(&quot;Torso&quot;) ~= nil) then
				if (speaker.Character.Torso:findFirstChild(&quot;BodyPosition&quot;) == nil) then putInPos(speaker) end
				speaker.Character.Torso.BodyPosition.position = Vector3.new(0,0,0)
				speaker.Character.Torso.BodyPosition.maxForce = Vector3.new(0,0,1e+006)
			end
		end

		if (string.match(msg, &quot;all&quot;)) then
			local c = game.Players:GetChildren()
			for i = 1, #c do
				if (c[i] ~= speaker and c[i].Character ~= nil and c[i].Character:findFirstChild(&quot;Torso&quot;) ~= nil) then
					if (c[i].Character.Torso:findFirstChild(&quot;BodyPosition&quot;) == nil) then putInPos(c[i]) end
					c[i].Character.Torso.BodyPosition.position = Vector3.new(0,0,0)
					c[i].Character.Torso.BodyPosition.maxForce = Vector3.new(0,0,1e+006)
				end
			end
		end

		local c = game.Players:GetChildren()
		for i = 1, #c do
			if (string.match(msg, string.lower(c[i].Name))) then
				if (c[i].Character ~= nil and c[i].Character:findFirstChild(&quot;Torso&quot;) ~= nil) then
					if (c[i].Character.Torso:findFirstChild(&quot;BodyPosition&quot;) == nil) then putInPos(c[i]) end
					c[i].Character.Torso.BodyPosition.position = Vector3.new(0,0,0)
					c[i].Character.Torso.BodyPosition.maxForce = Vector3.new(0,0,1e+006)
				end
			end
		end
        end

	if string.match(msg, &quot;freeze&quot;) then

		if (string.match(msg, &quot;me&quot;)) then
			if (speaker.Character ~= nil and speaker.Character:findFirstChild(&quot;Torso&quot;) ~= nil) then
				speaker.Character.Torso.Anchored = true
			end
		end

		if (string.match(msg, &quot;all&quot;)) then
			local c = game.Players:GetChildren()
			for i = 1, #c do
				if (c[i] ~= speaker and c[i].Character ~= nil and c[i].Character:findFirstChild(&quot;Torso&quot;) ~= nil) then
