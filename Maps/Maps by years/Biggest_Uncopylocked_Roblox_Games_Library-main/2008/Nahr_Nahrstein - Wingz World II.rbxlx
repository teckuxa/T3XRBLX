						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">PantRemover</string>
						<string name="Source">debounce = true

function onTouched(hit)
	if (hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil and debounce == true) then
		debounce = false
		if not (hit.Parent.Pants == nil) then
			hit.Parent.Pants:remove() --deletes pants of the toucher
		end
		wait(1)
		debounce = true
	end
end

