function onClicked()
button.BrickColor = BrickColor.Green()
game.Workspace.Radio.Sound:Pause()
game.Workspace.Radio2.Sound:Pause()
game.Workspace.Radio3.Sound:Pause()
game.Workspace.Radio4.Sound:Pause()
game.Workspace.Radio5.Sound:Pause()
game.Workspace.Radio6.Sound:Pause()
game.Workspace.Radio7.Sound:Pause()
game.Workspace.Radio8.Sound:Pause()
game.Workspace.Radio9.Sound:Pause()
game.Workspace.Radio10.Sound:Pause()
wait(0.5)
button.BrickColor = BrickColor.Red()
game.Workspace.Radio.Sound.SoundId = &quot;http://www.roblox.com/asset/?id=1372257&quot;
game.Workspace.Radio2.Sound.SoundId = &quot;http://www.roblox.com/asset/?id=1372257&quot;
