				<Item class="Script" referent="RBX6333">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Meshes</string>
						<string name="Source">template = script.Parent.Parent:findFirstChild(&quot;Battle Droid&quot;)

function onTouch(hit)
local h = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
if h ~= nil then
local headm = template.Head.Mesh:clone()
local torsom = template.Torso.Mesh:clone()
local lam = template:findFirstChild(&quot;Left Arm&quot;).Mesh:clone()
local llm = template:findFirstChild(&quot;Left Leg&quot;).Mesh:clone()
local ram = template:findFirstChild(&quot;Right Arm&quot;).Mesh:clone()
local rrm = template:findFirstChild(&quot;Right Leg&quot;).Mesh:clone()
headm.Parent = hit.Parent:findFirstChild(&quot;Head&quot;)
torsom.Parent = hit.Parent:findFirstChild(&quot;Torso&quot;)
lam.Parent = hit.Parent:findFirstChild(&quot;Left Arm&quot;)
llm.Parent = hit.Parent:findFirstChild(&quot;Left Leg&quot;)
ram.Parent = hit.Parent:findFirstChild(&quot;Right Arm&quot;)
rrm.Parent = hit.Parent:findFirstChild(&quot;Right Leg&quot;)
end
end

script.Parent.Touched:connect(onTouch)</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX6334">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Special Weapon</string>
						<string name="Source">local debounce = true

function getPlayer(humanoid) 
	local players = game.Players:children() 
	for i = 1, #players do 
		if players[i].Character.Humanoid == humanoid then return players[i] end 
	end 
	return nil 
end 

function onTouch(part) 
	local human = part.Parent:findFirstChild(&quot;Humanoid&quot;) 
	if (human ~= nil) and (debounce == true) then
		debounce = false
		local player = getPlayer(human) 
		if (player == nil) then return end 
		game.Lighting.Blaster:clone().Parent = player.Backpack --change TOOL to the name of the tool inside the script
		wait(1)
		debounce = true
	end
end


script.Parent.Touched:connect(onTouch) 
