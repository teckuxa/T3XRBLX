						<string name="Name">Debounce</string>
						<string name="Source">debounce = true
button = script.Parent

function onTouched(hit)
	if (hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil and debounce == true) then
		debounce = false
		button.BrickColor = BrickColor.Red()
		wait(1)
		button.BrickColor = BrickColor.Green()
		debounce = true
	end
end


