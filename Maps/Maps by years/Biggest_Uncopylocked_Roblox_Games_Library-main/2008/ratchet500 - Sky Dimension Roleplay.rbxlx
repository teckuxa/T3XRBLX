&#9;for ___,b in pairs(c) do
&#9;&#9;if b[4]~=nil then if type(b[4])~=&quot;boolean&quot; then table.insert(b,4,true) end else b[4]=true end
&#9;&#9;table.insert(channels,b)
&#9;end
end end

function tableconcat(table,space)
cc=&quot;&quot;
for _,a in pairs(table) do
if type(a)~=&quot;string&quot; then
cc=cc..tostring(a)..space
else
cc=cc..a..space
end
end
return cc
end

totalChannels=#channels

function isAnAnimation(ChannelTable)
if ChannelTable[5]~=nil then
return true
else
return false
end
end

function refresh(rTime)

--clear out animation
if cChannel~=nil then
if math.floor(script.Parent.channel.Value)~=cChannel then
for _,a in pairs(script.Parent.Parent.Up:GetChildren()) do
if string.sub(a.Name,1,9)==&quot;Animation&quot; then
a.Texture=&quot;&quot;
a:remove()
end
end
end
end

--make sure the channel isn&apos;t outside bounds
script.Parent.channel.Value=math.floor(script.Parent.channel.Value)
if script.Parent.channel.Value&gt;#channels then script.Parent.channel.Value=1 end
if script.Parent.channel.Value&lt;1 then script.Parent.channel.Value=#channels end
currentChannel=script.Parent.channel.Value

--access the texture
tex=[[http://www.roblox.com/Thumbs/Asset.ashx?format=png&amp;width=420&amp;height=230&amp;assetId=]]..tostring(channels[currentChannel][1])..[[&amp;RAND=]]..tostring(math.random(1,100000000))
script.Parent.Parent.Down.Backup.Texture=tex
wait(rTime)

--when it&apos;s ready, transfer the texture
script.Parent.Main.Texture=script.Parent.Parent.Down.Backup.Texture

--draw the person&apos;s picture.
if channels[currentChannel][3]==&quot;&quot; or channels[currentChannel][4]==false then
script.Parent.Parent.Character.Decal.Texture=&quot;&quot;
else
script.Parent.Parent.Character.Decal.Texture=&quot;http://www.roblox.com/Thumbs/Avatar.ashx?x=480&amp;y=360&amp;Format=Png&amp;username=&quot;..channels[currentChannel][3]..[[&amp;RAND=]] .. tostring(math.random(1,100000000))
end

--change the model names.
if channels[currentChannel][3]~=&quot;&quot; then
script.Parent.Parent.ChannelCreator:GetChildren()[1].Name=&quot;Created By: &quot;..channels[currentChannel][3]
else
script.Parent.Parent.ChannelCreator:GetChildren()[1].Name=&quot; &quot;
end
if channels[currentChannel][2]~=&quot;&quot; then
script.Parent.Parent.ChannelIndicator:GetChildren()[1].Name=channels[currentChannel][2]..&quot; - Channel: &quot;..tostring(currentChannel)
else
script.Parent.Parent.ChannelIndicator:GetChildren()[1].Name=&quot;Channel: &quot;..tostring(currentChannel)
end

if isAnAnimation(channels[currentChannel]) then
anim=channels[currentChannel]
maxNum=1
for _,a in pairs(anim) do
decal=Instance.new(&quot;Decal&quot;)
decal.Texture=[[http://www.roblox.com/Thumbs/Asset.ashx?format=png&amp;width=420&amp;height=230&amp;assetId=]]..tostring(a)..[[&amp;RAND=]]..tostring(math.random(1,100000000))
decal.Name=&quot;Animation&quot;..tostring(_)
decal.Face=&quot;Front&quot;
decal.Parent=script.Parent.Parent.Up
if _&gt;maxNum then maxNum=_ end
end
cChannel=currentChannel
counter=5
wait(5) --waiting for splash screen
while currentChannel==cChannel do
counter=counter+1
if counter&gt;maxNum then counter=6 end
dec=script.Parent.Parent.Up:findFirstChild(&quot;Animation&quot;..tostring(counter))
if dec~=nil then script.Parent.Main.Texture=dec.Texture end
wait(channels[cChannel][5])
end
end

end

script.Parent.channel.Changed:connect(function() refresh(0) end)

tobool=function(arg1)
if type(arg1)==&quot;string&quot; then
if arg1==&quot;true&quot; then
return true
elseif arg1==&quot;false&quot; then
return false
else
return nil
end
end
if type(arg1)==&quot;number&quot; then
if arg1==0 then return false
elseif arg1==1 then return true
else return nil
end
end
if type(arg1)==&quot;boolean&quot; then return arg1 end
end

_G.insertChannel=function(phrase)
print(&quot;P1&quot;)
if string.sub(phrase,1,1)~=&quot;{&quot; then return end
phrase=string.sub(phrase,2)
print(&quot;P2&quot;)
tab={}
while string.find(phrase,&quot;,&quot;)~=nil do
print(&quot;P3&quot;)
wait()
dat=string.find(phrase,&quot;,&quot;)
print(dat)
cn=string.sub(phrase,1,dat-1)
phrase=string.sub(phrase,dat+1)
if tonumber(cn)~=nil then cn=tonumber(cn) end
if type(cn)==&quot;string&quot; or type(cn)==&quot;number&quot; or type(cn)==&quot;boolean&quot; then
print(&quot;P4&quot;)
if cn==&quot;true&quot; then cn=true end if cn==&quot;false&quot; then cn=false end
table.insert(tab,cn)
end
end
dat=string.find(phrase,&quot;}&quot;)
if dat~=nil then
print(&quot;P5&quot;)
cn=string.sub(phrase,1,dat-1)
if tonumber(cn)~=nil then cn=tonumber(cn) end
if type(cn)==&quot;string&quot; or type(cn)==&quot;number&quot; or type(cn)==&quot;boolean&quot; then
print(&quot;P6&quot;)
table.insert(tab,cn)
end
if #tab&gt;=3 then
print(&quot;P7&quot;)
if type(tab[1])==&quot;number&quot; and type(tab[2])==&quot;string&quot; and type(tab[3])==&quot;string&quot; then
print(&quot;P8&quot;)
if tab[4]==nil then tab[4]=true end
print(&quot;P9&quot;)
table.insert(channels,tab)
end
end
end
end

function onChatted(msg,player)
&#9;if string.sub(string.lower(msg),1,7)==&quot;insert/&quot; then
&#9;&#9;targ=string.sub(msg,8)
&#9;&#9;targ=tonumber(targ)
&#9;&#9;if targ~=nil then
&#9;&#9;&#9;if type(targ)==&quot;number&quot; and targ~=0 then
&#9;&#9;&#9;&#9;table.insert(channels,{targ,&quot;Uploaded Channel&quot;,player.Name})
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;if string.sub(msg:lower(),1,14)==&quot;insertchannel/&quot; then
&#9;&#9;targ=string.sub(msg,15)
&#9;&#9;if targ~=nil then
&#9;&#9;&#9;pcall(insertChannel,targ)
&#9;&#9;end
&#9;end
&#9;if string.sub(msg:lower(),1,8)==&quot;channel/&quot; then
&#9;&#9;targ=tonumber(string.sub(msg,9))
&#9;&#9;if targ~=nil then
&#9;&#9;&#9;if targ&gt;=1 and targ&lt;=#channels then
&#9;&#9;&#9;&#9;script.Parent.channel.Value=targ
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;if string.sub(msg:lower(),1,7)==&quot;remove/&quot; then
&#9;&#9;targ=tonumber(string.sub(msg,8))
&#9;&#9;if targ~=nil then
&#9;&#9;&#9;if targ&gt;=totalChannels and targ&lt;=#channels then
&#9;&#9;&#9;&#9;table.remove(channels,targ)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end
function onPlayerEntered(player)
player.Chatted:connect(function(msg) onChatted(msg,player) end)
end
game.Players.ChildAdded:connect(onPlayerEntered)

while true do
if isAnAnimation(channels[math.floor(script.Parent.channel.Value)])==false then
refresh(5)
end
wait(10)
end 
