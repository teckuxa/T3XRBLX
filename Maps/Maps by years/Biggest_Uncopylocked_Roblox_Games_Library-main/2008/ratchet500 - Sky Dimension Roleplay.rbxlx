				<Item class="Script" referent="RBX2390">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">function onClicked()
if script.Parent.Parent.Debounce.Value then
script.Parent.Parent.Debounce.Value=false
script.Parent.Parent.TV.channel.Value=script.Parent.Parent.TV.channel.Value+1
wait(2)
script.Parent.Parent.Debounce.Value=true
end
end
script.Parent.ClickDetector.MouseClick:connect(onClicked) </ProtectedString>
					</Properties>
				</Item>
