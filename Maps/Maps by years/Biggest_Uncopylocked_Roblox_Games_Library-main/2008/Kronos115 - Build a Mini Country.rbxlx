			<Item class="LocalScript" referent="RBX7944">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">LocalGUI</string>
					<ProtectedString name="Source">Tool = script.Parent

NoTarget = &quot;http://www.roblox.com/asset/?id=22590748&quot;
LockedOn = &quot;http://www.roblox.com/asset/?id=22589358&quot;

function Refresh(mouse)

mouse.Icon = NoTarget

local Target = mouse.Target

if Target == nil then 
return end

if (Target.Locked == false) and ((Target.Position - script.Parent.Parent.Parent.Character.Head.Position).Magnitude &lt; 60) then

mouse.Icon = LockedOn

end

end

function onEquippedLocal(mouse)

while true do

wait(0)

if mouse ~= nil then

Refresh(mouse)

end

end

end


script.Parent.Selected:connect(onEquippedLocal)

</ProtectedString>
