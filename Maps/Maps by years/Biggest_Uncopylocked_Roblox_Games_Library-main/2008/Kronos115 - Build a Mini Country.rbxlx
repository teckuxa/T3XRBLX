&#9;nextSetButton.Position = UDim2.new(0.0, 0, 1.0, -height)
&#9;nextSetButton.BackgroundColor3 = buttonColor
&#9;nextSetButton.TextColor3 = buttonTextColor
&#9;nextSetButton.BackgroundTransparency = transparency
