function onUnS(mouse)
if script.Parent.Parent.Parent.PlayerGui:findFirstChild(&quot;AmmoNotificationGUI&quot;) ~= nil then
script.Parent.Parent.Parent.PlayerGui.AmmoNotificationGUI:remove()
end
