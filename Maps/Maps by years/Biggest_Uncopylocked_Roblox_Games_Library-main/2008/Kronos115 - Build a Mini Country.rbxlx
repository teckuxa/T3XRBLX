			<Item class="Script" referent="RBX7961">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">WARP.DAT</string>
					<ProtectedString name="Source">local NewTimeTravelCoordinates = Vector3.new(1,33,7)
local OldTimeTravelCoordinates = Vector3.new(1,33,7)

local FluxCapacitor = script.Parent
local IsTimeTraveling = false

function TimeTravel(mouse)

if IsTimeTraveling == true then return end
IsTimeTraveling = true

local Vehicle = script.Parent.Parent.Parent.Character

OldTimeTravelCoordinates = Vehicle.Torso.Position

local DeloreanSFX = Instance.new(&quot;Sound&quot;)
DeloreanSFX.Name = &quot;DeloreanSFX&quot;
DeloreanSFX.SoundId = &quot;http://roblox.com/asset/?id=10209296&quot;
DeloreanSFX.Volume = 1
DeloreanSFX.Pitch = 1
DeloreanSFX.Parent = Vehicle.Torso
game:GetService(&quot;Debris&quot;):AddItem(DeloreanSFX, 10)

local WarpEffect = FluxCapacitor.WarpEffectGUI:Clone()
WarpEffect.Parent = script.Parent.Parent.Parent.PlayerGui
WarpEffect.WarpEffect.Visible = true
game:GetService(&quot;Debris&quot;):AddItem(WarpEffect, 10)

DeloreanSFX:Play()

--Vehicle.Humanoid.WalkSpeed = 0

for AnimateWarpEffect = 1,10 do
wait(0)
WarpEffect.WarpEffect.BackgroundTransparency = WarpEffect.WarpEffect.BackgroundTransparency - 0.1
end

game.Players.LocalPlayer.Character:MoveTo(mouse.hit.p)
NewTimeTravelCoordinates = mouse.hit.p

wait(1)

--Vehicle.Humanoid.WalkSpeed = 16

for AnimateWarpEffect = 1,100 do
wait(0)
WarpEffect.WarpEffect.BackgroundTransparency = WarpEffect.WarpEffect.BackgroundTransparency + 0.01
end

WarpEffect:remove()

IsTimeTraveling = false

wait(2)

DeloreanSFX:remove()

end

function InitiateTimeBoards(mouse)
mouse.Button1Down:connect(function() TimeTravel(mouse) end)
end

FluxCapacitor.Selected:connect(InitiateTimeBoards)

