			<Item class="Script" referent="RBX8017">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">TemporaryGUIRemovalScript</string>
					<ProtectedString name="Source">local IsEnabled = true

local Player = script.Parent.Parent.Parent
local Character = script.Parent.Parent.Parent.Character
local Humanoid = Character.Humanoid
local CPU = game.Workspace:findFirstChild(&quot;[[CentralProcessingUnitV.3]]&quot;)
local ToolGUI = script.Parent
local ToolName = script.ToolName

wait(1)

while true do

wait(0)

if Character:findFirstChild(ToolName.Value) == nil then
game:GetService(&quot;Debris&quot;):AddItem(ToolGUI, 0.1)
break
end

end
</ProtectedString>
				</Properties>
