function onButton1Down(mouse)
local SystemSFX = Instance.new(&quot;Sound&quot;)
SystemSFX.Name = &quot;SystemSFX&quot;
SystemSFX.SoundId = &quot;rbxasset://sounds\\switch.wav&quot;
SystemSFX.Volume = 1
SystemSFX.Pitch = 1
SystemSFX.Parent = script.Parent.Parent.Parent.Character.Torso
game:GetService(&quot;Debris&quot;):AddItem(SystemSFX, 5)
SystemSFX:Play()
targ = mouse.Target
if targ == nil or targ.Locked == true then
RussellInTheHole.TextBoxGUI.Text = &quot;Brick Properties&quot;
if SelectedBrick ~= nil then
SelectedBrick.BrickColor = SelectedBrickOriginalColor
SelectedBrick = nil
SelectedBrickOriginalColor = nil
end
T = 0
R = 0
C = true
RussellInTheHole.ReloadButtonGUI1.Text = &quot;???&quot;
RussellInTheHole.ReloadButtonGUI2.Text = &quot;???&quot;
RussellInTheHole.ReloadButtonGUI3.Text = &quot;???&quot;
return end
if targ.Locked == false and (targ.Position - script.Parent.Parent.Parent.Character.Head.Position).Magnitude &lt; 60 then
if targ ~= SelectedBrick then
if SelectedBrick ~= nil then
SelectedBrick.BrickColor = SelectedBrickOriginalColor
SelectedBrick = nil
SelectedBrickOriginalColor = nil
end
SelectedBrick = targ
SelectedBrickOriginalColor = targ.BrickColor
if targ.BrickColor ~= HighLightColor then
targ.BrickColor = HighLightColor
else
targ.BrickColor = HighLightColor2
end
end
RussellInTheHole.TextBoxGUI.Text = &quot;&apos;&quot;..SelectedBrick.Name..&quot;&apos;&quot;
T = targ.Transparency
R = targ.Reflectance
--[[if targ.Transparency &lt;= 0 then
RussellInTheHole.ReloadButtonGUI1.Text = 0
end
if targ.Transparency &gt; 0 and targ.Transparency &lt;  then
RussellInTheHole.ReloadButtonGUI1.Text = 0
end]]
RussellInTheHole.ReloadButtonGUI1.Text = &quot;&quot;..targ.Transparency..&quot;&quot;
RussellInTheHole.ReloadButtonGUI2.Text = &quot;&quot;..targ.Reflectance..&quot;&quot;
if targ.CanCollide == true then
C = true
RussellInTheHole.ReloadButtonGUI3.Text = &quot;Yes&quot;
else
C = false
RussellInTheHole.ReloadButtonGUI3.Text = &quot;No&quot;
end
return end
end

function ToggleCollide()

if RussellInTheHole.ReloadButtonGUI3.Text == &quot;Yes&quot; then
RussellInTheHole.ReloadButtonGUI3.Text = &quot;No&quot;
return end

if RussellInTheHole.ReloadButtonGUI3.Text == &quot;No&quot; then
RussellInTheHole.ReloadButtonGUI3.Text = &quot;Yes&quot;
return end

end

function ApplyChanges()

local SystemSFX = Instance.new(&quot;Sound&quot;)
SystemSFX.Name = &quot;SystemSFX&quot;
SystemSFX.SoundId = &quot;rbxasset://sounds\\switch.wav&quot;
SystemSFX.Volume = 1
SystemSFX.Pitch = 1
SystemSFX.Parent = script.Parent.Parent.Parent.Character.Torso
game:GetService(&quot;Debris&quot;):AddItem(SystemSFX, 5)
SystemSFX:Play()

if SelectedBrick == nil or SelectedBrick.Parent == nil then
SelectedBrick = nil
RussellInTheHole.TextBoxGUI.Text = &quot;Brick Properties&quot;
if RussellInTheHole.ReloadButtonGUI4.Text == &quot;Select A Brick First!&quot; then return end
RussellInTheHole.ReloadButtonGUI4.Text = &quot;Select A Brick First!&quot;
wait(1)
if RussellInTheHole == nil or RussellInTheHole.Parent == nil then return end
RussellInTheHole.ReloadButtonGUI4.Text = &quot;Apply Changes&quot;
return end

script.Parent.ValueChecker1.Value = RussellInTheHole.ReloadButtonGUI1.Text

if script.Parent.ValueChecker1.Value &lt;= 0.95 then
targ.Transparency = RussellInTheHole.ReloadButtonGUI1.Text
else
local KronosRox = true
if KronosRox == true then
if RussellInTheHole.TextBoxGUI2.Visible == true then return end
RussellInTheHole.TextBoxGUI2.Visible = true
wait(4)
if RussellInTheHole == nil or RussellInTheHole.Parent == nil then return end
RussellInTheHole.TextBoxGUI2.Visible = false
return end
end

targ.Reflectance = RussellInTheHole.ReloadButtonGUI2.Text

if RussellInTheHole.ReloadButtonGUI3.Text == &quot;Yes&quot; then
targ.CanCollide = true
else
targ.CanCollide = false
end

end

