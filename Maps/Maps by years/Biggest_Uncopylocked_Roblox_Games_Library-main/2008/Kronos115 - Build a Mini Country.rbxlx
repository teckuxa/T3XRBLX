						<string name="Name">Deadly</string>
						<ProtectedString name="Source">function onTouched(hit)
&#9;local human = hit.Parent:findFirstChild(&quot;Zombie&quot;)
&#9;if (human ~= nil) then
&#9;&#9;human.Health = human.Health - 25
&#9;end
end

--if (script.Parent ~= nil) and (script.Parent.className == &quot;Part&quot;) then --Work if in a block
--&#9;connection = script.Parent.Touched:connect(onTouched)
--end
script.Parent.Touched:connect(onTouched)
</ProtectedString>
