					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">ToolRemovalScript</string>
					<ProtectedString name="Source">local Tool = script.Parent

function Unequipped()
if Tool.Parent.Name == &quot;Workspace&quot; then

local DeleteTool = true

for PlayerCheck = 1,10 do
if DeleteTool == true then
wait(2)
end
if Tool.Parent.Name ~= &quot;Workspace&quot; then
DeleteTool = false
end
end

if DeleteTool == true then
game:GetService(&quot;Debris&quot;):AddItem(Tool, 0)
end

end
end

Tool.Unequipped:connect(Unequipped)

if Tool.Parent.Name == &quot;Workspace&quot; then

local DeleteTool = true

for PlayerCheck = 1,30 do
if DeleteTool == true then
wait(2)
end
if Tool.Parent.Name ~= &quot;Workspace&quot; then
DeleteTool = false
end
end

if DeleteTool == true then
game:GetService(&quot;Debris&quot;):AddItem(Tool, 0)
end

end
