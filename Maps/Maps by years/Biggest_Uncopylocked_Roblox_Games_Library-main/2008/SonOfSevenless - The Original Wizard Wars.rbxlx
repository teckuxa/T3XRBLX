						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">BridgeScript</string>
						<string name="Source">&#13;&#10;local bodyforce = script.Parent.Drawbridge.BodyForce&#13;&#10;&#13;&#10;local debounce = false&#13;&#10;&#13;&#10;&#13;&#10;function onTouchedUp(hit)&#13;&#10;&#9;print(&quot;Touched Up&quot;)&#13;&#10;&#9;local humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;)&#13;&#10;&#9;if humanoid~=nil and debounce == false then&#13;&#10;&#9;&#9;debounce = true&#13;&#10;&#9;&#9;bodyforce.force = Vector3.new(0,180000,0)&#13;&#10;&#9;&#9;wait(5)&#13;&#10;&#9;&#9;debounce = false&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#13;&#10;function onTouchedDown(hit)&#13;&#10;&#9;print(&quot;Touched Down&quot;)&#13;&#10;&#9;local humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;)&#13;&#10;&#9;if humanoid~=nil and debounce == false then&#13;&#10;&#9;&#9;debounce = true&#13;&#10;&#9;&#9;bodyforce.force = Vector3.new(0,0,0)&#13;&#10;&#9;&#9;wait(5)&#13;&#10;&#9;&#9;debounce = false&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;script.Parent.BridgeDown.Touched:connect(onTouchedDown)&#13;&#10;script.Parent.BridgeUp.Touched:connect(onTouchedUp)&#13;&#10;&#13;&#10;&#13;&#10;</string>
						<bool name="archivable">true</bool>
					</Properties>
