		<Item class="Script" referent="RBX1915">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">ManaRegen</string>
				<string name="Source">local wizardShirt = &quot;http://www.roblox.com/asset/?version=1&amp;id=1157047&quot;&#13;&#10;local battlemageShirt = &quot;http://www.roblox.com/asset/?version=1&amp;id=1161248&quot;&#13;&#10;local apprenticeShirt = &quot;http://www.roblox.com/asset/?version=1&amp;id=1161246&quot;&#13;&#10;&#13;&#10;&#13;&#10;function hasShirt(shirtType, player)&#13;&#10;&#9;local char = player.Character&#13;&#10;&#9;if (char == nil) then return false end&#13;&#10;&#13;&#10;&#9;local shirt = char:findFirstChild(&quot;Shirt Graphic&quot;)&#13;&#10;&#9;if (shirt == nil) then return false end&#13;&#10;&#13;&#10;&#9;if (shirt.Graphic == shirtType) then&#13;&#10;&#9;&#9;return true&#13;&#10;&#9;end&#13;&#10;&#13;&#10;&#9;return false&#13;&#10;end&#13;&#10;&#13;&#10;function minLevel(player)&#13;&#10;&#9;if (hasShirt(apprenticeShirt, player)) then return 5 end&#13;&#10;&#9;if (hasShirt(wizardShirt, player)) then return 5 end&#13;&#10;&#9;if (hasShirt(battlemageShirt, player)) then return 20 end&#13;&#10;&#9;return 1&#13;&#10;end&#13;&#10;&#13;&#10;&#13;&#10;function testForSetLevel(player)&#13;&#10;&#9;local stats = player:findFirstChild(&quot;leaderstats&quot;)&#13;&#10;&#9;if stats == nil then return end&#13;&#10;&#9;local level = stats:findFirstChild(&quot;Level&quot;)&#13;&#10;&#9;if level == nil then return end&#13;&#10;&#13;&#10;&#9;&#13;&#10;&#9;if (level.Value &lt; minLevel(player)) then&#13;&#10;&#9;&#9;level.Value = minLevel(player)&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;function GetMaxMana(level)&#13;&#10;&#9;return level * 20&#13;&#10;end&#13;&#10;&#13;&#10;function GetManaRegenRate(player, level)&#13;&#10;&#13;&#10;&#9;local r = 0&#13;&#10;&#9;if (level &lt; 5) then&#13;&#10;&#9;&#9;r = level&#13;&#10;&#9;else&#13;&#10;&#9;&#9;r = 5&#13;&#10;&#9;end&#13;&#10;&#13;&#10;&#9;if (hasShirt(wizardShirt, player) or hasShirt(battlemageShirt, player)) then r = r * 2 end&#13;&#10;&#13;&#10;&#9;return r&#13;&#10;&#9;&#13;&#10;end&#13;&#10;&#13;&#10;function RegenMana(player)&#13;&#10;&#9;-- make sure this player has the wizard board stats&#13;&#10;&#9;local stats = player:findFirstChild(&quot;leaderstats&quot;)&#13;&#10;&#9;if stats == nil then return end&#13;&#10;&#9;local mana = stats:findFirstChild(&quot;Mana&quot;)&#13;&#10;&#9;local level = stats:findFirstChild(&quot;Level&quot;)&#13;&#10;&#9;if mana == nil or level == nil then return end&#13;&#10;&#13;&#10;&#9;&#13;&#10;&#9;if (mana.Value &lt; GetMaxMana(level.Value)) then&#13;&#10;&#9;&#9;mana.Value = mana.Value + GetManaRegenRate(player, level.Value)&#13;&#10;&#9;end&#13;&#10;&#13;&#10;&#9;if (math.random(1, 25 * level.Value) == 12) then &#13;&#10;&#9;&#9;level.Value = level.Value + 1&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#13;&#10;&#13;&#10;while true do&#13;&#10;&#9;wait(2)&#13;&#10;&#9;&#13;&#10;&#9;local players = game.Players:children()&#13;&#10;&#9;for i =1,#players do&#13;&#10;&#9;&#9;RegenMana(players[i])&#13;&#10;&#9;&#9;testForSetLevel(players[i])&#13;&#10;&#9;end&#13;&#10;end</string>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX1916">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">StopSpawnCampingNoobs</string>
				<string name="Source">print(&quot;Random spawn script version 2.00 loaded&quot;)&#13;&#10;&#13;&#10;function onPlayerEntered(newPlayer)&#13;&#10;&#13;&#10;&#9;-- start to listen for new humanoid&#13;&#10;&#9;newPlayer.Changed:connect(function(property) onPlayerPropChanged(property, newPlayer) end )&#13;&#10;&#13;&#10;&#9;onPlayerRespawn(newPlayer)&#13;&#10;&#13;&#10;end&#13;&#10;&#13;&#10;&#13;&#10;function onPlayerPropChanged(property, player)&#13;&#10;&#9;if property == &quot;Character&quot; then&#13;&#10;&#9;&#9;onPlayerRespawn(player)&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#13;&#10;&#13;&#10;function onPlayerRespawn(player)&#13;&#10;&#9;&#13;&#10;&#9;-- only interested in events where the player gets a new character&#13;&#10;&#9;if player.Character == nil then return end&#13;&#10;&#13;&#10;&#9;local x = math.random(-200, 200)&#13;&#10;&#9;local z = math.random(-200, 200)&#13;&#10;&#9;local y = 50 + math.random(0, 20)&#13;&#10;&#13;&#10;&#9;local char = player.Character.Torso&#13;&#10;&#13;&#10;&#9;local cf = char.CFrame&#13;&#10;&#13;&#10;&#9;local lx = 0&#13;&#10;&#9;local ly = y&#13;&#10;&#9;local lz = 0&#13;&#10;&#13;&#10;&#9;char.CFrame = CFrame.new(Vector3.new(x,y,z), Vector3.new(lx,ly,lz))&#13;&#10;&#13;&#10;&#9;--player.Character:move(Vector3.new(x,y,z))&#13;&#10;&#9;&#13;&#10;end&#13;&#10;&#13;&#10;&#13;&#10;game.Players.ChildAdded:connect(onPlayerEntered)</string>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX1917">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Commands</string>
				<string name="Source">-- SonOfSevenless&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;function onChatted(msg, recipient, speaker)&#13;&#10;&#13;&#10;&#9;-- convert to all lower case&#13;&#10;&#13;&#10;&#9;local source = string.lower(speaker.Name)&#13;&#10;&#9;msg = string.lower(msg)&#13;&#10;&#13;&#10;&#9;&#13;&#10;&#9;-- make sure this player has the wizard board stats&#13;&#10;&#9;local stats = speaker:findFirstChild(&quot;leaderstats&quot;)&#13;&#10;&#9;if stats == nil then return end&#13;&#10;&#9;local mana = stats:findFirstChild(&quot;Mana&quot;)&#13;&#10;&#9;local level = stats:findFirstChild(&quot;Level&quot;)&#13;&#10;&#9;if mana == nil or level == nil then return end&#13;&#10;&#13;&#10;&#9;&#13;&#10;&#13;&#10;&#9;if (msg == &quot;day&quot;) then&#13;&#10;&#9;&#9;game.Lighting.TimeOfDay = &quot;16:32:00&quot;&#13;&#10;&#9;end&#13;&#10;&#9;&#13;&#10;&#13;&#10;&#9;if (msg == &quot;night&quot;) then&#13;&#10;&#9;&#9;game.Lighting.TimeOfDay = &quot;00:00:00&quot;&#13;&#10;&#9;end&#13;&#10;&#13;&#10;&#9;-- Below is only for me&#13;&#10;&#9;if (source ~= &quot;sonofsevenless&quot;) then return end&#13;&#10;&#13;&#10;&#9;if (msg == &quot;kill&quot;) then&#13;&#10;&#9;&#9;local m = Instance.new(&quot;Message&quot;)&#13;&#10;&#9;&#9;m.Text = &quot;A dark wind blows...&quot;&#13;&#10;&#9;&#9;m.Parent = game.Workspace&#13;&#10;&#9;&#9;wait(4)&#13;&#10;&#9;&#9;local c = game.Players:children()&#13;&#10;&#9;&#9;for i=1,#c do&#13;&#10;&#9;&#9;&#9;if (string.lower(c[i].Name) ~= &quot;sonofsevenless&quot;) then&#13;&#10;&#9;&#9;&#9;&#9;if (c[i].Character ~= nil and c[i].Character.Humanoid ~= nil) then&#13;&#10;&#9;&#9;&#9;&#9;&#9;c[i].Character.Humanoid.Health = 0&#13;&#10;&#9;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;end&#13;&#10;&#9;&#9;wait(2)&#13;&#10;&#9;&#9;m.Parent = nil&#13;&#10;&#9;end&#13;&#10;&#13;&#10;&#9;if (msg == &quot;deplorable&quot;) then&#13;&#10;&#9;&#9;local m = Instance.new(&quot;Message&quot;)&#13;&#10;&#9;&#9;m.Text = &quot;SOS spake the Deplorable Word!&quot;&#13;&#10;&#9;&#9;m.Parent = game.Workspace&#13;&#10;&#9;&#9;wait(4)&#13;&#10;&#9;&#9;for i=1,100 do&#13;&#10;&#9;&#9;&#9;local x = math.random(-200,200)&#13;&#10;&#9;&#9;&#9;local z = math.random(-200,200)&#13;&#10;&#9;&#9;&#9;local y = math.random(0,40)&#13;&#10;&#13;&#10;&#9;&#9;&#9;local r = math.random(6,16)&#13;&#10;&#13;&#10;&#9;&#9;&#9;local ex = Instance.new(&quot;Explosion&quot;)&#13;&#10;&#9;&#9;&#9;ex.Position = Vector3.new(x,y,z)&#13;&#10;&#9;&#9;&#9;ex.BlastRadius = r&#13;&#10;&#9;&#9;&#9;ex.Parent = game.Workspace&#13;&#10;&#9;&#9;&#9;wait(.05)&#13;&#10;&#9;&#9;end&#13;&#10;&#9;&#9;wait(2)&#13;&#10;&#9;&#9;m.Parent = nil&#13;&#10;&#9;end&#13;&#10;&#13;&#10;&#9;if (msg == &quot;levelall&quot;) then&#13;&#10;&#9;&#9;local m = Instance.new(&quot;Message&quot;)&#13;&#10;&#9;&#9;m.Text = &quot;Level Up!&quot;&#13;&#10;&#9;&#9;m.Parent = game.Workspace&#13;&#10;&#9;&#9;wait(4)&#13;&#10;&#9;&#9;local c = game.Players:children()&#13;&#10;&#9;&#9;for i=1,#c do&#13;&#10;&#9;&#9;&#9;local stats = c[i]:findFirstChild(&quot;leaderstats&quot;)&#13;&#10;&#9;&#9;&#9;if (stats ~= nil) then&#13;&#10;&#9;&#9;&#9;&#9;local lvl = stats:findFirstChild(&quot;Level&quot;)&#13;&#10;&#9;&#9;&#9;&#9;if (lvl ~= nil) then&#13;&#10;&#9;&#9;&#9;&#9;&#9;lvl.Value = lvl.Value + 1&#13;&#10;&#9;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;end&#13;&#10;&#9;&#9;wait(2)&#13;&#10;&#9;&#9;m.Parent = nil&#13;&#10;&#9;end&#13;&#10;&#13;&#10;&#13;&#10;end&#13;&#10;&#13;&#10;function onPlayerEntered(newPlayer)&#13;&#10;&#9;newPlayer.Chatted:connect(function(msg, recipient) onChatted(msg, recipient, newPlayer) end) &#13;&#10;end&#13;&#10;&#13;&#10;game.Players.ChildAdded:connect(onPlayerEntered)</string>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
