		<Item class="Script" referent="RBX7">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">RegenerationStation</string>
				<string name="Source">local stuff = game.Workspace.Castle:clone()&#13;&#10;local banditstuff = game.Workspace.BanditStuff:clone()&#13;&#10;local cats = {&quot;Catapult1&quot;, &quot;Catapult2&quot;, &quot;Catapult3&quot;, &quot;WheelyDealy&quot;}&#13;&#10;local catClones = {game.Workspace.Catapult1:clone(), game.Workspace.Catapult2:clone(), game.Workspace.Catapult3:clone(), game.Workspace.WheelyDealy:clone()}&#13;&#10;local catToRegen = 1&#13;&#10;&#13;&#10;message = nil&#13;&#10;function showMessage(text)&#13;&#10;&#9;-- This function flashes a message to all players&#13;&#10;&#9;-- Clear the message with hideMessage()&#13;&#10;&#13;&#10;&#9;hideMessage() -- Never show more than one message at a time&#13;&#10;&#9;if message == nil then message = Instance.new(&quot;Message&quot;) end -- only make a message if we don&apos;t have a message object lying around&#13;&#10;&#9;message.Text = text&#13;&#10;&#9;message.Parent = game.Workspace&#13;&#10;end&#13;&#10;&#13;&#10;function hideMessage()&#13;&#10;&#9;if message == nil then return end&#13;&#10;&#9;message.Parent = nil&#13;&#10;end&#13;&#10;&#13;&#10;function RegenACat()&#13;&#10;&#9;if (catToRegen &gt; #cats) then catToRegen = 1 end&#13;&#10;&#13;&#10;&#9;local cat = game.Workspace:findFirstChild(cats[catToRegen])&#13;&#10;&#9;cat:remove()&#13;&#10;&#9;local new_cat = catClones[catToRegen]:clone()&#13;&#10;&#9;new_cat.Parent = game.Workspace&#13;&#10;&#9;new_cat:makeJoints()&#13;&#10;&#13;&#10;&#9;catToRegen = catToRegen + 1&#13;&#10;end&#13;&#10;&#13;&#10;function Regen()&#13;&#10;&#9;game.Workspace.Castle:remove()&#13;&#10;&#9;local new_stuff = stuff:clone()&#13;&#10;&#9;new_stuff.Parent = game.Workspace&#13;&#10;&#9;new_stuff:makeJoints()&#13;&#10;&#13;&#10;&#9;--game.Workspace.BanditStuff:remove()&#13;&#10;&#9;--new_stuff = banditstuff:clone()&#13;&#10;&#9;--new_stuff.Parent = game.Workspace&#13;&#10;&#9;--new_stuff:makeJoints()&#13;&#10;end&#13;&#10;&#13;&#10;&#13;&#10;local game_time = 0&#13;&#10;while true do&#13;&#10;&#9;wait(20)&#13;&#10;&#13;&#10;&#9;game_time = game_time + 20&#13;&#10;&#13;&#10;&#9;if (game_time &gt; 300) then&#13;&#10;&#9;&#9;Regen()&#13;&#10;&#9;&#9;game_time = 0&#13;&#10;&#9;else&#13;&#10;&#9;&#9;RegenACat()&#13;&#10;&#9;end&#13;&#10;&#9;&#13;&#10;&#13;&#10;end</string>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
