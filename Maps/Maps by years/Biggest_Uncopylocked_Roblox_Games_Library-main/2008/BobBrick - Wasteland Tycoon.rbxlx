&#9;&#9;&#9;&#9;Y.C0 = CFrame.new(0, 0, 0)
&#9;&#9;&#9;&#9;Y.Parent = Y.Part0
&#9;&#9;end

&#9;&#9;local h = g:GetChildren()
&#9;&#9;for i = 1, # h do
&#9;&#9;&#9;h[i].Anchored = false
&#9;&#9;&#9;h[i].CanCollide = false
&#9;&#9;end
&#9;&#9;
&#9;end

&#9;if hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil and hit.Parent:findFirstChild(&quot;Arm2&quot;) == nil then
