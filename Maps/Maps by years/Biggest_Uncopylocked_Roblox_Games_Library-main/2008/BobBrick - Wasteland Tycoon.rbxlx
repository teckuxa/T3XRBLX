							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<ProtectedString name="Source">name = script.Parent
owner = name.Parent.OwnerName

while true do
if owner.Value ~= &quot;&quot; then
name.Name = &quot;Owner : &quot; .. owner.Value
else
name.Name = &quot;Owner : No One&quot;
end
wait(2)
end
</ProtectedString>
							</Properties>
						</Item>
					</Item>
					<Item class="Script" referent="RBX5985">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">ObjectsAndOwnerHandling</string>
							<ProtectedString name="Source">owner = script.Parent.OwnerName
local newfacpara = script.Parent.Parent
local factoryBackup = script.Parent.Parent.SaveTycoon
factory = script.Parent
stuff = factory.Stuff

if factoryBackup.Value == nil then  --If the factory hasn&apos;t been stored yet (Game just started)

&#9;B = Instance.new(&quot;Model&quot;)
&#9;B.Name = &quot;[Wargod99] Tycoon Kit [ItemId: &quot; ..math.random(1,10000).. &quot;]&quot;
&#9;B.Parent = game.Lighting
&#9;A = script.Parent:Clone()
&#9;A.Parent = B
&#9;factoryBackup.Value = A
&#9;items = script.Parent:GetChildren()
&#9;for i = 1, #items do
&#9;local founditem = script.Parent.Stuff:FindFirstChild(items[i].Name)
&#9;if founditem ~= nil and founditem.className == &quot;ObjectValue&quot; then
&#9;founditem.Value = items[i]
&#9;items[i].Parent = B
&#9;end
&#9;end
end
wait(1)
while script.Parent ~= nil do
&#9;if owner.Value ~= &quot;&quot; then
&#9;print (&quot;Owner: &quot; ..owner.Value)
&#9;&#9;local navn = owner.Value
&#9;&#9;leaver = game.Players:FindFirstChild(navn)
&#9;&#9;if leaver == nil then
&#9;&#9;&#9;print (&quot;Reset&quot;)
&#9;&#9;&#9;items = script.Parent.Stuff:GetChildren()
&#9;&#9;&#9;for i = 1, #items do
&#9;&#9;&#9;if items[i].className == &quot;ObjectValue&quot; and items[i].Value ~= nil then
&#9;&#9;&#9;items[i].Value:Remove()
&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;owner.Value = &quot;&quot;
&#9;&#9;&#9;MajorReset = factoryBackup.Value:Clone()
&#9;&#9;&#9;script.Parent.Parent.SaveTycoon.Value:remove()
&#9;&#9;&#9;factoryBackup.Value = nil
&#9;&#9;&#9;script.Parent:remove()
&#9;&#9;&#9;MajorReset.Parent = newfacpara
&#9;&#9;&#9;MajorReset:MakeJoints()
&#9;&#9;end
&#9;else
&#9;print (&quot;No Owner&quot;)
&#9;end
&#9;wait(2)
end
</ProtectedString>
