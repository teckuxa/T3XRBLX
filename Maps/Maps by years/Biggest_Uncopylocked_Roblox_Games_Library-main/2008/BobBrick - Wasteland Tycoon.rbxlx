				<Item class="Script" referent="RBX8579">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">-- EdduTheArdo&apos;s Transforming Script

local head = script.Parent
local sound = head:findFirstChild(&quot;Victory&quot;)

function onTouched(part)
&#9;local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;if h~=nil then
sound:play()
part.Parent:findFirstChild(&quot;Head&quot;).Transparency = 0 
part.Parent:findFirstChild(&quot;Torso&quot;).Transparency = 0
part.Parent:findFirstChild(&quot;Left Arm&quot;).Transparency = 0
part.Parent:findFirstChild(&quot;Right Arm&quot;).Transparency = 0
part.Parent:findFirstChild(&quot;Left Leg&quot;).Transparency = 0 
part.Parent:findFirstChild(&quot;Right Leg&quot;).Transparency = 0
part.Parent:findFirstChild(&quot;Right Leg&quot;).CanCollide = false
part.Parent:findFirstChild(&quot;Left Leg&quot;).CanCollide = false
part.Parent:findFirstChild(&quot;Right Arm&quot;).CanCollide = false
part.Parent:findFirstChild(&quot;Left Arm&quot;).CanCollide = false
part.Parent:findFirstChild(&quot;Torso&quot;).CanCollide = false
part.Parent:findFirstChild(&quot;Head&quot;).CanCollide = false
part.Parent:findFirstChild(&quot;Head&quot;).BrickColor = BrickColor.new(208)
part.Parent:findFirstChild(&quot;Head&quot;).Reflectance = 0
part.Parent:findFirstChild(&quot;Torso&quot;).Reflectance = 0
part.Parent:findFirstChild(&quot;Right Arm&quot;).Reflectance = 0
part.Parent:findFirstChild(&quot;Left Arm&quot;).Reflectance = 0
part.Parent:findFirstChild(&quot;Left Leg&quot;).Reflectance = 0
part.Parent:findFirstChild(&quot;Right Leg&quot;).Reflectance = 0
&#9;end
end

script.Parent.Touched:connect(onTouched)</ProtectedString>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX8580">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">InvisiScript</string>
						<ProtectedString name="Source">function onTouch(part) 
local human = part.Parent:findFirstChild(&quot;Humanoid&quot;) 
if human ~= nil then 
part.Parent:findFirstChild(&quot;Head&quot;).Transparency = 1 -- 0 = visible, 0.5 = Half invisible, 1 = Invisible. Change to the number you want.
part.Parent:findFirstChild(&quot;Torso&quot;).Transparency = 1
part.Parent:findFirstChild(&quot;Left Arm&quot;).Transparency = 1
part.Parent:findFirstChild(&quot;Right Arm&quot;).Transparency = 1
part.Parent:findFirstChild(&quot;Left Leg&quot;).Transparency = 1
part.Parent:findFirstChild(&quot;Right Leg&quot;).Transparency = 1 
if part.Parent:findFirstChild(&quot;Head&quot;):findFirstChild(&quot;face&quot;) == nil then return end
part.Parent:findFirstChild(&quot;Head&quot;):findFirstChild(&quot;face&quot;):remove() -- removes face so they won&apos;t see it
if part.Parent:findFirstChild(&quot;Torso&quot;):findFirstChild(&quot;roblox&quot;) == nil then return end
part.Parent:findFirstChild(&quot;Torso&quot;):findFirstChild(&quot;roblox&quot;):remove() -- removes T-shirt
end 
end 
script.Parent.Touched:connect(onTouch) 
</ProtectedString>
