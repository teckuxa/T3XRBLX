								<string name="Name">InvisiHat</string>
								<ProtectedString name="Source">function onClicked()
&#9;local d = script.Parent.Parent.Parent.Parent.Parent.Parent.Character:GetChildren() 
&#9;for i=1, #d do 
&#9;&#9;if (d[i].className == &quot;Hat&quot;) then 
&#9;&#9;&#9;d[i]:findFirstChild(&quot;Handle&quot;).Transparency = 1
&#9;&#9;end 
&#9;end
end 

