					<string name="Name">Script</string>
					<ProtectedString name="Source">wl = script.Parent
function onTouched(hit)
        wait(.1)&#9;
&#9;wl.Transparency = .1
        wait(.1)
&#9;wl.Transparency = .2
        wait(.1)
&#9;wl.Transparency = .3
        wait(.1)
&#9;wl.Transparency = .4
        wait(.1)
&#9;wl.Transparency = .5
        wait(.1)
&#9;wl.Transparency = .6
        wait(.1)
&#9;wl.Transparency = .7
        wait(.1)
&#9;wl.Transparency = .8
        wait(.1)
&#9;wl.Transparency = .9
        wait(.1)
&#9;wl.Transparency = 1
&#9;wl.CanCollide = false
&#9;wait(39)
&#9;wl.Transparency = 0
&#9;wl.CanCollide = true
end

script.Parent.Touched:connect (onTouched)</ProtectedString>
