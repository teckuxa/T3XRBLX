				<Item class="IntValue" referent="RBX2399">
					<Properties>
						<string name="Name">Boosters</string>
						<int name="Value">0</int>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
				<Item class="IntValue" referent="RBX2400">
