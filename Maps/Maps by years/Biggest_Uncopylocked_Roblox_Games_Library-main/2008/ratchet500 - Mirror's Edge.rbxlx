				<Item class="Script" referent="RBX2715">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">force field giver</string>
						<string name="Source">local debounce = false 
function onTouched(part)
	local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if h~=nil and debounce == false then
		debounce = true
		Field = Instance.new(&quot;ForceField&quot;)
		Field.Parent = part.Parent
		wait(4)
		debounce = false
	end
end

if (script.Parent ~= nil) and (script.Parent.className == &quot;Part&quot;) then 
	connection = script.Parent.Touched:connect(onTouched)
end
</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
