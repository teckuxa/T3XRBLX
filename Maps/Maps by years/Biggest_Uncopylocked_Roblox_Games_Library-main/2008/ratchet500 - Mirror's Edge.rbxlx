					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">RemoveTools</string>
					<string name="Source">door = script.Parent

local debounce = false
local co = script.Parent.BrickColor

function onTouch(hit)
	if debounce == true then return end
	if hit.Parent == nil then return end
	local h = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
	if h ~= nil and debounce == false then
		debounce = true
		local c = game.Players:findFirstChild(hit.Parent.Name).Backpack:GetChildren()
		for i = 1,#c do
			if c[i].className == &quot;Tool&quot; or c[i].className == &quot;HopperBin&quot; then
				local gog = game.StarterPack:findFirstChild(c[i].Name)
				if gog == nil then
					c[i]:remove()
					hit.Parent.Torso.Velocity=door.CFrame.lookVector * 100 -- Push the Player back to if he/she have any weapons
				end
			end
		end
		debounce = false
	end

	if h ~= nil and debounce == false then
		debounce = true
		local c = hit.Parent:GetChildren()
		for i = 1,#c do
			if c[i].className == &quot;Tool&quot;  then
				local gog = game.StarterPack:findFirstChild(c[i].Name)
				if gog == nil then
					c[i]:remove()
					hit.Parent.Torso.Velocity=door.CFrame.lookVector * 100 -- Push the Player back to if he/she have any weapons
				end
			end
		end
		debounce = false
	end
end
door.Touched:connect(onTouch)</string>
