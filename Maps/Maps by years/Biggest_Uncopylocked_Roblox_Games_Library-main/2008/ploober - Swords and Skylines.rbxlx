						<ProtectedString name="Source">--  Replace The &quot;??????&quot; With The Messages U Want To Say That Gonna Appear In The Upper Left Corner Of The Screen 
 --  U Can Edit The Time Too
 --  This Script Has Been Bringed To u For xXxGERA17xXx

print(&quot;How to do Admin Commands&quot;)

local debounce = false


function onHit(hit)
	local human = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
	if (human ~= nil) and debounce == false then

                debounce = true

local message = Instance.new(&quot;Message&quot;)
message.Text = &quot;If you are VIP&quot;
message.Parent = game.Players:playerFromCharacter(hit.Parent)
wait(3)
message.Text = &quot;You have admin commands&quot;
wait(3)
message.Text = &quot;say commands to see a list&quot;
wait(3)
message.Text = &quot;also, try walkspeed/me/30&quot;
wait(3)
message.Text = &quot;or shield/me&quot;

message:Remove ()

                debounce = false
	end
end

script.Parent.Touched:connect(onHit)</ProtectedString>
