	la.Reflectance = 0 
	ra.Reflectance = 0 
	ll.Reflectance = 0 
	rl.Reflectance = 0 
        wait(.05)
	t.Reflectance = 1 
	h.Reflectance = 1 
	la.Reflectance = 1 
	ra.Reflectance = 1 
	ll.Reflectance = 1 
	rl.Reflectance = 1 
        wait(.05)
	t.Reflectance = 0 
