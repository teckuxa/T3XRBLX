			<Item class="Script" referent="RBX2481">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Weld Script</string>
					<ProtectedString name="Source">function Weldnow()	
	local w1 = Instance.new(&quot;Weld&quot;)
	w1.Parent = script.Parent.Handle
	w1.Part0 = w1.Parent
	w1.Part1 = script.Parent.H2
	w1.C1 = CFrame.fromEulerAnglesXYZ(0, 0, 0) * CFrame.new(0,0,0)
	
	local w2 = Instance.new(&quot;Weld&quot;)
	w2.Parent = script.Parent.Handle
	w2.Part0 = w1.Parent
	w2.Part1 = script.Parent.H3
	w2.C1 = CFrame.fromEulerAnglesXYZ(0, 0, 0) * CFrame.new(0,0,0)

	local w3 = Instance.new(&quot;Weld&quot;)
	w3.Parent = script.Parent.Handle
	w3.Part0 = w1.Parent
	w3.Part1 = script.Parent.H4
	w3.C1 = CFrame.fromEulerAnglesXYZ(0, 0, 0) * CFrame.new(0, 0,0)

	local w4 = Instance.new(&quot;Weld&quot;)
	w4.Parent = script.Parent.Handle
	w4.Part0 = w1.Parent
	w4.Part1 = script.Parent.ZAP
	w4.C1 = CFrame.fromEulerAnglesXYZ(0, 0, 0) * CFrame.new(0, 0, 0.5)
end
script.Parent.Equipped:connect(Weldnow)
script.Parent.Unequipped:connect(Weldnow)
</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
