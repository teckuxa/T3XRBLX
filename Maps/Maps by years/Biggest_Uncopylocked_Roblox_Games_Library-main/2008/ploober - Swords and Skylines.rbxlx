					<Item class="Script" referent="RBX922">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">FireScript1</string>
							<ProtectedString name="Source">function t(h)
a = h.Parent:findFirstChild(&quot;Zombie&quot;)
if a then
a.Health = a.Health - 12
end
end
script.Parent.touched:connect(t)

wait(3)
script.Parent:remove()</ProtectedString>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
					<Item class="Script" referent="RBX923">
						<Properties>
