				<Item class="Script" referent="RBX1117">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">HellfireScript</string>
						<ProtectedString name="Source">--- SonOfSevenless
print(&quot;Hellfire Spell Loaded&quot;)

local COOLDOWN = 10



bin = script.Parent





function hellfire()

	local player = game.Players.LocalPlayer
	if player == nil or player.Character == nil then return end

	local char = player.Character.Torso



	local booms = 8
	for i = 1,booms do

		local a = i * ((3.14156 * 2) / booms) 
		local x = 22 * math.cos(a)
		local z = 22 * math.sin(a)


		local ex = Instance.new(&quot;Explosion&quot;)
		ex.BlastRadius = 12
		ex.BlastPressure = 20
		ex.Position = Vector3.new(char.CFrame.p.x + x, char.CFrame.p.y, char.CFrame.p.z + z)
		ex.Parent = game.Workspace


	end



end


enabled = true
function onButton1Down(mouse)
	if not enabled then
		return
	end

	local player = game.Players.LocalPlayer
	if player == nil then return end
	

	enabled = false
	mouse.Icon = &quot;rbxasset://textures\\ArrowFarCursor.png&quot;

	-- find the best cf
	local cf = mouse.Hit
	local v = cf.lookVector

	hellfire()

	wait(COOLDOWN)
	mouse.Icon = &quot;rbxasset://textures\\ArrowCursor.png&quot;
	enabled = true

end

function onSelected(mouse)
	mouse.Icon = &quot;rbxasset://textures\\ArrowCursor.png&quot;
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end

bin.Selected:connect(onSelected)

