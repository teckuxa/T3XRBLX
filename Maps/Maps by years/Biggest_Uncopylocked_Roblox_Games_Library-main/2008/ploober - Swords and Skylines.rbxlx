		<Item class="Script" referent="RBX139">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Color Changing Health Script V2</string>
				<ProtectedString name="Source">audio = true --Change this to false if you dont want the sounds of a HeartBeat.
bg = false--Change this to false if you dont want the grey Background.
bgtrans = 0 --Change this to the number of transparency you want for the Background. Ignore if you made background false. Use numbers 0 - 1 (Example: 0.5)

--\\BY ALEXNEWTRON--DO NOT MESS WITH ANYTHING IN THE SCRIPT OR IT WILL BREAK. THANK YOU//--
--make sure its all set before checking values
script.ChildSpawn.HealthGUI.Tray.audio.Value = true
script.ChildSpawn.HealthGUI.Tray.BG.Visible = true
script.ChildSpawn.HealthGUI.Tray.BG.BackgroundTransparency = bgtrans
if audio == true then
script.ChildSpawn.HealthGUI.Tray.audio.Value = true
elseif audio == false then
script.ChildSpawn.HealthGUI.Tray.audio.Value = false
else
script.ChildSpawn.HealthGUI.Tray.audio.Value = true
end
if bg == true then
--nothing to do
elseif bg == false then
script.ChildSpawn.HealthGUI.Tray.BG.Visible = false
else
--still nothing to do
end
function onConnect(newPlayer)
m = script.ChildSpawn:Clone()
m.Parent = game.Workspace
m.name.Value = newPlayer.Name
end
game.Players.ChildAdded:connect(onConnect)

function onPlayerExit(player)
local people = game.Workspace:GetChildren()
for i = 1, #people do 
if people[i].Name == &quot;ChildSpawn&quot; then
if ChildSpawn.name.Value == player.Name then
people[i]:remove()
end
end
end
end
game.Players.PlayerRemoving:connect(onPlayerExit)

--check if theres already players in server
local people = game.Workspace:GetChildren()
for i = 1, #people do 
if people[i].Name == &quot;ChildSpawn&quot; then
people[i]:remove() 
end
end
wait(2)
local people = game.Players:GetChildren()
for i = 1, #people do
q = script.ChildSpawn:Clone()
q.Parent = game.Workspace
q.name.Value = people[i].Name
end
--\\BY ALEXNEWTRON--DO NOT MESS WITH ANYTHING IN THE SCRIPT OR IT WILL BREAK. THANK YOU//--</ProtectedString>
				<bool name="archivable">true</bool>
			</Properties>
			<Item class="Script" referent="RBX140">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">ChildSpawn</string>
					<ProtectedString name="Source">--\\BY ALEXNEWTRON--DO NOT MESS WITH ANYTHING IN THE SCRIPT OR IT WILL BREAK. THANK YOU//--
wait(2) --wait for character
--already do it
name = script.name.Value
if game.Players[name].Character:findFirstChild(&quot;NewHealthScript&quot;) then
game.Players[name].Character.NewHealthScript:remove()
--ROBLOX SUCKY SCRIPT REMOVED!
end
if game.Players[name].Character:findFirstChild(&quot;HealthScript v2.0&quot;) then
game.Players[name].Character[&quot;HealthScript v2.0&quot;]:remove()
--ROBLOX SUCKY SCRIPT REMOVED!
end
if game.Players[name].PlayerGui:findFirstChild(&quot;RobloxStatusGUI&quot;) then
game.Players[name].PlayerGui.RobloxStatusGUI:remove()
--ROBLOX SUCKY GUI REMOVED!
end
if game.Players[name].PlayerGui:findFirstChild(&quot;HealthGUI&quot;) then
game.Players[name].PlayerGui.HealthGUI:remove()
--ROBLOX SUCKY GUI REMOVED!
end
--add new gui
l = script.HealthGUI:Clone()
l.Parent = game.Players[name].PlayerGui
--ADDED EPIC GUI
--add new health script into player
n = script.NewHealthScript:Clone()
n.Parent = game.Players[name].Character
--ADDED SPECIAL SCRIPT
function onSpawn()
local name = script.name.Value
if game.Players[name].Character:findFirstChild(&quot;NewHealthScript&quot;) then
game.Players[name].Character.NewHealthScript:remove()
--ROBLOX SUCKY SCRIPT REMOVED!
end
if game.Players[name].Character:findFirstChild(&quot;HealthScript v2.0&quot;) then
game.Players[name].Character[&quot;HealthScript v2.0&quot;]:remove()
--ROBLOX SUCKY SCRIPT REMOVED!
end
if game.Players[name].PlayerGui:findFirstChild(&quot;RobloxStatusGUI&quot;) then
game.Players[name].PlayerGui.RobloxStatusGUI:remove()
--ROBLOX SUCKY GUI REMOVED!
end
if game.Players[name].PlayerGui:findFirstChild(&quot;HealthGUI&quot;) then
game.Players[name].PlayerGui.HealthGUI:remove()
--ROBLOX SUCKY GUI REMOVED!
end
--add new gui
l = script.HealthGUI:Clone()
l.Parent = game.Players[name].PlayerGui
--ADDED EPIC GUI
--add new health script into player
n = script.NewHealthScript:Clone()
n.Parent = game.Players[name].Character
--ADDED SPECIAL SCRIPT


end
game.Players[script.name.Value].CharacterAdded:connect(onSpawn)
--\\BY ALEXNEWTRON--DO NOT MESS WITH ANYTHING IN THE SCRIPT OR IT WILL BREAK. THANK YOU//--</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
				<Item class="StringValue" referent="RBX141">
					<Properties>
						<string name="Name">name</string>
						<string name="Value"></string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX142">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">NewHealthScript</string>
						<ProtectedString name="Source">--\\BY ALEXNEWTRON--DO NOT MESS WITH ANYTHING IN THE SCRIPT OR IT WILL BREAK. THANK YOU//--
local humanoid = script.Parent.Humanoid

function UpdateGUI(health)
	local pgui = game.Players:GetPlayerFromCharacter(humanoid.Parent).PlayerGui
	local tray = pgui.HealthGUI.Tray
	
	tray.HealthBar.Size = UDim2.new(0.2, 0, 0.8 * (health / humanoid.MaxHealth), 0) 
	tray.HealthBar.Position = UDim2.new(0.4, 0, 0.8 * (1-  (health / humanoid.MaxHealth)) , 0) 
	if script.Parent.Humanoid.Health &lt;= 30 then
		tray.HealthBar.BackgroundColor3 = Color3.new(255/255, 0/255, 0/255)
		--red
		tray.Color.Value = &quot;Red&quot;
	elseif script.Parent.Humanoid.Health &lt;= 70 then
		tray.HealthBar.BackgroundColor3 = Color3.new(255/255, 255/255, 0/255)
		--yellow
		tray.Color.Value = &quot;Yellow&quot;
	elseif script.Parent.Humanoid.Health &gt; 70 then
		tray.HealthBar.BackgroundColor3 = Color3.new(0/255, 255/255, 0/255)
		--green
		tray.Color.Value = &quot;Green&quot;
	end
	if script.Parent.Humanoid.Health == 0 then
		--dead
		tray.Color.Value = &quot;Dead&quot;
	end
end

function HealthChanged(health)
	UpdateGUI(health)
end

humanoid.HealthChanged:connect(HealthChanged)
--\\BY ALEXNEWTRON--DO NOT MESS WITH ANYTHING IN THE SCRIPT OR IT WILL BREAK. THANK YOU//--</ProtectedString>
