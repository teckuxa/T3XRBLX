						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">PaintballShooter</string>
						<ProtectedString name="Source">Tool = script.Parent


function fire(v)

	Tool.Handle.Fire:play()
	

	local vCharacter = Tool.Parent
	local vPlayer = game.Players:playerFromCharacter(vCharacter)

	local missile = Instance.new(&quot;Part&quot;)

        

	local spawnPos = Tool.Barrel.CFrame + Vector3.new(0, .5, 0)

	local mesh = Tool.Mesh:clone()
	


	spawnPos  = spawnPos + (v * 2)

	missile.CFrame = spawnPos
	missile.Size = Vector3.new(1,1,1)
	missile.Velocity = v * 467
	local team = script.Parent.Team
	if team.Value ~= 0 then
		missile.BrickColor = Tool.Parent.Torso.BrickColor
	end
	local tw = Tool.Team:clone()
	tw.Parent = missile
	missile.Shape = 0
	missile.BottomSurface = 0
	missile.TopSurface = 0
	missile.Name = &quot;Paintball&quot;
	missile.Elasticity = 0
	missile.Reflectance = .3
	missile.Friction = 1
	mesh.Parent = missile


	local force = Instance.new(&quot;BodyForce&quot;)
	force.force = Vector3.new(0,100,0)
	force.Parent = missile
	
	local new_script = script.Parent.Paintball:clone()
	new_script.Disabled = false
	new_script.Parent = missile

	local creator_tag = Instance.new(&quot;ObjectValue&quot;)
	creator_tag.Value = vPlayer
	creator_tag.Name = &quot;creator&quot;
	creator_tag.Parent = missile
	


	missile.Parent = game.Workspace	

end


function check(en)
---------------------------------------Function start here.
if (Tool.Enabled == false) then
return false
end--end for if!
-------------------------------
if (Tool.Enabled == true) then
return true
end
---------------------------------------Function end here.
end


Tool.Enabled = true
function onActivated()

	if not Tool.Enabled then
		return
	end
	
	local character = Tool.Parent;
	local bullets = script.Parent.Bullets
	local clips = script.Parent.Clips
	local humanoid = character:findFirstChild(&quot;Humanoid&quot;)
	if humanoid == nil then
		print(&quot;Humanoid not found&quot;)
		return 
	end

	if Tool.Enabled ~= true then return end

	local offsetRatio = {-.01, 0, .01}
	local targetPos = humanoid.TargetPoint
	local lookAt = (targetPos - character.Head.Position).unit
	
	if (check()) and bullets.Value &gt; 0 then
		local offset = (targetPos - character.Head.Position).unit + Vector3.new((offsetRatio[math.random(.1, #offsetRatio)]), (offsetRatio[math.random(.1, #offsetRatio)]), 0)
		fire(offset)
		character.Torso:findFirstChild(&quot;Right Shoulder&quot;).DesiredAngle = 1.7	
		bullets.Value = bullets.Value - 1 
		Tool.Name = (&quot;Glock[&quot;..script.Parent.Bullets.Value..&quot;][&quot;..script.Parent.Clips.Value..&quot;]&quot;)
		wait(0.1)
		onActivated()
	end

	if bullets.Value &lt; 1  and clips.Value &gt; 0 then
		local oldm = game.Players:findFirstChild(humanoid.Parent.Name):findFirstChild(&quot;Message&quot;)
		if oldm ~= nil then 
			oldm:remove()
		end
		local mes = Instance.new(&quot;Message&quot;)		
		mes.Text = (&quot; Press R to Reload&quot;)
		mes.Parent = game.Players:findFirstChild(humanoid.Parent.Name)
		wait(1)
		if mes == nil then return end
		mes:remove()
	end

	if bullets.Value &lt; 1 and clips.Value &lt; 1 then
		local oldm = game.Players:findFirstChild(humanoid.Parent.Name):findFirstChild(&quot;Message&quot;)
		if oldm ~= nil then 
			oldm:remove()
		end
		local mes = Instance.new(&quot;Message&quot;)		
		mes.Text = (&quot;No more ammo.&quot;)
		mes.Parent = game.Players:findFirstChild(humanoid.Parent.Name)
		wait(1)
		if mes == nil then return end
		mes:remove()
	end

	Tool.Name = (&quot;Glock[&quot;..script.Parent.Bullets.Value..&quot;][&quot;..script.Parent.Clips.Value..&quot;]&quot;)

	return
		

	--Tool.Enabled = true
end


script.Parent.Activated:connect(onActivated)
</ProtectedString>
