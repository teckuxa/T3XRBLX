					<Item class="Script" referent="RBX274">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">StatBadgeAwarder</string>
							<ProtectedString name="Source">local BadgeID = 25473875 -- Enter the BadgeID here
local kills = &quot;KOs&quot; -- Enter what stat you want to be needed, Works for anything (eg. KO&apos;s, Points)
local HowMuch = 50 -- Enter how many you want them to have to get the badge
game.Players.PlayerAdded:connect(function(p) 
repeat wait() until p:findFirstChild(&quot;leaderstats&quot;) ~= nil 
p.leaderstats[kills].Changed:connect(function() 
if p.leaderstats[kills].Value &lt;= HowMuch - 1 then return end 
game:GetService(&quot;BadgeService&quot;):AwardBadge(p.userId, BadgeID) 
end) 
end) 

-- Whole script made my Mattomattic</ProtectedString>
