								<ProtectedString name="Source">function onChange()
local health = script.Parent.Parent.Parent.Parent.Character.Humanoid.Health
if health &gt; 50 then 
	script.Parent.ImageLabel.Image = &quot;http://www.roblox.com/asset/?id=10521899&quot;
elseif health &lt;= 50 then
	script.Parent.ImageLabel.Image = &quot;http://www.roblox.com/asset/?id=7918793&quot;
end
if health == 0 then
script.Parent.ImageLabel.Image = &quot;http://www.roblox.com/asset/?id=8635133&quot;
end

end
script.Parent.Parent.Parent.Parent.Character.Humanoid.Changed:connect(onChange)</ProtectedString>
