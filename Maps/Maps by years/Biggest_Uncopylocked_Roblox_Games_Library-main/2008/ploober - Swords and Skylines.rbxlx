									<ProtectedString name="Source">--\\BY ALEXNEWTRON--DO NOT MESS WITH ANYTHING IN THE SCRIPT OR IT WILL BREAK. THANK YOU//--
local health = script.Parent.Parent.Parent.Parent.Parent.Character.Humanoid.Health
local mhealth = script.Parent.Parent.Parent.Parent.Parent.Character.Humanoid.MaxHealth
script.Parent.Text = string.sub(string.lower(health),1,3)..&quot;/&quot;..string.sub(string.lower(mhealth),1,3)
function onChange()
local health = script.Parent.Parent.Parent.Parent.Parent.Character.Humanoid.Health
local mhealth = script.Parent.Parent.Parent.Parent.Parent.Character.Humanoid.MaxHealth
script.Parent.Text = string.sub(string.lower(health),1,3)..&quot;/&quot;..string.sub(string.lower(mhealth),1,3)
end
script.Parent.Parent.Parent.Parent.Parent.Character.Humanoid.Changed:connect(onChange)
