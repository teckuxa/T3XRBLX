			<Item class="Script" referent="RBX1608">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">WeldScript</string>
					<ProtectedString name="Source">local hand = script.Parent.Handle
local h1 = script.Parent.H1
local h2 = script.Parent.H2
local h3 = script.Parent.H3
local h4 = script.Parent.H4

function onWeld()
	local c = hand:GetChildren()
	for i = 1, #c do
		if c[i].className == &quot;Weld&quot; then
			c[i]:Remove()
		end
	end
	local w = Instance.new(&quot;Weld&quot;)
	w.Parent = hand
	w.Part0 = hand
	w.Part1 = h1
	w.C0 = CFrame.new(0,0.5,0)
	local w = Instance.new(&quot;Weld&quot;)
	w.Parent = hand
	w.Part0 = hand
	w.Part1 = h2
	w.C0 = CFrame.new(0,-0.5,0)
	local w = Instance.new(&quot;Weld&quot;)
	w.Parent = hand
	w.Part0 = hand
	w.Part1 = h3
	w.C0 = CFrame.new(0,0.6,0)
	local w = Instance.new(&quot;Weld&quot;)
	w.Parent = hand
	w.Part0 = hand
	w.Part1 = h4
	w.C0 = CFrame.new(0.25,1,0) * CFrame.fromEulerAnglesXYZ(1.57,0,0)
end

script.Parent.Equipped:connect(onWeld)
script.Parent.Unequipped:connect(onWeld)</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="LocalScript" referent="RBX1609">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">BangThrow</string>
					<ProtectedString name="Source">local fire = true
local grenade = Instance.new(&quot;Model&quot;)
grenade.Name = &quot;Grenade&quot;
local b = script.Parent.Handle:Clone()
b.CanCollide = true
b.Name = &quot;Grenade&quot;
b.Parent = grenade
script.Parent.H1:Clone().Parent = grenade
script.Parent.H2:Clone().Parent = grenade
local a = 50

function onActivate()
	if fire == true then
		fire = false
		script.Parent.H1.Transparency = 1
		script.Parent.H2.Transparency = 1
		script.Parent.H3.Transparency = 1
		script.Parent.Handle.Transparency = 1
		local ring = script.Parent.H4:Clone()
		ring.Parent = game.Workspace
		ring.CanCollide = true
		ring.Velocity = Vector3.new(math.random(50,100),math.random(10,50),math.random(1,5))
		script.Parent.H4.Transparency = 1
		local backup = grenade:Clone()
		backup.Parent = game.Workspace
		backup.Grenade.Position = (mouse.Hit.lookVector * 5) + human.Head.Position
		backup.H1.Position = backup.Grenade.Position
		backup.H2.Position = backup.Grenade.Position
		local w = Instance.new(&quot;Weld&quot;)
		w.Parent = backup.Grenade
		w.Part0 = w.Parent
		w.Part1 = backup.H1
		w.C0 = CFrame.new(0,0.5,0)
		local w = Instance.new(&quot;Weld&quot;)
		w.Parent = backup.Grenade
		w.Part0 = w.Parent
		w.Part1 = backup.H2
		w.C0 = CFrame.new(0,-0.5,0)
		backup:MoveTo((mouse.Hit.lookVector * 5) + human.Head.Position)
		local bv = Instance.new(&quot;BodyVelocity&quot;)
		bv.Parent = backup.Grenade
		bv.velocity = mouse.Hit.lookVector * a
		wait(0.05)
		bv:Remove()
		local s = script.Parent.FlashBangScript:Clone()
		s.Disabled = false
		s.Parent = backup
		wait(7.5)
		ring:Remove()
		fire = true
		script.Parent.H1.Transparency = 0
		script.Parent.H2.Transparency = 0
		script.Parent.H3.Transparency = 0
		script.Parent.H4.Transparency = 0
		script.Parent.Handle.Transparency = 0
	end
end

function onKeyDown(key)
	key:lower()
	if key == &quot;n&quot; and a &gt; 10 then
		a = a - 2.5
	elseif key == &quot;m&quot; and a &lt; 100 then
		a = a + 2.5
	end
end

function onEquip(mse)
	mouse = mse
	human = script.Parent.Parent
	mse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	mse.KeyDown:connect(onKeyDown)
end

script.Parent.Equipped:connect(onEquip)
script.Parent.Activated:connect(onActivate)</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX1610">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">FlashBangScript</string>
					<ProtectedString name="Source">local flash = Instance.new(&quot;Part&quot;)
flash.BrickColor = BrickColor.new(208)
flash.TopSurface = 0
flash.BottomSurface = 0
flash.Name = &quot;Flash&quot;
flash.CanCollide = false
flash.Anchored = true
flash.Locked = true
flash.Size = Vector3.new(4,4,4)
flash.formFactor = 0
flash.Transparency = 0
local m = Instance.new(&quot;SpecialMesh&quot;)
m.Parent = flash
m.MeshType = &quot;Sphere&quot;
m.Scale = Vector3.new(1,0,1)
print(&quot;Flashbang Loaded&quot;)

function makeFlash()
	local pos = script.Parent.Grenade.Position
	script.Parent.Grenade:Remove()
	script.Parent.H1:Remove()
	script.Parent.H2:Remove()
	local flashes = {}
	local b = flash:Clone()
	b.Position = pos + Vector3.new(10,0,0)
	table.insert(flashes, b)
	local b = flash:Clone()
	b.Position = pos - Vector3.new(10,0,0)
	table.insert(flashes,b)
	local b = flash:Clone()
	b.Position = pos + Vector3.new(0,0,10)
	table.insert(flashes,b)
	local b = flash:Clone()
	b.Position = pos- Vector3.new(0,0,10)
	table.insert(flashes,b)
	local b = flash:Clone()
	b.Position = pos + Vector3.new(6,0,6)
	table.insert(flashes,b)
	local b = flash:Clone()
	b.Position = pos - Vector3.new(6,0,6)
	table.insert(flashes,b)
	local b = flash:Clone()
	b.Position = pos + Vector3.new(-6,0,6)
	table.insert(flashes,b)
	local b = flash:Clone()
	b.Position = pos + Vector3.new(6,0,-6)
	table.insert(flashes,b)
	local b = flash:Clone()
	b.Position = pos + Vector3.new(5,5,0)
	table.insert(flashes,b)
	local b = flash:Clone()
	b.Position = pos - Vector3.new(5,-5,0)
	table.insert(flashes,b)
	local b = flash:Clone()
	b.Position = pos + Vector3.new(0,5,5)
	table.insert(flashes,b)
	local b = flash:Clone()
	b.Position = pos - Vector3.new(0,-5,5)
	table.insert(flashes,b)
	local b = flash:Clone()
	b.Position = pos + Vector3.new(0,10,0)
	table.insert(flashes,b)
	for i = 1, #flashes do
		flashes[i].Parent = script.Parent
	end
	wait(0.0000000003)
	for i = 150, 10, -1 do
		for x = 1, #flashes do
			flashes[x].Mesh.Scale = Vector3.new(i * 0.1, i * 0.1, i * 0.1)
		end
		wait(0.0000000003)
	end
	script.Parent:Remove()
end

wait(math.random(0,000000000000000005))

makeFlash()</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX1611">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">PUT THIS IN THE WEAPON</string>
					<ProtectedString name="Source">local debounce = false

function getPlayer(humanoid) 
local players = game.Players:children() 
for i = 1, #players do 
if players[i].Character.Humanoid == humanoid then return players[i] end 
end 
return nil 
end 

function onTouch(part) 

local human = part.Parent:findFirstChild(&quot;Humanoid&quot;) 
if (human ~= nil) and debounce == false then

debounce = true

local player = getPlayer(human) 

if (player == nil) then return end 

script.Parent:clone().Parent = player.Backpack

wait(2)
debounce = false
end
end


script.Parent.Parent.Touched:connect(onTouch) 
</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
		</Item>
