						<Item class="Script" referent="RBX176">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">CheckTheme</string>
								<ProtectedString name="Source">function onChange()
local people = script.Parent:GetChildren()
for i = 1, #people do 
if people[i].Name == script.Parent.Parent.Theme.Value then
people[i].BackgroundColor3 = Color3.new(164, 163, 166)
else
if people[i].className == &quot;Script&quot; then
--no
else
people[i].BackgroundColor3 = Color3.new(95, 95, 95)
end
end
end
end
script.Parent.Parent.Theme.Changed:connect(onChange)</ProtectedString>
