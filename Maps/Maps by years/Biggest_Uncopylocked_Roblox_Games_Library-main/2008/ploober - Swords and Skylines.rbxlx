					<string name="Name">NXT gun Fix</string>
					<ProtectedString name="Source">--[[what this does is well when you use a NXT gun it lets your arm move around... when you put the gun away and walk away
your arm will float in mid air and wont be attached to your body unless you select the gun again... this script will fix that.  ]]--


 function unequiped(Pistol) --change &quot;Pistol&quot; to the name of the gun you want to fix
   
if local (&quot;Pistol&quot;) ~= unequiped then   --change &quot;Pistol&quot; to the name of the gun you want to fix
wait(0.01)  
joint = getjoint() 
local c0 = nil 
local c1 = nil 
if joint~= nil then 
c0 = joint.C0.p -- center of arm 
c1 = joint.C1.p 
arm = getarm() 
arm.Anchored = false 
torso = joint.Part0 
pointing = false
end 
end
end

script.Parent.unequiped:connect(Pistol)  --change &quot;Pistol&quot; to the name of the gun you want to fix




