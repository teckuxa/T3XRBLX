						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">ShockScript</string>
						<ProtectedString name="Source">pod = script.Parent

function onTouched(part)
h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
p = part.Parent
t = p:findFirstChild(&quot;Torso&quot;)
h = p:findFirstChild(&quot;Head&quot;)
la = p:findFirstChild(&quot;Left Arm&quot;)
ra = p:findFirstChild(&quot;Right Arm&quot;)
ll = p:findFirstChild(&quot;Left Leg&quot;)
rl = p:findFirstChild(&quot;Right Leg&quot;)
if h~=nil then
        part.Anchored = true
	t.Anchored = true
	h.Anchored = true
	la.Anchored = true
	ra.Anchored = true
	ll.Anchored = true
	rl.Anchored = true 
	wait(.05)
	t.Reflectance = 1 
	h.Reflectance = 1 
	la.Reflectance = 1 
	ra.Reflectance = 1 
	ll.Reflectance = 1 
	rl.Reflectance = 1 
        wait(.05)
	t.Reflectance = 0 
	h.Reflectance = 0 
	la.Reflectance = 0 
	ra.Reflectance = 0 
	ll.Reflectance = 0 
	rl.Reflectance = 0 
        wait(.05)
	t.Reflectance = 1 
	h.Reflectance = 1 
	la.Reflectance = 1 
	ra.Reflectance = 1 
	ll.Reflectance = 1 
	rl.Reflectance = 1 
        wait(.05)
	t.Reflectance = 0 
	h.Reflectance = 0 
	la.Reflectance = 0 
	ra.Reflectance = 0 
	ll.Reflectance = 0 
	rl.Reflectance = 0 
        wait(.05)
	t.Reflectance = 1 
	h.Reflectance = 1 
	la.Reflectance = 1 
	ra.Reflectance = 1 
	ll.Reflectance = 1 
	rl.Reflectance = 1 
        wait(.05)
	t.Reflectance = 0 
	h.Reflectance = 0 
	la.Reflectance = 0 
	ra.Reflectance = 0 
	ll.Reflectance = 0 
	rl.Reflectance = 0 
        wait(.05)
	t.Reflectance = 1 
	h.Reflectance = 1 
	la.Reflectance = 1 
	ra.Reflectance = 1 
	ll.Reflectance = 1 
	rl.Reflectance = 1 
        wait(.05)
	t.Reflectance = 0 
	h.Reflectance = 0 
	la.Reflectance = 0 
	ra.Reflectance = 0 
