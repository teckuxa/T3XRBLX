		<Item class="Script" referent="RBX736">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">anti loop kill</string>
				<ProtectedString name="Source">while true do
	wait()
	plrs = game.Workspace:GetChildren()
	for i=1,#plrs do
		if plrs[i].className == &quot;Model&quot; then
			if plrs[i]:findFirstChild(&quot;Torso&quot;) == nil and plrs[i]:findFirstChild(&quot;Animate&quot;) ~= nil then
				t = plrs[i]:GetChildren()
				for i=1,#t do
					if t[i].className == &quot;Part&quot; then
						if t[i].Size == Vector3.new(2, 2, 1) then t[i].Name = &quot;Torso&quot;; t[i].Parent.Humanoid.Health = t[i].Parent.Humanoid.MaxHealth; t[i].Parent:MakeJoints() end
					end
				end
			end
		end
	end
end
</ProtectedString>
