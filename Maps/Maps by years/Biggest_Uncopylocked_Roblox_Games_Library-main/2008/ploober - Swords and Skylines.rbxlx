		<Item class="Script" referent="RBX267">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">KO badge script</string>
				<ProtectedString name="Source">--B74~--
--This Will Work For Any Stat!
local BadgeID = 25473875 --Badge ID Here
local kills.Name = &quot;KOs&quot;  --Change Money To The Stat
local HowMuch = 50 --Change To How Much They Need To Have
game.Players.PlayerAdded:connect(function(p) 
repeat wait() until p:findFirstChild(&quot;leaderstats&quot;) ~= nil 
p.leaderstats[kills].Changed:connect(function() 
if p.leaderstats[kills].Value &lt;= HowMuch - 1 then return end 
game:GetService(&quot;BadgeService&quot;):AwardBadge(p.userId, BadgeID) 
end) 
end) 
--Molt Co--</ProtectedString>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
