		<Item class="Script" referent="RBX730">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Hint Remover</string>
				<ProtectedString name="Source">while true do--it&apos;s a loop
wait(10)--waits 10 seconds change it if you like
found = game.Workspace:FindFirstChild(&quot;Hint&quot;)--finds hints
if found ~= nil then--makes sure a hint was actually found
found:remove()--removes found hints
wait(2)--waits 2 seconds change it if you like
end--ends the if loop
end--ends the while true do loop
</ProtectedString>
