			<Item class="LocalScript" referent="RBX1274">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Local Gui Key</string>
					<ProtectedString name="Source">r = game:service(&quot;RunService&quot;)



local Tool = script.Parent
local mload = Tool.meele
local team = Tool.Team
MaxAmmo = script.Parent.Bullets.Value

local isOn = false

function reload()
	if script.Parent.Clips.Value &lt; 1 then return end
	enabled = false
	Tool.Enabled = false
	script.Parent.Handle.Reload:play()
	script.Parent.Clips.Value = script.Parent.Clips.Value - 1
	wait(1.5)
	script.Parent.Bullets.Value = MaxAmmo
	enabled = true
	Tool.Enabled = true
	Tool.Name = (&quot;Glock[&quot;..script.Parent.Bullets.Value..&quot;][&quot;..script.Parent.Clips.Value..&quot;]&quot;)
end

function tagHumanoid(humanoid, player)
	local creator_tag = Instance.new(&quot;ObjectValue&quot;)
	creator_tag.Value = player
	creator_tag.Name = &quot;creator&quot;
	creator_tag.Parent = humanoid
end

function untagHumanoid(humanoid)
	if humanoid ~= nil then
		local tag = humanoid:findFirstChild(&quot;creator&quot;)
		if tag ~= nil then
			tag.Parent = nil
		end
	end
end

function onKeyDown(key)
	Tool.Name = (&quot;Glock[&quot;..script.Parent.Bullets.Value..&quot;][&quot;..script.Parent.Clips.Value..&quot;]&quot;)
	if (key~=nil) then
		key = key:lower()
		if (key==&quot;r&quot;)  then
			reload()
		end
	end
end

function onEquippedLocal(mouse)

	if mouse == nil then
		print(&quot;Mouse not found&quot;)
		return 
	end

	Tool.Name = (&quot;Glock[&quot;..script.Parent.Bullets.Value..&quot;][&quot;..script.Parent.Clips.Value..&quot;]&quot;)

	mouse.KeyDown:connect(onKeyDown)
	mouse.Icon = &quot;http://www.roblox.com/asset/?version=1&amp;id=1279200&quot;
end

Tool.Equipped:connect(onEquippedLocal)
</ProtectedString>
