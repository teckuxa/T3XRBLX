script.Parent.Parent.Parent.Tray.Name = script.Parent.Parent.Parent.Theme.Value
script.Parent.Parent.Parent[script.Parent.Name].Name = &quot;Tray&quot;
script.Parent.Parent.Parent.Tray.Visible = true
script.Parent.Parent.Parent.Tray.audio.Value = true
script.Parent.Parent.Parent.Theme.Value = script.Parent.Name
end
end
script.Parent.MouseButton1Down:connect(onClick)</ProtectedString>
