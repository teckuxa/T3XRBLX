				<string name="Name">ChildSpawn</string>
				<ProtectedString name="Source">--\\BY ALEXNEWTRON--DO NOT MESS WITH ANYTHING IN THE SCRIPT OR IT WILL BREAK. THANK YOU//--
wait(2) --wait for character
--already do it
name = script.name.Value
if game.Players[name].Character:findFirstChild(&quot;NewHealthScript&quot;) then
game.Players[name].Character.NewHealthScript:remove()
--ROBLOX SUCKY SCRIPT REMOVED!
end
if game.Players[name].Character:findFirstChild(&quot;HealthScript v2.0&quot;) then
game.Players[name].Character[&quot;HealthScript v2.0&quot;]:remove()
--ROBLOX SUCKY SCRIPT REMOVED!
end
if game.Players[name].PlayerGui:findFirstChild(&quot;RobloxStatusGUI&quot;) then
game.Players[name].PlayerGui.RobloxStatusGUI:remove()
--ROBLOX SUCKY GUI REMOVED!
end
if game.Players[name].PlayerGui:findFirstChild(&quot;HealthGUI&quot;) then
game.Players[name].PlayerGui.HealthGUI:remove()
--ROBLOX SUCKY GUI REMOVED!
end
--add new gui
l = script.HealthGUI:Clone()
l.Parent = game.Players[name].PlayerGui
--ADDED EPIC GUI
--add new health script into player
n = script.NewHealthScript:Clone()
n.Parent = game.Players[name].Character
--ADDED SPECIAL SCRIPT
function onSpawn()
local name = script.name.Value
if game.Players[name].Character:findFirstChild(&quot;NewHealthScript&quot;) then
game.Players[name].Character.NewHealthScript:remove()
--ROBLOX SUCKY SCRIPT REMOVED!
end
if game.Players[name].Character:findFirstChild(&quot;HealthScript v2.0&quot;) then
game.Players[name].Character[&quot;HealthScript v2.0&quot;]:remove()
--ROBLOX SUCKY SCRIPT REMOVED!
end
if game.Players[name].PlayerGui:findFirstChild(&quot;RobloxStatusGUI&quot;) then
game.Players[name].PlayerGui.RobloxStatusGUI:remove()
--ROBLOX SUCKY GUI REMOVED!
end
if game.Players[name].PlayerGui:findFirstChild(&quot;HealthGUI&quot;) then
game.Players[name].PlayerGui.HealthGUI:remove()
--ROBLOX SUCKY GUI REMOVED!
end
--add new gui
l = script.HealthGUI:Clone()
l.Parent = game.Players[name].PlayerGui
--ADDED EPIC GUI
--add new health script into player
n = script.NewHealthScript:Clone()
n.Parent = game.Players[name].Character
--ADDED SPECIAL SCRIPT


end
game.Players[script.name.Value].CharacterAdded:connect(onSpawn)
--\\BY ALEXNEWTRON--DO NOT MESS WITH ANYTHING IN THE SCRIPT OR IT WILL BREAK. THANK YOU//--</ProtectedString>
