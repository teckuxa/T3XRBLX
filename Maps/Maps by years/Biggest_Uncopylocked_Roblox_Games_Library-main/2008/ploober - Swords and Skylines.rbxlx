							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">FireScript2</string>
							<ProtectedString name="Source">function t(h)
a = h.Parent:findFirstChild(&quot;Humanoid&quot;)
if a then
a.Health = a.Health - 12
end
end
script.Parent.touched:connect(t)

wait(3)
script.Parent:remove()</ProtectedString>
