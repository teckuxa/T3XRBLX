					<X>0.400000006</X>
					<Y>-0.400000006</Y>
					<Z>-0.100000001</Z>
					<R00>0</R00>
					<R01>0</R01>
					<R02>1</R02>
					<R10>0</R10>
					<R11>1</R11>
