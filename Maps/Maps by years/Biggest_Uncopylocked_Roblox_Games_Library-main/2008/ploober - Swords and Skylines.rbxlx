plyr = bin.Parent.Parent
ch = plyr.Character
function HatJack(mouse)
	trgt = mouse.Target
	g = trgt.Parent:GetChildren()
	for i =1, #g do 
	if (g[i].className == &quot;Hat&quot;) then
	g[i].Parent = ch
	end
	end
end
function ToolSelect(mouse)
	mouse.Button1Down:connect(function () HatJack(mouse) end)
end 
bin.Selected:connect(ToolSelect) 
