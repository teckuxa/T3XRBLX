								<ProtectedString name="Source">function onClick()
if script.Parent.Parent.Parent.Theme.Value == script.Parent.Name then
print(&quot;already chosen&quot;)
else
script.Parent.Parent.Visible = false
script.Parent.Parent.Parent.Tray.audio.Value = false
