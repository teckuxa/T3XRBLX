					<Item class="Script" referent="RBX26">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">function onChange()
local health = script.Parent.Parent.Parent.Parent.Character.Humanoid.Health
if health &lt;= 30 then
	script.Parent.Heart1.Visible = true
	script.Parent.Heart2.Visible = false
	script.Parent.Heart3.Visible = false
elseif health &lt;= 70 then
	script.Parent.Heart1.Visible = true
	script.Parent.Heart2.Visible = true
	script.Parent.Heart3.Visible = false
elseif health &gt; 70 then
	script.Parent.Heart1.Visible = true
	script.Parent.Heart2.Visible = true
	script.Parent.Heart3.Visible = true
end
if health == 0 then
	script.Parent.Heart1.Visible = false
	script.Parent.Heart2.Visible = false
	script.Parent.Heart3.Visible = false
end

end
script.Parent.Parent.Parent.Parent.Character.Humanoid.Changed:connect(onChange)</ProtectedString>
