local spd = 0
local position = engine.Position

while true do
	wait(0.1)
	direction = engine.CFrame.lookVector 
	position = position + spd*0*direction
	error = position - engine.Position
	engine.Velocity = spd*error
	engine.RotVelocity = Vector3.new(0, 0, 0)
end 
