						<string name="Name">Easy Regen Script</string>
						<string name="Source">local box = script.Parent


local debounce = false



function onTouched(hit)
	local humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;) 
	if humanoid~=nil and debounce == false then
		debounce = true
		color = hit.Parent.Plane.BodyKit.Model.Value
		color.Value = script.Parent.Value.Value
		wait()
		p = hit.Parent.Plane.BodyKit.Model.Script:clone()
		p2 = hit.Parent.Plane.BodyKit.Model.Script
		p.Parent = hit.Parent.Plane.BodyKit.Model
		p2:remove()


		debounce = false
	end
end


