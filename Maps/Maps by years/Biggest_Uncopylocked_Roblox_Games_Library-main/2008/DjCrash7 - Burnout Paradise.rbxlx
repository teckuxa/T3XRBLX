								<Item class="Script" referent="RBX7173">
									<Properties>
										<bool name="Disabled">false</bool>
										<Content name="LinkedSource"><null></null></Content>
										<string name="Name">Script</string>
										<string name="Source">function onTouched(hit) 
if hit.Velocity.magnitude&gt;130 and hit.Parent.Parent.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil then 
hit.Parent.Parent:BreakJoints() 
local p = Instance.new(&quot;Message&quot;)
p.Parent = game.Players:GetPlayerFromCharacter(script.Parent.Parent.Parent.Parent) 
p.Text = &quot;~-You have Taken Down &quot;..hit.Parent.Parent.Parent.Name..&quot;-~&quot;
local m = Instance.new(&quot;Message&quot;)
m.Parent = game.Players:GetPlayerFromCharacter(hit.Parent.Parent.Parent) 
m.Text = &quot;~-You have been Taken Down by &quot;..script.Parent.Parent.Parent.Parent.Name..&quot;-~&quot;
wait(2)
m:remove()
p:remove()
end 
end 
script.Parent.Touched:connect(onTouched) 
</string>
										<bool name="archivable">true</bool>
									</Properties>
								</Item>
							</Item>
						</Item>
					</Item>
					<Item class="IntValue" referent="RBX7174">
						<Properties>
							<string name="Name">Regen</string>
							<int name="Value">0</int>
