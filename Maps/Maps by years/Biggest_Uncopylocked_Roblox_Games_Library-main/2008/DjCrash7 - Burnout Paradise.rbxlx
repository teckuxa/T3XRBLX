	script.Parent.Yellow.Transparency = 0.5
	script.Parent.Red.Transparency = 0.5
	script.Parent.Green.Transparency = 0
	print(&quot;Green On&quot;)
	wait(10)
	script.Parent.Green.Transparency = 0.5
