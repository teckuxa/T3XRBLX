								<Properties>
									<string name="Name">OriginCFrame</string>
									<CoordinateFrame name="Value">
										<X>0</X>
										<Y>16.1999989</Y>
										<Z>-40</Z>
										<R00>0</R00>
										<R01>0</R01>
