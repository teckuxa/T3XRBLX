local children = game.Workspace:children()
for i=1,#children do
	if (children[i].Name == &quot;GTN&quot;) then -- Replace the Admin door name with your models&apos;s name.
		table.insert(everything, children[i]:clone())
		table.insert(names, children[i].Name)
	end
end


