			<Item class="Script" referent="RBX8208">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<string name="Source">while true do
	script.Parent.Yellow1.Transparency = 0.5
	script.Parent.Red1.Transparency = 0.5
	script.Parent.Green1.Transparency = 0
	print(&quot;Green On&quot;)
	wait(10)
	script.Parent.Green1.Transparency = 0.5
	script.Parent.Yellow1.Transparency = 0
	print(&quot;Yellow On&quot;)
	wait(2)
	script.Parent.Yellow1.Transparency = 0.5
	script.Parent.Red1.Transparency = 0
	print(&quot;Red On&quot;)
	wait(12)
end
</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
