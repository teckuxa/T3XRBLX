			<Item class="Script" referent="RBX8321">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<string name="Source">print(&quot;SpongebobandMario&apos;s Message Script&quot;) 

local debounce = false 


function onHit(hit) 
local human = hit.Parent:findFirstChild(&quot;Humanoid&quot;) 
if (human ~= nil) and debounce == false then 

debounce = true 

local message = Instance.new(&quot;Message&quot;) 
message.Parent = game.Players:playerFromCharacter(hit.Parent) 
wait(0)
message.Text = &quot;~~Super Jump!~~&quot; 
wait(5) 

message:Remove () 

debounce = false 
end 
end 

script.Parent.Touched:connect(onHit) </string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
		</Item>
