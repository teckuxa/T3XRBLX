		<Item class="Script" referent="RBX4942">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Script</string>
				<string name="Source">p = game.Workspace.Hint

while true do 

p.Text = &quot;Controls: W--Forward A--Turn Left S--Reverse D--Turn Right...&quot;

wait(10)

p.Text = &quot;Select the &apos;&apos;Control&apos;&apos; tool--- B to turn on Boost-- L to turn on lights-- P to turn off lights...&quot;

wait(10)

p.Text = &quot;F to Fire Guns(Super VIP Only)-- V to turn off boost(VIP/Super VIP ONLY)&quot;

wait(5)

p.Text = &quot;Boost will last for 20 seconds--Boost will last forever for VIP&quot;

wait(8)

p.Text = &quot;Introducing new CRASHBREAKER! Hit C in Controls and watch  it go BOOM, now get REVENGE!&quot;

wait(8)

end
</string>
