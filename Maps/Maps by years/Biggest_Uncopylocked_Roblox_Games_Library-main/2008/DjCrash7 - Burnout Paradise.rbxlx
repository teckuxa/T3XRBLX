		<Item class="Script" referent="RBX4511">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Timed Regen Script</string>
				<string name="Source">--Made kingkiller1000
model = game.Workspace.Cones--change Model to the name of your model --you can change the words in the quotations to what you want it to say when regenning your model 

backup = model:clone()

while true do
	wait(20)--this is how long till your model regenerates

	model:remove()

	wait(0)--this is how long your message will be shown for

	model = backup:clone()
	model.Parent = game.Workspace
end </string>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
