									<string name="Source">--Button that turns on/off coalmaker, and only works for the owner

--Script by Uberubert!
--Free for anyone to use

coalOn = script.Parent.Parent.Parent.CoalOn
owner = coalOn.Parent.OwnerName 
local ting = 0 --debouncer

function onTouched(hit)
	if ting == 0 then --check for debounce
	ting = 1 
	check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;) --try to find the human that touched the button
	if check ~= nil and coalOn.Value == 1 then --if toucher is a human and machine is on, then to following
		if hit.Parent.Name == owner.Value then --If the one who pressed the button is the owner then
			coalOn.Value = 0 --Turn off machine
			wait(3) --wait a while before button works again
		end
	end
	ting = 0
	end
end

script.Parent.Touched:connect(onTouched)
