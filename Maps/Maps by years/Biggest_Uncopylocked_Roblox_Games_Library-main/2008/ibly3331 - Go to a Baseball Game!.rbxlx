						<Item class="Script" referent="RBX1267">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">RemoveAndCount</string>
								<string name="Source">--This script checks the name of the thing that hits it. If the name is &quot;PieceOfCoal&quot; or &quot;Diamond&quot; it will add
--to the counting of the correct counter.

local ting = 0 --debouncer
coals = 0
coalCount = script.Parent.Parent.Counters:findFirstChild(&quot;Hotdogs: 0&quot;)

function onTouched(ItemThatHit)
	if ting == 0 then --check for debounce
	print(&quot;Remover Touched&quot;)
	ting = 1 --activate debounce
		if ItemThatHit.Name == &quot;PieceOfCoal&quot; then --If a coal hit the remover then
			print(&quot;coal&quot;)
			coals = tonumber (string.sub (coalCount.Name, 9))
			coals = coals + 1 --increase number of coals counted
			coalCount.Name = &quot;Hotdogs: &quot; .. coals --Change name of the counter to display new count
			ItemThatHit:remove() --remove the thing that hit the remover
		end
	ting = 0 --deactivate debounce
	end
end

script.Parent.Touched:connect(onTouched)
</string>
								<bool name="archivable">true</bool>
							</Properties>
						</Item>
					</Item>
