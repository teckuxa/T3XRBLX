							<Item class="Script" referent="RBX1023">
								<Properties>
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">Script</string>
									<string name="Source">--Button that turns on/off coalmaker, and only works for the owner

--Script by Uberubert!
--Free for anyone to use

coalOn = script.Parent.Parent.Parent.CoalOn
owner = coalOn.Parent.OwnerName 
local ting = 0 --debouncer

function onTouched(hit)
	if ting == 0 then --check for debounce
	ting = 1 
	check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;) --try to find the human that touched the button
	if check ~= nil and coalOn.Value == 1 then --if toucher is a human and machine is on, then to following
		if hit.Parent.Name == owner.Value then --If the one who pressed the button is the owner then
			coalOn.Value = 0 --Turn off machine
			wait(3) --wait a while before button works again
		end
	end
	ting = 0
	end
end

script.Parent.Touched:connect(onTouched)
</string>
									<bool name="archivable">true</bool>
								</Properties>
							</Item>
						</Item>
					</Item>
					<Item class="Script" referent="RBX1024">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">CoalMakerScript</string>
							<string name="Source">newCoal = script.Parent.PieceOfCoal:clone() --save a coal for later
coalBackup = newCoal:clone() --save a backup for later cloning
script.Parent.PieceOfCoal:remove() --remove the starting coal from the game
onCheck = script.Parent.CoalOn --save shortcut to machines on-check
productionTime = 1 --seconds to wait before making a new coal

while true do
	while onCheck.Value == 1 do --as long as machine is turned on
		newCoal.Parent = script.Parent --Put a new coal into the game
		newCoal = coalBackup:clone() --Make a new coal for later
		wait(productionTime) --time to wait before making a new coal
	end --repeat if machine is still on (if CoalOn still has the value 1)
	wait(1) --time to wait before checking again
end
