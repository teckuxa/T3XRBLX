			<Item class="Script" referent="RBX2134">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Reset</string>
					<string name="Source">bin = script.Parent    

function checkScript()
	player = game.Players.LocalPlayer
	if (player == nil) then return end
	local run = game.Players.LocalPlayer.Character:findFirstChild(&quot;Script&quot;)
	if (run ~= nil) then
		run.Parent = nil 
	end
end 

function onButton1Down(mouse)
	mouse.Icon = &quot;rbxasset://textures\\ArrowFarCursor.png&quot;
	local player = game.Players.LocalPlayer.Character
	local run = bin.Script:clone()
	run.Disabled = false 
	run.Parent = player 
end

function onButton1Up(mouse)
	mouse.Icon = &quot;rbxasset://textures\\ArrowCursor.png&quot;
	player = game.Players.LocalPlayer
	if (player == nil) then return end
	char = player.Character
	RS = char.Torso[&quot;Right Shoulder&quot;]
	LS = char.Torso[&quot;Left Shoulder&quot;]
	local run = game.Players.LocalPlayer.Character:findFirstChild(&quot;Script&quot;)
	if (run ~= nil) then
		run.Parent = nil 
	end
	RS.DesiredAngle = 0
	LS.DesiredAngle = 0
end 

function onSelected(mouse)
	local c = game.Players.LocalPlayer:GetChildren()
	for i = 1,#c do
		if c[i].className == &quot;Message&quot; or c[i].className == &quot;Hint&quot; then
			c[i]:Remove()
		end
	end
	mouse.Icon = &quot;rbxasset://textures\\ArrowCursor.png&quot;
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
	mouse.Button1Up:connect(function() onButton1Up(mouse) end)
end

bin.Selected:connect(onSelected)
bin.Deselected:connect(checkScript) </string>
