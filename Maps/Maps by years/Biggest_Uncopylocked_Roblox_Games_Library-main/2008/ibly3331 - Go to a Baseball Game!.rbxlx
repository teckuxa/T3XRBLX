					<string name="Source">function onChanged()
print(&quot;Changed&quot;)
local Diff1 = script.Parent.Diff1.Value
local Diff2 = script.Parent.Diff2.Value 
if script.Parent.Parent:findFirstChild(&quot;Right Arm&quot;) ~= nil then
script.Parent.Parent:findFirstChild(&quot;Right Arm&quot;):findFirstChild(&quot;RightGrip&quot;).C0 = CFrame.new(Vector3.new(0,-1,0))
