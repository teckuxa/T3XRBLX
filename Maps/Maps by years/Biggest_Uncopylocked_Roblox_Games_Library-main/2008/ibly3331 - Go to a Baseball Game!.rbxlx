									<string name="Source">--  Replace the &quot;Your Text Goes Here&quot;s with your messages you want to appear in the top left hand corner of the screen
 --  You can also edit the time it takes for them to appear
 --  Make sure both the &quot;..hit.Parent.Name&quot; Has &quot;s at the begining and end of it, as well as the enrie message

print(&quot;iPlay&apos;s name saying message brick&quot;)

local debounce = false


function onHit(hit)
	local human = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
	if (human ~= nil) and debounce == false then

                debounce = true

local message = Instance.new(&quot;Message&quot;)
message.Text = &quot;Nice try!&quot;
message.Parent = game.Players:playerFromCharacter(hit.Parent)
wait(3)
message.Text = &quot;You can&apos;t take the giver away from everybody else,&quot;
wait(3)
message.Text = &quot;Now that I made a better version, you can&apos;t wreck it&quot;
wait(3)
message.Text = &quot;4 anybody elsePress the button for infinty health instead.&quot;
wait(3)

message:Remove ()

                debounce = false
	end
end

