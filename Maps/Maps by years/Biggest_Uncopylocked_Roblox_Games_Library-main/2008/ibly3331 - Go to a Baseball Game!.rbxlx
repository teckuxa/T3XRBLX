									<string name="Name">Script</string>
									<string name="Source">print(&quot;ibly3331&apos;sCollectPayButtonLoaded&quot;)
local ting = 0 --debouncer
coalCount = script.Parent.Parent.Parent.Counters:findFirstChild(&quot;Hotdogs: 0&quot;)

function onTouched(hit)
	
owner = script.Parent.Parent.Parent.OwnerName
	
	print(&quot;We made it this far&quot;)
	if ting == 0 then --check for debounce
	print(&quot;I found the owner&quot;)
	ting = 1 
	print(&quot;I found the owner&quot;)
	check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;) --try to find the human that touched the button
	print(&quot;The dude who pressed button, is he an owner?&quot;)
	if check~= nil and hit.Parent.Name == owner.Value then --If the one who pressed the button is the owner then		
	print(&quot;I found the owner&quot;)	
		local user = game.Players:GetPlayerFromCharacter(hit.Parent) --get player from touching human
		local stats = user:findFirstChild(&quot;leaderstats&quot;) --Find moneyholder
	print(&quot;He has a wallet&quot;)
		if stats~= nil then --If moneyholder exists then
			local cash = stats:findFirstChild(&quot;Money&quot;) --Get money
	print(&quot;His wallet has money&quot;)
			
			if coalCount~= nil then --If Hotdogs: exists then
				local value = tonumber (string.sub (coalCount.Name, 9)) 
			cash.Value = cash.Value +10*value
	print(&quot;Giving him 100 big ones&quot;)		
				coalCount.Name = &quot;Hotdogs: 0&quot; 
	print(&quot;Reseting number so noobs can&apos;t get rich&quot;)
				wait(3)
			end
		end	
	end
	ting = 0
	end
end

script.Parent.Touched:connect(onTouched)
