	--local C1 = hit.CFrame:inverse() * CJ 

	--weld.C0 = C0 
	--weld.C1 = C1 

	--weld.Parent = pellet 

	-- make a splat
	--for i=1,splat do
		--local s = Instance.new(&quot;Part&quot;)
		--s.Shape = 1 -- block
		--s.formFactor = 2 -- plate
		--s.Size = Vector3.new(1,.4,1)
