				<string name="Name">HintScript</string>
				<string name="Source">function onPlayerEntered(newPlayer)
local h = Instance.new(&quot;Hint&quot;)
h.Parent = newPlayer
h.Text = &quot;Welcome to my Baseball park!&quot;
wait(3)
h.Text = &quot;Try out the NEXT Generation Bat!&quot;
wait(2)
h.Text = &quot;It was made completely by me, not by xLEGOx&quot;
wait(2)
h:Remove()
end 

game.Players.ChildAdded:connect(onPlayerEntered)</string>
