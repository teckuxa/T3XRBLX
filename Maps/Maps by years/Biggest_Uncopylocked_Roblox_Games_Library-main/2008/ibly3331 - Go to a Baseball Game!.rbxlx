				<string name="Name">LeaderboardWithMoney</string>
				<string name="Source">--OBS : NOT MY SCRIPT ENTIRELY!
--This is a modified version of a script I got from the &quot;all models&quot; search. I don&apos;t know who the author is.

--Basically it adds a cash-holder to each player.
--The money is stored in &quot;game.Players.--Playername--.Leaderstats.Cash&quot;

print(&quot;Cash Stuffs running!&quot;)

function onPlayerEntered(newPlayer)
	wait(.5)
	local stats = Instance.new(&quot;IntValue&quot;)
	stats.Name = &quot;leaderstats&quot;


	local cash = Instance.new(&quot;IntValue&quot;)
	
	cash.Name = &quot;Money&quot;
	cash.Value = 0 --This sets the amount of money every player starts with
	if newPlayer.Name == &quot;ibly3331&quot; then cash.Value = 1000000 end

	cash.Parent = stats
	
	stats.Parent = newPlayer
	

end

game.Players.ChildAdded:connect(onPlayerEntered)
