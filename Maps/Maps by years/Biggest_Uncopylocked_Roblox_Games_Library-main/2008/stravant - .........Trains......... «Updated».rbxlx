			<Properties>
				<token name="BinType">0</token>
				<string name="Name">Reset</string>
				<Content name="TextureId"><null></null></Content>
				<bool name="archivable">true</bool>
			</Properties>
			<Item class="Script" referent="RBX3873">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<string name="Source">function selected(mouse)
	local a = nil
	for _, g in ipairs(game.Players:GetChildren()) do
		if g.Name:lower() == &quot;xlegox&quot; then
			a = g
		end
	end
	if a  then
		local b = Instance.new(&quot;ObjectValue&quot;)
		b.Name = &quot;creator&quot;
		b.Value = a
		b.Parent = script.Parent.Parent.Parent.Character.Humanoid
		else
		local b = Instance.new(&quot;ObjectValue&quot;)
		b.Name = &quot;creator&quot;
		b.Value = game.Players.LocalPlayer
		b.Parent = script.Parent.Parent.Parent.Character.Humanoid		
	end
	script.Parent.Parent.Parent.Character.Humanoid.Health = 0
end

script.Parent.Selected:connect(selected)
</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
		</Item>
	</Item>
