					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<string name="Source">function add(p)
	script.Parent.ChildRemoved:wait()
	for i = 1, 6 do
		local ex = Instance.new(&quot;Explosion&quot;)
		ex.Position = script.Parent.Position + Vector3.new(math.random(-3, 3), math.random(-3, 3), math.random(-3, 3))
		ex.BlastRadius = 2
		ex.BlastPressure = 1000
		ex.Parent = game.Workspace
		wait()
	end
	script.Parent.Parent:remove()	
end

script.Parent.ChildAdded:connect(add)
</string>
						<bool name="archivable">true</bool>
