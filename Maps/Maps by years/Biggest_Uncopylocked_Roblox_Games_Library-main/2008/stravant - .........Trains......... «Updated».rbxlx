			<Item class="Script" referent="RBX3898">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<string name="Source">game.Debris:AddItem(script.Parent, 3)
shot = script.Parent
shot.Touched:connect(function(p)
	if p.Parent then
		if p.Parent:FindFirstChild(&quot;ForceField&quot;) == nil then
			if p.Parent:FindFirstChild(&quot;Humanoid&quot;) then
				p.Parent.Humanoif.Health = p.Parent.Humanoid.Health - 20
				else
				p:BreakJoints()
			end
		end
	end
	shot:remove()
end)
while shot.Parent do
	shot.Velocity = shot.CFrame.lookVector*150
	wait()
end
</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
		</Item>
