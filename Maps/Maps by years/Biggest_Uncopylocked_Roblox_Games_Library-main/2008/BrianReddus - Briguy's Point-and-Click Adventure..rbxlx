end

function mode2()
--slow transitions, looks slick
script.Parent.Color = Color3.new(1,0,0) --Color3.new(math.random(), math.random(), math.random()) 
wait(0.2)
script.Parent.Color = Color3.new(.8,.2,0) --Color3.new(math.random(), math.random(), math.random()) 
