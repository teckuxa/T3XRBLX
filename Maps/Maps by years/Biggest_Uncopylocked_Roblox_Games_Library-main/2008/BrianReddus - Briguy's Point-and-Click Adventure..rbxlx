						<string name="Name">Script</string>
						<ProtectedString name="Source">function onTouched(part)
	if part.Parent.Name == &quot;Couch&quot; then
		local message = Instance.new(&quot;Hint&quot;)
		message.Text = &quot;You cut a cushion off the couch!&quot;
		message.Parent = game.Players:findFirstChild(part.Parent.Parent.Owner.Value)
		part.Parent.Cushion:Remove()
		part.Parent.Name = &quot;Broken&quot;
		wait(3)
		message:Remove()

	end
end 

