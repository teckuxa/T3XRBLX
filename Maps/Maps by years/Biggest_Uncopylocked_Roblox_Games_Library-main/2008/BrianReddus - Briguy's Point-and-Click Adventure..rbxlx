						<string name="Name">Script</string>
						<ProtectedString name="Source">function onTouched(part)
	if part.Parent.Name == &quot;TV&quot; then
		local message = Instance.new(&quot;Hint&quot;)
		message.Text = &quot;You used the diamond to cut the TV off the wall.&quot;
		message.Parent = game.Players:findFirstChild(part.Parent.Parent.Owner.Value)
		part.Parent:BreakJoints()
		wait(3)
		message:Remove()

	end
end 

script.Parent.Touched:connect(onTouched)</ProtectedString>
