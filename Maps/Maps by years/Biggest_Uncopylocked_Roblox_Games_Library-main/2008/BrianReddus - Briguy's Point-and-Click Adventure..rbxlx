			message.Text = &quot;I must walk into the light...I must WALK INTO the light...&quot;
			message.Parent = player
			wait(6)
			message.Parent = nil
		end

		if (hit.Name == &quot;Disco&quot;) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = &quot;I&apos;d rather not.&quot;
			message.Parent = player
			wait(3)
			message.Parent = nil
		end

		if (hit.Name == &quot;Finale&quot;) then
		if (game.Workspace.Slot1.BrickColor.Number == 105) and
			(game.Workspace.Slot2.BrickColor.Number == 24) and
			(game.Workspace.Slot3.BrickColor.Number == 23) and
			(game.Workspace.Slot4.BrickColor.Number == 28) then
			f = game.Workspace.Finale
			f.Transparency = 1
			f.CanCollide = false
			wait(5)
			f.Transparency = 0
			f.CanCollide = true
		else return end
		end

		if (hit.Name == &quot;Slot1&quot;) or (hit.Name == &quot;Slot2&quot;) or (hit.Name == &quot;Slot3&quot;) or (hit.Name == &quot;Slot4&quot;) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = &quot;I need to use the shape keys on these slots.&quot;
			message.Parent = player
			wait(4)
			message.Parent = nil
		end

		if (hit.Name == &quot;Key1&quot;) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = &quot;Got Square Key!&quot;
			game.Lighting.Square:clone().Parent = pack
			message.Parent = player
			wait(4)
			message.Parent = nil
		end

		if (hit.Name == &quot;Key2&quot;) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = &quot;Got Head?&quot;
			game.Lighting.Head:clone().Parent = pack
			message.Parent = player
			wait(4)
			message.Parent = nil
		end

		if (hit.Name == &quot;Key3&quot;) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = &quot;Got Wedge Key!&quot;
			game.Lighting.Wedge:clone().Parent = pack
			message.Parent = player
			wait(4)
			message.Parent = nil
		end

		if (hit.Name == &quot;Key4&quot;) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = &quot;Got Sphere Key!&quot;
			game.Lighting.Sphere:clone().Parent = pack
			message.Parent = player
			wait(4)
			message.Parent = nil
		end

		if (hit.Name == &quot;TrashBasket&quot;) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = &quot;Found the Jail Door Key! It&apos;s smells kinda funky...&quot;
			game.Lighting.JailKey:clone().Parent = pack
			message.Parent = player
			wait(4)
			message.Parent = nil
		end

		if (hit.Name == &quot;MoldyDonut&quot;) then
			hit.Transparency = 1
			local message = Instance.new(&quot;Hint&quot;)
			local char = game.Workspace:findFirstChild(player.Name)
			message.Text = &quot;*eats moldy donut* Uh oh...&quot;
			message.Parent = player
			wait(2)
			char.Head.Mesh.Scale = Vector3.new(0.2, 0.2, 0.2)
			wait(2)
			char.Head.Mesh.Scale = Vector3.new(1.2, 1.2, 1.2)
			char.Head.Size = Vector3.new(math.random(1, 10), math.random(1, 10), math.random(1, 10))
			wait(1)
			message.Parent = nil
			hit.Transparency = 0
		end

		if (hit.Name == &quot;Donut&quot;) then
			local message = Instance.new(&quot;Hint&quot;)
			local char = game.Workspace:findFirstChild(player.Name)
			message.Parent = player
			message.Text = &quot;*eats Donut*&quot;
			hit.Transparency = 1
			wait(2)
			h = char.Humanoid.MaxHealth
			char.Humanoid.MaxHealth = h + 100
			message.Text = &quot;maxHealth increased!&quot;
			wait(3)
			message.Parent = nil
			hit.Transparency = 0
		end

		if (hit.Name == &quot;DonutBox&quot;) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = &quot;I can&apos;t eat the box!&quot;
			message.Parent = player
			wait(3.5)
			message.Parent = nil
		end

		if (hit.Name == &quot;JailDoor&quot;) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = &quot;It&apos;s locked. Someone must have locked it up and thrown away the key...&quot;
			message.Parent = player
			wait(5)
			message.Parent = nil
		end

		if (hit.Name == &quot;IronGlass&quot;) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = &quot;I knew a guy who once walked into a bar. Ouch. I&apos;m not making the same mistake.&quot;
			message.Parent = player
			wait(6)
			message.Parent = nil
		end

		if (hit.Name == &quot;IronGlass1&quot;) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = &quot;Well, those look pretty much escapeproof.&quot;
			message.Parent = player
			wait(6)
			message.Parent = nil
		end

		if (hit.Parent.Name == &quot;General Eric&quot;) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = &quot;NOOOOOOOOOOOOOOOOOOO! My plan was so perfect!&quot;
			message.Parent = player
			wait(4)
			message.Text = &quot;I was going to use the army to produce and sell &apos;Ketchup-in-a-CUBE!&apos;&quot;
			wait(4)
			message.Text = &quot;I would have been a millionaire!&quot;
			wait(2.3)
			message.Text = &quot;This will not be the last time you hear from me! Mark my words, I&apos;ll get out of jail sooner or later!&quot;
			wait(5)
			message.Text = &quot;And when I do...&quot;
			wait(2)
			message.Parent = nil
			local m = Instance.new(&quot;Message&quot;)
			m.Text = &quot;YOU&apos;LL ALL PAY!!!!!1!!!!0.999...!!!!!!!&quot;
			m.Parent = game.Workspace
			wait(1.5)
			m.Parent = nil
			local char = game.Workspace:findFirstChild(player.Name)
			local pod = game.Workspace:findFirstChild(&quot;SpawnLocation5&quot;)
			local torso = char.Torso
			local location = {pod.Position}
			local i = 1

			local x = location[i].x
			local y = location[i].y
			local z = location[i].z

			x = x + math.random(-1, 1)
			z = z + math.random(-1, 1)
			y = y + math.random(2, 3)

			local cf = torso.CFrame
			local lx = 0
			local ly = y
			local lz = 0

			torso.CFrame = CFrame.new(Vector3.new(x,y,z), Vector3.new(lx,ly,lz))
		n = Instance.new(&quot;IntValue&quot;)
		n.Name = &quot;WinnerValue&quot;
		n.Parent = player
		n.Value = 1
		end

		if (hit.Name == &quot;SkySign&quot;) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = &quot;Argh. If you&apos;re reading this, you&apos;ve made it past my obviously incompetent henchmen.&quot;
			message.Parent = player
			wait(6)
			message.Text = &quot;You&apos;ll never make it in my bunker though, because you&apos;ll never find the mesh keys needed to open it!&quot;
			wait(7)
			message.Text = &quot;Actually, you probably will, because they&apos;re hidden in fairly obvious locations... :(&quot;
			wait(6)
			message.Text = &quot;                                 ~~~General Eric~~~&quot;
			wait(4)
			message.Parent = nil
		end

		if (hit.Name == &quot;TVRemote&quot;) then
			game.Workspace.TVFront.Transparency = 0.8
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = &quot;Reporter: Hello, and this is Paul McGuyman for the New Roblox News.&quot;
			message.Parent = player
			wait(6)
			message.Text = &quot;Reporter (aka Paul): I&apos;m here at that abandoned airport outside of town, with RCMP Officer Amon Ehbert.&quot;
			wait(8)
			message.Text = &quot;Officer Amon: Thanks Paul. We have just apprehended what could be Canada&apos;s Most Wanted Madman, General Eric.&quot;
			wait(8)
			message.Text = &quot;All thanks to a member of our Top Secret Spy Division, which has its headquarters in Fox Creek, Alberta.&quot;
			wait(8)
			message.Text = &quot;Reporter Paul: What&apos;s his/her name?&quot;
			wait(4)
			message.Text = &quot;Officer Amon: Classified.&quot;
			wait(4)
			message.Text = &quot;Reporter Paul: And the location of the headquarters isn&apos;t?&quot;
			wait(6)
			message.Text = &quot;Officer Amon: Oops...&quot;
			wait(3)
			message.Parent = nil
			game.Workspace.TVFront.Transparency = 0
		end

		if (hit.Name == &quot;RemoveTool&quot;) then
		c = player.Backpack:GetChildren()
		for i = 1, #c do
		if (c[i].Name ~= &quot;Use&quot;) and (c[i].Name ~= &quot;Look&quot;) and (c[i].Name ~= &quot;Reset&quot;) then
		c[i]:remove()
		else end
		end
		end

		if (hit.Name == &quot;RemoveFake&quot;) then
		c = player.Backpack:GetChildren()
		for i = 1, #c do
		if (c[i].Name == &quot;FakeKey&quot;) then
		c[i]:remove()
		else end
		end
		end

		if (hit.Name == &quot;FakeKey&quot;) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = &quot;Got...Fake Key? :(&quot;
			game.Lighting.FakeKey:clone().Parent = pack
			message.Parent = player
			wait(2)
			message.Parent = nil
		end

		if (hit.Name == &quot;TreeTop&quot;) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = &quot;There&apos;s something in that tree!&quot;
			message.Parent = player
			wait(4)
			message.Text = &quot;It&apos;s a Grapple Watch!&quot;
			game.Lighting.GrappleWatch:clone().Parent = pack
			wait(3)
			message.Parent = nil
		end

		if (hit.Name == &quot;Tree&quot;) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = &quot;No time to climb trees now, I have to save the world!&quot;
			message.Parent = player
			wait(5)
			message.Parent = nil
		end

		if (hit.Name == &quot;Verify&quot;) then
			if (game.Workspace.PaintRed.BrickColor.Number == 21) and (game.Workspace.PaintBlue.BrickColor.Number == 23) and (game.Workspace.PaintYellow.BrickColor.Number == 24) and (game.Workspace.PaintGreen.BrickColor.Number == 28) and (game.Workspace.PaintOrange.BrickColor.Number == 106)
and (game.Workspace.PaintViolet.BrickColor.Number == 104) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = &quot;It did something!&quot;
			message.Parent = player
			wait(3)
			message.Text = &quot;I got the Bowser Jewel!&quot;
			game.Lighting.BowserJewel:clone().Parent = pack
			wait(3)
			message.Text = &quot;Just kidding...I got the Access Card!&quot;
			pack.BowserJewel:remove()
			game.Lighting.AccessCard:clone().Parent = pack
			wait(4)
			message.Parent = nil
			elseif (game.Workspace.PaintRed.BrickColor.Number ~= 21) or (game.Workspace.PaintBlue.BrickColor.Number ~= 23) or (game.Workspace.PaintYellow.BrickColor.Number ~= 24) or (game.Workspace.PaintGreen.BrickColor.Number ~= 28) or (game.Workspace.PaintOrange.BrickColor.Number ~= 106)
or (game.Workspace.PaintViolet.BrickColor.Number ~= 104) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = &quot;It spat out a card. On the card it says: Hint: Falling water arc.&quot;
			message.Parent = player
			wait(6)
			message.Parent = nil
			end
		end

		if (hit.Name == &quot;RemovePaint&quot;) then
		c = player.Backpack:GetChildren()
		for i = 1, #c do
		if (c[i].Name == &quot;Red&quot;) or (c[i].Name == &quot;Orange&quot;) or (c[i].Name == &quot;Yellow&quot;) or (c[i].Name == &quot;Green&quot;) or (c[i].Name == &quot;Blue&quot;) or (c[i].Name == &quot;Violet&quot;) then
		c[i]:remove()
		else end
		end
		end

		if (hit.Name == &quot;PaintCan&quot;) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = &quot;It&apos;s a can of paint!&quot;
			message.Parent = player
			wait(2)
			game.Lighting.Violet:clone().Parent = pack
			game.Lighting.Green:clone().Parent = pack
			game.Lighting.Yellow:clone().Parent = pack
			game.Lighting.Blue:clone().Parent = pack
			game.Lighting.Red:clone().Parent = pack
			game.Lighting.Orange:clone().Parent = pack
			wait(2)
			message.Text = &quot;Wait...one can of paint = six colours? How does that work?&quot;
			wait(6)
			message.Parent = nil
		end

		if (hit.Name == &quot;PaintRed&quot;) or (hit.Name == &quot;PaintYellow&quot;) or (hit.Name == &quot;PaintOrange&quot;) or (hit.Name == &quot;PaintGreen&quot;) or (hit.Name == &quot;PaintBlue&quot;) or (hit.Name == &quot;PaintViolet&quot;) then		
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = &quot;I&apos;ll need some paint.&quot;
			message.Parent = player
			wait(3)
			message.Parent = nil
		end

		if (hit.Name == &quot;GrapplePoint&quot;) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = &quot;Looks like a viable point to grapple on. If only I had a Grapple Watch.&quot;
			message.Parent = player
			wait(5)
			message.Parent = nil
		end

		if (hit.Name == &quot;AddPlane&quot;) then
		game.Lighting:findFirstChild(&quot;Plane V3.5&quot;):clone().Parent = pack
		end]]

--MORE

	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	end



function onSelected(mouse)
	print(&quot;Action Tool Selected&quot;)
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end

bin.Selected:connect(onSelected)
