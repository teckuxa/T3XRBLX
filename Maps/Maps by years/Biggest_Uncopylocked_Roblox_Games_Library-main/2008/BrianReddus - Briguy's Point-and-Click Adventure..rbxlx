			message.Text = hit.Parent.Message.Value
			message.Parent = player
			wait(5)
			message.Parent = nil
		end

		if (hit.Parent.Name == &quot;TV2&quot;) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = hit.Parent.Message.Value
			message.Parent = player
			wait(5)
			message.Parent = nil
		end

		if (hit.Parent.Name == &quot;Bathtub&quot;) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = hit.Parent.Message.Value
			message.Parent = player
			wait(5)
			message.Parent = nil
		end
		if (hit.Parent.Name == &quot;Arcade&quot;) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = hit.Parent.Message.Value
			message.Parent = player
			wait(5)
			message.Parent = nil
		end
--------------------------------This is where the non-Models start------------------------

		if (hit.Name == &quot;Key&quot;) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = hit.Message.Value
			message.Parent = player
			wait(5)
			message.Parent = nil
		end

		if (hit.Name == &quot;Crowbar&quot;) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = hit.Message.Value
			message.Parent = player
			wait(5)
			message.Parent = nil
		end

		if (hit.Name == &quot;SafeDoor&quot;) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = hit.Message.Value
			message.Parent = player
			wait(5)
			message.Parent = nil
		end

