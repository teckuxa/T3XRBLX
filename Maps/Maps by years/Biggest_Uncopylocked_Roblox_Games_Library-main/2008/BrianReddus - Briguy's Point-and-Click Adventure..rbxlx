						<string name="Name">Script</string>
						<ProtectedString name="Source">door = script.Parent.Parent.Door

function onChange()
	if script.Parent.Open.Value then
		door:Remove()
	elseif not script.Parent.Open.Value then
	end
end

script.Parent.Open.Changed:connect(function(property)
	if property == &quot;Value&quot; then
		onChange()
	end
end)
</ProtectedString>
