			game.Workspace.TVFront.Transparency = 0.8
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = &quot;Reporter: Hello, and this is Paul McGuyman for the New Roblox News.&quot;
			message.Parent = player
			wait(6)
			message.Text = &quot;Reporter (aka Paul): I&apos;m here at that abandoned airport outside of town, with RCMP Officer Amon Ehbert.&quot;
			wait(8)
			message.Text = &quot;Officer Amon: Thanks Paul. We have just apprehended what could be Canada&apos;s Most Wanted Madman, General Eric.&quot;
			wait(8)
			message.Text = &quot;All thanks to a member of our Top Secret Spy Division, which has its headquarters in Fox Creek, Alberta.&quot;
			wait(8)
			message.Text = &quot;Reporter Paul: What&apos;s his/her name?&quot;
			wait(4)
			message.Text = &quot;Officer Amon: Classified.&quot;
			wait(4)
			message.Text = &quot;Reporter Paul: And the location of the headquarters isn&apos;t?&quot;
			wait(6)
			message.Text = &quot;Officer Amon: Oops...&quot;
			wait(3)
			message.Parent = nil
			game.Workspace.TVFront.Transparency = 0
		end

		if (hit.Name == &quot;RemoveTool&quot;) then
		c = player.Backpack:GetChildren()
		for i = 1, #c do
		if (c[i].Name ~= &quot;Use&quot;) and (c[i].Name ~= &quot;Look&quot;) and (c[i].Name ~= &quot;Reset&quot;) then
		c[i]:remove()
		else end
		end
		end

		if (hit.Name == &quot;RemoveFake&quot;) then
		c = player.Backpack:GetChildren()
		for i = 1, #c do
		if (c[i].Name == &quot;FakeKey&quot;) then
		c[i]:remove()
		else end
		end
		end

		if (hit.Name == &quot;FakeKey&quot;) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = &quot;Got...Fake Key? :(&quot;
			game.Lighting.FakeKey:clone().Parent = pack
			message.Parent = player
			wait(2)
			message.Parent = nil
		end

		if (hit.Name == &quot;TreeTop&quot;) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = &quot;There&apos;s something in that tree!&quot;
			message.Parent = player
			wait(4)
			message.Text = &quot;It&apos;s a Grapple Watch!&quot;
			game.Lighting.GrappleWatch:clone().Parent = pack
			wait(3)
			message.Parent = nil
		end

		if (hit.Name == &quot;Tree&quot;) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = &quot;No time to climb trees now, I have to save the world!&quot;
			message.Parent = player
			wait(5)
			message.Parent = nil
		end

		if (hit.Name == &quot;Verify&quot;) then
			if (game.Workspace.PaintRed.BrickColor.Number == 21) and (game.Workspace.PaintBlue.BrickColor.Number == 23) and (game.Workspace.PaintYellow.BrickColor.Number == 24) and (game.Workspace.PaintGreen.BrickColor.Number == 28) and (game.Workspace.PaintOrange.BrickColor.Number == 106)
and (game.Workspace.PaintViolet.BrickColor.Number == 104) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = &quot;It did something!&quot;
			message.Parent = player
			wait(3)
			message.Text = &quot;I got the Bowser Jewel!&quot;
			game.Lighting.BowserJewel:clone().Parent = pack
			wait(3)
			message.Text = &quot;Just kidding...I got the Access Card!&quot;
			pack.BowserJewel:remove()
			game.Lighting.AccessCard:clone().Parent = pack
			wait(4)
			message.Parent = nil
			elseif (game.Workspace.PaintRed.BrickColor.Number ~= 21) or (game.Workspace.PaintBlue.BrickColor.Number ~= 23) or (game.Workspace.PaintYellow.BrickColor.Number ~= 24) or (game.Workspace.PaintGreen.BrickColor.Number ~= 28) or (game.Workspace.PaintOrange.BrickColor.Number ~= 106)
or (game.Workspace.PaintViolet.BrickColor.Number ~= 104) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = &quot;It spat out a card. On the card it says: Hint: Falling water arc.&quot;
			message.Parent = player
			wait(6)
			message.Parent = nil
			end
		end

		if (hit.Name == &quot;RemovePaint&quot;) then
		c = player.Backpack:GetChildren()
		for i = 1, #c do
		if (c[i].Name == &quot;Red&quot;) or (c[i].Name == &quot;Orange&quot;) or (c[i].Name == &quot;Yellow&quot;) or (c[i].Name == &quot;Green&quot;) or (c[i].Name == &quot;Blue&quot;) or (c[i].Name == &quot;Violet&quot;) then
		c[i]:remove()
		else end
		end
		end

		if (hit.Name == &quot;PaintCan&quot;) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = &quot;It&apos;s a can of paint!&quot;
			message.Parent = player
			wait(2)
			game.Lighting.Violet:clone().Parent = pack
			game.Lighting.Green:clone().Parent = pack
			game.Lighting.Yellow:clone().Parent = pack
			game.Lighting.Blue:clone().Parent = pack
			game.Lighting.Red:clone().Parent = pack
			game.Lighting.Orange:clone().Parent = pack
			wait(2)
			message.Text = &quot;Wait...one can of paint = six colours? How does that work?&quot;
			wait(6)
			message.Parent = nil
		end

		if (hit.Name == &quot;PaintRed&quot;) or (hit.Name == &quot;PaintYellow&quot;) or (hit.Name == &quot;PaintOrange&quot;) or (hit.Name == &quot;PaintGreen&quot;) or (hit.Name == &quot;PaintBlue&quot;) or (hit.Name == &quot;PaintViolet&quot;) then		
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = &quot;I&apos;ll need some paint.&quot;
			message.Parent = player
			wait(3)
			message.Parent = nil
		end

		if (hit.Name == &quot;GrapplePoint&quot;) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = &quot;Looks like a viable point to grapple on. If only I had a Grapple Watch.&quot;
			message.Parent = player
			wait(5)
			message.Parent = nil
		end

		if (hit.Name == &quot;AddPlane&quot;) then
		game.Lighting:findFirstChild(&quot;Plane V3.5&quot;):clone().Parent = pack
		end]]

--MORE

	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	end



function onSelected(mouse)
	print(&quot;Action Tool Selected&quot;)
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end

bin.Selected:connect(onSelected)
</ProtectedString>
