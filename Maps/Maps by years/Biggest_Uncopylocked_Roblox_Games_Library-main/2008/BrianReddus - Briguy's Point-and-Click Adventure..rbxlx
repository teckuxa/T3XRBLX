			<Item class="Script" referent="RBX1706">
				<Properties>
					<bool name="Archivable">true</bool>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">box = script.Parent

while true do 
wait(0.1) 
box.Y1.BrickColor = BrickColor.new(24)
box.B1.BrickColor = BrickColor.new(23)
wait(0.2)
box.Y1.BrickColor = BrickColor.new(26)
box.B1.BrickColor = BrickColor.new(26)
box.Y2.BrickColor = BrickColor.new(24)
box.B2.BrickColor = BrickColor.new(23)
wait(0.2)
box.Y2.BrickColor = BrickColor.new(26)
box.B2.BrickColor = BrickColor.new(26)
box.Y3.BrickColor = BrickColor.new(24)
box.B3.BrickColor = BrickColor.new(23)
wait(0.2)
box.Y3.BrickColor = BrickColor.new(26)
box.B3.BrickColor = BrickColor.new(26)
box.Y4.BrickColor = BrickColor.new(24)
box.B4.BrickColor = BrickColor.new(23)
wait(0.2)
box.Y4.BrickColor = BrickColor.new(26)
box.B4.BrickColor = BrickColor.new(26)
box.Y5.BrickColor = BrickColor.new(24)
box.B5.BrickColor = BrickColor.new(23)
wait(0.2)
box.Y5.BrickColor = BrickColor.new(26)
box.B5.BrickColor = BrickColor.new(26)
box.Y4.BrickColor = BrickColor.new(24)
box.B4.BrickColor = BrickColor.new(23)
wait(0.2)
box.Y4.BrickColor = BrickColor.new(26)
box.B4.BrickColor = BrickColor.new(26)
box.Y3.BrickColor = BrickColor.new(24)
box.B3.BrickColor = BrickColor.new(23)
wait(0.2)
box.Y3.BrickColor = BrickColor.new(26)
box.B3.BrickColor = BrickColor.new(26)
box.Y2.BrickColor = BrickColor.new(24)
box.B2.BrickColor = BrickColor.new(23)
wait(0.2)
box.Y2.BrickColor = BrickColor.new(26)
box.B2.BrickColor = BrickColor.new(26)
box.Y1.BrickColor = BrickColor.new(24)
box.B1.BrickColor = BrickColor.new(23)
wait(0.1)
end

</ProtectedString>
