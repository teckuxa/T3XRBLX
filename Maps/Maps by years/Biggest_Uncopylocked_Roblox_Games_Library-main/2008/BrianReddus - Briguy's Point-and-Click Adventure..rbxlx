	local hit = mouse.Target
	if (hit == nil) then return end

	if hit.Parent.Name == &quot;TV&quot; then
		local message = Instance.new(&quot;Hint&quot;)
		message.Text = &quot;You used the diamond to cut the TV off the wall.&quot;
