				<Item class="Script" referent="RBX2222">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">regen = script.Parent.Parent:clone()

function onClick()
	--LOL regen
	script.Parent.Parent:remove()
	regen.Parent= game.Workspace
	regen:makeJoints()
end

script.Parent.ClickDetector.MouseClick:connect(onClick)</ProtectedString>
