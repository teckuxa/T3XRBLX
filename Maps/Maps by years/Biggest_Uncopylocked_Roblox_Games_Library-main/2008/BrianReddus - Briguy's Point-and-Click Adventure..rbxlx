					<Item class="Script" referent="RBX1245">
						<Properties>
							<bool name="Archivable">true</bool>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">--Basically checks if the toucher of the button is a player, then adds that players name to a StringValue.
--The factorys buttons always check if the toucher is the same as the owner, and will not do anything
--unless the touchers name is the same as the owners name.

--Uberubert
--This script is free to use for anyone

local ting = 0 --debouncer
owner = script.Parent.Parent.Parent.Owner --This is the thing that holds the owners name

function onTouched(hit)

	if ting == 0 then --debounce check
	ting = 1 --activate debounce
	check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;) --Find the human that touched the button

	if check ~= nil then --If a human is found, then
		local user = game.Players:GetPlayerFromCharacter(hit.Parent) --Find human among the players
		owner.Value = hit.Parent.Name --save new owners name for later.
	end
	script.Parent:Remove()

	ting = 0 --remove debounce
	end

end

script.Parent.Touched:connect(onTouched) --Start listening for button-touchers.
</ProtectedString>
						</Properties>
					</Item>
				</Item>
