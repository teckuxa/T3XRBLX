								<ProtectedString name="Source">function mode1()
--good flashing
script.Parent.Color = randval1 --Color3.new(math.random(), math.random(), math.random()) 
wait(0.5)
script.Parent.Color = randval3 --Color3.new(math.random(), math.random(), math.random()) 
