						<ProtectedString name="Source">function onTouched(part)
	if part.Name == &quot;SafeDoor&quot; then
	part.BodyVelocity.velocity = Vector3.new(5,0,0)
		local message = Instance.new(&quot;Hint&quot;)
		message.Text = &quot;Wow! The remote opened the wall! Whats inside?&quot;
		message.Parent = game.Players:findFirstChild(part.Parent.Owner.Value)
		wait(3)
		message:Remove()

	end
	if part.Parent.Name == &quot;TV&quot; then
		local message = Instance.new(&quot;Hint&quot;)
		message.Text = &quot;Thats odd, the remote wont work on the TV. IS there anything else in the room?&quot;
		message.Parent = game.Players:findFirstChild(part.Parent.Parent.Owner.Value)
		wait(3)
		message:Remove()
	end
end 

