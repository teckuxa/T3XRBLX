				<Item class="Script" referent="RBX3581">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">SignScript</string>
						<ProtectedString name="Source">local sign = script.Parent 
local teleporter = sign.Parent 

local placeId = teleporter.PlaceId
local decal
local tex

if placeId then 
	placeId = placeId.Value
	decal = script.Parent.Decal
	tex = &quot;http://www.roblox.com/Thumbs/Asset.ashx?format=png&amp;width=420&amp;height=230&amp;assetId=&quot; ..placeId
	decal.Texture = tex
end



</ProtectedString>
					</Properties>
