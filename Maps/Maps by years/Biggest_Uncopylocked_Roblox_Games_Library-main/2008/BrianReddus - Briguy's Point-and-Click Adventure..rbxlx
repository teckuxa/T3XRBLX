					<Item class="Script" referent="RBX1335">
						<Properties>
							<bool name="Archivable">true</bool>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">function onTouched(part)
local player = game.Players:GetPlayerFromCharacter(part.Parent)
	if player.Backpack == nil then
		print(&quot;Player haf no bakpak!&quot;)
		elseif player.Backpack ~= nil then
		print(&quot;Playa haf bakpak!&quot;)
		player.Backpack.Remote:Remove()
		player.Backpack.Diamond:Remove()
		player.Backpack.Metal_Fan:Remove()
		local message = Instance.new(&quot;Hint&quot;)
		message.Text = &quot;You drop all  but the crowbar. You may need it&quot;
		message.Parent = player
		script.Parent.Parent:Remove()
		wait(5)
		message:Remove()
	end
end

script.Parent.Touched:connect(onTouched)</ProtectedString>
						</Properties>
					</Item>
				</Item>
			</Item>
