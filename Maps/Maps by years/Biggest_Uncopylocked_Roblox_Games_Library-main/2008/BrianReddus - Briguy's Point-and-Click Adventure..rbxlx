			local ly = y
			local lz = 0
			torso.Anchored = true
			torso.CFrame = CFrame.new(Vector3.new(x,y,z), Vector3.new(lx,ly,lz))

message.Text = &quot;Should be easy enough.&quot; 
wait(2.7)
message.Text = &quot;FOUR HOURS LATER&quot;
local stat = player.leaderstats:findFirstChild(&quot;Time Spent on Mission&quot;)
stat.Value = stat.Value + 240
wait(2.7)	
message.Text = &quot;Professor Boddy, over intercom: Slave Number Two to Lab for weapons testing!&quot; 
wait(4.5)
			local p = game.Workspace:findFirstChild(&quot;MachineFloor&quot;)
			local torso = char.Torso
			local location = {p.Position}
			local i = 1

			local x = location[i].x
			local y = location[i].y
			local z = location[i].z

			x = x + math.random(-1, 1)
			z = z + math.random(-1, 1)
			y = y + math.random(2, 3)

			local cf = torso.CFrame
			local lx = 0
			local ly = y
			local lz = 0

			torso.CFrame = CFrame.new(Vector3.new(x,y,z), Vector3.new(lx,ly,lz))
message.Text = &quot;Professor Boddy: Time for you to be the victim of my latest torture device!&quot;
wait(4)
message.Text = &quot;***THINK FAST!***&quot;
wait(1)
local n = pack:FindFirstChild(&quot;LeadPipe&quot;)
if n ~= nil then
message.Text = &quot;You thought fast! You&apos;re smart!&quot;
wait(2.5)
message.Text = &quot;In a throwback to the classic Clue (Cluedo for Brits), you attack Boddy with the Lead Pipe&quot;
wait(2)
game.Workspace:findFirstChild(&quot;Professor Boddy&quot;).Humanoid.Health = 1
char.Torso.Anchored = false
torso.CFrame = CFrame.new(Vector3.new(x,y,z), Vector3.new(lx,ly,lz))
wait(2)
message.Text = &quot;SUCCESS! You are free!&quot;
wait(2)
message.Parent = nil
wait(5)
game.Workspace:findFirstChild(&quot;Professor Boddy&quot;).Humanoid.Health = 100
elseif n == nil then
char.Humanoid.Health = 0
local stat = player.leaderstats:findFirstChild(&quot;Time Spent on Mission&quot;)
stat.Value = stat.Value - 240
message.Text = &quot;FAILURE. You couldn&apos;t think of anything. Retry?&quot;
wait(2.5)
message.Text = &quot;y_&quot;
wait(0.5)
message.Parent = nil
end
elseif l == nil then 
local player = bin.Parent.Parent 
local message = Instance.new(&quot;Hint&quot;) 
message.Text = &quot;Hmm...I should be wearing a hat, so I can trick them into letting me in.&quot; 
message.Parent = player 
wait(5) 
message.Text = &quot;Without one, it&apos;ll be pretty obvious I&apos;m not a slave.&quot; 
wait(4) 
message.Parent = nil 
end 
end

		if (hit.Parent.Name == &quot;BadStars&quot;) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = &quot;Got fake Void Star! With Mind-Control Chip!&quot;
			message.Parent = player
			wait(4)
			message.Text = &quot;Oh dear...&quot;
			wait(1)
			char.Humanoid.Health = 0
			wait(1)
			message.Parent = nil
		end

		if (hit.Parent.Name == &quot;GoodStars&quot;) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = &quot;Got a fake Void Star! Without Mind-Control Chip!&quot;
			message.Parent = player
			game.Lighting.Hat:clone().Parent = pack
			wait(4)
			message.Text = &quot;Phew!&quot;
			wait(2)
			message.Parent = nil
		end

		if (hit.Name == &quot;Port1&quot;) or (hit.Name == &quot;Port2&quot;) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = &quot;I must walk into the light...I must WALK INTO the light...&quot;
			message.Parent = player
			wait(6)
			message.Parent = nil
		end

		if (hit.Name == &quot;Disco&quot;) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = &quot;I&apos;d rather not.&quot;
			message.Parent = player
			wait(3)
			message.Parent = nil
		end

		if (hit.Name == &quot;Finale&quot;) then
		if (game.Workspace.Slot1.BrickColor.Number == 105) and
			(game.Workspace.Slot2.BrickColor.Number == 24) and
			(game.Workspace.Slot3.BrickColor.Number == 23) and
			(game.Workspace.Slot4.BrickColor.Number == 28) then
			f = game.Workspace.Finale
			f.Transparency = 1
			f.CanCollide = false
			wait(5)
			f.Transparency = 0
			f.CanCollide = true
		else return end
		end

		if (hit.Name == &quot;Slot1&quot;) or (hit.Name == &quot;Slot2&quot;) or (hit.Name == &quot;Slot3&quot;) or (hit.Name == &quot;Slot4&quot;) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = &quot;I need to use the shape keys on these slots.&quot;
			message.Parent = player
			wait(4)
			message.Parent = nil
		end

		if (hit.Name == &quot;Key1&quot;) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = &quot;Got Square Key!&quot;
			game.Lighting.Square:clone().Parent = pack
			message.Parent = player
			wait(4)
			message.Parent = nil
		end

		if (hit.Name == &quot;Key2&quot;) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = &quot;Got Head?&quot;
			game.Lighting.Head:clone().Parent = pack
			message.Parent = player
			wait(4)
			message.Parent = nil
		end

		if (hit.Name == &quot;Key3&quot;) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = &quot;Got Wedge Key!&quot;
			game.Lighting.Wedge:clone().Parent = pack
			message.Parent = player
			wait(4)
			message.Parent = nil
		end

		if (hit.Name == &quot;Key4&quot;) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = &quot;Got Sphere Key!&quot;
			game.Lighting.Sphere:clone().Parent = pack
			message.Parent = player
			wait(4)
			message.Parent = nil
		end

