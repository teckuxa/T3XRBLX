			message.Text = hit.Message.Value
			message.Parent = player
			wait(5)
			message.Parent = nil
		end

		if (hit.Name == &quot;MetalSliver&quot;) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = hit.Message.Value
			message.Parent = player
			wait(5)
			message.Parent = nil
		end
--[[

		if (hit == game.Workspace.Plank) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = &quot;I can&apos;t just pull them away with my bare hands! I need something to hammer them away with.&quot;
			message.Parent = player
			wait(5)
			message.Parent = nil
		end

		if (hit == game.Workspace.SpawnLocation) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = &quot;Me and PU Division have an agreement to only use the spawn points when I die.&quot;
			message.Parent = player
			wait(5)
			message.Parent = nil
		end

		if (hit.Name == &quot;Icicle&quot;) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = &quot;I&apos;m cold enough as it is.&quot;
			message.Parent = player
			wait(3)
			message.Parent = nil
		end

		if (hit.Name == &quot;IceDoor&quot;) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = &quot;I...it w...w...won&apos;t b...b...b...budge.&quot;
			message.Parent = player
			wait(4)
			message.Parent = nil
		end

		if (hit.Name == &quot;IceDoor2&quot;) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = &quot;Yep, still stuck.&quot;
			message.Parent = player
			wait(3)
			message.Parent = nil
		end

		if (hit.Name == &quot;Hammer&quot;) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = &quot;Got Hammer!&quot;
			message.Parent = player
			wait(3)
			game.Lighting.HammerTime:clone().Parent = pack
			message.Text = &quot;Now, how are we going to get out of here?&quot;
			wait(4)
			message.Text = &quot;*THE WRITER HAS FIXED THE PLOT HOLE. YOU HAVE TO GET OUT OF HERE YOURSELF. HA.*&quot;
			wait(7)
			message.Parent = nil
		end

		if (hit.Name == &quot;Cabinets&quot;) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = &quot;They won&apos;t open.&quot;
			message.Parent = player
			wait(3)
			message.Parent = nil
		end

		if (hit.Name == &quot;Stove&quot;) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = &quot;I&apos;ll need an oven mitt.&quot;
			message.Parent = player
			wait(3)
			message.Parent = nil
		end

		if (hit.Name == &quot;Fridge&quot;) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = &quot;Got Leftovers! Ewww.....&quot;
			game.Lighting.Leftovers:clone().Parent = pack
			message.Parent = player
			wait(4)
			message.Parent = nil
		end

		if (hit.Name == &quot;Mitt&quot;) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = &quot;Acquired Oven Mitt!&quot;
			game.Lighting.OvenMitt:clone().Parent = pack
			message.Parent = player
			wait(4)
			message.Parent = nil
		end

		if (hit.Name == &quot;Counter&quot;) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = &quot;You there! Will you let me in?&quot;
			message.Parent = player
			wait(4)
			message.Text = &quot;Guard: Nope. Strict orders from the boss. Sorry. I might let you in for some...I dunno, cookies?&quot;
			wait(6)
			message.Text = &quot;Well, okay then...I guess I&apos;ll need to find some cookies.&quot;
			wait(5)
			message.Parent = nil
		end




		if (hit.Name == &quot;Box&quot;) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = &quot;Nope, the box looks pretty much solid. I&apos;ll have to get a fake Void Star some other way.&quot;
			message.Parent = player
			wait(5)
			message.Parent = nil
		end

		if (hit.Name == &quot;Pipe&quot;) then
			local message = Instance.new(&quot;Hint&quot;)
			message.Text = &quot;Got Lead Pipe!&quot;
			message.Parent = player
			game.Lighting.LeadPipe:clone().Parent = pack
			wait(4)
			message.Text = &quot;Great...now I&apos;ll be a murder suspect.&quot;
			wait(4)
			message.Parent = nil
		end

