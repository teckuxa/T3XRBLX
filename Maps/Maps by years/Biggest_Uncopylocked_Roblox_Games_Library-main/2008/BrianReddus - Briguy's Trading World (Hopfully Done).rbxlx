							<string name="Name">Money</string>
							<string name="Source">profit = script.Parent.Parent.Parent.MoneySaved


function onTouched(hit)
	h = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
	if h ~= nil then
		print(&quot;Touched&quot;)
		person = game.Players:findFirstChild(hit.Parent.Name)
		if person ~= nil then
		money = person.leaderstats.Money
		money.Value = money.Value + profit.Value
		profit.Value = 0
		end
	else
	print (&quot;Not Human&quot;)
	end
end


script.Parent.Touched:connect(onTouched)</string>
