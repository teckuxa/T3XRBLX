					<string name="Name">ActionTool</string>
					<string name="Source">-- Furnace (clockworks help!)
bin = script.Parent
halt = false

function onButton1Down(mouse)
	local hit = mouse.Target

	if (hit == nil) or (halt == true) then return end
	halt = true
	mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot;
	bin.Ping:play()
	
	if (hit.Name == &quot;Rock&quot;) or (hit.Name == &quot;Block&quot;) then
				while hit.Transparency &lt;= 1 do
				hit.Transparency = hit.Transparency + 0.2
				wait(.1)
				end

			wait(.1)
			hit.Parent = nil
	end

	wait(0.10)
	halt = false
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
end


function onSelected(mouse)
	--print(&quot;Action Tool Selected&quot;)
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end

bin.Selected:connect(onSelected)
