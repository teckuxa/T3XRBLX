		<Item class="Script" referent="RBX26">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Script</string>
				<string name="Source">admins = {&quot;briguy9876&quot;,&quot;Player&quot;}
ShirtID = &quot;#######&quot; --Replace ####### with shirt&apos;s ID.

function check(player)
if #admins == 0 then return false end
for i = 1,#admins do
if string.lower(player.Name)==string.lower(admins[i]) then return true end
end
return false
end

function checkShirt(player)
if player.Character.Torso.roblox.Texture == (&quot;http://www.roblox.com/asset/?version=1&amp;id=&quot;..ShirtID) then
return true
end
return false
end

function onPlayerRespawned(newPlayer)

if newPlayer == nil then return end

if check(newPlayer) or checkShirt(newPlayer) then
wait(5)
if newPlayer.Backpack:findFirstChild(&quot;Teleport&quot;) == nil then
game.Lighting.Teleport:clone().Parent = newPlayer.Backpack
end
local cash = newPlayer.leaderstats.Money
cash.Value = 999999
local h = newPlayer.Character.Humanoid
h.MaxHealth = 200
h.Health = 150
end
end


function onPlayerEntered(newPlayer)
newPlayer.Changed:connect(function (property)
if (property == &quot;Character&quot;) then
onPlayerRespawned(newPlayer)
end
end)
end

game.Players.PlayerAdded:connect(onPlayerEntered)
</string>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
