				<Item class="Script" referent="RBX1193">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">GoldS</string>
						<string name="Source">function onTouched(hit)
	h = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
	if h~= nil then
		person = game.Players:findFirstChild(hit.Parent.Name)
		money = person.leaderstats.Money
		money.Value = money.Value + 100
		script.Parent:remove()
	end
end


script.Parent.Touched:connect(onTouched)

print(&quot;Gold Made&quot;)</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
			<Item class="Model" referent="RBX1194">
				<Properties>
					<token name="Controller">0</token>
					<bool name="ControllerFlagShown">true</bool>
					<CoordinateFrame name="ModelInPrimary">
						<X>0</X>
						<Y>0</Y>
						<Z>0</Z>
						<R00>1</R00>
						<R01>0</R01>
						<R02>0</R02>
						<R10>0</R10>
						<R11>1</R11>
						<R12>0</R12>
						<R20>0</R20>
						<R21>0</R21>
						<R22>1</R22>
					</CoordinateFrame>
					<string name="Name">Random Block</string>
					<Ref name="PrimaryPart">null</Ref>
					<bool name="archivable">true</bool>
				</Properties>
				<Item class="Script" referent="RBX1195">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<string name="Source">--Randomized digsite

Block = script.Parent.Block
GoldScript = script.Parent.GoldS
BrickLoc = script.Position
BrickLoc.Value = CFrame.new(Block.CFrame.x,Block.CFrame.y,Block.CFrame.z + 1)


for i=1,12 do
	b = math.random(1,10)
	if b &lt;= 7 then
	newBlock = Instance.new(&quot;Part&quot;)
	newBlock.BrickColor = Block.BrickColor
	newBlock.Anchored = true
	newBlock.formFactor = 0
	newBlock.Size = Block.Size
	newBlock.Parent = game.Workspace.DigBricks
	newBlock.Name = &quot;Block&quot;
	newBlock.CFrame = CFrame.new(BrickLoc.Value.x, BrickLoc.Value.y, BrickLoc.Value.z + 10)
	BrickLoc.Value = newBlock.CFrame
	elseif b&gt;7 and b&lt;=9 then
	newBlock = Instance.new(&quot;Part&quot;)
	newBlock.BrickColor = BrickColor.new(194)
	newBlock.Anchored = true
	newBlock.formFactor = 0
	newBlock.Size = Block.Size
	newBlock.Parent = game.Workspace.DigBricks
	newBlock.Name = &quot;Rock&quot;
	newBlock.CFrame = CFrame.new(BrickLoc.Value.x, BrickLoc.Value.y, BrickLoc.Value.z + 10)
	BrickLoc.Value = newBlock.CFrame
	else
	gold = Instance.new(&quot;Part&quot;)
	gold.BrickColor = BrickColor.new(24)
	gold.Reflectance = .5
	goldS = GoldScript:clone()
	goldS.Parent = gold
	goldS.Disabled = false
	gold.Parent = game.Workspace.DigBricks
	BrickLoc.Value = CFrame.new(BrickLoc.Value.x, BrickLoc.Value.y, BrickLoc.Value.z + 10)
	gold.CFrame = BrickLoc.Value
end
end
</string>
