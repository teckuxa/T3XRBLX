		<Item class="Script" referent="RBX3330">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">StarterPack</string>
				<string name="Source">function onPlayerRespawned(newPlayer)

if newPlayer == nil then return end

	m = Instance.new(&quot;Hint&quot;)
	m.Text = &quot;Loading Tools....&quot;
	m.Parent = newPlayer
	wait(3)
	m:remove()

	if newPlayer:findFirstChild(&quot;HasTools&quot;) == nil then
game.Lighting.Dig:clone().Parent = newPlayer.Backpack
game.Lighting.ClickAxe:clone().Parent = newPlayer.Backpack
game.Lighting.Donate:clone().Parent = newPlayer.Backpack
game.Lighting.Car:clone().Parent = newPlayer.Backpack
game.Lighting:findFirstChild(&quot;Give Wood&quot;):clone().Parent = newPlayer.Backpack

m = Instance.new(&quot;BoolValue&quot;)
m.Name = &quot;HasTools&quot;
m.Parent = newPlayer
end
end


function onPlayerEntered(newPlayer)
newPlayer.Changed:connect(function (property)
if (property == &quot;Character&quot;) then
onPlayerRespawned(newPlayer)
end
end)
end

game.Players.PlayerAdded:connect(onPlayerEntered)
</string>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
