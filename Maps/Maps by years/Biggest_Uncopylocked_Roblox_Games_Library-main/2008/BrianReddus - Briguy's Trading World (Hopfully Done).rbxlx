bin = script.Parent
halt = false

function onButton1Down(mouse)
	local hitt = mouse.Target

	if (hitt == nil) or (halt == true) then return end
	halt = true
	mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot;

	
	if (hitt.Parent.Name == &quot;Tree&quot;) then
				local user = bin.Parent.Parent
				bin.Ping:play()
				hitt.Parent.hit.Value = hitt.Parent.hit.Value - 3
					if hitt.Parent.hit.Value &lt; 1 and hitt.Parent.Timber.Value == 0 then --check if the tree is felled
		user.leaderstats.Wood.Value = user.leaderstats.Wood.Value + 4--add money to the dude with the axe
		hitt.Parent.Timber.Value = 1 --this declares the tree &quot;felled&quot; and makes sure nobody else can get money from it
		wait(resettime)
	else
		wait(1)
	end
	end

	wait(.1)
	halt = false
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
end


function onSelected(mouse)
	--print(&quot;Action Tool Selected&quot;)
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end

