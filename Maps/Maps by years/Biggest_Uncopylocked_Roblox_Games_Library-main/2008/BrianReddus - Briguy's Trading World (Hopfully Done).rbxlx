		<Item class="Script" referent="RBX19">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Regen</string>
				<string name="Source">WallB = game.Workspace.WallBackup.Value
Wall = game.Workspace.Wall
WallB = Wall:clone()

while true do
	wait(600)
	Wall:remove()
	game.Workspace.DigBricks:remove()
	thing = Instance.new(&quot;Model&quot;)
	thing.Name = &quot;DigBricks&quot;
	thing.Parent = game.Workspace
	print(&quot;Removing Bricks&quot;)
	m = Instance.new(&quot;Message&quot;)
	m.Parent = game.Workspace
	m.Text = &quot;Creating new Digging Area...&quot;
	wait(3)
	WallBack = WallB:clone()
	WallBack.Parent = game.Workspace
	print(&quot;Adding new wall&quot;)
	Wall = WallBack
	m:remove()
end
</string>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
