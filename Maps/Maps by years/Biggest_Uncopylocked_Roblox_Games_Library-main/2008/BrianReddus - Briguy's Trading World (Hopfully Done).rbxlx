				</Properties>
				<Item class="Script" referent="RBX3755">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<string name="Source">while true do
	wait(60)
	local money = script.Parent
	if money.Value &gt; 0 then
	money.Value = money.Value + (money.Value*.1)
end
end
</string>
