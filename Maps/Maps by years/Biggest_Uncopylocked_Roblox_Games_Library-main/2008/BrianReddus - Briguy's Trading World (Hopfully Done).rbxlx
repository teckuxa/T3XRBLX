			<Item class="Sound" referent="RBX5817">
				<Properties>
					<bool name="Looped">false</bool>
					<string name="Name">Ping</string>
					<int name="PlayCount">85</int>
					<bool name="PlayOnRemove">false</bool>
					<Content name="SoundId"><hash>5d76008258272483b448e8dae14f4751</hash></Content>
					<float name="Volume">1</float>
