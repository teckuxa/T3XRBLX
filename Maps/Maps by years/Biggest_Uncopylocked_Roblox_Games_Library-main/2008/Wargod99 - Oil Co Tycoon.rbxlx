				<Item class="Script" referent="RBX7055">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">ObjectsAndOwnerHandling2</string>
						<ProtectedString name="Source">owner = script.Parent.OwnerName
local newfacpara = script.Parent.Parent
local factoryBackup = script.Parent.Parent.RigValue
factory = script.Parent
stuff = factory.Stuff
local B = nil
if factoryBackup.Value == nil then  --If the factory hasn&apos;t been stored yet (Game just started)

&#9;B = Instance.new(&quot;Model&quot;)
&#9;B.Name = &quot;[Wargod99] Oil Tycoon [ItemId: &quot; ..math.random(1,10000).. &quot;]&quot;
&#9;B.Parent = game.Lighting
&#9;A = script.Parent:Clone()
&#9;A.Parent = B
&#9;factoryBackup.Value = A

&#9;stuff.ExtraOil.oil4.Value = factory:findFirstChild(&quot;Sell Oil For $4 cost: 600,-&quot;)
&#9;stuff.ExtraOil.oil6.Value = factory:findFirstChild(&quot;Sell Oil For $6 cost: 1200,-&quot;)
&#9;stuff.ExtraOil.oil8.Value = factory:findFirstChild(&quot;Sell Oil For $8 cost: 2000,-&quot;)
&#9;stuff.ExtraOil.oil10.Value = factory:findFirstChild(&quot;Sell Oil For $10 cost: 4000,-&quot;)

&#9;stuff.oru.Value = factory:findFirstChild(&quot;Upgrade oil refiner oil value = oil value +20 cost: 5000,-&quot;)
&#9;stuff.buygt.Value = factory:findFirstChild(&quot;Buy Gas Tanks: 5000,-&quot;)


&#9;stuff.House.buyf2.Value = factory:findFirstChild(&quot;Buy 2nd Floor cost: 500,-&quot;)
&#9;stuff.House.f2.Value = factory.House.f2


&#9;stuff.Fence.Value = factory.Fence
&#9;stuff.Road.Value = factory.Road
&#9;stuff.House.Small.Value = factory.House.Small
&#9;stuff.House.Medium.Value = factory.House.Medium
&#9;stuff.Rigs.Rig1.Value = factory.Rig1
&#9;stuff.Rigs.Rig2.Value = factory.Rig2
&#9;stuff.Rigs.Rig3.Value = factory.Rig3
&#9;stuff.Rigs.Rig4.Value = factory.Rig4
&#9;stuff.Rigs.Rig5.Value = factory.Rig5
&#9;stuff.extraprof.BuyTrain.Value = factory.SBT
&#9;stuff.extraprof.Company.Value = factory.SBL

&#9;stuff.oilref.Value = factory.oilref
&#9;stuff.oilrefb.Value = factory.oilrefb
&#9;stuff.GT.Value = factory.GasTank




------------------------SKY SCRAPER----------------------------------------------------
buttonclone = script.Parent.buttonclone
buttonclone.Value = script.Parent.GroundFloor.Stairs:findFirstChild(&quot;Lay Floor&quot;)
storyclone = script.Parent.Storyclone
story = script.Parent.Story
story2 =script.Parent
story2.Stair.Value = story.Stairs
story2.Supports1.Value = story.Supporters1
story2.Supports2.Value = story.Supporters2
story2.Walls1.Value = story.Wall1
story2.Walls2.Value = story.Wall2
story2.Walls3.Value = story.Wall3
story2.Walls4.Value = story.Wall4
story.Stairs.Parent = B
story.Supporters1.Parent = B
story.Supporters2.Parent = B
story.Wall1.Parent = B
story.Wall2.Parent = B
story.Wall3.Parent = B
story.Wall4.Parent = B

storyclone.Value = story
story.Parent = B
--------------------------------------------------------------

&#9;--Removing stored stuff that can be upgraded/spawned

&#9;factory:findFirstChild(&quot;Sell Oil For $4 cost: 600,-&quot;).Parent = B
&#9;factory:findFirstChild(&quot;Sell Oil For $6 cost: 1200,-&quot;).Parent = B
&#9;factory:findFirstChild(&quot;Sell Oil For $8 cost: 2000,-&quot;).Parent = B
&#9;factory:findFirstChild(&quot;Sell Oil For $10 cost: 4000,-&quot;).Parent = B
&#9;factory:findFirstChild(&quot;Buy Gas Tanks: 5000,-&quot;).Parent = B
&#9;factory:findFirstChild(&quot;Upgrade oil refiner oil value = oil value +20 cost: 5000,-&quot;).Parent = B

&#9;factory.Fence.Parent = B
&#9;factory.Road.Parent = B
&#9;factory.House.Medium.Parent = B
&#9;factory.Rig1.Parent = B
&#9;factory.Rig2.Parent = B
&#9;factory.Rig3.Parent = B
&#9;factory.Rig4.Parent = B
&#9;factory.Rig5.Parent = B
&#9;factory.SBL.Parent = B
&#9;factory.SBT.Parent = B

&#9;factory.oilref.Parent = B
&#9;factory.oilrefb.Parent = B
&#9;factory.GasTank.Parent = B


&#9;factory.House.f2.Parent = B
&#9;factory:findFirstChild(&quot;Buy 2nd Floor cost: 500,-&quot;).Parent = B






end
wait(1)
script.Parent.OilValue.Value = 0
while script.Parent ~= nil do
&#9;if owner.Value ~= &quot;&quot; then
&#9;print (&quot;Owner: &quot; ..owner.Value)
&#9;&#9;local navn = owner.Value
&#9;&#9;leaver = game.Players:FindFirstChild(navn)
&#9;&#9;if leaver == nil then
&#9;&#9;&#9;print (&quot;Reset&quot;)
&#9;&#9;&#9;owner.Value = &quot;&quot;
&#9;&#9;&#9;MajorReset = factoryBackup.Value:Clone()
&#9;&#9;&#9;factoryBackup.Value:remove()
&#9;&#9;&#9;factoryBackup.Value = nil
&#9;&#9;&#9;B:Remove()
&#9;&#9;&#9;&#9;S =  script.Parent:GetChildren()
&#9;&#9;&#9;&#9;for i = 1, #S do
&#9;&#9;&#9;&#9;&#9;if S[i].Name == &quot;Story&quot; then
&#9;&#9;&#9;&#9;&#9;S[i]:Remove()
&#9;&#9;&#9;&#9;&#9;wait(.5)
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;script.Parent:remove()
&#9;&#9;&#9;MajorReset.Parent = newfacpara
&#9;&#9;&#9;MajorReset:MakeJoints()
&#9;&#9;end
&#9;else
&#9;print (&quot;No Owner&quot;)
&#9;end
&#9;wait(2)
end
