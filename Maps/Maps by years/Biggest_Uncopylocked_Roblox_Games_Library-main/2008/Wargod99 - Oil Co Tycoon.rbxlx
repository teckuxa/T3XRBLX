&#9;&#9;&#9;&#9;&#9;machinee:MakeJoints()

&#9;&#9;&#9;&#9;&#9;machinef = factory.Stuff.buytankb.Value:clone()
&#9;&#9;&#9;&#9;&#9;machinef.Parent = factory
&#9;&#9;&#9;&#9;&#9;machinef:MakeJoints()

&#9;&#9;&#9;&#9;&#9;machinec = factory.Stuff.buyShop.Value:clone()
&#9;&#9;&#9;&#9;&#9;machinec.Parent = factory
&#9;&#9;&#9;&#9;&#9;machinec:MakeJoints()

&#9;&#9;&#9;&#9;&#9;machined = factory.Stuff.buyStationRoof.Value:clone()
&#9;&#9;&#9;&#9;&#9;machined.Parent = factory
&#9;&#9;&#9;&#9;&#9;machined:MakeJoints()


&#9;&#9;&#9;&#9;&#9;machineg = factory.Stuff.buySighn.Value:clone()
&#9;&#9;&#9;&#9;&#9;machineg.Parent = factory
&#9;&#9;&#9;&#9;&#9;machineg:MakeJoints()










script.Parent.Parent:remove()


&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end

&#9;end
&#9;ting = 0
&#9;end
end

