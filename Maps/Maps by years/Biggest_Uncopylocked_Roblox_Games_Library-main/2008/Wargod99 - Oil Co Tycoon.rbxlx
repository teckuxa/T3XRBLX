									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">Script</string>
									<ProtectedString name="Source">story = script.Parent.Parent.Parent
owner = story.Parent.OwnerName
newfloor = story.StairsCheck

local ting = 0 

function onTouched(hit)
&#9;if ting == 0 then 
&#9;ting = 1 
&#9;check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;) 
&#9;if check ~= nil then
&#9;&#9;if owner.Value == hit.Parent.Name then
&#9;&#9;newwalls = story.Parent.Supports2.Value:clone() --Change wallnumber on copy
&#9;&#9;newwalls.Parent = story
&#9;&#9;newwalls:MakeJoints()
&#9;&#9;script.Parent.Parent:remove()
&#9;&#9;newfloor.Value = newfloor.Value + 1
&#9;&#9;end
&#9;end
&#9;ting = 0 
&#9;end
end

script.Parent.Touched:connect(onTouched) 
</ProtectedString>
								</Properties>
							</Item>
							<Item class="Script" referent="RBX7508">
								<Properties>
									<bool name="Archivable">true</bool>
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">Script</string>
									<ProtectedString name="Source">floornumber = script.Parent.Parent.Parent.StoryNumber.Value
local location = {script.Parent.Position}
local i = 1
local x = location[i].x
local z = location[i].z
script.Parent.Position = Vector3.new(x,1.8 + (12.4 * floornumber),z)</ProtectedString>
