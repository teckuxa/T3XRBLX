						<string name="Name">Add PVals</string>
						<ProtectedString name="Source">while true do
wait(0.1)

local P1 = script.Parent.PV1
local P2 = script.Parent.PV2
local P3 = script.Parent.PV3
local P4 = script.Parent.PV4
local P5 = script.Parent.PV5
local P6 = script.Parent.PV6
local P7 = script.Parent.PV7
local P8 = script.Parent.PV8

local PValue = script.Parent.PValue

PValue.Value = P1.Value + P2.Value + P3.Value + P4.Value + P5.Value + P6.Value + P7.Value + P8.Value

end
