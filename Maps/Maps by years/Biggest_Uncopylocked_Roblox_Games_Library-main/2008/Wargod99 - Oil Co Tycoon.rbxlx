						<string name="Name">PresentScript</string>
						<ProtectedString name="Source">-- copyright (c)
-------------------------------------------------------------------------------------------------------------------------------------------
-- please give credit to: nickcool9999
-- i am asking please.
-------------------------------------------------------------------------------------------------------------------------------------------
local debounce = false -- when the server starts the debounce is false

function getPlayer(humanoid) -- find the player
local players = game.Players:children() -- enter the players folder
for i = 1, #players do -- i=1 so (variable)
if players[i].Character.Humanoid == humanoid then return players[i] end -- if a humanoid is a player then 
end -- end of script
return nil -- infinite loop
end -- end of script

function onTouch(part) -- if a player touches this part

local human = part.Parent:findFirstChild(&quot;Humanoid&quot;)  -- find the humanoid in the player
if (human ~= nil) and debounce == false then -- if a player touched this and debounce is false then

debounce = true -- a player touched this

local player = getPlayer(human)  -- try to find human who touched this

if (player == nil) then return end  -- if there is a player, do

script.Parent:findFirstChild(&quot;SuperJump&quot;):clone().Parent = player.Backpack -- the firepower plane tool

wait(2) -- wait 2 seconds
debounce = false -- end this script if there is not a human touching this
end -- end of script
end -- end of script


script.Parent.Touched:connect(onTouch) -- check for players who are going to touch this </ProtectedString>
					</Properties>
				</Item>
				<Item class="HopperBin" referent="RBX10138">
					<Properties>
						<bool name="Active">false</bool>
