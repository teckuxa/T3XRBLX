						<string name="Name">ObjectsAndOwnerHandling</string>
						<ProtectedString name="Source">owner = script.Parent.OwnerName
factoryBackup = game.Workspace.pstations.pstation5
factory = script.Parent
stuff = factory.Stuff




local B = nil
if factoryBackup.Value == nil then  --If the factory hasn&apos;t been stored yet (Game just started)

&#9;B = Instance.new(&quot;Model&quot;)
&#9;B.Name = &quot;[Wargod99] [P] Oil Tycoon [ItemId: &quot; ..math.random(1,10000).. &quot;]&quot;
&#9;B.Parent = game.Lighting
&#9;A = script.Parent:Clone()
&#9;A.Parent = B
&#9;factoryBackup.Value = A


&#9;--Storing stuff for later regen

&#9;stuff.buypumpa.Value = factory:findFirstChild(&quot;Buy A Petrol Pump(a) cost: 4000,-&quot;)
&#9;stuff.buypumpb.Value = factory:findFirstChild(&quot;Buy A Petrol Pump(b) cost: 4000,-&quot;)
&#9;stuff.buypumpc.Value = factory:findFirstChild(&quot;Buy A Diesel Pump(c) cost: 8000,-&quot;)
&#9;stuff.buypumpd.Value = factory:findFirstChild(&quot;Buy A Diesel Pump(d) cost: 8000,-&quot;)

&#9;stuff.buyCarwash.Value = factory:findFirstChild(&quot;Buy A Car Wash cost: 23,000,-&quot;)
&#9;stuff.buyShop.Value = factory:findFirstChild(&quot;Buy A Shop cost: 30,000,-&quot;)
&#9;stuff.buytankb.Value = factory:findFirstChild(&quot;Buy A Diesel Tank(b) cost: 15,000,-&quot;)
&#9;stuff.buytanka.Value = factory:findFirstChild(&quot;Buy A Petrol Tank(a) cost: 15,000,-&quot;)
&#9;stuff.buyStationRoof.Value = factory:findFirstChild(&quot;Buy A Station Roof cost: 10,000,-&quot;)
&#9;stuff.buySighn.Value = factory:findFirstChild(&quot;Buy A Station Sign cost: 1000,-&quot;)



&#9;stuff.pumpa.Value = factory.pumpa
&#9;stuff.pumpb.Value = factory.pumpb
&#9;stuff.pumpc.Value = factory.pumpc
&#9;stuff.pumpd.Value = factory.pumpd
&#9;
&#9;stuff.Road.Value = factory.Road
&#9;stuff.Carwash.Value = factory.Carwash
&#9;stuff.Sighn.Value = factory.Sighn
&#9;stuff.Shop.Value = factory.Shop
&#9;stuff.StationRoof.Value = factory.StationRoof

&#9;stuff.tanka.Value = factory.tanka
&#9;stuff.tankb.Value = factory.tankb


&#9;--Removing stored stuff that can be upgraded/spawned

&#9;factory:findFirstChild(&quot;Buy A Petrol Pump(a) cost: 4000,-&quot;).Parent=B
&#9;factory:findFirstChild(&quot;Buy A Petrol Pump(b) cost: 4000,-&quot;).Parent=B
&#9;factory:findFirstChild(&quot;Buy A Diesel Pump(c) cost: 8000,-&quot;).Parent=B
&#9;factory:findFirstChild(&quot;Buy A Diesel Pump(d) cost: 8000,-&quot;).Parent=B


&#9;factory:findFirstChild(&quot;Buy A Car Wash cost: 23,000,-&quot;).Parent=B
&#9;factory:findFirstChild(&quot;Buy A Shop cost: 30,000,-&quot;).Parent=B
&#9;factory:findFirstChild(&quot;Buy A Diesel Tank(b) cost: 15,000,-&quot;).Parent=B
&#9;factory:findFirstChild(&quot;Buy A Petrol Tank(a) cost: 15,000,-&quot;).Parent=B
&#9;factory:findFirstChild(&quot;Buy A Station Roof cost: 10,000,-&quot;).Parent=B

&#9;factory:findFirstChild(&quot;Buy A Station Sign cost: 1000,-&quot;).Parent=B



&#9;factory.pumpa.Parent=B
&#9;factory.pumpb.Parent=B
&#9;factory.pumpc.Parent=B
&#9;factory.pumpd.Parent=B
&#9;
&#9;factory.Road.Parent=B
&#9;factory.Carwash.Parent=B
&#9;factory.Sighn.Parent=B
&#9;factory.Shop.Parent=B
&#9;factory.StationRoof.Parent=B

&#9;factory.tanka.Parent=B
&#9;factory.tankb.Parent=B




end


wait(1)
while script.Parent ~= nil do
&#9;if owner.Value ~= &quot;&quot; then
&#9;&#9;local navn = owner.Value
&#9;&#9;ownr = game.Workspace.psowners:FindFirstChild(navn)
&#9;&#9;leaver = game.Players:FindFirstChild(navn)&#9;&#9;
&#9;&#9;&#9;if leaver == nil then
&#9;&#9;&#9;ownr:remove()
&#9;&#9;&#9;owner.Value = &quot;&quot;
&#9;&#9;&#9;MajorReset = factoryBackup.Value:clone()
&#9;&#9;&#9;script.Parent:remove()
&#9;&#9;&#9;MajorReset.Parent = game.Workspace.pstations
&#9;&#9;&#9;MajorReset:MakeJoints()
&#9;&#9;end
&#9;
&#9;else
&#9;print (&quot;no owner&quot;)
&#9;end
&#9;wait(2)
end








