								<string name="Name">Script</string>
								<ProtectedString name="Source">floornumber = script.Parent.Parent.StoryNumber.Value
c = script.Parent:getChildren()
for i = 1, #c do
if c[i].className == &quot;Part&quot; then
local location = {c[i].Position}
local x = location[1].x
local y = location[1].y
local z = location[1].z
c[i].CFrame = c[i].CFrame * CFrame.new(0,(12.4 * (floornumber - 1)),0)
script.Parent:MakeJoints()
end
end
</ProtectedString>
