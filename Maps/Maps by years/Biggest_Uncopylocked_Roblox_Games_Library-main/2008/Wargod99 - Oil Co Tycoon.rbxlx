							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">RewardCheck</string>
							<ProtectedString name="Source">storynum = script.Parent.StoryNumber

function message()
&#9;owner = script.Parent.Parent.Owner.Value
&#9;user = game.Players:findFirstChild(owner)
&#9;local message = Instance.new(&quot;Message&quot;) 
&#9;message.Text = &quot;Wow, you&apos;ve reached &quot; .. storynum.Value .. &quot;th Floor!&quot;
&#9;message.Parent = user
&#9;wait(2)
&#9;message.Parent = nil
&#9;if user ~=nil then
&#9;if storynum.Value == 50 or storynum.Value == 100 then 
&#9;&#9;message.Text = &quot;You got a teleport to the ground!&quot;
&#9;end
&#9;if storynum.Value == 200 then 
&#9;&#9;message.Text = &quot;You got a teleport to the ground!&quot;
&#9;end
&#9;if storynum.Value == 30 then
&#9;&#9;message.Text = &quot;You can claim a Fountain on the ground!&quot;
&#9;end
&#9;if storynum.Value == 70 then
&#9;&#9;message.Text = &quot;You can have windows washed from the ground!&quot;
&#9;end
&#9;message.Parent = user
&#9;wait(4)
&#9;message:remove()
&#9;end
end

if storynum.Value == 30 then
&#9;message()
end
if storynum.Value == 50 then
&#9;local tele = script.Parent.Parent.Tele50.Value:clone()
&#9;tele.Parent = script.Parent.Parent
&#9;message()
end
if storynum.Value == 70 then
&#9;message()
end
if storynum.Value == 100 then
&#9;local tele = script.Parent.Parent.Tele100.Value:clone()
&#9;tele.Parent = script.Parent.Parent
&#9;message()
