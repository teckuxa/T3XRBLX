										<ProtectedString name="Source">wait(1)
building = script.Parent.Parent.Parent.Parent.Parent
owner = building.OwnerName
local ting = 0 

function onTouched(hit)
&#9;if ting == 0 then 
&#9;ting = 1 
&#9;check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;) 
&#9;if check ~= nil then 
&#9;&#9;if owner.Value == hit.Parent.Name then
&#9;&#9;local newstory =  building.Storyclone.Value:clone()
&#9;&#9;building.TotalStories.Value = building.TotalStories.Value + 1
&#9;&#9;newstory.StoryNumber.Value = building.TotalStories.Value
&#9;&#9;newstory.Parent = building
&#9;&#9;newstory:MakeJoints()
&#9;&#9;user = game.Players:findFirstChild(owner.Value)
&#9;&#9;storystats = user.leaderstats.Stories
&#9;&#9;storystats.Value = building.TotalStories.Value
&#9;&#9;script.Parent.Parent:remove()
&#9;&#9;end
&#9;end
&#9;ting = 0 
&#9;end
end

script.Parent.Touched:connect(onTouched) 
