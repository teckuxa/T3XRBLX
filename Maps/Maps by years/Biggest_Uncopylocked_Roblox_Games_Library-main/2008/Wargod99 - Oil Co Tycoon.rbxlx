&#9;&#9;&#9;&#9;&#9;machinec.Parent = factory
&#9;&#9;&#9;&#9;&#9;machinec:MakeJoints()





&#9;&#9;&#9;&#9;&#9;script.Parent.Parent:remove()
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end

&#9;end
