				<Item class="Script" referent="RBX2411">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">MatsBlue</string>
						<ProtectedString name="Source">function onTouched(part)

&#9;local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;if h~=nil then

&#9;local pants = part.Parent:FindFirstChild(&quot;Pants&quot;)
&#9;local top = part.Parent:FindFirstChild(&quot;Shirt&quot;)
&#9;

&#9;if top ~= nil then 
&#9;top:remove()
&#9;&#9;if pants ~= nil then 
&#9;&#9;pants:remove()
&#9;&#9;newpants = script.Parent.Pants:clone()
&#9;&#9;newpants.Parent = part.Parent
&#9;&#9;else
&#9;&#9;newpants = script.Parent.Pants:clone()
&#9;&#9;newpants.Parent = part.Parent
&#9;&#9;end

&#9;elseif pants ~= nil then 
&#9;pants:remove()
&#9;newpants = script.Parent.Pants:clone()
&#9;newpants.Parent = part.Parent

&#9;else

&#9;newpants = script.Parent.Pants:clone()
&#9;newpants.Parent = part.Parent

&#9;end




&#9;end
end



script.Parent.Touched:connect(onTouched)</ProtectedString>
					</Properties>
