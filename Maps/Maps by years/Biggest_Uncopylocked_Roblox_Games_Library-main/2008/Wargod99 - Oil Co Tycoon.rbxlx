&#9;stuff.extraprof.Company.Value = factory.SBL

&#9;stuff.oilref.Value = factory.oilref
&#9;stuff.oilrefb.Value = factory.oilrefb
&#9;stuff.GT.Value = factory.GasTank




------------------------SKY SCRAPER----------------------------------------------------
buttonclone = script.Parent.buttonclone
buttonclone.Value = script.Parent.GroundFloor.Stairs:findFirstChild(&quot;Lay Floor&quot;)
storyclone = script.Parent.Storyclone
story = script.Parent.Story
story2 =script.Parent
story2.Stair.Value = story.Stairs
story2.Supports1.Value = story.Supporters1
story2.Supports2.Value = story.Supporters2
story2.Walls1.Value = story.Wall1
