										<bool name="Archivable">true</bool>
										<bool name="Disabled">false</bool>
										<Content name="LinkedSource"><null></null></Content>
										<string name="Name">Script</string>
										<ProtectedString name="Source">story = script.Parent.Parent.Parent.Parent
owner = story.Parent.OwnerName
newfloor = story.StairsCheck

local ting = 0 

function onTouched(hit)
&#9;if ting == 0 then 
&#9;ting = 1 
&#9;check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;) 
&#9;if check ~= nil then
&#9;&#9;if newfloor.Value == 6 then
&#9;&#9;if owner.Value == hit.Parent.Name then
&#9;&#9;newwalls = story.Parent.Stair.Value:clone() --Change wallnumber on copy
&#9;&#9;newwalls.Parent = story
&#9;&#9;newwalls:MakeJoints()
&#9;&#9;script.Parent.Parent:remove()
&#9;&#9;end
&#9;&#9;else
&#9;&#9;script.Parent.Parent.Name = &quot;Finish the story first&quot;
&#9;&#9;wait(3)
&#9;&#9;script.Parent.Parent.Name = &quot;Build Stairs&quot;
&#9;&#9;end
&#9;end
&#9;ting = 0 
&#9;end
end

script.Parent.Touched:connect(onTouched) 
</ProtectedString>
									</Properties>
								</Item>
								<Item class="Script" referent="RBX9983">
									<Properties>
										<bool name="Archivable">true</bool>
										<bool name="Disabled">false</bool>
										<Content name="LinkedSource"><null></null></Content>
										<string name="Name">Script</string>
										<ProtectedString name="Source">floornumber = script.Parent.Parent.Parent.Parent.StoryNumber.Value
local location = {script.Parent.Position}
local i = 1
local x = location[i].x
local z = location[i].z
script.Parent.CFrame = script.Parent.CFrame * CFrame.new(0,1.8+(12.4 * (floornumber - 1)),0)</ProtectedString>
									</Properties>
								</Item>
							</Item>
						</Item>
						<Item class="Script" referent="RBX9984">
							<Properties>
								<bool name="Archivable">true</bool>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<ProtectedString name="Source">floornumber = script.Parent.Parent.StoryNumber.Value
c = script.Parent:getChildren()
for i = 1, #c do
if c[i].className == &quot;Part&quot; then
local location = {c[i].Position}
local x = location[1].x
local y = location[1].y
local z = location[1].z
c[i].CFrame = c[i].CFrame * CFrame.new(0,(12.4 * (floornumber - 1)),0)
script.Parent:MakeJoints()
end
end
</ProtectedString>
