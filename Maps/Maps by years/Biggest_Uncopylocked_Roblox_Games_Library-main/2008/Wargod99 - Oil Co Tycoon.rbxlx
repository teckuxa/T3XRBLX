									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">Script</string>
									<ProtectedString name="Source">story = script.Parent.Parent.Parent
owner = story.Parent.OwnerName
newfloor = story.StairsCheck

local ting = 0 

function onTouched(hit)
&#9;if ting == 0 then 
&#9;ting = 1 
&#9;check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;) 
&#9;if check ~= nil then
&#9;&#9;if owner.Value == hit.Parent.Name then
&#9;&#9;newwalls = story.Parent.Walls2.Value:clone() --Change wallnumber on copy
&#9;&#9;newwalls.Parent = story
&#9;&#9;newwalls:MakeJoints()
&#9;&#9;script.Parent.Parent:remove()
&#9;&#9;newfloor.Value = newfloor.Value + 1
&#9;&#9;end
&#9;end
&#9;ting = 0 
&#9;end
end

script.Parent.Touched:connect(onTouched) 
</ProtectedString>
