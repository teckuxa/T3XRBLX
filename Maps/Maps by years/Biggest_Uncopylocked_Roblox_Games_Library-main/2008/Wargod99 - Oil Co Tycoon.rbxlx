						<Item class="Script" referent="RBX8204">
							<Properties>
								<bool name="Archivable">true</bool>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<ProtectedString name="Source">factory = script.Parent.Parent.Parent
local ting = 0

function onTouched(hit)
&#9;if ting == 0 then
&#9;ting = 1

&#9;local owner = factory.OwnerName.Value
&#9;check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
&#9;if check ~= nil then
&#9;&#9;local user = game.Players:GetPlayerFromCharacter(hit.Parent) 
&#9;&#9;if owner == user.Name then
&#9;&#9;&#9;local stats = user:findFirstChild(&quot;leaderstats&quot;)
&#9;&#9;&#9;if stats ~= nil then
&#9;&#9;&#9;&#9;local cash = stats:findFirstChild(&quot;Money&quot;)
&#9;&#9;&#9;&#9;if cash.Value &gt; 4999 then
&#9;&#9;&#9;&#9;&#9;cash.Value  = cash.Value -5000
&#9;&#9;&#9;&#9;&#9;machine = factory.Stuff.oilref.Value:clone()
&#9;&#9;&#9;&#9;&#9;machine.Parent = factory
&#9;&#9;&#9;&#9;&#9;machine:MakeJoints()

&#9;&#9;&#9;&#9;&#9;machineb = factory.Stuff.oru.Value:clone()
&#9;&#9;&#9;&#9;&#9;machineb.Parent = factory
&#9;&#9;&#9;&#9;&#9;machineb:MakeJoints()


&#9;&#9;&#9;&#9;&#9;script.Parent.Parent:remove()
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end

&#9;end
&#9;ting = 0
&#9;end
end

script.Parent.Touched:connect(onTouched)
</ProtectedString>
							</Properties>
						</Item>
					</Item>
