								<string name="Name">Script</string>
								<string name="Source">function WAIT()
time=math.random(10,60)
time=time/100
return time
end
time=math.random(30,40)
time=time/10
wait(time)
script.Parent.Transparency=0.2
time=WAIT()
wait(time)
script.Parent.Transparency=0.3
time=WAIT()
wait(time)
script.Parent.Transparency=0.4
time=WAIT()
wait(time)
script.Parent.Transparency=0.5
time=WAIT()
wait(time)
script.Parent.Transparency=0.6
time=WAIT()
wait(time)
script.Parent.Transparency=0.7
time=WAIT()
wait(time)
script.Parent.Transparency=0.8
time=WAIT()
wait(time)
script.Parent.Transparency=0.9
time=WAIT()
wait(time)
script.Parent:remove()
</string>
