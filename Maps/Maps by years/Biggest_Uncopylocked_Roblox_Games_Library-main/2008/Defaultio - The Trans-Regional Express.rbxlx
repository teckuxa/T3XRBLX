					<string name="Source">wait()
clone=game.Lighting.Train:clone()
OnOff=script.Parent.OnOff
Button=script.Parent.Button
function Go()
while OnOff.Value==true do
px1=Button.Position.x
pz1=Button.Position.z
px1=math.floor(px1)
pz1=math.floor(pz1)
wait(10)
if OnOff.Value==false then return end
px2=Button.Position.x
pz2=Button.Position.z
px2=math.floor(px2)
pz2=math.floor(pz2)
vx=px1-px2
vz=pz1-pz2
if vx&gt;=-3 and vx&lt;=2 and vz&gt;=-3 and vz&lt;=2 then
script.Parent:remove()
clone.Parent=game.Workspace
clone:MakeJoints()
end
end
end
OnOff.Changed:connect(Go)
while true do
wait(2)
if Button.Position.y&lt;24 or Button.Position.y&gt;28 then
script.Parent:remove()
clone.Parent=game.Workspace
clone:MakeJoints()
end
end </string>
