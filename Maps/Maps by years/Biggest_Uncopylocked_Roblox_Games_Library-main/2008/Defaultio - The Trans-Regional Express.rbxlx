function on()
	isOn.Value = true
	script.Parent.BrickColor = BrickColor.new(106)
	for m = 1, #wheels do
		wheels[m].LeftParamA=0.2
		wheels[m].LeftParamB=-0.2
		wheels[m].RightParamA=-0.2
		wheels[m].RightParamB=0.2
	end
wait(2)
if isOn.Value==false then return end
	for m = 1, #wheels do
		wheels[m].LeftParamA=0.4
		wheels[m].LeftParamB=-0.4
		wheels[m].RightParamA=-0.4
		wheels[m].RightParamB=0.4
