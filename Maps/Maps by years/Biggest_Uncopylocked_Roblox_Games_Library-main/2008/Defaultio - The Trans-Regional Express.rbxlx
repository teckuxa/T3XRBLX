					<Item class="Script" referent="RBX5219">
						<Properties>
							<bool name="Disabled">true</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<string name="Source">OnOff=script.Parent.Parent.Parent.OnOff
Smoke=script.Parent.Parent.Smoke:clone()
Smoke.Transparency=0.1
Smoke.BottomSurface=1
Smoke.BodyVelocity.maxForce=Vector3.new(0, 1e+005, 0)
Smoke.BodyVelocity.velocity=Vector3.new(0, 20, 0)
Smoke.Script:remove()
function GoSmoke()
while OnOff.Value==true do
time=math.random(50,90)
time=time/100
wait(time)
NewSmoke=Smoke:clone()
NewSmoke.Mesh.Scale=Vector3.new(math.random(5,9),math.random(8,12),math.random(8,12))
NewSmoke.CFrame = CFrame.fromEulerAnglesXYZ(math.random(0,6.28), math.random(0,6.28), math.random(0,6.28))
ScriptClone=script.Script:clone()
ScriptClone.Disabled=false
ScriptClone.Parent=NewSmoke
NewSmoke.Position=Vector3.new(script.Parent.Position.x,script.Parent.Position.y+1,script.Parent.Position.z)
NewSmoke.Parent=game.Workspace.Smoke
end
end
OnOff.Changed:connect(GoSmoke)</string>
							<bool name="archivable">true</bool>
						</Properties>
						<Item class="Script" referent="RBX5220">
