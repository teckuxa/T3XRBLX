		wheels[m].RightParamB=0.3
	end
	wait(0.5)	
	if isOn.Value==true then return end
	for m = 1, #wheels do
		wheels[m].LeftParamA=0.2
		wheels[m].LeftParamB=-0.2
		wheels[m].RightParamA=-0.2
		wheels[m].RightParamB=0.2
	end
	wait(0.5)	
	if isOn.Value==true then return end
	for m = 1, #wheels do
		wheels[m].LeftParamA=0.1
		wheels[m].LeftParamB=-0.1
		wheels[m].RightParamA=-0.1
		wheels[m].RightParamB=0.1
	end
	wait(0.5)	
	if isOn.Value==true then return end
	for m = 1, #wheels do
		wheels[m].LeftParamA=0
		wheels[m].LeftParamB=-0
		wheels[m].RightParamA=-0
		wheels[m].RightParamB=0
	end

	script.Parent.BrickColor = BrickColor.new(21)
qwerty=false
end

function onClicked()
if qwerty==false then
qwerty=true
	if isOn.Value == true then off() else on() end
end
end

script.Parent.ClickDetector.MouseClick:connect(onClicked)</string>
						<bool name="archivable">true</bool>
