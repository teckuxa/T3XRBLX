					<Item class="Script" referent="RBX4735">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<string name="Source">function OnTouch(part) 
if (part.Parent:FindFirstChild(&quot;Humanoid&quot;) ~= nil) then 
local p = game.Players:GetPlayerFromCharacter(part.Parent) 
if (p ~= nil) then 
if p.Oreo1.Value==false then
p.Oreo1.Value=true
H=Instance.new(&quot;Hint&quot;)
H.Text=&quot;You found Oreo 1!&quot;
H.Parent=p
wait(2)
if p.Oreo1.Value==true and p.Oreo2.Value==true and p.Oreo3.Value==true and p.Oreo4.Value==true then
local b = game:GetService(&quot;BadgeService&quot;) 
b:AwardBadge(p.userId, script.Parent.BadgeID.Value) 
H.Text=&quot;You&apos;ve found all the Oreos!&quot;
wait(2)
end 
H:remove()
end 
end 
end
end 

script.Parent.Touched:connect(OnTouch) 
</string>
