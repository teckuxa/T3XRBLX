				<string name="Source">--this is a combination of lag removers varying from cleaning snaps, reducing debris, checking lag, and load time reducers--</string>
				<bool name="archivable">true</bool>
			</Properties>
			<Item class="Script" referent="RBX4765">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">LoadTime</string>
					<string name="Source">--	This script will lower the time required to load a map in online mode. Just leave it in the map. -Gamer3D
function breakAnchored(model)
	if (model.className == &quot;Part&quot;) or (model.className == &quot;Seat&quot;) or (model.className == &quot;SpawnLocation&quot;) then
		if model.Anchored then
			model:BreakJoints()
		end
	else
		local child = model:GetChildren()
		for n = 1, #child do
			breakAnchored(child[n])
		end
	end
end

function makeUnanchored(model)
	if (model.className == &quot;Part&quot;) or (model.className == &quot;Seat&quot;) or (model.className == &quot;SpawnLocation&quot;) then
		if not model.Anchored then
			model:MakeJoints()
		end
	else
		local child = model:GetChildren()
		for n = 1, #child do
			makeUnanchored(child[n])
		end
	end
end

wait()

breakAnchored(workspace)
makeUnanchored(workspace)</string>
					<bool name="archivable">true</bool>
