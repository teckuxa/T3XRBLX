						<string name="Source">local isOn = script.Parent.Parent.OnOff
wheels={ }
qwerty=false
c = script.Parent.Parent:getChildren()
for i = 1, #c do
b = c[i]:getChildren()
for n = 1, #b do
if b[n].Name==&quot;Wheels&quot; then
v=b[n]:GetChildren()
for m = 1, #v do
if v[m].Name==&quot;Wheel1&quot; or v[m].Name==&quot;Wheel2&quot; then
table.insert(wheels,v[m]) 
end
end
end
end
end


function on()
	isOn.Value = true
	script.Parent.BrickColor = BrickColor.new(106)
	for m = 1, #wheels do
		wheels[m].LeftParamA=0.2
		wheels[m].LeftParamB=-0.2
		wheels[m].RightParamA=-0.2
		wheels[m].RightParamB=0.2
	end
wait(2)
if isOn.Value==false then return end
	for m = 1, #wheels do
		wheels[m].LeftParamA=0.4
		wheels[m].LeftParamB=-0.4
		wheels[m].RightParamA=-0.4
		wheels[m].RightParamB=0.4
	end
wait(2)
if isOn.Value==false then return end
	for m = 1, #wheels do
		wheels[m].LeftParamA=0.6
		wheels[m].LeftParamB=-0.6
		wheels[m].RightParamA=-0.6
		wheels[m].RightParamB=0.6
	end
wait(2)
if isOn.Value==false then return end
	for m = 1, #wheels do
		wheels[m].LeftParamA=0.8
		wheels[m].LeftParamB=-0.8
		wheels[m].RightParamA=-0.8
		wheels[m].RightParamB=0.8
	end
wait(2)
if isOn.Value==false then return end
	for m = 1, #wheels do
		wheels[m].LeftParamA=1
		wheels[m].LeftParamB=-1
		wheels[m].RightParamA=-1
		wheels[m].RightParamB=1
	end
wait(2)
if isOn.Value==false then return end
	for m = 1, #wheels do
		wheels[m].LeftParamA=1.2
		wheels[m].LeftParamB=-1.2
		wheels[m].RightParamA=-1.2
		wheels[m].RightParamB=1.2
	end
wait(2)
if isOn.Value==false then return end
	for m = 1, #wheels do
		wheels[m].LeftParamA=1.4
		wheels[m].LeftParamB=-1.4
		wheels[m].RightParamA=-1.4
		wheels[m].RightParamB=1.4
	end
wait(2)
if isOn.Value==false then return end
	for m = 1, #wheels do
		wheels[m].LeftParamA=1.6
		wheels[m].LeftParamB=-1.6
		wheels[m].RightParamA=-1.6
		wheels[m].RightParamB=1.6
	end
wait(2)
if isOn.Value==false then return end
	for m = 1, #wheels do
		wheels[m].LeftParamA=1.8
		wheels[m].LeftParamB=-1.8
		wheels[m].RightParamA=-1.8
		wheels[m].RightParamB=1.8
	end
wait(2)
if isOn.Value==false then return end
	for m = 1, #wheels do
		wheels[m].LeftParamA=2
		wheels[m].LeftParamB=-2
		wheels[m].RightParamA=-2
		wheels[m].RightParamB=2
	end
	script.Parent.BrickColor = BrickColor.new(28)
qwerty=false
end

