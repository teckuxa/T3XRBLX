		wheels[m].LeftParamB=-1.8
		wheels[m].RightParamA=-1.8
		wheels[m].RightParamB=1.8
	end
wait(2)
if isOn.Value==false then return end
	for m = 1, #wheels do
		wheels[m].LeftParamA=2
		wheels[m].LeftParamB=-2
		wheels[m].RightParamA=-2
		wheels[m].RightParamB=2
	end
	script.Parent.BrickColor = BrickColor.new(28)
qwerty=false
end

