					</Properties>
				</Item>
				<Item class="Script" referent="RBX1785">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Shot</string>
						<string name="Source">local shot = script.Parent
a = 60

while true do
	wait(0.1)
	a = a - 1
	shot.Velocity = 150*shot.CFrame.lookVector 
	if a &lt; 1 then shot:remove() end
end
