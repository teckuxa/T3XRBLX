				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Msg</string>
				<string name="Source">function onPlayerRespawned(newPlayer)
	wait(1)
	local m = Instance.new(&quot;Message&quot;)
	m.Parent = newPlayer
	m.Text = &quot;say &apos;class&apos; to change class&quot;
	wait(4)
	m:remove()
	c:Disconnect()
end

function onPlayerEntered(newPlayer)
	c = newPlayer.Changed:connect(function (property)
		if (property == &quot;Character&quot;) then
			onPlayerRespawned(newPlayer)
		end
	end)
end

