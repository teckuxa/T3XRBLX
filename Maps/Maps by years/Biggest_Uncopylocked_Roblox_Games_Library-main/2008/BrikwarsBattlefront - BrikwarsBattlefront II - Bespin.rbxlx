						<string name="Name">Script</string>
						<string name="Source">local s = game.Lighting.Second:GetChildren()
local d = false

function onTouch(part)
	print(&quot;touched&quot;)
	if d == false then
		d = true
		if part.Parent ~= nil then
			local h = part.Parent:FindFirstChild(&quot;Humanoid&quot;)
			if h ~= nil then
				if h.Health &gt; 0 then
					local ch = part.Parent
					local p = game.Players:FindFirstChild(ch.Name)
					if p.Weaps ~= nil then
						print(&quot;weaps changing&quot;)
						local w = p.Weaps:GetChildren()
						for i = 1, #w do 
							w[i]:remove() 
						end
						wait()
						for i = 1, #s do
