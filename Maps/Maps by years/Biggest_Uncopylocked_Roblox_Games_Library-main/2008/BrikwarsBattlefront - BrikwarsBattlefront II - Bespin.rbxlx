			<Item class="Script" referent="RBX1256">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Flash</string>
					<string name="Source">while true do
	wait(0.2)
	local p = script.Parent:GetChildren()
	for i = 1, #p do
		if p[i].Name == &quot;Color&quot; then
			p[i].Transparency = 1
		end
	end
	wait(0.2)
	for i = 1, #p do
		if p[i].Name == &quot;Color&quot; then
			p[i].Transparency = 0.8
		end
	end
	wait(0.2)
	for i = 1, #p do
		if p[i].Name == &quot;Color&quot; then
			p[i].Transparency = 0.6
		end
	end
	wait(0.2)
	for i = 1, #p do
		if p[i].Name == &quot;Color&quot; then
			p[i].Transparency = 0.4
		end
	end
	wait(0.2)
	for i = 1, #p do
		if p[i].Name == &quot;Color&quot; then
			p[i].Transparency = 0.2
		end
	end
	wait(0.2)
	for i = 1, #p do
		if p[i].Name == &quot;Color&quot; then
			p[i].Transparency = 0
		end
	end
	wait(0.2)
	for i = 1, #p do
		if p[i].Name == &quot;Color&quot; then
			p[i].Transparency = 0.2
		end
	end
	wait(0.2)
	for i = 1, #p do
		if p[i].Name == &quot;Color&quot; then
			p[i].Transparency = 0.4
		end
	end
	wait(0.2)
	for i = 1, #p do
		if p[i].Name == &quot;Color&quot; then
			p[i].Transparency = 0.6
		end
	end
	wait(0.2)
	for i = 1, #p do
		if p[i].Name == &quot;Color&quot; then
			p[i].Transparency = 0.8
		end
	end
end
</string>
