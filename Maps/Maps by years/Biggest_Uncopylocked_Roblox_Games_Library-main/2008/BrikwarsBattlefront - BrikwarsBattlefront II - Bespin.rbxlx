						<string name="Source">local player = script.Parent.Parent.Parent.Name

function onSelected(mouse)
	print(&quot;tool selected&quot;)
	mouse.Button1Down:connect(function() heal(mouse) end)
end

function heal(mouse)
	local h = mouse.Target.Parent:FindFirstChild(&quot;Humanoid&quot;)
	if h ~= nil then
		if h.Health &lt; 100 then
			script.Parent.Amo.Value = script.Parent.Amo.Value - 1
			h.Health = h.MaxHealth
		end
	end
end

script.Parent.Selected:connect(onSelected)
