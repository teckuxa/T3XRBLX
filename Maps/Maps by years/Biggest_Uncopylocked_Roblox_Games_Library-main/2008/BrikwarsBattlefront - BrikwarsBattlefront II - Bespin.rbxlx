				<Item class="Script" referent="RBX1736">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<string name="Source">local player = script.Parent.Parent.Parent.Name

function onSelected(mouse)
	local b = findBomb()
	if b ~= nil then
		b.On.Value = true
	end
end

function findBomb()
	local c = game.Workspace:GetChildren()
	for i = 1, #c do
		if c[i].Name == &quot;Bomb&quot; then
			print(&quot;bomb &apos;&quot;..c[i].Name..&quot;&apos; found in &quot;..c[i].Parent.Name)
			if c[i].Owner.Value == player then
				print(&quot;bomb is yours&quot;)
				return c[i]
			end
		end
	end
end

script.Parent.Selected:connect(onSelected)
</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
