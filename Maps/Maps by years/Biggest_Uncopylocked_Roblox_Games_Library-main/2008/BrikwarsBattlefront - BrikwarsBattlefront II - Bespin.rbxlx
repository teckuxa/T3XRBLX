				<Item class="Script" referent="RBX1759">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Damage</string>
						<string name="Source">local damage = 20
local d = false
function onTouch(part)

	if d == false then
		
		d = true

		local h = part.Parent:FindFirstChild(&quot;Humanoid&quot;)

		if h ~= nil then

			h.Health = h.Health - damage

			stopShot()

			tagHumanoid(h)

			h:TakeDamage(damage)

			wait(2)

			untagHumanoid(h)

			script.Parent:remove()

			else

			script.Parent:remove()

		end
	
		d = false

	end

end

function stopShot()
	script.Parent.Position = Vector3.new(0, math.random(10000,100000), 0)
	script.Parent.Anchored = true
end

function tagHumanoid(humanoid)
	-- todo: make tag expire
	local tag = script.Parent:findFirstChild(&quot;creator&quot;)
	if tag ~= nil then
		local new_tag = tag:clone()
		new_tag.Parent = humanoid
	end
end


function untagHumanoid(humanoid)
	if humanoid ~= nil then
		local tag = humanoid:findFirstChild(&quot;creator&quot;)
		if tag ~= nil then
			tag.Parent = nil
		end
	end
end

script.Parent.Touched:connect(onTouch)</string>
