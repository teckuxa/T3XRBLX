				<Item class="Script" referent="RBX1412">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<string name="Source">local s = game.Lighting.Medic:GetChildren()
local d = false

function onTouch(part)
	print(&quot;touched&quot;)
	if d == false then
		d = true
		if part.Parent ~= nil then
			local h = part.Parent:FindFirstChild(&quot;Humanoid&quot;)
			if h ~= nil then
				if h.Health &gt; 0 then
					local ch = part.Parent
					local p = game.Players:FindFirstChild(ch.Name)
					if p.Weaps ~= nil then
						print(&quot;weaps changing&quot;)
						local w = p.Weaps:GetChildren()
						for i = 1, #w do 
							w[i]:remove() 
						end
						wait()
						for i = 1, #s do
							s[i]:clone().Parent = p.Weaps 
						end
						local c = p:FindFirstChild(&quot;Class&quot;)
						c.Value = &quot;Medic&quot;
						ch.Humanoid.Health = 0
					end
				end
			end
		end
		d = false
	end
end

