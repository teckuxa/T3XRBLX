						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Explode</string>
						<string name="Source">wait(0.5)
local active = script.Parent.On
while true do
	wait(0.5)
	if active.Value == true then --explode
		local e = Instance.new(&quot;Explosion&quot;)
		e.BlastRadius = 5
		e.BlastPressure = 1000000
		e.Position = script.Parent.Position
		e.Parent = game.Workspace
		script.Parent:remove()
	end
end
