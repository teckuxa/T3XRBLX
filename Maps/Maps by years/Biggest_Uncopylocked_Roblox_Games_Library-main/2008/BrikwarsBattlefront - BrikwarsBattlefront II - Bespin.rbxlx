				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">FixSpawn</string>
					<string name="Source">while true do
	wait(120)
	local s = script.Parent:FindFirstChild(&quot;CaptureScript&quot;)
	if s ~= nil then
		local c = s:clone()
		c.Parent = s.Parent
		s:remove()
	end
end
