			ch:FindFirstChild(&quot;Left Arm&quot;).BrickColor = BrickColor.new(135)
			ch:FindFirstChild(&quot;Torso&quot;).BrickColor = BrickColor.new(26)
			ch:FindFirstChild(&quot;Right Leg&quot;).BrickColor = BrickColor.new(194)
			ch:FindFirstChild(&quot;Right Arm&quot;).BrickColor = BrickColor.new(135)
