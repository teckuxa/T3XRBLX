			<Item class="Script" referent="RBX1277">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Flash</string>
					<string name="Source">while true do
	wait(0.2)
	local p = script.Parent:GetChildren()
	for i = 1, #p do
		if p[i].Name == &quot;Color&quot; then
			p[i].Transparency = 1
		end
	end
	wait(0.2)
	for i = 1, #p do
		if p[i].Name == &quot;Color&quot; then
			p[i].Transparency = 0.8
		end
	end
	wait(0.2)
	for i = 1, #p do
		if p[i].Name == &quot;Color&quot; then
			p[i].Transparency = 0.6
		end
	end
	wait(0.2)
	for i = 1, #p do
		if p[i].Name == &quot;Color&quot; then
			p[i].Transparency = 0.4
		end
	end
	wait(0.2)
	for i = 1, #p do
		if p[i].Name == &quot;Color&quot; then
			p[i].Transparency = 0.2
		end
	end
	wait(0.2)
	for i = 1, #p do
		if p[i].Name == &quot;Color&quot; then
			p[i].Transparency = 0
		end
	end
	wait(0.2)
	for i = 1, #p do
		if p[i].Name == &quot;Color&quot; then
			p[i].Transparency = 0.2
		end
	end
	wait(0.2)
	for i = 1, #p do
		if p[i].Name == &quot;Color&quot; then
			p[i].Transparency = 0.4
		end
	end
	wait(0.2)
	for i = 1, #p do
		if p[i].Name == &quot;Color&quot; then
			p[i].Transparency = 0.6
		end
	end
	wait(0.2)
	for i = 1, #p do
		if p[i].Name == &quot;Color&quot; then
			p[i].Transparency = 0.8
		end
	end
end
</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX1278">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">ColorChange</string>
					<string name="Source">local color = script.Parent.Value
local p = script.Parent:GetChildren()

function change(a)
	for i = 1, #p do
		if p[i].Name == &quot;Color&quot; then
			p[i].BrickColor = color.Value
		end
	end
	script.Parent.Spawn.TeamColor = color.Value
	script.Parent.Spawn.BrickColor = color.Value
end

change(p)

color.Changed:connect(change)
</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="BrickColorValue" referent="RBX1279">
				<Properties>
					<string name="Name">Value</string>
					<int name="Value">1</int>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX1280">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">CaptureScript</string>
					<string name="Source">local button = script.Parent.Button
local spawn = script.Parent.Spawn
local value = script.Parent.Value
local f = false
local d = false

function onTouch(part)
	if f == false then
		f = true
		local a = Touch(part)
		print(&quot;Finnished capture-function&quot;)
		if a == nil then d = false end
		f = false
		local p = getPlayer(part)
		if p ~= nil then
			local m = p:FindFirstChild(&quot;Message&quot;)
			if m ~= nil then
				m:remove()
			end
		end
	end
end

function Touch(part)
	print(&quot;Touched&quot;)
	if d == false then
		d = true
		print(&quot;Touched2&quot;)
		local m = Instance.new(&quot;Message&quot;)
		local p = getPlayer(part)
		if p ~= nil then
			print(&quot;player touched&quot;)
			local h = p.Character.Humanoid.Health
			local t = p.Character.Torso
			local n = nearestEnemy()
			if n &lt; 10 then return nil end
			m.Parent = p
			m.Text = &quot;Capturing : 10&quot;
			wait(1)
			n = nearestEnemy()
			if n &lt; 10 then return nil end
			if h &lt; 1 then return nil end
			if findDistance(t) &gt; 10 then return nil end
			m.Text = &quot;Capturing : 9&quot;
			wait(1)
			n = nearestEnemy()
			if n &lt; 10 then return nil end
			if h &lt; 1 then return nil end
			if findDistance(t) &gt; 10 then return nil end
			m.Text = &quot;Capturing : 8&quot;
			wait(1)
			n = nearestEnemy()
			if n &lt; 10 then return nil end
			if h &lt; 1 then return nil end
			if findDistance(t) &gt; 10 then return nil end
			m.Text = &quot;Capturing : 7&quot;
			wait(1)
			n = nearestEnemy()
			if n &lt; 10 then return nil end
			if h &lt; 1 then return nil end
			if findDistance(t) &gt; 10 then return nil end
			m.Text = &quot;Capturing : 6&quot;
			wait(1)
			n = nearestEnemy()
			if n &lt; 10 then return nil end
			if h &lt; 1 then return nil end
			if findDistance(t) &gt; 10 then return nil end
			m.Text = &quot;Capturing : 5&quot;
			value.Value = BrickColor.new(1)
			wait(1)
			n = nearestEnemy()
			if n &lt; 10 then return nil end
			if h &lt; 1 then return nil end
			if findDistance(t) &gt; 10 then return nil end
			m.Text = &quot;Capturing : 4&quot;
			wait(1)
			n = nearestEnemy()
			if n &lt; 10 then return nil end
			if h &lt; 1 then return nil end
			if findDistance(t) &gt; 10 then return nil end
			m.Text = &quot;Capturing : 3&quot;
			wait(1)
			n = nearestEnemy()
			if n &lt; 10 then return nil end
			if h &lt; 1 then return nil end
			if findDistance(t) &gt; 10 then return nil end
			m.Text = &quot;Capturing : 2&quot;
			wait(1)
			n = nearestEnemy()
			if n &lt; 10 then return nil end
			if h &lt; 1 then return nil end
			if findDistance(t) &gt; 10 then return nil end
			m.Text = &quot;Capturing : 1&quot;
			wait(1)
			n = nearestEnemy()
			if n &lt; 10 then return nil end
			if h &lt; 1 then return nil end
			if findDistance(t) &gt; 10 then return nil end
			spawn.BrickColor = p.TeamColor
			spawn.TeamColor = spawn.BrickColor
			value.Value = spawn.BrickColor
			local n = Instance.new(&quot;Message&quot;)
			n.Parent = game.Workspace	
			local c = getColor(spawn.BrickColor)
			--if c ~= nil then
				n.Text = script.Parent.Name..&quot; has been captured&quot; --by &quot;..spawn.BrickColor..&quot; !&quot;
				--else
				--n.Text = script.Parent.Name..&quot; has been captured!&quot;
			--end
			m:remove()
			wait(2)
			n:remove()
		end
		d = false
	end
end

function getColor(num)
	if num == 21 then
		return &quot;Blue&quot;
		elseif num == 23 then
		return &quot;Red&quot;
	end
end

function getPlayer(part)
	local players = game.Players:GetChildren()
	if part.Parent:FindFirstChild(&quot;Humanoid&quot;) ~= nil then
		local name = part.Parent.Name
		for i = 1, #players do
			if players[i].Name == name then
				return players[i]
			end
		end
	end
end

function nearestEnemy()
	local p = game.Players:GetChildren()
	local temp = 10000
	for i = 1, #p do
		if p[i].TeamColor == spawn.TeamColor then
			local t = p[i].Character.Torso
			if t ~= nil then
				local distance = (spawn.Position - t.Position).magnitude
				if distance &lt; temp then temp = distance end
			end
		end
	end
	return temp
end

function checkTeam(p)
	if p.TeamColor ~= nil then
		if p.TeamColor ~= spawn.TeamColor then
			return false --capture = true
			else
			return true --captrue = false
		end
	end
end

function findDistance(object)
	local pos = object.Position
	local dist = (spawn.Position - pos).magnitude
	return dist
end

print(&quot;capture script loaded&quot;)

button.Touched:connect(onTouch)
