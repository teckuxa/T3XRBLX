				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">chat</string>
				<string name="Source">function onPlayerRespawned(newPlayer)
end

function onChatted(msg, recipient, speaker)
	local m = string.lower(msg)
	if m == &quot;class&quot; then
		local t = speaker.Character:FindFirstChild(&quot;Torso&quot;)
		if t ~= nil then
			local w = speaker.Backpack:GetChildren()
			for i = 1, #w do
				w[i]:remove()
			end
			local c = speaker.Character:GetChildren()
			for i = 1, #c do
				if c[i].className == &quot;Tool&quot; then
					c[i]:remove()
				end
			end
			if speaker.TeamColor == game.Workspace.Blue.Value then
				t.CFrame = CFrame.new(game.Workspace.BlueS.Position)
				else
				t.CFrame = CFrame.new(game.Workspace.RedS.Position)
			end
		end
	end
end

function onPlayerEntered(newPlayer)
	newPlayer.Chatted:connect(function(msg, recipient) onChatted(msg, recipient, newPlayer) end) 
	newPlayer.Changed:connect(function (property)
		if (property == &quot;Character&quot;) then
			onPlayerRespawned(newPlayer)
		end
	end)
end

game.Players.ChildAdded:connect(onPlayerEntered)</string>
