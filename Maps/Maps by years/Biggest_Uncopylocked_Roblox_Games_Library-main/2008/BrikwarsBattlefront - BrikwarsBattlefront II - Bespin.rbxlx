		<Item class="Script" referent="RBX1526">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">GameLoop</string>
				<string name="Source">local save = {}

local g = game.Workspace:GetChildren()
for i = 1, #g do
	if g[i].className ~= &quot;Script&quot; then
		local Clone = g[i]:clone()
		table.insert (save, Clone)
	end
end

function numberSpawns(team)
	local g = game.Workspace:GetChildren()
	local a = {}
	for  i = 1, #g do
		if g[i]:FindFirstChild(&quot;Flash&quot;) ~= nil then
			if g[i].Color.BrickColor == team then
				table.insert(a, g[i])
			end
		end
	end
	return #a
end

function Reset(type, team)
	local m = Instance.new(&quot;Message&quot;)
	m.Name = &quot;Message&quot;
	if type == false then
		m.Text = &quot;the game is over, &quot;..team..&quot; won!&quot;
		else
		m.Text = team..&quot; captured all of the spawnpoints!&quot;
	end
	m.Parent = game.Workspace
	wait(3)
	local s = game.Workspace:GetChildren()
	collectgarbage(collect)
	for i = 1, #s do
		if s[i].className ~= &quot;Script&quot; then 
			local a = s[i]:FindFirstChild(&quot;Animate&quot;)
			if a == nil then
				s[i]:remove()
				elseif s[i]:FindFirstChild(&quot;Humanoid&quot;) ~= nil then
				s[i].Humanoid.Health = 0
			end
		end
	end
	for i = 1, #save do
		local c = save[i]:clone()
		c.Parent = game.Workspace
	end	
end

print(&quot;Game loop running&quot;)

while true do
	local gametime = 300
	while true do
		wait(1)
		gametime = gametime - 1
		if gametime &lt; 1 then 
			if numberSpawns(game.Workspace.Red.Value) &gt; numberSpawns(game.Workspace.Blue.Value) then
				Reset(false, &quot;Red&quot;)
				elseif numberSpawns(game.Workspace.Red.Value) &lt; numberSpawns(game.Workspace.Blue.Value) then
				Reset(false, &quot;Blue&quot;)
				else
				Reset(false, &quot;No one&quot;)
			end
			break 
		end
		if numberSpawns(game.Workspace.Red.Value) &gt; 5 then 
			Reset(true, &quot;Red&quot;)
			break
		end
		if numberSpawns(game.Workspace.Blue.Value) &gt; 5 then
			Reset(true, &quot;Blue&quot;)
			break
		end
		if numberSpawns(game.Workspace.Red.Value) &lt; 1 then 
			Reset(true, &quot;Blue&quot;)
			break
		end
		if numberSpawns(game.Workspace.Blue.Value) &lt; 1 then
			Reset(true, &quot;Red&quot;)
			break
		end
	end
end
	
</string>
