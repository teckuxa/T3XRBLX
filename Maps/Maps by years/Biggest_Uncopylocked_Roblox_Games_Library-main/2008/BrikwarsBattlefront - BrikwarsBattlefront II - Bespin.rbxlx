				<string name="Name">SpawnScript</string>
				<string name="Source">function onPlayerRespawned(newPlayer)
	local b = newPlayer.Weaps:GetChildren()
	for i = 1, #b do
		b[i]:clone().Parent = newPlayer.Backpack
	end
	if newPlayer.Class.Value == &quot;Troop&quot; then
		if newPlayer.TeamColor == game.Workspace.Red.Value then
			wait(2)
			local c = game.Lighting.Sith:GetChildren()
			local p = newPlayer.Character:GetChildren()
			local ch = newPlayer.Character
			ch:FindFirstChild(&quot;Left Leg&quot;).BrickColor = BrickColor.new(1)
			ch:FindFirstChild(&quot;Left Arm&quot;).BrickColor = BrickColor.new(1)
			ch:FindFirstChild(&quot;Torso&quot;).BrickColor = BrickColor.new(1)
			ch:FindFirstChild(&quot;Head&quot;).BrickColor = BrickColor.new(26)
			ch:FindFirstChild(&quot;Right Leg&quot;).BrickColor = BrickColor.new(1)
			ch:FindFirstChild(&quot;Right Arm&quot;).BrickColor = BrickColor.new(1)
			ch.Torso.roblox:remove()
			for i = 1, #c do   --clones anything in a model called &quot;hats&quot; in lighting
				local a = Instance.new(&quot;Hat&quot;)
				if c[i].Name == &quot;Visor&quot; then
					a.AttachmentPos = Vector3.new(0, 0.1, 0.2)
				end
				if c[i].Name == &quot;Mask&quot; then
					a.AttachmentPos = Vector3.new(0, -0.2, -0.8)
					a.AttachmentUp = Vector3.new(0, 0, -1)
					a.AttachmentForward = Vector3.new(0, 1, 0)
					a.AttachmentRight = Vector3.new(-1, 0, 0)
				end
				if c[i].Name == &quot;Mask2&quot; then
					a.AttachmentPos = Vector3.new(0, -0.25, -0.8)
					a.AttachmentUp = Vector3.new(0, 0, -1)
					a.AttachmentForward = Vector3.new(0, 1, 0)
					a.AttachmentRight = Vector3.new(1, 0, 0)
				end
				if c[i].Name == &quot;Eyes&quot; then
					a.AttachmentPos = Vector3.new(0, 0.3, 0.2)
				end
				if c[i].Name == &quot;Head&quot; then
					a.AttachmentPos = Vector3.new(0, 0.5, 0)
				end
				local clone = c[i]:clone()
				clone.Parent = a
				clone.Name = &quot;Handle&quot;
				a.Parent = newPlayer.Character
			end 
			wait(2)
			for i = 1, #p do  --removes thier hat if they had one on
				if p[i]:FindFirstChild(&quot;Handle&quot;) ~= nil and p[i].className ~= &quot;Tool&quot; then
					p[i]:remove()
					print(&quot;removed&quot;)
				end
			end
		end
