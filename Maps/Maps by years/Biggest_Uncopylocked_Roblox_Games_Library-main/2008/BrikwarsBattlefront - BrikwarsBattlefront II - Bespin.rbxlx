				<Item class="Script" referent="RBX1839">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Damage</string>
						<string name="Source">local damage = 100
local d = false
function onTouch(part)
	if d == false then
		d = true
		local h = part.Parent:FindFirstChild(&quot;Humanoid&quot;)
		if h ~= nil then
			if part.Name == &quot;Head&quot; then
				h.Health = 0
				elseif part.Name == &quot;Left Arm&quot; or part.Name == &quot;Right Arm&quot; then
				h.Health = h.Health - 75
				elseif part.Name == &quot;Torso&quot; then
				h.Health = h.Health - 90
				elseif part.Name == &quot;Left Leg&quot; or part.Name == &quot;Right Leg&quot; then
				h.Health = h.Health - 60
				else
				h.Health = h.Health - 50
			end
			stopShot()
			tagHumanoid(h)
			wait(2)
			untagHumanoid(h)
			script.Parent:remove()
			else
			script.Parent:remove()
		end
		local hh = part.Parent.Parent:FindFirstChild(&quot;Humanoid&quot;)
		if hh ~= nil then
			if part.Name == &quot;Head&quot; then
				hh.Health = 0
				elseif part.Name == &quot;Left Arm&quot; or part.Name == &quot;Right Arm&quot; then
				hh.Health = hh.Health - 75
				elseif part.Name == &quot;Torso&quot; then
				hh.Health = hh.Health - 90
				elseif part.Name == &quot;Left Leg&quot; or part.Name == &quot;Right Leg&quot; then
				hh.Health = hh.Health - 60
				else
				hh.Health = hh.Health - 50
			end
			stopShot()
			tagHumanoid(hh)
			wait(2)
			untagHumanoid(hh)
			script.Parent:remove()
			else
			script.Parent:remove()
		end
		d = false
	end
end
function stopShot()
	script.Parent.Position = Vector3.new(0, math.random(10000,100000), 0)
	script.Parent.Anchored = true
end
function tagHumanoid(humanoid)
	-- todo: make tag expire
	local tag = script.Parent:findFirstChild(&quot;creator&quot;)
	if tag ~= nil then
		local new_tag = tag:clone()
		new_tag.Parent = humanoid
	end
end
function untagHumanoid(humanoid)
	if humanoid ~= nil then
		local tag = humanoid:findFirstChild(&quot;creator&quot;)
		if tag ~= nil then
			tag.Parent = nil
		end
	end
end
script.Parent.Touched:connect(onTouch)</string>
