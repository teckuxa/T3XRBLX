						<R20>0</R20>
						<R21>-1</R21>
						<R22>-0</R22>
					</CoordinateFrame>
					<string name="Name">Lazer-Pistol</string>
					<Content name="TextureId"><hash>53a8056a72cf8eb1cb7473679fea9ee5</hash></Content>
