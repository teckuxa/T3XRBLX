				<string name="Source">function fix(a)
	if a.Name == &quot;Hat&quot; then
		a:remove()
	end
	if a.Name == &quot;Bomb&quot; then
		wait(30)
		if a ~= nil then
			a:remove()
		end
	end
	if a.className == &quot;Message&quot; then
		wait(2)
		a:remove()
	end
end

game.Workspace.ChildAdded:connect(fix)
