						<string name="Name">Shot</string>
						<string name="Source">local shot = script.Parent
a = 60

while true do
	wait(0.1)
	a = a - 1
	shot.Velocity = 150*shot.CFrame.lookVector 
	if a &lt; 1 then shot:remove() end
end
