				</Properties>
			</Item>
			<Item class="Script" referent="RBX1320">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">ColorChange</string>
					<string name="Source">local color = script.Parent.Value
local p = script.Parent:GetChildren()

function change(a)
	for i = 1, #p do
		if p[i].Name == &quot;Color&quot; then
			p[i].BrickColor = color.Value
		end
	end
	script.Parent.Spawn.TeamColor = color.Value
	script.Parent.Spawn.BrickColor = color.Value
end

change(p)

color.Changed:connect(change)
</string>
