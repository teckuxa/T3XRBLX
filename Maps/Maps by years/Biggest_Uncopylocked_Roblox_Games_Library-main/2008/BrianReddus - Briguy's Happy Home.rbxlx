					<string name="Name">Script</string>
					<ProtectedString name="Source">--0, 234, -35

function onClick()
pad = game.Workspace.FloorMid
BP = pad.BodyPosition

BP.position = Vector3.new(0, 235.3, -35)
wait(2)
BP.position = Vector3.new(0, 235.3, -49)
wait(15)
BP.position = Vector3.new(0, 235.3, -35)
wait(7)
BP.position = Vector3.new(0, 234, -35)
end


script.Parent.ClickDetector.MouseClick:connect(onClick)</ProtectedString>
				</Properties>
			</Item>
