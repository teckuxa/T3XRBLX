							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">local isOn = true

function off()
	isOn = false
	script.Parent.Reflectance = 0
end

function on()
	isOn = true
	script.Parent.Reflectance = 1
	script.Parent.Parent.Parent.Cart.Mover.BodyPosition.position = script.Parent.Parent.Parent.Floors:FindFirstChild(script.Parent.Name).Position
	wait(1)
	off()
end

function onClicked()
	
	if isOn == true then on() else on() end

end

script.Parent.ClickDetector.MouseClick:connect(onClicked)

off()</ProtectedString>
