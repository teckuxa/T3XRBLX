		<Item class="HopperBin" referent="RBX3914">
			<Properties>
				<bool name="Active">false</bool>
				<bool name="Archivable">true</bool>
				<token name="BinType">0</token>
				<string name="Name">MyCamTool</string>
				<Content name="TextureId"><null></null></Content>
			</Properties>
			<Item class="Script" referent="RBX3915">
				<Properties>
					<bool name="Archivable">true</bool>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">local zoom = false
local thing = game.Workspace.Cammy1 
local cammy = game.Workspace.Cammy1
local user = &quot;&quot;
local camount = 14
local spotnumber = 1

function onKeyDown(key)
	key:lower()
	if key == &quot;q&quot; then
			if not zoom then
				local player = game.Workspace:findFirstChild(script.Parent.Parent.Parent.Name)
				zoom = true
				cam = workspace.CurrentCamera:Clone()
				cam.Parent = workspace
				workspace.CurrentCamera.CameraSubject = thing
				workspace.CurrentCamera.CameraType = &quot;Custom&quot;
				workspace.CurrentCamera.CoordinateFrame = cammy.CFrame	
			else
				zoom = false
				workspace.CurrentCamera.CameraSubject = game.Players.LocalPlayer.Character
				workspace.CurrentCamera:Remove()
				workspace.CurrentCamera = cam
			end
	end
	if key == &quot;r&quot; then
		if not zoom then
			script.Parent.Parent = nil
			local message = game.Players.LocalPlayer:findFirstChild(&quot;Hint&quot;)
			if message ~= nil then
				message:remove()
			end
		else 
			print(&quot;A camera has detected you.&quot;)
		end
	end
	if key == &quot;e&quot; then
		if not zoom and spotnumber &lt; camount then
			spotnumber = spotnumber +1
			thing = workspace:findFirstChild(&quot;Cammy&quot;..spotnumber..&quot;&quot;)
			cammy = workspace:findFirstChild(&quot;Cammy&quot;..spotnumber..&quot;&quot;)
		elseif zoom and spotnumber &lt; camount then
			spotnumber = spotnumber + 1
			thing = workspace:findFirstChild(&quot;Cammy&quot;..spotnumber..&quot;&quot;)
			cammy = workspace:findFirstChild(&quot;Cammy&quot;..spotnumber..&quot;&quot;)
			workspace.CurrentCamera.CameraSubject = thing
			workspace.CurrentCamera.CameraType = &quot;Custom&quot;
			workspace.CurrentCamera.CoordinateFrame = cammy.CFrame
		elseif zoom and spotnumber == camount then
			spotnumber = 1
			thing = workspace:findFirstChild(&quot;Cammy&quot;..spotnumber..&quot;&quot;)
			cammy = workspace:findFirstChild(&quot;Cammy&quot;..spotnumber..&quot;&quot;)
			workspace.CurrentCamera.CameraSubject = thing
			workspace.CurrentCamera.CameraType = &quot;Custom&quot;
			workspace.CurrentCamera.CoordinateFrame = cammy.CFrame
		elseif not zoom and spotnumber == camount then
			spotnumber = 1
			thing = workspace:findFirstChild(&quot;Cammy&quot;..spotnumber..&quot;&quot;)
			cammy = workspace:findFirstChild(&quot;Cammy&quot;..spotnumber..&quot;&quot;)
		end
	end
	if key == &quot;f&quot; then
		if not zoom and spotnumber &gt; 1 then
			spotnumber = spotnumber -1
			thing = workspace:findFirstChild(&quot;Cammy&quot;..spotnumber..&quot;&quot;)
			cammy = workspace:findFirstChild(&quot;Cammy&quot;..spotnumber..&quot;&quot;)
		elseif zoom and spotnumber &gt; 1 then
			spotnumber = spotnumber - 1
			thing = workspace:findFirstChild(&quot;Cammy&quot;..spotnumber..&quot;&quot;)
			cammy = workspace:findFirstChild(&quot;Cammy&quot;..spotnumber..&quot;&quot;)
			workspace.CurrentCamera.CameraSubject = thing
			workspace.CurrentCamera.CameraType = &quot;Custom&quot;
			workspace.CurrentCamera.CoordinateFrame = cammy.CFrame
		elseif zoom and spotnumber &lt;= 1 then
			spotnumber = camount
			thing = workspace:findFirstChild(&quot;Cammy&quot;..spotnumber..&quot;&quot;)
			cammy = workspace:findFirstChild(&quot;Cammy&quot;..spotnumber..&quot;&quot;)
			workspace.CurrentCamera.CameraSubject = thing
			workspace.CurrentCamera.CameraType = &quot;Custom&quot;
			workspace.CurrentCamera.CoordinateFrame = cammy.CFrame
		elseif not zoom and spotnumber &lt;= 1 then
			spotnumber = camount
			thing = workspace:findFirstChild(&quot;Cammy&quot;..spotnumber..&quot;&quot;)
			cammy = workspace:findFirstChild(&quot;Cammy&quot;..spotnumber..&quot;&quot;)
		end
	end
end

function connect(mouse)
	local human = script.Parent.Parent
	player = game.Players:GetPlayerFromCharacter(human)
	if player ~= nil then
		user = player
	end
	local dude = game.Workspace:findFirstChild(script.Parent.Parent.Parent.Name) 
	local human = dude.Humanoid
	human.Died:connect(FailSafe)
	mouse.KeyDown:connect(onKeyDown)

	local ms = Instance.new(&quot;Hint&quot;)
	ms.Parent = game.Players.LocalPlayer
	ms.Text = &quot;Security Camera On.&quot;
	wait(3)
	ms.Text = &quot;&apos;Q&apos; is to Start/Stop. &apos;E&apos; is to cycle both image frames. To remove the Camera tool, Press &apos;R&apos;&quot;
	wait(6)
	ms.Text = &quot;Please note that the camera will ONLY work if seated behind the screens.&quot;
	wait(3)
	ms:remove()
end

function remoov()
	if zoom == true then
		workspace.CurrentCamera.CameraSubject = user.Character
		workspace.CurrentCamera:Remove()
		workspace.CurrentCamera = cam
		zoom = false
	end
end

function FailSafe() 
	if zoom then
		workspace.CurrentCamera.CameraSubject = game.Players.LocalPlayer.Character
		workspace.CurrentCamera:Remove()
		workspace.CurrentCamera = cam
	else
		return
	end
end

script.Parent.Deselected:connect(remoov)
script.Parent.Selected:connect(connect)
</ProtectedString>
				</Properties>
			</Item>
		</Item>
		<Item class="HopperBin" referent="RBX3916">
			<Properties>
				<bool name="Active">false</bool>
				<bool name="Archivable">true</bool>
				<token name="BinType">0</token>
				<string name="Name">Teleport</string>
				<Content name="TextureId"><null></null></Content>
			</Properties>
			<Item class="Script" referent="RBX3917">
				<Properties>
					<bool name="Archivable">true</bool>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">TeleportScript</string>
					<ProtectedString name="Source">--- SonOfSevenless
print(&quot;Teleport Spell Loaded&quot;)

local COOLDOWN = 0
local MP = 0



bin = script.Parent

function TryToCast(player)
	-- returns true if player may cast this spell

	-- make sure this player has the wizard board stats
	local stats = player:findFirstChild(&quot;leaderstats&quot;)
	if stats == nil then return false end
	local mana = stats:findFirstChild(&quot;Mana&quot;)
	local level = stats:findFirstChild(&quot;Level&quot;)
	if mana == nil or level == nil then return false end

	if (mana.Value &gt;= MP) then
		mana.Value = mana.Value - MP
		return true
	end

	return false
end




function teleportPlayer(pos)

	local player = game.Players.LocalPlayer
	if player == nil or player.Character == nil then return end

	local char = player.Character.Torso

	sound = Instance.new(&quot;Sound&quot;)
	sound.SoundId = &quot;&quot;
	sound.Parent = char
	sound.PlayOnRemove = true
	sound:remove()

	char.CFrame = CFrame.new(Vector3.new(pos.x, pos.y + 7, pos.z))


	sound = Instance.new(&quot;Sound&quot;)
	sound.SoundId = &quot;&quot;
	sound.Parent = char
	sound.PlayOnRemove = true
	sound:remove()

end


enabled = true
function onButton1Down(mouse)
	if not enabled then
		return
	end

	local player = game.Players.LocalPlayer
	if player == nil then return end
	--if TryToCast(player) == false then return end
	

	enabled = false
	mouse.Icon = &quot;rbxasset://textures\\ArrowFarCursor.png&quot;

	-- find the best cf
	local cf = mouse.Hit
	local v = cf.lookVector

	teleportPlayer(cf.p)

	wait(COOLDOWN)
	mouse.Icon = &quot;rbxasset://textures\\ArrowCursor.png&quot;
	enabled = true

end

function onSelected(mouse)
	mouse.Icon = &quot;rbxasset://textures\\ArrowCursor.png&quot;
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end

bin.Selected:connect(onSelected)

</ProtectedString>
				</Properties>
			</Item>
		</Item>
