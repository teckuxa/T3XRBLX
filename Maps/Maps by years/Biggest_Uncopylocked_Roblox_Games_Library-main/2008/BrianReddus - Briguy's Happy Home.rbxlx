			<Item class="Script" referent="RBX2951">
				<Properties>
					<bool name="Archivable">true</bool>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">tool = script.CamTool


function touch(hit)
	local h = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
	if h ~= nil then
		local player = game.Players:findFirstChild(hit.Parent.Name)
		local tewl = player.Backpack:findFirstChild(tool.Name)
		if tewl == nil then
			tool:clone().Parent = player.Backpack
		end
	end
end

script.Parent.Touched:connect(touch)

function added(part)
		if part.className == &quot;Weld&quot; then

		

		local torso = part.Part1
		if torso ~= nil then

			local char = torso.Parent
			local player = game.Players:GetPlayerFromCharacter(char)
			if player ~= nil then
				local hopper = Instance.new(&quot;ObjectValue&quot;)
				hopper.Parent = char
				hopper.Name = &quot;Seated&quot;
				part.AncestryChanged:connect(function(child) onSitUp(child, hopper) end) 
			end
		end
		end
end
script.Parent.ChildAdded:connect(added)
function onSitUp(child, hopper)
	if child.Parent == nil then
		hopper.Parent = nil 	
	end
end
</ProtectedString>
				</Properties>
				<Item class="HopperBin" referent="RBX2952">
					<Properties>
						<bool name="Active">false</bool>
						<bool name="Archivable">true</bool>
						<token name="BinType">0</token>
						<string name="Name">CamTool</string>
						<Content name="TextureId"><null></null></Content>
					</Properties>
					<Item class="Script" referent="RBX2953">
						<Properties>
							<bool name="Archivable">true</bool>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">local zoom = false
local thing = game.Workspace.Cammy1 
local cammy = game.Workspace.Cammy1
local user = &quot;&quot;
local camount = 14
local spotnumber = 1

function onKeyDown(key)
	key:lower()
	if key == &quot;q&quot; then
			if not zoom then
				local player = game.Workspace:findFirstChild(script.Parent.Parent.Parent.Name)
				local seated = player:findFirstChild(&quot;Seated&quot;)
				if seated ~= nil then
				zoom = true
				cam = workspace.CurrentCamera:Clone()
				cam.Parent = workspace
				workspace.CurrentCamera.CameraSubject = thing
				workspace.CurrentCamera.CameraType = &quot;Custom&quot;
				workspace.CurrentCamera.CoordinateFrame = cammy.CFrame	
				end
			else
				zoom = false
				workspace.CurrentCamera.CameraSubject = game.Players.LocalPlayer.Character
				workspace.CurrentCamera:Remove()
				workspace.CurrentCamera = cam
			end
	end
	if key == &quot;r&quot; then
		if not zoom then
			script.Parent.Parent = nil
			local message = game.Players.LocalPlayer:findFirstChild(&quot;Hint&quot;)
			if message ~= nil then
				message:remove()
			end
		else 
			print(&quot;A camera has detected you.&quot;)
		end
	end
	if key == &quot;e&quot; then
		if not zoom and spotnumber &lt; camount then
			spotnumber = spotnumber +1
			thing = workspace:findFirstChild(&quot;Cammy&quot;..spotnumber..&quot;&quot;)
			cammy = workspace:findFirstChild(&quot;Cammy&quot;..spotnumber..&quot;&quot;)
		elseif zoom and spotnumber &lt; camount then
			spotnumber = spotnumber + 1
			thing = workspace:findFirstChild(&quot;Cammy&quot;..spotnumber..&quot;&quot;)
			cammy = workspace:findFirstChild(&quot;Cammy&quot;..spotnumber..&quot;&quot;)
			workspace.CurrentCamera.CameraSubject = thing
			workspace.CurrentCamera.CameraType = &quot;Custom&quot;
			workspace.CurrentCamera.CoordinateFrame = cammy.CFrame
		elseif zoom and spotnumber == camount then
			spotnumber = 1
			thing = workspace:findFirstChild(&quot;Cammy&quot;..spotnumber..&quot;&quot;)
			cammy = workspace:findFirstChild(&quot;Cammy&quot;..spotnumber..&quot;&quot;)
			workspace.CurrentCamera.CameraSubject = thing
			workspace.CurrentCamera.CameraType = &quot;Custom&quot;
			workspace.CurrentCamera.CoordinateFrame = cammy.CFrame
		elseif not zoom and spotnumber == camount then
			spotnumber = 1
			thing = workspace:findFirstChild(&quot;Cammy&quot;..spotnumber..&quot;&quot;)
			cammy = workspace:findFirstChild(&quot;Cammy&quot;..spotnumber..&quot;&quot;)
		end
	end
end

function connect(mouse)
	local human = script.Parent.Parent
	player = game.Players:GetPlayerFromCharacter(human)
	if player ~= nil then
		user = player
	end
	local dude = game.Workspace:findFirstChild(script.Parent.Parent.Parent.Name) 
	local human = dude.Humanoid
	human.Died:connect(FailSafe)
	mouse.KeyDown:connect(onKeyDown)

	local ms = Instance.new(&quot;Hint&quot;)
	ms.Parent = game.Players.LocalPlayer
	ms.Text = &quot;Security Camera On.&quot;
	wait(3)
	ms.Text = &quot;&apos;Q&apos; is to Start/Stop. &apos;E&apos; is to cycle both image frames. To remove the Camera tool, Press &apos;R&apos;&quot;
	wait(6)
	ms.Text = &quot;Please note that the camera will ONLY work if seated behind the screens.&quot;
	wait(3)
	ms:remove()
end

function remoov()
	if zoom == true then
		workspace.CurrentCamera.CameraSubject = user.Character
		workspace.CurrentCamera:Remove()
		workspace.CurrentCamera = cam
		zoom = false
	end
end

function FailSafe() 
	if zoom then
		workspace.CurrentCamera.CameraSubject = game.Players.LocalPlayer.Character
		workspace.CurrentCamera:Remove()
		workspace.CurrentCamera = cam
	else
		return
	end
end

script.Parent.Deselected:connect(remoov)
script.Parent.Selected:connect(connect)
</ProtectedString>
						</Properties>
					</Item>
				</Item>
			</Item>
		</Item>
