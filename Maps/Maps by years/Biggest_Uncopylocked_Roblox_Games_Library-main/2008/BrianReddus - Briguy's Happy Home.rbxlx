			<Item class="Script" referent="RBX1495">
				<Properties>
					<bool name="Archivable">true</bool>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">MasterScript</string>
					<ProtectedString name="Source">Code = &quot;4113&quot; 
Input = &quot;&quot;






function Clear()
print(&quot;Cleared&quot;)
Input = &quot;&quot;
end

script.Parent.Clear.ClickDetector.MouseClick:connect(Clear)




function Enter()
if Input == Code then
print(&quot;Entered&quot;)
Input = &quot;&quot;

pad = game.Workspace.FloorMid
BP = pad.BodyPosition

BP.position = Vector3.new(0, 235.3, -35)
wait(2)
BP.position = Vector3.new(0, 235.3, -49)
wait(15)
BP.position = Vector3.new(0, 235.3, -35)
wait(7)
BP.position = Vector3.new(0, 233.8, -35)



return end
Input = &quot;&quot;
print(&quot;Wrong Code&quot;)
end




script.Parent.Enter.ClickDetector.MouseClick:connect(Enter)

------------------------------------------
--Digets


function Click1()
Input = Input..1
print(&quot;1&quot;) 
end

script.Parent.GreenButton.ClickDetector.MouseClick:connect(Click1)

function Click2()
Input = Input..2
print(&quot;2&quot;)
end

script.Parent.YellowButton.ClickDetector.MouseClick:connect(Click2)

function Click3()
Input = Input..3
print(&quot;3&quot;)
end

script.Parent.BlueButton.ClickDetector.MouseClick:connect(Click3)

function Click4()
Input = Input..4
print(&quot;4&quot;)
end

script.Parent.RedButton.ClickDetector.MouseClick:connect(Click4)















</ProtectedString>
