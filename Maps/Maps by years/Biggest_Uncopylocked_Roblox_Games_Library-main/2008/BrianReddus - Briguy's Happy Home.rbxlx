				<Item class="Script" referent="RBX2047">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">speed = 50

door = script.Parent
bv = door.BodyVelocity

function onChange()
	door:BreakJoints()
	if script.Parent.Open.Value then
		bv.velocity = Vector3.new(-speed,0,0)
	elseif not script.Parent.Open.Value then
		bv.velocity = Vector3.new(speed,0,0)
	end
end

script.Parent.Open.Changed:connect(function(property)
	if property == &quot;Value&quot; then
		onChange()
	end
end)
</ProtectedString>
					</Properties>
				</Item>
			</Item>
