						<string name="Name">MasterScript</string>
						<ProtectedString name="Source">function onClick()
print(&quot;SlideDoor&quot;)

local sdoor = script.Parent.Parent.SlideDoor

sdoor.BodyVelocity.velocity = Vector3.new(5,0,0)
wait(7)
sdoor.BodyVelocity.velocity = Vector3.new(-5,0,0)

end

------------------------------------------

script.Parent.ClickDetector.MouseClick:connect(onClick)









