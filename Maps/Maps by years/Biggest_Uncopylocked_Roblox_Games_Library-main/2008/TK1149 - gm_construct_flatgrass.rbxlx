				<string name="Name">Motorcycle</string>
				<string name="Source">-- D.T.M.

model = game.Workspace.blank -- Change &quot;blank&quot; to the name of the model you wanna regenerate. NOTE: THE MODEL CANNOT HAVE SPACES IN ITS NAME!
backup = model:clone() 

function onChatted(msg, recipient, speaker) 

local source = string.lower(speaker.Name) 
msg = string.lower(msg) 

if (msg == &quot;blank&quot;) then -- Change &quot;red&quot; to what you want to say to make the model regenerate. NOTE: IT CANNOT HAVE CAPS OR SPACES IN IT!
model:remove() 
model = backup:clone() 
model.Parent = game.Workspace 
model:makeJoints() 
end 

end 

