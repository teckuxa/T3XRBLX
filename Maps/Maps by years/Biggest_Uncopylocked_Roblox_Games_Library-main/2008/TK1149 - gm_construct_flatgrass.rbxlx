					</Item>
					<Item class="Script" referent="RBX1065">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<string name="Source">local e1 = script.Parent.Enabled
local portal = script.Parent.Parent.Blue
local e2 = portal.Enabled
local fling = 1

function onTouched(part)
	if part:GetMass() &gt;= 126 then return end
	if part.Name == &quot;Portal&quot; then return end
	if part.Parent == nil then return end
	local t = part.Parent:findFirstChild(&quot;Torso&quot;)
	if t ~= nil then part = t end
	if e1.Value == 1 then
		e2.Value = 2
		local x = part.Velocity.x
		local y = part.Velocity.y
		local z = part.Velocity.z
		if x &gt; y and x &gt; z then
			c = x 
		elseif y &gt; x and y &gt; z then
			c = y
		elseif z &gt; x and z &gt; y then
			c = z 
		end
		print(c)
		if c &lt; 0 then
			c = -c
			print(&quot;Changed &quot; .. c)
		end
		part.CFrame = portal.CFrame
		wait()
		part.Velocity = portal.CFrame.lookVector * (c * 2)		--adjusts speed.
		wait(1)
		e2.Value = 1
	end
end

script.Parent.Touched:connect(onTouched)

