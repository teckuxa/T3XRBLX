					<Item class="Script" referent="RBX1071">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<string name="Source">local e1 = script.Parent.Enabled
local portal = script.Parent.Parent.Red
local e2 = portal.Enabled
local fling = 1

function onTouched(part)
	if part:GetMass() &gt;= 126 then return end			--small objects only are teleported
	if part.Name == &quot;Portal&quot; then return end			--the projectiles cant be teleported
	if part.Parent == nil then return end
	local t = part.Parent:findFirstChild(&quot;Torso&quot;)			--makes the part the torso instead of the hitting part if avaliable
	if t ~= nil then part = t end
	if e1.Value == 1 then
		e2.Value = 2					--debounces the portal you come out of, but not the one you enter, allowing infinite loops.
		local x = part.Velocity.x			--next few lines find the highest velocity (speed)
		local y = part.Velocity.y
		local z = part.Velocity.z
		if x &gt; y and x &gt; z then
			c = x 
		elseif y &gt; x and y &gt; z then
			c = y
		elseif z &gt; x and z &gt; y then
			c = z 
		end
		print(c)					--prints speed
		if c &lt; 0 then				--make sure the speed is positive.
			c = -c
			print(&quot;Changed &quot; .. c)
		end
		part.CFrame = portal.CFrame		--moves the object
		wait()
		part.Velocity = portal.CFrame.lookVector * (c * 2)		--adjusts speed.
		wait(1)
		e2.Value = 1
	end
end

script.Parent.Touched:connect(onTouched)
</string>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
				</Item>
			</Item>
			<Item class="Script" referent="RBX1072">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">PortalShooter</string>
					<string name="Source">Tool = script.Parent
hold = false
currentColor = script.Parent.currentColor
firstTime = script.Parent.FirstTime
carry = false
object = nil
color = script.Parent.Color
h = Instance.new(&quot;Hint&quot;)
h.Parent = nil
Tool.Teleporters:MoveTo(Vector3.new(math.random(-200,200), 1000, math.random(-200,200)))

function computeDirection(vec)
	local lenSquared = vec.magnitude^2
	local invSqrt = 1 / math.sqrt(lenSquared)
	return Vector3.new(vec.x * invSqrt, vec.y * invSqrt, vec.z * invSqrt)
end

function onSelected(mouse)
	h.Parent = Tool.Parent
	h.Text = &quot;Press Q for Blue Portal, E for Red Portal, R to close Portals.&quot;
	Tool.Handle3.CanCollide = false
	Weld()
end

function onUnSelected(mouse)
	Tool.Handle3.CanCollide = true
	Weld()
	h.Parent = nil
end

function Weld()				--welds all the parts together
	w1 = Instance.new(&quot;Weld&quot;)
	w1.Parent = Tool.Handle	
	w1.Part0 = w1.Parent
	w1.Part1 = Tool.Handle1
	w1.C1 = CFrame.new(Vector3.new(0, -1.5, 0))

	w2 = Instance.new(&quot;Weld&quot;)
	w2.Parent = Tool.Handle
	w2.Part0 = w2.Parent
	w2.Part1 = Tool.Handle2
	w2.C1 = CFrame.new(Vector3.new(0, -2.3, 0))
	
	w3 = Instance.new(&quot;Weld&quot;)
	w3.Parent = Tool.Handle
	w3.Part0 = w3.Parent
	w3.Part1 = Tool.Handle3
	w3.C1 = CFrame.new(Vector3.new(0, -2.5, 0))
	
	w4 = Instance.new(&quot;Weld&quot;)
	w4.Parent = Tool.Handle
	w4.Part0 = w4.Parent
	w4.Part1 = Tool.I1
	w4.C1 = CFrame.new(Vector3.new(0, -1.9, 0.6)) * CFrame.fromEulerAnglesXYZ(-0.6, 0, 0)
	
	w5 = Instance.new(&quot;Weld&quot;)
	w5.Parent = Tool.Handle
	w5.Part0 = w5.Parent
	w5.Part1 = Tool.I2
	w5.C1 = CFrame.new(Vector3.new(0, -2.1, -1.6)) * CFrame.fromEulerAnglesXYZ(0.4, 0, 0)
	
	w6 = Instance.new(&quot;Weld&quot;)
	w6.Parent = Tool.Handle
	w6.Part0 = w6.Parent
	w6.Part1 = Tool.O1
	w6.C1 = CFrame.new(Vector3.new(-0.5, -1.9, 0)) * CFrame.fromEulerAnglesXYZ(0, -0.5, -0.5)

	w7 = Instance.new(&quot;Weld&quot;)
	w7.Parent = Tool.Handle
	w7.Part0 = w7.Parent
	w7.Part1 = Tool.O2
	w7.C1 = CFrame.new(Vector3.new(1.6, -2, -0.6)) * CFrame.fromEulerAnglesXYZ(0, 0.5, 0.5)

	w8 = Instance.new(&quot;Weld&quot;)
	w8.Parent = Tool.Handle
	w8.Part0 = w8.Parent
	w8.Part1 = Tool.P1
	w8.C1 = CFrame.new(Vector3.new(0.5, -1.9, 0)) * CFrame.fromEulerAnglesXYZ(0, 0.5, 0.5)

	w9 = Instance.new(&quot;Weld&quot;)
	w9.Parent = Tool.Handle
	w9.Part0 = w9.Parent
	w9.Part1 = Tool.P2
	w9.C1 = CFrame.new(Vector3.new(-1.6, -2, -0.6)) * CFrame.fromEulerAnglesXYZ(0, -0.5, -0.5)
end

function onKeyDown(key, mouse)
	if (key == &quot;q&quot;) then
		currentColor = 1
	end
	if (key == &quot;e&quot;) then
		currentColor = 2
	end
	if (key == &quot;p&quot;) then
		if (carry == false) then 
			if (mouse.Target:GetMass() &gt; 400) then return end
			object = mouse.Target
			local b = Instance.new(&quot;BodyPosition&quot;)
			b.Parent = object
			b.position = Tool.Parent.Humanoid.TargetPoint / 0.4
			b.maxForce = Vector3.new(3000, 3000, 3000)
			carry = true
		else
			object.BodyPosition:remove()
			object = nil
		end
	end
end

function fire(v)
	print(v)
	if (hold == false) and (carry == false) then
		hold = true
		Tool.Parent.Torso[&quot;Right Shoulder&quot;].DesiredAngle = 3			--moves your arm as if firing.
		Tool.BuildSound:Play()									--plays a sound (cant be heard by other players)
		if firstTime.Value == true then
			firstTime.Value = false								--the first time a portal is fired, they are put into the game.
			script.Parent.Teleporters:MoveTo(Vector3.new(math.random(-200,200), 1000, math.random(-200,200)))
			script.Parent.Teleporters.Parent = script.Parent.Parent
		end
		local dir = v - script.Parent[&quot;Handle3&quot;].Position
		dir = computeDirection(dir)
		local pos = script.Parent[&quot;Handle3&quot;].Position + (dir * 8)
		local p = Instance.new(&quot;Part&quot;)
		p.Name = &quot;Portal&quot;
		p.CFrame = CFrame.new(pos, pos + dir)
		p.BrickColor = BrickColor.new(currentColor.Value)
		p.Reflectance = 0.2
		p.Velocity = (script.Parent.Parent[&quot;Head&quot;].Position - v).unit * -100	--the last number is the speed of the firing (dont make it too fast, or portals will go through walls and appear in bad places.)
		p.Size = Vector3.new(1, 1, 1)
		p.formFactor = &quot;Symmetric&quot;
		local mesh = Instance.new(&quot;SpecialMesh&quot;)
		mesh.MeshType = &quot;Sphere&quot;
		mesh.Scale = Vector3.new(1, 1, 1)
		mesh.Parent = p
		local upforce = Instance.new(&quot;BodyForce&quot;)
		upforce.force = Vector3.new(0, p:GetMass() * 196, 0)
		upforce.Parent = p
		if (color.Value == 1) then
			s = script.Parent[&quot;BlueScript&quot;]:Clone()
		else
			s = script.Parent[&quot;RedScript&quot;]:Clone()
		end
		s.Disabled = false
		s.Parent = p
		p.Parent = game.Workspace[script.Parent.Parent.Name]
		hold = false
	end
end

Tool.Enabled = true

function onActivated()
	if script.Parent.Enabled == true then
		script.Parent.Enabled = false
		fire(script.Parent.Parent[&quot;Humanoid&quot;].TargetPoint)
		wait(0.25)
		script.Parent.Enabled = true
	end
end

function RemovePortals(property)
	if property == &quot;Value&quot; then
		if Tool.FirstTime.Value == false then return end
		script.Parent.Parent.Teleporters.Parent = script.Parent
		script.Parent.Teleporters:MoveTo(Vector3.new(math.random(-200,200), 1000, math.random(-200,200)))
	end
end

Tool.Activated:connect(onActivated)
Tool.Unequipped:connect(onUnSelected)
Tool.Equipped:connect(onSelected)
Tool.FirstTime.Changed:connect(RemovePortals) 
Weld()</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="LocalScript" referent="RBX1073">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Local Gui</string>
					<string name="Source">local Tool = script.Parent
object = nil
carry = false

function onEquippedLocal(mouse)
	if mouse == nil then
		print(&quot;Mouse not found&quot;)			--checks if the mouse is there
		return 
	end
	mouse.KeyDown:connect(onKeyDown)
	mouse.Icon = &quot;http://www.roblox.com/asset/?id=2314979&quot;		--changes the cursor to a cool one. =P
end

function onKeyDown(key)
	key = key:lower()
	if (key == &quot;q&quot;) then
		script.Parent.currentColor.Value = 23
		script.Parent.Color.Value = 1
	end
	if (key == &quot;e&quot;) then
		script.Parent.currentColor.Value = 21
		script.Parent.Color.Value = 2
	end
	if (key == &quot;r&quot;) then
		script.Parent.FirstTime.Value = true
	end
end
Tool.Equipped:connect(onEquippedLocal)</string>
