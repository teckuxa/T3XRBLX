			<Item class="Script" referent="RBX1076">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">RedScript</string>
					<string name="Source">game:GetService(&quot;Debris&quot;):AddItem(script.Parent, 8)

function onTouched(hit)
	if hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil then return end
	if hit.Parent.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil then return end
	if hit.Name ~= &quot;Portal&quot; or hit.Name == &quot;Red&quot; or hit.Name == &quot;Head&quot; or hit.Name == &quot;Torso&quot; then	--if the part isnt named portal, then the projectile is removed
		script.Parent:remove()
		return
	end
	local tele = script.Parent.Parent.Teleporters
	local pos = script.Parent.Position
	script.Parent.Parent[&quot;PortalGun&quot;].Open:Play()		--plays a sound (cant be heard)
	script.Parent:remove()							--removes the projectile
	tele.Red.CFrame = hit.CFrame
	if hit.Size.y &lt; hit.Size.x and hit.Size.y &lt; hit.Size.z then											--these 6 lines orient the portal depending on the thickness of a brick.
		tele.Red.CFrame = tele.Red.CFrame * CFrame.fromEulerAnglesXYZ(math.pi / 2, 0, 0)
	elseif hit.Size.x &lt; hit.Size.y and hit.Size.x &lt; hit.Size.z then
		tele.Red.CFrame = tele.Red.CFrame * CFrame.fromEulerAnglesXYZ(0, math.pi / 2, math.pi / 2)
	elseif hit.Size.z &lt; hit.Size.y and hit.Size.z &lt; hit.Size.x then
		tele.Red.CFrame = tele.Red.CFrame * CFrame.fromEulerAnglesXYZ(0, 0, math.pi / 2)
	end
	tele.Red.Size = Vector3.new(1, 1, 0.4)	
	tele.Red.Position = pos
	local oriCFrame = tele.Red.CFrame			--the next lines enlarge the portal in a cool effect.
	wait()
	tele.Red.Size = Vector3.new(2, 1.2, 0.4)
	wait()
	tele.Red.Size = Vector3.new(4, 2.5, 0.4)
	wait()
	tele.Red.Size = Vector3.new(6, 3.2, 0.4)
	wait()
	tele.Red.Size = Vector3.new(8, 5, 0.4)
	wait()
	tele.Red.Size = Vector3.new(10, 6, 0.4)
	tele.Red.CFrame = oriCFrame
end

script.Parent.Touched:connect(onTouched)

wait(2)
script.Parent:remove()					--removes the projectile after 2 seconds.</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX1077">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">BlueScript</string>
					<string name="Source">game:GetService(&quot;Debris&quot;):AddItem(script.Parent, 8)

function onTouched(hit)
	if hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil then return end
	if hit.Parent.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil then return end
	if hit.Name ~= &quot;Portal&quot; or hit.Name == &quot;Red&quot; or hit.Name == &quot;Head&quot; or hit.Name == &quot;Torso&quot; then					--if the part isnt named portal, then the projectile is removed
		script.Parent:remove()
		return
	end
	local tele = script.Parent.Parent.Teleporters
	local pos = script.Parent.Position
	script.Parent.Parent[&quot;PortalGun&quot;].Open:Play()		--plays a sound (cant be heard)
	script.Parent:remove()							--removes the projectile
	tele.Blue.CFrame = hit.CFrame
	if hit.Size.y &lt; hit.Size.x and hit.Size.y &lt; hit.Size.z then											--these 6 lines orient the portal depending on the thickness of a brick.
		tele.Blue.CFrame = tele.Blue.CFrame * CFrame.fromEulerAnglesXYZ(math.pi / 2, 0, 0)
	elseif hit.Size.x &lt; hit.Size.y and hit.Size.x &lt; hit.Size.z then
		tele.Blue.CFrame = tele.Blue.CFrame * CFrame.fromEulerAnglesXYZ(0, math.pi / 2, math.pi / 2)
	elseif hit.Size.z &lt; hit.Size.y and hit.Size.z &lt; hit.Size.x then
		tele.Blue.CFrame = tele.Blue.CFrame * CFrame.fromEulerAnglesXYZ(0, 0, math.pi / 2)
	end
	tele.Blue.Size = Vector3.new(1, 1, 0.4)	
	tele.Blue.Position = pos
	local oriCFrame = tele.Blue.CFrame			--the next lines enlarge the portal in a cool effect.
	wait()
	tele.Blue.Size = Vector3.new(2, 1.2, 0.4)
	wait()
	tele.Blue.Size = Vector3.new(4, 2.5, 0.4)
	wait()
	tele.Blue.Size = Vector3.new(6, 3.2, 0.4)
	wait()
	tele.Blue.Size = Vector3.new(8, 5, 0.4)
	wait()
	tele.Blue.Size = Vector3.new(10, 6, 0.4)
	tele.Blue.CFrame = oriCFrame
end

script.Parent.Touched:connect(onTouched)

wait(2)
script.Parent:remove()					--removes the projectile after 2 seconds.</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX1078">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">README</string>
					<string name="Source">--[[

Portal Gun by Toxsikkilla, give credit if you wish to publish this. =D
________________

==Non-scripter Instructions==
	To make a place with this Tool with as little bugs as possible, follow these steps

	1. 	Name every brick you want portals to go on as Portal.
	2. 	You can have the walls rotated in ANY way, and you can resize them however you want.
	3. 	A square block is a BAD IDEA, Portals will always go on the thinnest side, so square blocks should be broken up into 4 pieces.
	4.	Have fun building! Make a fun level, and DONT delete these instructions if you wish to publish the tool yourself.
________________

==Scripter Instructions==
	Same as above, but if you can...

	1.	Fix bugs.
	2.	Fix flinging, it does work but can be glitchy.
	3.	If you modify the tool, add your name to the bottom of the list. =D
________________

==List of bug fixers==
	Toxsikkilla	- Made the Multihandle, started the gun from scratch, added textures, flinging, everything basically. =P
	coelho714 	- Making the player that can choose between Red/Blue Portal, close Portals, fixed a bit on flinging.
	Toxsikkilla	- Made the closing Portals fix of the previous update work. General bug fixes also.
________________

Have fun! =D</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
