		<Item class="Script" referent="RBX328">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Wheeeee</string>
				<string name="Source">bin=script.Parent
you = bin.Parent.Parent
s = Instance.new(&quot;Script&quot;)
m = Instance.new(&quot;Message&quot;)
youc = you:getChildren()

function onSelected(mouse)
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	mouse.KeyDown:connect(onKeyDown)
if you:findFirstChild(&quot;RunMessage&quot;) == nil then
m.Parent = you
m.Name = &quot;RunMessage&quot;
m.Text = &quot;W to run&quot;
wait(3)
m.Text = &quot;S to go back to normal speed&quot;
wait(3)
m.Text = &quot;choose your speed then&quot;
wait(3)
m.Text = &quot;unselect the tool to keep it&quot;
m:remove()
else
m:remove()
end
end

function onKeyDown(key)
	if (key~=nil) then
		key = key:lower()
			if key==&quot;w&quot; then

s.Source = [[
g = script.Parent

function onRunning(speed)
	if speed&gt;0 then
		pose = &quot;Running&quot;
g.Torso.Velocity = g.Torso.CFrame.lookVector *60 -- Speed
	else
		pose = &quot;Standing&quot;
	end
end

g.Humanoid.Running:connect(onRunning)
]]
s.Disabled = false
s.Parent = you.Character
elseif key ~=&quot;c&quot; and key ~= &quot; &quot; and s ~= nil then
s:remove()

			end
end
end


bin.Selected:connect(onSelected)
if m ~= nil then
m:remove()
end

-- Original Creator: Gamehero. :)
</string>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX329">
			<Properties>
				<bool name="Disabled">true</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Script</string>
				<string name="Source">X = script.Parent
TT = 0

function onRunning(speed) 
	Head = X.Head
	if speed&gt;0 and TT == 0 then 
		if Head:FindFirstChild(&quot;LowGrav&quot;) == nil then
			local b = Instance.new(&quot;BodyForce&quot;)
			b.Name = &quot;LowGrav&quot;
			b.force = Vector3.new(0,-50000,0)
			b.Parent = Head
		end
		pose = &quot;Running&quot; 
		X.Torso[&quot;Right Shoulder&quot;].CurrentAngle = -1.5
		X.Torso[&quot;Left Shoulder&quot;].CurrentAngle = 1.5
		X.Torso[&quot;Right Shoulder&quot;].DesiredAngle = -1.5
		X.Torso[&quot;Left Shoulder&quot;].DesiredAngle = 1.5
		X.Torso.Velocity = X.Torso.CFrame.lookVector *80 
	elseif X.Torso[&quot;Right Shoulder&quot;].DesiredAngle == 3.14 and Head:FindFirstChild(&quot;LowGrav&quot;) ~= nil then
		Head.LowGrav:remove()
	else 
		pose = &quot;Standing&quot; 
	end 
end 
function onJumping() 
	TT = 1
	Head = X.Head
	if Head:FindFirstChild(&quot;LowGrav&quot;) ~= nil then
		Head.LowGrav:remove()
	end 
	TT = 0
end 

X.Humanoid.Jumping:connect(onJumping)
X.Humanoid.Running:connect(onRunning)</string>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX330">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Voice_Regen</string>
				<string name="Source">-- nimaki12

model = game.Workspace.Model -- Change Planes to the model&apos;s name you want this script for, do not use spaces in model&apos;s name
backup = model:clone() 

function onChatted(msg, recipient, speaker) 

local source = string.lower(speaker.Name) 
msg = string.lower(msg) 

if (msg == &quot;regen&quot;) then -- Change regen to the word you want to say to regenerate your model, do not use spaces or capital letters
model:remove() 
model = backup:clone() 
model.Parent = game.Workspace 
model:makeJoints() 
end 

end 

function onPlayerEntered(newPlayer) 
newPlayer.Chatted:connect(function(msg, recipient) onChatted(msg, recipient, newPlayer) end) 
end 

game.Players.ChildAdded:connect(onPlayerEntered) 

-- This script must be used in the workspace otherwise it ill not work, sorry</string>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
