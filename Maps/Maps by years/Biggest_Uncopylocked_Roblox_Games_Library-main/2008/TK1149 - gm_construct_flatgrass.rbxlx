			<Item class="LocalScript" referent="RBX1137">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">LocalGUI</string>
					<string name="Source">local Tool = script.Parent
local holding = false

function onMouseDown(mouse)
	obj = mouse.Target
	if obj ~= nil then
		if obj.Name ~= &quot;Cube&quot; then return end
		if obj:findFirstChild(&quot;BodyPosition&quot;) ~= nil then return end
		if obj:GetMass() &gt; 125 then return end
		if (Tool.Parent.Torso.Position - obj.Position).magnitude &gt; 15 then return end
		if obj.Anchored == true then return end
		Tool.Obj.Value = obj
		holding = true
	end
end

function onMouseUp()
	if holding then 
		holding = not holding
	end
end

function Punt(key, m)
	key = key:lower()
	if key ~= &quot;e&quot; then return end
	Tool.CFrame.Value = m.Hit
	Tool.Punt.Value = true
	wait(0.1)
	Tool.Punt.Value = false
end

function move(m)
	if not holding then return end
	local Torso = Tool.Parent:findFirstChild(&quot;Torso&quot;)
	if Torso ~= nil then
		position = Torso.Position + ((m.Hit.p - Torso.Position).unit * 10)
		Tool.Pos.Value = position
	end
end

function onEquippedLocal(mouse)
	if mouse == nil then
		print(&quot;Mouse not found&quot;)			--checks if the mouse is there
		return 
	end
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;		--changes the cursor to a cool one. =P
	mouse.Button1Down:connect(function () onMouseDown(mouse) end)
	mouse.Button1Up:connect(onMouseUp)
	mouse.KeyDown:connect(function (k) Punt(k, mouse) end)
	mouse.Idle:connect(function () move(mouse) end)
	mouse.Move:connect(function () move(mouse) end)
end 

Tool.Equipped:connect(onEquippedLocal)</string>
