		<Item class="Script" referent="RBX335">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Regen Script</string>
				<string name="Source">model = game.Workspace.trench
messageText = &quot;Regenerating Trench...&quot;

message = Instance.new(&quot;Message&quot;)
message.Text = messageText
backup = model:clone()

wait(20)

while true do
	wait(300) -- regenerate this model every 300 seconds

	message.Parent = game.Workspace
	model:remove()

	wait(4) -- display regen message for 4 seconds

	model = backup:clone()
	model.Parent = game.Workspace
	model:makeJoints()
	message.Parent = nil
end</string>
				<bool name="archivable">true</bool>
			</Properties>
