					<Item class="Script" referent="RBX2992">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<string name="Source">--Forest Sector Log System
--by WackoMcGoose

--Tag definitions for Log System components
LogSystem = game.Workspace:findFirstChild(&quot;Forest Sector LogSystem&quot;)
ShortLog = LogSystem.ShortLog.Base.BodyPosition
MediumLog = LogSystem.MediumLog.Base.BodyPosition
TallLog = LogSystem.TallLog.Base.BodyPosition
----------------------------------------------------------
SLLower = LogSystem.ShortLog.ShortLogLowerPosition
SLUpper = LogSystem.ShortLog.ShortLogUpperPosition
MLLower = LogSystem.MediumLog.MediumLogLowerPosition
MLUpper = LogSystem.MediumLog.MediumLogUpperPosition
TLLower = LogSystem.TallLog.TallLogLowerPosition
TLUpper = LogSystem.TallLog.TallLogUpperPosition
--To set a Log&apos;s position, use LogName.position = LogName(Upper or Lower).Position
button = script.Parent

--Set logs to initial LowerPositions
ShortLog.position = SLLower.Position
MediumLog.position = MLLower.Position
TallLog.position = TLLower.Position

LogDebounce = true

function RaiseTheLogs()
	if (LogDebounce == true) then
		LogDebounce = false
		print(&quot;Raising Forest Sector logs...&quot;)
		--Raise short log
		ShortLog.position = SLUpper.Position
		wait(1)
		--Raise medium log
		MediumLog.position = MLUpper.Position
		wait(1)
		--Raise tall log
		TallLog.position = TLUpper.Position
		wait(1)
		--Keep logs raised for 30 seconds, then lower them
		wait(30)
		ShortLog.position = SLLower.Position
		MediumLog.position = MLLower.Position
		TallLog.position = TLLower.Position
		LogDebounce = true
	end
end

button.ClickDetector.MouseClick:connect(RaiseTheLogs)
</string>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
				</Item>
