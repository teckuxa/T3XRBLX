		<Item class="Script" referent="RBX3341">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Supercomputer Reboot Program</string>
				<string name="Source">overwing = game.Workspace.OverwingGroup
overwingbackup = overwing:clone()
orb = game.Workspace.TransportOrbGroup
orbbackup = orb:clone()
doors = game.Workspace.WayTowerDoors
doorsbackup = doors:clone()
overboard = game.Workspace.OverboardGroup
overboardbackup = overboard:clone()

function onChatted(msg, recipient, speaker) 
	local source = string.lower(speaker.Name) 
	msg = string.lower(msg) 
	if (msg == &quot;regen_overwing&quot;) then
		overwing:remove()
		overwing = overwingbackup:clone()
		overwing.Parent = game.Workspace
		overwing:makeJoints()
	elseif (msg == &quot;regen_overboard&quot;) then
		overboard:remove()
		overboard = overboardbackup:clone()
		overboard.Parent = game.Workspace
		overboard:makeJoints()
	elseif (msg == &quot;regen_orbs&quot;) then
		orb:remove()
		orb = orbbackup:clone()
		orb.Parent = game.Workspace
		orb:makeJoints()
	elseif (msg == &quot;regen_waytowers&quot;) then
		doors:remove()
		doors = doorsbackup:clone()
		doors.Parent = game.Workspace
		doors:makeJoints()
	end
end

function onPlayerEntered(newPlayer) 
	newPlayer.Chatted:connect(function(msg, recipient) onChatted(msg, recipient, newPlayer) end) 
end 

game.Players.ChildAdded:connect(onPlayerEntered)
