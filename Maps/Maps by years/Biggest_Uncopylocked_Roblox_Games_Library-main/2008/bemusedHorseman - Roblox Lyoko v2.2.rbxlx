										<Content name="LinkedSource"><null></null></Content>
										<string name="Name">BugFixScript</string>
										<string name="Source">while true do
if(script.Parent.Parent.Name == &quot;Torso&quot;) then
	wait(60)
	script.Parent:Remove()
end
wait(60)
end
</string>
