						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<string name="Source">TowerInterior = game.Workspace:findFirstChild(&quot;Way Tower System&quot;):findFirstChild(&quot;Ice Sector Way Tower Interior&quot;)

function EnterTower(hit)
	if (hit.Parent:findFirstChild(&quot;Torso&quot;) ~= nil) then
		hit.Parent.Torso.CFrame = TowerInterior.EntryPoint.CFrame
	end
end

script.Parent.Touched:connect(EnterTower)
</string>
						<bool name="archivable">true</bool>
