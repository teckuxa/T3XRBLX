							<Item class="Script" referent="RBX1408">
								<Properties>
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">Script</string>
									<string name="Source">--Way Tower v2 by WackoMcGoose


r = script.Parent.RocketPropulsion

debounce = true
function onTouched(part)
if part.Parent ~= nil then
	if (debounce == false) then return end
	local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if (h~=nil) and (h.Health ~= 0) then
		debounce = false
		Lyokon = part.Parent
		g = r:Clone()
		g.Parent = Lyokon.Torso
		g.MaxSpeed = 180 --How fast you want the launcher to go!
		g:fire()
		local s = Instance.new(&quot;Sparkles&quot;)
		s.Parent = Lyokon.Torso
		Lyokon.Head.CanCollide = false
		Lyokon.Torso.CanCollide = false
		Lyokon:findFirstChild(&quot;Left Leg&quot;).CanCollide = false
		Lyokon:findFirstChild(&quot;Right Leg&quot;).CanCollide = false
		g.Target = script.Parent.Parent.locationa1
		wait(1)
		g.Target = script.Parent.Parent.locationa2
		wait(1)
		g.Target = script.Parent.Parent.locationa3
		wait(4)
		g.Target = script.Parent.Parent.locationa4
		wait(3)
		g.Target = script.Parent.Parent.locationa5
		wait(1)
		--------------
		wait(1) --THIS IS HOW MUCH TIME YOU WILL WAIT UNTIL THE LAUNCHER&apos;S FORCE STOPS WORKING ON YOU. CHANGE &quot;1&quot;.
		g:Remove()
		s:Remove()
		h.Parent.Head.CanCollide = true
		h.Parent.Torso.CanCollide = true
		h.Parent:findFirstChild(&quot;Left Leg&quot;).CanCollide = true
		h.Parent:findFirstChild(&quot;Right Leg&quot;).CanCollide = true
		debounce = true
		end
	end
end

script.Parent.Touched:connect(onTouched)</string>
									<bool name="archivable">true</bool>
