					<Item class="Script" referent="RBX2019">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Move</string>
							<string name="Source">--Moving Platform Script by WackoMcGoose

--Time is how many seconds the platform will wait. Edit it below.
time = 2.25

while true do
--For this to work, there must be two bricks named Location1 and Location2 in the same model as MovingPlatform.
--Location1 and Location2 must be Anchored, Transparent = 1, and not CanCollidable
script.Parent.BodyPosition.position = script.Parent.Parent.Location1.Position
wait(time)
script.Parent.BodyPosition.position = script.Parent.Parent.Location2.Position
wait(time)
end </string>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
				</Item>
