			<Item class="Script" referent="RBX1079">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">RegenScript</string>
					<string name="Source">model = script.Parent
backup = model:Clone()

if (model ~= game.Workspace) then
	while true do
		wait(300) --Regens every 5 minutes
		model:remove()
		model = backup:Clone()
		model.Parent = game.Workspace
		model:MakeJoints()
	end
end
</string>
