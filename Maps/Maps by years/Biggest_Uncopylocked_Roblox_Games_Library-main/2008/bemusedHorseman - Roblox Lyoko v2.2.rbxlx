							<string name="Name">TimerButtonScript</string>
							<string name="Source">button = script.Parent
OtherButton = button.Parent.Parent:findFirstChild(&quot;Open Door&quot;)

debounce = true
--Variable definitions for Timer function
SecondsLeft = 30
CentisecondsLeft = 0

function UpdateTimer()
	Hint.Text = &quot;Sector Five Door Countdown: 0:00:&quot;.. SecondsLeft .. &quot;.&quot;.. CentisecondsLeft ..&quot;&quot;.. math.random(0, 9) ..&quot;&quot;
end

function onClicked()
	if (debounce == false) then return end
	debounce = false
	OtherButton.Parent = nil
	print(&quot;Timer Button Clicked&quot;)
	button.Parent.Parent.Door.CanCollide = false
	button.Parent.Parent.Door.Transparency = 0.5
	Hint = Instance.new(&quot;Hint&quot;)
	Hint.Parent = game.Workspace
	print(&quot;Entering Timer loop&quot;)
	for s=1, 30 do --Loop to decrement seconds
		SecondsLeft = SecondsLeft - 1
		CentisecondsLeft = 9
		for m=1, 9 do
			CentisecondsLeft = CentisecondsLeft - 1
			wait(0.1)
			UpdateTimer()
		end
	end
	print(&quot;Finished countdown&quot;)
	wait(1)
	--Reset door and countdown mechanism
	button.Parent.Parent.Door.CanCollide = true
	button.Parent.Parent.Door.Transparency = 0.1
	Hint:Remove()
	SecondsLeft = 30
	CentisecondsLeft = 0
	debounce = true
	OtherButton.Parent = button.Parent.Parent
end

button.ClickDetector.MouseClick:connect(onClicked)
