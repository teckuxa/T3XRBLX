				<Item class="Script" referent="RBX620">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<string name="Source">TowerInterior = game.Workspace:findFirstChild(&quot;Way Tower System&quot;):findFirstChild(&quot;Forest Sector Way Tower Interior&quot;)

function EnterTower(hit)
	if (hit.Parent:findFirstChild(&quot;Torso&quot;) ~= nil) then
		hit.Parent.Torso.CFrame = TowerInterior.EntryPoint.CFrame
	end
end

script.Parent.Touched:connect(EnterTower)
</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX621">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<string name="Source">LifePointBoost = 100

function RegenerateLifePoints(hit)
	if (hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil) then
		hit.Parent.Humanoid.Health = hit.Parent.Humanoid.Health + LifePointBoost
	end
end

script.Parent.Touched:connect(RegenerateLifePoints)</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
