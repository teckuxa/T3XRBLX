					<Item class="Script" referent="RBX3270">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<string name="Source">--Transport Orb v1 by WackoMcGoose


r = script.Parent.RocketPropulsion

debounce = true
function onTouched(part)
if part.Parent ~= nil then
	if (debounce == false) then return end
	debounce = false
	local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if (h~=nil) and (h.Health ~= 0) then
		Lyokon = part.Parent
		script.Parent.Transparency = 0.25	
		g = r:Clone()
		g.Parent = Lyokon.Torso
		g.MaxSpeed = 180
		g:fire()
		local s = Instance.new(&quot;Sparkles&quot;)
		s.Parent = Lyokon.Torso
		Lyokon.Head.CanCollide = false
		Lyokon.Torso.CanCollide = false
		Lyokon:findFirstChild(&quot;Left Leg&quot;).CanCollide = false
		Lyokon:findFirstChild(&quot;Right Leg&quot;).CanCollide = false
		g.Target = script.Parent.Parent.locationa1
	end
end
end

function onTouchedLocationa1(part)
	g.Target = script.Parent.Parent.locationa2
	script.Parent.Transparency = 0
	debounce = true
end

function onTouchedLocationa2(part)
	g.Target = script.Parent.Parent.locationa3
end

function onTouchedLocationa3(part)
	g.Target = script.Parent.Parent.locationa4
end

function onTouchedLocationa4(part)
	g.Target = script.Parent.Parent.locationa5
end

function onTouchedLocationa5(part)
	g.Target = script.Parent.Parent.locationa6
end

function onTouchedLocationa6(part)
	Lyokon.Torso.CFrame = script.Parent.Parent.locationa7.CFrame
	g.Target = script.Parent.Parent.locationa8
end

function onTouchedLocationa8(part)
	Lyokon.Torso.CFrame = script.Parent.Parent.locationa9.CFrame
	g.Target = script.Parent.Parent.locationa10
end

function onTouchedLocationa10(part)
	Lyokon.Torso.CFrame = script.Parent.Parent.locationa11.CFrame
	g.Target = script.Parent.Parent.locationa12
	wait(2)
	g:Remove()
	s:Remove()
	h.Parent.Head.CanCollide = true
	h.Parent.Torso.CanCollide = true
	h.Parent:findFirstChild(&quot;Left Leg&quot;).CanCollide = true
	h.Parent:findFirstChild(&quot;Right Leg&quot;).CanCollide = true
	debounce = true
end

script.Parent.Touched:connect(onTouched)
script.Parent.Parent.locationa1.Touched:connect(onTouchedLocationa1)
script.Parent.Parent.locationa2.Touched:connect(onTouchedLocationa2)
script.Parent.Parent.locationa3.Touched:connect(onTouchedLocationa3)
script.Parent.Parent.locationa4.Touched:connect(onTouchedLocationa4)
script.Parent.Parent.locationa5.Touched:connect(onTouchedLocationa5)
script.Parent.Parent.locationa6.Touched:connect(onTouchedLocationa6)
script.Parent.Parent.locationa8.Touched:connect(onTouchedLocationa8)
script.Parent.Parent.locationa10.Touched:connect(onTouchedLocationa10)
</string>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
				</Item>
