						<Item class="Script" referent="RBX1287">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">RegenScript</string>
								<string name="Source">model1 = script.Parent.locationa1
backup = model1:Clone()

if (model1 ~= game.Workspace) then
	while true do
		wait(300) --Regens every 5 minutes
		model1:Remove()
		model2 = backup:Clone()
		model2.Parent = script.Parent
		model2:MakeJoints()
	end
end
</string>
								<bool name="archivable">true</bool>
							</Properties>
