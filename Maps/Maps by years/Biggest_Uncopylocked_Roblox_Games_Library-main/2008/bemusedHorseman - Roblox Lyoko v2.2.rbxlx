						<string name="Source">TowerGlow = script.Parent

while true do
	--Alternate transparencies for tower&apos;s glow
	TowerGlow.Transparency = 0.75
	wait(.5)
	TowerGlow.Transparency = 0.5
	wait(.5)
end</string>
