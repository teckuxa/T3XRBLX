		<Item class="HopperBin" referent="RBX3694">
			<Properties>
				<token name="BinType">0</token>
				<string name="Name">Devirtualize</string>
				<Content name="TextureId"><null></null></Content>
				<bool name="archivable">true</bool>
			</Properties>
			<Item class="Script" referent="RBX3695">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Devirtualize Tool Script</string>
					<string name="Source">--Devirtualize Tool Script v2.6
--by WackoMcGoose for Roblox Lyoko

function DevirtualizeMe(mouse)
	--Gets the tool&apos;s backpack&apos;s parent&apos;s body
	local Lyokon = game.Workspace:findFirstChild(script.Parent.Parent.Parent.Name)
	--If using a Launch Star or similar object, don&apos;t devirtualize or the object will break!
	if (Lyokon:findFirstChild(&quot;Head&quot;):findFirstChild(&quot;RocketPropulsion&quot;) ~= nil or Lyokon:findFirstChild(&quot;Torso&quot;):findFirstChild(&quot;RocketPropulsion&quot;) ~= nil) then return end
	--Put Sparkle objects in all the body parts.
	Sparkly = Instance.new(&quot;Sparkles&quot;)
	Sparkly.Parent = Lyokon:findFirstChild(&quot;Head&quot;)
	Sparkly:Clone().Parent = Lyokon:findFirstChild(&quot;Torso&quot;)
	Sparkly:Clone().Parent = Lyokon:findFirstChild(&quot;Left Arm&quot;)
	Sparkly:Clone().Parent = Lyokon:findFirstChild(&quot;Right Arm&quot;)
	Sparkly:Clone().Parent = Lyokon:findFirstChild(&quot;Left Leg&quot;)
	Sparkly:Clone().Parent = Lyokon:findFirstChild(&quot;Right Leg&quot;)
	--=================================
	--Now start devirtualizing...
	Lyokon.Humanoid.Health = 0 --VERY important, because part-removal devirtualization traps the player!
	Lyokon:findFirstChild(&quot;Left Arm&quot;).CanCollide = true
	Lyokon:findFirstChild(&quot;Right Arm&quot;).CanCollide = true
	Lyokon:findFirstChild(&quot;Torso&quot;).Velocity = Lyokon:findFirstChild(&quot;Torso&quot;).CFrame.lookVector * 10
	wait(.5)
	--=================================
	Lyokon:findFirstChild(&quot;Head&quot;).Transparency = 0.989
	Lyokon:findFirstChild(&quot;Torso&quot;).Transparency = 0.989
	Lyokon:findFirstChild(&quot;Left Arm&quot;).Transparency = 0.989
	Lyokon:findFirstChild(&quot;Right Arm&quot;).Transparency = 0.989
	Lyokon:findFirstChild(&quot;Left Leg&quot;).Transparency = 0.989
	Lyokon:findFirstChild(&quot;Right Leg&quot;).Transparency = 0.989
	wait(.25)
	Lyokon:findFirstChild(&quot;Head&quot;):findFirstChild(&quot;face&quot;):Remove()
	Lyokon:findFirstChild(&quot;Torso&quot;):findFirstChild(&quot;roblox&quot;):Remove()
	for i=1, 5 do
		Lyokon:findFirstChild(&quot;Head&quot;).Reflectance = 1
		Lyokon:findFirstChild(&quot;Torso&quot;).Reflectance = 1
		Lyokon:findFirstChild(&quot;Left Arm&quot;).Reflectance = 1
		Lyokon:findFirstChild(&quot;Right Arm&quot;).Reflectance = 1
		Lyokon:findFirstChild(&quot;Left Leg&quot;).Reflectance = 1
		Lyokon:findFirstChild(&quot;Right Leg&quot;).Reflectance = 1
		wait(.05)
		Lyokon:findFirstChild(&quot;Head&quot;).Reflectance = 0
		Lyokon:findFirstChild(&quot;Torso&quot;).Reflectance = 0
		Lyokon:findFirstChild(&quot;Left Arm&quot;).Reflectance = 0
		Lyokon:findFirstChild(&quot;Right Arm&quot;).Reflectance = 0
		Lyokon:findFirstChild(&quot;Left Leg&quot;).Reflectance = 0
		Lyokon:findFirstChild(&quot;Right Leg&quot;).Reflectance = 0
		wait(.05)
	end
	Lyokon:findFirstChild(&quot;Head&quot;).Anchored = true
	Lyokon:findFirstChild(&quot;Torso&quot;).Anchored = true
	Lyokon:findFirstChild(&quot;Left Arm&quot;).Anchored = true
	Lyokon:findFirstChild(&quot;Right Arm&quot;).Anchored = true
	Lyokon:findFirstChild(&quot;Left Leg&quot;).Anchored = true
	Lyokon:findFirstChild(&quot;Right Leg&quot;).Anchored = true
end

function ToolSelected(mouse)
	mouse.Button1Down:connect(DevirtualizeMe)
end

script.Parent.Selected:connect(ToolSelected)
