						<string name="Source">WayTower = game.Workspace:findFirstChild(&quot;Desert Way Tower&quot;)

function ExitTower(hit)
	if (hit == nil) then return end
	if (hit.Parent:findFirstChild(&quot;Torso&quot;) ~= nil) then
		hit.Parent.Torso.CFrame = WayTower.ExitPoint.CFrame
		game.Players:findFirstChild(hit.Parent.Name).TeamColor = BrickColor.new(5)
	end
end

script.Parent.Touched:connect(ExitTower)
