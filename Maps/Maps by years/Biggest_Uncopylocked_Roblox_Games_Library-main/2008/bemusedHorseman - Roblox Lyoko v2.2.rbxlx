				<Item class="Script" referent="RBX3027">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<string name="Source">LifePointBoost = 10

function RegenerateLifePoints(hit)
	if (hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil) then
		hit.Parent.Humanoid.Health = hit.Parent.Humanoid.Health + LifePointBoost
	end
end

script.Parent.Touched:connect(RegenerateLifePoints)</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
