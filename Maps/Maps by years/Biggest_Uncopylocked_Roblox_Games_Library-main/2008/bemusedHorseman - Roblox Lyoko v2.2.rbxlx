					<string name="Name">Digital Sea Script</string>
					<string name="Source">function Devirtualize(part)
	if (part.Parent.className == &quot;Model&quot;) then part.Parent:BreakJoints() end
	part:BreakJoints()
	part.Anchored = true
	part.CanCollide = false
	Instance.new(&quot;Sparkles&quot;).Parent = part
	Instance.new(&quot;ForceField&quot;).Parent = part
	for i=1, 10 do
		part.Transparency = part.Transparency + 0.1
		wait(0.1)
	end
	part:Remove()
end
