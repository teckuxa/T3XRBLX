			<Item class="HopperBin" referent="RBX2019">
				<Properties>
					<bool name="Active">false</bool>
					<token name="BinType">0</token>
					<string name="Name">Donate</string>
					<Content name="TextureId"><null></null></Content>
					<bool name="archivable">true</bool>
				</Properties>
				<Item class="Script" referent="RBX2020">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">local pl = script.Parent.Parent.Parent

Amount = 1

Amounts = {1, 5, 25, 100, 250, 1000, 5000}

Keys = {&quot;Z&quot;, &quot;X&quot;, &quot;C&quot;, &quot;V&quot;, &quot;B&quot;, &quot;N&quot;, &quot;M&quot;}

AllKey = &quot;Q&quot;

function ShowHint(text)
	local h = Instance.new(&quot;Hint&quot;)
	h.Text = text
	h.Parent = pl
	game:GetService(&quot;Debris&quot;):AddItem(h, 3.5)
end

function KeyPress(Key)
	Key = string.upper(Key)
	for i = 1, #Keys do
		if Keys[i] == Key then
			Amount = Amounts[i]
			ShowHint(&quot;Donating &quot;.. tostring(Amount).. &quot; points&quot;)
		end
	end
	if Key == AllKey then
		Amount = math.huge
		ShowHint(&quot;Donating maximum points&quot;)
	end
end

function click(m)
	print(&quot;C&quot;)
	local p = m.Target
	if p == nil then return end
	print(&quot;H&quot;)
	local tpl = game.Players:playerFromCharacter(p.Parent)
	if tpl == nil then return end
	print(&quot;F&quot;)
	local am = pl.leaderstats.Points.Value - Amount
	if am &lt; 0 then
		print(&quot;D&quot;)
		tpl.leaderstats.Points.Value = tpl.leaderstats.Points.Value + pl.leaderstats.Points.Value
		ShowHint(&quot;Donated &quot;.. tostring(pl.leaderstats.Points.Value).. &quot; to &quot;.. tpl.Name)
		pl.leaderstats.Points.Value = 0
		print(&quot;0&quot;)
	else
		print(&quot;F&quot;)
		tpl.leaderstats.Points.Value = tpl.leaderstats.Points.Value + Amount
		pl.leaderstats.Points.Value = pl.leaderstats.Points.Value - Amount
		ShowHint(&quot;Donated &quot;.. tostring(Amount).. &quot; to &quot;.. tpl.Name)
		print(&quot;0&quot;)
	end
end

function selected(mouse)
	print(&quot;S&quot;)
	ShowHint(&quot;Z, X, C, V, B, N, M to donate amounts, Q to donate all&quot;)
	print(&quot;GH&quot;)
	mouse.KeyDown:connect(KeyPress)
	print(&quot;CK&quot;)
	mouse.Button1Down:connect(function() print(&quot;B1D&quot;) click(mouse) print(&quot;D1B&quot;) end)
	print(&quot;CM&quot;)
	mouse.Icon = &quot;rbxasset://Textures\\GunCursor.png&quot;
	print(&quot;DN&quot;)
end

script.Parent.Selected:connect(selected)

print(&quot;L&quot;)</ProtectedString>
