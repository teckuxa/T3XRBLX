					</Properties>
					<Item class="Script" referent="RBX1791">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">teleports = script.Parent.Ports:GetChildren()

function tagmodel(mod)
local a = Instance.new(&quot;BoolValue&quot;)
a.Name = &quot;TeleportDebounce&quot;
a.Value = true
a.Parent = mod
game.Debris:AddItem(a, 6)
end

function touch(toucher, port)
if toucher.Parent == nil then return end
local human = toucher.Parent:findFirstChild(&quot;Humanoid&quot;)
if human == nil then return end
if human.Health &lt;= 0 then return end
local torso = toucher.Parent:findFirstChild(&quot;Torso&quot;)
if torso == nil then return end
if torso:findFirstChild(&quot;TeleportDebounce&quot;) ~= nil then return end
tagmodel(torso)
local targetport = teleports[math.random(1, #teleports)]
while true do
if targetport ~= port then break end
targetport = teleports[math.random(1, #teleports)]
end
torso.CFrame = CFrame.new(targetport.Position + Vector3.new(0,3,0))
end

if #teleports &gt; 1 then
for i = 1, #teleports do
teleports[i].Touched:connect(function(hit)
touch(hit,teleports[i])
end)
end
else
print(&quot;Not enough Teleports!&quot;)
end
</ProtectedString>
							<bool name="archivable">true</bool>
