					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Rules</string>
						<ProtectedString name="Source">GameHint = shared.GameHint
Finished = shared.Finished

winnings = 0

t = Instance.new(&quot;Team&quot;)
t.Name = &quot;Blockers&quot;
t.AutoAssignable = false
t.TeamColor = BrickColor.new(24)
t.Parent = game.Teams

local pls = game.Players:GetPlayers()

squares = {}

--[[for x = 1, 20 do
	for z = 1, 20 do
		local sq = Instance.new(&quot;Part&quot;)
		sq.Size = Vector3.new(8,1.2,8)
		sq.Name = &quot;Square&quot;
		sq.BrickColor = BrickColor.random()
		sq.Position = Vector3.new(-x * 8 + 220, 120, z * 8 - 80)
		sq.Anchored = true
		local d = Instance.new(&quot;Decal&quot;)
		d.Face = &quot;Top&quot;
		d.Parent = sq
		local v = nil
		local db = false
		table.insert(squares, sq.Position + Vector3.new(0,5,0))
		sq.Touched:connect(function(hit)
			print(&quot;HIT: &quot;.. math.random(1, 100000000))
			if hit.Parent == nil then return end
			local pl = game.Players:playerFromCharacter(hit.Parent)
			if pl == nil then return end
			if v == nil then
				local human = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
				if human ~= nil then
					if human.Health &gt; 0 then
						d.Texture = &quot;http://www.roblox.com/Thumbs/Avatar.ashx?x=100&amp;y=100&amp;Format=Png&amp;username=&quot;.. pl.Name
						v = pl
						human.Health = human.MaxHealth
					end
				end
			else
				if v == pl or db then return end
				db = true
				sq.Transparency = 0.6
				sq.CanCollide = false
				wait(1)
				db = false
				sq.Transparency = 0
				sq.CanCollide = true
			end
		end)
		sq.Parent = script.Parent
	end
end --]]

local sqs = script.Parent.Squares:GetChildren()
for i = 1, #sqs do
	table.insert(squares, sqs[i].Position + Vector3.new(0,5,0))
	sqs[i].BrickColor = BrickColor.random()
	local v = nil
	local d = sqs[i].Decal
	sqs[i].Touched:connect(function(hit)
		if hit.Parent == nil then return end
		local pl = game.Players:playerFromCharacter(hit.Parent)
		if pl == nil then return end
		if v == nil then
			local human = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
			if human ~= nil then
				if human.Health &gt; 0 then
					d.Texture = &quot;http://www.roblox.com/Thumbs/Avatar.ashx?x=100&amp;y=100&amp;Format=Png&amp;username=&quot;.. pl.Name
					v = pl
					human.Health = human.MaxHealth
				end
			end
		else
			if v == pl or db then return end
			hit.Parent:BreakJoints()
			db = true
			sqs[i].Transparency = 0.6
			sqs[i].CanCollide = false
			wait(1)
			db = false
			sqs[i].Transparency = 0
			sqs[i].CanCollide = true
		end
	end)
end

for i = 1, #pls do
	if pls[i].Playing.Value == true then
		winnings = winnings + 1
		pls[i].TeamColor = BrickColor.new(24)
		local x = math.random(1, #squares)
		pls[i].Character.Torso.CFrame = CFrame.new(squares[x])
		table.remove(squares, x)
		local hum = pls[i].Character.Humanoid
		pls[i].Character.Humanoid.Died:connect(function()
			for j = 1, #pls do
				if pls[j].Playing.Value == true then
					pls[j].leaderstats.Points.Value = pls[j].leaderstats.Points.Value + 3
				end
			end
		end)
		coroutine.resume(coroutine.create(function()
			while true do
				wait(0.024)
				if Finished.Value == false and hum.Name == &quot;Humanoid&quot; then
					hum:TakeDamage(1)
				end
			end
		end))
	end
end

winnings = winnings * winnings

GameHint.Text = &quot;Capture squares by stepping on them, be careful not to step on others squares!&quot;

wait(5)

GameHint.Text = &quot;A New game will begin shortly...&quot;

winner = false

local timeleft = 120

while true do
	winner = false
	if timeleft &lt;= 0 then
		break
	end
	for i = 1, #pls do
		if pls[i].Playing.Value == true and pls[i].Parent ~= nil then
			if winner == false then
				winner = pls[i]
			elseif winner ~= nil then
				winner = nil
			end
		end
	end
	if winner ~= nil then
		break
	end
	timeleft = timeleft - wait()
end

if winner ~= false then
	GameHint.Text = winner.Name.. &quot; wins the game and &quot;.. winnings.. &quot; points!&quot;
	for i = 1, winnings do
		winner.leaderstats.Points.Value = winner.leaderstats.Points.Value + 1
		wait(0.1)
	end
else
	if math.random(1, 2) == 2 then
		GameHint.Text = &quot;Nobody won, but I&apos;m feeling kind, so you can all have 3 points each!&quot;
		for i = 1, #pls do
			for p = 1, 3 do
				pls[i].leaderstats.Points.Value = pls[i].leaderstats.Points.Value + 1
				wait(0.1)
			end
		end
	else
		GameHint.Text = &quot;Nobody won, how boring.&quot;
	end
end

wait(5)

t:Remove()

Finished.Value = true
