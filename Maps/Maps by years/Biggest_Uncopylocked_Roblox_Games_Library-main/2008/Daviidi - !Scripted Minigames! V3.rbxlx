			<Ref name="PrimaryPart">null</Ref>
			<bool name="archivable">true</bool>
		</Properties>
		<Item class="Model" referent="RBX2">
			<Properties>
				<CoordinateFrame name="ModelInPrimary">
					<X>0</X>
					<Y>0</Y>
					<Z>0</Z>
					<R00>1</R00>
					<R01>0</R01>
					<R02>0</R02>
					<R10>0</R10>
					<R11>1</R11>
					<R12>0</R12>
					<R20>0</R20>
					<R21>0</R21>
					<R22>1</R22>
				</CoordinateFrame>
				<string name="Name">Minigaming</string>
				<Ref name="PrimaryPart">null</Ref>
				<bool name="archivable">true</bool>
			</Properties>
			<Item class="Script" referent="RBX3">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">MinigameScript</string>
					<ProtectedString name="Source">gamemod = game.Lighting.Minigames
games = gamemod:GetChildren()
reelgames = gamemod:GetChildren()
shared[&quot;GameHint&quot;] = Instance.new(&quot;Hint&quot;)
GameHint = shared[&quot;GameHint&quot;]
GameHint.archivable = false
GameHint.Name = &quot;MinigameHint&quot;
GameHint.Text = &quot;Minigames Loading, Please wait...&quot;
GameHint.Parent = game.Workspace
waitroom = script.Parent.Lobby
shared[&quot;CurrentGame&quot;] = nil
shared[&quot;Finished&quot;] = Instance.new(&quot;BoolValue&quot;)
shared.Finished.Name = &quot;Done&quot;
RequiredPlayers = 2

if game:findFirstChild(&quot;NetworkServer&quot;) == nil then RequiredPlayers = 1 end

function waitforend()
while true do
shared.Finished.Changed:wait()
if shared.Finished.Value == true then
shared.Finished.Value = false
break
end
end
end

function rungame(minigame)
shared.Finished.Value = false
local pls = game.Players:GetPlayers()
for i = 1, #pls do
	if pls[i].Character ~= nil then
		if pls[i].Character:findFirstChild(&quot;Humanoid&quot;) ~= nil and pls[i].Character:findFirstChild(&quot;Torso&quot;) ~= nil then
			if pls[i].Character.Humanoid.Health &gt; 0 then
				pls[i].Playing.Value = true
			end
		end
	end
end
shared[&quot;CurrentGame&quot;] = minigame:Clone()
local rules = shared[&quot;CurrentGame&quot;].Rules
rules.Parent = nil
shared[&quot;CurrentGame&quot;].Parent = game.Workspace
shared[&quot;CurrentGame&quot;]:MakeJoints()

wait(2)

rules.Disabled = false

rules.Parent = shared[&quot;CurrentGame&quot;]

waitforend()
endgame()
end

function endgame()
	shared[&quot;CurrentGame&quot;]:Remove()
	shared[&quot;CurrentGame&quot;] = nil
	GameHint.Text = &quot;&quot;
	local pls = game.Players:GetPlayers()
	for i = 1, #pls do
		if pls[i].Playing.Value == true then
			pls[i].Playing.Value = false
			if pls[i].Character ~= nil then
				pls[i].Character:MoveTo(waitroom.Base.Position + Vector3.new(math.random(-10,10),3,math.random(-10,10)))
				if pls[i].Character:findFirstChild(&quot;Humanoid&quot;) ~= nil then
					pls[i].Character.Humanoid.Health = pls[i].Character.Humanoid.MaxHealth
				end
				local st = pls[i].Character:GetChildren()
				for i = 1, #st do
					if st[i].className == &quot;Tool&quot; then st[i]:Remove() end
				end
			end
		end
		local bpack = pls[i].Backpack
		if bpack ~= nil then
			local bpt = bpack:GetChildren()
			for i = 1, #bpt do
				if bpt[i].className == &quot;Tool&quot; then bpt[i]:Remove() end
			end
		end
		pls[i].TeamColor = BrickColor.new(1)
	end
	local te = game.Teams:GetTeams()
	for i = 1, #te do
		if te[i].Name ~= &quot;Players&quot; then
			te[i]:Remove()
		end
	end
end

function choosegame()
local i = 0
GameHint.Text = &quot;Now Selecting Minigame...&quot;
wait(5)
for somethingodd = 1, math.random(50,60) do
i = math.random(1, #games)
GameHint.Text = (i.. &quot;: &quot;.. games[i].Name)
wait(.1)
end
i = math.random(1, #reelgames)
GameHint.Text = (&quot;Selected: &quot;.. i.. &quot;: &quot;.. reelgames[i].Name)
wait(5)
GameHint.Text = &quot;Loading &quot;.. reelgames[i].Name.. &quot;...&quot;
rungame(reelgames[i])
table.remove(reelgames,i)
end

function rungameloop()
while true do
local imbr = false
if #game.Players:GetPlayers() &gt;= RequiredPlayers then
local pls = game.Players:GetPlayers()
for i = 1, #pls do
if pls[i].Character == nil then
while true do
GameHint.Text = &quot;Waiting for &quot;.. pls[i].Name.. &quot; to load character.&quot;
pls[i].Changed:wait()
if pls[i].Character ~= nil or pls[i].Parent == nil then break end
end
end
end
if #game.Players:GetPlayers() &gt;= RequiredPlayers then -- Final check
if #reelgames &lt; 1 then reelgames = gamemod:GetChildren() end
choosegame()
end
else
GameHint.Text = &quot;The game needs at least &quot;.. RequiredPlayers.. &quot; players to start.&quot;
local m = Instance.new(&quot;Message&quot;)
m.Text = &quot;Want someone to play these minigames with? Try inviting some friends of yours to come and play with you!&quot;
if #game.Players:GetPlayers() &gt; 0 then m.Parent = workspace end
game.Players.PlayerAdded:wait()
m:Remove()
end
end
end

function die(player)
player.Playing.Value = false
player.TeamColor = BrickColor.new(1)
end

function respawn(player)
if player.Character == nil then return end
if player.Character:findFirstChild(&quot;Humanoid&quot;) == nil then return end
player.Character.Humanoid.Died:connect(function() die(player) end)
end

function newplayer(pl)
local playing = Instance.new(&quot;BoolValue&quot;)
playing.Name = &quot;Playing&quot;
playing.Value = false
playing.Parent = pl
local stats = Instance.new(&quot;IntValue&quot;)
stats.Name = &quot;leaderstats&quot;
local points = Instance.new(&quot;IntValue&quot;)
points.Name = &quot;Points&quot;
points.Parent = stats
stats.Parent = pl
pl.Changed:connect(function(property) if property == &quot;Character&quot; then respawn(pl) end end)
end

game.Players.PlayerAdded:connect(newplayer)

rungameloop()
