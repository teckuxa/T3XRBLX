		r.Position = script.Parent.Position + Vector3.new(0, i - (script.Parent.Size.y / 2), 0)
		r.Parent = workspace
		game:service(&quot;Debris&quot;):AddItem(r, math.random(50, 150)/10)
	end
	script.Parent:Remove()
end

