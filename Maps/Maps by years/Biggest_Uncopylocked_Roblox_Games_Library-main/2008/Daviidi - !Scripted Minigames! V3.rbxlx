			<Item class="Script" referent="RBX2706">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Rules</string>
					<ProtectedString name="Source">GameHint = shared.GameHint
Finished = shared.Finished

local slowtime = 240

local t = Instance.new(&quot;Team&quot;)
t.AutoAssignable = false
t.Name = &quot;Drivers&quot;
t.TeamColor = BrickColor.new(24)
t.Parent = game.Teams

local cars = script.Parent.Cars:GetChildren()

GameHint.Text = &quot;Get in a car, and drive the circuit to the VERY END!&quot;
wait(3.5)
local ncars = {}

for i = 1, #cars do
	local x = cars[i]:GetChildren()
	for j = 1, #x do
		x[j].Anchored = false
		x[j].Velocity = Vector3.new()
		x[j].RotVelocity = Vector3.new()
	end
end

wait(1.5)

local g = game.Players:GetPlayers()

function getseat(torso)
	for i = 1, #ncars do
		if ncars[i]:findFirstChild(&quot;VehicleSeat&quot;) ~= nil then
			if ncars[i].VehicleSeat:findFirstChild(&quot;SeatWeld&quot;) ~= nil then
				if ncars[i].VehicleSeat.SeatWeld.Part1 == torso or ncars[i].VehicleSeat.SeatWeld.Part0 == torso then
					return ncars[i].VehicleSeat
				end
			end
		end
	end
	return nil
end

for i = 1, #g do
	if g[i].Playing.Value == true and g[i].Character ~= nil then
		local t = g[i].Character:findFirstChild(&quot;Torso&quot;)
		if t ~= nil then
			g.TeamColor = BrickColor.new(24)
			local carn = math.random(1, #cars)
			local car = cars[carn]
			car.VehicleSeat.MaxSpeed = 0
			table.remove(cars, carn)
			table.insert(ncars, car)
			t.CFrame = CFrame.new(car.VehicleSeat.Position + Vector3.new(0,2,0))
		end
	end
end

GameHint.Text = &quot;Tap forward twice quickly to turbo boost!&quot;

wait(5)

for i = 5, 1, -1 do
	GameHint.Text = &quot;Starting in &quot;.. i
	wait(1)
end

GameHint.Text = &quot;DRIVE!!!&quot;

for i = 1, #cars do
	cars[i]:Remove()
end

for i = 1, #ncars do
	ncars[i].VehicleSeat.MaxSpeed = 50
end

cars = nil

local winner = nil

wait(4)

GameHint.Text = &quot;A new game will begin shortly&quot;

local con = script.Parent.DrivingFinish.FinishCon.Touched:connect(function(p)
	if p.Parent == nil then return end
	if p.Parent:findFirstChild(&quot;Humanoid&quot;) == nil then return end
	if p.Parent.Humanoid.Health &lt;= 0 then return end
	local torso = p.Parent:findFirstChild(&quot;Torso&quot;)
	if torso == nil then return end
	if getseat(torso) == nil then return end
	local pl = game.Players:GetPlayerFromCharacter(p.Parent)
	if pl == nil or winner ~= nil then return end
	winner = pl
end)

local mt = slowtime

while true do
	local pln = game.Players:GetPlayers()
	local stillrun = false
	for i = 1, #pln do
		if pln[i].Playing.Value == true then
			stillrun = true
		end
	end
	if not stillrun then
		break
	end
	mt = mt - wait()
	if winner ~= nil or mt &lt;= 0 or #game.Players:GetPlayers() &lt; 1 then
		break
	end
end

con:disconnect()

mt = math.floor((slowtime - mt)*10)/10

if winner == nil then
	GameHint.Text = &quot;There was no winner.&quot;
	wait(5)
else
	GameHint.Text = winner.Name.. &quot; made it to the end in &quot;.. mt.. &quot; Seconds!&quot;
	wait(5)
	local winnings = math.ceil(slowtime - mt)/3 + #g - 1
	GameHint.Text = winner.Name.. &quot; wins &quot;.. winnings.. &quot; points!&quot;
	wait(2)
	for i = 1, #winnings do
		winner.leaderstats.Points.Value = winner.leaderstats.Points.Value + 1
		wait()
	end
	wait(2)
end

t:Remove()

Finished.Value = true
</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="Model" referent="RBX2707">
				<Properties>
					<CoordinateFrame name="ModelInPrimary">
						<X>0</X>
