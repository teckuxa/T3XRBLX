function Click()
	if u == true then return end
	u = true
	local x = Instance.new(&quot;Explosion&quot;)
	x.BlastPressure = 2000000
	x.Position = script.Parent.Parent.Parent.Character.Head.Position
	x.Hit:connect(function(part)
		if part.Parent == nil or part.Parent == script.Parent.Parent.Parent.Character then return end
		if part.Parent:findFirstChild(&quot;Humanoid&quot;) == nil then return end
		local t = Instance.new(&quot;ObjectValue&quot;)
		t.Name = &quot;creator&quot;
		t.Value = script.Parent.Parent.Parent
		t.Parent = part.Parent.Humanoid
		game:GetService(&quot;Debris&quot;):AddItem(t, 0.5)
	end)
	x.Parent = workspace
end

