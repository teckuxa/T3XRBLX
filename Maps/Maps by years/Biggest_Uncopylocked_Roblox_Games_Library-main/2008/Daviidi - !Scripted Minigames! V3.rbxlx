				<Item class="Script" referent="RBX204">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Rules</string>
						<ProtectedString name="Source">GameHint = shared.GameHint
Finished = shared.Finished

wep = game.Lighting.Tools.Sword

function death(deadhuman, deadplayer)
deadplayer.TeamColor = BrickColor.new(1)
local creator = deadhuman:findFirstChild(&quot;creator&quot;)
if creator == nil then return end
if creator.Value == nil then return end
local stats = creator.Value:findFirstChild(&quot;leaderstats&quot;)
if stats == nil then return end
local points = stats:findFirstChild(&quot;Points&quot;)
if points == nil then return end
points.Value = points.Value + 8
end

tblues = {}
treds = {}

local pls = game.Players:GetPlayers()
local tno = 1
for i = 1, #pls do
if pls[i].Playing.Value == true then
if pls[i].Character ~= nil then
pls[i].Character.Humanoid.Died:connect(function() death(pls[i].Character.Humanoid, pls[i]) end)
wep:Clone().Parent = pls[i]:findFirstChild(&quot;Backpack&quot;)
if tno == 1 then
pls[i].TeamColor = BrickColor.new(21) -- Bright red
table.insert(treds, pls[i])
pls[i].Character:MoveTo(script.Parent.RedSpawn.Position + Vector3.new(math.random(-10,10),5,math.random(-10,10)))
tno = 2
else
pls[i].TeamColor = BrickColor.new(23) -- Bright blue
table.insert(tblues, pls[i])
pls[i].Character:MoveTo(script.Parent.BlueSpawn.Position + Vector3.new(math.random(-10,10),5,math.random(-10,10)))
tno = 1
end
end
end
end

local t = Instance.new(&quot;Team&quot;)
t.AutoAssignable = false
t.Name = &quot;Red&quot;
t.TeamColor = BrickColor.new(21)
t.Parent = game.Teams
local t = Instance.new(&quot;Team&quot;)
t.AutoAssignable = false
t.Name = &quot;Blue&quot;
t.TeamColor = BrickColor.new(23)
t.Parent = game.Teams


GameHint.Text = &quot;Destroy the other team, The winning team will earn points, FIGHT!&quot;

wait(5)

GameHint.Text = &quot;A New game will begin shortly...&quot;

winner = nil
for i = 1, 240 do
wait(0.25)
local reds = 0
local blues = 0
local pls = game.Players:GetPlayers()
for i = 1, #pls do
if pls[i].Playing.Value == true then
if pls[i].Neutral == false then
if pls[i].TeamColor == BrickColor.new(21) then -- Bright Red
reds = reds + 1
elseif pls[i].TeamColor == BrickColor.new(23) then -- Bright Blue
blues = blues + 1
end
end
end
end
if blues == 0 and reds &gt; 0 then
winner = &quot;red&quot;
break
end
if reds == 0 and blues &gt; 0 then
winner = &quot;blue&quot;
break
end
if blues == 0 and reds == 0 then
winner = nil
break
end
end

if winner == nil then
GameHint.Text = &quot;There was no winning team, all surviving players get two Points each&quot;
local pls = game.Players:GetPlayers()
for i = 1, #pls do
stats = pls[i]:findFirstChild(&quot;leaderstats&quot;)
if stats ~= nil then
points = stats:findFirstChild(&quot;Points&quot;)
if points ~= nil then
if pls[i].Playing.Value == true then
points.Value = points.Value + 2
end
end
end
end
elseif winner == &quot;blue&quot; then
GameHint.Text = &quot;The blue team won, all members of the blue team get one point plus an extra two if they survived&quot;
for i = 1, #tblues do
stats = tblues[i]:findFirstChild(&quot;leaderstats&quot;)
if stats ~= nil then
points = stats:findFirstChild(&quot;Points&quot;)
if points ~= nil then
points.Value = points.Value + 1
if tblues[i].Playing.Value == true then points.Value = points.Value + 2 end
end
end
end
elseif winner == &quot;red&quot; then
GameHint.Text = &quot;The red team won, all members of the red team get one point plus an extra two if they survived&quot;
for i = 1, #treds do
stats = treds[i]:findFirstChild(&quot;leaderstats&quot;)
if stats ~= nil then
points = stats:findFirstChild(&quot;Points&quot;)
if points ~= nil then
points.Value = points.Value + 1
if treds[i].Playing.Value == true then points.Value = points.Value + 2 end
end
end
end
end

wait(5)

game.Teams.Red:Remove()
game.Teams.Blue:Remove()
local pls = game.Players:GetPlayers()
for i = 1, #pls do
pls[i].TeamColor = BrickColor.new(1)
if pls[i].Character ~= nil then
local tools = pls[i].Character:GetChildren()
for i = 1, #tools do
if tools[i].className == &quot;Tool&quot; then
tools[i]:Remove()
end
end
end
if pls[i]:findFirstChild(&quot;Backpack&quot;) ~= nil then
local tools = pls[i].Backpack:GetChildren()
for i = 1, #tools do
if tools[i].className == &quot;Tool&quot; then
tools[i]:Remove()
end
end
end
local tools = game.Workspace:GetChildren()
for i = 1, #tools do
if tools[i].className == &quot;Tool&quot; then
tools[i]:Remove() -- Catches glitched dropped tools
end
end
end
Finished.Value = true
</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
			<Item class="Model" referent="RBX205">
