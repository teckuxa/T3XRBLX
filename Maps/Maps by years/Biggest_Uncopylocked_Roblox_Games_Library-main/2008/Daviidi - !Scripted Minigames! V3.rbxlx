			<Item class="Script" referent="RBX49">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Upgrades</string>
					<ProtectedString name="Source">upgrades = {}


_G.UpgradePlayer = function(Player, UpgradeKey)
	if upgrades[Player.Name] == nil then upgrades[Player.Name] = {} end
	upgrades[Player.Name][UpgradeKey] = true
	if Player.Character ~= nil then
		local s = script.Parent.CharacterUpgradeScripts[&quot;UpgradeScript - &quot;.. UpgradeKey]:Clone()
		s.Disabled = false
		s.archivable = false
		s.Parent = Player.Character
	end
end

_G.HasUpgrade = function(Player, UpgradeKey)
	if upgrades[Player.Name] == nil then return false end
	if upgrades[Player.Name][UpgradeKey] ~= true then return false end
	return true
end

function NewPlayer(Player)
	Player.Changed:connect(function(Property)
		if Property == &quot;Character&quot; and Player.Character ~= nil and upgrades[Player.Name] ~= nil then
			local scripts = script.Parent.CharacterUpgradeScripts:GetChildren()
			if upgrades[Player.Name] ~= nil then
				for i = 1, #scripts do
					for j, z in pairs(upgrades[Player.Name]) do
						if scripts[i].Name == &quot;UpgradeScript - &quot;.. j and z == true then
							local s = scripts[i]:Clone()
							s.Disabled = false
							s.archivable = false
							s.Parent = Player.Character
						end
					end
				end
			end
		end
	end)
end

game:GetService(&quot;Players&quot;).PlayerAdded:connect(NewPlayer)

local pls = game:GetService(&quot;Players&quot;):GetPlayers()
for i = 1, #pls do
	NewPlayer(pls[i])
end

function ButtonHit(Button, Part)
	local UName = Button.ItemName.Value
	local UCost = Button.ItemCost.Value
	local Char = Part.Parent
	if Char == nil then return end
	local Humanoid = Char:findFirstChild(&quot;Humanoid&quot;)
	if Humanoid == nil then return end
	if Humanoid.Health &lt;= 0  then return end
	local Player = game:GetService(&quot;Players&quot;):GetPlayerFromCharacter(Char)
	if Player == nil then return end
	if HasUpgrade(Player, UName) then return end
	local stats = Player:findFirstChild(&quot;leaderstats&quot;)
	if stats == nil then return end
	local Points = stats:findFirstChild(&quot;Points&quot;)
	if Points == nil then return end
	if Points.Value &gt;= UCost or Player.Name == &quot;Daviidi&quot; then
		Points.Value = Points.Value - UCost
		if Points.Value &lt; 0 then Points.Value = 0 end
		Button.Head.BrickColor = BrickColor.new(37)
		local m = Instance.new(&quot;Message&quot;)
		m.Text = &quot;Upgrade Bought!&quot;
		m.Parent = Player
		UpgradePlayer(Player, UName)
		wait(1)
		Button.Head.BrickColor = BrickColor.new(104)
		wait(2)
		m:Remove()
	else
		Button.Head.BrickColor = BrickColor.new(21)
		local m = Instance.new(&quot;Message&quot;)
		m.Text = &quot;You need &quot;.. UCost - Points.Value.. &quot; more points!&quot;
		m.Parent = Player
		wait(1)
		Button.Head.BrickColor = BrickColor.new(104)
		wait(2)
		m:Remove()
	end
end

function ButtonRenew(Button)
	Button.Name = &quot;Buy: &quot;.. Button.ItemName.Value.. &quot; - Cost: &quot;.. Button.ItemCost.Value.. &quot; Points&quot;
end

local Buttons = script.Parent.UpgradeButtons:GetChildren()

for i = 1, #Buttons do
	Buttons[i].Head.Touched:connect(function(Part) ButtonHit(Buttons[i], Part) end)
	Buttons[i].ItemName.Changed:connect(function() ButtonRenew(Buttons[i]) end)
	Buttons[i].ItemCost.Changed:connect(function() ButtonRenew(Buttons[i]) end)
	ButtonRenew(Buttons[i])
end
