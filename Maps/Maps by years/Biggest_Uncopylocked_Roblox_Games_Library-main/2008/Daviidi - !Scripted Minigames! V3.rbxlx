				<ProtectedString name="Source">ida=14491293
idb=14435035

function awardbadge(player,bid)
	local b = game:service(&quot;BadgeService&quot;)
	b:AwardBadge(player.userId, bid)
end

function newplayer(pl)
	local points = nil
	while true do
		points = pl:findFirstChild(&quot;leaderstats&quot;)
		if points ~= nil then break end
		pl.ChildAdded:wait()
	end
	points = points.Points
	while true do
		if points.Value &gt;= 150 then break end
		points.Changed:wait()
	end
	awardbadge(pl,ida)
	while true do
		if points.Value &gt;= 500 then break end
		points.Changed:wait()
	end
	awardbadge(pl,idb)
end

game.Players.PlayerAdded:connect(newplayer)</ProtectedString>
