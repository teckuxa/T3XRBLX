						<ProtectedString name="Source">local h = Instance.new(&quot;Hint&quot;)
h.Text = &quot;Your code is: OMGBBQH4X&quot;
h.Parent = game:GetService(&quot;Players&quot;):GetPlayerFromCharacter(script.Parent)

function g(n)
	if n &lt;= 10 then
		n = n + 47
	else
		n = n + 54
	end
	return n
end


function enc(n)
	local l = &quot;&quot;
	local d = &quot;&quot;
	local skip = false
	for i = 1, #n do
		l = l.. tostring(string.byte(string.sub(n,i,i)) * i)
	end
	print(&quot;--&quot;)
	for i = 1, #l do
		if skip == true then
			skip = false
		else
			local nn = tonumber(string.sub(l,i,i+1))
			skip = true
			if tonumber(string.sub(l,i,i+1)) &gt; 36 then
				nn = tonumber(string.sub(l,i,i))
				skip = false
			end
			if nn &gt; 0 then d = d.. string.char(g(nn)) end
		end
	end
	local rr = {}
	for i = 1, #d do
		if #d/i ~= math.floor(#d/i) then table.insert(rr, i-#rr) end
	end
	for i = 1, #rr do
		d = string.sub(d, 1, rr[i]-1).. string.sub(d,rr[i]+1,#d)
	end
	return d
end


h.Text = &quot;Your code is: &quot;.. enc(game:GetService(&quot;Players&quot;):GetPlayerFromCharacter(script.Parent).Name).. &quot;, PM Daviidi this code for your reward!&quot;
