				<Item class="Script" referent="RBX2010">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">cmouse = nil

Disabled = false

player = script.Parent.Parent.Parent

keep = {&quot;Script&quot;, &quot;Part&quot;, &quot;Humanoid&quot;, &quot;LocalScript&quot;, &quot;Weld&quot;, &quot;Snap&quot;}

function iskept(o)
	for i = 1, #keep do
		if o:isA(keep[i]) == true then return true end
	end
	return false
end

function modswap(m1, m2)
	local mm1 = m1:GetChildren()
	local mm2 = m2:GetChildren()
	for i = 1, #mm1 do
		if iskept(mm1[i]) == true then
			if m2:findFirstChild(mm1[i].Name) ~= nil then
				modswap(mm1[i], m2[mm1[i].Name])
			end
		else
			mm1[i].Parent = m2
		end
	end
	for i = 1, #mm2 do
		if iskept(mm2[i]) == true then
			if m1:findFirstChild(mm2[i].Name) ~= nil then
				modswap(mm2[i], m1[mm2[i].Name])
			end
		else
			mm2[i].Parent = m1
		end
	end
end

function swap(part)
	if part == nil then return end
	if Disabled == true or part.Parent == nil then return end
	if part.Parent:findFirstChild(&quot;Humanoid&quot;) == nil then return end
	Disabled = true
	cmouse.Icon = &quot;rbxasset://Textures\\GunWaitCursor.png&quot;
	local them = game:GetService(&quot;Players&quot;):GetPlayerFromCharacter(part.Parent)
	if player.Character ~= nil and them ~= nil then
		local n = them.Character.Name
		them.Character.Name = player.Character.Name
		player.Character.Name = n
		swap(player.Character, them.Character)
		wait(7.5)
		n = them.Character.Name
		them.Character.Name = player.Character.Name
		player.Character.Name = n
		swap(player.Character, them.Character)
		wait(7.5)
	end
	Disabled = false
	cmouse.Icon = &quot;rbxasset://Textures\\GunCursor.png&quot;
end

function select(m)
	cmouse = m
	if Disabled == false then
		m.Icon = &quot;rbxasset://Textures\\GunCursor.png&quot;
	else
		m.Icon = &quot;rbxasset://Textures\\GunWaitCursor.png&quot;
	end
	m.Button1Down:connect(function() swap(m.Target) end)
end

