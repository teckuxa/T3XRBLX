						<Item class="Script" referent="RBX2772">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">TurboSpeed</string>
								<ProtectedString name="Source">local DB = false

script.Parent.Changed:connect(function(stat)
	if script.Parent.MaxSpeed == 0 then return end
	if stat ~= &quot;Throttle&quot; or script.Parent.Throttle ~= 1 then return end
	local t = 0
	for i = 1, 2 do
		while true do
			local time = tick()
			local stat = script.Parent.Changed:wait()
			t = t + tick() - time
			if stat == &quot;Throttle&quot; and script.Parent.Throttle == 1 then break end
		end
	end
	if t &gt; 1.5 or DB then return end
	DB = true
	script.Parent.MaxSpeed = 120
	script.Parent.Torque = 20
	local f = Instance.new(&quot;BodyForce&quot;)
	f.force = Vector3.new(0,2500,0)
	f.Parent = script.Parent
	local g = Instance.new(&quot;BodyGyro&quot;)
	g.D = 25
	g.P = 150
	g.Parent = script.Parent
	g.maxTorque = Vector3.new(0,0,1)
	wait(3)
	script.Parent.MaxSpeed = 50
	script.Parent.Torque = 4
	wait(2)
	f:Remove()
	g:Remove()
	wait(5)
	DB = false
end)</ProtectedString>
								<bool name="archivable">true</bool>
							</Properties>
						</Item>
					</Item>
