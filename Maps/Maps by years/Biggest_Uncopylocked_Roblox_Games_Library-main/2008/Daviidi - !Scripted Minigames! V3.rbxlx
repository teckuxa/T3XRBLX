								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<ProtectedString name="Source">function Darkmove()
script.Parent.Transparency = 1
script.Parent.CanCollide = false
print(&quot;DarksMoved&quot;)
if c ~= nil then
	c:disconnect()
	c = nil
end
wait(5)
script.Parent.Transparency = 0
script.Parent.CanCollide = true
fake.Parent = script.Parent.Parent
c = fake.Touched:connect(faketouch)
end

function faketouch(hit)
print(&quot;WASHIT&quot;)
if hit.Parent == nil then return end
print(hit.Parent.Name.. &quot; Touched&quot;)
if hit.Parent:findFirstChild(&quot;Humanoid&quot;) == nil then return end
hit.Parent.Humanoid.Health = 0
Ghost:Play()
fake.Parent = nil
script.Parent.Transparency = 1
script.Parent.CanCollide = false
wait(5)
script.Parent.Transparency = 0
script.Parent.CanCollide = true
Ghost:Stop()
fake.Parent = script.Parent.Parent
end

fake = script.Parent.Parent.Dark.Handle:Clone()
fake.Name = &quot;FakeDark&quot;
fake.Anchored = true

Ghost = Instance.new(&quot;Sound&quot;)
Ghost.SoundId = &quot;rbxasset://sounds\\HalloweenGhost.wav&quot;
Ghost.Parent = fake
Ghost.Volume = 1

wait(5)

c = script.Parent.Parent.Dark.AncestryChanged:connect(Darkmove)</ProtectedString>
