							<string name="Name">ToxicExplosion</string>
							<ProtectedString name="Source">local nt = script.Parent:Clone()
while nt:findFirstChild(&quot;Decal&quot;) ~= nil do nt.Decal:Remove() end
nt[script.Name]:Remove()
nt.Size = Vector3.new(nt.Size.x, 1, nt.Size.y)
nt.Anchored = false
nt.Name = &quot;BarrelPart&quot;

function touch(hit)
	c:disconnect()
	for _ = 1, 3 do
		local ex = Instance.new(&quot;Explosion&quot;)
		ex.Position = script.Parent.Position + Vector3.new(math.random() - 0.5, 0, math.random() - 0.5)
		ex.BlastRadius = 6
		ex.BlastPressure = 750000
		ex.Parent = workspace
	end
	for i = 1, script.Parent.Size.y do
		local r = nt:Clone()
		r.Position = script.Parent.Position + Vector3.new(0, i - (script.Parent.Size.y / 2), 0)
		r.Parent = workspace
		game:service(&quot;Debris&quot;):AddItem(r, math.random(50, 150)/10)
	end
	script.Parent:Remove()
end

c = script.Parent.Touched:connect(touch)</ProtectedString>
