						<string name="Name">Script</string>
						<ProtectedString name="Source">loss = false

player = script.Parent.Parent.Parent

function add(p)
	local f = Instance.new(&quot;BodyForce&quot;)
	f.Name = &quot;AntiWeight&quot;
	f.force = Vector3.new(0,p:GetMass()*100,0)
	f.Parent = p
end

function rem(p)
	local f = p:findFirstChild(&quot;AntiWeight&quot;)
	if f ~= nil then
		f:Remove()
	end
end

function lg(a)
	local b = a:GetChildren()
	for i = 1, #b do
		lg(b[i])
	end
	if a:isA(&quot;BasePart&quot;) then
		add(a)
	end
end

function rg(a)
	local b = a:GetChildren()
	for i = 1, #b do
		rg(b[i])
	end
	if a:isA(&quot;BasePart&quot;) then
		rem(a)
	end
end

function sel(m)
	if loss == true then
		script.Parent.Name = &quot;Weight Loss [ON]&quot;
	else
		script.Parent.Name = &quot;Weight Loss [OFF]&quot;
	end
	m.Button1Down:connect(function()
		if loss then
			rg(player.Character)
			script.Parent.Name = &quot;Weight Loss [OFF]&quot;
			loss = false
		else
			lg(player.Character)
			script.Parent.Name = &quot;Weight Loss [ON]&quot;
			loss = true
		end
	end)
	m.Icon = &quot;rbxasset://Textures\\GunCursor.png&quot;
end

script.Parent.Selected:connect(sel)
script.Parent.Deselected:connect(function()
	script.Parent.Name = &quot;Weight&quot;
end)
