						<R22>1</R22>
					</CoordinateFrame>
					<string name="Name">BurningBuilding.rbxm</string>
					<Ref name="PrimaryPart">null</Ref>
					<bool name="archivable">true</bool>
				</Properties>
				<Item class="Script" referent="RBX1009">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Rules</string>
						<ProtectedString name="Source">GameHint = shared.GameHint
Finished = shared.Finished

winnings = 0
spawn = script.Parent.Floor
burn = script.BurnScript
burn.Parent = nil
burn.Disabled = false

function death(deadhuman, deadplayer)
	deadplayer.Playing.Value = false
	deadplayer.TeamColor = BrickColor.new(1)
	local pls = game.Players:GetPlayers()
	for i = 1, #pls do
		if pls[i].Playing.Value == true then
			if pls[i].Character ~= nil then
				if pls[i]:findFirstChild(&quot;leaderstats&quot;) ~= nil then
					if pls[i].leaderstats:findFirstChild(&quot;Points&quot;) ~= nil then
						pls[i].leaderstats.Points.Value = pls[i].leaderstats.Points.Value + 5
					end
				end
			end
		end
	end
end

local pls = game.Players:GetPlayers()
for i = 1, #pls do
	if pls[i].Playing.Value == true then
		if pls[i].Character ~= nil then
			if pls[i].Character:findFirstChild(&quot;Humanoid&quot;) ~= nil then
				winnings = winnings + 1
				pls[i].TeamColor = BrickColor.new(24)
				pls[i].Character.Humanoid.Died:connect(function() death(pls[i].Character.Humanoid, pls[i]) end)
				if pls[i].Character:findFirstChild(&quot;Torso&quot;) ~= nil then
					pls[i].Character.Torso.CFrame = CFrame.new(spawn.Position+Vector3.new(math.random(-5,5),7,math.random(-5,5)))
				end
			end
		end
	end
end

winnings = winnings * winnings

local t = Instance.new(&quot;Team&quot;)
t.AutoAssignable = false
t.Name = &quot;Burners&quot;
t.TeamColor = BrickColor.new(24)
t.Parent = game.Teams

GameHint.Text = &quot;Avoid The flames in the house, Get READY!!!&quot;

wait(5)

for t = 5, 1, -1 do
	GameHint.Text = t
	wait(1)
end

local parts = script.Parent.House:GetChildren()
burn.Parent = parts[math.random(1,#parts)]

GameHint.Text = &quot;A new game will begin SOON...&quot;

winner = nil
tblues = {}
treds = {}
for i = 1, 720 do
wait(0.25)
local pls = game.Players:GetPlayers()
winner = nil
if #pls == 0 then break end
for i = 1, #pls do
if pls[i].Playing.Value == true then
if pls[i].Neutral == false then
if winner == nil then winner = pls[i] else winner = false end
end
end
end
if winner ~= false then break end
end

if winner ~= nil and winner ~= false then
GameHint.Text = winner.Name.. &quot; has won the game and earned &quot;.. winnings.. &quot; extra points!&quot; 
local stats = winner:findFirstChild(&quot;leaderstats&quot;)
if stats == nil then return end
local points = stats:findFirstChild(&quot;Points&quot;)
if points == nil then return end
for i = 1, winnings do
points.Value = points.Value + 1
wait()
end
else
GameHint.Text = &quot;No winner...&quot; 
end
wait(5)

game.Teams.Burners:Remove()

local pls = game.Players:GetPlayers()
for i = 1, #pls do
pls[i].TeamColor = BrickColor.new(1)
if pls[i].Character ~= nil then
local tools = pls[i].Character:GetChildren()
for i = 1, #tools do
if tools[i].className == &quot;Tool&quot; then
tools[i]:Remove()
end
end
end
if pls[i]:findFirstChild(&quot;Backpack&quot;) ~= nil then
local tools = pls[i].Backpack:GetChildren()
for i = 1, #tools do
if tools[i].className == &quot;Tool&quot; then
tools[i]:Remove()
end
end
end
end
local tools = game.Workspace:GetChildren()
for i = 1, #tools do
if tools[i].className == &quot;Tool&quot; then
tools[i]:Remove() -- Catches glitched dropped tools
end
end
Finished.Value = true
</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
					<Item class="Script" referent="RBX1010">
						<Properties>
							<bool name="Disabled">true</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">BurnScript</string>
							<ProtectedString name="Source">explosionsallowed = 5

function k(p) 
	if p:findFirstChild(script.Name) == nil then
		script:Clone().Parent = p
	end
end

function toomany()
	local am = 0
	local s = workspace:GetChildren()
	for i = 1, #s do
		if s[i].className == &quot;Explosion&quot; then
			am = am + 1
		end
	end
	if am &gt;= explosionsallowed then return true end
	return false
end

function explode()
	while toomany() == true do workspace.ChildRemoved:wait() end
	local ex = Instance.new(&quot;Explosion&quot;)
	ex.BlastPressure = 100000
	ex.BlastRadius = 3
	ex.Position = script.Parent.Position
	ex.Hit:connect(k)
	ex.Parent = workspace
end

if script.Parent.Anchored == true then
	pos = Instance.new(&quot;BodyPosition&quot;)
	pos.maxForce = Vector3.new(math.huge,math.huge,math.huge)
	pos.position = script.Parent.Position
	pos.Parent = script.Parent
	script.Parent.Anchored = false
end

script.Parent.BrickColor = BrickColor.new(26)
s = script.Sparkles:Clone()
s.Parent = script.Parent

script.Parent.Touched:connect(function(hit)
	if hit:findFirstChild(&quot;TimesHit&quot;) == nil then
		local th = Instance.new(&quot;IntValue&quot;)
		th.Name = &quot;TimesHit&quot;
		th.Parent = hit
	end
	hit.TimesHit.Value = hit.TimesHit.Value + math.ceil(script.Parent:GetMass()/2)
	if hit.TimesHit.Value &gt;= hit:GetMass() then k(hit) end
end)

wait(math.random(100,1000)/100)

explode()

wait(2)

script.Parent:BreakJoints()

wait(8)

script.Parent:Remove()
