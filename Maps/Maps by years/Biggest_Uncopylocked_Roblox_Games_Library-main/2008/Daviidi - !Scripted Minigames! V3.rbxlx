						<ProtectedString name="Source">GameHint = shared.GameHint
Finished = shared.Finished

weps = game.Lighting.Tools.ElementalSwords:GetChildren()
winnings = 0

function death(deadhuman, deadplayer)
deadplayer.TeamColor = BrickColor.new(1)
local tls = deadplayer.Backpack:GetChildren()
for i = 1, #tls do
	if tls[i]:findFirstChild(&quot;Handle&quot;) ~= nil and deadplayer.Character:findFirstChild(&quot;Torso&quot;) ~= nil then
		tls[i].Handle.Position = deadplayer.Character.Torso.Position + Vector3.new(math.random()-0.5,1,math.random()-0.5)
		tls[i].Parent = game.Workspace
	end
end
local tls = deadplayer.Character:GetChildren()
for i = 1, #tls do
	if tls[i].className == &quot;Tool&quot; and tls[i]:findFirstChild(&quot;Handle&quot;) ~= nil and deadplayer.Character:findFirstChild(&quot;Torso&quot;) ~= nil then
		tls[i].Handle.Position = deadplayer.Character.Torso.Position + Vector3.new(math.random()-0.5,1,math.random()-0.5)
		tls[i].Parent = game.Workspace
	end
end
local creator = deadhuman:findFirstChild(&quot;creator&quot;)
if creator == nil then return end
if creator.Value == nil then return end
local stats = creator.Value:findFirstChild(&quot;leaderstats&quot;)
if stats == nil then return end
local points = stats:findFirstChild(&quot;Points&quot;)
if points == nil then return end
points.Value = points.Value + 5
end

local pls = game.Players:GetPlayers()
local spawns = script.Parent.Spawns:GetChildren()
for i = 1, #pls do
if pls[i].Playing.Value == true then
if pls[i].Character ~= nil then
winnings = winnings + 1
pls[i].TeamColor = BrickColor.new(24)
pls[i].Character.Humanoid.Died:connect(function() death(pls[i].Character.Humanoid, pls[i]) end)
if pls[i].Character:findFirstChild(&quot;Head&quot;) ~= nil then
	pls[i].Character.Head.Anchored = true
	local h2 = pls[i].Character.Head:Clone()
	pls[i].Character.Head.Transparency = 1
	h2.Name = &quot;FakeHead&quot;
	h2.Parent = pls[i].Character
	h2.CFrame = pls[i].Character.Head.CFrame
	h2:MakeJoints()
	h2.Anchored = false
	pls[i].Character.Head.Anchored = false
end
local wep = math.random(1, #weps)
weps[wep]:Clone().Parent = pls[i]:findFirstChild(&quot;Backpack&quot;)
local xwx = math.random(1,#spawns)
local pos = (spawns[xwx].Position + Vector3.new(0,3,0))
pls[i].Character.Torso.CFrame = CFrame.new(pos)
table.remove(spawns, xwx)
end
end
end

script.Parent.Spawns:Remove()
winnings = winnings * winnings

local t = Instance.new(&quot;Team&quot;)
t.AutoAssignable = false
t.Name = &quot;Elementals&quot;
t.TeamColor = BrickColor.new(24)
t.Parent = game.Teams


GameHint.Text = &quot;Destroy the other players, every element have different advantages over other elements, FIGHT!&quot;

wait(5)

GameHint.Text = &quot;A New game will begin shortly...&quot;

winner = nil
tblues = {}
treds = {}
for i = 1, 720 do
wait(0.25)
local reds = 0
local blues = 0
local pls = game.Players:GetPlayers()
winner = nil
if #pls == 0 then break end
for i = 1, #pls do
if pls[i].Playing.Value == true then
if pls[i].Neutral == false then
if winner == nil then winner = pls[i] else winner = false end
end
end
end
if winner ~= false then break end
end

if winner ~= nil and winner ~= false then
GameHint.Text = winner.Name.. &quot; has won the game and earned &quot;.. winnings.. &quot; extra points!&quot; 
local stats = winner:findFirstChild(&quot;leaderstats&quot;)
if stats == nil then return end
local points = stats:findFirstChild(&quot;Points&quot;)
if points == nil then return end
for i = 1, winnings do
points.Value = points.Value + 1
wait(0.1)
end
else
GameHint.Text = &quot;No winner...&quot; 
end
wait(5)

game.Teams.Elementals:Remove()

local pls = game.Players:GetPlayers()
for i = 1, #pls do
pls[i].TeamColor = BrickColor.new(1)
if pls[i].Character ~= nil then

if pls[i].Character:findFirstChild(&quot;Head&quot;) ~= nil then
	pls[i].Character.Head.Transparency = 0
	if pls[i].Character:findFirstChild(&quot;FakeHead&quot;) ~= nil then
	pls[i].Character.FakeHead:Remove()
	end
end

local tools = pls[i].Character:GetChildren()
for i = 1, #tools do
if tools[i].className == &quot;Tool&quot; then
tools[i]:Remove()
end
end
end
if pls[i]:findFirstChild(&quot;Backpack&quot;) ~= nil then
local tools = pls[i].Backpack:GetChildren()
for i = 1, #tools do
if tools[i].className == &quot;Tool&quot; then
tools[i]:Remove()
end
end
end
end
local tools = game.Workspace:GetChildren()
for i = 1, #tools do
if tools[i].className == &quot;Tool&quot; then
tools[i]:Remove() -- Catches glitched dropped tools
end
end
Finished.Value = true
