			<Item class="Script" referent="RBX131">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Tick-Tock</string>
					<ProtectedString name="Source">-- Analogue Clock Script
-- Scripted by Daviidi

local stupidnumber = 9.43

local errormsg = nil

local Hour = script.Parent:findFirstChild(&quot;HHand&quot;)
local Min = script.Parent:findFirstChild(&quot;MHand&quot;)
local Sec = script.Parent:findFirstChild(&quot;SHand&quot;)

local C = script.Parent:findFirstChild(&quot;ClockCentre&quot;)

local Lighting = game:service(&quot;Lighting&quot;)

if C == nil then
	errormsg = &quot;Clock Centre not Found&quot;
	error(errormsg)
end

if Hour == nil or Min == nil or Sec == nil then 
	errormsg = &quot;Clock Hand Missing&quot;
	error(errormsg)
end

function sethandpos(hand, num)
	hand.CFrame = C.CFrame * CFrame.fromEulerAnglesXYZ(0,stupidnumber + num/(stupidnumber/4.94),0)
	hand.CFrame = hand.CFrame + (hand.CFrame.lookVector * (hand.Size.z / 2)) -- + C.Position
end

function gettime(seconds)
	local minutes = seconds/60
	seconds = seconds - (math.floor(minutes)*60)
	local hours = minutes/60
	minutes = minutes - (math.floor(hours)*60)
	return hours, minutes, seconds
end

function tick()
	local hours, minutes, seconds = gettime(Lighting:GetMinutesAfterMidnight() * 60)
	sethandpos(Hour, -hours)
	sethandpos(Min, -minutes/60*12)
	sethandpos(Sec, -seconds/60*12)
end

Lighting.Changed:connect(tick)

tick()</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
