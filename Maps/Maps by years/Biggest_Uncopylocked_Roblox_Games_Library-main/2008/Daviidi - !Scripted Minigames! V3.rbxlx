				<Item class="Script" referent="RBX2006">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">cmouse = nil

Disabled = false

player = script.Parent.Parent.Parent

function fakedie()
	if Disabled == true then return end
	Disabled = true
	cmouse.Icon = &quot;rbxasset://Textures\\GunWaitCursor.png&quot;
	local face = nil
	local shirt = nil
	local fhold = nil
	local shold = nil
	if player.Character ~= nil then
	local fake = Instance.new(&quot;Model&quot;)
	fake.Name = player.Character.Name
		local st = player.Character:GetChildren()
		for i = 1, #st do
			if st[i].archivable == true then
				if st[i].className == &quot;Part&quot; then
					st[i]:Clone().Parent = fake
					st[i].Transparency = 1
					if st[i]:findFirstChild(&quot;roblox&quot;) ~= nil then
						shirt = st[i].roblox
						shold = st[i]
						st[i].roblox.Parent = nil
					end
					if st[i]:findFirstChild(&quot;face&quot;) ~= nil then
						face = st[i].face
						fhold = st[i]
						st[i].face.Parent = nil
					end
				elseif st[i].className == &quot;Hat&quot; or st[i].className == &quot;Tool&quot; then
					if st[i]:findFirstChild(&quot;Handle&quot;) ~= nil then
						st[i].Handle:Clone().Parent = fake
						st[i].Handle.Transparency = 1
					end
				elseif st[i].className == &quot;ForceField&quot; then
					st[i]:Clone().Parent = fake
					st[i]:Remove()
				else
					st[i]:Clone().Parent = fake
				end
			end
		end
		local s = fake:GetChildren()
		for i = 1, #s do
			if s[i].className == &quot;Part&quot; then s[i].CanCollide = true end
		end
		fake.Parent = workspace
		game:service(&quot;Debris&quot;):AddItem(fake, 10)
		wait(5)
		fake:Remove()
		for i = 1, #st do
			if st[i].className == &quot;Part&quot; then
				st[i].Transparency = 0
			elseif st[i].className == &quot;Hat&quot; or st[i].className == &quot;Tool&quot; then
				if st[i]:findFirstChild(&quot;Handle&quot;) ~= nil then
					st[i].Handle.Transparency = 0
				end
			end
		end
		if face ~= nil then face.Parent = fhold end
		if shirt ~= nil then shirt.Parent = shold end
		wait(10)
	end
	Disabled = false
	cmouse.Icon = &quot;rbxasset://Textures\\GunCursor.png&quot;
end

function select(m)
	cmouse = m
	if Disabled == false then
		m.Icon = &quot;rbxasset://Textures\\GunCursor.png&quot;
	else
		m.Icon = &quot;rbxasset://Textures\\GunWaitCursor.png&quot;
	end
	m.Button1Down:connect(fakedie)
end

