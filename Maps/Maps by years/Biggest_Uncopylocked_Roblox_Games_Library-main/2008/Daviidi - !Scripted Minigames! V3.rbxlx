						<ProtectedString name="Source">GameHint = shared.GameHint
Finished = shared.Finished

winnings = 0
plates = script.Parent.Plates
local pls = game.Players:GetPlayers()

for i = 1, #pls do
	if pls[i].Playing.Value == true then
		if pls[i].Character ~= nil then
			pls[i].Character.Humanoid.Died:connect(function()
				pls[i].TeamColor = BrickColor.new(1)
				for j = 1, #pls do
					if pls[j].TeamColor == BrickColor.new(24) then
						pls[j].leaderstats.Points.Value = pls[j].leaderstats.Points.Value + 3
					end
				end
			end)
			pls[i].Character:MoveTo(Vector3.new(math.random(50, 199), 150, math.random(-76, 73)))
			winnings = winnings + 1
		end
		pls[i].TeamColor = BrickColor.new(24)
	end
end

local t = Instance.new(&quot;Team&quot;)
t.AutoAssignable = false
t.Name = &quot;Fallers&quot;
t.TeamColor = BrickColor.new(24)
t.Parent = game.Teams

winnings = winnings * winnings

GameHint.Text = &quot;Stay on the plates, be the last one alive!&quot;

wait(5)

GameHint.Text = &quot;A New game will begin shortly...&quot;

winner = nil
while true do
	winner = nil
	local pls = game.Players:GetPlayers()
	for i = 1, #pls do
		if pls[i].Playing.Value == true then
			if winner ~= nil then winner = false else winner = pls[i] end
		end
	end
	if winner ~= false then break end
	local platestuff = plates:GetChildren()
	if #platestuff &lt;= 1 then break end
	local i = math.random(1, #platestuff)
	coroutine.resume(coroutine.create(function()
		for tr = 0, 1, 0.1 do
			platestuff[i].Transparency = tr
			wait(0.1)
		end
		platestuff[i]:Remove()
	end))
	wait(0.6)
end

if winner == nil or winner == false then
	GameHint.Text = &quot;No Winner.&quot;
else
	GameHint.Text = winner.Name.. &quot; won!&quot;
	for i = 1, winnings do
		winner.leaderstats.Points.Value = winner.leaderstats.Points.Value + 1
		wait(0.1)
	end
end

wait(5)

game.Teams.Fallers:Remove()
local pls = game.Players:GetPlayers()
for i = 1, #pls do
pls[i].TeamColor = BrickColor.new(1)
if pls[i].Character ~= nil then
local tools = pls[i].Character:GetChildren()
for i = 1, #tools do
if tools[i].className == &quot;Tool&quot; then
tools[i]:Remove()
end
end
end
if pls[i]:findFirstChild(&quot;Backpack&quot;) ~= nil then
local tools = pls[i].Backpack:GetChildren()
for i = 1, #tools do
if tools[i].className == &quot;Tool&quot; then
tools[i]:Remove()
end
end
end
local tools = game.Workspace:GetChildren()
for i = 1, #tools do
if tools[i].className == &quot;Tool&quot; then
tools[i]:Remove() -- Catches glitched dropped tools
end
end
end
Finished.Value = true
