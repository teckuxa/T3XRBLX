				<Item class="Script" referent="RBX1587">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Rules</string>
						<ProtectedString name="Source">GameHint = shared.GameHint
Finished = shared.Finished

winnings = 0
cars = script.Parent.Cars:GetChildren()

function death(deadhuman, deadplayer)
deadplayer.Playing.Value = false
deadplayer.TeamColor = BrickColor.new(1)
local pls = game.Players:GetPlayers()
for i = 1, #pls do
if pls[i].Playing.Value == true then
if pls[i].Character ~= nil then
if pls[i]:findFirstChild(&quot;leaderstats&quot;) ~= nil then
if pls[i].leaderstats:findFirstChild(&quot;Points&quot;) ~= nil then
pls[i].leaderstats.Points.Value = pls[i].leaderstats.Points.Value + 1
end
end
end
end
end
end

local pls = game.Players:GetPlayers()
for i = 1, #pls do
	if pls[i].Playing.Value == true then
		if pls[i].Character ~= nil then
			if pls[i].Character:findFirstChild(&quot;Humanoid&quot;) ~= nil then
				winnings = winnings + 1
				pls[i].TeamColor = BrickColor.new(24)
				pls[i].Character.Humanoid.Died:connect(function() death(pls[i].Character.Humanoid, pls[i]) end)
				local carno = math.random(1, #cars)
				local dcar = cars[carno]
				table.remove(cars,carno)
				local cp = dcar:GetChildren()
				for Q = 1, #cp do
					if cp[Q].Name == &quot;Engine&quot; then
						script.Parent.Crash:Clone().Parent = cp[Q]
					elseif cp[Q].Name == &quot;Bumper&quot; then
						script.Parent.Bump:Clone().Parent = cp[Q]
					end
				end
				dcar.Parent = script.Parent
				dcar:MakeJoints()
				pls[i].Character.Humanoid.Died:connect(function() if dcar ~= nil then dcar:BreakJoints() wait(5) dcar:Remove() end end)
				if pls[i].Character:findFirstChild(&quot;Torso&quot;) ~= nil then
					pls[i].Character.Torso.CFrame = CFrame.new(dcar.VehicleSeat.Position+Vector3.new(0,3,0))
					coroutine.resume(coroutine.create(function()
						local tors = pls[i].Character.Torso
						local ts = 5
						local h = Instance.new(&quot;Hint&quot;)
						h.Text = &quot;Start driving, before your engine overheats!!! :-O&quot;
						while true do
							local pos = tors.Position
							ts = ts + wait(0.5)
							if tors.Parent == nil then return end
							if tors.Parent.Parent == nil then return end
							if (pos - tors.Position).magnitude &gt; 2 then ts = 0 end
							if ts &gt; 20 then
								local x = Instance.new(&quot;Explosion&quot;)
								x.Position = tors.Position
								x.Parent = workspace
								ts = 0
							elseif ts &gt; 14 then
								h.Parent = pls[i]
								game:service(&quot;Debris&quot;):AddItem(h, 0.4)
							end
						end
					end))
				end
			end
		end
	end
end

script.Parent.Cars:Remove()

winnings = winnings * winnings

local t = Instance.new(&quot;Team&quot;)
t.AutoAssignable = false
t.Name = &quot;Drivers&quot;
t.TeamColor = BrickColor.new(24)
t.Parent = game.Teams

GameHint.Text = &quot;Drive around without crashing as much as you can, DRIVE!&quot;

wait(5)

GameHint.Text = &quot;A New game will begin shortly...&quot;

winner = nil
tblues = {}
treds = {}
for i = 1, 720 do
wait(0.25)
local pls = game.Players:GetPlayers()
winner = nil
if #pls == 0 then break end
for i = 1, #pls do
if pls[i].Playing.Value == true then
if pls[i].Neutral == false then
if winner == nil then winner = pls[i] else winner = false end
end
end
end
if winner ~= false then break end
end

if winner ~= nil and winner ~= false then
GameHint.Text = winner.Name.. &quot; has won the game and earned &quot;.. winnings.. &quot; extra points!&quot; 
local stats = winner:findFirstChild(&quot;leaderstats&quot;)
if stats == nil then return end
local points = stats:findFirstChild(&quot;Points&quot;)
if points == nil then return end
for i = 1, winnings do
points.Value = points.Value + 1
wait(0.1)
end
else
GameHint.Text = &quot;No winner...&quot; 
end
wait(5)

game.Teams.Drivers:Remove()

local pls = game.Players:GetPlayers()
for i = 1, #pls do
pls[i].TeamColor = BrickColor.new(1)
if pls[i].Character ~= nil then
local tools = pls[i].Character:GetChildren()
for i = 1, #tools do
if tools[i].className == &quot;Tool&quot; then
tools[i]:Remove()
end
end
end
if pls[i]:findFirstChild(&quot;Backpack&quot;) ~= nil then
local tools = pls[i].Backpack:GetChildren()
for i = 1, #tools do
if tools[i].className == &quot;Tool&quot; then
tools[i]:Remove()
end
end
end
end
local tools = game.Workspace:GetChildren()
for i = 1, #tools do
if tools[i].className == &quot;Tool&quot; then
tools[i]:Remove() -- Catches glitched dropped tools
end
end
Finished.Value = true
</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX1588">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Bump</string>
						<ProtectedString name="Source">function ex(p)
	if p.Parent == script.Parent.Parent then return end
	p:BreakJoints()
end

if script.Parent.className ~= &quot;Model&quot; then
	script.Parent.Touched:connect(ex)
end

</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX1589">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Crash</string>
						<ProtectedString name="Source">times = 0

d = 0

function ex(p)
	if d == 1 then return end
	if p.Parent == script.Parent.Parent then return end
	d = 1
	times = times + 1
	if times &gt;= 2 then
		local ex = Instance.new(&quot;Explosion&quot;)
		ex.Position = script.Parent.Parent.VehicleSeat.Position
		ex.BlastRadius = 10
		ex.BlastPressure = 1500000
		ex.Parent = game.Workspace
		wait(5)
		script.Parent.Parent:Remove()
	end
	wait(.5)
	d = 0
end

if script.Parent.className ~= &quot;Model&quot; then
	script.Parent.Touched:connect(ex)
end

</ProtectedString>
