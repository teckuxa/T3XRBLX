						<ProtectedString name="Source">local Invisible = false

local Parts = {}

local face = nil
local ts = nil

function IV(Mod)
	local A = Mod:GetChildren()
	for i = 1, #A do
		if A[i]:isA(&quot;BasePart&quot;) == true then
			A[i].Transparency = 1
			table.insert(Parts, A[i])
		end
		IV(A[i])
	end
end


function Click()
	if Invisible then
		for i = 1, #Parts do
			Parts[i].Transparency = 0
		end
		Invisible = false
		if face ~= nil then face.Parent = script.Parent.Parent.Parent.Character.Head face = nil end
		if ts ~= nil then ts.Parent = cript.Parent.Parent.Parent.Character.Torso ts = nil end
	else
		local Mod = script.Parent.Parent.Parent.Character
		IV(Mod)
		face = Mod.Head:findFirstChild(&quot;face&quot;)
		ts = Mod.Torso:findFirstChild(&quot;roblox&quot;)
		if ts ~= nil then ts.Parent = nil end
		if face ~= nil then face.Parent = nil end
		Invisible = true
	end
end

function select(m)
	m.Icon = &quot;rbxasset://Textures\\GunCursor.png&quot;
	m.Button1Down:connect(Click)
end

