		<Item class="Script" referent="RBX47">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Day/Night Script</string>
				<ProtectedString name="Source">--Scripted By Daviidi


local speed = 1 -- how many ingame seconds pass per real time second

time = game:service(&quot;Lighting&quot;):GetMinutesAfterMidnight()

local full = 60 * 60 * 12 -- a full day

while true do
	time = (time + (wait()/60)*speed)
	game:service(&quot;Lighting&quot;):SetMinutesAfterMidnight(time)
	if time &gt;= full then time = time - full end
end
</ProtectedString>
