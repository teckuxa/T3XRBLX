						<ProtectedString name="Source">cmouse = nil

Disabled = false

pl = script.Parent.Parent.Parent
human = pl.Character.Humanoid

function Stat()
	if Disabled == true then return end
	Disabled = true
	cmouse.Icon = &quot;rbxasset://Textures\\GunWaitCursor.png&quot;
	human.Name = &quot;Statue&quot;
	local spd = human.WalkSpeed
	human.WalkSpeed = 0
	local s = pl.Character:GetChildren()
	local colors = {}
	for i = 1, #s do
		if s[i].className == &quot;Part&quot; then
			s[i].Anchored = true
			s[i].Material = &quot;Concrete&quot;
			table.insert(colors, s[i].BrickColor)
			s[i].BrickColor = BrickColor.new(0)
		end
	end
	wait(10)
	for i = 1, #s do
		if s[i].className == &quot;Part&quot; then
			s[i].Anchored = false
			s[i].Material = &quot;Plastic&quot;
			s[i].BrickColor = colors[i]
		end
	end
	human.WalkSpeed = spd
	human.Name = &quot;Humanoid&quot;
	wait(15)
	Disabled = false
	cmouse.Icon = &quot;rbxasset://Textures\\GunCursor.png&quot;
end

function select(m)
	cmouse = m
	if Disabled == false then
		m.Icon = &quot;rbxasset://Textures\\GunCursor.png&quot;
	else
		m.Icon = &quot;rbxasset://Textures\\GunWaitCursor.png&quot;
	end
	m.Button1Down:connect(Stat)
end

