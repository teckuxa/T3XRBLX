				<Item class="Script" referent="RBX34">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">BallPlay</string>
						<ProtectedString name="Source">ballmod = script.Parent.Balls
backup = ballmod:Clone()

--[[
Ball Commands:
balls/move - moves all the balls randomly
balls/regen - regenerates all the balls to there original state
balls/one - removes all but one ball.
balls/shine - makes all balls shine
balls/explode - makes all balls explode with a small explosion.
balls/jump - makes all balls jump into the air a bit
balls/sparkle - makes all balls sparkle
balls/none - removes all balls
--]]

function get(m)
if m == &quot;move&quot; then
local balls = ballmod:GetChildren()
for i = 1, #balls do
balls[i].RotVelocity = balls[i].RotVelocity + Vector3.new(math.random(-500,500),math.random(-500,500),math.random(-500,500))
end
elseif m == &quot;regen&quot; then
ballmod:Remove()
ballmod = backup:Clone()
ballmod.Parent = script.Parent
elseif m == &quot;one&quot; then
local balls = ballmod:GetChildren()
local i = math.random(1, #balls)
for j = 1, #balls do
if balls[j] ~= balls[i] then
balls[j]:Remove()
end
end
elseif m == &quot;shine&quot; then
local balls = ballmod:GetChildren()
for i = 1, #balls do
balls[i].Reflectance = .75
end
elseif m == &quot;explode&quot; then
local balls = ballmod:GetChildren()
for i = 1, #balls do
local ex = Instance.new(&quot;Explosion&quot;)
ex.BlastPressure = 10000000
ex.BlastRadius = 1
ex.Position = balls[i].Position
ex.Parent = balls[i]
end
elseif m == &quot;jump&quot; then
local balls = ballmod:GetChildren()
for i = 1, #balls do
balls[i].Velocity = balls[i].Velocity + Vector3.new(0,math.random(50,150),0)
end
elseif m == &quot;sparkle&quot; then
local balls = ballmod:GetChildren()
for i = 1, #balls do
Instance.new(&quot;Sparkles&quot;).Parent = balls[i]
end
elseif m == &quot;none&quot; then
local balls = ballmod:GetChildren()
for j = 1, #balls do
balls[j]:Remove()
end
end
end

function chat(msg)
msg = string.lower(msg)
if string.sub(msg,1,6) == &quot;balls/&quot; then
get(string.sub(msg,7))
end
end

function newplayer(pl)
pl.Chatted:connect(chat)
end

game.Players.PlayerAdded:connect(newplayer)</ProtectedString>
