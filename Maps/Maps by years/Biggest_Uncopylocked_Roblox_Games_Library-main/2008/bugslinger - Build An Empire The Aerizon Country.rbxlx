&#9;&#9;&#9;a=true
&#9;&#9;&#9;for i=1,20 do
&#9;&#9;&#9;&#9;if not a==true then break end
&#9;&#9;&#9;&#9;wait(0.1)
&#9;&#9;&#9;end
&#9;&#9;&#9;a=false
&#9;&#9;&#9;script.Parent.CanCollide=true
&#9;&#9;&#9;script.Parent.Transparency=0
&#9;&#9;else
&#9;&#9;print(&quot;User:&quot;..p.Name..&quot; does not have badge:&quot;..tostring(script.Parent.BadgeID.Value))
&#9;&#9;a=false
&#9;&#9;script.Parent.CanCollide=true
&#9;&#9;script.Parent.Transparency=0
&#9;&#9;end
&#9;end
end
