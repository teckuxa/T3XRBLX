function onKeyDown(key) -- key functions



&#9;if (key~=nil) then



&#9;&#9;if (key==&quot;z&quot;) then -- mode button

&#9;&#9;&#9;mode = &quot;Transparency&quot;
&#9;&#9;&#9;if (interval==&quot;Increase&quot;)then
