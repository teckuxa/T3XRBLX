		<Item class="HopperBin" referent="RBX6497">
			<Properties>
				<bool name="Active">false</bool>
				<token name="BinType">0</token>
				<string name="Name">Axe</string>
				<Content name="TextureId"><null></null></Content>
			</Properties>
			<Item class="Script" referent="RBX6498">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">local damage = 1
local money = 1
local reload = 1
local tool = script.Parent
local debounce = true

function getDist(pos, pos2)
&#9;return (pos - pos2).magnitude
end

function message(parent, text, time)
&#9;local m = Instance.new(&quot;Message&quot;)
&#9;m.Text = text
&#9;m.Parent = parent
&#9;wait(time)
&#9;m:remove()
end

function onButton1Down(mouse)
&#9;local target = mouse.Target

&#9;if target == nil then return end

&#9;if debounce == false then return end

&#9;if target.Parent == nil then return end

&#9;if target.Parent.Name ~= &quot;Tree&quot; then return end

&#9;local player = tool.Parent.Parent

&#9;local char = player.Character

&#9;if player == nil then return end

&#9;local dist = getDist(target.Position, char.Head.Position)

&#9;if dist &gt; 3 then return end

&#9;local treehp = target.Parent.hit
&#9;local treedead = target.Parent.Timber

&#9;if treehp == nil or treedead == nil then return end

&#9;if treehp.Value &gt; 0 then

&#9;&#9;treehp.Value = treehp.Value - damage

&#9;elseif treehp.Value &lt; 1 and treedead.Value == 0 then

&#9;&#9;treedead.Value = 1
&#9;&#9;local cash = player.leaderstats.Gold
&#9;&#9;cash.Value = cash.Value + money

&#9;end

&#9;if treedead.Value == 0 then

&#9;&#9;debounce = false

&#9;&#9;message(player, &quot;Resting, &quot;..(treehp.Value + 1)..&quot; hits to go&quot;, reload)

&#9;&#9;debounce = true

&#9;end
end

function onSelected(mouse)
&#9;print(&quot;Equipped&quot;)
&#9;mouse.Button1Down:connect(function () onButton1Down(mouse) end)
end

tool.Selected:connect(onSelected)</ProtectedString>
