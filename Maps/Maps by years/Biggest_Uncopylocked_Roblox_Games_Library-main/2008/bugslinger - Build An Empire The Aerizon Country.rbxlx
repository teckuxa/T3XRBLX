			<Item class="Script" referent="RBX4964">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">PresentScript</string>
					<ProtectedString name="Source">local tool = &quot;Spear&quot;
local cost = 80
local debounce = true
local tool_real = game.Lighting:findFirstChild(tool):clone()

script.Parent.Name = &quot;Buy a &quot;..tool..&quot;, -&quot;..cost..&quot; Gold&quot;

function onTouched(hit)

&#9;if debounce == false then return end

&#9;if hit.Parent == nil then return end

&#9;local p = game.Players:GetPlayerFromCharacter(hit.Parent)

&#9;if p ~= nil then

&#9;&#9;local cash = p.leaderstats.Gold

&#9;&#9;if cash.Value &gt;= cost then

&#9;&#9;&#9;cash.Value = cash.Value - cost

&#9;&#9;&#9;tool_real:clone().Parent = p.Backpack

&#9;&#9;end

&#9;end

&#9;debounce = false

&#9;wait(1)

&#9;debounce = true

end

script.Parent.Head.Touched:connect(onTouched)</ProtectedString>
