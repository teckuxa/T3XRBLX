					<ProtectedString name="Source">a=false
function onTouched(part)
&#9;p=game.Players:playerFromCharacter(part.Parent)
&#9;if p~=nil then
&#9;&#9;if game:GetService(&quot;BadgeService&quot;):UserHasBadge(p.userId, script.Parent.BadgeID.Value)~=nil then
&#9;&#9;&#9;print(&quot;User:&quot;..p.Name..&quot; has badge:&quot;..tostring(script.Parent.BadgeID.Value))
&#9;&#9;&#9;script.Parent.CanCollide=false
&#9;&#9;&#9;script.Parent.Transparency=0.9
&#9;&#9;&#9;a=true
&#9;&#9;&#9;for i=1,20 do
&#9;&#9;&#9;&#9;if not a==true then break end
&#9;&#9;&#9;&#9;wait(0.1)
&#9;&#9;&#9;end
&#9;&#9;&#9;a=false
&#9;&#9;&#9;script.Parent.CanCollide=true
&#9;&#9;&#9;script.Parent.Transparency=0
&#9;&#9;else
&#9;&#9;print(&quot;User:&quot;..p.Name..&quot; does not have badge:&quot;..tostring(script.Parent.BadgeID.Value))
&#9;&#9;a=false
&#9;&#9;script.Parent.CanCollide=true
&#9;&#9;script.Parent.Transparency=0
&#9;&#9;end
&#9;end
end
