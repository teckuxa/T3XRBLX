&#9;w2.Parent = script.Parent.Handle
&#9;w2.Part0 = w1.Parent
&#9;w2.Part1 = script.Parent.Beam
&#9;w2.C1 = CFrame.fromEulerAnglesXYZ(0, 0, 0) * CFrame.new(0, 0, -1.2)

end

script.Parent.Equipped:connect(Weldnow)
script.Parent.Unequipped:connect(Weldnow)

do
