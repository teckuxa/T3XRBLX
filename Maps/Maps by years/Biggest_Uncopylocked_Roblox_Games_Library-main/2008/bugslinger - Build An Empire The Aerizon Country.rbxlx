			<Item class="Script" referent="RBX5138">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">MinedCheck</string>
					<ProtectedString name="Source">hits = script.Parent.hit --This keeps track of how much &quot;hp&quot; the tree has left
local newgold = script.Parent:clone() --for inserting a new tree later

while true do --infinite loop
if hits.Value &lt; 1 then --if the gold mine has less than 1 &quot;hp&quot; then
&#9;script.Parent:BreakJoints() --make the gold mine fall apart
&#9;wait(3) --wait a while
&#9;script.Parent:remove() --remove the mine
&#9;wait(10) --wait a while
&#9;newtree.Parent = game.Workspace --insert a new mine
&#9;newtree:MakeJoints() --make the mine stay together
end
wait(1) --wait a while before checking trees hp again
end
</ProtectedString>
				</Properties>
			</Item>
