			<Item class="Script" referent="RBX129">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">local model = script.Parent
local backup = model:clone()
local value = model.Dead

function breakApart()
&#9;local c = model:GetChildren()
&#9;local v = Vector3.new(math.random(-1, 1), 0, math.random(-1, 1))
&#9;for index, child in pairs(c) do
&#9;&#9;if child.Name == &quot;BrisilOre&quot; then
&#9;&#9;&#9;child:remove()
&#9;&#9;end
&#9;end
end

function onDied()
&#9;breakApart()
&#9;wait(3)
&#9;backup.Parent = game.Workspace
&#9;backup:MakeJoints()
&#9;model:remove()
end

value.Changed:connect(onDied)</ProtectedString>
