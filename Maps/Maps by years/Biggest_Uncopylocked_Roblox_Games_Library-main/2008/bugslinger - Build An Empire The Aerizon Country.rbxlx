&#9;&#9;
&#9;local w2 = Instance.new(&quot;Weld&quot;)
&#9;w2.Parent = script.Parent.Handle
&#9;w2.Part0 = w1.Parent
&#9;w2.Part1 = script.Parent.Beam
&#9;w2.C1 = CFrame.fromEulerAnglesXYZ(0, 0, 0) * CFrame.new(0, 0, -1)

&#9;local w3 = Instance.new(&quot;Weld&quot;)
&#9;w3.Parent = script.Parent.Handle
&#9;w3.Part0 = w1.Parent
&#9;w3.Part1 = script.Parent.Tip
&#9;w3.C1 = CFrame.fromEulerAnglesXYZ(0, -3.15, 0) * CFrame.new(0, 0, -2)

end

script.Parent.Equipped:connect(Weldnow)
script.Parent.Unequipped:connect(Weldnow)

do
&#9;local w1 = Instance.new(&quot;Weld&quot;)
