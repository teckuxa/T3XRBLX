&#9;&#9;&#9;end

&#9;&#9;end



&#9;end

end







function onButton1Down(mouse)
&#9;if mouse.Target ~= nil then
&#9;&#9;mt = mouse.Target
&#9;&#9;mts = mt.Size&#9;
&#9;&#9;if mt.Locked == false then
&#9;&#9;&#9;if mode == &quot;Transparency&quot; then
&#9;&#9;&#9;&#9;if interval == &quot;Increase&quot; then
&#9;&#9;&#9;&#9;&#9;if(mt.Transparency&lt;=1)then
&#9;&#9;&#9;&#9;&#9;&#9;mt.Transparency = mt.Transparency+0.1
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;if interval == &quot;Decrease&quot; then
&#9;&#9;&#9;&#9;&#9;if(mt.Transparency&gt;=0)then
&#9;&#9;&#9;&#9;&#9;&#9;mt.Transparency = mt.Transparency-0.1
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;if mode == &quot;Reflectance&quot; then
&#9;&#9;&#9;&#9;if interval == &quot;Increase&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;if(mt.Reflectance&lt;=1)then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;mt.Reflectance = mt.Reflectance+0.1
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;if interval == &quot;Decrease&quot; then
&#9;&#9;&#9;&#9;&#9;if(mt.reflectance&gt;=0)then
&#9;&#9;&#9;&#9;&#9;&#9;mt.Reflectance = mt.Reflectance-0.1
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;elseif mt.Locked == true then
&#9;&#9;&#9;text2.Parent = gui
&#9;&#9;&#9;text2.Text = &quot;Brick is locked!&quot;
&#9;&#9;&#9;text.Position = UDim2.new(0,0,1,-100)
&#9;&#9;&#9;text.Position = text.Position - UDim2.new(0,0,0,20)
&#9;&#9;&#9;text2.Size = UDim2.new(0,130,0,20)
&#9;&#9;end
&#9;elseif mouse.Target == nil then
&#9;&#9;text2.Parent = gui
&#9;&#9;text2.Text = &quot;No brick found.&quot;
&#9;&#9;text.Position = UDim2.new(0,0,1,-100)
&#9;&#9;text.Position = text.Position - UDim2.new(0,0,0,20)
&#9;&#9;text2.Size = UDim2.new(0,130,0,20)
&#9;end
end

function om(mouse)
&#9;if mouse.Target ~= nil then
&#9;&#9;if mouse.Target.Locked == false then
&#9;&#9;&#9;if mode == &quot;Transparency&quot; then
&#9;&#9;&#9;&#9;if interval == &quot;Increase&quot; then
&#9;&#9;&#9;&#9;&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
&#9;&#9;&#9;&#9;&#9;text2.Parent = gui
&#9;&#9;&#9;&#9;&#9;text2.Size = UDim2.new(0,150,0,20)
&#9;&#9;&#9;&#9;&#9;text2.Text = &quot;Increase Trans~&quot;..mouse.Target.Name
&#9;&#9;&#9;&#9;&#9;text.Position = UDim2.new(0,0,1,-100)
&#9;&#9;&#9;&#9;&#9;text.Position = text.Position - UDim2.new(0,0,0,20)
&#9;&#9;&#9;&#9;&#9;text2.Size = UDim2.new(0,130,0,20)
&#9;&#9;&#9;&#9;elseif interval == &quot;Decrease&quot; then
&#9;&#9;&#9;&#9;&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
&#9;&#9;&#9;&#9;&#9;text2.Parent = gui
&#9;&#9;&#9;&#9;&#9;text2.Size = UDim2.new(0,150,0,20)
