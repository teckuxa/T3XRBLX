		<Item class="HopperBin" referent="RBX3706">
			<Properties>
				<bool name="Active">false</bool>
				<token name="BinType">0</token>
				<string name="Name">Keycard</string>
				<Content name="TextureId"><null></null></Content>
			</Properties>
			<Item class="Script" referent="RBX3707">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Search Tool</string>
					<ProtectedString name="Source">bin = script.Parent
local pack = bin.Parent
local player = pack.Parent
local debounce = false
local char = game.Workspace:findFirstChild(player.Name)

local textbox = player.PlayerGui.TextBox.Chat

function onButton1Down(mouse)
&#9;mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot;
&#9;local hit = mouse.Target
&#9;if (hit == nil) then return end
&#9;&#9;if (hit.Parent.Name == &quot;Scanner&quot;) and debounce == false then
&#9;&#9;&#9;&#9;if(player:findFirstChild(&quot;Safe&quot;) == nil) then
&#9;&#9;&#9;&#9;debounce = true
&#9;&#9;&#9;&#9;textbox.Text = &quot;Aha! I got the keycard working.&quot;
&#9;&#9;&#9;&#9;wait(3)
&#9;&#9;&#9;&#9;textbox.Text = &quot;The safe has something on it now!&quot;
&#9;&#9;&#9;&#9;wait(3)
&#9;&#9;&#9;&#9;textbox.Text = &quot;I need a combination?! Ugh.&quot;
&#9;&#9;&#9;&#9;wait(3)
&#9;&#9;&#9;&#9;textbox.Text = &quot;There&apos;s a hint: &apos;Plants&apos;&quot;
&#9;&#9;&#9;&#9;wait(3)
&#9;&#9;&#9;&#9;textbox.Text = &quot; &quot;
&#9;&#9;&#9;&#9;combo = game.Lighting.Combo:clone()
&#9;&#9;&#9;&#9;combo.Parent = player.PlayerGui
&#9;&#9;&#9;&#9;debounce = false
&#9;&#9;else
&#9;&#9;&#9;&#9;textbox.Text = &quot;Yes! The safe is open!&quot;
&#9;&#9;&#9;&#9;wait(3)
&#9;&#9;&#9;&#9;textbox.Text = &quot;What&apos;s inside..?&quot;
&#9;&#9;&#9;&#9;wait(3)
&#9;&#9;&#9;&#9;textbox.Text = &quot;It&apos;s another key. Wait, there&apos;s a note here too...&quot;
&#9;&#9;&#9;&#9;game.Lighting.MasterKey:clone().Parent = pack
&#9;&#9;&#9;&#9;wait(3)
&#9;&#9;&#9;&#9;textbox.Text = &quot;&apos;The Master Key&apos;&quot;
&#9;&#9;&#9;&#9;wait(3)
&#9;&#9;&#9;&#9;textbox.Text = &quot; &quot;
&#9;&#9;&#9;end
&#9;&#9;end
&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
&#9;end



function onSelected(mouse)
&#9;print(&quot;Action Tool Selected&quot;)
&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end

bin.Selected:connect(onSelected)
</ProtectedString>
				</Properties>
			</Item>
		</Item>
		<Item class="HopperBin" referent="RBX3708">
			<Properties>
				<bool name="Active">false</bool>
				<token name="BinType">0</token>
