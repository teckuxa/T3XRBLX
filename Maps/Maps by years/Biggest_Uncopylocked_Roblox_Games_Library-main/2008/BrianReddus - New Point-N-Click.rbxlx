		<Item class="ScreenGui" referent="RBX3698">
			<Properties>
				<string name="Name">Combo</string>
			</Properties>
			<Item class="Script" referent="RBX3699">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">wait(5)

local combo = script.Parent
local cont = combo.Container
local num1 = combo.Num1
local num2 = combo.Num2
local num3 = combo.Num3
local inst = combo.Instructions
local sub = combo.Submit

part1 = 0
part2 = 0
part3 = 0

num1.Text = part1
num2.Text = part2
num3.Text = part3

function click1()
&#9;if part1 ~= 9 then
&#9;part1 = part1 + 1
&#9;else
&#9;part1 = 0
&#9;end
&#9;num1.Text = part1
end

function click2()
&#9;if part2 ~= 9 then
&#9;part2 = part2 + 1
&#9;else
&#9;part2 = 0
&#9;end
&#9;num2.Text = part2
end

function click3()
&#9;if part3 ~= 9 then
&#9;part3 = part3 + 1
&#9;else
&#9;part3 = 0
&#9;end
&#9;num3.Text = part3
end

function submit()
&#9;if (part1 == 8) and (part2 == 3) and (part3 == 6) then
&#9;&#9;inst.Text = &quot;Correct!&quot;
&#9;&#9;safe = Instance.new(&quot;BoolValue&quot;)
&#9;&#9;safe.Name = &quot;Safe&quot;
&#9;&#9;safe.Parent = script.Parent.Parent.Parent
&#9;&#9;wait(3)
&#9;&#9;script.Parent:remove()
&#9;else
&#9;&#9;inst.Text = &quot;Incorrect!&quot;
&#9;&#9;wait(3)
&#9;&#9;inst.Text = &quot;Press each number to change it.&quot;
&#9;end
end

&#9;&#9;

num1.MouseButton1Down:connect(click1)
num2.MouseButton1Down:connect(click2)
num3.MouseButton1Down:connect(click3)
sub.MouseButton1Down:connect(submit)
</ProtectedString>
				</Properties>
			</Item>
