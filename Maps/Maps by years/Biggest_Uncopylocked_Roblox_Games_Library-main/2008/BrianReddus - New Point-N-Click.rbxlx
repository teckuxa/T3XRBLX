				<Item class="Script" referent="RBX3245">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">debounce = false
function onTouched(hit)
&#9;if debounce == false then
&#9;&#9;&#9;if hit.Name ~= &quot;Handle&quot; then
&#9;&#9;&#9;&#9;if hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil then
&#9;&#9;&#9;&#9;debounce = true
&#9;&#9;&#9;player = game.Players:findFirstChild(hit.Parent.Name)
&#9;&#9;&#9;print(player.Name)
                          msg = player.PlayerGui.TextBox.Chat
                          msg.Text = (&quot;Looks like your stuck in a bedroom...&quot;)
                          wait(5)
                          msg.Text = (&quot;Theres a door over there, but I bet its locked.&quot;)
                          wait(4)
                          msg.Text = (&quot;The door is always locked...&quot;)
                          wait(4)
                          msg.Text = (&quot;Its how all places like this work.&quot;)
                          wait(4)
                          msg.Text = &quot; &quot;
&#9;&#9;&#9;debounce = false
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

script.Parent.Touched:connect(onTouched)</ProtectedString>
