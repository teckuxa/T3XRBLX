				<Item class="Script" referent="RBX3241">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">debounce = false
function onTouched(hit)
&#9;if debounce == false then
&#9;&#9;&#9;if hit.Name ~= &quot;Handle&quot; then
&#9;&#9;&#9;&#9;if hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil then
&#9;&#9;&#9;&#9;debounce = true
&#9;&#9;&#9;player = game.Players:findFirstChild(hit.Parent.Name)
&#9;&#9;&#9;print(player.Name)
                          msg = player.PlayerGui.TextBox.Chat
                          msg.Text = (&quot;Oh noes! It was a one way hatch!&quot;)
                          wait(5)
                          msg.Text = (&quot;It looks like your stuck inside for now...&quot;)
                          wait(4)
                          msg.Text = (&quot;How ironic.&quot;)
                          wait(4)
                          msg.Text = (&quot;The place creator needs some new ideas...&quot;)
                          wait(4)
                          msg.Text = &quot; &quot;
&#9;&#9;&#9;debounce = false
end
end
&#9;end
end

script.Parent.Touched:connect(onTouched)</ProtectedString>
					</Properties>
				</Item>
			</Item>
