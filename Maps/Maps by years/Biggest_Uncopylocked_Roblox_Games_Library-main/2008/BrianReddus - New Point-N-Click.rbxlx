							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">debounce = false
function onTouched(hit)
&#9;if debounce == false then
&#9;&#9;&#9;h = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;&#9;&#9;&#9;if h ~= nil then
&#9;&#9;&#9;&#9;key = game.Players:findFirstChild(hit.Parent.Name):findFirstChild(&quot;FirstFloor&quot;)
&#9;&#9;&#9;&#9;if key ~= nil then
&#9;&#9;&#9;&#9;debounce = true
&#9;&#9;&#9;&#9;torso = hit.Parent.Torso
&#9;&#9;&#9;&#9;torso.CFrame = CFrame.new(46, 19, -135)
&#9;&#9;&#9;&#9;debounce = false
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

script.Parent.Touched:connect(onTouched)</ProtectedString>
						</Properties>
					</Item>
				</Item>
