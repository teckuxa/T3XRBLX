					<ProtectedString name="Source">bin = script.Parent
local pack = bin.Parent
local player = pack.Parent
local debounce = false
local char = game.Workspace:findFirstChild(player.Name)

local textbox = player.PlayerGui.TextBox.Chat

function onButton1Down(mouse)
&#9;mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot;
&#9;local hit = mouse.Target
&#9;if (hit == nil) then return end
&#9;&#9;if (hit.Name == &quot;ElevatorKey&quot;) and debounce == false then
&#9;&#9;&#9;&#9;if (pack:findFirstChild(&quot;Paper&quot;) ~= nil) then
&#9;&#9;&#9;&#9;debounce = true
&#9;&#9;&#9;&#9;textbox.Text = &quot;This key opened the elevator doors!&quot;
&#9;&#9;&#9;&#9;wait(3)
&#9;&#9;&#9;&#9;textbox.Text = &quot;But the elevator isn&apos;t there...&quot;
&#9;&#9;&#9;&#9;wait(3)
&#9;&#9;&#9;&#9;textbox.Text = &quot;I guess you gotta jump!&quot;
&#9;&#9;&#9;&#9;wait(3)
&#9;&#9;&#9;&#9;char.Torso.CFrame = CFrame.new(-31, 6.4, -16)
&#9;&#9;&#9;&#9;key = Instance.new(&quot;BoolValue&quot;)
&#9;&#9;&#9;&#9;key.Name = &quot;Basement&quot;
&#9;&#9;&#9;&#9;key.Parent = player
&#9;&#9;&#9;&#9;textbox.Text = &quot;Is this a... Jailcell?!?!&quot;
&#9;&#9;&#9;&#9;wait(3)
&#9;&#9;&#9;&#9;textbox.Text = &quot;Great. I&apos;m always getting stuck.&quot;
&#9;&#9;&#9;&#9;wait(3)
&#9;&#9;&#9;&#9;--Item cleanout time!
&#9;&#9;&#9;&#9;&#9; if pack:findFirstChild(&quot;Pole Hook&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;pack:findFirstChild(&quot;Pole Hook&quot;):remove()
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9; if pack:findFirstChild(&quot;Wrench&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;pack:findFirstChild(&quot;Wrench&quot;):remove()
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9; if pack:findFirstChild(&quot;Paper&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;pack:findFirstChild(&quot;Paper&quot;):remove()
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;textbox.Text = &quot;YOUR BACKPACK HAS BEEN CLEANED OUT OF USELESS ITEMS&quot;
&#9;&#9;&#9;&#9;wait(3)
&#9;&#9;&#9;&#9;textbox.Text = &quot; &quot;
&#9;&#9;&#9;&#9;script.Parent.Parent = nil
&#9;&#9;&#9;&#9;debounce = false
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;textbox.Text = &quot;How do I know that&apos;s where this is supposed to go?&quot;
&#9;&#9;&#9;&#9;wait(3)
&#9;&#9;&#9;&#9;textbox.Text = &quot; &quot;
&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
&#9;end



function onSelected(mouse)
&#9;print(&quot;Action Tool Selected&quot;)
&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end

bin.Selected:connect(onSelected)
</ProtectedString>
				</Properties>
			</Item>
		</Item>
