	<Item class="StarterPack" referent="RBX3645">
		<Properties>
			<string name="Name">StarterPack</string>
		</Properties>
		<Item class="HopperBin" referent="RBX3646">
			<Properties>
				<bool name="Active">false</bool>
				<token name="BinType">0</token>
				<string name="Name">Look</string>
				<Content name="TextureId"><null></null></Content>
			</Properties>
			<Item class="Script" referent="RBX3647">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Search Tool</string>
					<ProtectedString name="Source">bin = script.Parent
local pack = bin.Parent
local player = pack.Parent
local debounce = false


function onButton1Down(mouse)
&#9;mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot;
&#9;local hit = mouse.Target
&#9;if (hit == nil) then return end
&#9;&#9;if  debounce == false then
&#9;&#9;&#9;local h = hit.Parent:findFirstChild(&quot;Stuff&quot;)
&#9;&#9;&#9;&#9;if h ~= nil  then
&#9;&#9;&#9;&#9;local g = h.Look
&#9;&#9;&#9;&#9;debounce = true
local textbox = player.PlayerGui.TextBox.Chat
&#9;&#9;&#9;&#9;textbox.Text = g.Value
&#9;&#9;&#9;&#9;wait(3)
&#9;&#9;&#9;&#9;textbox.Text = &quot; &quot;
&#9;&#9;&#9;&#9;debounce = false
&#9;&#9;&#9;end
&#9;&#9;end
&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
&#9;end



function onSelected(mouse)
&#9;print(&quot;Action Tool Selected&quot;)
&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end

bin.Selected:connect(onSelected)
</ProtectedString>
				</Properties>
			</Item>
		</Item>
		<Item class="HopperBin" referent="RBX3648">
			<Properties>
				<bool name="Active">false</bool>
				<token name="BinType">0</token>
				<string name="Name">Use</string>
				<Content name="TextureId"><null></null></Content>
			</Properties>
			<Item class="Script" referent="RBX3649">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Search Tool</string>
					<ProtectedString name="Source">bin = script.Parent
local pack = bin.Parent
local player = pack.Parent
local char = game.Workspace:findFirstChild(player.Name)
local debounce = false

function onButton1Down(mouse)
&#9;mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot;
&#9;local hit = mouse.Target
&#9;if (hit == nil) then return end

&#9;&#9;if debounce == false then
&#9;&#9;&#9;local h = hit.Parent:findFirstChild(&quot;Stuff&quot;)
&#9;&#9;&#9;&#9;if h ~= nil then
&#9;&#9;&#9;&#9;local g = h.Use
&#9;&#9;&#9;&#9;local item = g:findFirstChild(&quot;Item&quot;)
&#9;&#9;&#9;&#9;debounce = true
local textbox = player.PlayerGui.TextBox.Chat

&#9;&#9;&#9;&#9;textbox.Text = g.Value
&#9;&#9;&#9;&#9;if item ~= nil then
&#9;&#9;&#9;&#9;game.Lighting:findFirstChild(item.Value):clone().Parent = pack
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;wait(3)
&#9;&#9;&#9;&#9;textbox.Text = &quot; &quot;
&#9;&#9;&#9;&#9;debounce = false

&#9;&#9;&#9;end
&#9;&#9;end
&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
&#9;end



function onSelected(mouse)
&#9;print(&quot;Action Tool Selected&quot;)
&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end

bin.Selected:connect(onSelected)
</ProtectedString>
