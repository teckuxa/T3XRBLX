&#9;&#9;&#9;&#9;debounce = false
&#9;&#9;&#9;end
&#9;&#9;if (hit.Name == &quot;Painting2&quot;) and debounce == false then
&#9;&#9;&#9;&#9;debounce = true
&#9;&#9;&#9;&#9;textbox.Text = &quot;The crowbar will help me get back outside.&quot;
&#9;&#9;&#9;&#9;wait(3)
&#9;&#9;&#9;&#9;char.Torso.CFrame = CFrame.new(-18, 5.2, -75)
&#9;&#9;&#9;&#9;textbox.Text = &quot;I think it&apos;s almost over...&quot;
&#9;&#9;&#9;&#9;wait(3)
