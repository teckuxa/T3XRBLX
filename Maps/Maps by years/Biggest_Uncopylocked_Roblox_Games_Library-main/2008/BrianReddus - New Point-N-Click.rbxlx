&#9;&#9;if (hit.Parent.Name == &quot;Painting&quot;) and debounce == false then
&#9;&#9;&#9;&#9;debounce = true
&#9;&#9;&#9;&#9;textbox.Text = &quot;Hey! There&apos;s a hole behind this painting!&quot;
&#9;&#9;&#9;&#9;wait(3)
&#9;&#9;&#9;&#9;char.Torso.CFrame = CFrame.new(-32, 4.8, -76)
&#9;&#9;&#9;&#9;textbox.Text = &quot;It seems that there&apos;s a safe back here!&quot;
