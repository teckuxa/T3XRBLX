						<string name="Name">Script</string>
						<ProtectedString name="Source">debounce = false
function onTouched(hit)
&#9;if debounce == false then
&#9;&#9;&#9;if hit.Name ~= &quot;Handle&quot; then
&#9;&#9;&#9;&#9;if hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil then
&#9;&#9;&#9;&#9;debounce = true
&#9;&#9;&#9;player = game.Players:findFirstChild(hit.Parent.Name)
&#9;&#9;&#9;print(player.Name)
                          msg = player.PlayerGui.TextBox.Chat
                          msg.Text = (&quot;Hmm? This room is nearly empty...&quot;)
                          wait(5)
                          msg.Text = (&quot;It also looks like no one has been here for awhile...&quot;)
                          wait(4)
                          msg.Text = (&quot;You might get some info on that computer.&quot;)
                          wait(4)
                          msg.Text = (&quot;I wonder how to get out....&quot;)
                          wait(4)
                          msg.Text = &quot; &quot;
&#9;&#9;&#9;debounce = false
&#9;&#9;&#9;end
end
&#9;end
end

