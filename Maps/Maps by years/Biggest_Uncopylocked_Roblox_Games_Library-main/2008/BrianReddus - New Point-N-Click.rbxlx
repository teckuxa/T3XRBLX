&#9;&#9;help2.Visible = true
&#9;&#9;help3.Visible = true
&#9;else&#9;
&#9;&#9;isOn = false
&#9;&#9;help1.Visible = false
&#9;&#9;help2.Visible = false
&#9;&#9;help3.Visible = false
end
end


