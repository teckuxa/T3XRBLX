			<Item class="Script" referent="RBX3709">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Search Tool</string>
					<ProtectedString name="Source">bin = script.Parent
local pack = bin.Parent
local player = pack.Parent
local debounce = false
local char = game.Workspace:findFirstChild(player.Name)

local textbox = player.PlayerGui.TextBox.Chat

function onButton1Down(mouse)
&#9;mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot;
&#9;local hit = mouse.Target
&#9;if (hit == nil) then return end
&#9;&#9;if (hit.Name == &quot;FinalDoor&quot;) and debounce == false then
&#9;&#9;&#9;&#9;debounce = true
&#9;&#9;&#9;&#9;textbox.Text = &quot;Yes! The door is open!&quot;
&#9;&#9;&#9;&#9;wait (3)
&#9;&#9;&#9;&#9;textbox.Text = &quot;There&apos;s a ladder to go back up!&quot;
&#9;&#9;&#9;&#9;char.Torso.CFrame = CFrame.new(92, 19.2, -15)
&#9;&#9;&#9;&#9;wait (3)
&#9;&#9;&#9;&#9;textbox.Text = &quot;Wait... There&apos;s someone in here!&quot;
&#9;&#9;&#9;&#9;wait (3)
&#9;&#9;&#9;&#9;villian = player.PlayerGui.TextBox.Villian
&#9;&#9;&#9;&#9;villian.Visible = true
&#9;&#9;&#9;&#9;villian.Text = &quot;Hey! How did you get in here?!&quot;
&#9;&#9;&#9;&#9;textbox.Text = &quot; &quot;
&#9;&#9;&#9;&#9;wait (3)
&#9;&#9;&#9;&#9;villian.Text = &quot; &quot;
&#9;&#9;&#9;&#9;textbox.Text = &quot;Sir, I&apos;m here to arrest you for evil-doings!&quot;
&#9;&#9;&#9;&#9;wait (3)
&#9;&#9;&#9;&#9;villian.Text = &quot;NOOOOOO!&quot;
&#9;&#9;&#9;&#9;textbox.Text = &quot; &quot;
&#9;&#9;&#9;&#9;wait (3)
&#9;&#9;&#9;&#9;villian.Text = &quot;Wait, I have a permit for all of this.&quot;
&#9;&#9;&#9;&#9;textbox.Text = &quot; &quot;
&#9;&#9;&#9;&#9;wait (3)
&#9;&#9;&#9;&#9;villian.Text = &quot; &quot;
&#9;&#9;&#9;&#9;textbox.Text = &quot;Oh, okay.&quot;
&#9;&#9;&#9;&#9;wait (3)
&#9;&#9;&#9;&#9;villian.Text = &quot;THE&quot;
&#9;&#9;&#9;&#9;textbox.Text = &quot;END&quot;
&#9;&#9;&#9;&#9;wait (7)
&#9;&#9;&#9;&#9;villian.Text = &quot;I hope you enjoyed the place!&quot;
&#9;&#9;&#9;&#9;textbox.Text = &quot;Your master key works on all doors, so you&apos;re free to roam.&quot;
&#9;&#9;&#9;&#9;wait (10)
&#9;&#9;&#9;&#9;debounce = false
&#9;&#9;&#9;end
&#9;&#9;if (hit.Name == &quot;Attic1&quot;) and debounce == false then
&#9;&#9;&#9;&#9;debounce = true
&#9;&#9;&#9;&#9;textbox.Text = &quot;You use the MasterKey to open the Attic and get through!&quot;
&#9;&#9;&#9;&#9;wait(3)
&#9;&#9;&#9;&#9;char.Torso.CFrame = CFrame.new(26, 30, -135)
&#9;&#9;&#9;&#9;textbox.Text = &quot;It seems the attic leads to the room nearby!&quot;
&#9;&#9;&#9;&#9;wait(3)
&#9;&#9;&#9;&#9;textbox.Text = &quot;  &quot;
&#9;&#9;&#9;&#9;debounce = false
&#9;&#9;&#9;end
&#9;&#9;&#9;if (hit.Name == &quot;Attic2&quot;) and debounce == false then
&#9;&#9;&#9;&#9;debounce = true
&#9;&#9;&#9;&#9;textbox.Text = &quot;You use the Masterkey to get back out into the hallway&quot;
&#9;&#9;&#9;&#9;wait(3)
&#9;&#9;&#9;&#9;char.Torso.CFrame = CFrame.new(36, 30.8, -135)
&#9;&#9;&#9;&#9;textbox.Text = &quot; &quot;
&#9;&#9;&#9;&#9;debounce = false
&#9;&#9;&#9;end
&#9;&#9;if (hit.Name == &quot;Door1&quot;) and debounce == false then
&#9;&#9;&#9;&#9;debounce = true
&#9;&#9;&#9;&#9;textbox.Text = &quot;You use the Masterkey to open the door and get through!&quot;
&#9;&#9;&#9;&#9;wait(3)
&#9;&#9;&#9;&#9;char.Torso.CFrame = CFrame.new(46, 19, -135)
&#9;&#9;&#9;&#9;textbox.Text = &quot;To re-enter the room, just touch the door.&quot;
&#9;&#9;&#9;&#9;wait(3)
&#9;&#9;&#9;&#9;textbox.Text = &quot; &quot;
&#9;&#9;&#9;&#9;debounce = false
&#9;&#9;&#9;end
&#9;&#9;if (hit.Name == &quot;Door5&quot;) and debounce == false then
&#9;&#9;&#9;&#9;debounce = true
&#9;&#9;&#9;&#9;textbox.Text = &quot;You use the MasterKey to get back into the house!&quot;
&#9;&#9;&#9;&#9;wait(3)
&#9;&#9;&#9;&#9;char.Torso.CFrame = CFrame.new(60, 18, -61)
&#9;&#9;&#9;&#9;textbox.Text = &quot;To re-enter the final room, click on the door again.&quot;
&#9;&#9;&#9;&#9;wait(3)
&#9;&#9;&#9;&#9;textbox.Text = &quot; &quot;
&#9;&#9;&#9;&#9;debounce = false
&#9;&#9;&#9;end
&#9;&#9;if (hit.Name == &quot;Door7&quot;) and debounce == false then
&#9;&#9;&#9;&#9;debounce = true
&#9;&#9;&#9;&#9;textbox.Text = &quot;You use the MasterKey to get back in the final room!&quot;
&#9;&#9;&#9;&#9;wait(3)
&#9;&#9;&#9;&#9;char.Torso.CFrame = CFrame.new(63, 18.4, -44)
&#9;&#9;&#9;&#9;textbox.Text = &quot;To re-enter the house, click on the door again.&quot;
&#9;&#9;&#9;&#9;wait(3)
&#9;&#9;&#9;&#9;textbox.Text = &quot; &quot;
&#9;&#9;&#9;&#9;debounce = false
&#9;&#9;&#9;end
&#9;&#9;if (hit.Name == &quot;Door6&quot;) and debounce == false then
&#9;&#9;&#9;&#9;debounce = true
&#9;&#9;&#9;&#9;textbox.Text = &quot;You use the MasterKey to get back outside!&quot;
&#9;&#9;&#9;&#9;wait(3)
&#9;&#9;&#9;&#9;char.Torso.CFrame = CFrame.new(39, 18.4, -1)
&#9;&#9;&#9;&#9;textbox.Text = &quot;To re-enter the house, go back through the maze.&quot;
&#9;&#9;&#9;&#9;wait(3)
&#9;&#9;&#9;&#9;textbox.Text = &quot; &quot;
&#9;&#9;&#9;&#9;debounce = false
&#9;&#9;&#9;end
&#9;&#9;if (hit.Name == &quot;ElevatorKey&quot;) and debounce == false then
&#9;&#9;&#9;&#9;debounce = true
&#9;&#9;&#9;&#9;textbox.Text = &quot;You use the MasterKey to get back into the basement!&quot;
&#9;&#9;&#9;&#9;wait(3)
&#9;&#9;&#9;&#9;char.Torso.CFrame = CFrame.new(-31, 6.4, -16)
&#9;&#9;&#9;&#9;textbox.Text = &quot;To go back to the top floor, finish the game like normal.&quot;
&#9;&#9;&#9;&#9;wait(3)
&#9;&#9;&#9;&#9;textbox.Text = &quot; &quot;
&#9;&#9;&#9;&#9;debounce = false
&#9;&#9;&#9;end
--60, 18, -61
&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
&#9;end



function onSelected(mouse)
&#9;print(&quot;Action Tool Selected&quot;)
&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end

bin.Selected:connect(onSelected)
</ProtectedString>
				</Properties>
			</Item>
		</Item>
	</Item>
