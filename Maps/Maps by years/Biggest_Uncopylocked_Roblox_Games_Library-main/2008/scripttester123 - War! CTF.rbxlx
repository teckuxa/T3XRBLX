				<Item class="Script" referent="RBX1355">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">DoNotTouch</string>
						<ProtectedString name="Source">--ihaveamac
--Please don&apos;t mess with anything in this script.
local debounce = false
function onTouched(hit)
local human = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
local player = game.Players:findFirstChild(hit.Parent.Name)
if human ~= nil and debounce ~= true then
&#9;human.MaxHealth = 150
&#9;human.Health = 150
&#9;tools = player.Backpack:GetChildren()
&#9;for i = 1, #tools do
&#9;&#9;debounce = true
&#9;&#9;tools[i]:remove()
&#9;&#9;wait(0)

&#9;&#9;
&#9;end


&#9;tools = game.Lighting.PutToolsInHere:GetChildren()
&#9;for i = 1, #tools do

&#9;&#9;tools[i]:clone().Parent = player.Backpack
&#9;&#9;wait(0.5)
&#9;&#9;debounce = false
&#9;&#9;
&#9;end
local m = Instance.new(&quot;Message&quot;)
m.Parent = game.Players:playerFromCharacter(human.Parent)
m.Text = &quot;You now have VIP tools and 150 health!&quot;
game:GetService(&quot;Debris&quot;):AddItem(m, 4)
end
end
script.Parent.Touched:connect(onTouched)</ProtectedString>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX1356">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">-- list of account names allowed to go through the door.
permission = { &quot;Scripttester123&quot; } -- This is how many people can still get through, so u don&apos;t have to change shirts. You can also have another friend here.

-- TextureId of the VIP shirt.
texture = &quot;http://www.roblox.com/asset/?id=12905811&quot;
texture2 = &quot;http://www.roblox.com/asset/?id=25694951&quot;-- Inserting T-Shirt link instructions below

function checkOkToLetIn(name) 
    for i = 1,#permission do 
        -- convert strings to all upper case, otherwise we will let in 
        -- &quot;Username&quot; but not &quot;username&quot; or &quot;uSERNAME&quot; 
        if (string.upper(name) == string.upper(permission[i])) then return true end 
    end 
    return false 
end 

local Door = script.Parent

function onTouched(hit) 
    print(&quot;Door Hit&quot;) 
    local human = hit.Parent:findFirstChild(&quot;Humanoid&quot;) 
    if (human ~= nil ) then 
        if human.Parent.Torso.roblox.Texture == texture or human.Parent.Torso.roblox.Texture == texture2 then --the shirt 


            print(&quot;Human touched door&quot;) 
            -- test the human&apos;s name against the permission list 
        elseif (checkOkToLetIn(human.Parent.Name)) then 
            print(&quot;Human passed test&quot;) 

        else human.Health = 0 -- delete this line of you want a non-killing VIP door 
        end 
    end 
end 

script.Parent.Touched:connect(onTouched)

