						<string name="Name">DoNotTouch</string>
						<ProtectedString name="Source">--ihaveamac
--Please don&apos;t mess with anything in this script.
local debounce = false
function onTouched(hit)
local human = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
local player = game.Players:findFirstChild(hit.Parent.Name)
if human ~= nil and debounce ~= true then
&#9;human.MaxHealth = 150
&#9;human.Health = 150
&#9;tools = player.Backpack:GetChildren()
&#9;for i = 1, #tools do
&#9;&#9;debounce = true
&#9;&#9;tools[i]:remove()
&#9;&#9;wait(0)

&#9;&#9;
&#9;end


&#9;tools = game.Lighting.PutToolsInHere:GetChildren()
&#9;for i = 1, #tools do

&#9;&#9;tools[i]:clone().Parent = player.Backpack
&#9;&#9;wait(0.5)
&#9;&#9;debounce = false
&#9;&#9;
&#9;end
local m = Instance.new(&quot;Message&quot;)
m.Parent = game.Players:playerFromCharacter(human.Parent)
m.Text = &quot;You now have VIP tools and 150 health!&quot;
game:GetService(&quot;Debris&quot;):AddItem(m, 4)
end
end
