				</Item>
				<Item class="Script" referent="RBX975">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">system = script.Parent
model = system.Plane
backup = model:Clone()
regen = system.Regen

function checkRegen()
&#9;if regen.Value == 1 then
&#9;&#9;model = backup:Clone()
&#9;&#9;model.Parent = system
&#9;&#9;model:MakeJoints()
&#9;end
end
regen.Changed:connect(checkRegen)</ProtectedString>
					</Properties>
				</Item>
			</Item>
			<Item class="Script" referent="RBX976">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">RegenScript</string>
					<ProtectedString name="Source">system = script.Parent
model1 = system.Station1
backup1 = model1:Clone()
regen = system.Regen

function regenerate1(model,backup)
&#9;model:remove()
&#9;wait(1)
&#9;model1 = backup:Clone()
&#9;model1.Parent = system
&#9;model1:MakeJoints()
end

function checkRegen()
&#9;if regen.Value == 1 then
&#9;&#9;regenerate1(model1,backup1)
&#9;end
end
regen.Changed:connect(checkRegen)</ProtectedString>
				</Properties>
			</Item>
