						<ProtectedString name="Source">--This Teleporter is made for itachi1488
--This is the Teleporter script. This script is required to make the teleporter part work.
--Remember, you can NOT delete the IntValue, &quot;Enabled&quot;, in either of the teleporter bricks.
--To edit the tool, read the Instruction Manual and then edit the GiverScript.
--Finally, if you un-grouped the bricks, make sure you put them back together. Put them in the
--same model when you are done.

------------------------------------
modelname=&quot;VIP&quot;    --This is the brick name that you will be teleported to. You can change the name to make it so that it will teleport to the correct place
------------------------------------

function onTouched(part)  --DO NOT EDIT ANYTHING FROM LINES 11-54, OR THE TELEPORTER WILL BE SEVERELY DAMAGED.
&#9;if part.Parent ~= nil then
&#9;local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;&#9;if h~=nil then
&#9;&#9;&#9;local teleportfrom=script.Parent.Enabled.Value
&#9;&#9;&#9;if teleportfrom~=0 then
&#9;&#9;&#9;&#9;if h==humanoid then
&#9;&#9;&#9;&#9;return
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;local teleportto=game.Workspace.VIP
&#9;&#9;&#9;&#9;if teleportto~=nil then
&#9;&#9;&#9;&#9;&#9;local torso = h.Parent.Torso
&#9;&#9;&#9;&#9;&#9;local location = {teleportto.Position}
&#9;&#9;&#9;&#9;&#9;local i = 1

&#9;&#9;&#9;&#9;&#9;local x = location[i].x
&#9;&#9;&#9;&#9;&#9;local y = location[i].y
&#9;&#9;&#9;&#9;&#9;local z = location[i].z
&#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;&#9;x = x + math.random(-1, 1)
&#9;&#9;&#9;&#9;&#9;z = z + math.random(-1, 1)
&#9;&#9;&#9;&#9;&#9;y = y + math.random(2, 3)

&#9;&#9;&#9;&#9;&#9;local cf = torso.CFrame
&#9;&#9;&#9;&#9;&#9;local lx = 0
&#9;&#9;&#9;&#9;&#9;local ly = y
&#9;&#9;&#9;&#9;&#9;local lz = 0
&#9;&#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;&#9;script.Parent.Enabled.Value=0
&#9;&#9;&#9;&#9;&#9;torso.CFrame = CFrame.new(Vector3.new(x,y,z), Vector3.new(lx,ly,lz))
&#9;&#9;&#9;&#9;&#9;wait(3)
&#9;&#9;&#9;&#9;&#9;script.Parent.Enabled.Value=1

&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;print(&quot;Could not find teleporter!&quot;)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

