		<Item class="Script" referent="RBX463">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">game</string>
				<ProtectedString name="Source">local GFB = game.Workspace.GreenFlagSet:clone()
local RFB = game.Workspace.RedFlagSet:clone()

local h = Instance.new(&quot;Hint&quot;)
h.Parent = game.Workspace
local time = 900


function reset()
&#9;time = 900
&#9;p = game.Players:GetChildren()
&#9;for i = 1,#p do
&#9;p[i].Character.Head:remove()
&#9;end
&#9;local m = Instance.new(&quot;Message&quot;)
&#9;m.Parent = game.Workspace
&#9;m.Text = &quot;New game is starting! Flags reset. Have fun!:D&quot;
&#9;game.Workspace.GreenFlagSet:Remove()
&#9;game.Workspace.RedFlagSet:Remove()
&#9;local rc = RFB:clone()
&#9;rc.Parent = game.Workspace
&#9;local gc = GFB:clone()
&#9;gc.Parent = game.Workspace
&#9;wait(5)
&#9;m:remove()
end
while true do
&#9;h.Text = &quot;There are &quot; ..time.. &quot; seconds left in the game!!&quot;
&#9;wait(1)
&#9;time = time - 1
&#9;if time == 0 then
&#9;&#9;reset()
&#9;end
end 

</ProtectedString>
			</Properties>
		</Item>
