				<Item class="Script" referent="RBX2531">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">system = script.Parent
model = system.Plane
backup = model:Clone()
regen = system.Regen

function checkRegen()
&#9;if regen.Value == 1 then
&#9;&#9;model = backup:Clone()
&#9;&#9;model.Parent = system
&#9;&#9;model:MakeJoints()
&#9;end
end
regen.Changed:connect(checkRegen)</ProtectedString>
					</Properties>
				</Item>
				<Item class="IntValue" referent="RBX2532">
					<Properties>
						<string name="Name">Regen</string>
						<int name="Value">0</int>
					</Properties>
