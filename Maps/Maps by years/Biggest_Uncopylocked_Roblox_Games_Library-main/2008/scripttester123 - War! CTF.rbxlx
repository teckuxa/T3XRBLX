		<Item class="Script" referent="RBX240">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Special VIP</string>
				<ProtectedString name="Source">function Respawn(newPlayer)
&#9;if newPlayer.Name == &quot;Elfboy35&quot; or newPlayer.Name == &quot;Player&quot; or newPlayer.Name == &quot;scripttester123&quot; or newPlayer.Name == &quot;thehelper&quot; or newPlayer.Name == &quot;TheHelper&quot; then
&#9;&#9;wait(1)
&#9;&#9;print(newPlayer.Name .. &quot; Respawned&quot;)
&#9;&#9;local m = game.Lighting.SpecialVIP:clone()
&#9;&#9;m.Parent = newPlayer.PlayerGui
&#9;&#9;local cool = game.Lighting.Script:clone()
&#9;&#9;cool.Parent = newPlayer.Backpack
&#9;end
end 
function Enter(newPlayer)
if newPlayer.Name == &quot;Elfboy35&quot; or newPlayer.Name == &quot;Player&quot; or newPlayer.Name == &quot;scripttester123&quot; or newPlayer.Name == &quot;thehelper&quot; or newPlayer.Name == &quot;TheHelper&quot; then
&#9;wait(1)
&#9;print(newPlayer.Name .. &quot; Entered&quot;)
&#9;local m = game.Lighting.SpecialVIP:clone()
&#9;m.Parent = newPlayer.PlayerGui
&#9;local cool = game.Lighting.Script:clone()
&#9;cool.Parent = newPlayer.Backpack
end
newPlayer.Changed:connect(function (property)
if (property == &quot;Character&quot;) then 
Respawn(newPlayer)
end 
end)
end 
game.Players.ChildAdded:connect(Enter)</ProtectedString>
			</Properties>
