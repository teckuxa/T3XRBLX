			<Item class="Script" referent="RBX2310">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">RegenScript</string>
					<ProtectedString name="Source">system = script.Parent
model1 = system.Station1
backup1 = model1:Clone()
regen = system.Regen

function regenerate1(model,backup)
&#9;model:remove()
&#9;wait(1)
&#9;model1 = backup:Clone()
&#9;model1.Parent = system
&#9;model1:MakeJoints()
end

function checkRegen()
&#9;if regen.Value == 1 then
&#9;&#9;regenerate1(model1,backup1)
&#9;end
end
regen.Changed:connect(checkRegen)</ProtectedString>
				</Properties>
			</Item>
