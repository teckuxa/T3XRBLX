			<Item class="Script" referent="RBX2753">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">script.Parent.Selected:connect(function(mouse)
mouse.Button1Down:connect(function()


hi = script.Parent.Mine:Clone()
hi.Mine.Position = mouse.Hit.p + Vector3.new(0,0.5,0)
hi.this.CFrame = hi.Mine.CFrame*CFrame.new(0,0.5,0)

hi.Mine.BrickColor = script.Parent.Parent.Parent.TeamColor
hi.Parent = game.Workspace
wait(0.1)
script.Parent:Remove()
end)
end)</ProtectedString>
				</Properties>
			</Item>
