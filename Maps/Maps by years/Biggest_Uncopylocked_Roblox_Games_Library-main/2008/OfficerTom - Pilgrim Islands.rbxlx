					<Item class="Script" referent="RBX3260">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<string name="Source">system = script.Parent
go = system.Go
stop = system.Stop
left = system.Left
right = system.Right
bottom = system.ShipBottom
bottomforce = bottom.BodyPosition.maxForce

local debounce = false

function onTouchGo(part)
	local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if h ~= nil then
	if bottom:findFirstChild(&quot;GasScript&quot;) ~= nil then return end
	local gas = script.GasScript:clone()
	gas.Disabled = false
	gas.Parent = bottom
	end
end

function onTouchStop(part)
	local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if h ~= nil then
	if bottom:findFirstChild(&quot;GasScript&quot;) ~= nil then
	bottom.GasScript:remove()
	end

	local bottompos = bottom.Position

	bottom:findFirstChild(&quot;BodyPosition&quot;).position = bottompos
	bottom:findFirstChild(&quot;BodyPosition&quot;).maxForce = Vector3.new(&quot;9e+031&quot;, &quot;9e+031&quot;, &quot;9e+031&quot;)
	wait(2)
	bottom:findFirstChild(&quot;BodyPosition&quot;).position = Vector3.new(0, 0, 0)
	bottom:findFirstChild(&quot;BodyPosition&quot;).maxForce = bottomforce
	end
end

function onTouchLeft(part)
	local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if h ~= nil then
	if left.Value.Value == 0 and debounce == false and right.Value.Value == 0 then
	debounce = true
	left.Value.Value = 1
	left.BrickColor = BrickColor.Black()
	local leftscript = script.LeftScript:clone()
	leftscript.Disabled = false
	leftscript.Parent = bottom
	wait(0.5)
	debounce = false
	return end

	if left.Value.Value == 1 and debounce == false then
	debounce = true
	left.Value.Value = 0
	left.BrickColor = BrickColor.Yellow()
	if bottom:findFirstChild(&quot;LeftScript&quot;) ~= nil then
	bottom:findFirstChild(&quot;LeftScript&quot;):remove()
	end
	wait(0.5)
	debounce = false
	end

	end
end

function onTouchRight(part)
	local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if h ~= nil then
	if right.Value.Value == 0 and debounce == false and left.Value.Value == 0 then
	debounce = true
	right.Value.Value = 1
	right.BrickColor = BrickColor.Black()
	local rightscript = script.RightScript:clone()
	rightscript.Disabled = false
	rightscript.Parent = bottom
	wait(0.5)
	debounce = false
	return end

	if right.Value.Value == 1 and debounce == false then
	debounce = true
	right.Value.Value = 0
	right.BrickColor = BrickColor.Yellow()
	if bottom:findFirstChild(&quot;RightScript&quot;) ~= nil then
	bottom:findFirstChild(&quot;RightScript&quot;):remove()
	end
	wait(0.5)
	debounce = false
	end

	end
end
go.Touched:connect(onTouchGo)
stop.Touched:connect(onTouchStop)
left.Touched:connect(onTouchLeft)
right.Touched:connect(onTouchRight)</string>
							<bool name="archivable">true</bool>
						</Properties>
						<Item class="Script" referent="RBX3261">
							<Properties>
								<bool name="Disabled">true</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">GasScript</string>
								<string name="Source">ship = script.Parent
position = ship.Position

function fly()
	direction = ship.CFrame.lookVector 
	position = position +2 * direction
	error = position - ship.Position
	ship.Velocity = 1*error
end 

while true do
	wait(0.3)
	fly()
end
</string>
								<bool name="archivable">true</bool>
							</Properties>
						</Item>
						<Item class="Script" referent="RBX3262">
