				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Buildingrespawn</string>
				<string name="Source">model = game.Workspace.Anobi
messageText = &quot;Remaking Materials..&quot;

message = Instance.new(&quot;Message&quot;)
message.Text = messageText
backup = model:clone()

while true do
	wait(250) -- regenerate this model every 300 seconds

	message.Parent = game.Workspace
	model:remove()

	wait(4) -- display regen message for 4 seconds

	model = backup:clone()
	model.Parent = game.Workspace
	model:makeJoints()
	message.Parent = nil
end</string>
