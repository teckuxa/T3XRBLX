								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">SunkScript</string>
								<string name="Source">ship = script.Parent.Parent.Parent

while true do
	wait(1)

	local position = script.Parent.Position

	if position.y &lt; -40 then
	ship:remove()
	break end

end </string>
