		<Item class="Script" referent="RBX717">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Boatsyrespawn</string>
				<string name="Source">model = game.Workspace.Boatses
messageText = &quot;Regenerating Boats..&quot;

message = Instance.new(&quot;Message&quot;)
message.Text = messageText
backup = model:clone()

while true do
	wait(10000) -- regenerate this model every 300 seconds

	message.Parent = game.Workspace
	model:remove()

	wait(4) -- display regen message for 4 seconds

	model = backup:clone()
	model.Parent = game.Workspace
	model:makeJoints()
	message.Parent = nil
end</string>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
