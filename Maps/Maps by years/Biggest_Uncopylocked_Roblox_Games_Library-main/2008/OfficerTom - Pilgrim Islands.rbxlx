								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">TouchScript</string>
								<string name="Source">ship = script.Parent.Parent

function onTouch(part)
	if part.Name == &quot;Water&quot; then return end
	local gas = script.Parent:findFirstChild(&quot;GasScript&quot;)
	if gas ~= nil then
	gas:remove()
	end
end 
script.Parent.Touched:connect(onTouch)</string>
