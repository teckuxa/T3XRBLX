								<bool name="Disabled">true</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">LeftScript</string>
								<string name="Source">while true do
	script.Parent.RotVelocity = Vector3.new(0, 0.1, 0)
	wait()
end
</string>
								<bool name="archivable">true</bool>
							</Properties>
						</Item>
						<Item class="Script" referent="RBX3046">
