						<string name="Name">Script</string>
						<string name="Source">script.Parent.Equipped:connect(function()
	script.Parent.Heal.Changed:connect(function()
		local a = script.Parent.Handle.Mesh.Scale.x-0.01
		if a &gt; 0 then
			script.Parent.Handle.Mesh.Scale = Vector3.new(a, a, a)
			script.Parent.Parent.Humanoid.Health = script.Parent.Parent.Humanoid.Health + 1
			else
			script.Parent:remove()
		end
	end)
end)
