						<string name="Source">local cl = nil
local time = 15

for _, i in ipairs(script.Parent.Parent:GetChildren()) do
	if i.className == &quot;Tool&quot; then cl = i:clone() break end
end

script.Parent.Parent.ChildRemoved:connect(function()
	print(&quot;Taken&quot;)
	wait(time)
	print(&quot;Regened&quot;)
	cl:clone().Parent = script.Parent.Parent
end)
