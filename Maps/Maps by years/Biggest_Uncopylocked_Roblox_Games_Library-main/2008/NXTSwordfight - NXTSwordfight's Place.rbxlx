			<Item class="Script" referent="RBX139">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<string name="Source">script.Parent.On.Click.MouseClick:connect(function() 
	if script.Parent.Go.Value then
		script.Parent.Go.Value = false
		--script.Parent.On.BrickColor = BrickColor.new(21)
		else
		script.Parent.Go.Value = true
		--script.Parent.On.BrickColor = BrickColor.new(28)	
	end
end)

while true do
	if script.Parent.Go.Value then
		script.Parent.Engine.Force.velocity = script.Parent.Engine.CFrame.lookVector*20
		else
		script.Parent.Engine.Force.velocity = Vector3.new(0, 0, 0)
	end
	wait(0.1)
end </string>
					<bool name="archivable">true</bool>
				</Properties>
