				<Item class="LocalScript" referent="RBX67">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Trans</string>
						<string name="Source">local tl = script.Parent
local lastPos = Vector3.new()

tl.Equipped:connect(function(mouse)
	mouse.Button1Down:connect(function()
		tl.Go.Value = not tl.Go.Value
	end)
	mouse.Move:connect(function()
		print(mouse.X, &quot;, &quot;, mouse.Y)
		local x = ((mouse.ViewSizeX/2) - mouse.X)*1.57/(mouse.ViewSizeX/2)
		local y = 0
		if mouse.Y &gt; (mouse.ViewSizeY/2) then
			y = 0
			else
			y = math.abs(mouse.Y-(mouse.ViewSizeY/2))*1.57/(mouse.ViewSizeY/2)
		end
		tl.MousePos.Value = Vector3.new(x, y, 0)
	end)
	mouse.KeyDown:connect(function(key) 
		if key == &apos;q&apos; then
			tl.Spec.Value = not tl.Spec.Value
		end
	end)
end)
</string>
