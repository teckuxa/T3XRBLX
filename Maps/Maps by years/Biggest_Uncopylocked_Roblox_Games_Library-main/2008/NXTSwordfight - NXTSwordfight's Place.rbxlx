				<Item class="Script" referent="RBX743">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<string name="Source">deb = false

function touch(part)
	if deb then return else deb = true end
	delay(0.4, function() deb = false end)
	local player = game.Players:playerFromCharacter(part.Parent)
	if player then
		if not player.Character:FindFirstChild(&quot;Torso&quot;) then return end
		player.Character.Torso.Anchored = true
		local dist = (script.Parent.Parent.End.Position - player.Character.Torso.Position).magnitude
		for i = 1, dist+2, 2 do
			if not player.Character:FindFirstChild(&quot;Torso&quot;) then return end
			player.Character.Torso.CFrame = CFrame.new(script.Parent.Parent.Start.Position, script.Parent.Parent.End.Position)*CFrame.new(0, 0, -i)*CFrame.fromEulerAnglesXYZ(-math.pi/2, 0, 0)
			wait(0.1)
		end
		if player.Character:FindFirstChild(&quot;Torso&quot;) then player.Character.Torso.Anchored = false end
	end
end
script.Parent.Touched:connect(touch)

</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
