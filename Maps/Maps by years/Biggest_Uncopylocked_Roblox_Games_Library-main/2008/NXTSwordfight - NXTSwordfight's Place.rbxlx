						<string name="Source">local tl = script.Parent

tl.Equipped:connect(function(mouse)
	local down = false
	mouse.Button1Down:connect(function()
		down = true
		while down do
			tl.Heal.Value = not tl.Heal.Value
			wait()
		end
	end)
	mouse.Button1Up:connect(function() down = false end)
end)
