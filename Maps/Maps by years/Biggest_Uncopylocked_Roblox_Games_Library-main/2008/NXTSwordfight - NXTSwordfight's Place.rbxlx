		<Item class="Tool" referent="RBX796">
			<Properties>
				<int name="ActivationState">0</int>
				<int name="BackendToolState">1</int>
				<bool name="Enabled">true</bool>
				<CoordinateFrame name="Grip">
					<X>0</X>
					<Y>0</Y>
					<Z>-1.5</Z>
					<R00>0</R00>
					<R01>0</R01>
					<R02>1</R02>
					<R10>1</R10>
					<R11>0</R11>
					<R12>0</R12>
					<R20>0</R20>
					<R21>1</R21>
					<R22>0</R22>
				</CoordinateFrame>
				<string name="Name">Sword</string>
				<Content name="TextureId"><url>rbxasset://Textures\Sword128.png</url></Content>
				<bool name="archivable">true</bool>
			</Properties>
			<Item class="LocalScript" referent="RBX797">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Trans</string>
					<string name="Source">local tl = script.Parent
local lastPos = Vector3.new()

tl.Equipped:connect(function(mouse)
	mouse.Button1Down:connect(function()
		tl.Go.Value = not tl.Go.Value
	end)
	mouse.Move:connect(function()
		print(mouse.X, &quot;, &quot;, mouse.Y)
		local x = ((mouse.ViewSizeX/2) - mouse.X)*1.57/(mouse.ViewSizeX/2)
		local y = 0
		if mouse.Y &gt; (mouse.ViewSizeY/2) then
			y = 0
			else
			y = math.abs(mouse.Y-(mouse.ViewSizeY/2))*1.57/(mouse.ViewSizeY/2)
		end
		tl.MousePos.Value = Vector3.new(x, y, 0)
	end)
	mouse.KeyDown:connect(function(key) 
		if key == &apos;q&apos; then
			tl.Spec.Value = not tl.Spec.Value
		end
	end)
end)
</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="Vector3Value" referent="RBX798">
				<Properties>
					<string name="Name">MousePos</string>
					<Vector3 name="Value">
						<X>0</X>
						<Y>0</Y>
						<Z>0</Z>
					</Vector3>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX799">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Attack</string>
					<string name="Source">local tl = script.Parent
local player = nil
local weld = nil
local orig = CFrame.new()
local sl = tl.Slash
local specDeb = false
local noTk = false
local Blocked = false

local SlashSound = Instance.new(&quot;Sound&quot;)
SlashSound.SoundId = &quot;rbxasset://sounds\\swordslash.wav&quot;
SlashSound.Parent = tl.Handle
SlashSound.Volume = .7

local UnsheathSound = Instance.new(&quot;Sound&quot;)
UnsheathSound.SoundId = &quot;rbxasset://sounds\\unsheath.wav&quot;
UnsheathSound.Parent = tl.Handle
UnsheathSound.Volume = 1

local damage = 10

function blow(hit)
	if (hit.Parent == nil) then return end --bullet hits sword
	if Blocked and not noTk then return end --special going
	if weld == nil then return end --sword not equipped
	local humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
	if humanoid~=nil and humanoid ~= tl.Parent.Humanoid then
		if not weld.C1 or not weld.C0 then print(&quot;player is dead&quot;) return end --weilder is dead
		local tag = Instance.new(&quot;ObjectValue&quot;) --create tag
		tag.Value, tag.Name = game.Players:playerFromCharacter(tl.Parent), &quot;creator&quot;
		tag.Parent = humanoid
		if sl.Value then damage = 10+(tl.MousePos.Value.y*12) else damage = 10 end --damage increase
		if noTk then damage = 30 end
		humanoid:TakeDamage(damage)
		print(&quot;Damaged&quot;)
		wait(1)
		if tag then tag:remove() end
		elseif hit:FindFirstChild(&quot;Blade&quot;) ~= nil then
		Blocked = true
		wait(1)
		Blocked = false
	end
end

function atk()
	if not noTk then
		sl.Value = true
		SlashSound:play()
		local anim = Instance.new(&quot;StringValue&quot;)
		anim.Name = &quot;toolanim&quot;
		anim.Value = &quot;Slash&quot;
		anim.Parent = tl
	end
end

function spec()
	if weld and not specDeb then
		specDeb = true
		noTk = true
		for i = 1, 5, 0.1 do
			wait()
			weld.C1 = orig*CFrame.fromEulerAnglesXYZ(2*math.abs(math.cos(i)+0.5), 0, 2*math.sin(i*2))
		end
		noTk = false
		wait(15)
		specDeb = false
	end
end

function mov()
	if weld and not noTk then
		weld.C1 = orig*CFrame.fromEulerAnglesXYZ(tl.MousePos.Value.y, 0 --[[tl.MousePos.Value.x]], -tl.MousePos.Value.x)
	end
end

function weldThis()
local w = Instance.new(&quot;Weld&quot;)
w.Parent, w.Part0 = tl.Handle, tl.Handle
w.Part1 = tl.Handle2
end

tl.Equipped:connect(function()
	UnsheathSound:play()
	player = game.Players:playerFromCharacter(tl.Parent)
	weld = player.Character[&quot;Right Arm&quot;].RightGrip
	orig = weld.C1
	script.Parent.MousePos.Changed:connect(mov)
	script.Parent.Go.Changed:connect(atk)
	script.Parent.Spec.Changed:connect(spec)
end)

tl.Changed:connect(function(p) if p == &quot;Parent&quot; then weldThis() end end)
tl.Unequipped:connect(function() weld = nil end)
sl.Changed:connect(function() if sl.Value then wait(0.3) sl.Value = false end end)
script.Parent.Handle.Touched:connect(blow)

weldThis()


	
</string>
