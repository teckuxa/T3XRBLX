				<Item class="Script" referent="RBX728">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Attack</string>
						<string name="Source">local tl = script.Parent
local player = nil
local weld = nil
local orig = CFrame.new()
local sl = tl.Slash
local specDeb = false
local Blocked = false

local SlashSound = Instance.new(&quot;Sound&quot;)
SlashSound.SoundId = &quot;rbxasset://sounds\\swordslash.wav&quot;
SlashSound.Parent = tl.Handle
SlashSound.Volume = .7

local UnsheathSound = Instance.new(&quot;Sound&quot;)
UnsheathSound.SoundId = &quot;rbxasset://sounds\\unsheath.wav&quot;
UnsheathSound.Parent = tl.Handle
UnsheathSound.Volume = 1

local damage = 10

function blow(hit)
	print(pcall(function()
	if (hit.Parent == nil) then return end --bullet hits sword
	if Blocked then return end --special going
	if weld == nil then return end --sword not equipped
	local humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
	if humanoid~=nil and humanoid ~= tl.Parent.Humanoid then
		if not weld.C1 or not weld.C0 then print(&quot;player is dead&quot;) return end --weilder is dead
		local tag = Instance.new(&quot;ObjectValue&quot;) --create tag
		tag.Value, tag.Name = game.Players:playerFromCharacter(tl.Parent), &quot;creator&quot;
		tag.Parent = humanoid
		if true then damage = 10+(tl.MousePos.Value.y*12) else damage = 10 end --damage increase
		humanoid:TakeDamage(damage)
		print(&quot;Damaged&quot;)
		wait(1)
		if tag then tag:remove() end
		elseif hit:FindFirstChild(&quot;Blade&quot;) ~= nil then
		Blocked = true
		wait(1)
		Blocked = false
	end
	end))
end

function atk()
	sl.Value = true
	SlashSound:play()
	local anim = Instance.new(&quot;StringValue&quot;)
	anim.Name = &quot;toolanim&quot;
	anim.Value = &quot;Slash&quot;
	anim.Parent = tl
end

local TempDmg = 30

function specHit(hit, sender)
	local h = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
	local hh = hit.Parent.Parent:FindFirstChild(&quot;Humanoid&quot;)
	if h then
		if h == tl.Parent.Humanoid then return end
		sender.CanCollide = false
		h:TakeDamage(TempDmg)
		TempDmg = TempDmg - 5
		else
		if not hh then sender.CanCollide = true end
	end
end

function spec()
	if weld and not specDeb then
		specDeb = true
		TempDmg = 25
		local b = tl.Handle:clone()
		b.CanCollide = true
		b.Position = b.Position+tl.Parent.Torso.CFrame.lookVector*1.5
		b.Parent = game.Workspace
		b.Velocity = CFrame.new(b.Position, tl.MouseHit.Value).lookVector*75
		b.Touched:connect(function(hit) specHit(hit, b) end)
		wait(2)
		b:remove()
		wait(2)
		specDeb = false
	end
end

function mov()
	if weld then
		weld.C1 = orig*CFrame.fromEulerAnglesXYZ(tl.MousePos.Value.y, 0 --[[tl.MousePos.Value.x]], -tl.MousePos.Value.x)
	end
end

function weldThis()
local w = Instance.new(&quot;Weld&quot;)
w.Parent, w.Part0 = tl.Handle, tl.Handle
w.Part1 = tl.Handle2
end

tl.Equipped:connect(function()
	tl.Handle2.CanCollide = false
	UnsheathSound:play()
	player = game.Players:playerFromCharacter(tl.Parent)
	weld = player.Character[&quot;Right Arm&quot;].RightGrip
	orig = weld.C1
	script.Parent.MousePos.Changed:connect(mov)
	script.Parent.Go.Changed:connect(atk)
	script.Parent.Spec.Changed:connect(spec)
end)

tl.Changed:connect(function(p)
	if p == &quot;Parent&quot; then
		weldThis()
	end
end)

tl.Unequipped:connect(function() weld = nil end)
sl.Changed:connect(function() if sl.Value then wait(0.3) sl.Value = false end end)
script.Parent.Handle.Touched:connect(blow)

weldThis()
	
</string>
