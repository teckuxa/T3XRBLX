			<Item class="Tool" referent="RBX725">
				<Properties>
					<int name="ActivationState">0</int>
					<int name="BackendToolState">2</int>
					<bool name="Enabled">true</bool>
					<CoordinateFrame name="Grip">
						<X>0</X>
						<Y>0</Y>
						<Z>-1.5</Z>
						<R00>0</R00>
						<R01>0</R01>
						<R02>1</R02>
						<R10>1</R10>
						<R11>0</R11>
						<R12>0</R12>
						<R20>0</R20>
						<R21>1</R21>
						<R22>0</R22>
					</CoordinateFrame>
					<string name="Name">Cyclone-Blade</string>
					<Content name="TextureId"><url>rbxasset://Textures\Sword128.png</url></Content>
					<bool name="archivable">true</bool>
				</Properties>
				<Item class="LocalScript" referent="RBX726">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Trans</string>
						<string name="Source">local tl = script.Parent
local lastPos = Vector3.new()

tl.Equipped:connect(function(mouse)
	mouse.Button1Down:connect(function()
		tl.Go.Value = not tl.Go.Value
	end)
	mouse.Move:connect(function()
		print(mouse.X, &quot;, &quot;, mouse.Y)
		local x = ((mouse.ViewSizeX/2) - mouse.X)*1.57/(mouse.ViewSizeX/2)
		local y = 0
		if mouse.Y &gt; (mouse.ViewSizeY/2) then
			y = 0
			else
			y = math.abs(mouse.Y-(mouse.ViewSizeY/2))*1.57/(mouse.ViewSizeY/2)
		end
		tl.MousePos.Value = Vector3.new(x, y, 0)
		tl.MouseHit.Value = mouse.Hit.p
	end)
	mouse.Idle:connect(function()
		tl.MouseHit.Value = mouse.Hit.p
	end)
	mouse.KeyDown:connect(function(key) 
		if key == &apos;q&apos; then
			tl.Spec.Value = not tl.Spec.Value
		end
	end)
end)
