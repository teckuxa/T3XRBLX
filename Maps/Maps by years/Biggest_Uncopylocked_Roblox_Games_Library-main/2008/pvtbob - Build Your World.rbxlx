			<Item class="Script" referent="RBX3912">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">MapCompressor</string>
					<ProtectedString name="Source">-- Using this script is VERY simple.
-- You just have to group your map in a model
-- and put the model in this script. Simple like
-- that. When you do that, run the place and
-- a stringvalue will appear. Upload it and send
-- a PM to SirGelatina with the link to the model

-- MapDecompressor will be released soon.

function explode(div,str)
&#9;if (div==&apos;&apos;) then return false end 
&#9;&#9;local pos,arr = 0,{} 
&#9;&#9;for st,sp in function() return string.find(str,div,pos,true) end do 
&#9;&#9;&#9;table.insert(arr,string.sub(str,pos,st-1))
&#9;&#9;&#9;pos = sp + 1
&#9;&#9;end 
&#9;&#9;table.insert(arr,string.sub(str,pos))
&#9;return arr 
end

--[[
1 - X
2 - Z
3 - Size
4 - Color
5 - Tree/Gold
]]

local children = script:getChildren()
for i=1, #children do

str = &quot;&quot;
local list = children[i]:getChildren()
for x=1, #list do
&#9;local pos = explode(&quot;|&quot;, list[x].Name)
&#9;str = str .. pos[1] .. &quot;-&quot; .. pos[2] .. &quot;-&quot; .. explode(&quot;.&quot;, tostring(list[x].Size.y / 1.2))[1] .. &quot;-&quot; .. tostring(list[x].BrickColor)
&#9;if list[x]:findFirstChild(&quot;Forest&quot;) ~= nil then
&#9;&#9;str = str .. &quot;-T&quot;
&#9;end
&#9;if list[x]:findFirstChild(&quot;Gold&quot;) ~= nil then
&#9;&#9;str = str .. &quot;-G&quot;
&#9;end
&#9;str = str .. &quot;|&quot;
end

local M = Instance.new(&quot;StringValue&quot;)
M.Name = children[i].Name
M.Parent = game.Workspace
M.Value = str

end
</ProtectedString>
				</Properties>
			</Item>
