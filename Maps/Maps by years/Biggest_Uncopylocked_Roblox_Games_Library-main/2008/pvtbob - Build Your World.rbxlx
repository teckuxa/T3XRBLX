								<ProtectedString name="Source">while true do
     A = script.Parent
wait(0.1)
     A.BrickColor = BrickColor.new(24)
wait(0.1)
     A.BrickColor = BrickColor.new(106)
wait(0.1)
     A.BrickColor = BrickColor.new(21)
wait(0.1)
     A.BrickColor = BrickColor.new(24)
wait(0.1)
     A.BrickColor = BrickColor.new(106)
wait(0.1)
