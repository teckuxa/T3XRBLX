while true do 

&#9;&#9;light.Transparency = .5
&#9;
&#9;&#9;wait(.2) 

&#9;&#9;light.Transparency = .2

&#9;&#9;wait(.2) 

&#9;&#9;light.Transparency = 1

&#9;&#9;wait(.2) 

&#9;&#9;light.Transparency = .6

&#9;&#9;wait(.2) 

&#9;&#9;light.Transparency = .5
&#9;&#9;
&#9;&#9;wait(.2) 

&#9;&#9;light.Transparency = 0

&#9;&#9;wait(.2) 

&#9;&#9;light.Transparency = .2

&#9;&#9;wait(.2) 

&#9;&#9;light.Transparency = .1

&#9;&#9;wait(.2)

&#9;&#9;light.Transparency = .7

&#9;&#9;wait(.2)

&#9;&#9;light.Transparency = .6

&#9;&#9;wait(.2)

end 
</ProtectedString>
