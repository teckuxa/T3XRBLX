							<string name="Name">Script</string>
							<ProtectedString name="Source">function givetool(player)
	tool = script.Parent[&quot;Place Miner&quot;]:clone()
	tool.Parent = player.Backpack
end

function request(part)
	player = game.Players:findFirstChild(part.Parent.Name)
	if player == nil then return end
	if player.leaderstats[&quot;$&quot;].Value &gt;= 4000 then
		player.leaderstats[&quot;$&quot;].Value = player.leaderstats[&quot;$&quot;].Value - 4000
		givetool(player)
	end
end

script.Parent.Touched:connect(request)
