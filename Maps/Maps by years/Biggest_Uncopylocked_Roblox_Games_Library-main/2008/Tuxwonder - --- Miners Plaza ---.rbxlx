						<string name="Name">VipDoor</string>
						<ProtectedString name="Source">killing = true --change this to false if you want a non killing door.
mode = &quot;TShirt&quot; --change this to either &quot;Off&quot;,&quot;Shirt&quot;, &quot;TShirt&quot;, &quot;Pant&quot;, &quot;Decal&quot;, &quot;Team&quot;, or &quot;Hat&quot;(anyone on the permission list will still be able to access the door.)
team = &quot;Killers&quot; -- change this if you are using the Team mode to the name of the team allowed in the door(anyone on the permission list will still be allowed)
Texture = &quot;http://www.roblox.com/asset/?id=19847452&quot;  --This is the texture of the item accepted, if it is hat then use the hats name like CPlusPlusTextBook
time = 2 --change this to the time until the door will close
permission = {&quot;veka&quot;,&quot;BocaDude&quot;,&quot;stevenmeow123&quot;,&quot;wrentchhead&quot;,&quot;aviola1998&quot;,&quot;nicky21230&quot;,&quot;Awesome860&quot;,&quot;SkittlesTNEB&quot;,&quot;kokjon&quot;,&quot;donkeyo4&quot;,&quot;mnbvc655&quot;,&quot;macj1997&quot;,&quot;masterblaster600&quot;,&quot;killerman321&quot;,&quot;tref17&quot;,&quot;EvilSnowMan1&quot;,&quot;navy996&quot;,&quot;Homestar3&quot;,&quot;mallinson2648&quot;}  --change these names to who can enter/exit the door.(you can add more)
Door = script.Parent  --other methods may be &quot;Door = game.Workspace.DOORNAMEHERE&quot;
function check(name) --names the function
	for i = 1,#permission do --does it for the number of the list
		if (string.upper(name) == string.upper(permission[i])) then return true end  --returns true if the name is on the list
	end 
	return false  --returns false if it is not
end 



mode = string.lower(mode) --so upercase letter mistakes will be ok

function onTouched(hit) 

	if hit.className ~= &quot;Hat&quot; and hit~= nil and hit.Parent ~= nil  then
	local human = hit.Parent:findFirstChild(&quot;Humanoid&quot;) 
		if (human ~= nil ) and (game.Players:findFirstChild(hit.Parent.Name) ~= nil) then 
--tshirt mode
			if mode == &quot;tshirt&quot; and human.Parent.Torso.roblox ~= nil then
			local human = hit.Parent:findFirstChild(&quot;Humanoid&quot;) 
				if (human ~= nil ) then 
					if (check(human.Parent.Name)) or human.Parent.Torso:findFirstChild(&quot;roblox&quot;).Texture == Texture then 
					Door.Transparency = 0.7 
					Door.CanCollide = false 
					wait(time) 
					Door.CanCollide = true 
					Door.Transparency = 0 
					else 
						if killing == true then
						human.Health= 0
						end
					end
				end			
			end 
--Shirt mode
	if mode == &quot;shirt&quot; then
		if (check(human.Parent.Name)) or human.Parent:findFirstChild(&quot;Shirt&quot;).ShirtTemplate == Texture then 
				Door.Transparency = 0.7 
				Door.CanCollide = false 
				wait(time) 
				Door.CanCollide = true 
				Door.Transparency = 0 
			else 
				Door.CanCollide = true
		end			
	end 
--Pants Mode
	if mode == &quot;pant&quot; and human.Parent:findFirstChild(&quot;Pants&quot;) ~= nil then
			if (check(human.Parent.Name)) or human.Parent:findFirstChild(&quot;Pants&quot;).PantsTemplate == Texture then 
				Door.Transparency = 0.7 
				Door.CanCollide = false 
				wait(time) 
				Door.CanCollide = true 
				Door.Transparency = 0 
			else 
				if killing == true then
				human.Health= 0
				end
			end
	end
--Hat Mode


if mode == &quot;hat&quot; then 

x = hit.Parent:findFirstChild(Texture)
	if (check(human.Parent.Name)) or x ~= nil then 
			Door.Transparency = 0.7 
			Door.CanCollide = false 
			wait(time) 
			Door.CanCollide = true 
			Door.Transparency = 0 
			else 
			if killing == true then 
			human.Health= 0 
			end 
	end 
end 

--parent texture Mode


if mode == &quot;decal&quot; then --this will check if the tshirt&apos;s texture is the texture in the &quot;Text&quot; of the door.

x = script.Parent:findFirstChild(&quot;Text&quot;).Texture
	if (check(human.Parent.Name)) or hit.Parent.Torso:findFirstChild(&quot;roblox&quot;).Texture == x then 
			Door.Transparency = 0.7 
			Door.CanCollide = false 
			wait(time) 
			Door.CanCollide = true 
			Door.Transparency = 0 
			else 
			if killing == true then 
			human.Health= 0 
			end 
	end 
end 
--Team mode
	if mode == &quot;team&quot; then
			if (check(human.Parent.Name)) or game.Players:findFirstChild(human.Parent.Name).TeamColor==game.Teams:findFirstChild(team).TeamColor then 
				Door.Transparency = 0.7 
				Door.CanCollide = false 
				wait(time) 
				Door.CanCollide = true 
				Door.Transparency = 0 
			else 
				if killing == true then
				human.Health= 0
				end
			end
	end
--Off mode
	if mode == &quot;off&quot; then
		local human = hit.Parent:findFirstChild(&quot;Humanoid&quot;) 
		if (human ~= nil ) then 
			if (check(human.Parent.Name))  then 
				Door.Transparency = 0.7 
				Door.CanCollide = false 
				wait(time) 
				Door.CanCollide = true 
				Door.Transparency = 0 
			else 
				if killing == true then
				human.Health= 0
				end
			end
		end 
	end

end
end
end

