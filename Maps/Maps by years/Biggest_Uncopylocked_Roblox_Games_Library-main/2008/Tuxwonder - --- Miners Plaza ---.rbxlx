				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">fame</string>
					<ProtectedString name="Source">while true do
if script.Parent.Name ~= &quot;Main&quot; then
x = script.Parent.Position.x / 8
y = (8000 - script.Parent.Position.y) / 8
z = script.Parent.Position.z / 8
script.Parent.Name = &quot;&quot;..x..&quot;,&quot;..y..&quot;,&quot;..z..&quot;&quot;
end
wait(5)
end
</ProtectedString>
