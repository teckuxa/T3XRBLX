			<Item class="Script" referent="RBX11516">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">bin=script.Parent
player = bin.Parent.Parent
debounce = false
cost = {[0] = 5,[1] = 24,[2] = 48,[3] = 57,[4] = 89,[5] = 123,[6] = 301,[7] = 107}
name = {[0] = &quot;Rock&quot;,[1] = &quot;Copper&quot;,[2] = &quot;Silver&quot;,[3] = &quot;Emerald&quot;,[4] = &quot;Ruby&quot;,[5] = &quot;Gold&quot;,[6] = &quot;Diamond&quot;,[7] = &quot;Sapphire&quot;}
color = {[0] = 199,[1] = 38,[2] = 194,[3] = 28,[4] = 21,[5] = 24,[6] = 1,[7] = 23}
doo = false

function givemoney(part)
	upd = false
	g = game.Workspace.PersMines:GetChildren()
	for i = 1, #g do
		if g[i].Name == &quot;PersonalMine&quot; then
			if g[i].Owner.Value == bin.Parent.Parent then
				local y = g[i].Stands:findFirstChild(name[part.type.Value]):findFirstChild(&quot;Stand&quot;)
				if y ~= nil then
					bin.Parent.Parent.leaderstats:findFirstChild(&quot;$&quot;).Value = bin.Parent.Parent.leaderstats:findFirstChild(&quot;$&quot;).Value + cost[part.type.Value] * 1.25
					upd = true
				end
			end
		end
	end
	if upd == false then
		bin.Parent.Parent.leaderstats:findFirstChild(&quot;$&quot;).Value = bin.Parent.Parent.leaderstats:findFirstChild(&quot;$&quot;).Value + cost[part.type.Value]
	end
end

function givenew(type,quantity)
	a = Instance.new(&quot;Vector3Value&quot;)
	a.Name = bin.Parent.Parent.Name
	a.Value = Vector3.new(type,quantity,0)
	a.Parent = game.Workspace.Leaderboard
end

function onButton1Down(mouse)
	local part = mouse.Target
	if part ~= nil then
		local g = part:findFirstChild(&quot;fame&quot;)
			if g ~= nil then
			r = part:findFirstChild(&quot;mine&quot;)
			if r == nil then
				if debounce == false then
					if part.Position.y &gt;= 408 then
						Pos = bin.Parent.Parent.Character.Torso.Position - part.Position
						if Pos.magnitude &lt; 25 then
							local j = math.random(1,50)
							if j == 1 then
								gas(part)
							else
								dig(part)
							end
						else
						message(&quot;You&apos;re to far away!&quot;)
						end
					else
						message(&quot;You cant dig that far!&quot;)
					end
				end
			end
		end
	end
end

function dig(part)
	if debounce == false then
		debounce = true
dug(part)
		q = Instance.new(&quot;ObjectValue&quot;)
		q.Name = &quot;mine&quot;
	
		q.Parent = part
		m = Instance.new(&quot;Hint&quot;)
		m.Parent = bin.Parent.Parent
		d = Instance.new(&quot;StringValue&quot;)
		d.Name = &quot;dug&quot;
		d.Value = part.Name
		d.Parent = game.Workspace.Dug
		for i = 1, 100 do
			
			m.Text = &quot;Mining &quot;..name[part.type.Value]..&quot; is &quot;..i..&quot;% done&quot;
			part.Transparency = i / 100
			wait(script.Parent.Speed.Value / 100)
		end
	q:Remove()
givemoney(part)
		player:findFirstChild(part.type.Value).Value = player:findFirstChild(part.type.Value).Value + 1
givenew(part.type.Value,player:findFirstChild(part.type.Value).Value)
	part:Remove()
		bin.Parent.Parent.leaderstats:findFirstChild(&quot;Total Bricks Dug&quot;).Value = bin.Parent.Parent.leaderstats:findFirstChild(&quot;Total Bricks Dug&quot;).Value + 1
		wait(1)
	m:Remove()
		debounce = false
	end
end

function onSelected(mouse)
mouse.Button1Down:connect(function() onButton1Down(mouse) end)
mouse.KeyDown:connect(onKeyDown)
end

function onDeselected()
if plane ~= nil then
plane = nil
end
end

bin.Selected:connect(onSelected)
bin.Deselected:connect(onDeselected)

-----------------------()-----------------------------------------------------()-------------------------------------------------------------------()------------------------

function dug(part)
	for i = 1, 6 do
		moe(part,i)
	end
end

function moe(part,mode)
	print(&quot;------Moe has been covered&quot;)
	x = part.Position.x
	y = part.Position.y
	z = part.Position.z
	b = part:clone()
	if mode == 1 then
		b.Name = &quot;&quot;..(x/8)+1 ..&quot;,&quot;..((8000-y)/8)..&quot;,&quot;..(z/8)..&quot;&quot;
		b.Position = Vector3.new(x+8,y,z)
	end
	if mode == 2 then
		b.Name = &quot;&quot;..(x/8)-1 ..&quot;,&quot;..((8000-y)/8)..&quot;,&quot;..(z/8)..&quot;&quot;
		b.Position = Vector3.new(x-8,y,z)
	end
	if mode == 3 then
		b.Name = &quot;&quot;..(x/8) ..&quot;,&quot;..((8000-y)/8)+1 ..&quot;,&quot;..(z/8)..&quot;&quot;
		b.Position = Vector3.new(x,y-8,z)
	end
	if mode == 4 then
		b.Name = &quot;&quot;..(x/8) ..&quot;,&quot;..((8000-y)/8)-1 ..&quot;,&quot;..(z/8)..&quot;&quot;
		b.Position = Vector3.new(x,y+8,z)
	end
	if mode == 5 then
		b.Name = &quot;&quot;..(x/8) ..&quot;,&quot;..((8000-y)/8)..&quot;,&quot;..(z/8)+1 ..&quot;&quot;
		b.Position = Vector3.new(x,y,z+8)
	end
	if mode == 6 then
		b.Name = &quot;&quot;..(x/8) ..&quot;,&quot;..((8000-y)/8)..&quot;,&quot;..(z/8)-1 ..&quot;&quot;
		b.Position = Vector3.new(x,y,z-8)
	end
	print(&quot;------&quot;..b.Name..&quot; is b&apos;s name&quot;)
	u = b:GetChildren()
	for i = 1,#u do
		if u[i].Name == &quot;Crack&quot; then
			u[i]:Remove()
		end
	end

	local m = b:findFirstChild(&quot;mine&quot;)
	if m ~= nil then
		m:Remove()
	end

	local g = math.random(1,5)
	if g == 1 then
		local w = math.random(1,#cost)
		if cost[w] &lt;= math.random(1,320) then
			b.BrickColor = BrickColor.new(color[w])
			b.type.Value = w
			b.Reflectance = 0.2
			if w == 6 then
				b.Transparency = 0.3
			end
		end
	else
		b.BrickColor = BrickColor.new(199)
		b.type.Value = 0
		b.Reflectance = 0
	end

	local j = game.Workspace:findFirstChild(b.Name)
	if j == nil then
		print(&quot;---------j is nil&quot;)

		elmo = game.Workspace.Dug:GetChildren()
		for i = 1,#elmo do
			print(&quot;------------&quot;..elmo[i].Value..&quot; is the value&quot;)
			if elmo[i].Value == b.Name then
				print(&quot;Removed&quot;)
				b:Remove()
				doo = true
			end
		end
		if doo == false then
			if b.Position.y &lt;= 8000 then
				b.Parent = game.Workspace
				b.Transparency = 0
			end
		end
	else
		print(&quot;---------Found j&quot;)
		b:Remove()
	end
doo = false
end

function message(mes)
	debounce = true
	m = Instance.new(&quot;Message&quot;)
	m.Parent = bin.Parent.Parent
	m.Text = mes
	wait(2)
	m:Remove()
	debounce = false
end

function gas(part)
	for a = 1, 6 do
		n = script.Parent.Crack:clone()
		n.Parent = part
		n.Face = a - 1
	end
	message(&quot;Oh noes! You just hit a pocket of Natural Gas!&quot;)
	for i = 1,15 do
		q = Instance.new(&quot;Part&quot;)
		q.Size = Vector3.new(1,1,1)
		q.Transparency = 0.75
		q.Position = part.Position
		q.BrickColor = BrickColor.new(119)
		q.Anchored = true
		q.Parent = game.Workspace.Gas
game.Debris:AddItem(q,4)
		k = Instance.new(&quot;SpecialMesh&quot;)
		k.MeshType = 3
		k.Parent = q
		k.Scale = Vector3.new(10+i,10+i,10+i)
		q.Name = &quot;Gas&quot;
		g = game.Players:GetChildren()
		for d = 1, #g do
			pos = part.Position - g[d].Character.Torso.Position
			if pos.magnitude &lt; i + 3 then
				g[d].Character.Humanoid.Health = 0
				value = Instance.new(&quot;ObjectValue&quot;)
				value.Parent = g[d]
				value.Name = &quot;Gas&quot;
			end
		end
		wait(0.2)
	end
end






