					<string name="Name">Script</string>
					<ProtectedString name="Source">backup = script.Parent:clone()
time = false

for i = 1,2 do
wait(1)
end

function onChanged(value)
	if time == true then
	backup:clone().Parent = script.Parent.Parent
	script.Parent:Remove()
	else
	time = true
	end
end

script.Parent.Owner.Changed:connect(onChanged)
