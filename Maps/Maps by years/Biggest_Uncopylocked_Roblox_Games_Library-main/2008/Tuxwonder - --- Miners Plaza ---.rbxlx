			</Properties>
			<Item class="NumberValue" referent="RBX11514">
				<Properties>
					<string name="Name">Speed</string>
					<double name="Value">2.5</double>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="Decal" referent="RBX11515">
				<Properties>
					<token name="Face">2</token>
					<string name="Name">Crack</string>
					<float name="Shiny">20</float>
					<float name="Specular">0</float>
					<Content name="Texture"><url>http://www.roblox.com/asset/?id=14601651</url></Content>
