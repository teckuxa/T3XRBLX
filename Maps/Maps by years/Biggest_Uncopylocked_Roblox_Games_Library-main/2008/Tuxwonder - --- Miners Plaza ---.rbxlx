					<Item class="Script" referent="RBX2625">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">currency = &quot;$&quot;
needed = 10000

function onTouched(part)
	player = game.Players:findFirstChild(part.Parent.Name)
	if player == nil then return end
	money = player.leaderstats[currency].Value
	if money &gt;= needed then
		script.Parent.CanCollide = false
		wait(3)
		script.Parent.CanCollide = true
	else
		script.Parent.CanCollide = true
		part.Parent.Humanoid.Health = 0
	end
end
	
script.Parent.Touched:connect(onTouched)</ProtectedString>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
				</Item>
			</Item>
