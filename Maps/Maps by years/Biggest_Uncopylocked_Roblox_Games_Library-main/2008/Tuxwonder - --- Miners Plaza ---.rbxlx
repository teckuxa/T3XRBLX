name = {[0] = &quot;Rock&quot;,[1] = &quot;Copper&quot;,[2] = &quot;Silver&quot;,[3] = &quot;Emerald&quot;,[4] = &quot;Ruby&quot;,[5] = &quot;Gold&quot;,[6] = &quot;Diamond&quot;,[7] = &quot;Sapphire&quot;}
color = {[0] = 199,[1] = 38,[2] = 194,[3] = 28,[4] = 21,[5] = 24,[6] = 1,[7] = 23}

function onTouched(part)
	v = part:findFirstChild(&quot;type&quot;)
	if v ~= nil then
	d = Instance.new(&quot;StringValue&quot;)
	d.Name = &quot;dug&quot;
	d.Value = part.Name
	d.Parent = game.Workspace.Dug
	dug(part)
	part:Remove()
	end
end

function dug(part)
	for i = 1, 6 do
		moe(part,i)
	end
end

function moe(part,mode)
	print(&quot;------Moe has been covered&quot;)
	x = part.Position.x
	y = part.Position.y
	z = part.Position.z
	b = part:clone()
	if mode == 1 then
		b.Name = &quot;&quot;..(x/8)+1 ..&quot;,&quot;..((8000-y)/8)..&quot;,&quot;..(z/8)..&quot;&quot;
		b.Position = Vector3.new(x+8,y,z)
	end
	if mode == 2 then
		b.Name = &quot;&quot;..(x/8)-1 ..&quot;,&quot;..((8000-y)/8)..&quot;,&quot;..(z/8)..&quot;&quot;
		b.Position = Vector3.new(x-8,y,z)
	end
	if mode == 3 then
		b.Name = &quot;&quot;..(x/8) ..&quot;,&quot;..((8000-y)/8)+1 ..&quot;,&quot;..(z/8)..&quot;&quot;
		b.Position = Vector3.new(x,y-8,z)
	end
	if mode == 4 then
		b.Name = &quot;&quot;..(x/8) ..&quot;,&quot;..((8000-y)/8)-1 ..&quot;,&quot;..(z/8)..&quot;&quot;
		b.Position = Vector3.new(x,y+8,z)
	end
	if mode == 5 then
		b.Name = &quot;&quot;..(x/8) ..&quot;,&quot;..((8000-y)/8)..&quot;,&quot;..(z/8)+1 ..&quot;&quot;
		b.Position = Vector3.new(x,y,z+8)
	end
	if mode == 6 then
		b.Name = &quot;&quot;..(x/8) ..&quot;,&quot;..((8000-y)/8)..&quot;,&quot;..(z/8)-1 ..&quot;&quot;
		b.Position = Vector3.new(x,y,z-8)
	end
	print(&quot;------&quot;..b.Name..&quot; is b&apos;s name&quot;)
	u = b:GetChildren()
	for i = 1,#u do
		if u[i].Name == &quot;Crack&quot; then
			u[i]:Remove()
		end
	end
	local m = b:findFirstChild(&quot;mine&quot;)
	if m ~= nil then
		m:Remove()
	end

	local g = math.random(1,5)
	if g == 1 then
		local w = math.random(1,#cost)
		if cost[w] &lt;= math.random(1,320) then
			b.BrickColor = BrickColor.new(color[w])
			b.type.Value = w
			b.Reflectance = 0.3
			if w == 6 then
				b.Transparency = 0.3
			end
		end
	else
		b.BrickColor = BrickColor.new(199)
		b.type.Value = 0
		b.Reflectance = 0
	end

	local j = game.Workspace:findFirstChild(b.Name)
	if j == nil then
		print(&quot;---------j is nil&quot;)

		elmo = game.Workspace.Dug:GetChildren()
		for i = 1,#elmo do
			print(&quot;------------&quot;..elmo[i].Value..&quot; is the value&quot;)
			if elmo[i].Value == b.Name then
				print(&quot;Removed&quot;)
				b:Remove()
				doo = true
			end
		end
		if doo == false then
			if b.Position.y &lt;= 8000 then
				b.Parent = game.Workspace
				b.Transparency = 0
			end
		end
	else
		print(&quot;---------Found j&quot;)
		b:Remove()
	end
doo = false
end	

