							<string name="Name">Script</string>
							<ProtectedString name="Source">lastgave = 0
demo = game.Workspace.DemoMine
x = 20000
debounce = false

function place(model)
	child = model:GetChildren()
	for i = 1, #child do
		wait(0.001)
		child[i].Parent = game.Workspace
	end
end

function teleport(guy,place)
	guy.Torso.CFrame = CFrame.new(place.Position + Vector3.new(0,4,0))
end

function onTouched(part)
	if debounce == true then return end
	debounce = true
	if part.Parent == game.Players:findFirstChild(part.Parent.Name).Character then 
		found = false
		g = game.Workspace.PersMines:GetChildren()
		for i = 1, #g do 
			if g[i].Name == &quot;PersonalMine&quot; then
			if g[i].Owner.Value == game.Players:findFirstChild(part.Parent.Name) then
				found = true
				p = g[i]:findFirstChild(&quot;Platform&quot;)
				if p ~= nil then
				teleport(part.Parent,p)
				end
			end
			else
				g[i]:Remove()
			end
		end
		if found == false then 
			newplace = demo:clone()
			newplace.Parent = game.Workspace.PersMines
			newplace:MoveTo(Vector3.new(0,8004.5,x))
			newplace.Name = &quot;PersonalMine&quot;
			newplace.Owner.Value = game.Players:findFirstChild(part.Parent.Name)
			place(newplace.DiggingArea)
			teleport(part.Parent,newplace.Platform)
			x = x + 2400
		end
	end
	debounce = false
end

