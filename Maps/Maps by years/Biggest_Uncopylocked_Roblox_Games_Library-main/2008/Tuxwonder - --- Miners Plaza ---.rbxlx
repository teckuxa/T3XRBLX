		<Item class="Script" referent="RBX4">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Leaderboard</string>
				<ProtectedString name="Source">cost = {[0] = 5,[1] = 24,[2] = 48,[3] = 57,[4] = 89,[5] = 123,[6] = 301,[7] = 107}
name = {[0] = &quot;Rock&quot;,[1] = &quot;Copper&quot;,[2] = &quot;Silver&quot;,[3] = &quot;Emerald&quot;,[4] = &quot;Ruby&quot;,[5] = &quot;Gold&quot;,[6] = &quot;Diamond&quot;,[7] = &quot;Sapphire&quot;}
color = {[0] = 199,[1] = 38,[2] = 194,[3] = 28,[4] = 21,[5] = 24,[6] = 1,[7] = 23}
winner = &quot;RJ17141&quot;
parti = {&quot;TheBloxxerofRoblox&quot;,&quot;kelco5473&quot;,&quot;qwertyalex11&quot;,&quot;fsjd150&quot;,&quot;RedApple8&quot;,&quot;Dssdundonald&quot;,&quot;deathdinox81&quot;}

-- ( Don&apos;t be nervous it&apos;s easier than you think)

print(&quot;Cash Stuffs running!&quot;)

function change(thing)
	game.Players:findFirstChild(thing.Name).PlayerGui.Material.Material[name[thing.Value.x]].TextLabel.Text = name[thing.Value.x]..&quot; : &quot;..game.Players:findFirstChild(thing.Name)[thing.Value.x].Value + 1
	thing:Remove()
end

function onPlayerEntered(newPlayer)
	wait(.5)
	local stats = Instance.new(&quot;IntValue&quot;)
	stats.Name = &quot;leaderstats&quot;

	local cash = Instance.new(&quot;IntValue&quot;)
	local money = Instance.new(&quot;IntValue&quot;)
	
	cash.Name = &quot;Total Bricks Dug&quot;
	cash.Value = 0 --This sets the amount of money every player starts with
	e = table.concat(parti,&quot;&quot;)
	print(e)
	money.Name = &quot;$&quot;
	if newPlayer.Name == winner then
	money.Value = 10000 --This sets the amount of money every player starts with
	else if string.find(e,newPlayer.Name) ~= nil then
	money.Value = 2000
	else
	money.Value = 0
	end
	end
	money.Parent = stats
	cash.Parent = stats
	stats.Parent = newPlayer
	for i = 1,#cost + 1 do
		v = Instance.new(&quot;IntValue&quot;)
		v.Name = i - 1
		v.Value = 0
		v.Parent = newPlayer
		print(&quot;gave&quot;)
	end
end

script.ChildAdded:connect(change)
game.Players.ChildAdded:connect(onPlayerEntered)
</ProtectedString>
				<bool name="archivable">true</bool>
			</Properties>
