								<string name="Name">Script</string>
								<ProtectedString name="Source">bin=script.Parent
player = bin.Parent.Parent
debounce = false

function onButton1Down(mouse)
	print(&quot;hit&quot;)
	if debounce == false then
	debounce = true
	part = mouse.Target
	type = part:findFirstChild(&quot;type&quot;)
	if part ~= nil then
		checkplace(part)
		print(&quot;go to checkplace&quot;)
	end
	end
end

function checkplace(part)
	d1 = string.find(part.Name,&quot;,&quot;)
	d2 = string.find(part.Name,&quot;,&quot;,d1 + 1)
	x = string.sub(part.Name,1,d1 - 1)	--	--	--	--	-- &apos;?&apos;,?,?
	y = string.sub(part.Name,d1 + 1,d2 - 1) 	--	--	--	-- ?,&apos;?&apos;,?	
	z = string.sub(part.Name,d2 + 1)	--	--	--	--	-- ?,?,&apos;?&apos;
	print(x..y..z)
	if y ~= &quot;0&quot; then
		message(&quot;Please place on the surface&quot;)
	end
	xl = game.Workspace:findFirstChild(x + 1 ..&quot;,&quot;..y..&quot;,&quot;..z)
	xr = game.Workspace:findFirstChild(x - 1 ..&quot;,&quot;..y..&quot;,&quot;..z)
	zl = game.Workspace:findFirstChild(x..&quot;,&quot;..y..&quot;,&quot;..z + 1)
	zr = game.Workspace:findFirstChild(x..&quot;,&quot;..y..&quot;,&quot;..z - 1)
	if xl == nil then
		message(&quot;You need it to be on flat land!&quot;)
		return
	end
	if xr == nil then
		message(&quot;You need it to be on flat land!&quot;)
		return
	end
	if zl == nil then
		message(&quot;You need it to be on flat land!&quot;)
		return
	end
	if zr == nil then
		message(&quot;You need it to be on flat land!&quot;)
		return
	end
	place(part,x,z)
end

function place(part)
	quenzar = Instance.new(&quot;ObjectValue&quot;)
	quenzar.Name = &quot;go&quot;
	digger = game.Workspace.EDigger:clone()
	quenzar.Parent = digger
	digger.Parent = game.Workspace
	digger:MoveTo(Vector3.new(x * 8, 8000, z * 8))
	scpt = script.Weld:clone()
	scpt.Parent = digger.Digger
	wait(1)
	g = digger.Digger:GetChildren()
	for i = 1, #g do
		if g[i].className == &quot;Part&quot; then
		g[i].Anchored = false
		end
	end
	script.Parent:Remove()
	
end

function message(mes)
	debounce = true
	m = Instance.new(&quot;Message&quot;)
	m.Parent = bin.Parent.Parent
	m.Text = mes
	wait(2)
	m:Remove()
	debounce = false
end

function onSelected(mouse)
mouse.Button1Down:connect(function() onButton1Down(mouse) end)
mouse.KeyDown:connect(onKeyDown)
end

function onDeselected()
end

bin.Selected:connect(onSelected)
bin.Deselected:connect(onDeselected)






	</ProtectedString>
