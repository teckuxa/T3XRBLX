										<Content name="LinkedSource"><null></null></Content>
										<string name="Name">Script</string>
										<ProtectedString name="Source">Upgradecost = script.Parent.Cost.Value
-------------------------------------------------------------------------------------------------------------------------
local ting = 0

function onTouched(hit)
	if ting == 0 then
	ting = 1
	check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
	if check ~= nil then
		local user = game.Players:GetPlayerFromCharacter(hit.Parent)
		local stats = user:findFirstChild(&quot;leaderstats&quot;)

		if stats ~= nil then
			local cash = stats:findFirstChild(&quot;Cash&quot;)
			if cash.Value &gt; (Upgradecost-1) then
				cash.Value = cash.Value - Upgradecost
				script.Parent.Parent.Parent.BeltSpeed.Value = (script.Parent.Parent.Parent.BeltSpeed.Value * 2) - 1.5
				Upgradecost = Upgradecost + 150 
				script.Parent.Parent.Name = &quot;Upgrade Conveyor Speed: &quot;..Upgradecost
				if script.Parent.Parent.Parent.BeltSpeed.Value &gt;= 12 then
					script.Parent.Parent:remove()
				end
			end
			wait(2)
		end
	end

	ting = 0
	end
end

script.Parent.Touched:connect(onTouched)
