									<ProtectedString name="Source">owner = script.Parent.Parent.Parent.Parent.OwnerName
debounce = false
donation = 10000

function onTouched(part)
	local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if (h~=nil) and debounce == false then
			debounce = true
			local thisplr = game.Players:findFirstChild(h.Parent.Name)
			if (thisplr~=nil) then
				local stats = thisplr:findFirstChild(&quot;leaderstats&quot;)
				if (stats~=nil) then
					local score = stats:findFirstChild(&quot;Cash&quot;)
					if (score~=nil) and score.Value &gt;= donation then
						score.Value = score.Value - donation
						script.Parent.Parent.Parent.Payment.Value = script.Parent.Parent.Parent.Payment.Value + donation
					end
				end
			end
			wait(1)
			debounce = false
	end
end


script.Parent.Touched:connect(onTouched)





