	if Metal.Name == &quot;Ruby&quot; then
		script.Parent.Parent.Parent.Paygiver.Payment.Value = script.Parent.Parent.Parent.Paygiver.Payment.Value + Metal:findFirstChild(&quot;Price&quot;).Value
		Metal:remove()
	end
end

