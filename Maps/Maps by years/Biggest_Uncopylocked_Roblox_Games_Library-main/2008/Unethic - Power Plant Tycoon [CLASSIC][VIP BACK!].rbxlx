							<ProtectedString name="Source">newRuby = script.Parent:findFirstChild(&quot;RubyPiece&quot;):clone()
RubyBackup = newRuby:clone()

while true do
	if script.Parent.RubyOn.Value == true then
		Ruby = RubyBackup:clone()
		Ruby.Parent = game.Workspace
		Ruby.Name = &quot;Ruby&quot;
		Ruby.CanCollide = true
		Ruby.Anchored = false
		wait(script.Parent.ExtractionTime.Value/10)
	end
	wait(1)
end
