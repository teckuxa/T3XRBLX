							<Item class="Script" referent="RBX5030">
								<Properties>
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">Script</string>
									<ProtectedString name="Source">RubyOn = script.Parent.Parent.Parent. RubyOn
local ting = 0

function onTouched(hit)
	if ting == 0 then
	ting = 1 
	check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
	if check ~= nil and  RubyOn.Value == false then
		script.Parent.Parent.Name = &quot;Turn off Wind Powered Energy Producer Producer&quot;
		 RubyOn.Value = true
		script.Parent.BrickColor = BrickColor.new(28)
		wait(2)
	elseif check ~= nil and  RubyOn.Value == true then
		script.Parent.Parent.Name = &quot;Turn on Wind Powered Energy Producer&quot;
		 RubyOn.Value = false
		script.Parent.BrickColor = BrickColor.new(21)
		wait(2)
	end
	ting = 0
	end
end

script.Parent.Touched:connect(onTouched)
</ProtectedString>
