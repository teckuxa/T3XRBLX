								<ProtectedString name="Source">debounce = false
door = script.Parent.Parent.Door
b1 = script.Parent
b2 = script.Parent.Parent.Button2
owner = script.Parent.Parent.Parent.OwnerName

function onTouched(part)
	local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if (h~=nil) and debounce == false then
		debounce = true
		if part.Parent.Name == owner.Value then
			if door.CanCollide == false then
				door.CanCollide = true
				door.Transparency = 0
				b1.BrickColor = BrickColor.new(28)
				b2.BrickColor = BrickColor.new(28)
			elseif door.CanCollide == true then
				door.CanCollide = false
				door.Transparency = 1
				b1.BrickColor = BrickColor.new(21)
				b2.BrickColor = BrickColor.new(21)
			end
		end
		wait(1)
		debounce = false
	end
end


