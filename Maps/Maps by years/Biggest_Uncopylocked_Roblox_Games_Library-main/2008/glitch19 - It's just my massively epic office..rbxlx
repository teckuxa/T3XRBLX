					<ProtectedString name="Source">local Tool = script.Parent
--[[
     ---- possible gears ----


]]

local gears = {22787189,20721924, 10469910, 11956382}


function onActivated()
	--This call will cause a &quot;wait&quot; until the data comes back
	local root = game:GetService(&quot;InsertService&quot;):LoadAsset(gears[math.random(1,#gears)])

	local instances = root:GetChildren()
	if #instances == 0 then
		root:Remove()
		return
	end

	root = root:GetChildren()
	if #root == 1 then
		root = root[1]
	-- needed for irregularity in hippo gear
	elseif #root == 2 then
		for i = 1, #root do
			if root[i].Name == &quot;Hippo&quot; then
				root = root[i]
				break
			end
		end
	end
	print(root)
	root.Parent = Tool.Parent
	Tool:remove()

end

Tool.Activated:connect(onActivated)
