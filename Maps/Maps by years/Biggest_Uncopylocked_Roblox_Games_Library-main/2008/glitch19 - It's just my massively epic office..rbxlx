								<ProtectedString name="Source">function onTouched(part)
 local h = part.Parent:findFirstChild(&quot;Humanoid&quot;) 
 if (h ~=nil) then -- If there is a Humanoid then
       h.MaxHealth = 200
       h.Health = 200
 end
 end

script.Parent.Touched:connect(onTouched)</ProtectedString>
