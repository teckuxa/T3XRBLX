			<Item class="Script" referent="RBX3063">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<string name="Source">m = Instance.new(&quot;Hint&quot;)

function Selected(mouse)
Seconds = 0
m.Parent = script.Parent.Parent.Parent
if Dead == true then return end
	if script.Parent.Name == &quot;Select Me&quot; then
	m.Text = &quot;Click on a maze-piece to select it&quot;
	end
Selected = true
Dropper = false
mouse.Button1Down:connect(function() onButton1Down(mouse) end)
--mouse.Button1Up:connect(function() onButton1Up(mouse) end)
mouse.KeyDown:connect(onKeyDown)
	repeat
	wait(0.1)
		if script.Parent.Parent.Parent.Character:findFirstChild(&quot;Humanoid&quot;) ~= nil then
			if script.Parent.Parent.Parent.Character.Humanoid.Health &lt;= 0 then
			Dead = true
			m.Parent = nil
			end
		else
		Dead = true
		m.Parent = nil
		end
		if Seconds &lt;= 4 then
			if ((script.Parent.TextureId ~= &quot;&quot;) and (script.Parent.Name == &quot;Select Me&quot;)) then
				m.Text = &quot;Press Q to use the Eye-Dropper, and E to Delete Maze-Parts&quot;
				script.Parent.Name = &quot;Delete&quot;
			end
			if m.Text ~= &quot;Click on a maze-piece to select it&quot; then
				Seconds = Seconds + 0.1
			end
		else
		m.Parent = nil
		end
		if Dropper == true then
			mouse.Icon = &quot;http://www.roblox.com/asset/?id=13477439&quot;
		else
			mouse.Icon = &quot;&quot;
		end
	until Selected == false
end

function onButton1Down(mouse)
if mouse.Target == nil then return end
	if mouse.Target.Parent.Name == &quot;Pieces&quot; then
		script.Parent.TextureId = mouse.Target.Decal.Texture
		Dropper = false
	end
	if mouse.Target.Parent.Name == &quot;Map&quot; then
		if script.Parent.TextureId ~= &quot;&quot; then
			if Dropper == false then
				if mouse.Target:findFirstChild(&quot;Decal&quot;) ~= nil then
					mouse.Target.Decal:Remove()
				end
				Decal = Instance.new(&quot;Decal&quot;)
				Decal.Texture = script.Parent.TextureId
				Decal.Face = &quot;Top&quot;
				Decal.Parent = mouse.Target
			else
				if mouse.Target:findFirstChild(&quot;Decal&quot;) ~= nil then
					script.Parent.TextureId = mouse.Target.Decal.Texture
					Dropper = false
				else
					Dropper = false
					script.Parent.TextureId = &quot;&quot;
				end
			end
		else
			if Dropper == false then
				if mouse.Target:findFirstChild(&quot;Decal&quot;) ~= nil then
					mouse.Target.Decal:Remove()
				end
			else
				if mouse.Target:findFirstChild(&quot;Decal&quot;) ~= nil then
					script.Parent.TextureId = mouse.Target.Decal.Texture
					Dropper = false
				else
					Dropper = false
					script.Parent.TextureId = &quot;&quot;
				end
			end
		end
	end
end

function onKeyDown(key)
	if key == &quot;q&quot; then
		if Dropper ~= true then
			Dropper = true
		else
			Dropper = false
		end
	end
	if key == &quot;e&quot; then
		script.Parent.TextureId = &quot;&quot;
	end
end

function Deselected()
	Selected = false
	m.Parent = nil
end

--[[
function onButton1Up(mouse)
end

]]

script.Parent.Selected:connect(Selected)
script.Parent.Deselected:connect(Deselected)
