						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">ScriptA</string>
						<string name="Source">function ChangePart(part)
if script.Parent.Maze:findFirstChild(part.Name) ~= nil then
script.Parent.Maze[part.Name].Parent = nil
end
if part:findFirstChild(&quot;Decal&quot;) ~= nil then
if part.Decal.Texture == &quot;http://www.roblox.com/asset/?id=13462520&quot; then
Model = Instance.new(&quot;Model&quot;)
Model.Name = part.Name
p = Instance.new(&quot;Part&quot;)
p.BrickColor = BrickColor.new(&quot;Institutional white&quot;)
p.Anchored = true
p.size = Vector3.new(20,20,5)
p.CFrame = (CFrame.new(script.Parent.Maze.Floor.Position + ((script.Parent.Map.Base.Position - part.Position) * 20)) + Vector3.new(7.5,18.2,0)) * CFrame.fromEulerAnglesXYZ(0,math.rad(270),0)
p.Parent = Model
d = Instance.new(&quot;Decal&quot;)
d.Texture = &quot;http://www.roblox.com/asset/?id=13437930&quot;
d.Face = &quot;Top&quot;
d.Parent = p
p = Instance.new(&quot;Part&quot;)
p.BrickColor = BrickColor.new(&quot;Institutional white&quot;)
p.Anchored = true
p.size = Vector3.new(20,20,5)
p.CFrame = (CFrame.new(script.Parent.Maze.Floor.Position + ((script.Parent.Map.Base.Position - part.Position) * 20)) + Vector3.new(-7.5,18.2,0)) * CFrame.fromEulerAnglesXYZ(0,math.rad(270),0)
p.Parent = Model
d = Instance.new(&quot;Decal&quot;)
d.Texture = &quot;http://www.roblox.com/asset/?id=13437930&quot;
d.Face = &quot;Top&quot;
d.Parent = p
Model.Parent = script.Parent.Maze
end
