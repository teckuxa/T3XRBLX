						<Item class="Script" referent="RBX5673">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<string name="Source">x = script.Parent.Pieces:getChildren()
for i = 1,#x do
function OnClicked()
if x[i].CanCollide == true then
x[i].CanCollide = false
x[i].Transparency = 1
else
x[i].CanCollide = true
x[i].Transparency = 0
end
end
x[i].ClickDetector.mouseClick:connect(OnClicked)
end

function FillMaze()
local x = script.Parent.Pieces:getChildren()
for i = 1,#x do
x[i].CanCollide = true
x[i].Transparency = 0
end
end
script.Parent[&quot;Fill Maze&quot;].Head.ClickDetector.mouseClick:connect(FillMaze)

function ClearMaze()
local x = script.Parent.Pieces:getChildren()
for i = 1,#x do
x[i].CanCollide = false
x[i].Transparency = 1
end
end
script.Parent[&quot;Clear Maze&quot;].Head.ClickDetector.mouseClick:connect(ClearMaze)

debug = false
function RecreateMaze(player)
if player.Parent:findFirstChild(&quot;Torso&quot;) ~= nil then
if debug == true then return end
debug = true
if script.Parent.Parent.Maze:findFirstChild(&quot;Maze_Pieces&quot;) ~= nil then
script.Parent.Parent.Maze:findFirstChild(&quot;Maze_Pieces&quot;):Remove()
end
local x = script.Parent.Pieces:getChildren()
m = Instance.new(&quot;Model&quot;)
m.Name = &quot;Maze_Pieces&quot;
m.Parent = script.Parent.Parent.Maze
for i = 1,#x do
if x[i].CanCollide ~= false then
p = Instance.new(&quot;Part&quot;)
p.size = Vector3.new(10,10,10)
p.Anchored = true
p.CFrame = CFrame.new(script.Parent.Parent.Maze.Maze_Walls.Base.Position + (script.Parent.Base.Position - x[i].Position)*10) + Vector3.new(0,13,0)
p.TopSurface = 0
p.BottomSurface = 0
p.Parent = m
end
end
a = 5
button = script.Parent[&quot;Recreate Maze&quot;]
for i = 1,a do
button.Name = &quot;Recreate Maze (&quot;..a..&quot;)&quot;
wait(1)
a = a - 1
end
button.Name = &quot;Recreate Maze&quot;
debug = false
end
end
script.Parent[&quot;Recreate Maze&quot;].Head.Touched:connect(RecreateMaze)

function TeleportToMaze(player)
if player.Parent:findFirstChild(&quot;Torso&quot;) ~= nil then
player.Parent.Torso.CFrame = script.Parent.Parent.Maze.Start.Start.CFrame + Vector3.new(0,4,0)
end
end
script.Parent[&quot;Teleport to Maze&quot;].Head.Touched:connect(TeleportToMaze)</string>
