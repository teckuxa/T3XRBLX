				<string name="Name">Shrink Script</string>
				<string name="Source">x = script.Parent:getChildren()
for i = 1,#x do
if x[i].className == &quot;Part&quot; then
local part = x[i]
local V = script.Value.Value
local x = (part.size.x)*V
local y = (part.size.y)*V
local z = (part.size.z)*V
local X = (part.Position.x)*V
local Y = (part.Position.y)*V
local Z = (part.Position.z)*V
local Parent = part.Parent
part.size = Vector3.new(x,y,z)
part.Parent = Lighting
part.Position = Vector3.new(X,Y,Z)
part.Parent = Parent
end
end </string>
