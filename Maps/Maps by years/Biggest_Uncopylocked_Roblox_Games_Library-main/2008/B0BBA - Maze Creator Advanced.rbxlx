					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<string name="Source">cam = false

function Selected(mouse)
mouse.Button1Down:connect(function() onButton1Down(mouse) end)
mouse.KeyDown:connect(onKeyDown)
end

function onButton1Down(mouse)
target = mouse.Target
if cam == false then
cam = true
if target.Parent.Name == &quot;Maze&quot; then
Workspace.CurrentCamera.CameraType = &quot;Fixed&quot;
Workspace.CurrentCamera.CameraSubject = target.Parent.Parent.Map.Base
Workspace.CurrentCamera.CoordinateFrame = CFrame.new(target.Parent.Parent.Map.Base.Position + Vector3.new(-10,10,0),target.Parent.Parent.Map.Base.Position)
Workspace.CurrentCamera.Focus = target.Parent.Parent.Map.Base.CFrame
else
Workspace.CurrentCamera.CameraType = &quot;Fixed&quot;
Workspace.CurrentCamera.CameraSubject = target.Parent.Parent.Parent.Map.Base
Workspace.CurrentCamera.CoordinateFrame = CFrame.new(target.Parent.Parent.Parent.Map.Base.Position + Vector3.new(-10,10,0),target.Parent.Parent.Parent.Map.Base.Position)
Workspace.CurrentCamera.Focus = target.Parent.Parent.Parent.Map.Base.CFrame
end
else
cam = false
Workspace.CurrentCamera.CameraType = &quot;Custom&quot;
Workspace.CurrentCamera.CameraSubject = script.Parent.Parent.Parent.Character.Humanoid
end
end

function onKeyDown(key)
if key == &quot;q&quot; then
cam = true
end
end

script.Parent.Selected:connect(Selected)
