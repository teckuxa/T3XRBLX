						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<string name="Source">x = script.Parent:getChildren()
for i = 1,#x do
if x[i] ~= script then

function EditMaze(player)
if game.Players:findFirstChild(player.Parent.Name) ~= nil then
if x[i].Owner.Value == player.Parent.Name then
player.Parent.Torso.CFrame = player.Parent.Torso.CFrame - player.Parent.Torso.Position + Workspace.Mazes:findFirstChild(x[i].Maze.Value)[&quot;Build-a-maze&quot;].Exit.Position + Vector3.new(0,3.3,0)
else
local m = Instance.new(&quot;Message&quot;)
m.Text = &quot;You can&apos;t edit someone else&apos;s maze!&quot;
m.Parent = game.Players:findFirstChild(player.Parent.Name)
wait(2)
m:Remove()
end
end
end
x[i][&quot;Edit Maze&quot;].Head.Touched:connect(EditMaze)

function TeleportToMaze(player)
if player.Parent:findFirstChild(&quot;Torso&quot;) ~= nil then
player.Parent.Torso.CFrame = player.Parent.Torso.CFrame - player.Parent.Torso.Position + Workspace.Mazes:findFirstChild(x[i].Maze.Value).Maze.Start.Start.Position + Vector3.new(0,3.3,0)
s = script.Character_Marker:Clone()
s.Disabled = false
v = Instance.new(&quot;ObjectValue&quot;)
v.Name = &quot;Maze&quot;
v.Value = Workspace.Mazes:findFirstChild(x[i].Maze.Value)
v.Parent = s
s.Parent = player.Parent
end
end
x[i][&quot;Play Maze&quot;].Head.Touched:connect(TeleportToMaze)

function TeleportOutOfMaze(player)
if player.Parent:findFirstChild(&quot;Torso&quot;) ~= nil then
if player.Parent:findFirstChild(player.Parent.Name) ~= nil then
player.Parent:findFirstChild(player.Parent.Name):remove()
end
player.Parent.Torso.CFrame = player.Parent.Torso.CFrame - player.Parent.Torso.Position + Vector3.new(math.random(-5,5),10,math.random(-5,5))
if x[i].Owner.Value ~= &quot;nobody&quot; then
local m = Instance.new(&quot;Message&quot;)
m.Text = player.Parent.Name..&quot; completed &quot;..x[i].Owner.Value..&quot;&apos;s maze!&quot;
m.Parent = Workspace
wait(2)
m:Remove()
end
end
end
Workspace.Mazes:findFirstChild(x[i].Maze.Value).Maze.Finish.Finish.Touched:connect(TeleportOutOfMaze)


function Open()
local Door_A = x[i].Door.Door_A
local Door_B = x[i].Door.Door_B
if x[i].Debug.Value ~= true then
x[i].Debug.Value = true
for i = 1,3 do
for i = 1,10 do
wait()
Door_A.CFrame = Door_A.CFrame + Door_A.CFrame.lookVector * 0.1
Door_B.CFrame = Door_B.CFrame + Door_B.CFrame.lookVector * 0.1
end
CFrameA = Door_A.CFrame
CFrameB = Door_B.CFrame
Door_A.size = Door_A.size - Vector3.new(0,0,1)
Door_B.size = Door_B.size - Vector3.new(0,0,1)
Door_A.CFrame = CFrameA - CFrameA.lookVector * 0.5
Door_B.CFrame = CFrameB - CFrameB.lookVector * 0.5
end
Door_A.Transparency = 1
Door_B.Transparency = 1
wait(2)
Door_A.Transparency = 0
Door_B.Transparency = 0
for i = 1,3 do
CFrameA = Door_A.CFrame
CFrameB = Door_B.CFrame
Door_A.size = Door_A.size + Vector3.new(0,0,1)
Door_B.size = Door_B.size + Vector3.new(0,0,1)
Door_A.CFrame = CFrameA + CFrameA.lookVector * 0.5
Door_B.CFrame = CFrameB + CFrameB.lookVector * 0.5
for i = 1,10 do
wait()
Door_A.CFrame = Door_A.CFrame - Door_A.CFrame.lookVector * 0.1
Door_B.CFrame = Door_B.CFrame - Door_B.CFrame.lookVector * 0.1
end
end
x[i].Debug.Value = false
end
end
x[i].Door.Scanner_A.Touched:connect(Open)
x[i].Door.Scanner_B.Touched:connect(Open)

function Ownership(owner)
if x[i].Owner.Value == &quot;nobody&quot; then
if game.Players:findFirstChild(owner.Parent.Name) ~= nil then
if game.Players:findFirstChild(owner.Parent.Name):findFirstChild(&quot;Map&quot;) == nil then
local o = Instance.new(&quot;ObjectValue&quot;)
o.Name = &quot;Map&quot;
o.Value = script.Parent.Parent
o.Parent = game.Players:findFirstChild(owner.Parent.Name)
x[i].Owner.Value = owner.Parent.Name
x[i].Name = &quot;Maze Owner: &quot;..owner.Parent.Name
end
end
end
end
x[i].Door.Scanner_A.Touched:connect(Ownership)
x[i].Door.Scanner_B.Touched:connect(OwnerShip)

function Disown(owner)
if x[i].Owner.Value ~= nobody then
if owner.Name == x[i].Owner.Value then
x[i].Name = &quot;Maze Owner: Nobody&quot;
x[i].Owner.Value = &quot;nobody&quot;
end
end
end
game.Players.ChildRemoved:connect(Disown)

--the end stop here
end
end </string>
						<bool name="archivable">true</bool>
					</Properties>
					<Item class="Script" referent="RBX3392">
						<Properties>
							<bool name="Disabled">true</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Character_Marker</string>
							<string name="Source">m = Instance.new(&quot;Model&quot;)
m.Name = script.Parent.Name
m.Parent = script.Parent
p = Instance.new(&quot;Part&quot;)
p.Anchored = true
p.size = Vector3.new(0.5,0.5,0.5)
p.Name = &quot;Head&quot;
p.Parent = m
h = Instance.new(&quot;Humanoid&quot;)
h.Health = 0
h.MaxHealth = 0
h.Parent = m
function OnRemoved(x)
if x == m then
script:Remove()
end
end
script.Parent.ChildRemoved:connect(OnRemoved)
while true do
p.CFrame = CFrame.new((script.Maze.Value[&quot;Build-a-maze&quot;].Base.Position + ((script.Maze.Value.Maze.Maze_Walls.Base.Position - script.Parent.Torso.Position)/10)) + Vector3.new(0,.1,0))
wait()
end
