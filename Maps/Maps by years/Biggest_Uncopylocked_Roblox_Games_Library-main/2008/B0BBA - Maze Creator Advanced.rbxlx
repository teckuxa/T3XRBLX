							<string name="Name">Script</string>
							<string name="Source">function ResetMap()
x = script.Parent.Maze:getChildren()
for i = 1,#x do
if x[i].className == &quot;Model&quot; then x[i]:Remove() end
end
x = script.Parent.Map:getChildren()
for i = 1,#x do
if x[i]:findFirstChild(&quot;Decal&quot;) ~= nil then
x[i].Decal:remove()
end
end
end

function MakeMap()
x = script.Parent.Maze:getChildren()
for i = 1,#x do
if x[i].className == &quot;Model&quot; then x[i]:Remove() end
end
x = script.Parent.Map:getChildren()
for i = 1,#x do
