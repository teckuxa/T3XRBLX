						<Item class="Script" referent="RBX2699">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<string name="Source">function OnTouched(hit)
if game.Players:findFirstChild(script.Parent.Parent.Value) == nil then
if game.Players:getPlayerFromCharacter(hit.Parent) ~= nil then
if game.Players:getPlayerFromCharacter(hit.Parent):findFirstChild(&quot;Maze&quot;) ~= nil then return end
script.Parent.Head.Decal.Texture = &quot;http://www.roblox.com/Thumbs/Avatar.ashx?format=png&amp;x=500&amp;y=500&amp;username=&quot;..hit.Parent.Name
script.Parent.Parent.Value = hit.Parent.Name
script.Parent.Name = hit.Parent.Name..&quot;&apos;s Maze&quot;
v = Instance.new(&quot;ObjectValue&quot;)
v.Name = &quot;Maze&quot;
v.Value = script.Parent.Parent.Parent.Parent
v.Parent = game.Players:getPlayerFromCharacter(hit.Parent)
end
end
end
script.Parent.Part.Touched:connect(OnTouched)

while true do
wait(1)
if script.Parent.Parent.Value ~= &quot;Nobody&quot; then
if game.Players:findFirstChild(script.Parent.Parent.Value) == nil then
script.Parent.Head.Decal.Texture = &quot;&quot;
script.Parent.Parent.Value = &quot;Nobody&quot;
script.Parent.Name = &quot;Nobody&apos;s Maze&quot;
end
end
end
</string>
								<bool name="archivable">true</bool>
