								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<string name="Source">function TeleportToMaze(player)
if player.Parent:findFirstChild(&quot;Torso&quot;) ~= nil then
player.Parent.Torso.CFrame = player.Parent.Torso.CFrame - player.Parent.Torso.Position + script.Parent.Parent.Parent.Maze.Start.Start.Position + Vector3.new(0,3.3,0)
end
end
script.Parent.Touched:connect(TeleportToMaze)</string>
								<bool name="archivable">true</bool>
