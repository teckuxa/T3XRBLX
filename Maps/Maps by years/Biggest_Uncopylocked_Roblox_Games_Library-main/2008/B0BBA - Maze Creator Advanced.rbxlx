					<Item class="Script" referent="RBX1047">
						<Properties>
							<bool name="Disabled">true</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Rename</string>
							<string name="Source">x = script.Parent:getChildren()
for i = 1,#x do
if x[i].className == &quot;Part&quot; then
x[i].Name = math.ceil(x[i].CFrame.x)..&quot;/&quot;..math.ceil(x[i].CFrame.z)
--x[i].CFrame = CFrame.new(math.ceil(x[i].CFrame.x),1,math.ceil(x[i].CFrame.z))
end
end
</string>
							<bool name="archivable">true</bool>
						</Properties>
						<Item class="Script" referent="RBX1048">
							<Properties>
								<bool name="Disabled">true</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<string name="Source">d = Instance.new(&quot;Decal&quot;)
d.Texture = &quot;http://www.roblox.com/asset/?id=13437930&quot;
d.Face = &quot;Top&quot;
d.Parent = p

x = script.Parent.Parent.Maze:getChildren()
for i = 1,#x do
if x[i].Name == &quot;Part&quot; then x[i]:Remove() end
end
x = script.Parent:getChildren()
for i = 1,#x do
if x[i].className == &quot;Part&quot; then
part = x[i]
if part:findFirstChild(&quot;Decal&quot;) ~= nil then
if part.Decal.Texture == &quot;http://www.roblox.com/asset/?id=13462520&quot; then
p = Instance.new(&quot;Part&quot;)
p.Anchored = true
p.size = Vector3.new(20,20,5)
p.CFrame = (CFrame.new(script.Parent.Parent.Maze.Floor.Position + ((script.Parent.Base.Position - part.Position) * 20)) + Vector3.new(7.5,18.2,0)) * CFrame.fromEulerAnglesXYZ(0,math.rad(270),0)
p.Parent = script.Parent.Parent.Maze
p = Instance.new(&quot;Part&quot;)
p.Anchored = true
p.size = Vector3.new(20,20,5)
p.CFrame = (CFrame.new(script.Parent.Parent.Maze.Floor.Position + ((script.Parent.Base.Position - part.Position) * 20)) + Vector3.new(-7.5,18.2,0)) * CFrame.fromEulerAnglesXYZ(0,math.rad(270),0)
p.Parent = script.Parent.Parent.Maze
end
if part.Decal.Texture == &quot;http://www.roblox.com/asset/?id=13462513&quot; then
p = Instance.new(&quot;Part&quot;)
p.Anchored = true
p.size = Vector3.new(5,20,20)
