							<Item class="Script" referent="RBX3136">
								<Properties>
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">Script</string>
									<string name="Source">function EndMaze(player)
if player.Parent:findFirstChild(&quot;Torso&quot;) ~= nil then
player.Parent.Torso.CFrame = player.Parent.Torso.CFrame - player.Parent.Torso.Position + Vector3.new(math.random(-5,5),10,math.random(-5,5))
local m = Instance.new(&quot;Message&quot;)
m.Text = player.Parent.Name..&quot; completed the demo maze!&quot;
m.Parent = Workspace
wait(2)
m:Remove()
end
end
script.Parent.Touched:connect(EndMaze)</string>
									<bool name="archivable">true</bool>
								</Properties>
							</Item>
