							<string name="Name">Script</string>
							<string name="Source">m = Instance.new(&quot;Message&quot;)
Debug = false

function TeleportToMaze(hit)
if script.Parent.Parent.Owner.Value == nil then return end
local Player = hit.Parent
if game.Players:getPlayerFromCharacter(Player) ~= nil then
if Player:findFirstChild(&quot;Torso&quot;) ~= nil then
Player.Torso.CFrame = script.Parent.Parent.Parent.Maze.Entrance.Floor.CFrame + Vector3.new(0,4,0)
if Player:findFirstChild(&quot;Pos&quot;) == nil then
s = script.Pos:Clone()
s.Value.Value = script.Parent.Parent.Parent.Maze
s.Disabled = false
s.Parent = Player
end
end
end
end
script.Parent.Teleport.Touched:connect(TeleportToMaze)

function TeleportFromMaze(hit)
if Debug == true then return end
local Player = hit.Parent
if game.Players:getPlayerFromCharacter(Player) ~= nil then
if Player:findFirstChild(&quot;Torso&quot;) ~= nil then
Player.Torso.CFrame = script.Parent.Parent.Base.CFrame + Vector3.new(0,30,0)
if Player:findFirstChild(&quot;Player&quot;) ~= nil then
Player.Player:Remove()
end
if ((script.Parent.Parent.Owner.Value == &quot;Nobody&quot;) or (script.Parent.Parent.Owner.Value ==  Player.Name)) then return end
m.Text = Player.Name..&quot; Completed &quot;..script.Parent.Parent.Owner.Value..&quot;&apos;s Maze!&quot;
m.Parent = Workspace
Debug = true
wait(3)
Debug = false
m.Parent = nil
end
end
end
script.Parent.Parent.Parent.Maze.Exit.Floor.Touched:connect(TeleportFromMaze)</string>
							<bool name="archivable">true</bool>
						</Properties>
						<Item class="Script" referent="RBX164">
							<Properties>
								<bool name="Disabled">true</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Pos</string>
								<string name="Source">M = Instance.new(&quot;Model&quot;)
M.Name = &quot;Player&quot;
M.Parent = script.Parent

m = Instance.new(&quot;Model&quot;)
m.Name = script.Parent.Name
m.Parent = M

h = Instance.new(&quot;Humanoid&quot;)
h.MaxHealth = 0
h.Parent = m

p = Instance.new(&quot;Part&quot;)
p.Name = &quot;Head&quot;
p.FormFactor = &quot;Symmetric&quot;
p.size = Vector3.new(1,1,1)
p.Anchored = true
p.CanCollide = false
p.Parent = m

m = Instance.new(&quot;BlockMesh&quot;)
m.Scale = Vector3.new(1/5,1/5,1/5)
m.Offset = Vector3.new(0,-0.4,0)
m.Parent = p

function OnRemoved(child)
if child == M then
script:Remove()
end
end

script.Parent.ChildRemoved:connect(OnRemoved)

while true do
wait()
p.Position = script.Value.Value.Map.Base.Position + ((script.Value.Value.Maze.Floor.Position - script.Parent.Torso.Position)/20)
end
