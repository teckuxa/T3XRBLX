function ResetMap()
x = script.Parent.Map:getChildren()
for i = 1,#x do
if x[i]:findFirstChild(&quot;Decal&quot;) ~= nil then
x[i].Decal:remove()
end
end
end
script.Parent[&quot;Clear-Maze&quot;].Head.ClickDetector.MouseClick:connect(ResetMap)
script.Parent.Parent.Tower.Owner.Changed:connect(ResetMap)

x = script.Parent.Map:getChildren()
for i = 1,#x do
x[i].ChildAdded:connect(function() ChangePart(x[i]) end)
x[i].ChildRemoved:connect(function() ChangePart(x[i]) end)
end
