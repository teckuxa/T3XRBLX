					<Item class="Script" referent="RBX2632">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<string name="Source">script.Parent.Elevator.CFrame = script.Parent.Base.CFrame
script.Parent.Elevator.BodyGyro.cframe = script.Parent.Base.CFrame
script.Parent.Elevator.BodyPosition.position = script.Parent.Base.CFrame.p

function onTouched(hit)
if hit.Parent:findFirstChild(&quot;Torso&quot;) ~= nil then
if hit.Parent.Name ~= script.Parent.Parent.Owner.Value then
hit.Parent.Torso:breakJoints()
end
end
end
script.Parent.Door.Touched:connect(onTouched)

while true do
script.Parent.Elevator.CFrame = script.Parent.Base.CFrame
script.Parent.Elevator.BodyGyro.cframe = script.Parent.Base.CFrame
script.Parent.Elevator.BodyPosition.position = script.Parent.Base.CFrame.p
script.Parent.Elevator:breakJoints()
wait(2)
	for i = 0,200 do
		wait()
		script.Parent.Elevator.BodyPosition.position = script.Parent.Elevator.BodyPosition.position + Vector3.new(0,1/4,0)
	end
wait(2)
	for i = 0,200 do
		wait()
		script.Parent.Elevator.BodyPosition.position = script.Parent.Elevator.BodyPosition.position - Vector3.new(0,1/4,0)
	end
wait(2)
end
