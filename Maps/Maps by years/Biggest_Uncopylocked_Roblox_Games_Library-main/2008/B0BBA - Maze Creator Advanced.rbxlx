						<string name="Source">--B0BBA
function Selected(mouse)
mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end

function onButton1Down(mouse)
if script.Parent.Parent.Parent.Character:findFirstChild(script.Parent.Parent.Parent.Character.Name) ~= nil then
script.Parent.Parent.Parent.Character:findFirstChild(script.Parent.Parent.Parent.Character.Name):remove()
end
script.Parent.Parent.Parent.Character.Torso.Velocity = Vector3.new(0,0,0)
script.Parent.Parent.Parent.Character.Torso.RotVelocity = Vector3.new(0,0,0)
script.Parent.Parent.Parent.Character.Torso.CFrame = script.Parent.Parent.Parent.Character.Torso.CFrame - script.Parent.Parent.Parent.Character.Torso.Position + Vector3.new(math.random(-5,5),10,math.random(-5,5))
end


script.Parent.Selected:connect(Selected)
</string>
