					<Item class="Geometry" referent="RBX10198">
						<Properties>
							<string name="Name">No samurai plzzz</string>
							<bool name="archivable">true</bool>
						</Properties>
						<Item class="Model" referent="RBX10199">
							<Properties>
								<CoordinateFrame name="ModelInPrimary">
									<X>0</X>
									<Y>0</Y>
									<Z>0</Z>
