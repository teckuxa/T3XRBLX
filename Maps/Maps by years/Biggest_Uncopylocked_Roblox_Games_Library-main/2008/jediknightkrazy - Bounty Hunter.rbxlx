						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">BountyContext</string>
						<ProtectedString name="Source">_G[game.Workspace.BountyManager].AddPlayer(script.PlayerValue.Value)
while true do
	wait(10)
	if (script:FindFirstChild(&quot;PlayerValue&quot;) == nil or script.PlayerValue.Value == nil or script.PlayerValue.Value.Parent == nil) then
		script:Remove()
	end
end
</ProtectedString>
