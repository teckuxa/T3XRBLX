					<Item class="Script" referent="RBX11546">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">TimerScript</string>
							<ProtectedString name="Source">while true do
	local time = game.Workspace.GameScript.SecondsLeft.Value
	local minutes = math.floor(time / 60)
	local seconds = time - (minutes * 60)
	local secondsString = tostring(seconds)
	if (string.len(secondsString) &lt; 2) then
		secondsString = &quot;0&quot; .. secondsString
	end
	script.Parent.Text = minutes .. &quot;:&quot; .. secondsString .. &quot; remaining&quot;
	if (time &lt;= 30 and time % 2 == 0) then
		script.Parent.BackgroundColor = BrickColor.new(&quot;Really red&quot;)
	else
		script.Parent.BackgroundColor = BrickColor.new(&quot;Institutional white&quot;)
	end
	wait(0.5)
end
</ProtectedString>
