								<string name="Name">Script</string>
								<ProtectedString name="Source">script.Parent.MouseButton1Click:connect(function()
	local h = script.Parent.Parent.Parent.Parent.Parent.Character.Humanoid
	--remove killtags
	while h:FindFirstChild(&quot;creator&quot;) ~= nil do
		h:FindFirstChild(&quot;creator&quot;):Remove()
	end
	h.Health = 0
end)</ProtectedString>
