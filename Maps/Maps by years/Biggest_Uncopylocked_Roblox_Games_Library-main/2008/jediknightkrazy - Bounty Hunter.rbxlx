				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">onPlayerEnter</string>
				<ProtectedString name="Source">function bountyMgr() return _G[game.Workspace.BountyManager] end
function unlockMgr() return _G[game.Workspace.UnlockManager] end

function SpawnRandom(character)
	if (character == nil) then return end
	local map = game.Workspace:FindFirstChild(&quot;Map&quot;)
	if (map == nil) then
		delay(1, function() SpawnRandom(character) end)
		return
	end
	local spawnPoints = {}
	local c = map:GetChildren()
	for i, ci in ipairs(c) do
		if (ci.Name == &quot;SpawnLocation&quot;) then
			table.insert(spawnPoints, ci)
		end
	end
	local spawnPoint = spawnPoints[math.random(#spawnPoints)]
	if (spawnPoint == nil) then
		delay(1, function() SpawnRandom(character) end)
		return
	end
	character.Torso.CFrame = CFrame.new(character.Torso.Position) + Vector3.new(0, 10, 0)
	wait(0.2)
	character.Torso.CFrame = CFrame.new(spawnPoint.Position) + Vector3.new(0, 10, 0)
end

function onPlayerRespawned(newPlayer)
	--game.Workspace.CleanMessages:Clone().Parent = newPlayer.Character
	--unlockMgr().MakePreviews(newPlayer)
	wait(0.5)
	--SpawnRandom(newPlayer.Character)
	while (newPlayer:FindFirstChild(&quot;Message&quot;) ~= nil) do
		newPlayer.Message:Remove()
	end
	--bountyMgr().AddPlayer(newPlayer.Character)
end



function onPlayerEntered(newPlayer)
	newPlayer.Changed:connect(function (property)
		if (property == &quot;Character&quot;) then
			onPlayerRespawned(newPlayer)
		end
	end)
end

game.Players.PlayerAdded:connect(onPlayerEntered)
</ProtectedString>
