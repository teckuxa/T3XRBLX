					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">ShopScript</string>
					<ProtectedString name="Source">moneyMgr = function() return _G[game.Workspace.CashManager] end
--bountyMgr = function() return _G[game.Workspace.BountyManager] end

wait(1)
local mainWindow = script.Parent.MainWindow
local tabs = mainWindow.ShopTabs
local shopWin = mainWindow.ShopWindow
local scrollBar = shopWin.Scrollbar
local player = script.Parent.Parent.Parent
local cashLabel = mainWindow.CashLabel
local spawnButton = mainWindow.SpawnButton

local categoryLabel = shopWin.CategoryLabel

local items = {}

local shopItem = game.Lighting.ShopItem:Clone()

local debounce = false

local scrollIndex = 0

function refreshScroll()
	local shopIndex = 0
	for i, ci in ipairs(items) do
		local realIndex = shopIndex - scrollIndex
		ci.Position = UDim2.new(0.1, -40 , 0, 40 + (120 * realIndex))
		if ((realIndex &gt; 2) and ((140 + (120 * realIndex) &gt; shopWin.AbsoluteSize.y)) or
		40 + (120 * realIndex) &lt; 0) then
			ci.Visible = false
		else
			ci.Visible = true
		end
		shopIndex = shopIndex + 1
	end
	if (#items == 0) then
		scrollBar.Scrollbox.Visible = false
	else
		scrollBar.Scrollbox.Visible = true
		scrollBar.Scrollbox.Size = UDim2.new(0, 20, 1 / #items, 0)
		scrollBar.Scrollbox.Position = UDim2.new(0, 0, scrollIndex/#items, 0)
	end
end

function updateCash()
	cashLabel.Text = &quot;Cash: &quot; .. moneyMgr().GetMoney(player)
end

function scroll(scrollDir)
	scrollIndex = scrollIndex + scrollDir
	if (scrollIndex &lt; 0) then
		scrollIndex = 0
	elseif (scrollIndex &gt; #items - 1) then
		scrollIndex = #items - 1
	end
	refreshScroll()
end

function onTabClicked(tab)
	if (debounce == true) then return end
	local c = tabs:GetChildren()
	for i, ci in ipairs(c) do
		ci.BackgroundColor = BrickColor.new(&quot;Medium red&quot;)
	end
	tab.BackgroundColor = BrickColor.new(&quot;Bright red&quot;)
	categoryLabel.Text = tab.Description.Value

	for i, ci in ipairs(items) do
		ci:Remove()
	end
	items = {}

	local panelIndex = 0
	local c = tab.Items:GetChildren()
	local selectedItem = nil

	for i, ci in ipairs(c) do
		if (ci.Value == 1) then
			selectedItem = ci
		end
	end

	for i, ci in ipairs(c) do
		local itemPanel = shopItem:Clone()

		local isSelected = (ci.Value == 1)
		local description = ci.Description.Value
		local cost = ci.Cost.Value
		
		if (isSelected == true) then
			itemPanel.BackgroundColor = BrickColor.new(&quot;Bright red&quot;)
			if (ci.Cost.Value == 0) then
				itemPanel.BuyButton.Visible = false
			else
				itemPanel.BuyButton.Visible = true
				itemPanel.BuyButton.Text = &quot;Refund&quot;
			end
		else
			itemPanel.BackgroundColor = BrickColor.new(&quot;Medium red&quot;)
			if (selectedItem.Cost.Value == 0) then
				itemPanel.BuyButton.Visible = true
			else
				itemPanel.BuyButton.Visible = false
			end
		end
		itemPanel.DescriptionLabel.Text = description
		itemPanel.CostLabel.Text = &quot;Cost: &quot; .. cost
		itemPanel.Name = ci.Name
		itemPanel.NameLabel.Text = ci.Name
		itemPanel.OriginalItem.Value = ci
		itemPanel.BuyButton.MouseButton1Click:connect(function() onBuyButtonClicked(itemPanel) end)
		
		itemPanel.Parent = shopWin
		table.insert(items, itemPanel)
		scrollIndex = 0
		refreshScroll()
	
		panelIndex = panelIndex + 1
	end
end

function onBuyButtonClicked(panel)
	if (debounce == true) then return end
	
	local wasSelected = (panel.OriginalItem.Value.Value == 1)

	if (not wasSelected) then
		if (moneyMgr().GetMoney(player) &lt; panel.OriginalItem.Value.Cost.Value) then
			debounce = true
			panel.BuyButton.Text = &quot;Insufficient funds&quot;
			delay(1, function()
				panel.BuyButton.Text = &quot;Buy&quot;
				debounce = false
			end)
			return
		else
			moneyMgr().ChangeMoney(player, -panel.OriginalItem.Value.Cost.Value)
			updateCash()
		end
	else
		moneyMgr().ChangeMoney(player, panel.OriginalItem.Value.Cost.Value)
		updateCash()
	end

	local defaultItem = nil
	for i, ii in ipairs(items) do
		ii.OriginalItem.Value.Value = 0
		ii.BackgroundColor = BrickColor.new(&quot;Medium red&quot;)
		if (wasSelected == false and panel.OriginalItem.Value.Cost.Value ~= 0) then
			ii.BuyButton.Visible = false
		else
			ii.BuyButton.Visible = true
		end
		ii.BuyButton.Text = &quot;Buy&quot;
		if (ii.OriginalItem.Value:FindFirstChild(&quot;IsDefault&quot;) ~= nil) then
			defaultItem = ii
		end
	end

	if (wasSelected and defaultItem ~= nil) then
		defaultItem.OriginalItem.Value.Value = 1
		defaultItem.BackgroundColor = BrickColor.new(&quot;Bright red&quot;)
		defaultItem.BuyButton.Visible = false
	else
		panel.OriginalItem.Value.Value = 1
		panel.BackgroundColor = BrickColor.new(&quot;Bright red&quot;)
		if (panel.OriginalItem.Value.Cost.Value ~= 0) then
			panel.BuyButton.Visible = true
			panel.BuyButton.Text = &quot;Refund&quot;
		else
			panel.BuyButton.Visible = false
		end
	end
end

function onSpawnButtonClicked()
	character = player.Character
	if (character == nil) then return end
	local map = game.Workspace:FindFirstChild(&quot;Map&quot;)
	if (map == nil) then return end

	local spawnPoints = {}
	local c = map:GetChildren()
	for i, ci in ipairs(c) do
		if (ci.Name == &quot;SpawnLocation&quot;) then
			table.insert(spawnPoints, ci)
		end
	end
	local spawnPoint = spawnPoints[math.random(#spawnPoints)]
	if (spawnPoint == nil) then return end
	
	character.Torso.CFrame = CFrame.new(character.Torso.Position) + Vector3.new(0, 10, 0)
	wait(0.2)
	character.Torso.CFrame = CFrame.new(spawnPoint.Position) + Vector3.new(0, 10, 0)

	local refundS = script.RefundScript:Clone()
	

	local c = tabs:GetChildren()
	for i, ci in ipairs(c) do
		local items = ci.Items:GetChildren()
		for i2, item in ipairs(items) do
			if (item.Value == 1) then
				local realCat = game.Lighting.ShopItems:FindFirstChild(ci.Name)
				local realItem = realCat:FindFirstChild(item.Name)
				refundS.MoneySpent.Value = refundS.MoneySpent.Value + item.Cost.Value
				if (realItem ~= nil) then
					realItem = realItem:Clone()
					if (realItem:IsA(&quot;Tool&quot;) or realItem:IsA(&quot;HopperBin&quot;)) then
						realItem.Parent = player.Backpack
					end
					if (realItem:IsA(&quot;GuiMain&quot;)) then
						realItem.Parent = player.PlayerGui
					end
					if (realItem:IsA(&quot;Script&quot;)) then
						realItem.Parent = player.Character
					end
				end
			end
		end
	end
	c = game.Lighting.Guis:GetChildren()
	for i, ci in ipairs(c) do
		ci:Clone().Parent = player.PlayerGui
	end
	local bcontext = script.BountyContext:Clone()
	bcontext.Disabled = false
	bcontext.PlayerValue.Value = character
	bcontext.Name = character.Name .. bcontext.Name
	bcontext.Parent = game.Workspace
	refundS.Disabled = false
	refundS.Parent = character
	
	script.Parent:Remove()
end

local c = tabs:GetChildren()
for i, ci in ipairs(c) do
	ci.MouseButton1Click:connect(function() onTabClicked(ci) end)
end
scrollBar.UpButton.MouseButton1Click:connect(function() scroll(-1) end)
scrollBar.DownButton.MouseButton1Click:connect(function() scroll(1) end)
spawnButton.MouseButton1Click:connect(onSpawnButtonClicked)

shopWin.Changed:connect(function(prop)
	if (prop == &quot;AbsoluteSize&quot;) then
		refreshScroll()
	end
end)
updateCash()</ProtectedString>
