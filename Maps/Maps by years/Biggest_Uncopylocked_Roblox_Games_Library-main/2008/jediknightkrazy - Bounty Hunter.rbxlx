				<ProtectedString name="Source">_G[script] = {}
public = _G[script]

Currency = &quot;Points&quot;
InitialValue = 0

function GetStat(player)
	if (player == nil) then return nil end
	--If it&apos;s a character, try to get the player
	if(player.className == &quot;Model&quot;) then
		realPlayer = game.Players:GetPlayerFromCharacter(player)
		if (realPlayer ~= nil) then return GetStat(realPlayer) end
	elseif (player:FindFirstChild(&quot;leaderstats&quot;) ~= nil and
		player.leaderstats:FindFirstChild(Currency) ~= nil) then
		return player.leaderstats[Currency]
	end
end

public.GetMoney = function(player)
	stat = GetStat(player)
	if (stat ~= nil) then
		return stat.Value
	end
end

public.SetMoney = function(player, money)
	stat = GetStat(player)
	if (stat ~= nil) then
		stat.Value = money
	end
end

public.ChangeMoney = function(player, money)
	stat = GetStat(player)
	if (stat ~= nil) then
		stat.Value = stat.Value + money
		if (stat.Value &lt;= 0) then stat.Value = 0 end
	end
end

function onPlayerEntered(newPlayer)
	local stats = newPlayer:FindFirstChild(&quot;leaderstats&quot;)
	if (stats == nil) then
		stats = Instance.new(&quot;IntValue&quot;)
		stats.Name = &quot;leaderstats&quot;
	end
	
	local c = stats:FindFirstChild(Currency)
	if (c == nil) then
		c = Instance.new(&quot;IntValue&quot;)
		c.Name = Currency
		c.Value = InitialValue
	end
	c.Parent = stats
	stats.Parent = newPlayer
end

game.Players.ChildAdded:connect(onPlayerEntered)</ProtectedString>
