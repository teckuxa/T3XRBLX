						<string name="Name">RefundScript</string>
						<ProtectedString name="Source">local eligible = true
function onDied()
	if (eligible and script.MoneySpent.Value &gt; 0) then
		_G[game.Workspace.CashManager].ChangeMoney(script.Parent, script.MoneySpent.Value)
		_G[game.Workspace.MessageManager].ShowPlayerWarning(&quot;You received a spawnkill refund of &quot; .. script.MoneySpent.Value .. &quot;.&quot;, game.Players:GetPlayerFromCharacter(script.Parent), BrickColor.new(&quot;Bright blue&quot;))
	end
end
script.Parent.Humanoid.Died:connect(onDied)
wait(10)
eligible = false


</ProtectedString>
