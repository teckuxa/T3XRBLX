						<string name="Name">BooletScript</string>
						<ProtectedString name="Source">local boolet = script.Parent

trail = game.Lighting.Projectiles.BooletTrail:Clone()

local startPoint = boolet.Position
local lastPos = boolet.Position
function showTrail()
	local dist = (boolet.Position - lastPos).magnitude
	local vector = (boolet.Position - lastPos).unit
		
	local c = trail:Clone()
	c.CFrame = CFrame.new(Vector3.new(0,0,0), vector) + boolet.Position - (vector * (dist / 2))
	c.Mesh.Scale = Vector3.new(0.5, 0.5, dist)
	c.Parent = game.Workspace
	lastPos = boolet.Position
end

local onehit = false
boolet.Touched:connect(function(part)
	showTrail()
	if (onehit == true) then return end
	onehit = true
	if (part.Parent:FindFirstChild(&quot;Humanoid&quot;) ~= nil) then
		local h = part.Parent.Humanoid
		local sound = game.Lighting.Sounds.Bash:Clone()
		sound.Parent = boolet
		sound:Play()
		local tag = boolet:findFirstChild(&quot;creator&quot;)
		if (tag ~= nil and h.Parent ~= boolet.creator.Value.Character) then
		-- kill all other tags
			while(h:FindFirstChild(&quot;creator&quot;) ~= nil) do
				h:FindFirstChild(&quot;creator&quot;).Parent = nil
			end

			local new_tag = tag:clone()
			new_tag.Parent = h
			--debris:AddItem(new_tag, 1)
		end
		if (h.Parent ~= boolet.creator.Value.Character) then
			local dist = (boolet.Position - startPoint).magnitude
			local dmg = math.random(30,40)
			h:TakeDamage(dmg)
		end
			boolet:Remove()
	elseif (part.CanCollide == true and part.Name ~= &quot;ShotgunRound&quot;) then
		delay(0.1, function() boolet:Remove() end)
	else
		onehit = false
	end
end)

delay(10, function() boolet:Remove() end)
while boolet.Parent ~= nil do
	showTrail()
	wait(0.2)
end
