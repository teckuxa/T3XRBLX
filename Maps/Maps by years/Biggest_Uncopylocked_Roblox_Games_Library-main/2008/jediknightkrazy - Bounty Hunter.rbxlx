						</CoordinateFrame>
						<string name="Name">Heavy Pistol</string>
						<Content name="TextureId"><null></null></Content>
						<bool name="archivable">true</bool>
					</Properties>
					<Item class="Script" referent="RBX10941">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Server Script</string>
							<ProtectedString name="Source">local Tool = script.Parent
--local mouse
local char
local sound = Tool.Handle.Fire

function weld(part, cframe)
	local w1 = Instance.new(&quot;Weld&quot;)
	w1.Parent = script.Parent.Handle
	w1.Part0 = w1.Parent
	w1.Part1 = part
	w1.C1 = cframe
end


Tool.Enabled = true
function onActivated()
	if not Tool.Enabled then
		return
	end

	Tool.Enabled = false

	local character = Tool.Parent
	local humanoid = character.Humanoid
	if humanoid == nil then
		print(&quot;Humanoid not found&quot;)
		return 
	end
	
	
	local boolet = game.Lighting.Projectiles:FindFirstChild(&quot;HeavyPistolRound&quot;):Clone()
	local bv = Instance.new(&quot;BodyVelocity&quot;)
	bv.P = 10000
	local firePos = Tool.Handle.Position
	local vector = (humanoid.TargetPoint - firePos).unit
	local dist = (firePos - humanoid.TargetPoint).magnitude
	local tag = Instance.new(&quot;ObjectValue&quot;)
	tag.Name = &quot;creator&quot;
	tag.Value = game.Players:GetPlayerFromCharacter(char)
	tag.Parent = boolet
	local spreadTarget = humanoid.TargetPoint +
			Vector3.new(math.random(-dist, dist) / 13, math.random(-dist, dist) / 13, math.random(-dist, dist) / 13)
	local spreadVector = (spreadTarget - firePos).unit
	bv.maxForce = Vector3.new(10000,10000,10000)
	bv.velocity = spreadVector * 450
	bv.Parent = boolet
	boolet.CFrame = CFrame.new(firePos) + spreadVector * 5
	boolet.Velocity = spreadVector * 450
	boolet.Parent = game.Workspace
	sound:Play()
	wait(0.8)
	Tool.Enabled = true
end

function onUnequipped(m)
	char = nil
	--Selfdestruct when dropped
	local parent = Tool.Parent
	if (parent == game.Workspace) then
		Tool:Remove()
	end
end


function onEquipped(m)

	char = Tool.Parent

	script.Parent.Activated:connect(function() onActivated() end)
	
	
end

script.Parent.Equipped:connect(onEquipped)
script.Parent.Unequipped:connect(onUnequipped)
</ProtectedString>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
					<Item class="Script" referent="RBX10942">
						<Properties>
