				<string name="Name">GameScript</string>
				<ProtectedString name="Source">secondsLeft = script.SecondsLeft
ROUND_LENGTH = 600
m = Instance.new(&quot;Message&quot;)
moneyMgr = function() return _G[game.Workspace.MoneyManager] end
local lastMap = &quot;&quot;

while true do
	
	local maps = game.Lighting.Maps:GetChildren()
	local newMap = nil
	local newMapName = lastMap

	while newMapName == lastMap do
		local randIndex = math.random(#maps) 
		newMap = maps[randIndex]
		newMapName = newMap.Name
	end
	
	lastMap = newMapName
	m.Text = &quot;Welcome to &quot; .. newMapName .. &quot;!&quot;
	m.Parent = game.Workspace
	wait(2)
	m.Text = &quot;You have 10 minutes to find and eliminate your targets.&quot;
	wait(2)
	m.Text = &quot;May the best Hunter win.&quot;
	wait(2)
	m.Parent = nil

	local c = game.Players:GetChildren()

	for i, ci in ipairs(c) do
		if (ci ~= nil and ci.Character ~= nil) then
			ci.Character.Humanoid.Health = 0
			moneyMgr().SetMoney(ci, 0)
		end
	end

	local currentMap = game.Workspace:FindFirstChild(&quot;Map&quot;)
	if (currentMap ~= nil) then
		currentMap:Remove()
	end
	newMap = newMap:Clone()
	newMap.Parent = game.Workspace
	newMap.Name = &quot;Map&quot;
	newMap:MakeJoints()

	local seconds = ROUND_LENGTH
	secondsLeft.Value = seconds
	
	while (seconds &gt; 0) do
		wait(1)
		m.Parent = nil
		seconds = seconds - 1
		secondsLeft.Value = seconds
		if (seconds == 30) then
			m.Text = &quot;Round ends in 30 seconds!&quot;
			m.Parent = game.Workspace
		end
		if (seconds &lt;= 10) then
			m.Text = &quot;Round ends in &quot; .. seconds .. &quot; seconds&quot;
			m.Parent = game.Workspace
		end
	end

	local c = game.Players:GetChildren()
	local hiscore = -1
	local winner = nil
	local winners = nil

	for i, ci in ipairs(c) do
		if (ci ~= nil) then
			local score = moneyMgr().GetMoney(ci)
			
			if (score &gt; hiscore) then
				winner = ci.Name
				winners = nil
				hiscore = score
			elseif (score == hiscore) then
				if (winner ~= nil) then
					winners = {winner}
					winner = nil
				end
				table.insert(winners, ci.Name)
			end
		end
	end

	if (winner ~= nil) then
		m.Text = winner .. &quot; wins with &quot; .. hiscore .. &quot; points!&quot;
		m.Parent = game.Workspace
	elseif (winners ~= nil) then
		m.Text = &quot;Several players tied with &quot; .. hiscore .. &quot; points!&quot;
		m.Parent = game.Workspace
		wait(2)
		text = &quot; &quot;
		for i, s in ipairs(winners) do
			text = text .. s .. &quot; &quot;
		end
		m.Text = text
	end
		
	wait(3)
	m.Text = &quot;New round starting soon!&quot;
	wait(3)
	
end
</ProtectedString>
