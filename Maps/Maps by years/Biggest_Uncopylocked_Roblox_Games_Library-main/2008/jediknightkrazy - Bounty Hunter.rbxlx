								<ProtectedString name="Source">bountyMgr = function() return _G[game.Workspace.BountyManager] end
handle = script.Parent.Handles

while true do
	local character = script.Parent.Parent.Parent.Parent.Character
	local c = game.Players:GetChildren()

	script.Parent.Visible = false

	handle.Adornee = nil
	
	for i, ci in ipairs(c) do
		local hunterChar = ci.Character
		local target = bountyMgr().GetTarget(hunterChar)
	
		if (target ~= nil and target == character and hunterChar:FindFirstChild(&quot;JammerTag&quot;) == nil) then
			if (hunterChar:FindFirstChild(&quot;Torso&quot;) ~= nil) then
				if ((hunterChar.Torso.Position - character.Torso.Position).magnitude &lt;= 50) then
					script.Parent.Visible = true
					handle.Adornee = hunterChar.Torso
					break
				else
				end
			end
		end
		
	end

	wait()
end
