										<Content name="LinkedSource"><null></null></Content>
										<string name="Name">Kill tem!</string>
										<ProtectedString name="Source">function noHelmet(chr)

	local s = script.NoHelmet:clone()
	s.Disabled = false
	s.Parent = chr
	
end

function checkHelmets()
	local p = game.Players:GetPlayers()

	for i=1,#p do
		local c = p[i].Character
		if (c ~= nil) then 
			local helmet = c:findFirstChild(&quot;Samurai&quot;)
			if (helmet == nil and c:findFirstChild(&quot;NoHelmet&quot;) == nil) then
				noHelmet(c)
			end
		end
	end
end

function nosamurai()
	while(true) do
		wait(3)
		checkHelmets()
	end
end

if game:findFirstChild(&quot;NetworkServer&quot;) ~= nil then
	nosamurai()
	wait(600)
	game.Lighting.TimeOfDay = &quot;00:00:00&quot;
	game.Lighting.Brightness = 0
end
</ProtectedString>
