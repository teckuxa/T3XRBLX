					<Item class="LocalScript" referent="RBX11530">
						<Properties>
							<bool name="Disabled">true</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">NavigatorGuiScript</string>
							<ProtectedString name="Source">wait(1)

local char = script.Parent
local player = game.Players:GetPlayerFromCharacter(char)
local gui = script.GuiLink.Value

while true do
	local targetFound = true
	local targetValue = char:FindFirstChild(&quot;TargetValue&quot;)
	if (targetValue == nil) then
		targetFound = false
	elseif (targetValue.Value == nil) then
		targetFound = false
	elseif (targetValue.Value.Parent == nil) then
		targetFound = false
	elseif (targetValue.Value:FindFirstChild(&quot;Torso&quot;) == nil) then
		targetFound = false
	elseif (targetValue.Value.Humanoid.Health &lt;= 0) then
		targetFound = false
	end

	if (targetFound == true) then
		local cameraPos = game.Workspace.CurrentCamera.CoordinateFrame
		
		local headPos = char.Head.Position
		local headPos2D = Vector3.new(headPos.x, 0, headPos.z)
		local cameraPos2D = cameraPos - cameraPos.p + headPos2D
		
		local targetPos = targetValue.Value.Torso.Position
		local targetPos2D = Vector3.new(targetPos.x, 0, targetPos.z)
		local transTargetPos =  cameraPos2D:inverse() * CFrame.new(targetPos2D)
		local transTargetPos2D = Vector3.new(transTargetPos.p.x, 0, transTargetPos.p.z)

		local direction = transTargetPos2D.unit

		local xPos = direction.x * 35
		local yPos = direction.z * 35
		
		if (targetValue.Value:FindFirstChild(&quot;JammerTag&quot;) == nil) then
			gui.XMark.Position = UDim2.new(0.5, xPos, 1, yPos - 100)
			gui.XMark.Text = &quot;X&quot;
		else
			gui.XMark.Position = UDim2.new(0.5, 0, 1, -100)
			gui.XMark.Text = &quot;JAMMED&quot;
		end

		

		local dist = (targetPos - headPos).magnitude
		local label = &quot;&quot;
		--[[if (dist &gt; 200) then
			label = &quot;Freezing!&quot;
		elseif (dist &gt; 175) then
			label = &quot;Very cold.&quot;
		elseif (dist &gt; 150) then
			label = &quot;Cold.&quot;
		elseif (dist &gt; 125) then
			label = &quot;Chilly.&quot;
		elseif (dist &gt; 100) then
			label = &quot;Lukewarm.&quot;
		elseif (dist &gt; 75) then
			label = &quot;Warm.&quot;
		elseif (dist &gt; 50) then
			label = &quot;Hot!&quot;
		elseif (dist &gt; 25) then
			label = &quot;Very hot!&quot;
		else 
			label = &quot;Burning!!!!!&quot;
		end]]--
		if dist &gt; 200 then dist = 200 end

		local percent = (200 - dist) / 200
		local barSize = percent * 150
		gui.Meter.Size = UDim2.new(0, barSize, 0, 20)
		gui.Label.Text = targetValue.Value.Name
	else
		gui.XMark.Position = UDim2.new(0.5, 0, 1, -100)
		gui.Meter.Size = UDim2.new(0, 0, 0, 0)
		gui.Label.Text = &quot;No target&quot;
	end
	
	wait()
end
</ProtectedString>
