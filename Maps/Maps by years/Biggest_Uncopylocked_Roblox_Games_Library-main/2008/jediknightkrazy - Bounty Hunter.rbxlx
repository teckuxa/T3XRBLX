						<Item class="Script" referent="RBX11552">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<ProtectedString name="Source">local helpFrame = script.Parent.Parent.Parent:FindFirstChild(&quot;HelpFrame&quot;)

function Toggle(visibility)
	helpFrame.Visible = visibility
	script.Parent.Visible = not visibility
end

script.Parent.MouseButton1Click:connect(function()
	helpFrame = script.Parent.Parent.Parent:FindFirstChild(&quot;HelpFrame&quot;)
	if (helpFrame == nil) then return end
	local visibility = not helpFrame.Visible
	
	Toggle(visibility)
	
end)

wait(1)
local player = script.Parent.Parent.Parent.Parent.Parent
if (player:FindFirstChild(&quot;HasViewedHelp&quot;) == nil) then
	Toggle(true)
end
</ProtectedString>
								<bool name="archivable">true</bool>
