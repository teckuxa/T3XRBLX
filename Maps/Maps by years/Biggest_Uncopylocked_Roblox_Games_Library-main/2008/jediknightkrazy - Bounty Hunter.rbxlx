public = _G[script]

public.ShowLocalMessage = function(text, pos)
	local m = Instance.new(&quot;Model&quot;)
	m.Name = text
	local h = Instance.new(&quot;Humanoid&quot;)
	h.Name = &quot;Message&quot;
	h.MaxHealth = 0
	local p = Instance.new(&quot;Part&quot;)
	p.Size = Vector3.new(1, 1, 1)
	p.Transparency = 0.9
	p.Anchored = true
	p.CanCollide = false
	p.CFrame = CFrame.new(pos)
	p.Name = &quot;Head&quot;
	h.Parent = m
	p.Parent = m
	m.Parent = game.Workspace
	delay(0, function()
		for i=1, 40 do
			p.CFrame = p.CFrame + Vector3.new(0, 0.1, 0)
			wait(0.05)
		end
		m:Remove()
	end)
end

public.ShowPlayerWarning = function(text, player, color)
	local guiM = Instance.new(&quot;GuiMain&quot;)
	local textLabel = Instance.new(&quot;TextLabel&quot;)
	guiM.Name = &quot;PlayerWarning&quot;
	textLabel.BackgroundColor = color
	textLabel.BorderColor = color
	textLabel.Position = UDim2.new(0,0,0,0)
	textLabel.Size = UDim2.new(1,0,1,0)
	textLabel.Text = text
	textLabel.TextColor = BrickColor.new(&quot;Really black&quot;)
	textLabel.Transparency = 0.3
	textLabel.Parent = guiM
	guiM.Parent = player.PlayerGui
end
