				<string name="Name">BountyManager</string>
				<ProtectedString name="Source">_G[script] = {}
public = _G[script]

msgMgr = function() return _G[game.Workspace.MessageManager] end
moneyMgr = function() return _G[game.Workspace.MoneyManager] end
cashMgr = function() return _G[game.Workspace.CashManager] end

local players = {}

function getPlayer(player)
	for i=1, #players do
		if (players[i] ~= nil and players[i].player == player) then
			return players[i]
		end
	end
	return nil
end

public.GetClosestPlayer = function(pos, maxDist)
	local closestPlayer = nil
	local dist = maxDist
	for i, j in ipairs(players) do
		if (j ~= nil and j.player ~= nil) then
			thisDist = (j.player.Torso.Position - pos).magnitude 
			if (thisDist &lt; dist) then
				closestPlayer = j.player
				dist = thisDist
			end
		end
	end
	return closestPlayer
end


function GetTarget(player)
	playerR = getPlayer(player)
	if (playerR ~= nil) then
		return playerR.target
	else return nil end
end
public.GetTarget = GetTarget

function removePlayer(player)
	for i=1, #players do
		if (players[i] ~= nil and players[i].player == player) then
			table.remove(players, i)
			break
		end
	end
end

function AddDetector(player)
	playerV = getPlayer(player)
	if (player == nil) then return end
	if (playerV == nil) then return end
	--[[local detector
	if (player:FindFirstChild(&quot;HotColdDetector&quot;) ~= nil) then
		detector = player.HotColdDetector
	else
		detector= game.Workspace.HotColdDetector:Clone()
		detector.Parent = player
	end
	detector.Target.Value = playerV.target]]--
	local targetValue = Instance.new(&quot;ObjectValue&quot;)
	if (player:FindFirstChild(&quot;TargetValue&quot;) ~= nil) then
		targetValue = player.TargetValue
	end
	targetValue.Value = playerV.target
	targetValue.Name = &quot;TargetValue&quot;
	targetValue.Parent = player
end

function wasKilledBy(target, player)
	if (target == nil or target.Parent == nil) then return false end
	if (target:FindFirstChild(&quot;Humanoid&quot;) == nil) then return false end
	c = target.Humanoid:GetChildren()
	for i=1, #c do
		if(c[i].Name == &quot;creator&quot;) then
			if (c[i].Value ~= nil and c[i].Value.Character == player) then
				return true
			end
		end
	end
	return false
end

function onTargetKilled(target, player)
	local m = Instance.new(&quot;Message&quot;)
	if (wasKilledBy(target, player)) then 
		m.Text = &quot;Target down!&quot;
		msgMgr().ShowLocalMessage(&quot;+5 to &quot; .. player.Name .. &quot; for target killed&quot;, target.Torso.Position)
		moneyMgr().ChangeMoney(player, 5)
		cashMgr().ChangeMoney(player, 5)
	else
		m.Text = &quot;Your target was killed...&quot;	
	end
	m.Parent = game.Players:GetPlayerFromCharacter(player)
	playerR.target = nil
	delay(3, function() m:Remove() end)
end

function onHunterKilled(player)
	for i=1, #players do
		if (players[i].target ~= player and wasKilledBy(player, players[i].player)) then
			--wasKilledBy(players[i].player, player)
			if (GetTarget(player) == players[i].player) then
				msgMgr().ShowLocalMessage(&quot;+1 to &quot; .. players[i].player.Name .. &quot; for killing hunter!&quot;, player.Torso.Position)
				moneyMgr().ChangeMoney(players[i].player, 1)
				cashMgr().ChangeMoney(players[i].player, 1)
			else
				msgMgr().ShowLocalMessage(&quot;-10 from &quot; .. players[i].player.Name .. &quot; for wrong player killed&quot;, player.Torso.Position)
				moneyMgr().ChangeMoney(players[i].player, -10)
				cashMgr().ChangeMoney(players[i].player, -10)
				--New penalty
				local playerData = game.Players:GetPlayerFromCharacter(players[i].player)
				msgMgr().ShowPlayerWarning(player.Name .. &quot; was not your target!!&quot;, playerData, BrickColor.new(&quot;Really red&quot;))
				players[i].player.Humanoid.Health = 0
			end
		end
	end
	removePlayer(player)
end

function FindTarget(player)
	print(&quot;Finding target&quot;)
	playerR = getPlayer(player)
	if (playerR == nil) then return nil end
	playerR.target = nil
	local target = nil
	if (playerR.targetDeadConnect ~= nil) then
		playerR.targetDeadConnect:disconnect()
		playerR.targetDeadConnect = nil
	end
	--It&apos;s a for so it can time out
	for error=1, 50 do	
		local temp = players[math.random(1, #players)]
		if (temp ~= nil and temp.player ~= nil and temp.player.Parent ~= nil and temp.player ~= player) then
			target = temp.player
			break
		end
	end
	playerR.target = target
	AddDetector(player)
	if (target ~= nil and target.Parent ~= nil) then
		playerR.targetDeadConnect = target:FindFirstChild(&quot;Humanoid&quot;).Died:connect(function() onTargetKilled(target, player) end)
		delay(2, function() CheckTarget(player) end)
	else
		delay(2, function() FindTarget(player) end)
	end
	return target
end
public.FindTarget = FindTarget

function CheckTarget(player)
	while true do
		playerR = getPlayer(player)
		if (playerR == nil) then return end
		if (playerR.target == nil or playerR.target.Parent == nil) then
			FindTarget(player)
			return
		end
		wait(2)
	end
end

function onPlayerLeft(player)
	for i, pi in ipairs(players) do
		if (pi.player == nil or pi.player.Parent == nil) then
			table.remove(players, i)
		end
	end
end

function AddPlayer(player)
	if (getPlayer(player) == nil and player ~= nil and player.Parent ~= nil) then
		table.insert(players, {player=player, target=nil, targetDeadConnect=nil})
		FindTarget(player)
		player.Humanoid.Died:connect(function() onHunterKilled(player) end)
	end

end
public.AddPlayer = AddPlayer
game.Players.PlayerRemoving:connect(onPlayerLeft)</ProtectedString>
