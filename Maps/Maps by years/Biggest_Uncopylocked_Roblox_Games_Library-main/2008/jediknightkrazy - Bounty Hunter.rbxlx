					<Item class="Script" referent="RBX11026">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Server Script</string>
							<ProtectedString name="Source">local Tool = script.Parent
--local mouse
local char
local sound = Tool.Handle.Fire

function weld(part, cframe)
	local w1 = Instance.new(&quot;Weld&quot;)
	w1.Parent = script.Parent.Handle
	w1.Part0 = w1.Parent
	w1.Part1 = part
	w1.C1 = cframe
end


Tool.Enabled = true
function onActivated()
	if not Tool.Enabled then
		return
	end

	Tool.Enabled = false

	local character = Tool.Parent
	local humanoid = character.Humanoid
	if humanoid == nil then
		print(&quot;Humanoid not found&quot;)
		return 
	end
	local boolet = game.Lighting.Projectiles:FindFirstChild(&quot;SniperBoolet&quot;):Clone()
	local bv = Instance.new(&quot;BodyVelocity&quot;)
	bv.P = 10000
	local firePos = Tool.Handle.Position
	local vector = (humanoid.TargetPoint - firePos).unit
	local tag = Instance.new(&quot;ObjectValue&quot;)
	tag.Name = &quot;creator&quot;
	tag.Value = game.Players:GetPlayerFromCharacter(char)
	tag.Parent = boolet
	bv.maxForce = Vector3.new(7500,7500,7500)
	bv.velocity = vector * 600
	bv.Parent = boolet
	boolet.CFrame = CFrame.new(firePos) + (vector * 5)
	boolet.Velocity = vector * 600
	boolet.Parent = game.Workspace
	sound:Play()
	wait(1.5)
	Tool.Enabled = true
end

function onUnequipped(m)
	local realArm = char:FindFirstChild(&quot;Left Arm&quot;)
	realArm.Transparency = 0
	char = nil
	
	--Selfdestruct when dropped
	local parent = Tool.Parent
	if (parent == game.Workspace) then
		Tool:Remove()
	end
end


function onEquipped(m)
	char = Tool.Parent
	--mouse = m
	--local arm = char:FindFirstChild(&quot;Left Arm&quot;):Clone()
	--arm.Parent = script.Parent.Handle
	--weld(arm, CFrame.fromEulerAnglesXYZ(math.rad(225),math.rad(90),math.rad(90)) * CFrame.new(0, 1.5, .1))
	

	--local realArm = char:FindFirstChild(&quot;Left Arm&quot;)
	--realArm.Transparency = 1

	script.Parent.Activated:connect(function() onActivated() end)
	
	
end

script.Parent.Equipped:connect(onEquipped)
script.Parent.Unequipped:connect(onUnequipped)
</ProtectedString>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
					<Item class="LocalScript" referent="RBX11027">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Local Gui</string>
							<ProtectedString name="Source">local Tool = script.Parent

MAX_SCOPE = 150

enabled = true
function onButton1Down(mouse)
	if not enabled then
		return
	end

	enabled = false
	mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot;
	wait(1.5)
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	enabled = true

end

local isScoping = false
local scopeBrick = nil
local scopePos = nil

function scope(hit)
	local player = game.Players.LocalPlayer
	local char = player.Character
	local torso = char.Torso
	local vector = (hit - torso.Position).unit
	local scopePoint

	if ((hit - torso.Position).magnitude &lt; MAX_SCOPE) then
		scopePoint = hit
	else
		scopePoint = torso.Position + (vector * MAX_SCOPE)
	end

	local b = Instance.new(&quot;Part&quot;)
	b.Name = &quot;Scope&quot;
	b.Anchored = true
	b.Transparency = 1
	b.Size = Vector3.new(1,1,1)
	b.Locked = true
	b.CanCollide = false
	b.CFrame = CFrame.new(Vector3.new(0,0,0), vector) + scopePoint
	b.Parent = game.Workspace
	
	local camera = game.Workspace.CurrentCamera
	camera.CameraSubject = b
	camera.CameraType = &quot;Attach&quot;
	
	--char.Humanoid.Running:connect(function() unscope() end)
	local scopePos = torso.Position
	delay(0.5, function() 
		while true do
			if (scopeBrick == nil) then break end
			local nowPos = torso.Position
			if ((nowPos - scopePos).magnitude &gt; 5) then
				unscope()
				break
			end
			wait(1)
		end
	end)

	scopeBrick = b
end

function unscope()
	if (scopeBrick ~= nil) then
		local player = game.Players.LocalPlayer
		local char = player.Character
		local camera = game.Workspace.CurrentCamera
		camera.CameraSubject = char.Humanoid
		camera.CameraType = &quot;Custom&quot;
		
		scopeBrick:Remove()
		scopeBrick = nil
	end
end

function onKeyDown(key, mouse)
	if (key == &quot;q&quot;) then
		if (scopeBrick == nil) then
			scope(mouse.hit.p)
		else
			unscope()
		end
	end
end

function onUnequippedLocal()
	unscope()
end

function onEquippedLocal(mouse)
	if mouse == nil then
		print(&quot;Mouse not found&quot;)
		return 
	end
	
	mouse.KeyDown:connect(function(key) onKeyDown(key, mouse) end)

	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end


Tool.Equipped:connect(onEquippedLocal)
Tool.Unequipped:connect(onUnequippedLocal)</ProtectedString>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
					<Item class="Script" referent="RBX11028">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Weld Script</string>
							<ProtectedString name="Source">function Weldnow()	
	local w1 = Instance.new(&quot;Weld&quot;)
	w1.Parent = script.Parent.Handle
	w1.Part0 = w1.Parent
	w1.Part1 = script.Parent.Handle2
	w1.C1 = CFrame.fromEulerAnglesXYZ(0, 0, 0) * CFrame.new(0, 1.5, 0.3)
	
	local w2 = Instance.new(&quot;Weld&quot;)
	w2.Parent = script.Parent.Handle
	w2.Part0 = w1.Parent
	w2.Part1 = script.Parent.Handle3
	w2.C1 = CFrame.fromEulerAnglesXYZ(3.14, 0, 0) * CFrame.new(0, 0.8, -0.33)

	local w3 = Instance.new(&quot;Weld&quot;)
	w3.Parent = script.Parent.Handle
	w3.Part0 = w1.Parent
