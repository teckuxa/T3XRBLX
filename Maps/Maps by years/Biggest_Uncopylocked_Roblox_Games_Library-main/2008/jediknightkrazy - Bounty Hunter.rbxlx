								<string name="Name">SlowDamage</string>
								<ProtectedString name="Source">while true do
	local players = game.Players:GetChildren()
	for i, pi in ipairs(players) do
		if (pi.Character ~= nil and pi.Character.Head ~= nil) then
			if (pi.Character.Head.Position.Y &lt; script.Parent.Position.Y + 5.5) then
				pi.Character.Humanoid.Health = pi.Character.Humanoid.Health - 15
			end
		end
	end
	wait(1)
end
	</ProtectedString>
