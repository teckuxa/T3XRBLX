						<Item class="Script" referent="RBX9741">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">PulseFog</string>
								<ProtectedString name="Source">this = script.Parent
trans = 0.1
while true do
	while trans &lt; 0.3 do
		trans = trans + 0.05
		this.Transparency = trans
		wait(0.5)
	end
	while trans &gt; 0.2 do
		trans = trans - 0.05
		this.Transparency = trans
		wait(0.5)
	end
end
</ProtectedString>
								<bool name="archivable">true</bool>
							</Properties>
						</Item>
					</Item>
				</Item>
