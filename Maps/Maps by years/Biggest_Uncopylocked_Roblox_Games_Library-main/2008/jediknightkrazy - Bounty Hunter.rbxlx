							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Weld Script</string>
							<ProtectedString name="Source">function Weldnow()	
	local w1 = Instance.new(&quot;Weld&quot;)
	w1.Parent = script.Parent.Handle
	w1.Part0 = w1.Parent
	w1.Part1 = script.Parent.Handle2
	w1.C1 = CFrame.fromEulerAnglesXYZ(0.3, 0, 0) * CFrame.new(0, -0.3, -0.4)
	
	local w2 = Instance.new(&quot;Weld&quot;)
	w2.Parent = script.Parent.Handle
	w2.Part0 = w1.Parent
	w2.Part1 = script.Parent.Handle3
	w2.C1 = CFrame.fromEulerAnglesXYZ(0, 0, 0) * CFrame.new(0, 0.045, 0.2)

	local w3 = Instance.new(&quot;Weld&quot;)
