print(answer)

time = 10
while time &gt; 0 do
	h = Instance.new(&quot;Hint&quot;)
	h.Parent = game.Workspace
	h.Text = time .. &quot; second[s] left to memorize.&quot;
	wait(1)
	time = time-1
	h:remove()
	end

script.Parent.Displayer:remove()

g = game.Players:GetChildren()
for i=1,#g do
	if g[i].Character == nil then return end
	if g[i].Character:findFirstChild(&quot;Playing&quot;) ~= nil then
		pb = script.Parent.PlayerBox:clone()
		pb.Parent = script.Parent
		pb:moveTo(pb.Spawner.Position + Vector3.new(0,0,20*i))
		pb.Name = g[i].Name .. &quot;&apos;s Box&quot;
		g[i].Character:moveTo(pb.Spawner.Position)
		end
	end

time = 60
while time &gt; 0 do
	h = Instance.new(&quot;Hint&quot;)
	h.Parent = game.Workspace
	h.Text = time .. &quot; second[s] left to input sequence.&quot;
	wait(1)
	time = time-1
	h:remove()
	end


--find winner
max = 0

function checkAnswers(box, player)
	local p = 0
	local displays = box:GetChildren()
	for i=1,#displays do
		d = box:findFirstChild(&quot;Display&quot; .. i)
		if d ~= nil then
			if d:findFirstChild(&quot;ClickDetector&quot;) ~= nil then d.ClickDetector:remove() end
			--print(i)
			print(d.Name .. &quot;, &quot; .. answer[i].Name)
			if d.BrickColor == answer[i].BrickColor then
				print(&quot;Yay&quot;)
				p = p+1
				d.Reflectance = 1
				end
			end
		end
		if p &gt; max then max = p end
		local m = Instance.new(&quot;Message&quot;)
		m.Parent = player
		m.Text = &quot;You have gotten &quot; .. p ..&quot; buttons correct!&quot;
		m.Name = &quot;Msg&quot;
		box.NumberCorrect.Value = p
	end

g = game.Players:GetChildren()
for i=1,#g do
	if g[i].Character == nil then return end
	if g[i].Character:findFirstChild(&quot;Playing&quot;) ~= nil then
		local thing = script.Parent:findFirstChild(g[i].Name .. &quot;&apos;s Box&quot;)
		if thing ~= nil then
			checkAnswers(thing, g[i])
			end
		end
	end

wait(3)

g = game.Players:GetChildren()
for i=1,#g do
	if g[i].Character == nil then return end
	if g[i].Character:findFirstChild(&quot;Playing&quot;) ~= nil then
		if g[i]:findFirstChild(&quot;Msg&quot;) ~= nil then g[i].Msg:remove() end
		local thing = script.Parent:findFirstChild(g[i].Name .. &quot;&apos;s Box&quot;)
		if thing ~= nil then
			if thing.NumberCorrect.Value &gt;= max then
				g[i].Character:moveTo(script.Parent.Spawn.Position)
				end
			thing:remove()
			end
		end
	end

wait(4)

game.Workspace.Timer.Value = 0

