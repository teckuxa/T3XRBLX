				<Item class="Script" referent="RBX5418">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">GameScript</string>
						<string name="Source">wait(7)
script.Parent.Spawn:remove()
p = game.Players:GetChildren()
for i=1,#p do
	if p[i].Character ~= nil then 
	if p[i].Character:findFirstChild(&quot;Playing&quot;) ~= nil then
	p[i].Character.Humanoid.WalkSpeed = 8
	local plane = game.Lighting.Plane:clone()
	plane.Parent = script.Parent
	plane.PrimaryPart = plane.Parts.Seat
	plane:moveTo(p[i].Character.Torso.Position)
	plane:makeJoints()
	--p[i].Character:moveTo(script.Parent.Spawn.Position + Vector3.new(math.random(-script.Parent.Spawn.Size.x/3, script.Parent.Spawn.Size.x/3), math.random(40,100), math.random(-script.Parent.Spawn.Size.z/3, script.Parent.Spawn.Size.z/3)))
	plane:moveTo(p[i].Character.Torso.Position-Vector3.new(0,20,0))
	p[i].Character:moveTo(plane.Parts.Seat.Position + Vector3.new(0,2,0))
	local tool = game.Lighting.Pilot:clone()
	tool.Parent = p[i].Backpack
	end
	end
	end



