			<Item class="Script" referent="RBX10306">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<string name="Source">function onTouch(part)
	if part.Parent then
		h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
		if h then
			player = game.Players:findFirstChild(h.Parent.Name)
			if player then
				player.leaderstats.Coins.Value = player.leaderstats.Coins.Value + 4
				script.Parent:remove()
				end
			end
		end
	end

script.Parent.Touched:connect(onTouch)</string>
					<bool name="archivable">true</bool>
