danumber1 = i
break
elseif string.sub(msg,i,i) == &quot;&quot; then
break
end end
if danumber1 == nil then return end
for i =danumber1 + 1,danumber1 + 100 do
if string.sub(msg,i,i) == &quot;/&quot; then
danumber2 = i
break
elseif string.sub(msg,i,i) == &quot;&quot; then
break
