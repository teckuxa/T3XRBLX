						<string name="Name">GameScript</string>
						<string name="Source">wait(7)

time = 0
while time &lt; 130 do
z = game.Lighting.Zombie:clone()
z.Parent = script.Parent
z:makeJoints()
z:moveTo(script.Parent.Base.Position + Vector3.new(math.random(-200,200), math.random(10,20), math.random(-200,200)))
wait(10)
time = time + 10
end

local things = script.Parent:GetChildren()
for i=1,#things do
	if things[i].Name == &quot;Zombie&quot; then
		things[i].Humanoid.Health = 0
		end
	end

local chars = game.Workspace:GetChildren()
for i=1,#chars do
	if chars[i].Name == &quot;Zombie&quot; then
		chars[i].Humanoid.Health = 0
		end
	end

wait(6)
game.Workspace.Timer.Value = 0</string>
