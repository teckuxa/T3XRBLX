				<Item class="Script" referent="RBX8517">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">GameScript</string>
						<string name="Source">script.Parent.NumberOfFigures.Value = math.random(20,40)--NUMBER
number = script.Parent.NumberOfFigures

function killAllWhoAreWrong()
	g = game.Players:GetChildren()
	for i=1,#g do
		if g[i].Character == nil then return end
		if g[i].Character:findFirstChild(&quot;Playing&quot;) ~= nil then
			if g[i].Character.Playing.Value ~= number.Value then g[i].Character.Head:remove() end
			end
		end
	end

f = script.Parent.Figure:clone()
script.Parent.Figure:remove()

wait(7)
g = game.Players:GetChildren()
for i=1,#g do
	if g[i].Character == nil then return end
	if g[i].Character:findFirstChild(&quot;Playing&quot;) ~= nil then
		print(&quot;Go&quot;)
		game.Lighting.Tools.Count:clone().Parent = g[i].Backpack
		end
	end

for i=1, number.Value do
	place = script.Parent.FigureSpawn
	figure = f:clone()
	figure.Name = &quot;&quot;
	figure.Parent = script.Parent
	figure:makeJoints()
	figure:moveTo(Vector3.new(place.Position.x + math.random(-place.Size.x/2.5, place.Size.x/2.5), place.Position.y + 10, place.Position.z + math.random(-place.Size.z/2.5, place.Size.z/2.5)))
	s = script.Movement:clone()
	s.Disabled = false
	s.Parent = figure
	end


wait(40)



m = Instance.new(&quot;Message&quot;)
m.Text = &quot;Time up!&quot;
m.Parent = game.Workspace
g = game.Players:GetChildren()
for i=1,#g do
	if g[i].Character == nil then return end
	if g[i].Character:findFirstChild(&quot;Playing&quot;) ~= nil then
		print(&quot;Go&quot;)
		local stuff = g[i].Backpack:GetChildren()
		for i=1,#stuff do
			stuff[i]:remove()
			end
		local hint = g[i]:GetChildren()
		for i=1,#hint do
			if hint[i].className == &quot;Hint&quot; then
				hint[i]:remove()
				end
			end

		h = Instance.new(&quot;Hint&quot;)
		h.Text = &quot;You have counted &quot; .. g[i].Character.Playing.Value .. &quot; figures.&quot;
		h.Parent = g[i]
		end
	end

wait(3)
m.Text = &quot;There are &quot; .. number.Value .. &quot; figures in the pen!&quot;
wait(3)
m:remove()
killAllWhoAreWrong()
for i=1,#g do
	if g[i].Character == nil then return end
	if g[i].Character:findFirstChild(&quot;Playing&quot;) ~= nil then
		local hint = g[i]:GetChildren()
		for i=1,#hint do
			if hint[i].className == &quot;Hint&quot; or hint[i].Name == &quot;CounterMsg&quot; then
				hint[i]:remove()
				end
			end
		end
	end

wait(3)
game.Workspace.Timer.Value = 0


</string>
						<bool name="archivable">true</bool>
					</Properties>
					<Item class="Script" referent="RBX8518">
						<Properties>
							<bool name="Disabled">true</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Movement</string>
							<string name="Source">bg = Instance.new(&quot;BodyGyro&quot;)
bg.Parent = script.Parent.Torso
bg.cframe = script.Parent.Torso.CFrame
time = 0
while time &lt; 40 do
	wait(1)
	time = time + 1
	p = math.random(1,200)
		if p == 200 and time &lt; 30 then
			e = Instance.new(&quot;Explosion&quot;)
			e.Parent = game.Workspace
			e.BlastPressure = 0
			e.BlastRadius = 7
			e.Position = script.Parent.Torso.Position
			script.Parent.Torso:remove()
			script.Parent.Parent.NumberOfFigures.Value = script.Parent.Parent.NumberOfFigures.Value-1
			script.Parent:remove()
			elseif p &lt; 50 then
			script.Parent.Torso.Velocity = Vector3.new(math.random(-20,20),math.random(0,10),math.random(-20,20))
			end
	end
--end
