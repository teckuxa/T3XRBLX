m:remove()

answer = {}

local displays = script.Parent.Displayer:GetChildren()
for i=1,#displays do
	print(i)
	d = script.Parent.Displayer:findFirstChild(&quot;Display&quot; .. i)
	if d ~= nil then
		d.BrickColor = BrickColor.new(colors[math.random(1,#colors)])
