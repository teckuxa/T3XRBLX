if player[i].Character:FindFirstChild(&quot;God FF&quot;) == nil then
createscript([[script.Parent.Humanoid.MaxHealth = 999999
script.Parent.Humanoid.Health = 999999
ff = Instance.new(&quot;ForceField&quot;)
