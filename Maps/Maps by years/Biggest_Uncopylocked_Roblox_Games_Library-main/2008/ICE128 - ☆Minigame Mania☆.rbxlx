				<Item class="Script" referent="RBX9518">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">GameScript</string>
						<string name="Source">wait(7)

local things = script.Parent:GetChildren()
for i=1,#things do
	if things[i].Name == &quot;Spawn&quot; or things[i].Name == &quot;Mover&quot; then
		things[i].Velocity = things[i].CFrame.lookVector * 20
		end
	end

while true do

	local choice = math.random(1,3)
	if choice == 1 then
		local fruit = game.Lighting.Money:clone()
		fruit.Parent = script.Parent
		xhalf = script.Parent.Spawner.Size.x/2
		fruit.CFrame = script.Parent.Spawner.CFrame * CFrame.new(math.random(-xhalf, xhalf), 0, 0)
		--fruit.BrickColor = BrickColor.Random()
	elseif choice &gt; 1 then
		local thing = game.Lighting.Bricky:clone()
		thing.Parent = script.Parent
		xhalf = script.Parent.Spawner.Size.x/2
		thing.Size = Vector3.new(math.random(3,12), math.random(3,12), math.random(3,12))
		thing.BrickColor = BrickColor.Random()
		thing.Reflectance = 0
		thing.CFrame = script.Parent.Spawner.CFrame * CFrame.new(math.random(-xhalf, xhalf), 0, 0)
		end
		wait(math.random(2,5) * .1)
	end
</string>
