						<string name="Source">wait(7)

p = game.Players:GetChildren()
for i=1,#p do
	if p[i].Character ~= nil then 
	if p[i].Character:findFirstChild(&quot;Playing&quot;) ~= nil then
	p[i].Character.Humanoid.WalkSpeed = 30
	end
	end
	end


while true do
b = Instance.new(&quot;Part&quot;)
b.Parent = game.Workspace
b.Position = script.Parent.Spawn.Position + Vector3.new(math.random(-script.Parent.Spawn.Size.x/2,script.Parent.Spawn.Size.x/2), 900, math.random(-script.Parent.Spawn.Size.z/2,script.Parent.Spawn.Size.z/2))
b.Name = &quot;Brick&quot;
b.BrickColor = BrickColor.new(199)
b.Size = Vector3.new(math.random(20,30),math.random(20,30),math.random(20,30))
b.Material = &quot;Slate&quot;
b.Anchored = false
b:breakJoints()
wait(math.random(3,4))
end
