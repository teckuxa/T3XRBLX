						<string name="Source">--Made by Stickmasterluke

plr=game.Players.LocalPlayer
sp=script.Parent
mode = 1

function Clicked(Mouse)
	char = script.Parent.Parent.Parent.Character
	if char ~= nil then
		int = char:findFirstChild(&quot;Playing&quot;)
		if int ~= nil then
			if mode == 1 then
				int.Value = int.Value + 1
				elseif mode == 2 and int.Value &gt; 1 then
				int.Value = int.Value - 1
				end
			end
		end 
	end

function UnClicked(Mouse)
end

function onKeyDown(key)
	if (key~=nil) then
		key = key:lower()
		if (key == &quot;q&quot;) then
			if mode == 1 then
				mode = 2

				sp.Name = &quot;Decreasing...&quot;
				--[[local m = Instance.new(&quot;Message&quot;)
				m.Name = &quot;Reminder&quot;
				m.Parent = script.Parent.Parent.Parent
				m.Text = &quot;Decreasing (Press Q to switch to increasing)&quot;

				local remover = script.Remover:clone()
				remover.Disabled = false
				remover.Parent = m]]

				elseif mode == 2 then
				mode = 1

				sp.Name = &quot;Increasing...&quot;
				--[[local m = Instance.new(&quot;Message&quot;)
				m.Name = &quot;Reminder&quot;
				m.Parent = script.Parent.Parent.Parent
				m.Text = &quot;Increasing (Press Q to switch to decreasing)&quot;

				local remover = script.Remover:clone()
				remover.Disabled = false
				remover.Parent = m]]

				end
			end
		end
	end

function Selected(Mouse) 

	char = script.Parent.Parent.Parent.Character
	player = script.Parent.Parent.Parent
	if char ~= nil then
		int = char:findFirstChild(&quot;Playing&quot;)
		if int ~= nil then
			int.Changed:connect(onChanged)
			end
		end 

	Mouse.KeyDown:connect(onKeyDown)
	Mouse.Button1Down:connect(function()Clicked(Mouse)end) 
	Mouse.Button1Up:connect(function()UnClicked(Mouse)end)
	--[[m = Instance.new(&quot;Hint&quot;)
	m.Name = &quot;CounterMsg&quot;
	m.Parent = script.Parent.Parent.Parent
	m.Text = &quot;Current Mode: Increasing (Press Q to switch to Decreasing)&quot;
	local remover = script.Remover:clone()
	remover.Disabled = false
	remover.Parent = m]]

end 

function Deselected(Mouse)
	--[[local c = player:findFirstChild(&quot;CounterMsg&quot;)
	if c ~= nil then
		c:remove()
		end]]
	end

function onChanged()
	char = script.Parent.Parent.Parent.Character
	if char ~= nil then
		int = char:findFirstChild(&quot;Playing&quot;)
		if int ~= nil then
			script.Parent.Name = int.Value .. &quot; figures!&quot;
			end
		end 
	end

sp.Selected:connect(Selected)
sp.Deselected:connect(Deselected) 
