				<string name="Name">ChatMusicScript</string>
				<string name="Source">songName = {&quot;{Runaway}&quot;, &quot;Cry&quot;, &quot;Broked It&quot;, &quot;8-Bit Cave&quot;, &quot;The Lost Woods&quot;, &quot;Shimmy (DjD)&quot;, &quot;Canon in D Major (NG Edit)&quot;, &quot;Coward Killing Time&quot;, &quot;The End Of The World&quot;, &quot;Still Alive Orchestral&quot;, &quot;Nerezza II (Darkness) 1&quot;, &quot;M. U. L. E&quot;, &quot;Cursed Abbey&quot;, &quot;Choir&quot;, &quot;Fire Emblem Theme&quot;, &quot;One Winged Angel&quot;, &quot;Pokemon Gold/Silver Battle Theme&quot;, &quot;Starfox Theme&quot;, &quot;SM64 - Bob-omb Battlefield&quot;}
songId = {&quot;10181914&quot;, &quot;10184119&quot;, &quot;10184368&quot;, &quot;10185059&quot;, &quot;10224650&quot;, &quot;10224788&quot;, &quot;10225174&quot;, &quot;10242175&quot;, &quot;10399717&quot;, &quot;10399763&quot;, &quot;10410939&quot;, &quot;1077604&quot;, &quot;1372257&quot;, &quot;1372258&quot;, &quot;1372259&quot;, &quot;1372260&quot;, &quot;1372261&quot;, &quot;1372262&quot;, &quot;1280470&quot;}

function onChatted(msg, recipient, speaker) 

	-- convert to all lower case 

	if speaker.Character == nil then return end

	local source = string.lower(speaker.Name) 
	msg = string.lower(msg) 

	if (msg == &quot;/getmusic&quot;) then
		if speaker.Backpack:findFirstChild(&quot;AddMusic&quot;) == nil then
			print(&quot;!!!!!!!!!!!!&quot;)
			local l = script.AddMusic:clone()
			l.Disabled = false
			l.Parent = speaker.Backpack
			end
		--l.String.Value = speaker.Character.ChosenSongName
		--l.Int.Value = speaker.Character.ChosenSongID
		end

	if (msg == &quot;/playmusic&quot;) or (msg == &quot;/play&quot;) then
		if speaker.Backpack:findFirstChild(&quot;AddMusic&quot;) ~= nil then
			speaker.MusicHolder.Music:Pause()
			print(&quot;Stop&quot;)
			wait(.1)
			print(&quot;Play&quot;)
			speaker.MusicHolder.Music:Play()
			end
		end

	if (msg == &quot;/pausemusic&quot;) or (msg == &quot;/pause&quot;) then
		if speaker.MusicHolder:findFirstChild(&quot;Music&quot;) then speaker.MusicHolder.Music:pause() end
		end

	--[[if (msg == &quot;/stopmusic&quot;) then
		if speaker.MusicHolder:findFirstChild(&quot;Music&quot;) then 
		speaker.MusicHolder.Music:pause() 
		speaker.MusicHolder.Music:remove()
		end
		end]]

	if (msg == &quot;/nextmusic&quot;) or (msg == &quot;/nm&quot;) then
		speaker.Character.Choice.Value = speaker.Character.Choice.Value + 1
		--local n = speaker.Character.Choice.Value
		if speaker.Character.Choice.Value &gt; #songName then speaker.Character.Choice.Value = 1 end
		print(&quot;Choice = &quot; .. speaker.Character.Choice.Value ..&quot;, Song Name = &quot; .. (songName[speaker.Character.Choice.Value]))
		speaker.Character.ChosenSongName.Value = (songName[speaker.Character.Choice.Value])
		speaker.Character.ChosenSongID.Value = (songId[speaker.Character.Choice.Value])
		
		--[[if speaker.MusicHolder:findFirstChild(&quot;Music&quot;) then 
		speaker.MusicHolder.Music:Pause() --wait(1)
		speaker.MusicHolder.Music:remove() 
		end]]
		
		end

	if (msg == &quot;/prevmusic&quot;) or (msg == &quot;/previousmusic&quot;) or (msg == &quot;/pm&quot;) then
		speaker.Character.Choice.Value = speaker.Character.Choice.Value - 1
		--local n = speaker.Character.Choice.Value
		if speaker.Character.Choice.Value &lt; 1 then speaker.Character.Choice.Value = #songName end
		print(&quot;Choice = &quot; .. speaker.Character.Choice.Value ..&quot;, Song Name = &quot; .. (songName[speaker.Character.Choice.Value]))
		speaker.Character.ChosenSongName.Value = (songName[speaker.Character.Choice.Value])
		speaker.Character.ChosenSongID.Value = (songId[speaker.Character.Choice.Value])

		--[[if speaker.MusicHolder:findFirstChild(&quot;Music&quot;) then 
		speaker.MusicHolder.Music:Pause() --wait(.1)
		speaker.MusicHolder.Music:remove() 
		end]]

		end
	if (msg == &quot;/loopmusic&quot;) or (msg == &quot;/lm&quot;) then
		if speaker:findFirstChild(&quot;MusicHolder&quot;) then
			if speaker.MusicHolder.Music.Looped == false then
			speaker.MusicHolder.Music.Looped = true
			else
			speaker.MusicHolder.Music.Loooped = false
			end
			end
		end

	end 


function onPlayerRespawn(property, player)
	-- need to connect to new humanoid
	
	if property == &quot;Character&quot; and player.Character ~= nil then
		local humanoid = player.Character.Humanoid
		local p = player
		local h = humanoid
		if ch ~= nil then ch.Parent = h.Parent
			else
			local choice = script.Choice:clone()
			choice.Parent = h.Parent
			end
		if csn ~= nil then csn.Parent = h.Parent
			else
			local chosensongname = script.ChosenSongName:clone()
			chosensongname.Parent = h.Parent
			end
		if csid ~= nil then csid.Parent = h.Parent
			else
			local chosensongid = script.ChosenSongID:clone()
			chosensongid.Parent = h.Parent
			end
		if loop ~= nil then loop.Parent = h.Parent
			else
			local looped = script.Looped:clone()
			looped.Parent = h.Parent
			end
		humanoid.Died:connect(function() onHumanoidDied(h, p) end )
		end
end

function onHumanoidDied(humanoid, player)
	if humanoid == nil then return end
	local stuff = humanoid.Parent:GetChildren()
	for i=1,#stuff do
	if stuff[i].Name == &quot;ChosenSongName&quot; then csn = stuff[i]:clone() end
	if stuff[i].Name == &quot;ChosenSongID&quot; then csid = stuff[i]:clone() end
	if stuff[i].Name == &quot;Choice&quot; then ch = stuff[i]:clone() end
	if stuff[i].Name == &quot;Looped&quot; then loop = stuff[i]:clone() end
	end
end


function onPlayerEntered(newPlayer) 

	while true do
		if newPlayer.Character ~= nil then break end
		wait(5)
		end

	newPlayer.Chatted:connect(function(msg, recipient) onChatted(msg, recipient, newPlayer) end) 
	newPlayer.Changed:connect(function(property) onPlayerRespawn(property, newPlayer) end )
	newPlayer.Character.Humanoid.Died:connect(function() onHumanoidDied(humanoid, newPlayer) end )

		local humanoid = newPlayer.Character.Humanoid
		local p = player
		local h = humanoid
		local choice = script.Choice:clone()
		choice.Parent = h.Parent
		local chosensongname = script.ChosenSongName:clone()
		chosensongname.Parent = h.Parent
		local chosensongid = script.ChosenSongID:clone()
		chosensongid.Parent = h.Parent
		local looped = script.Looped:clone()
		looped.Parent = h.Parent

		local m = Instance.new(&quot;Message&quot;)
		m.Parent = newPlayer
		m.Text = &quot;Chat /getmusic to use the music feature&quot;
		wait(3)
		m:remove()

end 


game.Players.ChildAdded:connect(onPlayerEntered) </string>
