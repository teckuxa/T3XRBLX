						<string name="Source">a = script.Parent.Ambience
a1 = script.Parent.Ambience1
a2 = script.Parent.Ambience2
a3 = script.Parent.Ambience3

stuff1 = script.Parent.Set1:GetChildren()
stuff2 = script.Parent.Set2:GetChildren()
stuff3 = script.Parent.Set3:GetChildren()
stuff4 = script.Parent.Set4:GetChildren()

function onFinishTouch(part)
	h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if h ~= nil and h.Parent:findFirstChild(&quot;Stun&quot;) == nil then
		script.Parent.Winner.Value = h.Parent.Name -- We have found a winner :D
		end
	end

script.Parent.Finish.Touched:connect(onFinishTouch)

function makeintoKeys(stuff)
	for i=1,#stuff do
		--[[k = stuff[i]
		k.Name = &quot;Key&quot;
		k.Parent = stuff[i].Parent]]
		--stuff[i]:remove()
		s = script.KeyScript:clone()
		s.Disabled = false
		s.Parent = stuff[i]
		--return k
		end
	end

makeintoKeys(stuff1)
makeintoKeys(stuff2)
makeintoKeys(stuff3)
makeintoKeys(stuff4)
k1 = script.Parent.Set1:GetChildren()
k2 = script.Parent.Set2:GetChildren()
k3 = script.Parent.Set3:GetChildren()
k4 = script.Parent.Set4:GetChildren()

wait(7)

g = game.Players:GetChildren()
for i=1,#g do
	if g[i].Character ~= nil then 
	if g[i].Character:findFirstChild(&quot;Playing&quot;) ~= nil then
		print(&quot;Go&quot;)
		game.Lighting.Tools.Punch:clone().Parent = g[i].Backpack
		end
		end
	end


function addSet(stuff, place)
	for i=1,#stuff do
		if stuff[i].Name == &quot;Key&quot; then
		stuff[i].Anchored = false
		--stuff[i].Position = Vector3.new(place.Position.x + math.random(-place.Size.x/4, place.Size.x/4), place.Position.y + 5, place.Position.z + math.random(-place.Size.z/4, place.Size.z/4))
		end
		end
	end

	timer = 45
	game.Lighting.Ambient = a.Value
	addSet(k1, script.Parent.Spawn)
	game.Lighting.Brightness = 0
	while timer &gt; 0 do
		timer = timer - 1
		wait(1)
		if timer == 50 then
		game.Lighting.Ambient = a1.Value
		end
		if timer == 30 then
		game.Lighting.Ambient = a2.Value
		end
		if timer == 20 then
		game.Lighting.Ambient = a3.Value
		end

		local count = 0
		local things = script.Parent.Group1:GetChildren()
		for i=1,#things do
			if things[i].BrickColor == BrickColor.new(26) then
				count = count + 1
				end
			end
		if count == #things then break end

		end

	msg = Instance.new(&quot;Message&quot;)
	msg.Parent = game.Workspace
	msg.Text = &quot;The next area has opened... Only 5 can move on.&quot;
	script.Parent.Barrier1:remove()
	script.Parent.Trapdoor1:remove()
	wait(3)
	msg:remove()

	timer = 45
	game.Lighting.Ambient = a.Value
	addSet(k2, script.Parent.KeySpawn2)
	while timer &gt; 0 do
		timer = timer - 1
		wait(1)
		if timer == 50 then
		game.Lighting.Ambient = a1.Value
		end
		if timer == 30 then
		game.Lighting.Ambient = a2.Value
		end
		if timer == 20 then
		game.Lighting.Ambient = a3.Value
		end

		local count = 0
		local things = script.Parent.Group2:GetChildren()
		for i=1,#things do
			if things[i].BrickColor == BrickColor.new(26) then
				count = count + 1
				end
			end
		if count == #things then break end

		end


	msg = Instance.new(&quot;Message&quot;)
	msg.Parent = game.Workspace
	msg.Text = &quot;The next area has opened... Only 2 can move on.&quot;
	script.Parent.Barrier2:remove()
	script.Parent.Trapdoor2:remove()
	script.Parent:findFirstChild(&quot;Trapdoor?&quot;):remove()
	wait(3)
	msg:remove()

	timer = 30
	game.Lighting.Ambient = a.Value
	addSet(k3, script.Parent.KeySpawn3)
	while timer &gt; 0 do
		timer = timer - 1
		wait(1)
		if timer == 20 then
		game.Lighting.Ambient = a1.Value
		end
		if timer == 10 then
		game.Lighting.Ambient = a2.Value
		end
		if timer == 5 then
		game.Lighting.Ambient = a3.Value
		end

		local count = 0
		local things = script.Parent.Group3:GetChildren()
		for i=1,#things do
			if things[i].BrickColor == BrickColor.new(26) then
				count = count + 1
				end
			end
		if count == #things then break end

		end

	msg = Instance.new(&quot;Message&quot;)
	msg.Parent = game.Workspace
	msg.Text = &quot;The next area has opened... Only 1 can win.&quot;
	script.Parent.Barrier3:remove()
	script.Parent.Trapdoor3:remove()
	wait(3)
	msg:remove()

	timer = 30
	game.Lighting.Ambient = a.Value
	addSet(k4, script.Parent.KeySpawn4)
	while timer &gt; 0 do
		timer = timer - 1
		wait(1)
		if timer == 20 then
		game.Lighting.Ambient = a1.Value
		end
		if timer == 10 then
		game.Lighting.Ambient = a2.Value
		end
		if timer == 5 then
		game.Lighting.Ambient = a3.Value
		end
		end

	script.Parent.Trapdoor4:remove()
</string>
						<bool name="archivable">true</bool>
					</Properties>
					<Item class="Script" referent="RBX9302">
						<Properties>
							<bool name="Disabled">true</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">KeyScript</string>
							<string name="Source">taken = Instance.new(&quot;BoolValue&quot;)
taken.Parent = script.Parent
taken.Value = false
taken.Name = &quot;Attached&quot;

function onTouch(part)
	if part.Parent ~= nil then
	h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if h ~= nil and taken.Value == false and h.Parent:findFirstChild(&quot;Key&quot;) == nil then
		script.Parent.Parent = h.Parent
		taken.Value = true
		--[[bp = Instance.new(&quot;BodyPosition&quot;)
		bp.Parent = script.Parent
		bp.maxForce = Vector3.new(10000000,10000000,10000000)]]
		while taken.Value == true do
			--bp.position = script.Parent.Parent.Head.Position + Vector3.new(0,1,0)
			script.Parent.CFrame = script.Parent.Parent.Torso.CFrame * CFrame.new(0,0,-5)
			wait()
			end
		end
	if taken.Value == true and part.Name == &quot;KeyHole&quot; and part.BrickColor == script.Parent.BrickColor then
		script.Parent.Parent.Torso.CFrame = (part.CFrame * CFrame.new(0,0,6))
		part.BrickColor = BrickColor.new(26)
		game.Workspace.Trumpets:play()
		m = Instance.new(&quot;Hint&quot;)
		m.Text = script.Parent.Parent.Name .. &quot; has advanced!&quot;
		m.Parent = game.Workspace
		script.Parent:remove()
		wait(2)
		m:remove()
		end
	if taken.Value == true and part.Name == &quot;KeyHole&quot; and part.BrickColor ~= script.Parent.BrickColor then
		script.Parent.CFrame = script.Parent.Parent.Torso.CFrame * CFrame.new(0,0,10)
		script.Parent.Parent = game.Workspace
		taken.Value = false
		end
		end
	end

script.Parent.Touched:connect(onTouch)
			
