						<string name="Name">GameScript</string>
						<string name="Source">SlashSound = game.Workspace.Slash

e = {}
stuff = script.Parent:GetChildren()
for i=1,#stuff do
	if stuff[i].Name == &quot;Electricity&quot; then
		table.insert(e, stuff[i])
		stuff[i].Transparency = .3
		stuff[i].Size = stuff[i].Size + Vector3.new(0,6,0)
		stuff[i].Touched:connect(onTouch)
		end
	end

function onTouch(part)
	h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if h ~= nil and h.Parent:findFirstChild(&quot;Stun&quot;) == nil then
		local lol = script.Stun:clone()
		lol.Disabled = false
		lol.Parent = h.Parent
		end
	end

function onFinishTouch(part)
	h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if h ~= nil and h.Parent:findFirstChild(&quot;Stun&quot;) == nil then
		script.Parent.Winner.Value = h.Parent.Name -- We have found a winner :D
		end
	end

script.Parent.Finish.Touched:connect(onFinishTouch)
wait(7)

p = game.Players:GetChildren()
for i=1,#p do
	if p[i].Character ~= nil then
	if p[i].Character:findFirstChild(&quot;Playing&quot;) ~= nil then
	p[i].Character.Humanoid.WalkSpeed = 25
	end
	end
	end

m = Instance.new(&quot;Model&quot;)
		m.Name = &quot;Electric1&quot;
		m.Parent = script.Parent
m2 = Instance.new(&quot;Model&quot;)
		m2.Name = &quot;Electric2&quot;
		m2.Parent = script.Parent

for i=1,#e do
	local s = math.random(1,2)
	if s &gt; 1 then
		e[i].Parent = m
		else
		e[i].Parent = m2
		end
	end

stuff = script.Parent:GetChildren()
for i=1,#stuff do
	if stuff[i].Name == &quot;Electric1&quot; then
		s1 = stuff[i]:clone()
		stuff[i]:remove()
		end
	end

stuff2 = script.Parent:GetChildren()
for i=1,#stuff2 do
	if stuff2[i].Name == &quot;Electric2&quot; then
		s2 = stuff2[i]:clone()
		end
	end

while true do
	wait(math.random(3,4)/2)

	print(&quot;1!&quot;)

	s  = s1:clone()
	s.Parent = script.Parent
	ee = s:GetChildren()
	for i=1,#ee do
		ee[i].Touched:connect(onTouch)
		end
	o = script.Parent:GetChildren()
	for i=1,#o do
		if o[i].Name == &quot;Electric2&quot; then
			o[i]:remove()
			end
		end

	wait(math.random(4,6)/2)

	print(&quot;2!&quot;)

	s  = s2:clone()
	s.Parent = script.Parent
	ee = s:GetChildren()
	for i=1,#ee do
		ee[i].Touched:connect(onTouch)
		end
	oo = script.Parent:GetChildren()
	for i=1,#oo do
		if oo[i].Name == &quot;Electric1&quot; then
			oo[i]:remove()
			end
		end
	
	end

	</string>
