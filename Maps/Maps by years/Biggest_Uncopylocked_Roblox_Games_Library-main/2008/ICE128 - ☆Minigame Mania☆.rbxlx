print(&quot;!&quot;)
function onTouch(part)
	h = part.Parent:findFirstChild(&quot;Humanoid&quot;) 
	if h ~= nil then
		h.Health = h.Health - 30
		end
	end

script.Parent.LongHand.Touched:connect(onTouch)
n = 3
script.Parent.Top.Anchored = false
script.Parent.Bottom.Anchored = true

while true do
	top.angularvelocity = Vector3.new(0,math.random(-9,-8)*n,0)
	wait(math.random(15,20))
	top.angularvelocity = Vector3.new(0,math.random(8,9)*n,0)
	bottom.angularvelocity = Vector3.new(0,math.random(1,5)*.01,0)
	wait(math.random(10,20))
	bottom.angularvelocity = Vector3.new(0,math.random(1,5)*.01,0)
	top.angularvelocity = Vector3.new(0,-4*n,0)
	wait(math.random(10,20))
	top.angularvelocity = Vector3.new(0,math.random(6,7)*n,0)
	bottom.angularvelocity = Vector3.new(0,math.random(-5,-1)*.01,0)
	wait(math.random(10,20))
	top.angularvelocity = Vector3.new(0,math.random(-11,-10)*n,0)
	bottom.angularvelocity = Vector3.new(0,math.random(1,5)*.01,0)
	wait(math.random(10,20))
	bottom.angularvelocity = Vector3.new(0,0,0)
	n = n + 1.5
	top.maxTorque = top.maxTorque * top.maxTorque
	end
