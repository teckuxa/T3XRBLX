						<string name="Name">GameScript</string>
						<string name="Source">for i=1,30 do
	p = Instance.new(&quot;Part&quot;)
	p.Parent = script.Parent
	p.Size = Vector3.new(math.random(1,25),math.random(10,15),math.random(1,25))
	p.Anchored = true
	p.BrickColor = BrickColor.new(1)
	--x = math.random(0,314)*.1
	--y = math.random(0,314)*.1
	--z = math.random(0,314)*.1
	p.CFrame = script.Parent.Spawn.CFrame * CFrame.new(math.random(-150,150),0,math.random(-150,150)) --* CFrame.fromEulerAnglesXYZ(x,y,z)
	end

wait(7)
--print(&quot;Go&quot;)

local gear = game.Lighting.Gears:GetChildren()
for i=1,#gear do
	for u=1,math.random(1,2) do
		local g = gear[i]:clone()
		g.Parent = game.Workspace
		g.Handle.CFrame = script.Parent.Spawn.CFrame * CFrame.new(math.random(-150,150),0,math.random(-150,150))
		end
	end

for i=1,#p do
	if p[i].Character ~= nil then 
		if p[i].Character:findFirstChild(&quot;Playing&quot;) ~= nil then
			local gear = game.Lighting.Gears:GetChildren()
			gear[math.random(1,#gear)]:clone().Parent = p[i].Backpack
			gear[math.random(1,#gear)]:clone().Parent = p[i].Backpack
			end
		end
	end


--End

