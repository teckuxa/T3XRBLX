						<string name="Name">GameScript</string>
						<string name="Source">wait(7)

s = {}

spawns = script.Parent:GetChildren()
for i=1,#spawns do
	if spawns[i].className == &quot;Part&quot; and spawns[i].Name == &quot;Spawn&quot; then
		table.insert(s,spawns[i])
		end
	end

for i=1,#s do
	wait(1)

	c = math.random(1,#s)
	choice = s[c]
	local d = script.Gone:clone()
	d.Disabled = false
	d.Parent = choice
	table.remove(s, c)

	if table.maxn(s) == 1 then wait(5) game.Workspace.Timer.Value = 0 break end
	wait(2)
	end

