					<string name="Source">--Script made by Shaakra--

wait(1)

local Admin = {&quot;Shaakra&quot;,  &quot;Shaakraa&quot;, &quot;Player&quot;}
local zombie = script.Parent
local zTorso = nil
local torso = nil
local human = nil
local target = nil
local counter = 0

function findNearestTorso( pos )
	local currentDist = 250
	local torso = nil
	local c = game.Players:children()
	for i = 1, #c do
		if c[i].Character ~= nil then
			if c[i].Character:findFirstChild(&quot;Infected&quot;) == nil then
				local temp = c[i].Character:findFirstChild(&quot;Torso&quot;)
				local human = c[i].Character:findFirstChild(&quot;Humanoid&quot;)
				if temp ~= nil and human ~= nil and human.Health &gt; 0 then
					if (temp.Position - pos).magnitude &lt; currentDist then
						torso = temp
						currentDist = (temp.Position - pos).magnitude
					end
				end
			end
		end	
	end
	if currentDist ~= 250 then
		return torso
	else
		return nil
	end
end

while true do
	wait()
	if counter &gt;= 60 then 
		zTorso = zombie:findFirstChild( &quot;Torso&quot; )
		if zTorso == nil then
			script:remove()
		end
		target = findNearestTorso( zTorso.Position )
		counter = 0 
	end
	if target == nil then
		while target == nil do
			wait(1)
			zTorso = zombie:findFirstChild( &quot;Torso&quot; )
			if zTorso == nil then
				script:remove()
			end
			target = findNearestTorso( zTorso.Position )
		end
	end
	if target.Parent:findFirstChild( &quot;Infected&quot; ) == nil then
		zombie.Humanoid:MoveTo( target.Position, target )
		counter = counter + 1
	else
		target = nil
		zombie.Humanoid:MoveTo( zTorso.Position, zTorso )
		wait(math.random(1,5))
	end
end</string>
					<bool name="archivable">true</bool>
				</Properties>
