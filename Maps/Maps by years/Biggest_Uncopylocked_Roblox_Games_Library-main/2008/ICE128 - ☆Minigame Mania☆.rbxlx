							<string name="Name">RandomDestinations</string>
							<string name="Source">--[[function onTeleport(part, destination)
	print(destination.Name)
	if part.Parent ~= nil then
		h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
		if h ~= nil and part.Parent:findFirstChild(&quot;Torso&quot;) then
			h.Parent:moveTo(destination.Position + Vector3.new(0,5,0))
			h.Parent.Torso.Velocity = Vector3.new(0,50,0)
			end
		end
	end]]

function randomizeTeles(model)
	teles = {}
	local things = model:GetChildren()
	for i=1,#things do
		--if things[i].Name == &quot;Tele&quot; then
			table.insert(teles, things[i])
			--end
		end
	for i=1,#teles do
		print(table.maxn(teles))
		if table.maxn(teles) &lt; 1 then
			print(&quot;none left&quot;)
			break 
			end
		local m = math.random(1,#teles)
		if teles[m] ~= nil then
			mm = table.remove(teles, m)
			local n = math.random(1,#teles)
			if teles[n] ~= nil then
				nn = table.remove(teles, n)
				--print(tostring(m) .. &quot;, &quot; .. tostring(n) .. &quot; :: &quot; .. mm.Name .. &quot;, &quot; .. nn.Name)

				nn.CFrame = nn.CFrame * CFrame.new(0,-4,0)
				nn.Transparency = 1
				mm.CFrame = mm.CFrame * CFrame.new(0,-4,0)
				mm.Transparency = 1
				ov1 = Instance.new(&quot;ObjectValue&quot;)
				ov1.Parent = mm
				ov1.Value = nn
				ov1.Name = &quot;Location&quot;
				ov2 = Instance.new(&quot;ObjectValue&quot;)
				ov2.Parent = nn
				ov2.Value = mm
				ov2.Name = &quot;Location&quot;
				
				touch = script.Touch:clone()
				touch.Disabled = false
				touch.Parent = mm

				touch = script.Touch:clone()
				touch.Disabled = false
				touch.Parent = nn

				end
			end
		end
	--teles:remove()
	--print(&quot;*******SWITCH*********&quot;)
	end

models = script.Parent:GetChildren()
for i=1,#models do
	if models[i].className == &quot;Model&quot; then
		randomizeTeles(models[i])
		end
	end
		</string>
							<bool name="archivable">true</bool>
						</Properties>
						<Item class="Script" referent="RBX5392">
							<Properties>
								<bool name="Disabled">true</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Touch</string>
								<string name="Source">function onTeleport(part)
	destination = script.Parent.Location.Value
	print(destination.Name)
	if part.Parent ~= nil then
		h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
		if h ~= nil and part.Parent:findFirstChild(&quot;Torso&quot;) then
			h.Parent:moveTo(destination.Position + Vector3.new(math.random(-2,2),7,math.random(-2,2)))
			h.Parent.Torso.Velocity = Vector3.new(0,50,0)
			end
		end
	end

script.Parent.Touched:connect(onTeleport)</string>
