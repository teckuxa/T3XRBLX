				<Item class="Script" referent="RBX9386">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">GameScript</string>
						<string name="Source">wait(7)

g = game.Players:GetChildren()
for i=1,#g do
	if g[i].Character == nil then return end
	if g[i].Character:findFirstChild(&quot;Playing&quot;) ~= nil then
		pb = script.Parent.PlayerBox:clone()
		pb.Parent = script.Parent
		pb:moveTo(pb.Spawner.Position + Vector3.new(50*i, 0, 0))
		pb.Name = g[i].Name .. &quot;&apos;s Box&quot;
		pb.ObjectValue.Value = g[i]
		g[i].Character:moveTo(pb.Spawner.Position)
		if g[i].Character:findFirstChild(&quot;Humanoid&quot;) then
			g[i].Character.Humanoid.WalkSpeed = 0
			end
		end
	end

script.Parent.PlayerBox:remove()

wait(60)

local things = script.Parent:GetChildren()
for i=1,#things do
	local spawner = things[i]:findFirstChild(&quot;Spawner&quot;, true)
	if spawner ~= nil then
		local model = spawner.Parent
		model.Box:remove()
		end
	end

local m = Instance.new(&quot;Message&quot;)
m.Parent = game.Workspace
m.Text = &quot;Time&apos;s up!&quot;
wait(2)
m:remove()

max = 0

function checkAnswers(box, player)
	local p = 0
	p = box.NumberCorrect.Value
		if p &gt; max then max = p end
		local m = Instance.new(&quot;Message&quot;)
		m.Parent = player
		m.Text = &quot;You have gotten &quot; .. p ..&quot; boxes right!&quot;
		m.Name = &quot;Msg&quot;
		box.NumberCorrect.Value = p
	end

g = game.Players:GetChildren()
for i=1,#g do
	if g[i].Character == nil then return end
	if g[i].Character:findFirstChild(&quot;Playing&quot;) ~= nil then
		local thing = script.Parent:findFirstChild(g[i].Name .. &quot;&apos;s Box&quot;)
		if thing ~= nil then
			checkAnswers(thing, g[i])
			end
		end
	end

wait(3)

g = game.Players:GetChildren()
for i=1,#g do
	if g[i].Character == nil then return end
	if g[i].Character:findFirstChild(&quot;Playing&quot;) ~= nil then
		if g[i]:findFirstChild(&quot;Msg&quot;) ~= nil then g[i].Msg:remove() end
		local thing = script.Parent:findFirstChild(g[i].Name .. &quot;&apos;s Box&quot;)
		if thing ~= nil then
			if thing.NumberCorrect.Value &gt;= max then
				g[i].Character:moveTo(script.Parent.Spawn.Position)
				end
			thing:remove()
			end
		end
	end

wait(4)

game.Workspace.Timer.Value = 0



</string>
						<bool name="archivable">true</bool>
					</Properties>
