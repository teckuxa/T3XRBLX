						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">GameScript</string>
						<string name="Source">wait(7)
n = 5

g = game.Players:GetChildren()
for i=1,#g do
	if g[i].Character ~= nil then 
	if g[i].Character:findFirstChild(&quot;Playing&quot;) ~= nil then
		print(&quot;Go&quot;)
		game.Lighting.Tools.Punch:clone().Parent = g[i].Backpack
		end
		end
	end


stuff = script.Parent:GetChildren()
for i=1,#stuff do
	if stuff[i].Name == &quot;Treadmill1&quot; then
		stuff[i].Velocity = stuff[i].CFrame.lookVector * n
		end
	if stuff[i].Name == &quot;Treadmill2&quot; then
		stuff[i].Velocity = stuff[i].CFrame.lookVector * -n
		end
	end

timer = 120
while true do
	wait(1)
	timer = timer-1
	n = n + .5
	local stuff = script.Parent:GetChildren()
	for i=1,#stuff do
		if stuff[i].Name == &quot;Treadmill1&quot; then
			stuff[i].Velocity = stuff[i].CFrame.lookVector * n
			end
		if stuff[i].Name == &quot;Treadmill2&quot; then
			stuff[i].Velocity = stuff[i].CFrame.lookVector * -n
			end
		end
	if timer % 2 == 0 then--mod ftw
		--print(&quot;ZOMG&quot;)
		local stuff = script.Parent:GetChildren()
		for i=1,#stuff do
			if stuff[i].Name == &quot;Treadmill1&quot; then
				local cframe = stuff[i].CFrame
				stuff[i].Size = stuff[i].Size - Vector3.new(0,0,2)
				stuff[i].CFrame = cframe
				end
			if stuff[i].Name == &quot;Treadmill2&quot; then
				local cframe = stuff[i].CFrame
				stuff[i].Size = stuff[i].Size - Vector3.new(0,0,2)
				stuff[i].CFrame = cframe
				end
			end
		end
	end
