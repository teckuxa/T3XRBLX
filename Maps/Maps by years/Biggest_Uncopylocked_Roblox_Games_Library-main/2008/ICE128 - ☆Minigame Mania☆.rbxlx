						<string name="Source">plr=game.Players.LocalPlayer
sp=script.Parent
m = 1

function Clicked(Mouse)
end 

function UnClicked(Mouse)
end

function onKeyDown(key) 
	if (key~=nil) then 
		local key = key:lower() 
		if (key==&quot;q&quot;) then 
			local things = game.Players:GetChildren()
			if things[m] == nil then
				m = 1
			elseif things[m].Character ~= nil then
				if things[m].Character:findFirstChild(&quot;Head&quot;) then
					originalcam.CameraSubject = things[m].Character.Head
					originalcam.CameraType = 4
					m = m + 1
					end
				end
			end
		end
	end

function Selected(Mouse) 
	Mouse.KeyDown:connect(onKeyDown)
	Mouse.Button1Down:connect(function()Clicked(Mouse)end) 
	Mouse.Button1Up:connect(function()UnClicked(Mouse)end)
	originalcam = game.Workspace.CurrentCamera
	o = originalcam.CameraSubject
	yay = originalcam.CameraType
	local h = Instance.new(&quot;Hint&quot;)
	h.Parent = plr
	h.Name = &quot;CamNotice&quot;
	h.Text = &quot;Press Q to watch different players, deselect to exit.&quot;
end 

function Deselected(Mouse)
	if plr:findFirstChild(&quot;CamNotice&quot;) ~= nil then plr.CamNotice:remove() end
	if h then h:remove() end
	originalcam.CameraSubject = o
	originalcam.CameraType = yay
end

sp.Selected:connect(Selected)
sp.Deselected:connect(Deselected) </string>
