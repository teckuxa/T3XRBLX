				<string name="Source">if script.Parent:findFirstChild(&quot;Humanoid&quot;) == nil then
script:remove()
end

original = script.Parent.Humanoid.WalkSpeed
local things = script.Parent:GetChildren()
for i=1,#things do
	if things[i].className == &quot;Part&quot; then
		things[i].Reflectance = 1
		end
	end

script.Parent.Humanoid.WalkSpeed = 8
wait(2)
local things = script.Parent:GetChildren()
for i=1,#things do
	if things[i].className == &quot;Part&quot; then
		things[i].Reflectance = 0
		end
	end
script.Parent.Humanoid.WalkSpeed = original

