local x = math.random(2,10)
wait(x)

g = game.Players:GetChildren()
for i=1,#g do
	if g[i].Character ~= nil then 
	if g[i].Character:findFirstChild(&quot;Playing&quot;) ~= nil then
		print(&quot;Go&quot;)
		game.Lighting.Balefire:clone().Parent = g[i].Backpack
		end
		end
	end

m.Text = &quot;Draw!&quot;
wait(.3)
m:remove()
