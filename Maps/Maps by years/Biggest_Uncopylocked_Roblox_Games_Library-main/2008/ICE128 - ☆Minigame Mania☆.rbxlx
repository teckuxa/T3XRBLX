						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">GameScript</string>
						<string name="Source">wait(7)

p = game.Players:GetChildren()
for i=1,#p do
	if p[i].Character ~= nil then 
	if p[i].Character:findFirstChild(&quot;Playing&quot;) ~= nil then
	p[i].Character.Humanoid.WalkSpeed = 24
	end
	end
	end

while true do
	boulder = game.Lighting.Snowball:clone()
	boulder.Parent = script.Parent
	boulder.Position = script.Parent.BoulderSpawn.Position
	boulder.Velocity = Vector3.new(math.random(-100,100),math.random(0,40),math.random(-100,100))
	wait(.8)
	end
</string>
