						<string name="Source">starter = script.Parent[&quot;Press this to play Mini Plinko (5 coins).&quot;].Head
basket = script.Parent[&quot;Prize = 20 coins if landed here.&quot;].Head
lava = script.Parent.Lava
b = script.Parent.Ball:clone()
debounce = false

function onStart(part)
	if part.Parent ~= nil then
		local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
		if h ~= nil then
			local player = game.Players:findFirstChild(h.Parent.Name)
			if player then
				if player.leaderstats.Coins.Value &gt;= 5 and debounce == false then

					player.leaderstats.Coins.Value = player.leaderstats.Coins.Value - 5
					debounce = true

					local ball = b:clone()
					ball.Parent = script.Parent
					ball.Anchored = false
					ball.CFrame = CFrame.new(script.Parent.SpawnBasket.BallSpawn.Position - Vector3.new(0,4,0))
					ball.Velocity = Vector3.new(0,0,math.random(-10,10))
					ball.BrickColor = BrickColor.Random()

					local obj = Instance.new(&quot;ObjectValue&quot;)
					obj.Value = player
					obj.Name = &quot;Guy&quot;
					obj.Parent = ball

					starter.BrickColor = BrickColor.new(1)
					wait(1)
					starter.BrickColor = BrickColor.new(26)
					debounce = false
					end
				end
			end
		end
	end

function onGold(part)
	if part.Parent and part.Name == &quot;Ball&quot; then
		local guy = part:findFirstChild(&quot;Guy&quot;)
		if guy then
			value = guy.Value
			if value then
				value.leaderstats.Coins.Value = value.leaderstats.Coins.Value + 20
				end
			end
		part:remove()
		end
	end

function onLava(part)
	if part.Parent and part.Name == &quot;Ball&quot; then
		part:remove()
		end
	end

starter.Touched:connect(onStart)
basket.Touched:connect(onGold)
lava.Touched:connect(onLava)</string>
						<bool name="archivable">true</bool>
