						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">GameScript</string>
						<string name="Source">g = script.Parent:GetChildren()
for i=1,#g do
	if g[i].Name == &quot;Part&quot; then
		s = script.Crumble:clone()
		s.Disabled = false
		s.Parent = g[i]
		end
	end

wait(7)
g = game.Players:GetChildren()
for i=1,#g do
	if g[i].Character ~= nil then 
	if g[i].Character:findFirstChild(&quot;Playing&quot;) ~= nil then
		print(&quot;Go&quot;)
		game.Lighting.Tools.LinkedSword:clone().Parent = g[i].Backpack
		end
		end
	end

while true do
	fish = game.Lighting.Fish:clone()
	fish.Parent = game.Workspace
	fish.Position = script.Parent.FishSpawn.Position + Vector3.new(math.random(-script.Parent.FishSpawn.Size.x/2,script.Parent.FishSpawn.Size.x/2), 0, math.random(-script.Parent.FishSpawn.Size.z/2, script.Parent.FishSpawn.Size.z/2))
	fish.Velocity = fish.CFrame.lookVector * math.random(-30,30)
	wait(2)
	end
</string>
						<bool name="archivable">true</bool>
					</Properties>
					<Item class="Script" referent="RBX4484">
						<Properties>
							<bool name="Disabled">true</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Crumble</string>
							<string name="Source">debounce = false
clone = script.Parent:clone()

function onTouch(part)
	if part.Name == &quot;Fish&quot; and debounce == false then
		debounce = true
		script.Parent.Anchored = false
		script.Parent.CanCollide = false
		wait(3)
		script.Parent.Anchored = true
		script.Parent.Transparency = 1
		wait(2)
		s = clone:clone()
		s.Parent = script.Parent.Parent
		script.Parent:remove()
		end
	end

script.Parent.Touched:connect(onTouch)</string>
