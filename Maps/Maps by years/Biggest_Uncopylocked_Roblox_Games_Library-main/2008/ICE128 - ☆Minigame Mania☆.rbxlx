				<Item class="Script" referent="RBX6245">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">GameScript</string>
						<string name="Source">for i=1,20 do
	p = Instance.new(&quot;Part&quot;)
	p.Parent = script.Parent
	p.Size = Vector3.new(math.random(15,25),math.random(15,25),math.random(15,25))
	p.Anchored = true
	p.BrickColor = BrickColor.new(1)
	x = math.random(0,314)*.1
	y = math.random(0,314)*.1
	z = math.random(0,314)*.1
	p.CFrame = script.Parent.Spawn.CFrame * CFrame.new(math.random(-150,150),0,math.random(-150,150)) * CFrame.fromEulerAnglesXYZ(x,y,z)
	end

wait(7)
--print(&quot;Go&quot;)
g = game.Players:GetChildren()
for i=1,#g do
	if g[i].Character ~= nil then 
	if g[i].Character:findFirstChild(&quot;Playing&quot;) ~= nil then
		print(&quot;Go&quot;)
		game.Lighting.Tools.LinkedRocketLauncher:clone().Parent = g[i].Backpack
		game.Lighting.Tools.LinkedSlingshot:clone().Parent = g[i].Backpack
		game.Lighting.Tools.LinkedSuperball:clone().Parent = g[i].Backpack
		game.Lighting.Tools.LinkedSword:clone().Parent = g[i].Backpack
		game.Lighting.Tools.LinkedTimebomb:clone().Parent = g[i].Backpack
		game.Lighting.Tools.LinkedTrowel:clone().Parent = g[i].Backpack
		end
		end
	end

