				<Item class="Script" referent="RBX7813">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">GameScript</string>
						<string name="Source">colors = {&quot;Blue&quot;, &quot;Red&quot;, &quot;Yellow&quot;, &quot;Green&quot;, &quot;Purple&quot;, &quot;Orange&quot;, &quot;Black&quot;}

s = script.Parent:GetChildren()
for i=1,#s do
	if s[i].className == &quot;Model&quot; then
		s2 = s[i]:GetChildren()
		print(&quot;!&quot;)
		for u=1,#s2 do
			if s2[u].className ==&quot;Model&quot; then
				print(&quot;!!&quot;)
				s3 = s2[u]:GetChildren()
				for m=1,#s3 do
					s3[m].Parent = s2[u].Parent
					s3[m].Name = &quot;Part&quot;
					--print(s3[m].Parent.Name)
					end
				end
			--[[if s2[u].className == &quot;Part&quot; then
				s2[u].Parent = script.Parent
				end]]
			end
		end
	end

function onTouch(part)
	if part.Parent ~= nil then
	h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if h ~= nil then
		h.Health = 0
		end
		end
	end
script.Parent.Lava.Touched:connect(onTouch)

wait(7)
n = 1

g = game.Players:GetChildren()
for i=1,#g do
	if g[i].Character ~= nil then 
	if g[i].Character:findFirstChild(&quot;Playing&quot;) ~= nil then
		print(&quot;Go&quot;)
		game.Lighting.Tools.Punch:clone().Parent = g[i].Backpack
		end
		end
	end

while true do
	choice = colors[math.random(1,#colors)]

	stuff = script.Parent:GetChildren()
	for i=1,#stuff do
		if stuff[i].Name == choice then
			glow = script.Glow:clone()
			glow.Disabled = false
			glow.Parent = stuff[i]
			end
		end

	m = Instance.new(&quot;Message&quot;)
	m.Parent = game.Workspace
	m.Text = &quot;Go on the &quot; .. choice .. &quot; hexagon!&quot;
	wait(3/n)
	m:remove()
	for i=1,#stuff do
		if stuff[i].Name ~= choice and stuff[i].className == &quot;Model&quot; then
			move = script.Move:clone()
			move.Disabled = false
			move.Parent = stuff[i]
			end
		end
	wait(5)
	n = n+.4
	end
</string>
						<bool name="archivable">true</bool>
					</Properties>
					<Item class="Script" referent="RBX7814">
						<Properties>
							<bool name="Disabled">true</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Glow</string>
							<string name="Source">stuff = script.Parent:GetChildren()

for i=1,#stuff do
	if stuff[i].className == &quot;Part&quot; then
		stuff[i].Reflectance = .5
		end
	end
wait(1)
for i=1,#stuff do
	if stuff[i].className == &quot;Part&quot; then
		stuff[i].Reflectance = 0
		end
	end
script:remove()</string>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
					<Item class="Script" referent="RBX7815">
						<Properties>
							<bool name="Disabled">true</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Move</string>
							<string name="Source">stuff = script.Parent:GetChildren()
--print(&quot;Cmon&quot;)
n = 0
	while n &lt; 25 do
		wait()
		for i=1,#stuff do
			if stuff[i].className == &quot;Part&quot; then
				--print(&quot;...&quot;)
				stuff[i].CFrame = stuff[i].CFrame * CFrame.new(0,-.1,0)
				n = n+.05
				end
			end
		end
	while n &gt; 0 do
		wait()
		for i=1,#stuff do
			if stuff[i].className == &quot;Part&quot; then
				stuff[i].CFrame = stuff[i].CFrame * CFrame.new(0,.1,0)
				n = n-.05
				end
			end
		end
script:remove()
