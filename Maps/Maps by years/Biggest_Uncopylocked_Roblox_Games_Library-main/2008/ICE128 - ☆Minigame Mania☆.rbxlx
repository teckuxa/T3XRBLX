				<Item class="Script" referent="RBX5918">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">GameScript</string>
						<string name="Source">--1vsALL minigame

function TeleTo(character, destination) --I hate how moveTo(someplace) is unreliable!!!
	torso = character:findFirstChild(&quot;Torso&quot;)
	if torso then
		while true do
		if character == nil then break end
		character:moveTo(destination)
		wait()
		torso = character:findFirstChild(&quot;Torso&quot;)
		if character:findFirstChild(&quot;Torso&quot;) == nil then break end
		print((torso.Position - destination).magnitude)
		if (torso.Position - destination).magnitude &lt; 15 then break end
		end
	end
	end


wait(8)
playing = {}
p = game.Players:GetChildren()
for i=1,#p do
	if p[i].Character ~= nil then 
	if p[i].Character:findFirstChild(&quot;Playing&quot;) ~= nil then
	table.insert(playing, p[i])
	end
	end
	end

while seeker == nil do
	num = math.random(1,#playing)
	seeker = playing[num]
	print(seeker.Name)
	wait()
	end

local char = seeker.Character
print(seeker.Name)
game.Workspace.Controller.Value = seeker

m = Instance.new(&quot;Message&quot;)
m.Parent = game.Workspace
m.Text = &quot;The seeker is &quot; .. seeker.Name .. &quot;! Don&apos;t let it catch you!&quot;
TeleTo(char, script.Parent.Box.SeekerSpawn.Position)

for i=1,#playing do
	if playing[i] ~= seeker then
	if playing[i].Character ~= nil then
	playing[i].Character.Name = &quot;&quot;
	playing[i].Character.Head.Transparency = 1
	end
	end
end

--if seeker.Character == nil then game.Workspace.Timer.Value = 0 end
wait(3)
m:remove()
--if seeker.Character == nil then game.Workspace.Timer.Value = 0 end

h = Instance.new(&quot;Hint&quot;)
h.Parent = game.Workspace
timer = 60
while timer &gt; 0 do
	h.Text = timer .. &quot; second(s) until the seeker comes.&quot;
	wait(1)
	timer = timer - 1
	--if seeker.Character == nil then game.Workspace.Timer.Value = 0 end
	end
h:remove()

--if seeker.Character == nil then game.Workspace.Timer.Value = 0 end

m = Instance.new(&quot;Message&quot;)
m.Parent = game.Workspace
m.Text = seeker.Name .. &quot; is now in the field. Watch out for it!&quot;

TeleTo(char, script.Parent.Spawn.Position)
char.Humanoid.WalkSpeed = 28

local bam = script.Bam:clone()
bam.Disabled = false
bam.Parent = char

wait(3)
m:remove()
--if seeker.Character == nil then game.Workspace.Timer.Value = 0 end

h = Instance.new(&quot;Hint&quot;)
h.Parent = game.Workspace
timer = 180
while timer &gt; 0 do
	h.Text = timer .. &quot; second(s) until the minigame is over. Tag other players to get them out.&quot;
	wait(1)
	timer = timer - 1
	--if seeker.Character == nil then game.Workspace.Timer.Value = 0 end
	end

game.Workspace.Timer.Value = 0

</string>
						<bool name="archivable">true</bool>
					</Properties>
					<Item class="Script" referent="RBX5919">
						<Properties>
							<bool name="Disabled">true</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Bam</string>
							<string name="Source">function onTouch(part)
	if part.Parent ~= nil then
		h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
		if h ~= nil then
			if h ~= script.Parent.Humanoid then
			h.Health = 0
			end
			end
		end
	end

stuff = script.Parent:GetChildren()
for i=1,#stuff do
	if stuff[i].className == &quot;Part&quot; then
		stuff[i].Touched:connect(onTouch)
		end
	end

