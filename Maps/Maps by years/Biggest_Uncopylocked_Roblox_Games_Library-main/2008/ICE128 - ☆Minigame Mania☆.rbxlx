						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">GameScript</string>
						<string name="Source">local things = script.Parent:GetChildren()
for i=1,#things do
	local spawner = things[i]:findFirstChild(&quot;Spawner&quot;, true)
	if spawner ~= nil then
		local model = spawner.Parent
		local buttons = model.Buttons:GetChildren()
		for x=1,#buttons do
			o = buttons[x].BrickColor
			local c = Instance.new(&quot;ClickDetector&quot;)
			c.Parent = buttons[x]
			c.MaxActivationDistance = 10
			local s = script.Clicker:clone()
			s.Disabled = false
			s.Parent = buttons[x]
			end
		end
	end


wait(7)

g = game.Players:GetChildren()
for i=1,#g do
	if g[i].Character == nil then return end
	if g[i].Character:findFirstChild(&quot;Playing&quot;) ~= nil then
		pb = script.Parent.PlayerBox:clone()
		pb.Parent = script.Parent
		pb:moveTo(pb.Spawner.Position + Vector3.new(50*i, 0, 0))
		pb.Name = g[i].Name .. &quot;&apos;s Box&quot;
		pb.ObjectValue.Value = g[i]
		g[i].Character:moveTo(pb.Spawner.Position)
		if g[i].Character:findFirstChild(&quot;Humanoid&quot;) then
			g[i].Character.Humanoid.WalkSpeed = 0
			end
		end
	end

script.Parent.Spawn:remove()
script.Parent.PlayerBox:remove()

function killAllWhoDidNotPress()
	local things = script.Parent:GetChildren()
	for i=1,#things do
		local spawner = things[i]:findFirstChild(&quot;Spawner&quot;, true)
		if spawner ~= nil then
			local model = spawner.Parent
			local buttons = model.Buttons:GetChildren()
			for x=1,#buttons do
				if buttons[x].Reflectance &gt; 0 then

					--YOUFAIL
					for n=1, #buttons do
					buttons[n].Reflectance = 1
					buttons[n].BrickColor = o
					end

					if model.ObjectValue.Value ~= nil then
						if model.ObjectValue.Value.Character ~= nil then
							if model.ObjectValue.Value.Character:findFirstChild(&quot;Humanoid&quot;) then
								model.ObjectValue.Value.Character.Humanoid.Health = 0
								game.Workspace.LightningSound:play()
								local parts = model.ObjectValue.Value.Character:GetChildren()
								for z=1,#parts do
									if parts[z].className == &quot;Part&quot; then
										parts[z].Reflectance = 1
										end
									end
								model.ObjectValue.Value = nil
								end
							end
						end
					end
				end
			end
		end
	end


wait(1)
timer = 2
while true do
	m = math.random(1,4)
	local things = script.Parent:GetChildren()
	for i=1,#things do
		local spawner = things[i]:findFirstChild(&quot;Spawner&quot;, true)
		if spawner ~= nil then
			local model = spawner.Parent
			local buttons = model.Buttons:GetChildren()
			local choice = buttons[m]
			choice.BrickColor = BrickColor.new(1)
			choice.Reflectance = 1
			end
		end
	wait(timer)

	if timer &gt; .7 then
	timer = timer - .1
	--else
	--timer = timer - .02
	end

	killAllWhoDidNotPress()

	wait(2)

	local things = script.Parent:GetChildren()
	for i=1,#things do
		local spawner = things[i]:findFirstChild(&quot;Spawner&quot;, true)
		if spawner ~= nil then
			local model = spawner.Parent
			local buttons = model.Buttons:GetChildren()
			for x=1,#buttons do
				buttons[x].Reflectance = 0
				end
			end
		end

	end

