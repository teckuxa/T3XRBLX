			<Item class="LocalScript" referent="RBX10053">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">LocalScript</string>
					<string name="Source">--[[
---&lt;&lt;By 4430702&gt;&gt;---
Feel Free To Republish But Please Give Me Some Credit
This Gun Is Very Easy To Edit

*Its Instant Kill (Feel Free To Change The Damage Below)
*To Change Reload Time Change the &apos;4&apos; to the number of SECONDS you wish the reload time to be
*MessageShown is the Welcoming Hint, You Could Change This To Whatever you wish, for example
you could say &apos;Free-For-All Laser Gun&apos; or evan &apos;&apos;GET SOME KILLS&apos; i personaly use the version of the gun
]]
--&gt;&gt;Damage&lt;&lt;--
local Damage = 75
--&gt;&gt;Reload Time&lt;&lt;--
local ReloadTime = 1
--&gt;&gt;Message Shown&lt;&lt;--
--local MessageShown = &quot;GO and KILL!&quot;
--&gt;&gt;Lazor Color&lt;&lt;--
local LaserColor = 1

--Warning--  Avoid Changing The Script below UNLESS You Know What You Are Doing --Warning--

local Selected = false 
local Shoot = true
Tool = script.Parent
local Reloading = false

function Click(Target) 
	if Reloading == false then
	Reloading = true
	Target.Icon = &quot;rbxasset://textures/GunWaitCursor.png&quot;
	if (Target.Target ~= nil) then
		local humanoid = Target.Target.Parent:findFirstChild(&quot;Humanoid&quot;)
		if(humanoid~=nil)then 
			humanoid.Health = humanoid.Health - Damage
		end 
	end
	local P = Instance.new(&quot;Part&quot;) 
	P.Name = &quot;Laser&quot; 
	local Place0 = script.Parent.Parent[&quot;Right Arm&quot;].CFrame 
	local Place3 = script.Parent.Parent[&quot;Right Arm&quot;]
	P.formFactor = 0 
	P.Size = Vector3.new(1,1,1) 
	local Distance = (Target.Hit.p- Place3.Position).magnitude
	script.Parent.Mesh.Scale = Vector3.new(0.25, 0.25, Distance)
	P.CFrame = CFrame.new(Place3.Position, Target.Hit.p)*CFrame.new(0, 0, -Distance/2)
	script.Parent.Mesh:Clone().Parent = P
	P.Parent = game.Workspace 
	P.BrickColor = BrickColor.new(LaserColor)
	P.Transparency = 0.5 
	P.Reflectance = 0.2
	P.Anchored = true 
	P.CanCollide = false 
	for i = 1,10 do 
	P.Transparency = 0.5+(i*0.05) 
	wait(0.1) 
	end 

	wait(ReloadTime)
	Target.Icon = &quot;rbxasset://textures/GunCursor.png&quot;
	Reloading = false
	end
end 


function Select(Mouse) 
Mouse.Icon = &quot;rbxasset://textures/GunCursor.png&quot;
Mouse.Button1Down:connect(function()Click(Mouse)end) 
local Player = game.Players:GetPlayerFromCharacter(script.Parent.Parent)
--local AnyOldMessages = Player:FindFirstChild(&quot;LazorTagGunMessage&quot;)
--[[if AnyOldMessages == nil then
local NewMessage = Instance.new(&quot;Message&quot;)
NewMessage.Name = &quot;LazorTagGunMessage&quot;
NewMessage.Text = &quot;&quot; ..MessageShown
NewMessage.Parent = Player
end]]

end 
function Deselect() 
local Player = script.Parent.Parent.Parent
--[[local AnyOldMessages = Player:FindFirstChild(&quot;LazorTagGunMessage&quot;)
if AnyOldMessages ~= nil then
AnyOldMessages:remove()
end]]
end 
script.Parent.Equipped:connect(Select) 
script.Parent.Unequipped:connect(Deselect)


print(&quot;Hello world!&quot;)
</string>
