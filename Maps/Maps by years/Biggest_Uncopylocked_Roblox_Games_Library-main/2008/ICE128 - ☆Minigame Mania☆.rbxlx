				<Item class="Script" referent="RBX4541">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">GameScript</string>
						<string name="Source">top = script.Parent.Top.BodyAngularVelocity
bottom = script.Parent.Bottom.BodyAngularVelocity
script.Parent.Top.Anchored = true
script.Parent.Bottom.Anchored = true

wait(7)
print(&quot;Set up players&quot;)
g = game.Players:GetChildren()
for i=1,#g do
	if g[i].Character ~= nil then
