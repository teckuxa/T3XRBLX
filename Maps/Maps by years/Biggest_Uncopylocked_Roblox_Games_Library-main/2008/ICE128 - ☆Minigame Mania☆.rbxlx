							<string name="Source">function onTouch(part)
	if part ~= nil then
		if part.Size.x &lt; 40 and part.Size.y &lt; 40 and part.Size.z &lt; 40 and part:findFirstChild(&quot;Disco&quot;) == nil then
			if part.Parent.Name == &quot;Workspace&quot; or part.Parent:findFirstChild(&quot;Humanoid&quot;) then
			local thing = script.Parent.Disco:clone()
			thing.Parent = part
			part.Transparency = 0
			end
			end
		end
	end

script.Parent.Touched:connect(onTouch)</string>
