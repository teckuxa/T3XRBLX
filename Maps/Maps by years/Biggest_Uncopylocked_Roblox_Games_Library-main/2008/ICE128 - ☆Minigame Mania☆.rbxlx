				<Item class="Script" referent="RBX2009">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">ShopScript</string>
						<string name="Source">item = script.Parent.Item
price = script.Parent.Price
debounce = false
original = script.Parent.Head.BrickColor
--print(&quot;Hello World! Shopping script started&quot;)

function onTouch(part)
	h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if h ~= nil then
		player = game.Players:findFirstChild(h.Parent.Name)
		if player ~= nil then
			stats = player:findFirstChild(&quot;leaderstats&quot;)
			if stats ~= nil then
				points = stats:findFirstChild(&quot;Coins&quot;)
				if points ~= nil then
					if points.Value &gt;= price.Value and debounce == false and player.Backpack:findFirstChild(item.Value) == nil then
						debounce = true
						print(&quot;Go!&quot;)

						points.Value = points.Value - price.Value

						script.Parent.Head.BrickColor = BrickColor.new(21)

						bin = game.Lighting.Inventory:findFirstChild(item.Value):clone()
						bin.Parent = player.Backpack

						m = game.Workspace:findFirstChild(h.Parent.Name .. &quot;&apos;s Items&quot;)
						if m == nil then
							print(&quot;Making inventory&quot;)
							m = Instance.new(&quot;Model&quot;)
							m.Parent = game.Workspace
							m.Name = h.Parent.Name .. &quot;&apos;s Items&quot;
							end

						i = item:clone()
						i.Parent = m
						i.Name = item.Value
						i.Value = &quot;&quot;

						print(&quot;Finished...&quot;)

						wait(3)

						script.Parent.Head.BrickColor = original
						debounce = false

						print(&quot;Kk&quot;)
						end
					end
				end
			end
		end
	end

script.Parent.Head.Touched:connect(onTouch)</string>
						<bool name="archivable">true</bool>
