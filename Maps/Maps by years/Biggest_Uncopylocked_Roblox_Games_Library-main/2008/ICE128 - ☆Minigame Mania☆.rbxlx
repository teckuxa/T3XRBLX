								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<string name="Source">faces = {}
display = script.Parent.Parent.Display
box = script.Parent
db = display.BrickColor
bb = box.BrickColor
local things = game.Lighting.Refer:GetChildren()
for i=1,#things do
	table.insert(faces, things[i].Texture)
	end

function checkAnswer()
	if script.Parent.Parent.Display.Decal.Texture == script.Parent.Choice.Texture then
		print(&quot;Right&quot;)
		display.Reflectance = 3
		box.Reflectance = 3
		script.Parent.Parent.NumberCorrect.Value = script.Parent.Parent.NumberCorrect.Value + 1
		wait(.7)
		display.Reflectance = 0
		box.Reflectance = 1
		timer = timer / 1.3
		local m = math.random(1,#faces)
		script.Parent.Parent.Display.Decal.Texture = faces[m]
		else
		display.BrickColor = BrickColor.new(26)
		box.BrickColor = BrickColor.new(26)
		wait(.5)
		display.BrickColor = db
		box.BrickColor = bb
		print(&quot;Wrong&quot;)
		end
	end

function onTouch(part)
	if part.Parent then
		if part.Parent:findFirstChild(&quot;Humanoid&quot;) then
			if touchy == false then
				m = box.Mesh
				touchy = true
				coroutine.resume(coroutine.create(function()
					for i = 4,8,0.5 do
						m.Scale = Vector3.new(i/4,64/i/i/4,i/4)
						m.Offset = m.Offset + Vector3.new(0,.2,0)
						wait()
					end
					for i = 8,4,-0.5 do
						m.Scale = Vector3.new(i/4,64/i/i/4,i/4)
						m.Offset = m.Offset - Vector3.new(0,.2,0)
						wait()
					end
				end))
				end
			end
		end
	end

script.Parent.Touched:connect(onTouch)

x = 1
timer = 1
local m = math.random(1,#faces)
script.Parent.Parent.Display.Decal.Texture = faces[m]

while true do


	wait(.2)

	touchy = false
	while true do
		script.Parent.Parent.Box.Choice.Texture = faces[x]
		wait(timer)
		x = x + 1
		if x &gt; #faces then x = 1 end
		script.Parent.Sound:play()

		if touchy == true then
			touchy = false
			break
			end

		end
	wait(.3)
	checkAnswer()
	end
</string>
