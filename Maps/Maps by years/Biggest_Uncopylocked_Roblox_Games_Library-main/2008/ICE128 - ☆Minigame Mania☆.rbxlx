						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">GameScript</string>
						<string name="Source">wait(7)

g = game.Players:GetChildren()
for i=1,#g do
	if g[i].Character ~= nil then 
	if g[i].Character:findFirstChild(&quot;Torso&quot;) then
	if g[i].Character:findFirstChild(&quot;Playing&quot;) ~= nil then
		local bp = Instance.new(&quot;BodyPosition&quot;)
		bp.Parent = g[i].Character.Torso
		bp.position = script.Parent.Spawn.Position
		bp.maxForce = Vector3.new(0,0,10000000000)
		end
		end
		end
	end

while true do
	local fruit = game.Lighting.Fruit:clone()
	fruit.Parent = script.Parent
	xhalf = script.Parent.Spawn.Size.x/2
	fruit.Position = script.Parent.Spawn.Position + Vector3.new(math.random(-xhalf, xhalf), 100, 0)
	fruit.BrickColor = BrickColor.Random()
	wait(math.random(5,10) * .1)
	end
</string>
