					<Item class="Script" referent="RBX5591">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<string name="Source">function onTouch(part)
	if part.Parent == nil then return end
	h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if h ~= nil and h.Parent:findFirstChild(&quot;Torso&quot;) ~= nil then
		h.Parent.Torso.Velocity = Vector3.new(0,200,0)
		end
	end

script.Parent.Touched:connect(onTouch)</string>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
				</Item>
