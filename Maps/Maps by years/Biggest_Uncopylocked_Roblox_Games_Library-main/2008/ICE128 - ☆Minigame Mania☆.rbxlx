				<Item class="Script" referent="RBX7612">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">GameScript</string>
						<string name="Source">wait(8)

m = Instance.new(&quot;Message&quot;)
m.Parent = game.Workspace
m.Text = &quot;Gate will open in 3.&quot;
wait(1)
m.Text = &quot;2&quot;
wait(1)
m.Text = &quot;1&quot;
wait(1)
m.Text = &quot;!!!&quot;

script.Parent.Gate:remove()
g = script.Parent:GetChildren()
for i=1,#g do
	if g[i].Name == &quot;Recent&quot; or g[i].Name == &quot;Start&quot; then
		s = script.Generator:clone()
		s.Disabled = false
		s.Parent = g[i]
		end
	end

p = game.Players:GetChildren()
for i=1,#p do
	if p[i].Character ~= nil then 
	if p[i].Character:findFirstChild(&quot;Playing&quot;) ~= nil then
	p[i].Character.Humanoid.WalkSpeed = 36
	end
	end
	end


wait(.3)
m:remove()

</string>
						<bool name="archivable">true</bool>
					</Properties>
					<Item class="Script" referent="RBX7613">
						<Properties>
							<bool name="Disabled">true</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Generator</string>
							<string name="Source">debounce = false

function onTouch(part)
	h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if h ~= nil and debounce == false then
		debounce = true
		speed = game.Lighting.Speedy
		regular = game.Lighting.Regular
		block = game.Lighting.Block
		recent = script.Parent.Parent.Recent
		m = math.random(1,3)
		if m &lt; 2 then
			s = speed:clone()
			s.Parent = script.Parent.Parent
			n = math.random(1,2)
			if n &gt; 1 then
				s.CFrame = s.CFrame * CFrame.fromEulerAnglesXYZ(0,math.pi,0) -- Backwards
				end
			s.Position = recent.Position + Vector3.new(0,0,35)
			recent.Name = &quot;Part&quot;
			s.Name = &quot;Recent&quot;
			brick = s
			else
			r = regular:clone()
			r.Parent = script.Parent.Parent
			r.Position = recent.Position + Vector3.new(0,0,35)
			recent.Name = &quot;Part&quot;
			r.Name = &quot;Recent&quot;
			brick = r
			end
		b = block:clone()
		b.Parent = script.Parent.Parent
		b.Position = brick.Position + Vector3.new(math.random(-11,11),3,math.random(-11,11))
		wait(5)
		script.Parent.Anchored = false
		end
	end

