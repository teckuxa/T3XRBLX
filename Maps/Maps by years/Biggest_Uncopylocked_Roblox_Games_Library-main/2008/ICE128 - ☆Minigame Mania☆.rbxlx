				<Item class="Script" referent="RBX2863">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">GameScript</string>
						<string name="Source">function onFinishTouch(part)
	h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if h ~= nil and h.Parent:findFirstChild(&quot;Stun&quot;) == nil then
		script.Parent.Winner.Value = h.Parent.Name -- We have found a winner :D
		end
	end

script.Parent.Finish.Touched:connect(onFinishTouch)
wait(7)

</string>
						<bool name="archivable">true</bool>
					</Properties>
					<Item class="Script" referent="RBX2864">
						<Properties>
							<bool name="Disabled">true</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Stun</string>
							<string name="Source">bg = Instance.new(&quot;BodyGyro&quot;)
bg.Parent = script.Parent.Torso
bg.maxTorque = Vector3.new(1000000000,0,1000000000)
bg.cframe = script.Parent.Torso.CFrame * CFrame.fromEulerAnglesXYZ(3.14/2,0,3.14/2)
print(&quot;Zap&quot;)
wait(.5)
bg:remove()
script:remove()</string>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
