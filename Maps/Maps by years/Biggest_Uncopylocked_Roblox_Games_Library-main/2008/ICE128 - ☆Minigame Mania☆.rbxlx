local stuff = script.Parent.PlayerBox:GetChildren()
for i=1,#stuff do
	if stuff[i].className == &quot;Part&quot; then
	if stuff[i].Reflectance &gt; .2 and stuff[i]:findFirstChild(&quot;ClickDetector&quot;) ~= nil then
		s = script.Clicker:clone()
		s.Disabled = false
		s.Parent = stuff[i]
		stuff[i].ClickDetector.MaxActivationDistance = 20
		end
