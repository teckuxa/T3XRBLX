						<string name="Name">GameScript</string>
						<string name="Source">wait(7)
--wait(5)
while true do
	wait(.9)
	bomb = game.Lighting.TimeBomb:clone()
	bomb.Parent = script.Parent
	bomb.Position = script.Parent.Spawn.Position + Vector3.new(math.random(-script.Parent.Spawn.Size.x/2, script.Parent.Spawn.Size.x/2), math.random(0,10), math.random(-script.Parent.Spawn.Size.z/2,script.Parent.Spawn.Size.z/2))
	bomb.Velocity = Vector3.new(math.random(-50,50),math.random(-50,50),math.random(-50,50))
	end
</string>
