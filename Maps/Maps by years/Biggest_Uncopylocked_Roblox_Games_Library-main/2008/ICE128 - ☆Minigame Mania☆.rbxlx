		<Item class="Script" referent="RBX1452">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">function Hint</string>
				<string name="Source">_G[&quot;Hint&quot;] = function(...)
	local a = {...}
	local h,s,p,t,c = Instance.new(&quot;Hint&quot;),a[1],a[2],a[3],a[4]
	if (type(s) ~= &quot;string&quot;) and (type(s) ~= &quot;number&quot;) then error(&quot;bad argument #1 to &apos;message&apos; (string expected, got &quot;..type(s)..&quot;)&quot;,0) end
	if (type(p) ~= &quot;userdata&quot;) then error(&quot;bad argument #2 to &apos;message&apos; (object expected, got &quot;..type(p)..&quot;)&quot;,0) end
	if (type(t) ~= &quot;number&quot;) then error(&quot;bad argument #3 to &apos;message&apos; (number expected, got &quot;..type(t)..&quot;)&quot;,0) end
	if s then
		h.Text = s
		if p then
			h.Parent = p
			if t then
				if c then
					coroutine.resume(coroutine.create(function()
						wait(t)
						h:Remove()
					end))
				else
					wait(t)
					h:Remove()
				end
			end
		end
	end
	return h
end

