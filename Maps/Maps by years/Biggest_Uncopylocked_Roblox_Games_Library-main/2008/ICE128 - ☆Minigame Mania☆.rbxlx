				<Item class="Script" referent="RBX8653">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">GameScript</string>
						<string name="Source">wait(7)

p = game.Players:GetChildren()
for i=1,#p do
	if p[i].Character ~= nil then 
	if p[i].Character:findFirstChild(&quot;Playing&quot;) ~= nil then
	p[i].Character.Humanoid.WalkSpeed = 25
	--[[h = script.FPS:clone()
	h.Disabled = false
	h.Parent = p[i].Backpack]]
	end
	end
	end

g = game.Players:GetChildren()
for i=1,#g do
	if g[i].Character == nil then return end
	if g[i].Character:findFirstChild(&quot;Playing&quot;) ~= nil then
		print(&quot;Go&quot;)
		game.Lighting.Tools.Flashlight:clone().Parent = g[i].Backpack
		if g[i].Character:findFirstChild(&quot;Head&quot;) ~= nil then
			g[i].Character.Head.Transparency = 1
			end
		end
	end
</string>
						<bool name="archivable">true</bool>
					</Properties>
					<Item class="LocalScript" referent="RBX8654">
						<Properties>
							<bool name="Disabled">true</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">No</string>
							<string name="Source">while true do
	local c = game.Workspace.CurrentCamera
	if c.className == &quot;Camera&quot; and (c.CoordinateFrame.p - c.Focus.p).magnitude &gt; 1 then
			c.Focus = c.Focus * CFrame.new(c.CoordinateFrame.p, c.Focus.p) * (c.CoordinateFrame.p - c.Focus.p.magnitude)
		end
	wait(1)
	end
--[[c.CoordinateFrame]]

--(CFrame.new(c.CoordinateFrame.p, c.Focus.p)).lookVector * (c.CoordinateFrame.p - c.Focus.p).magnitude)
</string>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
					<Item class="LocalScript" referent="RBX8655">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">FPS</string>
							<string name="Source">--[[while true do
	local c = game.Workspace.CurrentCamera
	if script.Parent.Parent.Character ~= nil then
		char = script.Parent.Parent.Character
		head = char:findFirstChild(&quot;Head&quot;)
		if head ~= nil then
			
			if c.className == &quot;Camera&quot; and (c.CoordinateFrame.p - c.Focus.p).magnitude &gt; 3 then

					c.CoordinateFrame = c.CoordinateFrame * CFrame.new(c.CoordinateFrame.p-c.Focus.p)--head.CFrame - Vector3.new(1,0,0)

					--c.Focus = c.CoordinateFrame * CFrame.new((CFrame.new(c.CoordinateFrame.p, c.Focus.p)).lookVector * (c.CoordinateFrame.p - c.Focus.p).magnitude)

				end

			end

		end
	wait(1)
	end]]
--[[c.CoordinateFrame]]

--(CFrame.new(c.CoordinateFrame.p, c.Focus.p)).lookVector * (c.CoordinateFrame.p - c.Focus.p).magnitude)
</string>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
