						<string name="Name">GameScript</string>
						<string name="Source">wait(7)

s = {}

spawns = script.Parent:GetChildren()
for i=1,#spawns do
	if spawns[i].className == &quot;Part&quot; and spawns[i].Name == &quot;Spawn&quot; then
		spawns[i].Anchored = false
		local bp = Instance.new(&quot;BodyPosition&quot;)
		bp.Parent = spawns[i]
		bp.position = spawns[i].Position
		bp.maxForce = Vector3.new(100000,100000,100000)
		local bav = Instance.new(&quot;BodyAngularVelocity&quot;)
		bav.Parent = spawns[i]
		bav.maxTorque = Vector3.new(0,0,0)
		local c = Instance.new(&quot;ClickDetector&quot;)
		c.MaxActivationDistance = 50
		c.Parent = spawns[i]
		local d = script.Flip:clone()
		d.Disabled = false
		d.Parent = spawns[i]
		end
	end


</string>
						<bool name="archivable">true</bool>
					</Properties>
					<Item class="Script" referent="RBX6241">
						<Properties>
							<bool name="Disabled">true</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Flip</string>
							<string name="Source">debounce = false
function onClick()
	if debounce == false then
		debounce = true
		script.Parent.BodyAngularVelocity.maxTorque = Vector3.new(1000000,0,1000000)
		script.Parent.BodyAngularVelocity.angularvelocity = Vector3.new(math.random(-1,1),0,math.random(-1,1))
		wait(2)
		script.Parent.BodyAngularVelocity.angularvelocity = Vector3.new(0,0,0)
		script.Parent.BodyAngularVelocity.maxTorque = Vector3.new(0,0,0)
		debounce = false
		end
	end

script.Parent.ClickDetector.MouseClick:connect(onClick)</string>
							<bool name="archivable">true</bool>
