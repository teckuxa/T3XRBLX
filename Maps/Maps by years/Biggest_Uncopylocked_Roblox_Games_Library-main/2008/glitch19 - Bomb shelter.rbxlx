				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Regenerate</string>
				<ProtectedString name="Source">model = game.Workspace.Regen


backup = model:clone()

while true do
	wait(180)


	model:remove()



	model = backup:clone()
	model.Parent = game.Workspace
	model:makeJoints()

end
</ProtectedString>
