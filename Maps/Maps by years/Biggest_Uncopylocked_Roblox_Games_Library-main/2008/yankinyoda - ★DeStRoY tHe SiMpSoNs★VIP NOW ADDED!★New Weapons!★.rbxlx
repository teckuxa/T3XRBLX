					<Item class="Sound" referent="RBX2901">
						<Properties>
							<bool name="Archivable">true</bool>
							<bool name="Looped">false</bool>
							<string name="Name">Explosion</string>
							<float name="Pitch">1</float>
							<bool name="PlayOnRemove">true</bool>
