	g3.Part0 = g3.Parent
	g3.Part1 = Tool.G3
	g3.C1 = CFrame.fromEulerAnglesXYZ(math.pi / 2, 0, 0) * CFrame.new(0, -0.8, 4.25)
	local h1 = Instance.new(&quot;Weld&quot;)
