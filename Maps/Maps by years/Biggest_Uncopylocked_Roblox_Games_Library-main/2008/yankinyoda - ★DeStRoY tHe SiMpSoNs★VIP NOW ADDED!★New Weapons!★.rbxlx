	w1.Part1 = Tool.P1
	w1.C1 = CFrame.fromEulerAnglesXYZ(math.pi / 2, 0, 0) * CFrame.new(0, -0.8, 0.5)
	local w2 = Instance.new(&quot;Weld&quot;)
