					<string name="Name">WeldScript</string>
					<ProtectedString name="Source">Tool = script.Parent
print(&quot;Welding...&quot;)

function Weldnow()
	local f1 = Instance.new(&quot;Weld&quot;)
	f1.Parent = Tool.Handle
	f1.Part0 = f1.Parent
	f1.Part1 = Tool.F1
	f1.C1 = CFrame.fromEulerAnglesXYZ(math.pi / 2, 0, 0) * CFrame.new(0, -0.8, -4.2)
	local f2 = Instance.new(&quot;Weld&quot;)
	f2.Parent = Tool.Handle
	f2.Part0 = f2.Parent
	f2.Part1 = Tool.F2
	f2.C1 = CFrame.fromEulerAnglesXYZ(math.pi / 2, 0, 0) * CFrame.new(0, -0.8, -4.4)
	local f3 = Instance.new(&quot;Weld&quot;)
	f3.Parent = Tool.Handle
	f3.Part0 = f3.Parent
	f3.Part1 = Tool.F3
	f3.C1 = CFrame.fromEulerAnglesXYZ(math.pi / 2, 0, 0) * CFrame.new(0, -0.8, -4.6)
	local g1 = Instance.new(&quot;Weld&quot;)
