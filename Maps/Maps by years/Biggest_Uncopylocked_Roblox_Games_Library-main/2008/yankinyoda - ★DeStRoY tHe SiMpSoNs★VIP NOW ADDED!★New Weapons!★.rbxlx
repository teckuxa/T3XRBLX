	g1.Part1 = Tool.G1
	g1.C1 = CFrame.fromEulerAnglesXYZ(math.pi / 2, 0, 0) * CFrame.new(0, -0.8, 2.25)
	local g2 = Instance.new(&quot;Weld&quot;)
