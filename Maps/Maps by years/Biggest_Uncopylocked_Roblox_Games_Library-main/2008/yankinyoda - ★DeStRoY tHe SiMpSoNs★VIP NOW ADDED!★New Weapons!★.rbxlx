						</Item>
					</Item>
					<Item class="Script" referent="RBX427">
						<Properties>
							<bool name="Archivable">true</bool>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">MoveScriptToPlayer</string>
							<ProtectedString name="Source">function onTouched(hit)
	local humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
	if humanoid and debounce==nil then
		if humanoid.Parent:findFirstChild(&quot;Leap&quot;) then humanoid.Parent.Leap:remove() end
		debounce = true
		--script.Parent.Parent = nil
		script.Parent.Leap:clone().Parent=humanoid.Parent
		wait(1)
		debounce = nil
	end
end
