end
end


function onButton1Up(mouse)
sel = false
end

function onEquippedLocal(mouse)

	if mouse == nil then
		print(&quot;Mouse not found&quot;)
		return 
	end

	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;   --If you want another cursor texture, put it here!
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
	mouse.Button1Up:connect(function() onButton1Up(mouse) end)
	mouse.KeyDown:connect(onKeyDown) 
e = script.Parent.Parent.Parent:GetChildren()
for i=1,#e do
if e[i].className == &quot;Hint&quot; then
e[i]:remove()
end
end
s = Instance.new(&quot;Hint&quot;)
s.Parent = script.Parent.Parent.Parent
s.Text = &quot;Click R to reset the path.&quot;  --Change this to tell people how it works
end

function unsel(mouse)
e = script.Parent.Parent.Parent:GetChildren()
for i=1,#e do
if e[i].className == &quot;Hint&quot; then
e[i]:remove()
end
end
end


script.Parent.Selected:connect(onEquippedLocal) 
script.Parent.Deselected:connect(unsel)</ProtectedString>
