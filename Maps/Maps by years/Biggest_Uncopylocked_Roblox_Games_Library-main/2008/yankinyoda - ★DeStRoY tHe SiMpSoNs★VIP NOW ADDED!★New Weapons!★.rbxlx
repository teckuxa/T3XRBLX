			</Properties>
			<Item class="Script" referent="RBX1980">
				<Properties>
					<bool name="Archivable">true</bool>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Working Anti-lag script</string>
					<ProtectedString name="Source">print(&quot;AntiLag script loaded&quot;)
mj = 0
bj = 0
pa = 0
te = 0
de = 0

Instance.new(&quot;Part&quot;).Parent = game.Workspace

function ca()
if de == 0 then
de = 1
mj = 0
bj = 0
pa = 0
te = 0
print(&quot;Counters reset&quot;)
wait(.1)
c = game.Workspace:GetChildren()
for i = 1, #c do
te = te + 1
print(&quot;Found &quot;..te..&quot; objects in Workspace.&quot;)
if c[i].className == &quot;Part&quot; then
pa = pa + 1
print(&quot;Found &quot;..pa..&quot; bricks.&quot;)
if c[i].Anchored == true then
bj = bj + 1
c[i]:BreakJoints()
print(&quot;Broke &quot;..bj..&quot; joints of anchored bricks.&quot;)
else
mj = mj + 1
print(&quot;Made &quot;..mj..&quot; joints of unanchored bricks.&quot;)
c[i]:MakeJoints()
end
end
end
de = 0
end
print(&quot;One cycle completed&quot;)
end

script.Parent.ChildAdded:connect(ca)
--[[
Made by koolmanyes
You know only a noob would change my name
because this is one of the few working anti-lag
scripts in Roblox. Please give credit to me if you
like this script. PM me any problems with this
script. To use this, all you have to do is put it in
Workspace and ungroup most models.
]]--</ProtectedString>
				</Properties>
			</Item>
		</Item>
