						<ProtectedString name="Source">print (&quot;Multi-T-Shirt VIP T-Shirt Door Script Loaded&quot;)


permission = { &quot;YourName&quot; } --People who can get in.


texture = &quot;http://www.roblox.com/asset?id=8728826&quot;-- post the texture ID here
texture2 = &quot;http://www.roblox.com/asset?id=6388476&quot; -- post the 2nd shirt ID here
texture3 = &quot;http://www.roblox.com/asset?id=56262510&quot; --post the 3rd shirt ID here
texture4 = &quot;http://www.roblox.com/asset?id=4297203&quot;
--^ if you only want 2, then leave the texture3 blank. DO NOT delete that line.
-- If you want more than 3 t-shirts, you need to do this..
--1. Copy and paste texture3 = &quot;&quot; then add it to the line below..
--2. Step 2 is down below. look for green text..

function checkOkToLetIn(name) 
	for i = 1,#permission do 


		if (string.upper(name) == string.upper(permission[i])) then return true end 
	end 
	return false 
end 

local Door = script.Parent

function onTouched(hit) 
	print(&quot;Door Hit&quot;) 
	local human = hit.Parent:findFirstChild(&quot;Humanoid&quot;) 
	if (human ~= nil ) then 
		if human.Parent.Torso.roblox.Texture == texture or texture2 or texture3 or texture4 then 
--                                                                                                                                ^ right there
--                                                                             2. Type &quot;or texture4&quot; at the right of &quot; or texture3&quot;
			Door.Transparency = 0.8
			Door.CanCollide = false 
			wait(4)
			Door.CanCollide = true 
			Door.Transparency = 0 
			print(&quot;Human touched door&quot;) 
		elseif (checkOkToLetIn(human.Parent.Name)) then 
			print(&quot;Human passed test&quot;) 
			Door.Transparency = 0.8
			Door.CanCollide = false 
			wait(4)
			Door.CanCollide = true 
			Door.Transparency = 0 
		else human.Health = 0
		end 
	end 
end 

script.Parent.Touched:connect(onTouched)

--This has not been tested yet.</ProtectedString>
