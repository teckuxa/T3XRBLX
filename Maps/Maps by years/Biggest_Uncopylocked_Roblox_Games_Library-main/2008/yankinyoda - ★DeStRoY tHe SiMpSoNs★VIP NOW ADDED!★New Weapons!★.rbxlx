				</Item>
				<Item class="HopperBin" referent="RBX598">
					<Properties>
						<bool name="Active">false</bool>
						<bool name="Archivable">true</bool>
						<token name="BinType">0</token>
						<string name="Name">iceshard</string>
						<Content name="TextureId"><null></null></Content>
