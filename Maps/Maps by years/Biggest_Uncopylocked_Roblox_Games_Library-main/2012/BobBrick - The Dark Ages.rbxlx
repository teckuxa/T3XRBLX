			<Item class="Script" referent="RBX1997">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">BridgeScript</string>
					<ProtectedString name="Source">local bodyforce = script.Parent.Drawbridge.BodyForce

local debounce = false


function onClickedUp()
&#9;debounce = true
&#9;bodyforce.force = Vector3.new(0,250000,0)
&#9;wait(5)
&#9;debounce = false
end

function onClickedDown()
&#9;debounce = true
&#9;bodyforce.force = Vector3.new(0,-100,0)
&#9;wait(5)
&#9;debounce = false
end




script.Parent.BridgeDown.ClickDetector.MouseClick:connect(onClickedDown)
script.Parent.BridgeUp.ClickDetector.MouseClick:connect(onClickedUp)


</ProtectedString>
				</Properties>
			</Item>
