							<Vector3 name="Scale">
								<X>0.25</X>
								<Y>0.25</Y>
								<Z>0.25</Z>
							</Vector3>
							<Content name="TextureId"><url>http://www.roblox.com/asset/?id=55727398 </url></Content>
