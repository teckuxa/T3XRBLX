				<Item class="LocalScript" referent="RBX8243">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Local Gui</string>
						<ProtectedString name="Source">local Tool = script.Parent

local swingWithOut = nil
local swingJump = nil
local swordThrust = nil

local humanoid = nil

enabled = true
function onButton1Down(mouse)
&#9;if not enabled then
&#9;&#9;return
&#9;end

&#9;enabled = false

&#9;wait()

&#9;if Tool.Lunge.Value == true then
&#9;&#9;humanoid.Jump = true
&#9;&#9;swingJump:Play()
&#9;&#9;wait(0.8)
&#9;&#9;Tool.Lunge.Value = false
&#9;else
&#9;&#9;local anim = math.random(2,3)
&#9;&#9;if anim == 2 then
&#9;&#9;&#9;swingWithOut:Play()
&#9;&#9;else
&#9;&#9;&#9;swordThrust:Play()
&#9;&#9;end
&#9;end

&#9;enabled = true

end

function onEquippedLocal(mouse)

&#9;if mouse == nil then
&#9;&#9;print(&quot;Mouse not found&quot;)
&#9;&#9;return 
&#9;end

&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
&#9;
&#9;humanoid = Tool.Parent:FindFirstChild(&quot;Humanoid&quot;)

&#9;swingWithOut = humanoid:LoadAnimation(Tool.twohandswordwithswingout)
&#9;swingJump = humanoid:LoadAnimation(Tool.swordswingjump)
&#9;swordThrust = humanoid:LoadAnimation(Tool.swordthrust)

end

function onUnequippedLocal()

&#9;swingWithOut:remove()
&#9;swingJump:remove()
&#9;swordThrust:remove()

end

Tool.Equipped:connect(onEquippedLocal)
Tool.Unequipped:connect(onUnequippedLocal)
