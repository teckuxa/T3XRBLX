			<Item class="Script" referent="RBX1557">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Main</string>
					<ProtectedString name="Source">local _items = {} 

local door = -1 
--&#9;&#9;&#9;&#9;-1 = Closed
--&#9;&#9;&#9;&#9;0 = Active
--&#9;&#9;&#9;&#9;1 = Open

function getItems() 
&#9;for _,v in pairs(script.Parent:GetChildren()) do 
&#9;&#9;if ((v:IsA(&quot;BasePart&quot;)) and (v.Name == &quot;Bar&quot;)) then 
&#9;&#9;&#9;table.insert(_items,v) 
&#9;&#9;end 
&#9;end 
end 

function main() 
&#9;local d = door 
&#9;door = 0 
&#9;script.Parent.Button.BrickColor = BrickColor.new(&quot;New Yeller&quot;) 
&#9;for i = 0,5,0.05 do 
&#9;&#9;for _,v in pairs(_items) do 
&#9;&#9;&#9;v.CFrame = v.CFrame * CFrame.new(0,0,(0.2*(d))) 
&#9;&#9;end 
&#9;&#9;wait() 
&#9;end 
&#9;if (d == (-1)) then 
&#9;&#9;script.Parent.Button.BrickColor = BrickColor.new(&quot;Really red&quot;) 
&#9;elseif (d == 1) then 
&#9;&#9;script.Parent.Button.BrickColor = BrickColor.new(&quot;Bright green&quot;) 
&#9;end 
&#9;door = d 
end 

script.Parent.Button.Click.MouseClick:connect(function() 
&#9;if (door == 0) then return end 
&#9;door = (door*(-1)) 
&#9;main() 
end) 

getItems() </ProtectedString>
				</Properties>
			</Item>
		</Item>
