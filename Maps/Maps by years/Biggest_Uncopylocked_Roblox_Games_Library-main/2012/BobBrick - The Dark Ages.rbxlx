w2.Name = &quot;BoltWeld&quot; 
w2.Parent = script.Parent.Handle 
w2.Part0 = script.Parent.Handle 
w2.Part1 = script.Parent.Bolt 
w2.C1 = CFrame.new(0,-.35,-1.6)

</ProtectedString>
