						<ProtectedString name="Source">gui = script.Parent.ModelInsertGUI
lawlk = script.Parent
function onButton1Down(mouse)
&#9;mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot;
&#9;model = Game:GetService(&quot;InsertService&quot;):LoadAsset(102493694)
&#9;model.Parent = game.Workspace
&#9;model:MakeJoints()
&#9;model:MoveTo(mouse.hit.p)
&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
lawlk:remove()
end

function onSelected(mouse)
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
&#9;gui.Parent = script.Parent.Parent.Parent.PlayerGui
end

function onDeselected(mouse)
&#9;gui.Parent = script.Parent
end

script.Parent.Deselected:connect(onDeselected)
script.Parent.Selected:connect(onSelected)</ProtectedString>
