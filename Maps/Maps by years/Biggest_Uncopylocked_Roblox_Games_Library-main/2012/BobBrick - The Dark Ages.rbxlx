				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">TimedRegen</string>
				<ProtectedString name="Source">-- Made by: supercolbob999
-- Anywhere you see MODELNAME, replace it with your models name that you want to regenerate

model = game.Workspace.bridgethatfliesoffhinges -- Your model name here! It has to be EXACTLY what the name of the model is
--messageText = &quot;Regenerating Pyramid Tip&quot; -- What the message will say when its Regening

--message = Instance.new(&quot;Message&quot;)
--message.Text = messageText
backup = model:clone()

while true do
&#9;wait(300) -- How long it will take for the Model to Regenerate

&#9;--message.Parent = game.Workspace
&#9;model:Remove()

&#9;wait(3) -- How long the message above will be displayed
&#9;
&#9;model = backup:clone()
&#9;model.Parent = game.Workspace
&#9;model:makeJoints()
&#9;--message.Parent = nil
end

--Made By: supercolbob999 DO NOT Take Any Credit For This! Because i hate noobs Who Get A Script Of Free Models And Say They Made It!

--This is also for techdeckman2.He needs help and this regen script will geter done.

</ProtectedString>
