		<Item class="Script" referent="RBX1546">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Choosen Gear Remover</string>
				<ProtectedString name="Source">while true do
wait (5)
non_Allowed_Gear = {&quot;Hard Breaker&quot;, &quot;WindSword&quot;, &quot;Police Baton&quot;,&quot;ShoulderCannon&quot;,&quot;SpikePotion&quot;,&quot;StoneStaff&quot;} --Put the names of gear you wish to disallow in here.
function onPlayerEntered(player)
&#9;if player:findFirstChild(&quot;StarterGear&quot;) == nil or player:findFirstChild(&quot;Backpack&quot;) == nil then
&#9;&#9;while true do
&#9;&#9;&#9;wait(1)
&#9;&#9;&#9;if player:findFirstChild(&quot;StarterGear&quot;) ~= nil and player:findFirstChild(&quot;Backpack&quot;) ~= nil then
&#9;&#9;&#9;&#9;break
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;local starterGear = player.StarterGear
&#9;starterGear.ChildAdded:connect(function() checkGear(player) end)
&#9;player.Backpack.ChildAdded:connect(function() checkGear(player) end)
&#9;checkGear(starterGear)
end

game.Players.PlayerAdded:connect(onPlayerEntered)






function checkGear(bin)
&#9;function isBad(name)
&#9;&#9;for i,child in pairs(non_Allowed_Gear) do
&#9;&#9;&#9;if string.lower(child) == string.lower(name) then
&#9;&#9;&#9;&#9;return true
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;return false
&#9;end
&#9;for i,item in pairs(bin.StarterGear:getChildren()) do
&#9;&#9;if isBad(item.Name) then
&#9;&#9;&#9;item:remove()
&#9;&#9;end
&#9;end
&#9;for i,item in pairs(bin.Backpack:getChildren()) do
&#9;&#9;if isBad(item.Name) then
&#9;&#9;&#9;item:remove()
&#9;&#9;end
&#9;end
&#9;for i,item in pairs(bin.Character:getChildren()) do
&#9;&#9;if isBad(item.Name) and item.className == &quot;Tool&quot; then
&#9;&#9;&#9;item:remove()
&#9;&#9;end
&#9;end
end
end </ProtectedString>
			</Properties>
		</Item>
