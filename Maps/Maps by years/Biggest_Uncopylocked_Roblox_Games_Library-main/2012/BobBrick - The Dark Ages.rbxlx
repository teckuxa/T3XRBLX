							<ProtectedString name="Source">function onClick(mouse)--DO NOT CHANGE
&#9;if script.Parent.Parent.Parent.Frame1.Visible == false  then--Check
&#9;&#9;script.Parent.Parent.Parent.Frame1.Visible = true --visible
                script.Parent.BackgroundColor = BrickColor.new(&quot;Bright red&quot;)--Color if that label is opened
&#9;&#9;script.Parent.Text = &quot;Close&quot;--Text if that label is opened
&#9;else--Check not needed
&#9;&#9;script.Parent.Parent.Parent.Frame1.Visible = false--visible
                script.Parent.BackgroundColor = BrickColor.new(&quot;Bright green&quot;)--Color if that label is Closed
&#9;&#9;script.Parent.Text = &quot;Open&quot;--Text if that label is closed
       &#9;end
end
script.Parent.MouseButton1Click:connect(onClick)--DO NOT CHANGE

