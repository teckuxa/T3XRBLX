										<bool name="Disabled">false</bool>
										<Content name="LinkedSource"><null></null></Content>
										<string name="Name">Script</string>
										<ProtectedString name="Source">clockin = true

script.Parent.st.MouseButton1Click:connect(function()
workspace.Quarter.Value = &quot;1st&quot;
end
)

script.Parent.nd.MouseButton1Click:connect(function()
workspace.Quarter.Value = &quot;2nd&quot;
end
)

script.Parent.rd.MouseButton1Click:connect(function()
workspace.Quarter.Value = &quot;3rd&quot;
end
)

script.Parent.th.MouseButton1Click:connect(function()
workspace.Quarter.Value = &quot;4th&quot;
end
)

script.Parent.C.MouseButton1Click:connect(function()
for i, v in pairs(script.Parent:GetChildren()) do
if v.className == &quot;TextButton&quot; then
v.Visible = false
script.Parent.Open.Visible = true
end
end
end
)

script.Parent.AwayA.MouseButton1Click:connect(function()
workspace.AwayS.Value = workspace.AwayS.Value + 1
end
)

script.Parent.HomeA.MouseButton1Click:connect(function()
workspace.HomeS.Value = workspace.HomeS.Value + 1
end
)

script.Parent.AwayS.MouseButton1Click:connect(function()
workspace.AwayS.Value = workspace.AwayS.Value - 1
end
)

script.Parent.HomeS.MouseButton1Click:connect(function()
workspace.HomeS.Value = workspace.HomeS.Value - 1
end
)

script.Parent.StartTime.MouseButton1Click:connect(function()
if not workspace.Clock.IsRunning.Value then
workspace.Clock.IsRunning.Value = true
while workspace.Clock.IsRunning.Value do
if workspace.Clock.Value &gt; 0 then
workspace.Clock.Value = workspace.Clock.Value - 1
else workspace.Clock.IsRunning.Value = false
end
wait(1)
end
end
end
)

script.Parent.StopTime.MouseButton1Click:connect(function()
workspace.Clock.IsRunning.Value=false
end
)

script.Parent.reset.MouseButton1Click:connect(function()
workspace.Clock.Value = 300
end
)

script.Parent.Open.MouseButton1Click:connect(function()
for i, v in pairs(script.Parent:GetChildren()) do
if v:IsA(&quot;TextButton&quot;) then
v.Visible = true
script.Parent.Open.Visible = false
end
end
end
)
</ProtectedString>
