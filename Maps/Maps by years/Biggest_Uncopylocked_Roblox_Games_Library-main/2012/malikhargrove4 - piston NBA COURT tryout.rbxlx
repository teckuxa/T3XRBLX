game.lighting.Sky.SkyboxUp = &quot;rbxasset://Sky/null_plainsky512_up.jpg&quot;
game.Lighting.TimeOfDay = &quot;18:00:00&quot; --Time of Day
end
Epic.MouseClick:connect(onClick)
</ProtectedString>
