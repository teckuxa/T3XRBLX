											<string name="Name">prgm</string>
											<ProtectedString name="Source">local scorers={&quot;NbaBuilder&quot;,&quot;BlazingInferno2000&quot;};
local homeTeam = &quot;Golden State&quot;;
local teamToggle = true; -- true =&gt; home, false =&gt; away
local teamScores={0, 0}

wait(2.5)

script.Parent.homePanel.teamLabel.Text = homeTeam;

function check(n)
&#9;for i, v in pairs(scorers) do
&#9;&#9;if v:lower() == n then
&#9;&#9;&#9;return true
&#9;&#9;end
&#9;end
&#9;return false
end
function updateScoreboard()
&#9;script.Parent.awayPanel.teamScore.Text = string.format(&quot;%02d&quot;, workspace.ScoreReplicate.UPDATE.away.Value)
&#9;script.Parent.homePanel.teamScore.Text = string.format(&quot;%02d&quot;, workspace.ScoreReplicate.UPDATE.home.Value)
end
function sendScores(h, a)
&#9;workspace.ScoreReplicate.UPDATE.home.Value = teamScores[1];
&#9;workspace.ScoreReplicate.UPDATE.away.Value = teamScores[2];
&#9;workspace.ScoreReplicate.UPDATE.Value = not workspace.ScoreReplicate.UPDATE.Value
end
function changeScore(tm, n)
&#9;teamScores[tm and 1 or 2] = teamScores[tm and 1 or 2] + n;
end
function toggleTeam()
&#9;for i, v in pairs(script.Parent.ctrlPanel:children()) do
&#9;&#9;v.checkbox.Text = teamToggle and &quot;A&quot; or &quot;H&quot;
&#9;end
&#9;teamToggle = not teamToggle;
end

for i, v in pairs(script.Parent.ctrlPanel:children()) do
&#9;if check(game.Players.LocalPlayer.Name:lower()) then
&#9;&#9;v.MouseButton1Click:connect(function()
&#9;&#9;&#9;changeScore(teamToggle, v.pointValue.Value)
&#9;&#9;&#9;sendScores(teamScores[1], teamScores[2])
&#9;&#9;end)
&#9;&#9;v.checkbox.MouseButton1Click:connect(toggleTeam)
&#9;else
&#9;&#9;v.BackgroundColor3 = Color3.new(0.8, 0.8, 0.8);
&#9;&#9;v.btnLbl.TextColor3 = Color3.new(0.5, 0.5, 0.5);
&#9;&#9;v.checkbox.TextColor3 = Color3.new(0.5, 0.5, 0.5);
&#9;end
end

local out=true;
script.Parent.retractButton.MouseButton1Click:connect(function()
&#9;script.Parent.Parent:TweenPosition(UDim2.new(0.5, -203, 0, out == true and -126 or 10))
&#9;script.Parent.retractButton.Text = out and &quot;Show&quot; or &quot;Hide&quot;
&#9;out=not out
end)

local updateCheck=workspace.ScoreReplicate.UPDATE;
updateCheck.Changed:connect(updateScoreboard)</ProtectedString>
