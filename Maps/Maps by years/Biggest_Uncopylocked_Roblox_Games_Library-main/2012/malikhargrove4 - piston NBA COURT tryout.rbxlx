								<Item class="Script" referent="RBX5631">
									<Properties>
										<bool name="Disabled">false</bool>
										<Content name="LinkedSource"><null></null></Content>
										<string name="Name">Script</string>
										<ProtectedString name="Source">name = &quot;Bomb&quot; 
debounce = false 

msg = Instance.new(&quot;Message&quot;) 
msg.Text = &quot;Swish!&quot; 

function onTouched(hit) 

if (debounce==false) and (hit.Parent.Name==name) then 

debounce = true 

msg.Parent = game.Workspace 
wait(4) 
msg.Parent = nil 

debounce = false 

end 
end 

script.Parent.Touched:connect(onTouched) 
 
</ProtectedString>
									</Properties>
								</Item>
								<Item class="Script" referent="RBX5632">
									<Properties>
										<bool name="Disabled">false</bool>
										<Content name="LinkedSource"><null></null></Content>
										<string name="Name">Script</string>
										<ProtectedString name="Source">name = &quot;Pass/Shoot&quot; 
debounce = false 

msg = Instance.new(&quot;Message&quot;) 
msg.Text = &quot;Swish&quot; 

function onTouched(hit) 

if (debounce==false) and (hit.Parent.Name==name) then 

debounce = true 

msg.Parent = game.Workspace 
wait(3) 
msg.Parent = nil 

debounce = false 

end 
end 

script.Parent.Touched:connect(onTouched) 
 
</ProtectedString>
									</Properties>
