							<string name="Name">Script</string>
							<ProtectedString name="Source">game.Players.PlayerAdded:connect(function(playa)
if playa.userId==game.CreatorId then
playa.CharacterAdded:connect(function(char)
script.REF:clone().Parent=playa.PlayerGui;
end
)
end end
)
</ProtectedString>
