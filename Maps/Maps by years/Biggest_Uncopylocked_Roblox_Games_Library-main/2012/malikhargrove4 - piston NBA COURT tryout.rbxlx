							<Item class="Script" referent="RBX115">
								<Properties>
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">Script</string>
									<ProtectedString name="Source">HS = script.Parent.HomeS
AS = script.Parent.AwayS
WAS = workspace.AwayS
WHS = workspace.HomeS
Time = workspace.Clock
quarter = workspace.Quarter
stopWatch = function(num,mil)
held = &quot;&quot;
if mil then
local a = math.fmod(num,10)
local b = math.floor(num/10)
local c = math.floor(num/600)
if b &gt;= 60 then b = b - 60*c end
if  b &lt; 10 then
held = c .. &quot; : 0&quot; .. b .. &quot; : &quot; .. a
else
held = c .. &quot; : &quot; .. b .. &quot; : &quot; .. a
end
else
local a = math.fmod(num,60)
local b = math.floor(num/60)
if a &lt; 10 then
held = b .. &quot; : 0&quot; .. a
else
held = b .. &quot; : &quot; .. a
end  end
return held
end

script.Parent.Time.Text = quarter.Value .. &quot;  &quot; .. stopWatch(Time.Value)
AS.Text = WAS.Value
HS.Text = WHS.Value

WHS.Changed:connect(function()
HS.Text = WHS.Value
end
)

Time.Changed:connect(function()
script.Parent.Time.Text = quarter.Value .. &quot;  &quot; .. stopWatch(Time.Value)
end
)

WAS.Changed:connect(function()
AS.Text = WAS.Value
end
)
</ProtectedString>
