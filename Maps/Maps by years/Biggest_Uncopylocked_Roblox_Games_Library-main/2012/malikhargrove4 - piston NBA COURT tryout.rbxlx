												<ProtectedString name="Source">local Epic=script.Parent.ClickDetector
function onClick()
game.lighting.Sky.SkyboxBk = &quot;rbxasset://Sky/null_plainsky512_bk.jpg&quot;
game.lighting.Sky.SkyboxDn = &quot;rbxasset://Sky/null_plainsky512_dn.jpg&quot;
