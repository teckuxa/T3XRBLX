												<string name="Name">RadioScript</string>
												<ProtectedString name="Source">local isOn = false

function on()
&#9;isOn = true
&#9;script.Parent.Loop:Stop()
end

function off()
&#9;isOn = false
&#9;script.Parent.Loop:Play()
end

function onClicked()
&#9;
&#9;if isOn == true then off() else on() end

end

script.Parent.Parent.ClickDetector.MouseClick:connect(onClicked)

on()</ProtectedString>
