												<ProtectedString name="Source">local Epic=script.Parent.ClickDetector
function onClick()
game.lighting.Sky.SkyboxBk = &quot;http://www.roblox.com/asset/?version=1&amp;id=1013852&quot;
game.lighting.Sky.SkyboxDn = &quot;http://www.roblox.com/asset/?version=1&amp;id=1013853&quot;
game.lighting.Sky.SkyboxFt = &quot;http://www.roblox.com/asset/?version=1&amp;id=1013850&quot;
game.lighting.Sky.SkyboxLf = &quot;http://www.roblox.com/asset/?version=1&amp;id=1013851&quot;
game.lighting.Sky.SkyboxRt = &quot;http://www.roblox.com/asset/?version=1&amp;id=1013849&quot;
game.lighting.Sky.SkyboxUp = &quot;http://www.roblox.com/asset/?version=1&amp;id=1013854&quot;
game.Lighting.TimeOfDay = &quot;15:00:00&quot; --Time of Day
end
Epic.MouseClick:connect(onClick)
</ProtectedString>
