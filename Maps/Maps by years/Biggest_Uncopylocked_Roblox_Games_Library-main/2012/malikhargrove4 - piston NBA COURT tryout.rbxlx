								<string name="Name">Script</string>
								<ProtectedString name="Source">local isOn = true 

function on()
&#9;isOn = true
&#9;script.Parent.Water.Transparency = 0
&#9;script.Parent.Water.BrickColor = BrickColor.new(&quot;Bright blue&quot;)
&#9;script.Parent.Water.Smoke.Enabled = true

end

function off()
&#9;isOn = false
&#9;script.Parent.Water.Transparency = 1
&#9;script.Parent.Water.BrickColor = BrickColor.new(&quot;Bright blue&quot;)
&#9;script.Parent.Water.Smoke.Enabled = false

end

function onClicked()
&#9;
&#9;if isOn == true then off() else on() end

end

script.Parent.HOT.ClickDetector.MouseClick:connect(onClicked)
script.Parent.COLD.ClickDetector.MouseClick:connect(onClicked)

off()</ProtectedString>
