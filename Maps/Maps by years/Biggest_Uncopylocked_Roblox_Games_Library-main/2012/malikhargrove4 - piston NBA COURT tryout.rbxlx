									<ProtectedString name="Source">script.Parent.ChildAdded:connect(function(weld)
&#9;if weld:IsA(&quot;JointInstance&quot;) and weld ~= nil then
&#9;&#9;weld.C0 = weld.C0 - Vector3.new(0, 1, 0)
&#9;&#9;pcall(function()
&#9;&#9;&#9;humanoid = weld.Part1.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;&#9;&#9;player = game.Players:GetPlayerFromCharacter(humanoid.Parent)
&#9;&#9;&#9;Figure = humanoid.Parent
&#9;&#9;&#9;Torso = Figure:findFirstChild(&quot;Torso&quot;)
&#9;&#9;&#9;RightShoulder = Torso:findFirstChild(&quot;Right Shoulder&quot;)
&#9;&#9;&#9;LeftShoulder = Torso:findFirstChild(&quot;Left Shoulder&quot;)
&#9;&#9;&#9;RightHip = Torso:findFirstChild(&quot;Right Hip&quot;)
&#9;&#9;&#9;LeftHip = Torso:findFirstChild(&quot;Left Hip&quot;)
&#9;&#9;&#9;Neck = Torso:findFirstChild(&quot;Neck&quot;)
&#9;&#9;&#9;Script = Figure:findFirstChild(&quot;Animate&quot;)
&#9;&#9;&#9;if Script ~= nil then
&#9;&#9;&#9;&#9;Script.Parent = nil
&#9;&#9;&#9;end
&#9;&#9;&#9;if RightShoulder ~= nil and RightShoulder:IsA(&quot;Motor&quot;) then
&#9;&#9;&#9;&#9;RightShoulder.MaxVelocity = 0.15
&#9;&#9;&#9;&#9;RightShoulder.DesiredAngle = 3.14 / 2
&#9;&#9;&#9;end

&#9;&#9;&#9;if LeftShoulder ~= nil and LeftShoulder:IsA(&quot;Motor&quot;) then
&#9;&#9;&#9;&#9;LeftShoulder.MaxVelocity = 0.15
&#9;&#9;&#9;&#9;LeftShoulder.DesiredAngle = -3.14 /2
&#9;&#9;&#9;end

&#9;&#9;&#9;if RightHip ~= nil and RightHip:IsA(&quot;Motor&quot;) then
&#9;&#9;&#9;&#9;RightHip.DesiredAngle = 3.14 /2
&#9;&#9;&#9;end

&#9;&#9;&#9;if LeftHip ~= nil and LeftHip:IsA(&quot;Motor&quot;) then
&#9;&#9;&#9;&#9;LeftHip.DesiredAngle = -3.14 /2
&#9;&#9;&#9;end
&#9;&#9;end)
&#9;end
end)

script.Parent.ChildRemoved:connect(function(weld)
&#9;if weld:IsA(&quot;JointInstance&quot;) and weld ~= nil then
&#9;&#9;humanoid = weld.Part1.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;&#9;player = game.Players:GetPlayerFromCharacter(humanoid.Parent)
