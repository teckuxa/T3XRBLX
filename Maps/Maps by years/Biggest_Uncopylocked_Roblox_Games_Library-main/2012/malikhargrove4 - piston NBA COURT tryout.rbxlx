									<Item class="Script" referent="RBX5849">
										<Properties>
											<bool name="Disabled">false</bool>
											<Content name="LinkedSource"><null></null></Content>
											<string name="Name">Script</string>
											<ProtectedString name="Source">function Check()
if script.Parent.Power.Value == true then
game.Lighting.Ambient = Color3.new(1,0,0) --Red
wait(0.13)
game.Lighting.Ambient = Color3.new(0,0,1) --Blue
wait(0.13)
game.Lighting.Ambient = Color3.new(0, 1, 0)--Green
wait(0.13)
game.Lighting.Ambient = Color3.new(1.25,.21,.98) ---Pink
wait(0.13)
game.Lighting.Ambient = Color3.new(2.55, 1.02, 0) --Orange
wait(0.13)
game.Lighting.Ambient = Color3.new(1.02,0,1.7) ---Purple
wait(0.13)
game.Lighting.Ambient = Color3.new(1.5, 1.5, 0) --Yellow
wait(0.13)
game.Lighting.Ambient = Color3.new(0.505882,0.505882,0.505882) --Don&apos;t Remove this line, this makes it stop on Normal
wait(0)

end
end


while true do
Check()
wait(0)
end
</ProtectedString>
