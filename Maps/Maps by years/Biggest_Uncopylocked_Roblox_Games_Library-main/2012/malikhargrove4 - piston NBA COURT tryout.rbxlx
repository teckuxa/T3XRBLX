							<Item class="Script" referent="RBX83">
								<Properties>
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">Script</string>
									<ProtectedString name="Source">HS = script.Parent.HomeS
AS = script.Parent.AwayS
WAS = workspace.AwayS
WHS = workspace.HomeS
Time = workspace.Clock
quarter = workspace.Quarter
stopWatch = function(num,mil)
held = &quot;&quot;
if mil then
local a = math.fmod(num,10)
local b = math.floor(num/10)
local c = math.floor(num/600)
if b &gt;= 60 then b = b - 60*c end
if  b &lt; 10 then
held = c .. &quot; : 0&quot; .. b .. &quot; : &quot; .. a
else
held = c .. &quot; : &quot; .. b .. &quot; : &quot; .. a
end
else
local a = math.fmod(num,60)
local b = math.floor(num/60)
if a &lt; 10 then
held = b .. &quot; : 0&quot; .. a
else
held = b .. &quot; : &quot; .. a
end  end
return held
end

