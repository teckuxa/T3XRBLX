							<Item class="Script" referent="RBX3395">
								<Properties>
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">Head Changer</string>
									<ProtectedString name="Source">debouce = false
function onTouched(hit)
if debouce == false then
local h= hit.Parent:findFirstChild(&quot;Humanoid&quot;)
if h~=nil then
debouce = true
wait(0.1)
script.Parent.BrickColor = BrickColor.new(&quot;Medium blue&quot;)
local p=hit.Parent:GetChildren() 
for i=1,#p do 
if p[i].className==&quot;Pants&quot; then 
p[i]:remove() 
end 
end
local pz=hit.Parent:GetChildren() 
for i=1,#pz do 
if pz[i].className==&quot;Shirt&quot; then 
pz[i]:remove() 
end 
end
s=Instance.new(&quot;Pants&quot;)
s.Parent = hit.Parent
s.PantsTemplate = &quot;http://www.roblox.com/asset/?id=26412402&quot;
sa=Instance.new(&quot;Shirt&quot;)
sa.Parent = hit.Parent
sa.ShirtTemplate = &quot;http://www.roblox.com/asset/?id=26412385&quot;
h.MaxHealth = 100
local ph=hit.Parent:GetChildren() 
for i=1,#ph do 
if ph[i].className==&quot;&quot; then 
ph[i]:remove() 
&#9;end 
&#9;&#9;end
wait(2)
script.Parent.BrickColor = BrickColor.new(&quot;Medium blue&quot;)
debouce = false
end
end
end
script.Parent.Touched:connect(onTouched)</ProtectedString>
