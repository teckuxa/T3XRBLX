									<Item class="Script" referent="RBX5962">
										<Properties>
											<bool name="Disabled">false</bool>
											<Content name="LinkedSource"><null></null></Content>
											<string name="Name">Script</string>
											<ProtectedString name="Source">l = game:service(&quot;Lighting&quot;) 
r = game:service(&quot;RunService&quot;)

function Check()
if script.Parent.Power.Value == true then

l:SetMinutesAfterMidnight(l:GetMinutesAfterMidnight()+.08) 
r.Stepped:wait()
end 
end


while true do
Check()
wait(0)
end
</ProtectedString>
