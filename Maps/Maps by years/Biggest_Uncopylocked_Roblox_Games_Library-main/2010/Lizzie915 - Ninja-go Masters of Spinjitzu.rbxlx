						<Item class="LocalScript" referent="RBX1978">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Messages</string>
								<ProtectedString name="Source">wait()
Tool=script.Parent;
MP=Tool.MP
MaximumMP=15
Message=nil
AbilitySet=function()
&#9;init=MP.Value/5
&#9;init=math.floor(init)
&#9;return string.rep(&quot;+&quot;,init)..string.rep(&quot;-&quot;,3-init)
end
MessageUpdate=function()
&#9;Fill=math.floor(MP.Value)
&#9;Remainder=math.floor(MaximumMP-Fill)
&#9;StringFill=string.rep(&quot;|&quot;,Fill)
&#9;StringRemainder=string.rep(&quot;-&quot;,Remainder)
&#9;String=&quot;[&quot;..StringFill..StringRemainder..&quot;][&quot;..AbilitySet()..&quot;]&quot;..&quot;[&quot;..MP:FindFirstChild(Tool.Choice.Value).Value..&quot;(&quot;..Tool.Choice.Value..&quot;)&quot;..&quot;]&quot;..&quot;[Press &apos;c&apos; to change spec. attack|Press &apos;f&apos; to activate spec. attack (if enough MP is present)]&quot;
&#9;Message.Text=String
end
onEquipped=function()
&#9;wait()
&#9;CPlayer=Tool.Parent
&#9;if CPlayer==nil then
&#9;&#9;return
&#9;end
&#9;VPlayer=game.Players:GetPlayerFromCharacter(CPlayer)
&#9;if VPlayer==nil then
&#9;&#9;return
&#9;end
&#9;if Message==nil then
&#9;&#9;Message=Instance.new(&quot;Hint&quot;)
&#9;&#9;Message.Name=Tool.Name..&quot; Hint&quot;
&#9;end
&#9;Message.Parent=VPlayer
&#9;while true do
&#9;&#9;if Tool.Parent[&quot;className&quot;]==[[Backpack]] then
&#9;&#9;&#9;Message.Parent=nil
&#9;&#9;&#9;break
&#9;&#9;end
&#9;&#9;MessageUpdate()
&#9;&#9;wait(.05)
&#9;end
end
Tool.Equipped:connect(onEquipped)</ProtectedString>
							</Properties>
						</Item>
						<Item class="LocalScript" referent="RBX1979">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">_Main</string>
								<ProtectedString name="Source">-- FABULOUS SAYS VOTE FOR OBAMA
Tool=script.Parent;
CPlayer=nil
RightS=nil
FakeS=Instance.new(&quot;Motor&quot;)
FakeS.Name=&quot;Right Shoulder&quot;
G=Instance.new(&quot;Weld&quot;)
Time=0
Type=&quot;Slash&quot;
SlashDamage=25000000000 -- damage on a slash
PowerfulSlashDamage=999999999 -- damage on a more powerful slash
ComboSlashDamage=69999999999 -- generally just used to chain hits and gain MP.
desiredangle=.3
Deb=true
tDeb=true
wEnabled=true
MaxMP=15
hEnabled=true
aMP=true
CanUse=function(c)
&#9;if math.floor(Tool.MP.Value/5)&gt;=c then
&#9;&#9;return true
&#9;end
&#9;return false
end
JumpCon=function(W)&#9;
&#9;wEnabled=false
&#9;W.DesiredAngle=3.1
&#9;W.MaxVelocity=.3
&#9;wait(1)
&#9;W.DesiredAngle=1.6
&#9;wait(.5)
&#9;W.MaxVelocity=.15
&#9;wEnabled=true
end
Damage=function(hit,Bonus)
&#9;if hit.Parent==nil then
&#9;&#9;return
&#9;end
&#9;if not hEnabled then return end
&#9;h=hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
&#9;if h~=nil and hit.Parent~=Tool.Parent then
&#9;&#9;hEnabled=false
&#9;&#9;if Type==&quot;Slash&quot; then
&#9;&#9;&#9;h:TakeDamage(SlashDamage+Bonus)
&#9;&#9;elseif Type==&quot;PowerfulSlash&quot; then
&#9;&#9;&#9;h:TakeDamage(PowerfulSlashDamage+Bonus)
&#9;&#9;elseif string.match(Type,&quot;ComboSlash&quot;)==&quot;ComboSlash&quot; then
&#9;&#9;&#9;h:TakeDamage(ComboSlashDamage+Bonus)
&#9;&#9;end
&#9;&#9;if Tool.MP.Value&lt;MaxMP and aMP==true then
&#9;&#9;&#9;Tool.MP.Value=Tool.MP.Value+.5
&#9;&#9;end
&#9;&#9;if h.Health&lt;1 and h:FindFirstChild(&quot;creator&quot;)==nil then
&#9;&#9;&#9;c=Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;&#9;c.Name=&quot;creator&quot;
&#9;&#9;&#9;c.Value=game.Players:GetPlayerFromCharacter(Tool.Parent)
&#9;&#9;&#9;c.Parent=h
&#9;&#9;&#9;game:GetService(&quot;Debris&quot;):AddItem(c,.5)
&#9;&#9;end
&#9;&#9;wait()
&#9;&#9;hEnabled=true
&#9;end
end
Animation=function(T,C)
&#9;if C==&quot;Stop&quot; then
&#9;&#9;RightS=T:FindFirstChild(&quot;Right Shoulder&quot;)
&#9;&#9;if RightS==nil then
&#9;&#9;&#9;return
&#9;&#9;end
&#9;&#9;RightS.Parent=nil
&#9;&#9;FakeS.Part0=T
&#9;&#9;FakeS.C0=RightS.C0
&#9;&#9;FakeS.C1=RightS.C1&#9;
&#9;&#9;FakeS.Part1=T.Parent[&quot;Right Arm&quot;]
&#9;&#9;FakeS.Parent=T
&#9;&#9;FakeS.DesiredAngle=1.6
&#9;&#9;FakeS.MaxVelocity=.15
&#9;&#9;G.Part0=T.Parent[&quot;Right Arm&quot;]
&#9;elseif C==&quot;Resume&quot; then
&#9;&#9;FakeS.Parent=nil
&#9;&#9;RightS.Parent=T
&#9;end
end
Reset=function(Weld)
&#9;Weld.DesiredAngle=1.6
&#9;Weld.MaxVelocity=.15
end
Timing=function(trigger)
&#9;if time()-Time&lt;trigger then
&#9;&#9;return true
&#9;end
&#9;return false
end
cf=true
Flip=function()
&#9;if cf==false then
&#9;&#9;return
&#9;end
&#9;cf=false
&#9;gy=Instance.new(&quot;BodyGyro&quot;)
&#9;gy.D=gy.D/2
&#9;gy.P=gy.P*2
&#9;gy.maxTorque=Vector3.new(math.huge,math.huge,math.huge)
&#9;gy.cframe=Tool.Parent.Torso.CFrame
&#9;gy.Parent=Tool.Parent.Torso
&#9;v=Instance.new(&quot;BodyVelocity&quot;)
&#9;v.maxForce=Vector3.new(math.huge,math.huge,math.huge)
&#9;v.velocity=Tool.Parent.Torso.Velocity/5+Vector3.new(0,20,0)
&#9;v.Parent=Tool.Parent.Torso
&#9;for i=1, 16 do
&#9;&#9;gy.cframe=gy.cframe*CFrame.fromEulerAnglesXYZ(math.pi/8,0,0)
&#9;&#9;wait()
&#9;end
&#9;v.Parent=nil
&#9;wait(2.5)
&#9;gy.Parent=nil
&#9;cf=true
end
SpecPause=function(de)
&#9;Torsos={}
&#9;e=Instance.new(&quot;Part&quot;)
&#9;e.Transparency=.5
&#9;e.Reflectance=.4
&#9;e.Name=&quot;Emanate&quot;
&#9;e.TopSurface=0
&#9;e.BottomSurface=0
&#9;e.Shape=0
&#9;e.Size=Vector3.new(45,45,45)
&#9;e.Anchored=true
&#9;e.CanCollide=false
&#9;e.BrickColor=Tool.Parent.Torso.BrickColor
&#9;e.CFrame=Tool.Parent.Torso.CFrame
&#9;if de==true then
&#9;&#9;e.Parent=Tool.Parent
&#9;end
&#9;for i=1, 20 do
&#9;&#9;game.Lighting.Ambient=Color3.new(game.Lighting.Ambient.r/1.05,game.Lighting.Ambient.g/1.05,game.Lighting.Ambient.b/1.05)
&#9;&#9;e.Size=e.Size-Vector3.new(2,2,2)
&#9;&#9;e.Transparency=e.Transparency+.025
&#9;&#9;e.CFrame=Tool.Parent.Torso.CFrame
&#9;&#9;wait()
&#9;end
&#9;e.Parent=nil
&#9;coroutine.resume(coroutine.create(function()
&#9;&#9;for i=1, 20 do
&#9;&#9;&#9;game.Lighting.Ambient=Color3.new(game.Lighting.Ambient.r*1.05,game.Lighting.Ambient.g*1.05,game.Lighting.Ambient.b*1.05)
&#9;&#9;&#9;wait()
&#9;&#9;end&#9;&#9;
&#9;end))
end
SlashAnim=function(Weld,TypeS,EndCMD,TimeW)
&#9;wEnabled=false
&#9;conmain=nil
&#9;if TypeS==1 then
&#9;&#9;Tool.Handle.Slash:Play()
&#9;&#9;Weld.MaxVelocity=.3
&#9;&#9;Type=&quot;Slash&quot;
&#9;&#9;conmain=Tool[&quot;Blade&quot;].Touched:connect(function(hit) Damage(hit,0) end)
&#9;&#9;Weld.DesiredAngle=2
&#9;&#9;wait(.15)
&#9;&#9;Weld.DesiredAngle=.2
&#9;&#9;wait(.25)
&#9;elseif TypeS==2 then
&#9;&#9;Tool.Handle.Slash:Play()
&#9;&#9;Weld.C0=Weld.C0*CFrame.fromEulerAnglesXYZ(-math.pi/2,0,0)+Vector3.new(.25,-.5,0)
&#9;&#9;Weld.MaxVelocity=.2
&#9;&#9;Weld.CurrentAngle=2
&#9;&#9;Weld.DesiredAngle=-.5
&#9;&#9;Type=&quot;PowerfulSlash&quot;
&#9;&#9;conmain=Tool[&quot;Blade&quot;].Touched:connect(function(hit) Damage(hit,0) end)
&#9;&#9;v=Instance.new(&quot;BodyVelocity&quot;)
&#9;&#9;v.P=2000
&#9;&#9;v.maxForce=Vector3.new(math.huge,0,math.huge)
&#9;&#9;v.velocity=Tool.Parent.Torso.CFrame.lookVector*2.5
&#9;&#9;v.Parent=Tool.Parent.Torso
&#9;&#9;game:GetService(&quot;Debris&quot;):AddItem(v,.25)
&#9;&#9;wait(.5)
&#9;&#9;Weld.C0=RightS.C0
&#9;elseif TypeS==3 then
&#9;&#9;Tool.Handle.Slash:Play()
&#9;&#9;Tool.GripRight=Vector3.new(-1,0,0)
&#9;&#9;Weld.C0=Weld.C0*CFrame.fromEulerAnglesXYZ(-math.pi/2,0,0)+Vector3.new(.25,-.5,0)
&#9;&#9;Weld.MaxVelocity=.2
&#9;&#9;Weld.CurrentAngle=-1.4
&#9;&#9;Weld.DesiredAngle=2
&#9;&#9;Type=&quot;PowerfulSlash&quot;
&#9;&#9;conmain=Tool[&quot;Blade&quot;].Touched:connect(function(hit) Damage(hit,0) end)
&#9;&#9;v=Instance.new(&quot;BodyVelocity&quot;)
&#9;&#9;v.P=2000
&#9;&#9;v.maxForce=Vector3.new(math.huge,0,math.huge)
&#9;&#9;v.velocity=Tool.Parent.Torso.CFrame.lookVector*2.5
&#9;&#9;v.Parent=Tool.Parent.Torso
&#9;&#9;game:GetService(&quot;Debris&quot;):AddItem(v,.25)
&#9;&#9;wait(.5)
&#9;&#9;Tool.GripRight=Vector3.new(1,0,0)
&#9;&#9;Weld.C0=RightS.C0
&#9;elseif TypeS==4 then
&#9;&#9;wait(.2)
&#9;&#9;Tool.Handle.Slash:Play()
&#9;&#9;Weld.MaxVelocity=.3
&#9;&#9;Type=&quot;Slash&quot;
&#9;&#9;conmain=Tool[&quot;Blade&quot;].Touched:connect(function(hit) Damage(hit,0) end)
&#9;&#9;Weld.CurrentAngle=1.6
&#9;&#9;Weld.DesiredAngle=.4
&#9;&#9;wait(.3)
&#9;elseif TypeS==5 then
&#9;&#9;Tool.Handle.Slash:Play()
