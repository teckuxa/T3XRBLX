								<ProtectedString name="Source">function onTouched(hit)
&#9;if hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil and hit.Parent:findFirstChild(&quot;Leg2&quot;) == nil then
&#9;&#9;local g = script.Parent.Parent.Leg2:clone()
