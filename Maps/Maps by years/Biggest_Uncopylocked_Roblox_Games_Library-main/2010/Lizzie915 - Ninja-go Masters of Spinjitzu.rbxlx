					<string name="Name">Script</string>
					<ProtectedString name="Source">--Fully Functional Dance Tool by Kn276--
function dance()

local me = script.Parent.Parent.Parent.Character.Torso

local RightShoulder = me[&quot;Right Shoulder&quot;]
local LeftShoulder = me[&quot;Left Shoulder&quot;]
local RightHip = me[&quot;Right Hip&quot;]
local LeftHip = me[&quot;Left Hip&quot;]


for i=1, 9 do 

&#9;for i=1, 15 do

RightShoulder.MaxVelocity = 35
LeftShoulder.MaxVelocity = 35


RightShoulder.DesiredAngle = -0
&#9;LeftShoulder.DesiredAngle = 0
&#9;RightHip.DesiredAngle = 0
&#9;LeftHip.DesiredAngle = 0
&#9;wait(0)
end
&#9;for i=1, 14 do

RightShoulder.MaxVelocity = 0.35
LeftShoulder.MaxVelocity = 0.35

RightShoulder.DesiredAngle = 0
&#9;LeftShoulder.DesiredAngle = 0
&#9;RightHip.DesiredAngle = 0
&#9;LeftHip.DesiredAngle = 0

wait(0) end


RightShoulder.MaxVelocity = 0.35
LeftShoulder.MaxVelocity = 0.35
end


end

function go(mouse)

mouse.Button1Down:connect(function() dance() end)

end

script.Parent.Selected:connect(go)
