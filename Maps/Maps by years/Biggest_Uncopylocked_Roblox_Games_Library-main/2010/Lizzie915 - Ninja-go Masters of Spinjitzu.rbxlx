									<string name="Name">HatRemover</string>
									<ProtectedString name="Source">function onTouched(hit) 
&#9;local d = hit.Parent:GetChildren() 
&#9;for i=1, #d do 
&#9;&#9;if (d[i].className == &quot;Hat&quot;) then 
&#9;&#9;&#9;d[i]:remove() 
&#9;&#9;end 
&#9;end
end 

