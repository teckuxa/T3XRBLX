Swing=function()
&#9;if CPlayer==nil then
&#9;&#9;return
&#9;end
&#9;Torso=CPlayer:FindFirstChild(&quot;Torso&quot;)
&#9;if Torso==nil then
&#9;&#9;return
&#9;end
&#9;if not Deb then return end
&#9;Deb=false
&#9;Sh=Torso[&quot;Right Shoulder&quot;]
&#9;if Type==&quot;Slash&quot; and Timing(.2)==false then
&#9;&#9;SlashAnim(Sh,1,&quot;Nothing&quot;)
&#9;&#9;if Type~=&quot;PowerfulSlash&quot; then&#9;
&#9;&#9;wait(.2)
&#9;&#9;&#9;Reset(Sh)
&#9;&#9;end
&#9;&#9;Time=time()
&#9;elseif Type==&quot;Slash&quot; and Timing(.4)==true then
&#9;&#9;SlashAnim(Sh,2,&quot;Reset&quot;)
&#9;&#9;Time=time()
&#9;&#9;coroutine.resume(coroutine.create(function() while true do if Timing(1)==false then break end wait() end Type=&quot;Slash&quot; end))
&#9;elseif Type==&quot;PowerfulSlash&quot; and Timing(.4)==true then
&#9;&#9;SlashAnim(Sh,3,&quot;Reset&quot;)
&#9;&#9;Time=time()
&#9;&#9;Type=&quot;ComboSlash&quot;
&#9;&#9;coroutine.resume(coroutine.create(function() while true do if Timing(1)==false then break end wait() end Type=&quot;Slash&quot; end))
&#9;elseif Type==&quot;ComboSlash&quot; and Timing(.4)==true then
&#9;&#9;SlashAnim(Sh,4,&quot;Reset&quot;)
&#9;&#9;Time=time()
&#9;&#9;coroutine.resume(coroutine.create(function() while true do if Timing(.4)==false then break end wait() end Type=&quot;Slash&quot; end))
&#9;&#9;Type=&quot;ComboSlash2&quot;
&#9;elseif Type==&quot;ComboSlash2&quot; and Timing(.2)==true then
&#9;&#9;SlashAnim(Sh,5,&quot;Reset&quot;)
&#9;&#9;while true do
&#9;&#9;&#9;if Timing(.4)==false then
&#9;&#9;&#9;&#9;Type=&quot;Slash&quot;
&#9;&#9;&#9;&#9;break
&#9;&#9;&#9;end
&#9;&#9;&#9;wait()
&#9;&#9;end
&#9;end
&#9;Deb=true
end
EquipDebounce=true
ButtonDown=function(key)
&#9;if CPlayer==nil then
&#9;&#9;return
&#9;end
&#9;Torso=CPlayer:FindFirstChild(&quot;Torso&quot;)
&#9;if Torso==nil then
&#9;&#9;return
&#9;end
&#9;Sh=Torso[&quot;Right Shoulder&quot;]
&#9;if not Deb then return end
&#9;if key==&quot;f&quot; then
&#9;&#9;Deb=false
&#9;&#9;aMP=false
&#9;&#9;SlashAnim(Sh,&quot;Spec&quot;,&quot;Reset&quot;)
&#9;&#9;aMP=true
&#9;&#9;Deb=true
&#9;end
&#9;if key==&quot;c&quot; then
&#9;&#9;if Tool.Choice.Value&lt;3 then
&#9;&#9;&#9;Tool.Choice.Value=Tool.Choice.Value+1
&#9;&#9;else
&#9;&#9;&#9;Tool.Choice.Value=1
&#9;&#9;end
&#9;end
end
onEquippedLocal=function(mouse)
&#9;mouse.KeyDown:connect(ButtonDown)
end
onEquipped=function(mouse)
&#9;if not EquipDebounce then
&#9;&#9;return
&#9;end
&#9;EquipDebounce=false
&#9;CPlayer=Tool.Parent
&#9;Animation(CPlayer[&quot;Torso&quot;],&quot;Stop&quot;)
&#9;jCon=CPlayer.Humanoid.Jumping:connect(function() JumpCon(FakeS) end)
&#9;wEnabled=true
&#9;for i,v in pairs(Tool.Handle:children()) do
&#9;&#9;if v.className==&quot;Sound&quot; then
&#9;&#9;&#9;v:Stop()&#9;
&#9;&#9;end
&#9;end
end
onPutAway=function()
&#9;if CPlayer==nil then
&#9;&#9;return
&#9;end
&#9;EquipDebounce=true
&#9;Animation(CPlayer[&quot;Torso&quot;],&quot;Resume&quot;)
&#9;jCon:disconnect()
&#9;for i,v in pairs(Tool.Handle:children()) do
&#9;&#9;if v.className==&quot;Sound&quot; then
&#9;&#9;&#9;v:Stop()&#9;
&#9;&#9;end
&#9;end
end
Tool.Activated:connect(Swing)
Tool.Unequipped:connect(onPutAway)
Tool.Equipped:connect(onEquipped)
Tool.Equipped:connect(onEquippedLocal)
Trail=function()
&#9;bl=Tool.Blade:clone()
&#9;bl.Anchored=true
&#9;bl.Parent=Tool
&#9;coroutine.resume(coroutine.create(function(part) for ii=1, 27 do part.Transparency=ii*(1/27) wait() end part.Parent=nil end),bl)
end
while true do
&#9;if type(conmain)==&quot;userdata&quot; then
&#9;&#9;Trail()
&#9;end
&#9;wait()
end
