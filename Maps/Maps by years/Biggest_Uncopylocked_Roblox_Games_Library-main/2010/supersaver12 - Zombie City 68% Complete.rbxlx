wait(.05)
weld33.C1 = CFrame.new(-0.75, 0.25, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-70), math.rad(-7), math.rad(-0))
wait(.05)
weld33.C1 = CFrame.new(-0.75, 0.25, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-80), math.rad(-7), math.rad(-0))
wait(.05)
weld33.C1 = CFrame.new(-0.75, 0.25, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-7), math.rad(-0))

end

function ShellInsert()
weld55.C1 = CFrame.new(-0.35, -.3, 0.1) * CFrame.fromEulerAnglesXYZ(math.rad(310), math.rad(-10), math.rad(-90))
wait(.03)
