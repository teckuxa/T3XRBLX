						<Item class="Script" referent="RBX4273">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<ProtectedString name="Source">materials = {&quot;Plastic&quot;, &quot;Wood&quot;, &quot;Slate&quot;, &quot;Concrete&quot;, &quot;Corroded Metal&quot;, &quot;DiamondPlate&quot;, &quot;Aluminum&quot;, &quot;Ice&quot;}
mode = 1

function onButton1Down(mouse)
	down = true
	if mouse.Target ~= nil then 
		if not mouse.Target.Locked then
			changeMaterial(mouse.Target, materials[mode])
		end
	end
end

function onMove(mouse)
	if not down then return end
	if mouse.Target ~= nil then 
		if not mouse.Target.Locked then
			changeMaterial(mouse.Target, materials[mode])
		end
	end
end

function onButton1Up(mouse)
	down = false
end

function changeMaterial(brick, material)
	brick.Material = material
end

function onKeyDown(key)
	if key == nil then return end
	key = key:lower()
	if key == &quot;e&quot; then
		if mode &lt; #materials then
			mode = mode + 1
		else
			mode = 1
		end
		printMessage(&quot;Current material is &quot;..materials[mode]..&quot;.&quot;, 5)
	end
	if key == &quot;q&quot; then
		if mode &gt; 1 then
			mode = mode - 1
		else
			mode = #materials
		end
		printMessage(&quot;Current material is &quot;..materials[mode]..&quot;.&quot;, 5)
	end
end


function printMessage(text, time)
	local msg = Instance.new(&quot;Hint&quot;)
	msg.Parent = game.Players.LocalPlayer
	msg.Text = text
	game:getService(&quot;Debris&quot;):addItem(msg, time)
end
	
db = false
function onSelected(mouse)
	mouse.Icon = &quot;rbxasset://textures/MaterialCursor.png&quot;
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
	mouse.Button1Up:connect(function() onButton1Up(mouse) end)
	mouse.Move:connect(function() onMove(mouse) end)
	mouse.KeyDown:connect(onKeyDown)

	if not db then
		db = true
		printMessage(&quot;Welcome!&quot;, 4)
		wait(4)
		printMessage(&quot;Click on a brick and drag the mouse to change its material to your selected choice.&quot;, 6)
		wait(6)
		printMessage(&quot;Press &apos;q&apos; or &apos;e&apos; to select materials. The brick must be unlocked for you to change it.&quot;, 6)
	end
end

script.Parent.Selected:connect(onSelected)</ProtectedString>
