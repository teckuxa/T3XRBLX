wait(.05)
weld33.C1 = CFrame.new(-0.75, 0.25, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-50), math.rad(-7), math.rad(-0))
wait(.05)
weld33.C1 = CFrame.new(-0.75, 0.25, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-40), math.rad(-7), math.rad(-0))
end

function RaiseGun()
wait(.05)
weld33.C1 = CFrame.new(-0.75, 0.25, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-40), math.rad(-7), math.rad(-0))
wait(.05)
