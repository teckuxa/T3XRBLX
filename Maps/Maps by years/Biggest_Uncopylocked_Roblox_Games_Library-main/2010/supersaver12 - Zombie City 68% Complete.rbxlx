								<ProtectedString name="Source">-- Made by DraketehDark.Dude it is easy to make :P
Tool = script.Parent
Char = Tool.Parent.Parent.Character

function onDeath()

if Tool.Parent == Char then
Tool.Parent = game.Workspace
end
end

