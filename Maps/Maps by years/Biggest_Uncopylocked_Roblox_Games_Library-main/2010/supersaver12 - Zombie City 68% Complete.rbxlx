						<Item class="LocalScript" referent="RBX9076">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">AmmoScript</string>
								<ProtectedString name="Source">Tool = script.Parent 
function equip()
	print(&quot;Equipped&quot;)
	if game.Players.LocalPlayer ~= nil then
		local m = Instance.new(&quot;Hint&quot;)
		m.Parent = game.Players.LocalPlayer
		m.Name = &quot;AmmoStats&quot;
		while m ~= nil do
			wait(0.1)
			m.Text = &quot;Clip: &quot;..script.Clip.Value
		end
	end
end

function unequip()
	print(&quot;Unequipped&quot;)
	if game.Players.LocalPlayer ~= nil then
		print(&quot;localplayer found&quot;)
		local m = game.Players.LocalPlayer:FindFirstChild(&quot;AmmoStats&quot;)
		if m ~= nil then
			m:remove()
		end
	end
end

script.Parent.Equipped:connect(equip)
script.Parent.Unequipped:connect(unequip)
</ProtectedString>
								<bool name="archivable">true</bool>
							</Properties>
							<Item class="IntValue" referent="RBX9077">
								<Properties>
									<string name="Name">Ammo</string>
									<int name="Value">249</int>
									<bool name="archivable">true</bool>
								</Properties>
							</Item>
							<Item class="IntValue" referent="RBX9078">
								<Properties>
									<string name="Name">Clip</string>
									<int name="Value">7</int>
									<bool name="archivable">true</bool>
								</Properties>
								<Item class="Script" referent="RBX9079">
									<Properties>
										<bool name="Disabled">false</bool>
										<Content name="LinkedSource"><null></null></Content>
										<string name="Name">Reload</string>
										<ProtectedString name="Source">print(&quot;Ammo Clip Loaded&quot;)

while true do
	if (script.Parent.Value == 0) and (script.Parent.Parent.Ammo.Value &gt;= 1) then
		Mag = script.Parent.Parent.Parent.Magazine:clone()
		Mag.Parent = game.Debris
		Mag.Position = script.Parent.Parent.Parent.Magazine.Position
		Mag.CanCollide = true
		script.Parent.Parent.Parent.Magazine.Transparency = 1
		wait(1)
		script.Parent.Parent.Parent.Magazine.Transparency = 0
		script.Parent.Value = 10
		script.Parent.Parent.Ammo.Value = script.Parent.Parent.Ammo.Value - 1
	end
	if (script.Parent.Value == 0) and (script.Parent.Parent.Ammo.Value &lt;= 1) then
		Mag = script.Parent.Parent.Parent.Magazine:clone()
		Mag.Parent = game.Debris
		Mag.Position = script.Parent.Parent.Parent.Magazine.Position
		script.Parent.Parent.Parent.Magazine.Transparency = 1
		wait(1)
		script.Parent.Value = script.Parent.Parent.Ammo.Value
		script.Parent.Parent.Ammo.Value = 0
	end
	wait(0)
end
</ProtectedString>
										<bool name="archivable">true</bool>
									</Properties>
								</Item>
							</Item>
						</Item>
						<Item class="Script" referent="RBX9080">
							<Properties>
								<bool name="Disabled">true</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Paintball</string>
								<ProtectedString name="Source">ball = script.Parent
damage = 500



function onTouched(hit)
	local humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;)

	for i=1,8 do
		local s = Instance.new(&quot;Part&quot;)
		s.Shape = 1 -- block
		s.formFactor = 2 -- plate
		s.Size = Vector3.new(1,1,1)
		s.BrickColor = BrickColor.new(26)
		local v = Vector3.new(math.random(-1,1), math.random(0,1), math.random(-1,1))
		s.Velocity = 15 * v
		s.CFrame = CFrame.new(ball.Position + v, v)
		ball.BrickCleanup:clone().Parent = s
		s.BrickCleanup.Disabled = false
		s.Parent = game.Workspace
		explosion = Instance.new(&quot;Explosion&quot;)
	        explosion.Position = ball.Position
		explosion.BlastPressure = 100000
		explosion.BlastRadius = 0.1


	-- find instigator tag
	        local creator = script.Parent:findFirstChild(&quot;creator&quot;)
	        if creator ~= nil then
		        explosion.Hit:connect(function(part, distance)  onPlayerBlownUp(part, distance, creator) end)
	        end

	        explosion.Parent = game.Workspace
	end
	

	if humanoid ~= nil then
		tagHumanoid(humanoid)
		humanoid.Health = humanoid.Health - damage
		wait(1)
		untagHumanoid(humanoid)
	end

	connection:disconnect()
	ball.Parent = nil
end
function tagHumanoid(humanoid)
	-- todo: make tag expire
	local tag = ball:findFirstChild(&quot;creator&quot;)
	if tag ~= nil then
		local new_tag = tag:clone()
		new_tag.Parent = humanoid
	end
end


function untagHumanoid(humanoid)
	if humanoid ~= nil then
		local tag = humanoid:findFirstChild(&quot;creator&quot;)
		if tag ~= nil then
			tag.Parent = nil
		end
	end
end

connection = ball.Touched:connect(onTouched)

wait(4)
ball.Parent = nil</ProtectedString>
								<bool name="archivable">true</bool>
							</Properties>
						</Item>
						<Item class="Script" referent="RBX9081">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">PaintballShooter</string>
								<ProtectedString name="Source">Tool = script.Parent

colors = {26}
function charge()
	wait(0.1)
	Tool.Handle.Charge:play()
	Tool.Charge.Transparency = 1
	Tool.ChargeHandle.Transparency = 1
	Tool.ChargingHandle.Transparency = 0
	Tool.Charging.Transparency = 0
	Tool.ChargingBolt.Transparency = 0
	wait(0.4)	Tool.Charge.Transparency = 0
	Tool.ChargeHandle.Transparency = 0
	Tool.ChargingHandle.Transparency = 1
	Tool.Charging.Transparency = 1
	Tool.ChargingBolt.Transparency = 1
end

function fire(v)
if (script.Parent.AmmoScript.Clip.Value == 0) then 
	Tool.Handle.Sound:play()
	return
	end 
	script.Parent.AmmoScript.Clip.Value = script.Parent.AmmoScript.Clip.Value - 1
	print(Ammo)


	Tool.Handle.PewPew.Volume = 1 
	Tool.Handle.PewPew:play()
	Tool.Flash.Fire.Enabled = true
	Tool.Flash.Smoke.Enabled = true
	wait(0.14)

	local vCharacter = Tool.Parent
	local vPlayer = game.Players:playerFromCharacter(vCharacter)

	local missile = Instance.new(&quot;Part&quot;)
	local shellcasing = Instance.new(&quot;Part&quot;)

        

	local spawnPos = vCharacter.PrimaryPart.Position
	local otherspawnPos = vCharacter.Rifle.Charge.Position


	spawnPos  = spawnPos + (v * 7)

	missile.Position = spawnPos
	missile.Size = Vector3.new(1,1,1)
	missile.Velocity = v * 800 + Vector3.new(math.random(-2,2),math.random(-1,1),math.random(-2,2))
	missile.BrickColor = BrickColor.new(colors[math.random(1, #colors)])
	missile.Shape = 0.5
	missile.BottomSurface = 0
	missile.TopSurface = 0
	missile.Name = &quot;Paintball&quot;
	missile.Elasticity = 0
	missile.Reflectance = .1
	missile.Friction = .3
	shellcasing.Position = otherspawnPos
	shellcasing.Locked = false
	shellcasing.Size = Vector3.new(1,1,1)
	shellcasing.Velocity = v * 5
	shellcasing.BrickColor = BrickColor.new(24)
	shellcasing.Shape = 1
	shellcasing.BottomSurface = 0
	shellcasing.TopSurface = 0
	shellcasing.Name = &quot;Shell Casing&quot;
	shellcasing.Elasticity = 0.5
	shellcasing.Reflectance = 0.2
	shellcasing.Friction = 1
	shellcasing.CanCollide = true

local tc = Instance.new(&quot;BrickColorValue&quot;)
	tc.Value = vPlayer.TeamColor
	tc.Name = &quot;TeamColor&quot;
	tc.Parent = missile

	local force = Instance.new(&quot;BodyForce&quot;)
	force.force = Vector3.new(0,100,0)
	force.Parent = missile
	
	Tool.BrickCleanup:clone().Parent = missile
local new_mesh = script.Parent.Bullet:clone()
	new_mesh.Parent = missile
	local new_mesh = script.Parent.Mesh:clone()
	new_mesh.Parent = shellcasing

	local new_script = script.Parent.Paintball:clone()
	new_script.Disabled = false
	new_script.Parent = missile

	local thingy = script.Parent.BrickCleanup:clone()
	thingy.Disabled = false
	thingy.Parent = shellcasing
	local creator_tag = Instance.new(&quot;ObjectValue&quot;)
	creator_tag.Value = vPlayer
	creator_tag.Name = &quot;creator&quot;
	creator_tag.Parent = missile


	missile.Parent = game.Workspace
	shellcasing.Parent = game.Workspace
	
	Tool.Flash.Fire.Enabled = false
	Tool.Flash.Smoke.Enabled = false	
	charge()

end

Tool.Enabled = true
function onActivated()

	if not Tool.Enabled then
		return
	end

	Tool.Enabled = false
	local character = Tool.Parent;
	local humanoid = character.Humanoid
	if humanoid == nil then
		print(&quot;Humanoid not found&quot;)
		return 
	end

	local targetPos = humanoid.TargetPoint
	local lookAt = (targetPos - character.Head.Position).unit
	fire(lookAt)
	wait(1)
	Tool.Enabled = true
end

script.Parent.Activated:connect(onActivated)</ProtectedString>
