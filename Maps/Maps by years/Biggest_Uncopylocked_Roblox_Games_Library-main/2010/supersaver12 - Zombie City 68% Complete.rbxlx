local humanoid = Tool.Parent
local arms = nil
local torso = nil
local weld33 = nil -- right arm
local weld55 = nil -- left arm
local welds = {}
local reloading = false
local firing = false
local canreload = true
local canshoot = true
local cangrenade = false
local damage = 200

function ReloadNade()
if reloading == false and canreload == true and canshoot == true then
canshoot = false
