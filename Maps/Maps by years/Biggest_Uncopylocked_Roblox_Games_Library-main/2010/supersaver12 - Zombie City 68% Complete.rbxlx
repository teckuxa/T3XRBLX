								<ProtectedString name="Source">function Spread(part)
	check = part:findFirstChild(&quot;Fire&quot;)
		if check == nil then 
	script.Parent:Clone().Parent = part
	
		elseif check ~= nil then
	check.Size = check.Size + 1
	check.Heat = check.Heat  +1
	end
end


