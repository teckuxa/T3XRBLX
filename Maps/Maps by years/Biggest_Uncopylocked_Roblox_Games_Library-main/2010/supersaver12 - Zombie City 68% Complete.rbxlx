					<string name="Name">Script</string>
					<ProtectedString name="Source">system = script.Parent
model = system.BlueJet
backup = model:Clone()
regen = system.Regen

function checkRegen()
	if regen.Value == 1 then

		model:remove()

		wait(1)
		model = backup:Clone()
		model.Parent = system
		model:MakeJoints()
	end
end
regen.Changed:connect(checkRegen)</ProtectedString>
