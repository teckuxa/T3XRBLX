						<Item class="Script" referent="RBX7267">
							<Properties>
								<bool name="Disabled">true</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Rocket</string>
								<ProtectedString name="Source">function onHit()
	e = Instance.new(&quot;Explosion&quot;)
	e.Parent = game.Workspace
	e.Position = script.Parent.Position
	e.BlastRadius = 4
	e.BlastPressure = 250000
	script.Parent:Remove()
end

script.Parent.Touched:connect(onHit)

wait(10)

script.Parent:Remove()
</ProtectedString>
