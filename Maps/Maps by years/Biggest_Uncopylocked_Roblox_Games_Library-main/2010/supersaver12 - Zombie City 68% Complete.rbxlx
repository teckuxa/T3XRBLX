end

function Equip(mouse)
wait(0.01)
arms = {Tool.Parent:FindFirstChild(&quot;Left Arm&quot;), Tool.Parent:FindFirstChild(&quot;Right Arm&quot;)}
torso = Tool.Parent:FindFirstChild(&quot;Torso&quot;)
if arms ~= nil and torso ~= nil then
local sh = {torso:FindFirstChild(&quot;Left Shoulder&quot;), torso:FindFirstChild(&quot;Right Shoulder&quot;)}
if sh ~= nil then
local yes = true
if yes then
yes = false
sh[1].Part1 = nil
sh[2].Part1 = nil
local weld1 = Instance.new(&quot;Weld&quot;) -- left arm
weld55 = weld1
weld1.Part0 = torso
weld1.Parent = torso
weld1.Part1 = arms[1]
weld1.C1 = CFrame.new(-0.35, 1.4, .8) * CFrame.fromEulerAnglesXYZ(math.rad(290), math.rad(0), math.rad(-90))
welds[1] = weld1
local weld2 = Instance.new(&quot;Weld&quot;) -- right arm
weld33 = weld2
weld2.Part0 = torso
weld2.Parent = torso
weld2.Part1 = arms[2]
weld2.C1 = CFrame.new(-0.75, 0.25, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-7), math.rad(-0))
welds[2] = weld2
end
else
print(&quot;sh&quot;)
end
else
print(&quot;arms&quot;)
end
end

function Unequip(mouse)
if arms ~= nil and torso ~= nil then
local sh = {torso:FindFirstChild(&quot;Left Shoulder&quot;), torso:FindFirstChild(&quot;Right Shoulder&quot;)}
if sh ~= nil then
local yes = true
if yes then
yes = false
sh[1].Part1 = arms[1]
sh[2].Part1 = arms[2]
welds[1].Parent = nil
welds[2].Parent = nil
end
else
print(&quot;sh&quot;)
end
else
print(&quot;arms&quot;)
end
end




function onActivate()
	if enabled == true then
		enabled = false
		script.Parent.Fire:Play()
	for i = 1, 8 do -- Set this for more or less bullets
			local b = pellet:Clone()
			b.Parent = workspace
			local target = script.Parent.Parent.Humanoid.TargetPoint - script.Parent.Smoker.Position
			local dir = computeDirection(target)
			local pos = script.Parent.Smoker.Position + (dir * 2)
			local bcframe = CFrame.new(pos, pos + dir)
			local foirc = bcframe * CFrame.fromEulerAnglesXYZ(math.random(0,50) / 1000, math.random(-50,50) / 1000, 0) -- Lower values here will make it more accurate; higher, less accurate
			b.CFrame = foirc
			local bv = Instance.new(&quot;BodyVelocity&quot;)
			bv.maxForce = Vector3.new(1e+009,1e+009,1e+009)
			bv.velocity = foirc.lookVector * 400 -- Change this if you want the bullet to go faster or slower
			bv.Parent = b
			local s = script.Parent.Paintball:Clone()
			s.Disabled = false
			s.Parent = b
			local sb = script.Parent.BulletCleanup:Clone()
			sb.Disabled = false
			sb.Parent = b

			tool.Enabled=false
			
		end
