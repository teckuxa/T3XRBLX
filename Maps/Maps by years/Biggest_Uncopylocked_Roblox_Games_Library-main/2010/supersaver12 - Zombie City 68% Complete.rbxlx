							<Item class="Script" referent="RBX7092">
								<Properties>
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">Script</string>
									<ProtectedString name="Source">function onDie()
	human = nil
	script.Parent.Parent.Parent:BreakJoints()
	wait(5)
	script.Parent.Parent.Parent:Remove()
end

function Child(c)
	if c.Name == &quot;SeatWeld&quot; and c.Part1.Name == &quot;Torso&quot; then
		human = c.Part1.Parent
		script.Parent.Parent.Parent.Parent = human
		human.Humanoid.Died:connect(onDie)
	end
end

function noChild()
	human = nil
	script.Parent.Parent.Parent.Parent = game.Workspace
end

script.Parent.ChildAdded:connect(Child)
script.Parent.ChildRemoved:connect(noChild)
</ProtectedString>
									<bool name="archivable">true</bool>
								</Properties>
							</Item>
							<Item class="Script" referent="RBX7093">
								<Properties>
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">Script</string>
									<ProtectedString name="Source">function onChildAdded(child)
if child.Name == &quot;SeatWeld&quot; then
if child.Part1.Name == &quot;Torso&quot; then
player = game.Players:GetPlayerFromCharacter(child.Part1.Parent)
if player ~= nil then
tool = game.Lighting.Helicopter:Clone() -- Change this to whatever it is
tool.Parent = player.Backpack
end
end
end
end

function onChildRemoved()
if tool ~= nil then
tool:Remove()
end
end

script.Parent.ChildAdded:connect(onChildAdded)
script.Parent.ChildRemoved:connect(onChildRemoved)

-- Put it in the seat you want to give a tool.
</ProtectedString>
