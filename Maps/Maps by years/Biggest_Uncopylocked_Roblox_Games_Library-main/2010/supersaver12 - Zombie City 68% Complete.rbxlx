					</Item>
					<Item class="HopperBin" referent="RBX4261">
						<Properties>
							<bool name="Active">false</bool>
							<token name="BinType">0</token>
							<string name="Name">TranTool</string>
							<Content name="TextureId"><null></null></Content>
							<bool name="archivable">true</bool>
						</Properties>
						<Item class="Script" referent="RBX4262">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<ProtectedString name="Source">bin = script.Parent
function Transparent(mouse)
	t = mouse.Target
	if t.Locked == false then
		if t.Transparency &gt;= 1 then
			t.Transparency = 0
		else
			t.Transparency = t.Transparency + 0.1
		end
	end
end
function ToolSelect(mouse)
	mouse.Button1Down:connect(function () Transparent(mouse) end)
end
bin.Selected:connect(ToolSelect)</ProtectedString>
								<bool name="archivable">true</bool>
							</Properties>
						</Item>
