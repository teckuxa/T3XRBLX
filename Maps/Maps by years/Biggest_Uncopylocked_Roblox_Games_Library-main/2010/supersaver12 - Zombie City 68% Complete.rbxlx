				<Item class="Script" referent="RBX1065">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">Powder = script.Parent

function onTouched(part)
if part.Name == &quot;Paintball&quot; then
	local exp = Instance.new(&quot;Explosion&quot;)
	exp.Parent = game.Workspace
	exp.Position = Powder.Position
	exp.BlastRadius = Powder.Size.x * 8
	exp.BlastPressure = Powder.Size.x * 10000
end
end


Powder.Touched:connect(onTouched)</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
