								<ProtectedString name="Source">function PWNEM()
while true do
wait()
local ply = game.Workspace:GetChildren()
for i = 1, #ply do 

if ply[i]:findFirstChild(&quot;Zombie&quot;) ~= nil then
if (script.Parent.Nade.Position - ply[i].Torso.Position).magnitude &lt;= 22 then
ply[i].Zombie.Health = ply[i].Zombie.Health - 150
end
end

if ply[i]:findFirstChild(&quot;Humanoid&quot;) ~= nil then
if (script.Parent.Nade.Position - ply[i].Torso.Position).magnitude &lt;= 22 then
ply[i].Humanoid.Health = ply[i].Humanoid.Health - 150
end
end

end
end
end


wait(5)

s = Instance.new(&quot;Part&quot;)
s.Parent = script.Parent
s.Name = &quot;Smoke&quot;
s.Transparency = 1
s.Size = Vector3.new(1,1,1)
s.Shape = &quot;Block&quot;
s.TopSurface = &quot;Smooth&quot;
s.BottomSurface = &quot;Smooth&quot;
s.BrickColor = BrickColor.new(&quot;Bright red&quot;)
s.Anchored = true
s.CanCollide = false
s.Position = script.Parent.Nade.Position
script.Mesh:clone().Parent = s
script.Parent.Nade.Anchored = true
wait(0.01)
s.Transparency = 0
script.Boom:play()
wait(0.01)
s.Transparency = 0
wait(0.01)
s.Transparency = 0
wait(0.01)
s.Transparency = 0
wait(0.01)
s.Transparency = 0
wait(0.01)
PWNEM()</ProtectedString>
