m.MeshType = &quot;Sphere&quot;
m.Scale = Vector3.new(0.3,0.3,0.3) -- How big the bullet will look; change if you want
m.Parent = pellet

function LowerGun()

weld33.C1 = CFrame.new(-0.75, 0.25, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-7), math.rad(-0))
wait(.05)
weld33.C1 = CFrame.new(-0.75, 0.25, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-80), math.rad(-7), math.rad(-0))
wait(.05)
