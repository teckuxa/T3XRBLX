				<Item class="Script" referent="RBX8692">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">while true do
wait(.15)
if script.Parent.Value &gt; 5 then
script.Parent.Value = script.Parent.Value - 1
end
end
</ProtectedString>
