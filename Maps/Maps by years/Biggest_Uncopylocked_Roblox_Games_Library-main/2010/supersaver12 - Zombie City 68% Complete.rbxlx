				<Item class="Script" referent="RBX8688">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">Tool = script.Parent.Parent

function Slide()
while true do
wait(.5)
if script.Parent.Value &gt; 1 then
Tool.PartF1a.Transparency = 1
Tool.PartF1b.Transparency = 1
Tool.PartF1c.Transparency = 1
Tool.PartF1d.Transparency = 1
Tool.PartF1e.Transparency = 1
Tool.PartF1f.Transparency = 1
Tool.PartF1g.Transparency = 1
Tool.PartF1h.Transparency = 1
Tool.PartF1i.Transparency = 1
Tool.PartF1j.Transparency = 1
Tool.PartF1k.Transparency = 1
Tool.PartF1l.Transparency = 1
Tool.PartF1m.Transparency = 1
Tool.PartF1n.Transparency = 1
Tool.PartF2a.Transparency = 0
Tool.PartF2b.Transparency = 0
Tool.PartF2c.Transparency = 0
Tool.PartF2d.Transparency = 0
Tool.PartF2e.Transparency = 0
Tool.PartF2f.Transparency = 0
Tool.PartF2g.Transparency = 0
Tool.PartF2h.Transparency = 0
Tool.PartF2i.Transparency = 0
Tool.PartF2j.Transparency = 0
Tool.PartF2k.Transparency = 0
Tool.PartF2l.Transparency = 0
Tool.PartF2m.Transparency = 0
Tool.PartF2n.Transparency = 0
end
end

Tool.Equipped:connect(Slide)
</ProtectedString>
