								<string name="Name">GrenadeScript</string>
								<ProtectedString name="Source">r = game:service(&quot;RunService&quot;)

shaft = script.Parent
position = shaft.Position
car = false
lol = false

script.Parent.Explosion.PlayOnRemove = true -- play explosion sound when projectile removed from game


function blow()
	explosion = Instance.new(&quot;Explosion&quot;)
	explosion.Position = shaft.Position
	explosion.BlastPressure = 0
	explosion.BlastRadius = 10


	-- find instigator tag
	local creator = script.Parent:findFirstChild(&quot;creator&quot;)
	if creator ~= nil then
		explosion.Hit:connect(function(part, distance)  onPlayerBlownUp(part, distance, creator) end)
		explosion.Hit:connect(function(part, distance)  doDamage(part, distance) end)
	end


	explosion.Parent = game.Workspace
	connection:disconnect()
	wait(.1)
	shaft:remove()
end

function onPlayerBlownUp(part, distance, creator)
	
	if part.Name == &quot;Head&quot; then
	
		local humanoid = part.Parent.Humanoid
		tagHumanoid(humanoid, creator)
	end
end

function doDamage(part, distance)
	
	if part.Name == &quot;Regen&quot; then return end

	if part.Parent.className == &quot;Tool&quot; then return end
	if part.Parent.className == &quot;Hat&quot; then return end

	if part.Parent:findFirstChild(&quot;ShellShocked&quot;) ~= nil then return end
	if part.Parent:findFirstChild(&quot;ForceField&quot;) ~= nil then return end

	if part.Name == &quot;Head&quot; then
		local humanoid = part.Parent.Humanoid
		humanoid.Health = humanoid.Health - (130 - distance)
		local ss = Instance.new(&quot;IntValue&quot;)
		ss.Parent = part.Parent
		ss.Name = &quot;ShellShocked&quot;
		game:getService(&quot;Debris&quot;):addItem(ss,2)
	end
end


function tagHumanoid(humanoid, creator)
	-- tag does not need to expire iff all explosions lethal
	
	if creator ~= nil then
		local new_tag = creator:clone()
		new_tag.Parent = humanoid
		
	end
end

function untagHumanoid(humanoid)
	if humanoid ~= nil then
		local tag = humanoid:findFirstChild(&quot;creator&quot;)
		if tag ~= nil then
		
			tag.Parent = nil
		end
	end
end

t, s = r.Stepped:wait()

d = t + 4 - s
connection = shaft.Touched:connect(blow)

while t &lt; d do
	t = r.Stepped:wait()
end

-- at max range
blow()
script.Parent.Explosion.PlayOnRemove = false
shaft:remove()</ProtectedString>
