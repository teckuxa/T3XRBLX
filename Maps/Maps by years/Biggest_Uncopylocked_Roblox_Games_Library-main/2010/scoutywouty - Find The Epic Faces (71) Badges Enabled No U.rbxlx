							<string name="Name">Script</string>
							<ProtectedString name="Source">-- When touched, a message will be displayed to the toucher only, and noone else will see this message.

--Script by Uberubert!
--Free for anyone to use

message = Instance.new(&quot;Message&quot;) --make a messageholder
local ting = 0 --debouncer

function onTouched(hit)
&#9;if ting == 0 then --check for debounce
&#9;ting = 1 
&#9;check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;) --try to find the human that touched the button
&#9;if check ~= nil then --if toucher is a human then to following
&#9;&#9;message.Text = &quot;Are You Going To Favorite This Game?&quot; --The message to display
&#9;&#9;player = game.Players:findFirstChild(hit.Parent.Name) --Find player by searching for the players name among the players
&#9;&#9;if player ~= nil then --if the player was found (didn&apos;t suddenly leave or something) then do following
&#9;&#9;&#9;message.Parent = player --put message into the player that was found (will display a small message for that player only)
&#9;&#9;&#9;wait(3) --3 seconds wait (note: button wont work until this script&apos;s &quot;ting&quot; is 0 again)
&#9;&#9;&#9;message.Parent = nil --remove message from player, but keep it for later usage
&#9;&#9;end
&#9;end
&#9;ting = 0 --remove debounce
&#9;end
end

script.Parent.Touched:connect(onTouched) --start looking for touchers
</ProtectedString>
						</Properties>
					</Item>
				</Item>
			</Item>
		</Item>
