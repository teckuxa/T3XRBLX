meteor.Size = meteor.Size - Vector3.new(0.5, 0.5, 0.5)
wait(4)
local boom = Instance.new(&quot;Explosion&quot;)
boom.Parent = game.Workspace
boom.Position = meteor.Position
boom.BlastRadius = 15
boom.BlastPressure = 200
wait(0.01)
badge.Parent = game.Workspace
badge.Position = meteor.Position
local Neck = Instance.new(&quot;Weld&quot;)
Neck.Name = &quot;Neck&quot;
Neck.Part1 = meteor
Neck.Part0 = badge
Neck.C0 = CFrame.new(0,0,0)
