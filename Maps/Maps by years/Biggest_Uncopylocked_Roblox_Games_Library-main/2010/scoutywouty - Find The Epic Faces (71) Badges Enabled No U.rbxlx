			<Item class="Script" referent="RBX964">
				<Properties>
					<bool name="Archivable">true</bool>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">while true do
wait(10) --Change If You Like Scouty!
pick = math.random(1,3)
if pick == 1 then --Yellow Is OK.
script.Parent.Blue.kill.Value = true
script.Parent.Red.kill.Value = true
script.Parent.Yellow.kill.Value = false
elseif pick == 2 then --Red Is OK.
script.Parent.Blue.kill.Value = true
script.Parent.Yellow.kill.Value = true
script.Parent.Red.kill.Value = false
elseif pick == 3 then --Blue Is OK.
script.Parent.Red.kill.Value = true
script.Parent.Yellow.kill.Value = true
script.Parent.Blue.kill.Value = false
end end </ProtectedString>
				</Properties>
			</Item>
		</Item>
