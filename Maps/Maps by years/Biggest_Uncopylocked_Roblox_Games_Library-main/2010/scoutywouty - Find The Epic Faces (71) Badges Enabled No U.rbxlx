			<Item class="Script" referent="RBX391">
				<Properties>
					<bool name="Archivable">true</bool>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">Elements = {&quot;Leafa&quot;,&quot;Leafb&quot;,&quot;Snowflakea&quot;,&quot;Snowflakeb&quot;}
Distances = {3.3,3.4,3.1,3.6 }
Heights = {-1,1,0,2 }
Speeds = {0.035,0.055,0.07,0.09}

i = 0 
angle = 0
while true do 
i=i+1 
wait() 
for Num=1,#Elements do
Count = Num
Name = Elements[Count]
Distance = Distances[Count]
Speed = Speeds[Count]
Height = Heights[Count]
script.Parent[Name].CFrame = script.Parent[&quot;Middle&quot;].CFrame*CFrame.fromEulerAnglesXYZ(angle,(i * Speed),1)*CFrame.new(Height,0,Distance) 
end 
end </ProtectedString>
				</Properties>
			</Item>
