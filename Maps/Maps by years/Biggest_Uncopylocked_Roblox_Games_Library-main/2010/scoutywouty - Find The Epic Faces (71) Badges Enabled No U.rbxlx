			<Item class="Script" referent="RBX3754">
				<Properties>
					<bool name="Archivable">true</bool>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">CardScript</string>
					<ProtectedString name="Source">card = script.Parent

HitSound = Instance.new(&quot;Sound&quot;)
HitSound.Name = &quot;HitSound&quot;
HitSound.SoundId = &quot;http://www.roblox.com/asset/?id=28509434&quot;
HitSound.Parent = card
HitSound.Volume = 1

local debris = game:GetService(&quot;Debris&quot;)

function onTouched(hit)
&#9;local humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;)

&#9;if humanoid ~= nil then
&#9;&#9;tagHumanoid(humanoid)
&#9;&#9;HitSound.Pitch = math.random(0.8,1)
&#9;&#9;HitSound:Play()
&#9;&#9;local yellowHit = Instance.new(&quot;StringValue&quot;)
&#9;&#9;yellowHit.Name = &quot;YellowHit&quot;
&#9;&#9;yellowHit.Value = &quot;YellowHit&quot;
&#9;&#9;yellowHit.Parent = humanoid.Parent
&#9;&#9;local message = Instance.new(&quot;Message&quot;)
&#9;&#9;message.Text = &quot;You Have Been Given Scout&apos;s Autograph!&quot;
&#9;&#9;local player = game.Players:GetPlayerFromCharacter(humanoid.Parent)
&#9;&#9;if (player ~= nil) then
&#9;&#9;&#9;local b = game:GetService(&quot;BadgeService&quot;)
&#9;&#9;&#9;b:AwardBadge(player.userId, 37538042)
&#9;&#9;end
&#9;&#9;message.Parent = player
&#9;&#9;card.Parent = nil
&#9;&#9;debris:AddItem(message, 4)
&#9;&#9;local yellowCard = humanoid.Parent:FindFirstChild(&quot;YellowHit&quot;)
&#9;&#9;if yellowCard ~= nil then
&#9;&#9;&#9;yellowCard.Parent = nil
&#9;&#9;&#9;yellowCard:remove()
&#9;&#9;end
&#9;&#9;card.Parent = nil
&#9;&#9;untagHumanoid(humanoid)
&#9;end
end

function tagHumanoid(humanoid)
&#9;-- todo: make tag expire
&#9;local tag = card:findFirstChild(&quot;creator&quot;)
&#9;if tag ~= nil then
&#9;&#9;local new_tag = tag:clone()
&#9;&#9;new_tag.Parent = humanoid
&#9;end
end


function untagHumanoid(humanoid)
&#9;if humanoid ~= nil then
&#9;&#9;local tag = humanoid:findFirstChild(&quot;creator&quot;)
&#9;&#9;if tag ~= nil then
&#9;&#9;&#9;tag.Parent = nil
&#9;&#9;end
&#9;end
end

connection = card.Touched:connect(onTouched)

debris:AddItem(card, 16)</ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX3755">
				<Properties>
					<bool name="Archivable">true</bool>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">RayGun</string>
					<ProtectedString name="Source">local Tool = script.Parent;
local cardColor = 1
enabled = true

function fire(v)
&#9;local vCharacter = Tool.Parent
&#9;local vPlayer = game.Players:playerFromCharacter(vCharacter)
&#9;local missile = Instance.new(&quot;Part&quot;)
&#9;local spawnPos = vCharacter.PrimaryPart.Position
&#9;spawnPos  = spawnPos + (v * 10)
&#9;missile.Position = spawnPos
&#9;missile.formFactor = 2 
&#9;missile.Size = Vector3.new(1,0.4,2)
&#9;missile.Velocity = v * 10
&#9;missile.BottomSurface = 0
&#9;missile.TopSurface = 0
&#9;local force = Instance.new(&quot;BodyForce&quot;)
&#9;force.force = Vector3.new(0,10,0)
&#9;force.Parent = missile
&#9;local creator_tag = Instance.new(&quot;ObjectValue&quot;)
&#9;creator_tag.Value = vPlayer
&#9;creator_tag.Name = &quot;creator&quot;
&#9;creator_tag.Parent = missile
&#9;local new_script = script.Parent.CardScript:clone()
&#9;new_script.Disabled = false
&#9;new_script.Parent = missile
&#9;missile.Parent = game.Workspace
end


function onActivated()
&#9;if not enabled  then
&#9;&#9;return
&#9;end
&#9;enabled = false
&#9;local character = Tool.Parent;
&#9;local humanoid = character.Humanoid
&#9;if humanoid == nil then
&#9;&#9;print(&quot;Humanoid not found&quot;)
&#9;&#9;return 
&#9;end
&#9;local targetPos = humanoid.TargetPoint
&#9;local lookAt = (targetPos - character.Head.Position).unit
&#9;local reload = .5
&#9;fire(lookAt)
&#9;Tool.Handle.Transparency = 1
&#9;wait(reload)
&#9;wait(reload)
&#9;Tool.Handle.Transparency = 0
&#9;cardColor = 1
&#9;Tool.Handle.Mesh.TextureId = &quot;&quot;
&#9;enabled = true
end

function onEquipped()
&#9;Tool.Handle.EquipSound:play()
end

script.Parent.Activated:connect(onActivated)
script.Parent.Equipped:connect(onEquipped)
</ProtectedString>
				</Properties>
			</Item>
			<Item class="LocalScript" referent="RBX3756">
				<Properties>
					<bool name="Archivable">true</bool>
