						<Item class="DialogChoice" referent="RBX2436">
							<Properties>
								<bool name="Archivable">true</bool>
								<string name="Name">DialogChoice</string>
								<string name="ResponseDialog">Sometimes $100 is awarded to you when you find an epic face.</string>
