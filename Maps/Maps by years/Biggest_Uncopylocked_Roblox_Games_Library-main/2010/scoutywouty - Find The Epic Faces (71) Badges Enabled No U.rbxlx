					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Teleport</string>
					<ProtectedString name="Source">function FadeOut()
for i = 1,10 do
wait(0.1)
script.Parent.Transparency = script.Parent.Transparency + 0.1
end
script.Parent.Transparency = 1
end

function FadeIn()
for i = 1,10 do
wait(0.1)
script.Parent.Transparency = script.Parent.Transparency - 0.1
end
script.Parent.Transparency = 0
end

while true do
wait(2)
FadeOut()
script.Parent.CFrame = CFrame.new(Vector3.new(math.random(-200,200), 2.8, math.random(-200,200)))
FadeIn()
end


---Lion2323
