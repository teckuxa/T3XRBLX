					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">LocalScript</string>
					<ProtectedString name="Source">local Tool = script.Parent
local blow = nil

local sound = Instance.new(&quot;Sound&quot;)
sound.Parent  = Tool.Handle
local sounds = {&quot;32727625&quot;,&quot;32727646&quot;,&quot;32727664&quot;,&quot;32727673&quot;}
sound.Volume = 0.01

for i = 1, #sounds do
&#9;sound.SoundId = &quot;http://www.roblox.com/asset/?id=&quot; .. sounds[i]
&#9;sound:Play()&#9;
end

sound:Stop()
sound.Volume = 0.6

function onEquipped()
&#9;sound:Stop()
&#9;blow = Tool.Parent:FindFirstChild(&quot;Humanoid&quot;):LoadAnimation(Tool.hornblow)
end

function unEquipped()
&#9;blow:remove()
&#9;sound:Stop()
end

local enabled = false

function onActivated()

&#9;if enabled then
&#9;&#9;return
&#9;end

&#9;enabled = true

&#9;blow:Play(0.1,1,0.9)
&#9;Tool.GripForward = Vector3.new(1,0,0)
&#9;Tool.GripPos = Vector3.new(0.3,0.2,-0.2)
&#9;Tool.GripRight = Vector3.new(0,0,-1)
&#9;sound.SoundId = &quot;http://www.roblox.com/asset/?id=&quot; .. sounds[math.random(1,#sounds)]
&#9;sound.Pitch = math.random(0.7,1)
&#9;sound:Play()

&#9;wait(2.3)

&#9;Tool.GripForward = Vector3.new(0,0,-1)
&#9;Tool.GripPos = Vector3.new(-0.05, 0.12, 0.37)
&#9;Tool.GripRight = Vector3.new(1, 0, 0)

&#9;enabled = false

end

Tool.Activated:connect(onActivated)
Tool.Equipped:connect(onEquipped)
Tool.Unequipped:connect(onUnequipped)

