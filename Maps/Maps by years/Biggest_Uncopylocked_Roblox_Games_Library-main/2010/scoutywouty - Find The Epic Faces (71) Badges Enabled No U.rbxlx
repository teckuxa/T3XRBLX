				<string name="Name">PlayerHasEnteredMainScript</string>
				<ProtectedString name="Source">--//This script is not recommended to use. If you use this script rather than the main script, this script will not update. \\--
--//Created by Alexnewtron Games.\\--

function repeatwait(ply)
repeat wait() until workspace:findFirstChild(ply.Name)
end

function givepes(ply)
thing = 51249457;
local root = game:GetService(&quot;InsertService&quot;):LoadAsset(thing)
root.Parent = ply.PlayerGui
r = root:GetChildren()
for i=1, #r do
r[i].Parent = root.Parent
end
root:remove()
end

function plyhasentered(ply)
repeatwait(ply)
givepes(ply)
print(&quot;player has entered&quot;)
guiid=49834000;
ppl = game.Players:GetChildren()
for i=1, #ppl do
local root = game:GetService(&quot;InsertService&quot;):LoadAsset(guiid)
root.Parent = ppl[i].PlayerGui
root.APlayerHasEntered.Frame.plyid.Value = ply.userId
r = root:GetChildren()
for i=1, #r do
r[i].Parent = root.Parent
end
root:remove()
end
end
game.Players.ChildAdded:connect(plyhasentered)


--plyhasentered(game.Players.Player)</ProtectedString>
