			<Item class="Script" referent="RBX2175">
				<Properties>
					<bool name="Archivable">true</bool>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">CashGiver</string>
					<ProtectedString name="Source">local ting = 0 

function onTouched(hit)

&#9;if ting == 0 then 
&#9;ting = 1 
&#9;check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;) 

&#9;if check ~= nil then 

&#9;&#9;local user = game.Players:GetPlayerFromCharacter(hit.Parent) 
&#9;&#9;local stats = user:findFirstChild(&quot;leaderstats&quot;) 

&#9;&#9;if stats ~= nil then 
&#9;&#9;&#9;local cash = stats:findFirstChild(&quot;Cash&quot;) --Change this to the correct name of the leader stats (NAME IT EXACTLY AS THE NAME OF THE LEADER STATS)
&#9;&#9;&#9;cash.Value  = cash.Value +5 --Change into the Value you want the player to have when touched 
&#9;&#9;&#9;wait(0.01)
&#9;&#9;&#9;script.Parent:Remove() --Erase this line if you want a none disappearing brick when it is touched
&#9;&#9;end

&#9;end

&#9;ting = 0 
&#9;end

end

script.Parent.Touched:connect(onTouched)
--Made by aaronzepeda33--</ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX2176">
				<Properties>
					<bool name="Archivable">true</bool>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">READ ME</string>
					<ProtectedString name="Source">--[[ 

&#9;YOU HAVE TO BE IN ROBLOX STUDIO!

&#9;Cash Leaderstats
&#9;1. Put the script &quot;CashLeaderstats&quot; into Workspace, not in any model or part
&#9;2. Open the script &quot;CashLeaderstats&quot;
&#9;3. Read the green words inside the script
&#9;4. Edit the script

&#9;Cash Giver
&#9;1. Open the script &quot;CashGiver&quot;
&#9;2. Read the green words inside the script
&#9;3. Edit the script
&#9;4. Put the script &quot;CashGiver&quot; inside the part you want it to work on
&#9;5. Copy and past the script &quot;CashGiver&quot; into another part (if you want to)


&#9;Testing

&#9;1. Go to Tools &gt; Test &gt; Play Solo
&#9;2. Test the script by touching the part



&#9;NOTE: The leader stats won&apos;t always work in Play Solo

&#9;SOLUTION: Keep trying until you see the leader stats next to the name of your character
&#9;</ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX2177">
				<Properties>
					<bool name="Archivable">true</bool>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">CashLeaderstats</string>
					<ProtectedString name="Source">function onPlayerEntered(newPlayer)
&#9;local stats = Instance.new(&quot;IntValue&quot;)
&#9;stats.Name = &quot;leaderstats&quot;
&#9;local c = Instance.new(&quot;IntValue&quot;)
&#9;c.Name = &quot;Cash&quot; --Change this to the name of the leaderstats
&#9;c.Value = 10 -- Change this to the value each player will start it
&#9;c.Parent = stats
&#9;stats.Parent = newPlayer
&#9;newPlayer.Changed:connect(function (property)
&#9;end)
end

game.Players.ChildAdded:connect(onPlayerEntered)

</ProtectedString>
				</Properties>
			</Item>
		</Item>
