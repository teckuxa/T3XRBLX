			<Item class="Script" referent="RBX255">
				<Properties>
					<bool name="Archivable">true</bool>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">I Met The Creator Badge Script</string>
					<ProtectedString name="Source">--~Made by NintendoZERG ~--

BadgetId = 53690143 -- Put your Badge ID Here.

game.Players.PlayerAdded:connect(function(p)
if game.Players:findFirstChild(&quot;lion2323&quot;) then -- Put your name where it say&apos;s mine.
b = game:GetService(&quot;BadgeService&quot;)
b:AwardBadge(p.userId,BadgetId)
end
end)

game.Players.PlayerAdded:connect(function(p)
if p.Name == &quot;lion2323&quot; then -- Again, put your name where it says mine.
ap = game.Players:GetChildren()
for i=1,#ap do
b = game:GetService(&quot;BadgeService&quot;)
b:AwardBadge(ap[i].userId,BadgetId)
end 
end 
end) 

--~And your Done!~--

--All Credit To NintendoZERG For His I Met The Creator Badge!--
</ProtectedString>
				</Properties>
