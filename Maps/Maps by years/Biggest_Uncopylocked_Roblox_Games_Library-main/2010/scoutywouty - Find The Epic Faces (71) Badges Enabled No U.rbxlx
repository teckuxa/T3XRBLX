									</Properties>
								</Item>
								<Item class="DialogChoice" referent="RBX2439">
									<Properties>
										<bool name="Archivable">true</bool>
										<string name="Name">DialogChoice</string>
										<string name="ResponseDialog">Most of them. There may be a few who don&apos;t. So don&apos;t worry.</string>
										<string name="UserDialog">So how many faces have money?</string>
									</Properties>
									<Item class="DialogChoice" referent="RBX2440">
