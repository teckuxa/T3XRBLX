			<Item class="Script" referent="RBX81">
				<Properties>
					<bool name="Archivable">true</bool>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">ShirtId = script.Parent.Configuration.ShirtId.Value

function Work(hit)
local human = hit.Parent:findFirstChild(&quot;Humanoid&quot;) 
&#9;if (human ~= nil ) then &#9;
&#9;print(&quot;Human touched door&quot;)
&#9;&#9;local blah = game.Players:findFirstChild(hit.Parent.Name).userId
&#9;&#9;if game:GetService(&quot;BadgeService&quot;):UserHasBadge(blah,ShirtId) == true then
script.Parent.Transparency = 0.5 -- Transparency when open.
script.Parent.CanCollide = false
wait(3) -- The wait. (When open.)
script.Parent.Transparency = 0 -- Transparency when Clone.
script.Parent.CanCollide = true

script.Disabled = true
wait(0.001)              -- Auto-regen
script.Disabled = false
&#9;else
&#9;human.Health = 0  -- Kills nubs.
&#9;script.Disabled = true
&#9;wait(0.001)           -- Auto-regen
&#9;script.Disabled = false
end  
end
end



script.Parent.Touched:connect(Work)</ProtectedString>
