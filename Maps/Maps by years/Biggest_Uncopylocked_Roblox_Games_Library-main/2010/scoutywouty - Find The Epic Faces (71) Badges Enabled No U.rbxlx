						<string name="Name">Script</string>
						<ProtectedString name="Source">function onhit(hit)
if script.Parent.kill.Value == true then
wait(.0000005) --IN A FLASH! 0.0
hit.Parent.Humanoid.Health = 0
else
lol = script.Parent.Parent
lol.box.Transparency = 1
lol.box1.Transparency = 1
lol.box2.Transparency = 1
lol.box3.Transparency = 1
lol.box4.Transparency = 1
lol.box5.Transparency = 1
lol.box.CanCollide = false
lol.box1.CanCollide = false
lol.box2.CanCollide = false
lol.box3.CanCollide = false
lol.box4.CanCollide = false
lol.box5.CanCollide = false
wait(5)
lol.box.Transparency = 0
lol.box1.Transparency = 0
lol.box2.Transparency = 0
lol.box3.Transparency = 0
lol.box4.Transparency = 0
lol.box5.Transparency = 0
lol.box.CanCollide = true
lol.box1.CanCollide = true
lol.box2.CanCollide = true
lol.box3.CanCollide = true
lol.box4.CanCollide = true
lol.box5.CanCollide = true
end end
script.Parent.Touched:connect(onhit)</ProtectedString>
