				<string name="Name">Contributor Badge Script</string>
				<ProtectedString name="Source">---Minor---
MinorB = 53859664
MinorT = &quot;http://www.roblox.com/asset/?id=53859210&quot;

---Medium---
MediumB = 53860199
MediumT = &quot;http://www.roblox.com/asset/?id=53860013&quot;

---Major---
MajorB = 53861204
MajorT = &quot;http://www.roblox.com/asset/?id=53860895&quot;

---Uber---
UberB = 53862061
UberT = &quot;http://www.roblox.com/asset/?id=53861798&quot;

---Epic---
EpicB = 53862914
EpicT = &quot;http://www.roblox.com/asset/?id=53862727&quot;


game.Players.PlayerAdded:connect(function(p) 
wait(5)

---Minor Badge---
if p.Character.Torso.roblox.Texture == MinorT then 
game:GetService(&quot;BadgeService&quot;):AwardBadge(p.userId,MinorB) 
end 

---Medium Badge---
if p.Character.Torso.roblox.Texture == MediumT then 
game:GetService(&quot;BadgeService&quot;):AwardBadge(p.userId,MinorB) 
game:GetService(&quot;BadgeService&quot;):AwardBadge(p.userId,MediumB) 
end

---Major Badge---
if p.Character.Torso.roblox.Texture == MajorT then  
game:GetService(&quot;BadgeService&quot;):AwardBadge(p.userId,MinorB)
game:GetService(&quot;BadgeService&quot;):AwardBadge(p.userId,MediumB)
game:GetService(&quot;BadgeService&quot;):AwardBadge(p.userId,MajorB) 
end

---Uber Badge--
if p.Character.Torso.roblox.Texture == UberT then  
game:GetService(&quot;BadgeService&quot;):AwardBadge(p.userId,MinorB)
game:GetService(&quot;BadgeService&quot;):AwardBadge(p.userId,MediumB)
game:GetService(&quot;BadgeService&quot;):AwardBadge(p.userId,MajorB) 
game:GetService(&quot;BadgeService&quot;):AwardBadge(p.userId,UberB)
end

---Epic Badge---
if p.Character.Torso.roblox.Texture == EpicT then  
game:GetService(&quot;BadgeService&quot;):AwardBadge(p.userId,MinorB)
game:GetService(&quot;BadgeService&quot;):AwardBadge(p.userId,MediumB)
game:GetService(&quot;BadgeService&quot;):AwardBadge(p.userId,MajorB) 
game:GetService(&quot;BadgeService&quot;):AwardBadge(p.userId,UberB)
game:GetService(&quot;BadgeService&quot;):AwardBadge(p.userId,EpicB)
end
end) 

