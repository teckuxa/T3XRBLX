				<ProtectedString name="Source">local meteor = game.StarterGui.EpicFace
local badge = game.StarterGui.Badge
local one = script.Parent.One
local two = script.Parent.Two
local three = script.Parent.Three
local four = script.Parent.Four

while true do
wait(1)
local CC = math.random(1,4)
if CC == 1 then
meteor.Parent = game.Workspace
meteor.Position = one.Position
wait(4)
meteor.Size = meteor.Size - Vector3.new(0.5, 0.5, 0.5)
wait(0.1)
