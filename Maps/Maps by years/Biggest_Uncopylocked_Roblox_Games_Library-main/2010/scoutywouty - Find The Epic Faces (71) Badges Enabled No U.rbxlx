							<Item class="DialogChoice" referent="RBX2437">
								<Properties>
									<bool name="Archivable">true</bool>
									<string name="Name">DialogChoice</string>
									<string name="ResponseDialog">Yes, the creator is very busy and it&apos;s hard to put the script in all of them.</string>
									<string name="UserDialog">Sometimes?</string>
								</Properties>
								<Item class="DialogChoice" referent="RBX2438">
