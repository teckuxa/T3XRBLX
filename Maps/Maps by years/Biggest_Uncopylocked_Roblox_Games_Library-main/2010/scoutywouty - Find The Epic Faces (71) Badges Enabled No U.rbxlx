								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<ProtectedString name="Source">function Rain()
&#9;wait(0.2)
&#9;c = Instance.new(&quot;Part&quot;)
&#9;c.formFactor = 2
&#9;c.Size = Vector3.new(1, 0.4, 0)
&#9;c.BrickColor = BrickColor.new(&quot;Medium blue&quot;)
&#9;c.Transparency = 0.5
&#9;c.CanCollide = false
&#9;c.Parent = script.Parent.Parent
   m = script.Mesh: Clone()
&#9;m.Parent = c
&#9;c.Position = script.Parent.Position + (script.Parent.CFrame.lookVector * 2)
&#9;c:breakJoints()
&#9;c.Velocity = (script.Parent.CFrame.lookVector * math.random(0, 0)) + Vector3.new(math.random(0, 0), math.random(0, 0), math.random(0, 0))
&#9;game:GetService(&quot;Debris&quot;):AddItem(c, 1)
&#9;wait(0.4)
end 

while true do 
&#9;wait(0.01)
&#9;if script.Parent.Parent.IsRaining.Value == true then
&#9;&#9;Rain()
&#9;end
