					<Item class="Script" referent="RBX21">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">local move = 9
local c = script.Parent.Parent.Door.CFrame
local f = script.Frame:Clone()
local newele = script.Parent.Parent:Clone()
local deb = true

script.Parent.ChildAdded:connect(function(child)
if not deb then return end
deb = false
local torso = child.Part1
local player = game.Players:getPlayerFromCharacter(torso.Parent)

local l = Instance.new(&quot;ScreenGui&quot;)
l.Name = &quot;Launch&quot;
l.Parent = player.PlayerGui
f:Clone().Parent = player.PlayerGui.Launch

for i = 0, move, 0.2 do
script.Parent.Parent.Door.CFrame = c + Vector3.new(0,0,-i)
wait()
end
script.Parent.Parent.Door:MakeJoints()

l.Frame.TextBox.Text = &quot;3&quot;
wait(1)
l.Frame.TextBox.Text = &quot;2&quot;
wait(1)
l.Frame.TextBox.Text = &quot;1&quot;
wait(1)
l.Frame.TextBox.Text = &quot;LIFTOFF!&quot;
script.Parent.Parent.Mover.BodyVelocity.velocity = Vector3.new(0, 50,0)
for i, v in ipairs(script.Parent.Parent:getChildren()) do
v.Anchored = false
end
wait(.5)
l:remove()

repeat wait() until script.Parent.Parent.Mover.Position.y &gt; 250

script.Parent.Parent.Mover.BodyGyro:remove()
script.Parent.Parent.Mover.BodyVelocity:remove()

for i, v in ipairs(script.Parent.Parent:getChildren()) do
v.Touched:connect(function()
v:BreakJoints()
end)
end

wait(2)
local clo = newele:Clone()
clo.Parent = workspace
clo:MakeJoints()

wait(5)

script.Parent.Parent:Remove()

end)
</ProtectedString>
