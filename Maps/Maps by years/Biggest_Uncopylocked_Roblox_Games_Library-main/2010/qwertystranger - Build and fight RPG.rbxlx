L.Locked = true 
L.Anchored = true 
L.CanCollide = false 
L.Transparency = 0.05 
L.Reflectance = 0.1 
local Place0 = Person.Character.Suit.Watch2.CFrame * CFrame.new(0, -0.1, 0) 
local Mesh = Instance.new(&quot;CylinderMesh&quot;) 
Mesh.Parent = L 
