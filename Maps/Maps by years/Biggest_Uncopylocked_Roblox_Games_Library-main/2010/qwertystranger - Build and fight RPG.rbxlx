					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">LocalScript</string>
					<ProtectedString name="Source">--made by Stickmasterluke

wait()
check=false
sp=script.Parent
map=sp.Map
plr=game.Players.LocalPlayer
smallsize=Vector3.new(50,50,0)
bigsize=Vector3.new(500,500,0)
map.Image=&quot;http://www.roblox.com/asset/?id=27657674&quot;

map.MouseButton1Click:connect(function()
	if check then
		map.Size=UDim2.new(0,bigsize.x,0,bigsize.y)
	else
		map.Size=UDim2.new(0,smallsize.x,0,smallsize.y)
	end
	check=not check
end)
