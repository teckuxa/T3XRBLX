f = force
wait(0.01)
elseif ison == 0 then
if arms then
sh[1].Part1 = arms[1]
sh[2].Part1 = arms[2]
f.Parent = nil
arms[2].Name = &quot;Right Leg&quot;
arms[1].Name = &quot;Left Leg&quot;
