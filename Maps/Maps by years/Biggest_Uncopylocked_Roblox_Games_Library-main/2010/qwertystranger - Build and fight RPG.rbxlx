		<Item class="Script" referent="RBX5599">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">RealBlood </string>
				<ProtectedString name="Source">scripts = script.RealBlood:clone()
script.RealBlood:remove()

game.Players.PlayerAdded:connect(function(player) 
player.CharacterAdded:connect(function(char) 
wait(.5)
scripts:clone().Parent = char
end) 
end)

</ProtectedString>
