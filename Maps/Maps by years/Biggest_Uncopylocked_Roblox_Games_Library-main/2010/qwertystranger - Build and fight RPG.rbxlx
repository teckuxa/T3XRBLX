				<Item class="Script" referent="RBX246">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">function onTouched(hit)
	local human = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
	if (human ~= nil) then
		g=hit.Parent.Name
		h=game.Players:findFirstChild(g).Backpack:getChildren()
		for i=1, #h do
			h[i]:remove()
		end
	end
end

