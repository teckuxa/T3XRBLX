					<Item class="Script" referent="RBX5856">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">FellCheck</string>
							<ProtectedString name="Source">hits = script.Parent.hit --This keeps track of how much &quot;hp&quot; the tree has left
local newtree = script.Parent:clone() --for inserting a new tree later

while true do --infinite loop
if hits.Value &lt; 1 then --if the tree has less than 1 &quot;hp&quot; then
	script.Parent:BreakJoints() --make tree able to fall over. 
	wait(3) --wait a while
	script.Parent:remove() --remove the tree
	wait(10) --wait a while
	newtree.Parent = game.Workspace --insert a new tree
	newtree:MakeJoints() --make tree unable to fall over
end
wait(1) --wait a while before checking trees hp again
end
</ProtectedString>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
					<Item class="IntValue" referent="RBX5857">
						<Properties>
							<string name="Name">Timber</string>
							<int name="Value">0</int>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
					<Item class="Script" referent="RBX5858">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">README</string>
							<ProtectedString name="Source">--To change the trees hp, adjust the value in &quot;hit&quot;. Also look in the axe-tools script to adjust how much damage
--the axe deals, and how much money is awarded per tree.</ProtectedString>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
					<Item class="Script" referent="RBX5859">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">--Money Giver By Dianne


local ting = 0

function onTouched(hit)

	if ting == 0 then 
	ting = 1
	check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)

	if check ~= nil then 

		local user = game.Players:GetPlayerFromCharacter(hit.Parent)
		local stats = user:findFirstChild(&quot;leaderstats&quot;)

		if stats ~= nil then 
			local cash = stats:findFirstChild(&quot;Money&quot;)
			cash.Value  = cash.Value  +25
			wait(0.1)
		end 

	end 

	ting = 0
	end 

end 

script.Parent.Touched:connect(onTouched)
</ProtectedString>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
