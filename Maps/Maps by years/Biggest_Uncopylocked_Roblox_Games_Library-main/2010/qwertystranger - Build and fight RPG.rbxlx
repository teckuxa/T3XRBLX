					</Properties>
				</Item>
				<Item class="Script" referent="RBX1680">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">README</string>
						<ProtectedString name="Source">--To change the trees hp, adjust the value in &quot;hit&quot;. Also look in the axe-tools script to adjust how much damage
--the axe deals, and how much money is awarded per tree.</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX1681">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">--Money Giver By Dianne


local ting = 0

function onTouched(hit)

	if ting == 0 then 
	ting = 1
	check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)

	if check ~= nil then 

		local user = game.Players:GetPlayerFromCharacter(hit.Parent)
		local stats = user:findFirstChild(&quot;leaderstats&quot;)

		if stats ~= nil then 
			local cash = stats:findFirstChild(&quot;Money&quot;)
			cash.Value  = cash.Value  +25
			wait(0.1)
		end 

	end 

	ting = 0
	end 

end 

script.Parent.Touched:connect(onTouched)
</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
