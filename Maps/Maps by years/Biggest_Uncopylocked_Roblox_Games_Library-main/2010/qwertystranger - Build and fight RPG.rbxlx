									<string name="Name">Reset Script</string>
									<ProtectedString name="Source">-- [this reset makes u float wen u use it]

bin = script.Parent



function onButton1Down(mouse)

	local player = game.Players.LocalPlayer
	local Larm = player.Character:findFirstChild(&quot;Left Arm&quot;)
	local Rarm = player.Character:findFirstChild(&quot;Right Arm&quot;)
	local Lleg = player.Character:findFirstChild(&quot;Left Leg&quot;)
	local Rleg = player.Character:findFirstChild(&quot;Right Leg&quot;)
	local Torso = player.Character:findFirstChild(&quot;Torso&quot;)
	local Head = player.Character:findFirstChild(&quot;Head&quot;)
	if player == nil then return end
	Instance.new(&quot;BodyVelocity&quot;).Parent = player.Character.Head                --the lines wiyh bodyvelocity makes those body parts float
	Instance.new(&quot;BodyVelocity&quot;).Parent = player.Character.Torso
	Instance.new(&quot;Sparkles&quot;).Parent = player.Character.Torso
	Instance.new(&quot;BodyVelocity&quot;).Parent = player.Character:findFirstChild(&quot;Left Leg&quot;)
	Instance.new(&quot;BodyVelocity&quot;).Parent = player.Character:findFirstChild(&quot;Right Leg&quot;)
	Instance.new(&quot;BodyVelocity&quot;).Parent = player.Character:findFirstChild(&quot;Right Arm&quot;)
	Instance.new(&quot;BodyVelocity&quot;).Parent = player.Character:findFirstChild(&quot;Left Arm&quot;)
	Larm.Reflectance = 1
	Rarm.Reflectance = 1
	Lleg.Reflectance = 1
	Rleg.Reflectance = 1
	Head.Reflectance = 1
	Torso.Reflectance = 1
	mouse.Icon = &quot;rbxasset://textures\\ArrowCursor.png&quot;

end

function onSelected(mouse)
	mouse.Icon = &quot;rbxasset://textures\\ArrowCursor.png&quot;
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end

bin.Selected:connect(onSelected)

