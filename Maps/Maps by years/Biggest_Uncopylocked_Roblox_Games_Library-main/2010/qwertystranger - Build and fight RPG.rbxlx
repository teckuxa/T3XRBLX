			<Item class="Script" referent="RBX240">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Regen</string>
					<ProtectedString name="Source">-- Ajedi32

bin = script.Parent

ItemName = &quot;Ice Dagger&quot; -- The name of the item in the stand.
WaitTime = 20 -- The amount of time to wait before regenerating the item.


Item = bin:findFirstChild(ItemName)
backup = Item:clone()

function regen()
	local regen = backup:clone()
	regen.Parent = bin
end

debounce = false
function onTaken(property)
if (debounce == true) then return end
debounce = true
	if (bin:findFirstChild(ItemName) == nil) then
		wait(WaitTime)
		regen()
	end
debounce = false
end


