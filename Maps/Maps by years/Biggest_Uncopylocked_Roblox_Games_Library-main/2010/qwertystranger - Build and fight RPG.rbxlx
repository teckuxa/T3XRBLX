							<Item class="Script" referent="RBX474">
								<Properties>
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">Script</string>
									<ProtectedString name="Source">function onChildAdded(child)
if child.Name == &quot;SeatWeld&quot; then
if child.Part1.Name == &quot;Torso&quot; then
player = game.Players:GetPlayerFromCharacter(child.Part1.Parent)
if player ~= nil then
tool = game.Lighting.Hornet:Clone() -- Change this to whatever it is
tool.Parent = player.Backpack
end
end
end
end

function onChildRemoved()
if tool ~= nil then
tool:Remove()
end
end

script.Parent.ChildAdded:connect(onChildAdded)
script.Parent.ChildRemoved:connect(onChildRemoved)

-- Put it in the seat you want to give a tool.
</ProtectedString>
									<bool name="archivable">true</bool>
								</Properties>
							</Item>
							<Item class="Script" referent="RBX475">
								<Properties>
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">Script</string>
									<ProtectedString name="Source">function onDie()
	human = nil
	script.Parent.Parent.Parent:BreakJoints()
	wait(5)
	script.Parent.Parent.Parent:Remove()
end

function Child(c)
	if c.Name == &quot;SeatWeld&quot; and c.Part1.Name == &quot;Torso&quot; then
		human = c.Part1.Parent
		script.Parent.Parent.Parent.Parent = human
		human.Humanoid.Died:connect(onDie)
	end
end

function noChild()
	human = nil
	script.Parent.Parent.Parent.Parent = game.Workspace
end

script.Parent.ChildAdded:connect(Child)
script.Parent.ChildRemoved:connect(noChild)
</ProtectedString>
									<bool name="archivable">true</bool>
								</Properties>
							</Item>
							<Item class="Script" referent="RBX476">
								<Properties>
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">MessageBox</string>
									<ProtectedString name="Source">print(&quot;Sparttan&apos;s button&quot;)

local debounce = false


function onHit(hit)
	local human = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
	if (human ~= nil) and debounce == false then

                debounce = true

		local message = Instance.new(&quot;Message&quot;)
		message.Text = &quot;How to fly the Hornet&quot;
		message.Parent = game.Players:playerFromCharacter(hit.Parent)
		wait(3)
		message.Text = &quot;Y to start it up&quot;
		wait(3)
		message.Text = &quot;W to move&quot;
		wait(3)
		message.Text = &quot;D to speed up and A to slow down&quot;
		wait(3)
		message.Text = &quot;E to hover up and Q to hover down&quot;
		wait(3)
  		message.Text = &quot;S to hover and X to land&quot;
		wait(3)
                message:Remove ()

                debounce = false
	end
end

script.Parent.Touched:connect(onHit)
</ProtectedString>
									<bool name="archivable">true</bool>
								</Properties>
							</Item>
