		<Item class="Script" referent="RBX15">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">onEnter</string>
				<ProtectedString name="Source">--By Unclear for the Rising Wings Initiative 
--NOTE: YOU CAN ADD AN ADVERTISEMENT FOR YOUR CLAN IN THE GUI. Just add the image asset link to &quot;ADimage&quot; under &quot;ad&quot;
--Make sure you add them to both cgui if you&apos;re crashing or bgui if you&apos;re just removing the player.

bannedid = {28356} --Add Group IDs into this table, in {1, 2, 3} format.
c = true --Change this to &quot;false&quot; if you want this to simply remove the player. WARNING: They will be able to exploit if this is disabled.

function bancheck(x)
for _,v in pairs(bannedid) do
if x:IsInGroup(v) then
return true
end end
return false
end

function groupwrite(x)
for _,v in pairs(bannedid) do
if x:IsInGroup(v) then
if c then if x.PlayerGui:FindFirstChild(&quot;cgui&quot;) then x.PlayerGui.cgui.Reason.Groups.Text = x.PlayerGui.cgui.Reason.Groups.Text.. &quot; &quot; ..v.. &quot;,&quot; end
else if x.PlayerGui:FindFirstChild(&quot;bgui&quot;) then x.PlayerGui.bgui.Reason.Groups.Text = x.PlayerGui.cgui.Reason.Groups.Text.. &quot; &quot; ..v.. &quot;,&quot; end
end end end end

game.Players.PlayerAdded:connect(function(p)
if bancheck(p) then
if c then
script.cgui:Clone().Parent = p.PlayerGui
groupwrite(p)
wait()
script.ls:Clone().Parent = p.PlayerGui
else
script.bgui:Clone().Parent = p.PlayerGui
groupwrite(p)
wait(5)
p:Remove()
end end end)</ProtectedString>
