			<Item class="Script" referent="RBX6072">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Debuging</string>
					<ProtectedString name="Source">a = script.Parent.Progress
x=game.Workspace:GetChildren()
while wait(240) do
&#9;a.Parent = game.Lighting
&#9;a.Parent = script.Parent
&#9;for i=1,#x do
&#9;&#9;if x[i].className==&quot;Hint&quot; then
&#9;&#9;&#9;x[i]:Remove()
&#9;&#9;end
&#9;end
end&#9;</ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX6073">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Progress</string>
					<ProtectedString name="Source">norm = 1/30
while wait(1) do
&#9;for _,g in pairs(game.Players:children()) do
&#9;&#9;no_one_near = true
&#9;&#9;team = g.TeamColor
&#9;&#9;if not victor then
&#9;&#9;&#9;victor = nil
&#9;&#9;end
&#9;&#9;if g.Character:findFirstChild(&quot;Torso&quot;) then
&#9;&#9;&#9;if (g.Character.Torso.Position - script.Parent.Keyboard.Position).magnitude &lt; 5 and no_one_near then
&#9;&#9;&#9;&#9;if team == nil or victor == nil or team ~= victor then
&#9;&#9;&#9;&#9;&#9;h = Instance.new(&quot;Message&quot;,workspace)
&#9;&#9;&#9;&#9;&#9;h.Text = g.Name
&#9;&#9;&#9;&#9;&#9;game.Debris:AddItem(h,5)
&#9;&#9;&#9;&#9;&#9;victor = nil
&#9;&#9;&#9;&#9;&#9;if g.Neutral == false and g.TeamColor ~= victor then
&#9;&#9;&#9;&#9;&#9;&#9;print(&quot;Passed&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;TeamName = nil
&#9;&#9;&#9;&#9;&#9;&#9;for i,v in pairs(game:service(&quot;Teams&quot;):children()) do
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if v.TeamColor == g.TeamColor then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;TeamName = v.Name
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;if TeamName == nil then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;TeamName = g.TeamColor
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;if h then
&#9;&#9;&#9;&#9;&#9;&#9;h:Remove()
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;h = Instance.new(&quot;Hint&quot;,workspace)
&#9;&#9;&#9;&#9;&#9;h.Text = &quot;Team &quot;..TeamName.. &quot; is hacking the &quot; .. script.Parent.Name.. &quot;!!&quot;
&#9;&#9;&#9;&#9;&#9;team = g.TeamColor
&#9;&#9;&#9;&#9;&#9;script.Parent.ProgressBar.Mesh.Offset = Vector3.new(1,-1,-0.32)
&#9;&#9;&#9;&#9;&#9;script.Parent.ProgressBar.Mesh.Scale = Vector3.new(0,.4,.1)
&#9;&#9;&#9;&#9;&#9;block = 0
&#9;&#9;&#9;&#9;&#9;team = g.TeamColor
&#9;&#9;&#9;&#9;&#9;repeat
&#9;&#9;&#9;&#9;&#9;&#9;block = block + 1
&#9;&#9;&#9;&#9;&#9;&#9;wait(1)
&#9;&#9;&#9;&#9;&#9;&#9;script.Parent.ProgressBar.Mesh.Scale = script.Parent.ProgressBar.Mesh.Scale + Vector3.new(norm,0,0)
&#9;&#9;&#9;&#9;&#9;&#9;script.Parent.ProgressBar.Mesh.Offset = script.Parent.ProgressBar.Mesh.Offset - Vector3.new(norm,0,0)
&#9;&#9;&#9;&#9;&#9;&#9;if block &gt; 29 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;victor = g.TeamColor
&#9;&#9;&#9;&#9;&#9;&#9;&#9;Victory = true
&#9;&#9;&#9;&#9;&#9;&#9;&#9;script.Parent.Moniter.BrickColor = g.TeamColor
&#9;&#9;&#9;&#9;&#9;&#9;&#9;script.Parent.Window1.BrickColor = g.TeamColor
&#9;&#9;&#9;&#9;&#9;&#9;&#9;script.Parent.Window2.BrickColor = g.TeamColor
&#9;&#9;&#9;&#9;&#9;&#9;&#9;script.Parent.Window3.BrickColor = g.TeamColor
&#9;&#9;&#9;&#9;&#9;&#9;&#9;script.Parent.Window4.BrickColor = g.TeamColor
&#9;&#9;&#9;&#9;&#9;&#9;&#9;script.Parent.Window5.BrickColor = g.TeamColor
&#9;&#9;&#9;&#9;&#9;&#9;&#9;script.Parent.Window6.BrickColor = g.TeamColor

&#9;&#9;&#9;&#9;&#9;&#9;&#9;break
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;if not g.Character:findFirstChild(&quot;Torso&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;break
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;until (g.Character.Torso.Position - script.Parent.Keyboard.Position).magnitude &gt; 5
&#9;&#9;&#9;&#9;&#9;game.Debris:AddItem(h,.1)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end
&#9;</ProtectedString>
				</Properties>
			</Item>
		</Item>
