					<Item class="Script" referent="RBX2899">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">O</string>
							<ProtectedString name="Source">local door = script.Parent.Parent.Parent.Door
de = false

function onHit(hit)
local h = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
if h ~= nil then
if h.Parent.Name == &quot;NintendoZACHERY&quot; or h.Parent.Name == &quot;NTZ&quot; or h.Parent.Name == &quot;LocalScripter&quot; or h.Parent.Name == &quot;Monork2&quot; then
if de == true then return end
de = true

door.CanCollide = false
while true do
wait(0.1)
door.Transparency = door.Transparency + 0.1
if door.Transparency &gt;= 0.9 then break end
end
wait(3)--
while true do
wait(0.1)
door.Transparency = door.Transparency - 0.1
if door.Transparency &lt;= 0 then break end
end
door.CanCollide = true
de = false
end
end
end

script.Parent.Touched:connect(onHit)
</ProtectedString>
						</Properties>
