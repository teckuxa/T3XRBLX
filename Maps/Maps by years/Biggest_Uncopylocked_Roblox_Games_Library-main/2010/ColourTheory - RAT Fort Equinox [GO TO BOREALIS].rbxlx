				<Item class="Script" referent="RBX1078">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Fire</string>
						<ProtectedString name="Source">xrot = 0
yrot = 0
brot = 0
xorig = script.Parent.XPivot.CFrame
yorig = script.Parent.YPivot.CFrame
tur = script.Parent
firing = false
sitting = false
bulletnum = 0
function fire()
if firing == false then
spawn = tur.BarrelA.CFrame * CFrame.new(0,1,0) * CFrame.fromEulerAnglesXYZ(math.random(-100,100) / 10000,0,math.random(-100,100) / 10000)
bulletnum = bulletnum + 1
if bulletnum == 4 then
bulletnum = 0
tracer = script.Parent.Tracer:clone()
tracer.CFrame = spawn
tdir = tracer.CFrame * CFrame.fromEulerAnglesXYZ(1.57,0,0)
tracer.BodyVelocity.velocity = tdir.lookVector * 200
tracer.Damager.Disabled = false
tracer.Anchored = false
tracer.Parent = game.Workspace
else
bullet = script.Parent.Bullet:clone()
bullet.CFrame = spawn
bdir = bullet.CFrame * CFrame.fromEulerAnglesXYZ(1.57,0,0)
bullet.BodyVelocity.velocity = bdir.lookVector * 200
bullet.Damager.Disabled = false
bullet.Anchored = false
bullet.Parent = game.Workspace
end
firing = true
for i = 1,3 do
wait()
brot = brot + (2.093 / 3)
end
brot = 0
firing = false
end
end
script.Fire.Changed:connect(fire)
while true do
wait()
script.Fire.Value = false


--ZoomLimits--
if script.Zoom.Value &lt; 0 then
script.Zoom.Value = 0
elseif script.Zoom.Value &gt; 10 then
script.Zoom.Value = 10
end

--CFrames--
tur.YPivot.CFrame = yorig * CFrame.fromEulerAnglesXYZ(0,yrot,0)
tur.XPivot.CFrame = tur.YPivot.CFrame * CFrame.new(0,0.2,0) * CFrame.fromEulerAnglesXYZ(0,0,1.57)
tur.Body.CFrame = tur.YPivot.CFrame * CFrame.new(0,0.2,0) * CFrame.fromEulerAnglesXYZ(xrot,0,0) * CFrame.new(0,0.4,0)
tur.Camera.CFrame = tur.Body.CFrame * CFrame.new(0,0.6,-0.3) * CFrame.fromEulerAnglesXYZ(-1.57,1.57,0)
tur.CameraCF.CFrame = tur.Camera.CFrame * CFrame.new(0,script.Zoom.Value,0)
tur.CameraHead.CFrame = tur.CameraCF.CFrame * CFrame.new(0,1,0)
tur.BarrelBack.CFrame = tur.Body.CFrame * CFrame.new(0,0,-1.2) * CFrame.fromEulerAnglesXYZ(1.57,0,0)
tur.Barrel.CFrame = tur.Body.CFrame * CFrame.new(0,0,-1.2) * CFrame.fromEulerAnglesXYZ(1.57,0,0)
tur.BarrelA.CFrame = tur.BarrelBack.CFrame * CFrame.new(0,-0.1,0) * CFrame.fromEulerAnglesXYZ(0,brot,0) * CFrame.new(0,0,-0.25) * CFrame.fromEulerAnglesXYZ(3.14,1.57,0)
tur.BarrelB.CFrame = tur.BarrelBack.CFrame * CFrame.new(0,-0.1,0) * CFrame.fromEulerAnglesXYZ(0,brot + 2.093,0) * CFrame.new(0,0,-0.25) * CFrame.fromEulerAnglesXYZ(3.14,1.57,0)
tur.BarrelC.CFrame = tur.BarrelBack.CFrame * CFrame.new(0,-0.1,0) * CFrame.fromEulerAnglesXYZ(0,brot - 2.093,0) * CFrame.new(0,0,-0.25) * CFrame.fromEulerAnglesXYZ(3.14,1.57,0)

--Turning--
if xrot &gt; - 0.785 and tur.Parent.Controls.Seat.Throttle == -1 then
xrot = xrot + tur.Parent.Controls.Seat.Throttle * 0.01
elseif xrot &lt; 1.5 and tur.Parent.Controls.Seat.Throttle == 1 then
xrot = xrot + tur.Parent.Controls.Seat.Throttle * 0.01
end
yrot = yrot + tur.Parent.Controls.Seat.Steer * -0.01


--Camerascript--
if tur.Parent.Controls.Seat:findFirstChild(&quot;SeatWeld&quot;) ~= nil and sitting == false then
sitting = true
cam = script.CamScript:clone()
cam.Disabled = false
cam.Parent = game.Players[tur.Parent.Controls.Seat.SeatWeld.Part1.Parent.Name].PlayerGui
tool = script.Turret:clone()
tool.Parent = game.Players[tur.Parent.Controls.Seat.SeatWeld.Part1.Parent.Name].Backpack
end
if tur.Parent.Controls.Seat:findFirstChild(&quot;SeatWeld&quot;) == nil then
sitting = false
end
end
</ProtectedString>
					</Properties>
					<Item class="LocalScript" referent="RBX1079">
						<Properties>
							<bool name="Disabled">true</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">CamScript</string>
							<ProtectedString name="Source">while true do
wait()
if script.Parent.Parent.Character.Humanoid.Sit == true then
game.Workspace.CurrentCamera.CameraSubject = game.Workspace.Turret1.Turret.CameraHead
game.Workspace.CurrentCamera.CoordinateFrame = CFrame.new(game.Workspace.Turret1.Turret.CameraCF.Position) * CFrame.new(0,0,0)
game.Workspace.CurrentCamera.CameraType = &quot;Track&quot;
else
game.Workspace.CurrentCamera.CameraSubject = script.Parent.Parent.Character.Humanoid
game.Workspace.CurrentCamera.CameraType = &quot;Custom&quot;
script.Parent.Parent.Backpack.Turret:remove()
script:remove()
end
end
</ProtectedString>
						</Properties>
					</Item>
					<Item class="BoolValue" referent="RBX1080">
						<Properties>
							<string name="Name">Fire</string>
							<bool name="Value">false</bool>
						</Properties>
					</Item>
					<Item class="HopperBin" referent="RBX1081">
						<Properties>
							<bool name="Active">false</bool>
							<token name="BinType">0</token>
							<string name="Name">Turret</string>
							<Content name="TextureId"><url>http://www.roblox.com/asset/?id=39509774</url></Content>
						</Properties>
						<Item class="LocalScript" referent="RBX1082">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">LocalScript</string>
								<ProtectedString name="Source">firing = false
zoom = 0
function fire(key)
if key:lower() == &quot;l&quot; then
firing = true
elseif key:lower() == &quot;r&quot; then
zoom = .2
elseif key:lower() == &quot;f&quot; then
zoom = -.2
end
end
function remove(key)
if key:lower() == &quot;l&quot; then
firing = false
elseif key:lower() == &quot;r&quot; or key:lower() == &quot;f&quot; then
zoom = 0
end
end

function select(mouse)
mouse.KeyDown:connect(fire)
mouse.KeyUp:connect(remove)
end
script.Parent.Selected:connect(select)

while true do
wait()
game.Workspace.Turret1.Turret.Fire.Zoom.Value = game.Workspace.Turret1.Turret.Fire.Zoom.Value + zoom
if firing == true then
game.Workspace.Turret1.Turret.Fire.Fire.Value = true
end
end
</ProtectedString>
							</Properties>
						</Item>
					</Item>
