				<ProtectedString name="Source">--Easing it for people--
for i,v in pairs(game.Lighting:children()) do
&#9;getfenv(0)[v.Name:gsub(&quot; &quot;,&quot;_&quot;)] = v
end
--Now instead of calling everything in lighting, you can just use a variable that represents the name

--Assigning Specifics--
Groups = {Honors = 200425, Immortals = 239317, Sparrows = 238595, Vindicators = 342702, Medical = 322796, Admirals = 379606}
--Images--
GrandAdmiral_Image = &quot;http://www.roblox.com/asset/?id=50482444&quot;
Admiral_Image = &quot;http://www.roblox.com/asset/?id=50482437&quot;
Sparrow_Image = &quot;http://www.roblox.com/asset/?id=50482453&quot;
HonorImmortal_Image = &quot;http://www.roblox.com/asset/?id=50482425&quot;
Immortal_Image = &quot;http://www.roblox.com/asset/?id=50482417&quot;
Medic_Image = &quot;http://www.roblox.com/asset/?id=62460648&quot;
Vindicator_Image = &quot;http://www.roblox.com/asset/?id=62460646&quot;
Honor_Image = &quot;http://www.roblox.com/asset/?id=50482405&quot;
--Weapons--
Weapons = {
&#9;HonorGuns = {SPPulse},
&#9;VindGuns = {SPFragmentor},
&#9;MedGuns = {SPRecovery},
&#9;ImmortalGuns = {SPSupressor},
&#9;HonorImmortalGuns = {SPPulse,SPSupressor},
&#9;SparrowGuns = {SPNisus,SPTerminator,SPLancers,AdvancedPlane,SPFragmentor,SPScouter,SPJetpack,SPSupressor},
&#9;AdmiralGuns = {SPNisus,SPLancers,SPTerminator,SPPulse,SPScouter,SPJetpack,SPFragmentor,SPSupressor},
&#9;GrandAdmiralGuns = {SPFlight,SPTerminator,SPMauler,SPJetpack,SPRecovery,SPPulse,SPScouter,SPNisus,SPFragmentor,SPMenace}
}
--Script--
game.Players.PlayerAdded:connect(function(p)
&#9;p.CharacterAdded:connect(function()
&#9;&#9;idAssigned = false
&#9;&#9;Identity = Instance.new(&quot;BillboardGui&quot;)
&#9;&#9;Identity.Size = UDim2.new(6,0,1.5,0)
&#9;&#9;Identity.StudsOffset = Vector3.new(0,3,0)
&#9;&#9;Identity.Name = &quot;Identity&quot;..p.Name
&#9;&#9;Image = Instance.new(&quot;ImageLabel&quot;,Identity)
&#9;&#9;Image.Size = UDim2.new(1,0,1,0)
&#9;&#9;Image.BackgroundTransparency = 1
&#9;&#9;if p.Name:lower() == &quot;colourtheory&quot; then  -- 8
&#9;&#9;&#9;print(&quot;CT&quot;)
&#9;&#9;&#9;Image.Image = GrandAdmiral_Image
&#9;&#9;&#9;idAssigned = true
&#9;&#9;&#9;for i,v in pairs(Weapons.GrandAdmiralGuns) do
&#9;&#9;&#9;&#9;if p:findFirstChild(&quot;Backpack&quot;) then
&#9;&#9;&#9;&#9;&#9;v:clone().Parent = p.Backpack
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;if p:IsInGroup(Groups.Admirals) then -- 7
&#9;&#9;&#9;if not idAssigned then
&#9;&#9;&#9;&#9;for i,v in pairs(Weapons.AdmiralGuns) do
&#9;&#9;&#9;&#9;&#9;if p:findFirstChild(&quot;Backpack&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;v:clone().Parent = p.Backpack
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;idAssigned = true
&#9;&#9;&#9;&#9;Image.Image = Admiral_Image
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;if p:IsInGroup(Groups.Sparrows) then -- 6
&#9;&#9;&#9;if not idAssigned then
&#9;&#9;&#9;&#9;for i,v in pairs(Weapons.SparrowGuns) do
&#9;&#9;&#9;&#9;&#9;if p:findFirstChild(&quot;Backpack&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;v:clone().Parent = p.Backpack
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;idAssigned = true
&#9;&#9;&#9;&#9;Image.Image = Sparrow_Image
&#9;&#9;&#9;end
&#9;&#9;elseif p:IsInGroup(Groups.Honors) and p:IsInGroup(Groups.Immortals) then -- 5
&#9;&#9;&#9;if not idAssigned then
&#9;&#9;&#9;&#9;for i,v in pairs(Weapons.HonorImmortalGuns) do
&#9;&#9;&#9;&#9;&#9;if p:findFirstChild(&quot;Backpack&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;v:clone().Parent = p.Backpack
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;idAssigned = true
&#9;&#9;&#9;&#9;Image.Image = HonorImmortal_Image
&#9;&#9;&#9;end
&#9;&#9;elseif p:IsInGroup(Groups.Immortals) then -- 4
&#9;&#9;&#9;if not idAssigned then
&#9;&#9;&#9;&#9;for i,v in pairs(Weapons.ImmortalGuns) do
&#9;&#9;&#9;&#9;&#9;if p:findFirstChild(&quot;Backpack&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;v:clone().Parent = p.Backpack
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;idAssigned = true
&#9;&#9;&#9;&#9;Image.Image = Immortal_Image
&#9;&#9;&#9;end
&#9;&#9;elseif p:IsInGroup(Groups.Honors)then -- 3
&#9;&#9;&#9;if not idAssigned then
&#9;&#9;&#9;&#9;for i,v in pairs(Weapons.HonorGuns) do
&#9;&#9;&#9;&#9;&#9;if p:findFirstChild(&quot;Backpack&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;v:clone().Parent = p.Backpack
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;idAssigned = true
&#9;&#9;&#9;&#9;Image.Image = Honor_Image
&#9;&#9;&#9;end
&#9;&#9;elseif p:IsInGroup(Groups.Vindicators) then -- 2
&#9;&#9;&#9;if not idAssigned then
&#9;&#9;&#9;&#9;for i,v in pairs(Weapons.VindGuns) do
&#9;&#9;&#9;&#9;&#9;if p:findFirstChild(&quot;Backpack&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;v:clone().Parent = p.Backpack
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;idAssigned = true
&#9;&#9;&#9;&#9;Image.Image = Vindicator_Image
&#9;&#9;&#9;end
&#9;&#9;elseif p:IsInGroup(Groups.Medical) then -- 1
&#9;&#9;&#9;if not idAssigned then
&#9;&#9;&#9;&#9;for i,v in pairs(Weapons.MedGuns) do
&#9;&#9;&#9;&#9;&#9;if p:findFirstChild(&quot;Backpack&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;v:clone().Parent = p.Backpack
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;idAssigned = true
&#9;&#9;&#9;&#9;Image.Image = Medic_Image
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;if not idAssigned then
&#9;&#9;&#9;Identity:remove()
&#9;&#9;else
&#9;&#9;&#9;for i,v in pairs(game.Players:children()) do 
&#9;&#9;&#9;&#9;if v:findFirstChild(&quot;PlayerGui&quot;) then
&#9;&#9;&#9;&#9;&#9;pcall(function()
&#9;&#9;&#9;&#9;&#9;&#9;give = Identity:clone()
&#9;&#9;&#9;&#9;&#9;&#9;give.Parent = v.PlayerGui
&#9;&#9;&#9;&#9;&#9;&#9;give.Adornee = p.Character.Head
&#9;&#9;&#9;&#9;&#9;end)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end&#9;
&#9;&#9;for i,v in pairs(game.Players:children()) do
&#9;&#9;&#9;if v.Name ~= p.Name then
&#9;&#9;&#9;&#9;if v:findFirstChild(&quot;PlayerGui&quot;) then
&#9;&#9;&#9;&#9;&#9;if v.PlayerGui:findFirstChild(&quot;Identity&quot;..v.Name) then
&#9;&#9;&#9;&#9;&#9;&#9;pcall(function()
&#9;&#9;&#9;&#9;&#9;&#9;&#9;take = v.PlayerGui[&quot;Identity&quot;..v.Name]:Clone()
&#9;&#9;&#9;&#9;&#9;&#9;&#9;take.Parent = p.PlayerGui
&#9;&#9;&#9;&#9;&#9;&#9;&#9;take.Adornee = v.Character.Head
&#9;&#9;&#9;&#9;&#9;&#9;end)
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end)
end)
