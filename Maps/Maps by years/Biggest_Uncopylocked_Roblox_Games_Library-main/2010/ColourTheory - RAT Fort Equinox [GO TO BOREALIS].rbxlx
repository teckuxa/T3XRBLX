						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">MasterScript</string>
						<ProtectedString name="Source">Code = &quot;0652&quot; --Heres where you put your own code.
Input = &quot;&quot; --Keep this blank.
Animation = false --Turn Sliding Door On? Say &apos;true&apos; if you want it on, and &apos;false&apos; if you want it off.



------------------------------------------
--Clear, Enter, And Open

de = false

function Clear()
print(&quot;Cleared&quot;)
Input = &quot;&quot;
end

script.Parent.Clear.ClickDetector.MouseClick:connect(Clear)

function Enter()
if Input == Code then
print(&quot;Entered&quot;)
Input = &quot;&quot;

local door = script.Parent.Parent.Door
if de == true then return end
de = true

if Animation == false then
door.CanCollide = false
while true do
wait(0.1)
door.Transparency = door.Transparency + 0.1
if door.Transparency &gt;= 0.9 then break end
end
print(&quot;Opened&quot;)
wait(3)--
while true do
wait(0.1)
door.Transparency = door.Transparency - 0.1
if door.Transparency &lt;= 0 then break end
end
door.CanCollide = true
print(&quot;Closed&quot;)
de= false

else

frame = script.Parent.Parent.Frame
k = 0
while true do
wait()
if k &gt;= 45 then break end
k = k + 1
door.CFrame = door.CFrame - frame.ThickBrick.CFrame.lookVector * 0.195
end
print(&quot;Opened&quot;)
wait(3)
k = 0
while true do
wait()
if k &gt;= 45 then break end
k = k + 1
door.CFrame = door.CFrame + frame.ThickBrick.CFrame.lookVector * 0.195
end
print(&quot;Closed&quot;)
de = false
end
return end
Input = &quot;&quot;
print(&quot;Wrong Code&quot;)
end

script.Parent.Enter.ClickDetector.MouseClick:connect(Enter)

function Open()
local door = script.Parent.Parent.Door
if de == true then return end
de = true

if Animation == false then
door.CanCollide = false
while true do
wait(0.1)
door.Transparency = door.Transparency + 0.1
if door.Transparency &gt;= 0.9 then break end
end
print(&quot;Opened&quot;)
wait(3)--
while true do
wait(0.1)
door.Transparency = door.Transparency - 0.1
if door.Transparency &lt;= 0 then break end
end
door.CanCollide = true
print(&quot;Closed&quot;)
de= false

else

frame = script.Parent.Parent.Frame
k = 0
while true do
wait()
if k &gt;= 45 then break end
k = k + 1
door.CFrame = door.CFrame - frame.ThickBrick.CFrame.lookVector * 0.195
end
print(&quot;Opened&quot;)
wait(3)
k = 0
while true do
wait()
if k &gt;= 45 then break end
k = k + 1
door.CFrame = door.CFrame + frame.ThickBrick.CFrame.lookVector * 0.195
end
de = false
print(&quot;Closed&quot;)
end
end

script.Parent.Parent:findFirstChild(&quot;Open&quot;).ClickDetector.MouseClick:connect(Open)

