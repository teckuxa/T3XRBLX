&#9;&#9;&#9;&#9;if script.Speed.Value ~= 70 then script.Speed.Value = 70 end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;if power ~=nil then
&#9;&#9;&#9;&#9;if boostDB == 0 then
&#9;&#9;&#9;&#9;boostDB = 1
&#9;&#9;&#9;&#9;wait (1)
&#9;&#9;&#9;&#9;boostDB = 0
&#9;&#9;&#9;&#9;elseif boostDB == 1 and script.Boost.Value == 0 then
&#9;&#9;&#9;&#9;script.Boost.Value = 1
&#9;&#9;&#9;&#9;script.Speed.Value = 150
&#9;&#9;&#9;&#9;power.velocity = (plane.Engine.CFrame.lookVector * script.Speed.Value)
&#9;&#9;&#9;&#9;wait (5)
&#9;&#9;&#9;&#9;script.Speed.Value = 70
&#9;&#9;&#9;&#9;power.velocity = (plane.Engine.CFrame.lookVector * 100)
&#9;&#9;&#9;&#9;script.Boost.Value = 2
&#9;&#9;&#9;&#9;wait (15)
&#9;&#9;&#9;&#9;script.Boost.Value = 0
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;
&#9;&#9;&#9;end

end

