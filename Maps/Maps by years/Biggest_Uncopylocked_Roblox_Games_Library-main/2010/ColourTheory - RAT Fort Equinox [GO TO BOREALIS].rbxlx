					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">model = script.Parent.Parent.Savato
regen = script.Parent.Regen
backup = model:clone()


function regenerate()
&#9;if script.Parent.Parent:findFirstChild(&quot;Savato&quot;) ~=nil then script.Parent.Parent:findFirstChild(&quot;Savato&quot;):remove() end
&#9;script.Parent.Reflectance = .5
&#9;regen.Value = 1
&#9;wait(2)
&#9;model = backup:clone()
&#9;model.Parent = script.Parent.Parent
&#9;model:makeJoints()
&#9;regen.Value = 0
&#9;script.Parent.Reflectance = 0
end

function onHit(hit)
&#9;if script.Parent.Regen.Value == 0 then
&#9;&#9;regenerate()
&#9;end
end

script.Parent.Touched:connect(onHit)

</ProtectedString>
					</Properties>
				</Item>
