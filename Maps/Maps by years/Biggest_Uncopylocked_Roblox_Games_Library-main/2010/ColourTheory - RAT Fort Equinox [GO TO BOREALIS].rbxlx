&#9;if hit.Name == &quot;Building&quot; or
&#9;hit.Name == &quot;Safe&quot; then
&#9;&#9;swoosh:stop()
&#9;&#9;shaft:remove()
&#9;return end

&#9;if hit.Name == &quot;Shield&quot; then
&#9;&#9;shieldpoints = hit.ShieldPower
&#9;&#9;if (shieldpoints.Value &gt; 0) then
&#9;&#9;&#9;shieldpoints.Value = shieldpoints.Value - 5
&#9;&#9;&#9;shieldtransparency = hit.Transparent
&#9;&#9;&#9;shieldtransparency.Value = shieldtransparency.Value - 5
&#9;&#9;&#9;swoosh:stop()
&#9;&#9;&#9;shaft:remove()
&#9;&#9;end
&#9;return end

&#9;local shield = nil

&#9;if (hit.Parent.Parent:FindFirstChild(&quot;Parts&quot;) ~= nil) then
&#9;&#9;local shield = hit.Parent.Parent.Parts:FindFirstChild(&quot;Shield&quot;)
&#9;end

&#9;if shield ~= nil then
&#9;&#9;shieldpoints = shield.ShieldPower
&#9;&#9;if (shieldpoints.Value &gt; 0) then
&#9;&#9;&#9;shieldpoints.Value = shieldpoints.Value - 5
&#9;&#9;&#9;shieldtransparency = hit.Transparent
&#9;&#9;&#9;shieldtransparency.Value = shieldtransparency.Value - 5
&#9;&#9;&#9;swoosh:stop()
&#9;&#9;&#9;shaft:remove()
&#9;&#9;end
&#9;return end

&#9;local parent = hit.Parent.Parent
&#9;local owner = shaft.Owner
&#9;if owner ~= nil then
&#9;&#9;if parent ~= nil and owner.Value ~= nil then
&#9;&#9;&#9;if parent ~= owner.Value then
&#9;&#9;&#9;&#9;local stunt = parent:FindFirstChild(&quot;Stunt&quot;)
&#9;&#9;&#9;&#9;if stunt ~= nil then
&#9;&#9;&#9;&#9;&#9;if stunt.Value ~= 1 then
&#9;&#9;&#9;&#9;&#9;&#9;blow(hit)
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;blow(hit)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

function onPlayerBlownUp(part, distance, creator)
&#9;if part.Name == &quot;Head&quot; then
&#9;&#9;local humanoid = part.Parent:FindFirstChild(&quot;Humanoid&quot;)
&#9;&#9;if (humanoid ~= nil) then
&#9;&#9;&#9;tagHumanoid(humanoid, creator)
&#9;&#9;end
&#9;&#9;if (humanoid == nil) then
&#9;&#9;&#9;local humanoid = part.Parent:FindFirstChild(&quot;Reactor&quot;)
&#9;&#9;&#9;if (humanoid ~= nil) then
&#9;&#9;&#9;&#9;distance = (explosion.Position - part.Position).magnitude
&#9;&#9;&#9;&#9;if (distance &lt; 5) then
&#9;&#9;&#9;&#9;&#9;humanoid.Value = humanoid.Value - 187.5
&#9;&#9;&#9;&#9;else humanoid.Value = humanoid.Value - 4687.5/(distance*distance)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

function tagHumanoid(humanoid, creator)
&#9;if creator ~= nil then
&#9;&#9;local new_tag = creator:clone()
&#9;&#9;new_tag.Parent = humanoid
&#9;end
end

function untagHumanoid(humanoid)
&#9;if humanoid ~= nil then
&#9;&#9;local tag = humanoid:findFirstChild(&quot;creator&quot;)
&#9;&#9;if tag ~= nil then
&#9;&#9;&#9;tag:Remove()
&#9;&#9;end
&#9;end
end

t, s = r.Stepped:wait()

swoosh = script.Parent.Swoosh
swoosh:play()

d = t + 0.5 - s
connection = shaft.Touched:connect(onTouch)

while t &lt; d do
&#9;fly()
&#9;t = r.Stepped:wait()
end

-- at max range
script.Parent.Explosion.PlayOnRemove = false
swoosh:stop()
shaft:remove()
