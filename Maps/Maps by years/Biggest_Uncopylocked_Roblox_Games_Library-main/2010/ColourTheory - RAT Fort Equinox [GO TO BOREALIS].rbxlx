			<Item class="Animation" referent="RBX7499">
				<Properties>
					<Content name="AnimationId"><null></null></Content>
					<string name="Name">standstill</string>
				</Properties>
			</Item>
			<Item class="NumberValue" referent="RBX7500">
				<Properties>
					<string name="Name">CurrFuel</string>
					<double name="Value">998426</double>
				</Properties>
