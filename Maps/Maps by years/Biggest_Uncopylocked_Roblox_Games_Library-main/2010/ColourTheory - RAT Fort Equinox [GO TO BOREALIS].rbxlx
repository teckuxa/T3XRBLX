		<Item class="Script" referent="RBX56">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">VIP_EntranceWeapons</string>
				<ProtectedString name="Source">--Hurpus Derpus
function onPlayerRespawned(newPlayer)
&#9;wait(5)
&#9;if newPlayer.Character.Torso.roblox.Texture == &quot;http://www.roblox.com/asset/?id=24905365&quot; then
&#9;w = game.Lighting.Weps:GetChildren()
&#9;for i = 1,#w do
&#9;&#9;w[i]:Clone().Parent = newPlayer.Backpack
&#9;end
&#9;end
end

function onPlayerEntered(newPlayer)
&#9;newPlayer.Changed:connect(function (property)
&#9;&#9;if (property == &quot;Character&quot;) then
&#9;&#9;&#9;onPlayerRespawned(newPlayer)
&#9;&#9;end
&#9;end)
end

game.Players.PlayerAdded:connect(onPlayerEntered)</ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX57">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">BadgeRegen</string>
				<ProtectedString name="Source">-- C

model = game.Workspace.BadgeAwarder --Where it says &quot;ModelName&quot; put the name of the model you want to regen.
backup = model:clone() -- makes a backup copy of your model, which you will use later

function onChatted(msg, recipient, speaker) 

local source = string.lower(speaker.Name)
msg = string.lower(msg) --If you have caps troubles, not a problem! It will still work=D

if (msg == &quot;badge&quot;) then --Change The Word That you want them to Chat To Regen

model:remove()
model = backup:clone() 
model.Parent = game.Workspace 
model:makeJoints() 
end 

end 

--This is very important for the script
function onPlayerEntered(newPlayer) 
newPlayer.Chatted:connect(function(msg, recipient) onChatted(msg, recipient, newPlayer) end) 
end 

game.Players.ChildAdded:connect(onPlayerEntered)

--Remember the word you have to say to regen it. =D
--Please report any problems to arrarr06.

--</ProtectedString>
			</Properties>
		</Item>
