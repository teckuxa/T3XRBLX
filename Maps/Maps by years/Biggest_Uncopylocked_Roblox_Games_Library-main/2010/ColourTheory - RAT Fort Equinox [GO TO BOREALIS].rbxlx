						<Item class="Script" referent="RBX794">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">ToolGiver</string>
								<ProtectedString name="Source">debounce = true

turret = game.Lighting.Turret:clone()

script.Parent.Touched:connect(function(hit)
if hit == nil or hit.Parent == nil then return end
p = game.Players:playerFromCharacter(hit.Parent)
if p ~= nil and debounce then
debounce = false
c = turret:clone()
c.Turret.Value = script.Parent.Parent.Parent.Parts.Gun2
c.Parent = p.Backpack
end
end)

while true do
wait()
if script.Parent:findFirstChild(&quot;SeatWeld&quot;) then
debounce = false
else
debounce = true
if c ~= nil then
c:Remove()
end
end
end
</ProtectedString>
							</Properties>
						</Item>
					</Item>
				</Item>
			</Item>
