				<Item class="Script" referent="RBX4313">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">GiveScript</string>
						<ProtectedString name="Source">--[[
&#9;Now lets get to scripting. In line 30 change Parachute in
game.Lighting.Parachute:clone() to whatever you want your weapon/tool
to be named. Next, in line 32, change the number 1 in wait(1) to the
wait time between gives. I advise to leave that to avoid making players
frustrated.
]]

local debounce = false

function getPlayer(humanoid) 
local players = game.Players:children() 
for i = 1, #players do 
if players[i].Character.Humanoid == humanoid then return players[i] end 
end 
return nil 
end 

function onTouch(part) 

local human = part.Parent:findFirstChild(&quot;Humanoid&quot;) 
if (human ~= nil) and debounce == false then

debounce = true

local player = getPlayer(human) 

if (player == nil) then return end 

game.Lighting.SPCyclone:clone().Parent = player.Backpack
game.Lighting.SPLancers:clone().Parent = player.Backpack
game.Lighting.SPScouter:clone().Parent = player.Backpack
game.Lighting.Plane:clone().Parent = player.Backpack

wait(5)
debounce = false
end
end


script.Parent.Touched:connect(onTouch)</ProtectedString>
