			<Item class="LocalScript" referent="RBX6705">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">LocalScript</string>
					<ProtectedString name="Source">debounce = true
firing = false
tur = script.Parent.Turret
player = nil

x = Instance.new(&quot;Part&quot;)
x.Anchored = true
x.formFactor = 0
x.Shape = 0
x.Size = Vector3.new(1,1,1)
x.BrickColor = BrickColor.DarkGray()
Instance.new(&quot;Smoke&quot;,x)

local function rayCast(Pos, Dir, Max, Ignore) 
return Workspace:FindPartOnRay(Ray.new(Pos, Dir.unit * (Max or 999.999)), Ignore) 
end 

function fire(part, dir, ignore)
if p ~= nil then p:Remove() end
firepos = part.Position+part.CFrame.lookVector*part.Size.Z/2
hit,pos = rayCast(firepos, dir, nil, ignore)
p = Instance.new(&quot;Part&quot;)
p.BrickColor = BrickColor.Red()
p.FormFactor = &quot;Custom&quot; 
p.CanCollide = false 
p.Anchored = true
p.Size = Vector3.new(1,1,1)
bm = Instance.new(&quot;BlockMesh&quot;,p)
bm.Scale = Vector3.new(0.15, 0.15, (firepos - pos).magnitude) 
bm.Offset = Vector3.new(0,0,-(firepos - pos).magnitude/2)
p.CFrame = CFrame.new(firepos, pos) 
p.Parent = workspace
x.CFrame = CFrame.new(pos)
x.Parent = workspace
pcall(function() tagHumanoid(hit.Parent.Humanoid, player) hit.Parent.Humanoid:TakeDamage(3) end)
game:service(&quot;Debris&quot;):AddItem(p,0.1)
end

function onSelected(m)
m.Icon = &quot;http://www.roblox.com/asset/?id=46165652&quot;
player = game.Players.LocalPlayer

function onButton1Down(m)
if not debounce then return end
debounce = false
firing = true
tur.Value.Fire:Play()
while firing do
wait()
fire(tur.Value, (m.Hit.p-tur.Value.Position), x)
end
game:service(&quot;Debris&quot;):AddItem(x,0.1)
end

function onButton1Up(m)
m.Icon = &quot;http://www.roblox.com/asset/?id=46165664&quot;
firing = false
tur.Value.Fire:Stop()
tur.Value.Reload:Play()
repeat 
wait()
until tur.Value.Reload.IsPlaying == false
debounce = true
m.Icon = &quot;http://www.roblox.com/asset/?id=46165652&quot;
end
m.Button1Down:connect(function() onButton1Down(m) end)
m.Button1Up:connect(function() onButton1Up(m) end)
end

function tagHumanoid(humanoid, player)
&#9;if creator_tag ~= nil then creator_tag:Remove() end
&#9;creator_tag = Instance.new(&quot;ObjectValue&quot;)
&#9;creator_tag.Value = player
&#9;creator_tag.Name = &quot;creator&quot;
&#9;creator_tag.Parent = humanoid
&#9;game:service(&quot;Debris&quot;):AddItem(creator_tag, 1)
end

script.Parent.Selected:connect(onSelected)
</ProtectedString>
