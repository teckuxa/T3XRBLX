					<ProtectedString name="Source">bin=script.Parent
plane=nil
hold=false
local debounce = false
local planedebounce = false
local stuntdebounce = false
local controlling = false

function shoot(pln,spn)
&#9;local laser = script.Laser:clone()
&#9;laser.CFrame = spn.CFrame * CFrame.new(0, 0, -45)

&#9;laser.LaserScript.Disabled = false
&#9;laser.Parent = game.Workspace

&#9;local bv = pln.BodyVelocity:clone()
&#9;bv.Parent = laser
&#9;bv.velocity = (laser.CFrame.lookVector * 300)
&#9;
&#9;local creator_tag = Instance.new(&quot;ObjectValue&quot;)
&#9;creator_tag.Value = script.Parent.Parent.Parent
&#9;creator_tag.Name = &quot;creator&quot;
&#9;creator_tag.Parent = laser
end

function findPlane(player)
&#9;local list = player.Character:GetChildren()
&#9;for x = 1, #list do
&#9;&#9;if (list[x].Name == &quot;Heli&quot;) then
&#9;&#9;&#9;local weld = list[x]:FindFirstChild(&quot;Parts&quot;):FindFirstChild(&quot;Seat&quot;):FindFirstChild(&quot;SeatWeld&quot;)
&#9;&#9;&#9;if (weld ~= nil) and (weld.Part1 == player.Character:FindFirstChild(&quot;Torso&quot;)) then
&#9;&#9;&#9;&#9;return list[x]
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;return nil
end

function move(target, engine)
&#9;local origincframe = engine:findFirstChild(&quot;BodyGyro&quot;).cframe
&#9;local dir = (target - engine.Position).unit
&#9;local spawnPos = engine.Position
&#9;local bv = engine:findFirstChild(&quot;BodyVelocity&quot;)
&#9;local pos = spawnPos + (dir * 1)

&#9;engine:findFirstChild(&quot;BodyGyro&quot;).maxTorque = Vector3.new(40000, 40000, 40000)
&#9;engine:findFirstChild(&quot;BodyGyro&quot;).cframe = CFrame.new(pos,  pos + dir)
&#9;wait(0.1)
&#9;if bv~=nil then
&#9;bv.velocity = (engine.CFrame.lookVector * script.Speed.Value) end


end



function onButton1Down(mouse)
&#9;local vehicle = findPlane(script.Parent.Parent.Parent)
&#9;if vehicle ~= nil and debounce == false and planedebounce == false then
&#9;debounce = true

&#9;controlling = true

&#9;while true do
&#9;&#9;wait()
&#9;&#9;local engine = vehicle.Parts.Engine
&#9;&#9;local position = mouse.Hit
&#9;&#9;local target = position.p
&#9;&#9;if engine:findFirstChild(&quot;BodyVelocity&quot;) ~= nil then
&#9;&#9;move(target, engine)
&#9;&#9;end
&#9;&#9;if planedebounce == true or
&#9;&#9;controlling == false then break end
&#9;end
&#9;wait(.1)
&#9;debounce = false
&#9;end
end

function onButton1Up(mouse)
&#9;controlling = false
end

function onSelected(mouse)
&#9;mouse.Icon = &quot;http://www.roblox.com/asset/?id=46165652&quot;
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
&#9;mouse.Button1Up:connect(function() onButton1Up(mouse) end)
&#9;mouse.KeyDown:connect(onKeyDown)
end



function onKeyDown(key)
&#9;if (key~=nil) then
&#9;&#9;key = key:lower()
&#9;&#9;local vehicle = findPlane(script.Parent.Parent.Parent)
&#9;&#9;if (vehicle==nil) then return end
&#9;&#9;plane = vehicle.Parts
&#9;&#9;local engine = vehicle.Parts.Engine
&#9;&#9;&#9;if (key==&quot;f&quot;) and (bin.Reload.Value == 0) then
&#9;&#9;&#9;&#9;bin.Reload.Value = 1
&#9;&#9;&#9;&#9;shoot(vehicle,plane.Gun1)
&#9;&#9;&#9;&#9;wait(0.08)
&#9;&#9;&#9;&#9;shoot(vehicle,plane.Gun1)
&#9;&#9;&#9;&#9;wait(0.08)
&#9;&#9;&#9;&#9;shoot(vehicle,plane.Gun1)
&#9;&#9;&#9;&#9;wait(.2)
&#9;&#9;&#9;&#9;bin.Reload.Value = 0
&#9;&#9;&#9;end

&#9;&#9;&#9;if (key==&quot;x&quot;) and planedebounce == false then
&#9;&#9;&#9;&#9;if engine:findFirstChild(&quot;BodyGyro&quot;)~=nil then engine:findFirstChild(&quot;BodyGyro&quot;).maxTorque = Vector3.new(0, 0, 0) end
&#9;&#9;&#9;&#9;local power = plane.Engine:findFirstChild(&quot;BodyVelocity&quot;)
&#9;&#9;&#9;&#9;if (power ~= nil) then
&#9;&#9;&#9;&#9;if script.Speed.Value == 0 then
&#9;&#9;&#9;&#9;power:remove()
&#9;&#9;&#9;&#9;script.Speed.Value = 75
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;script.Speed.Value = 0
&#9;&#9;&#9;&#9;power.velocity = (power.Parent.CFrame.lookVector * script.Speed.Value)
&#9;&#9;&#9;&#9;end&#9;&#9;&#9;&#9;
&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;if (key==&quot;y&quot;) then
&#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;local power = plane.Engine:findFirstChild(&quot;BodyVelocity&quot;)
&#9;&#9;&#9;&#9;if (power == nil) then
&#9;&#9;&#9;&#9;local fly = vehicle.BodyVelocity:clone()
&#9;&#9;&#9;&#9;fly.Parent = plane.Engine
&#9;&#9;&#9;&#9;fly.velocity = (plane.Engine.CFrame.lookVector * 100)
&#9;&#9;&#9;&#9;if script.Speed.Value ~= 75 then script.Speed.Value = 75 end
&#9;&#9;&#9;&#9;elseif power ~=nil then
&#9;&#9;&#9;&#9;power.velocity = (plane.Engine.CFrame.lookVector * 100)
&#9;&#9;&#9;&#9;if script.Speed.Value ~= 75 then script.Speed.Value = 75 end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;
&#9;&#9;&#9;end

end

bin.Selected:connect(onSelected)

