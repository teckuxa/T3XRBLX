			<Properties>
				<bool name="Active">false</bool>
				<token name="BinType">0</token>
				<string name="Name">Turret</string>
				<Content name="TextureId"><null></null></Content>
			</Properties>
			<Item class="ObjectValue" referent="RBX6704">
				<Properties>
					<string name="Name">Turret</string>
					<Ref name="Value">null</Ref>
				</Properties>
