						</Properties>
					</Item>
					<Item class="HopperBin" referent="RBX1154">
						<Properties>
							<bool name="Active">false</bool>
							<token name="BinType">0</token>
							<string name="Name">Turret</string>
							<Content name="TextureId"><url>http://www.roblox.com/asset/?id=39509774</url></Content>
						</Properties>
						<Item class="LocalScript" referent="RBX1155">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">LocalScript</string>
								<ProtectedString name="Source">firing = false
zoom = 0
function fire(key)
if key:lower() == &quot;l&quot; then
firing = true
elseif key:lower() == &quot;r&quot; then
zoom = .2
elseif key:lower() == &quot;f&quot; then
zoom = -.2
end
end
function remove(key)
if key:lower() == &quot;l&quot; then
firing = false
elseif key:lower() == &quot;r&quot; or key:lower() == &quot;f&quot; then
zoom = 0
end
end

function select(mouse)
mouse.KeyDown:connect(fire)
mouse.KeyUp:connect(remove)
end
script.Parent.Selected:connect(select)

while true do
wait()
game.Workspace.Turret2.Turret.Fire.Zoom.Value = game.Workspace.Turret2.Turret.Fire.Zoom.Value + zoom
if firing == true then
game.Workspace.Turret2.Turret.Fire.Fire.Value = true
end
end
</ProtectedString>
							</Properties>
						</Item>
					</Item>
