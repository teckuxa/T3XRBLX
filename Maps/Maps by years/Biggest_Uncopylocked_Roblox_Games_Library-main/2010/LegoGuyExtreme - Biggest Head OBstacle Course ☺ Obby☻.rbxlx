					<string name="Name">Script</string>
					<ProtectedString name="Source">script.Parent.Sound:Play()
wait(0.5)
script.Parent.Sound:Stop()

s = Instance.new(&quot;Sound&quot;)
s.SoundId = &quot;http://www.roblox.com/asset?id=27697735&quot;
s.Pitch = 5
s.Volume = 1
s.Looped = true
s.Parent = script.Parent
wait(0.1)
s:Play()


