							<string name="Name">Script</string>
							<ProtectedString name="Source">local MaxSpeed = 50
local MaxReverse = 
local en = script.Parent
while true do 
wait(0)
if en.Throttle == 1 and en.Speed.Value &lt; MaxSpeed then 
wait(0.1)
en.Speed.Value = en.Speed.Value + 1
elseif en.Throttle == -1 and en.Speed.Value &gt; MaxReverse then 
wait(0.1)
en.Speed.Value = en.Speed.Value - 1
end 
end </ProtectedString>
