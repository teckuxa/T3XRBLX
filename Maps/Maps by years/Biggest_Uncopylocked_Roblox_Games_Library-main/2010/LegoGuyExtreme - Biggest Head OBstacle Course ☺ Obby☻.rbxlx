					<Item class="Script" referent="RBX89">
						<Properties>
							<bool name="Archivable">true</bool>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Hurt</string>
							<ProtectedString name="Source">function onTouched(hit)
find = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
if find ~= nil then
if script.Parent.Up.Value == 0 then
hit.Parent.Humanoid.Health = hit.Parent.Humanoid.Health - 50
end
end
end

script.Parent.Touched:connect(onTouched)

</ProtectedString>
