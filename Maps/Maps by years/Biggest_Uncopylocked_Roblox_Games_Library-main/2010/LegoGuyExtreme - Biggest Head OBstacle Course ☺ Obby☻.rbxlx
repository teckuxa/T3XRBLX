                sound = Instance.new(&quot;Sound&quot;)
&#9;&#9;sound.Name = &quot;InflateSound&quot;
&#9;&#9;sound.SoundId = &quot;http://www.roblox.com/asset/?id=11895499&quot;
                sound.Parent = player.Character
                sound:Play()
&#9;&#9;player.Character.Head.Mesh.Scale = Vector3.new(1.5,1.5,1.5)
&#9;&#9;wait(.1)
&#9;&#9;player.Character.Head.Mesh.Scale = Vector3.new(1.75,1.75,1.75)
