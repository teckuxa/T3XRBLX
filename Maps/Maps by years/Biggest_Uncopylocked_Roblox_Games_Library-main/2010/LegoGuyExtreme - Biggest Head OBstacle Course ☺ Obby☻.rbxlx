						</Item>
						<Item class="Script" referent="RBX1140">
							<Properties>
								<bool name="Archivable">true</bool>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<ProtectedString name="Source">while true do 
wait(0)
if script.Parent.Parent.Speed.Value == 0 then 
script.Parent.maxForce = Vector3.new(0, 0, 0)
else
script.Parent.maxForce = Vector3.new(4000000000, 4000000000, 4000000000)
end
end </ProtectedString>
							</Properties>
						</Item>
					</Item>
					<Item class="Script" referent="RBX1141">
						<Properties>
							<bool name="Archivable">true</bool>
							<bool name="Disabled">true</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">local MaxSpeed = 50
local MaxReverse = 
local en = script.Parent
while true do 
wait(0)
if en.Throttle == 1 and en.Speed.Value &lt; MaxSpeed then 
wait(0.1)
en.Speed.Value = en.Speed.Value + 1
elseif en.Throttle == -1 and en.Speed.Value &gt; MaxReverse then 
wait(0.1)
en.Speed.Value = en.Speed.Value - 1
end 
end </ProtectedString>
						</Properties>
					</Item>
