&#9;&#9;wait(.1)
&#9;&#9;player.Character.Head.Mesh.Scale = Vector3.new(4,4,4)
&#9;&#9;wait(.1)
&#9;&#9;player.Character.Head.Mesh.Scale = Vector3.new(4.25,4.25,4.25)
&#9;&#9;wait(.1)
&#9;&#9;player.Character.Head.Mesh.Scale = Vector3.new(4.5,4.5,4.5)
&#9;&#9;wait(.1)
&#9;&#9;player.Character.Head.Mesh.Scale = Vector3.new(4.75,4.75,4.75)
