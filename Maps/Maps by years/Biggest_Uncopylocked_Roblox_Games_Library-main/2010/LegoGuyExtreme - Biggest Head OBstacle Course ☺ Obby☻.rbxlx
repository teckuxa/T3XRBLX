				<Item class="Script" referent="RBX2123">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Regeno</string>
						<ProtectedString name="Source">deb = false

function onTouched(hit)
if hit.Parent == nil then return end
if deb == true then return end
deb = true
find = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
if find == nil then return end
script.Parent.BrickColor = BrickColor.new(&quot;Bright red&quot;)

robo = game.Lighting:findFirstChild(&quot;Big Head&quot;):Clone()
doah = script.Parent.Parent.Door

robot = robo:Clone()
robo:Remove()
script.Parent.Parent.Door:findFirstChild(&quot;Big Head&quot;):Remove()
robot.Parent = script.Parent.Parent.Door
robot:makeJoints()
robot:MoveTo(script.Parent.Parent.headspawn.CFrame.p)
doah.CanCollide = true
doah.Transparency = 0

wait(5)
script.Parent.BrickColor = BrickColor.new(&quot;Bright green&quot;)
deb = false
end

script.Parent.Touched:connect(onTouched)
</ProtectedString>
					</Properties>
				</Item>
			</Item>
