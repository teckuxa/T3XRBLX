					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">LocalScript</string>
					<ProtectedString name="Source">plr=game.Players.LocalPlayer
sp=script.Parent
m = 1

function Clicked(Mouse)
end 

function UnClicked(Mouse)
end

function onKeyDown(key) 
&#9;if (key~=nil) then 
&#9;&#9;local key = key:lower() 
&#9;&#9;if (key==&quot;q&quot;) then 
&#9;&#9;&#9;local things = game.Players:GetChildren()
&#9;&#9;&#9;if things[m] == nil then
&#9;&#9;&#9;&#9;m = 1
&#9;&#9;&#9;elseif things[m].Character ~= nil then
&#9;&#9;&#9;&#9;if things[m].Character:findFirstChild(&quot;Head&quot;) then
&#9;&#9;&#9;&#9;&#9;originalcam.CameraSubject = things[m].Character.Head
&#9;&#9;&#9;&#9;&#9;originalcam.CameraType = 4
&#9;&#9;&#9;&#9;&#9;m = m + 1
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end

function Selected(Mouse) 
&#9;Mouse.KeyDown:connect(onKeyDown)
&#9;Mouse.Button1Down:connect(function()Clicked(Mouse)end) 
&#9;Mouse.Button1Up:connect(function()UnClicked(Mouse)end)
&#9;originalcam = game.Workspace.CurrentCamera
&#9;o = originalcam.CameraSubject
&#9;yay = originalcam.CameraType
&#9;local h = Instance.new(&quot;Hint&quot;)
&#9;h.Parent = plr
&#9;h.Name = &quot;CamNotice&quot;
&#9;h.Text = &quot;Press Q to scroll through other players, deselect to exit.&quot;
end 

function Deselected(Mouse)
&#9;if plr:findFirstChild(&quot;CamNotice&quot;) ~= nil then plr.CamNotice:remove() end
&#9;if h then h:remove() end
&#9;originalcam.CameraSubject = o
&#9;originalcam.CameraType = yay
end

sp.Selected:connect(Selected)
sp.Deselected:connect(Deselected) </ProtectedString>
				</Properties>
