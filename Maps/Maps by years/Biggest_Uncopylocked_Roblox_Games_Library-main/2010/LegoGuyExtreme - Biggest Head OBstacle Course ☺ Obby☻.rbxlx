								<string name="Name">Script</string>
								<ProtectedString name="Source">while true do 
script.Parent.angularvelocity = (script.Parent.Parent.CFrame.lookVector * script.Parent.Parent.MaxRoll.Value * script.Parent.Parent.Steer) + (script.Parent.Parent.Parent.Piece.CFrame.lookVector * script.Parent.Parent.MaxPitch.Value * (script.Parent.Parent.Throttle * -1))
wait(0)
end </ProtectedString>
							</Properties>
