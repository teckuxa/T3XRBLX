				<Item class="Script" referent="RBX1000">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">GiveWepScript</string>
						<ProtectedString name="Source">--Thrown together by pitallingpat, no thanks needed just help make roblox better. Edited by LegoGuyExtreme :D

function getPlayer(humanoid) 
local players = game.Players:children() 
for i = 1, #players do 
if players[i].Character.Humanoid == humanoid then return players[i] end 
end 
return nil 
end 

local Door = script.Parent
local tool = game.Lighting.Fly

function onTouched(hit) 
&#9;print(&quot;Door Hit&quot;) 
&#9;local human = hit.Parent:findFirstChild(&quot;Humanoid&quot;) 
&#9;local player = getPlayer(human) 
&#9;if (human ~= nil ) then 
&#9;&#9;a = tool:clone()
                find = player.Backpack:findFirstChild(&quot;Fly&quot;)
                if find == nil then
                   a.Parent = player.Backpack 
                end
&#9;end 
end 

script.Parent.Touched:connect(onTouched)
</ProtectedString>
					</Properties>
				</Item>
			</Item>
