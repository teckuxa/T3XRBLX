					<Item class="Script" referent="RBX439">
						<Properties>
							<bool name="Archivable">true</bool>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">function createExplosion(position)

explosion = Instance.new(&quot;Explosion&quot;)
explosion.Position = position
explosion.BlastRadius = 4
explosion.Parent = game.Workspace
script.Parent.Parent.Engine:remove()
script.Parent.Parent.Parent.BodyKit.Wedge1:BreakJoints()

end

function onTouch(part)
&#9;if (script.Parent.Velocity.x &gt; 80) or (script.Parent.Velocity.z &gt; 80)  then
&#9;createExplosion(script.Parent.Position)
&#9;end
end

script.Parent.Touched:connect(onTouch)
</ProtectedString>
						</Properties>
					</Item>
				</Item>
