&#9;&#9;player.Character.Head.Mesh.Scale = Vector3.new(5,5,5)
&#9;&#9;wait(.1)
&#9;&#9;player.Character.Head.Mesh.Scale = Vector3.new(5.25,5.25,5.25)
&#9;&#9;wait(.1)
&#9;&#9;player.Character.Head.Mesh.Scale = Vector3.new(5.5,5.5,5.5)
&#9;&#9;wait(.1)
&#9;&#9;player.Character.Head.Mesh.Scale = Vector3.new(5.75,5.75,5.75)
&#9;&#9;wait(.1)
&#9;&#9;player.Character.Head.Mesh.Scale = Vector3.new(6,6,6)
&#9;&#9;wait(.1)
&#9;&#9;player.Character.Head.Mesh.Scale = Vector3.new(6.25,6.25,6.25)
