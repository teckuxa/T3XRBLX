function onTouched(hit)
if touched == 0 then return end
find = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
if find ~= nil then
touched = 0
script.Parent.TopSurface = &quot;Weld&quot;
wait(.5)
script.Parent.TopSurface = &quot;Glue&quot;
wait(.5)
script.Parent.TopSurface = &quot;Inlet&quot;
wait(.5)
local pos = script.Parent.Position
for i = 1,1 do
local p = Instance.new(&quot;Part&quot;)
p.formFactor = &quot;Plate&quot;
p.Size = Vector3.new(1,.4,1)
p.BrickColor = BrickColor.new(&quot;Dark orange&quot;)
p.Position = pos + Vector3.new((math.random()-.5),.2*i,(math.random()-.5))
p.Parent = game.Workspace
p.Size = Vector3.new((math.random(1,5)),0.4,(math.random(1,7))) 
a = p:Clone()
b = p:Clone()
c = p:Clone()
d = p:Clone()
a.Position = pos + Vector3.new((math.random()-.5),.2*i,(math.random()-.5))
a.Parent = game.Workspace
b.Position = pos + Vector3.new((math.random()-.5),.2*i,(math.random()-.5))
b.Parent = game.Workspace
c.Position = pos + Vector3.new((math.random()-.5),.2*i,(math.random()-.5))
c.Parent = game.Workspace
d.Position = pos + Vector3.new((math.random()-.5),.2*i,(math.random()-.5))
d.Parent = game.Workspace
script.Parent.CanCollide = false
script.Parent.Transparency = 1
wait(5)
a:Remove()
b:Remove()
c:Remove()
d:Remove()
p:Remove()
a:Remove()
b:Remove()
c:Remove()
d:Remove()
p:Remove()
script.Parent.CanCollide = true
script.Parent.Transparency = 0
script.Parent.TopSurface = &quot;Smooth&quot;
touched = 1
end
end
end

script.Parent.Touched:connect(onTouched)

</ProtectedString>
