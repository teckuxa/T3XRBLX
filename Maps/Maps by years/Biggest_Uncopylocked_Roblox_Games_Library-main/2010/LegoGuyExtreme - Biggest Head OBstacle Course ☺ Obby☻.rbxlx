					<string name="Name">Script</string>
					<ProtectedString name="Source">Head = script.Parent.Parent.Head
Headvelocity = Head.BodyVelocity

while true do
Headvelocity.velocity = Vector3.new(20,0,0)
wait(3)
Headvelocity.velocity = Vector3.new(-20,0,0)
wait(3)
end
</ProtectedString>
