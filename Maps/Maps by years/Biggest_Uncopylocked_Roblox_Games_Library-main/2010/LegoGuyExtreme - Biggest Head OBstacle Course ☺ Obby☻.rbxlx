				<Item class="Script" referent="RBX1866">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">local current = script.Parent.Parent:FindFirstChild(&quot;Plane&quot;)
local copy = current:Clone()

function add()
&#9;if current.Parent then
&#9;&#9;current.Parent = game.Workspace
&#9;end
&#9;local c = copy:Clone()
&#9;c.Parent = script.Parent.Parent
&#9;c:makeJoints()
&#9;current = c
end

while true do 
&#9;wait(5)
&#9;if script.Parent.Parent:FindFirstChild(current.Name) == nil
&#9;or (current:FindFirstChild(&quot;Engine&quot;)
&#9;and (script.Parent.Position - current.Engine.Position).magnitude &gt; 20) then
&#9;&#9;add()
&#9;end
end
</ProtectedString>
					</Properties>
				</Item>
			</Item>
