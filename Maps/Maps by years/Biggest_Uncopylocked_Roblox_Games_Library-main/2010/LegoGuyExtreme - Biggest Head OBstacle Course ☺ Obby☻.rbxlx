						<ProtectedString name="Source">--LegoGuyExtreme

function onTouched(hit)
find = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
if find ~= nil then
for i = 1, 10 do
wait(0.3)
script.Parent.Transparency = script.Parent.Transparency + 0.1
script.Parent.CanCollide = false
end
wait(3)
for p = 1, 10 do
wait(0.3)
script.Parent.Transparency = script.Parent.Transparency - 0.1
script.Parent.CanCollide = true
end
end
end

script.Parent.Touched:connect(onTouched)
</ProtectedString>
