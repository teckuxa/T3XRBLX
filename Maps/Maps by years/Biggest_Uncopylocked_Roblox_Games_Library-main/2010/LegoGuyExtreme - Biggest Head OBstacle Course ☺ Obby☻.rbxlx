					<Item class="Script" referent="RBX1028">
						<Properties>
							<bool name="Archivable">true</bool>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">local on = false
function bloop()
&#9;if not on then 
&#9;on = true
&#9;script.Parent.Parent.Light.BrickColor = BrickColor.new(&quot;Lime green&quot;)
&#9;script.Parent.Parent.Engine.Speed.Value = script.Parent.Parent.Engine.MaxSpeed
&#9;elseif on then 
&#9;on = false
&#9;script.Parent.Parent.Light.BrickColor = BrickColor.new(&quot;Really red&quot;)
&#9;script.Parent.Parent.Engine.Speed.Value = 0
&#9;end 
end 

connection = script.Parent.MouseClick:connect(bloop)</ProtectedString>
						</Properties>
					</Item>
				</Item>
			</Item>
		</Item>
		<Item class="Script" referent="RBX1029">
			<Properties>
				<bool name="Archivable">true</bool>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Creator message</string>
				<ProtectedString name="Source">--Made by LegoGuyExtreme

function onPlayerEntered(newPlayer) 
 if (newPlayer.Name== &quot;LegoGuyExtreme&quot;) then  --Change LegoGuyExtreme to your name
   wait(1)
    m = Instance.new(&quot;Message&quot;) 
    m.Parent = game.Workspace 
    m.Text = &quot;LegoGuyExtreme (The creator) has entered your server! Be at your best behaviour or he will ban you! Lol.&quot; --Change this message to how you want it
    wait(3)  
    m:Remove() 
  end
end 

game.Players.ChildAdded:connect(onPlayerEntered) 

--Don&apos;t mess with anything else</ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX1030">
			<Properties>
				<bool name="Archivable">true</bool>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Met Creator</string>
				<ProtectedString name="Source">owner = &quot;LegoGuyExtreme&quot; 

BadgetId =  39220309

game.Players.PlayerAdded:connect(function(p)
if game.Players:findFirstChild(owner) then
b = game:GetService(&quot;BadgeService&quot;)
b:AwardBadge(p.userId,BadgetId)
end
end)

game.Players.PlayerAdded:connect(function(p)
if p.Name == owner then 
ap = game.Players:GetChildren()
for i=1,#ap do
b = game:GetService(&quot;BadgeService&quot;)
b:AwardBadge(ap[i].userId,BadgetId)
end 
end 
end) </ProtectedString>
			</Properties>
		</Item>
