					<Item class="Script" referent="RBX1101">
						<Properties>
							<bool name="Archivable">true</bool>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">SpinScript</string>
							<ProtectedString name="Source">--[[

Spin script by LegoGuyExtreme!
What this script does is makes the object it is put into spin around.
Use this script to make video game-like coins!
Just like the coins in TylerMcBride&apos;s ROBLOX Adventure!
Hope you have fun.

--]]

SpinSpeed = 0.05 --Change 0.05 to the speed you want the object to spin.

while true do
script.Parent.CFrame = script.Parent.CFrame * CFrame.new(0,0, 0) * CFrame.fromEulerAnglesXYZ(0, &quot;&quot;..SpinSpeed..&quot;&quot;, 0)
wait(0.001)
end

</ProtectedString>
						</Properties>
					</Item>
					<Item class="Script" referent="RBX1102">
						<Properties>
							<bool name="Archivable">true</bool>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">MedalGive</string>
							<ProtectedString name="Source">function onTouched(hit)
find = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
if find ~= nil then
dude = hit.Parent
player = game.Players:getPlayerFromCharacter(dude)
if player ~= nil then
mes = player:findFirstChild(&quot;Message&quot;)
if mes ~= nil then return end
medal = player:findFirstChild(&quot;&quot;..script.Parent.Name..&quot;&quot;)
if medal ~= nil then
local me = Instance.new(&quot;Message&quot;)
me.Parent = player
me.Text = &quot;You already have this medal.&quot;
wait(3)
me:Remove()
player.Character.Torso.CFrame = CFrame.new(game.Workspace.Pad.CFrame.p)
cpoint2 = player:findFirstChild(&quot;Checkpoint&quot;)
if cpoint2 ~= nil then 
cpoint2:Remove()
end
return end
local m = Instance.new(&quot;Message&quot;)
m.Text = &quot;Medal #4: Hole in the ground&quot;
m.Parent = player
player.leaderstats.Medals.Value = player.leaderstats.Medals.Value + 1
wait(3)
m:Remove()
player.Character.Torso.CFrame = CFrame.new(game.Workspace.Pad.CFrame.p)
local med = Instance.new(&quot;ObjectValue&quot;)
med.Name = &quot;&quot;..script.Parent.Name..&quot;&quot;
med.Parent = player
cpoint = player:findFirstChild(&quot;Checkpoint&quot;)
if cpoint ~= nil then 
cpoint:Remove()
end
end
end
end

script.Parent.Touched:connect(onTouched)



</ProtectedString>
						</Properties>
					</Item>
				</Item>
