						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">Teleport=&quot;Teleporter2&quot;
ting=0
function touch(hit)
&#9;tele=script.Parent.Parent:findFirstChild(Teleport)
&#9;if tele~=nil and script.Parent.Enabled.Value~=0 then
&#9;&#9;if ting==0 then
&#9;&#9;&#9;ting=1
&#9;&#9;&#9;if hit.Parent:findFirstChild(&quot;Humanoid&quot;)~=nil then
&#9;&#9;&#9;&#9;if hit.Parent:findFirstChild(&quot;Torso&quot;)~=nil then
&#9;&#9;&#9;&#9;&#9;script.Parent.Enabled.Value=0
&#9;&#9;&#9;&#9;&#9;tele.Enabled.Value=0
&#9;&#9;&#9;&#9;&#9;hit.Parent.Torso.CFrame=CFrame.new(tele.Position.X,tele.Position.Y+3,tele.Position.Z)
&#9;&#9;&#9;&#9;&#9;wait(0.1)
&#9;&#9;&#9;&#9;&#9;script.Parent.Enabled.Value=1
&#9;&#9;&#9;&#9;&#9;tele.Enabled.Value=1
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;ting=0
&#9;&#9;end
&#9;end
end

script.Parent.Touched:connect(touch)</ProtectedString>
