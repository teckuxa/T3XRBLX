							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">function blow(hit)
   local h = hit.Parent:FindFirstChild(&quot;Humanoid&quot;) --No touchy!

   if (h ~= nil) then --Don&apos;t touch this either!
   explosion = Instance.new(&quot;Explosion&quot;)--Ooooo, veeery important, no touchy!
   explosion.Position = script.Parent.Position --Important
   explosion.BlastRadius = 0 --IMPORTANT!!!!!
   explosion.BlastPressure = 0
   script.Parent:Remove()


   explosion.Parent = game.Workspace --GAH THIS IS SOOOO IMPORTANT DONT EVER EVER EVEEEEEER touch it!
wait(2)
script.Parent.Parent:Remove()
   end

end

script.Parent.Touched:connect(blow) --bleh(dont touch either!)

</ProtectedString>
