					<Item class="Script" referent="RBX1096">
						<Properties>
							<bool name="Archivable">true</bool>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">GiveVal</string>
							<ProtectedString name="Source">function onTouched(hit)
find = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
if find ~= nil then
valu = hit.Parent:findFirstChild(&quot;UpHigh&quot;)
if valu ~= nil then return end
val = script.Parent.UpHigh:Clone()
val.Parent = hit.Parent
end
end

script.Parent.Touched:connect(onTouched)


</ProtectedString>
						</Properties>
					</Item>
				</Item>
