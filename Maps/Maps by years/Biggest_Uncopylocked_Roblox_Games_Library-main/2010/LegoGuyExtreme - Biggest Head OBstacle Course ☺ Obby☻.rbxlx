			<Item class="Script" referent="RBX2847">
				<Properties>
					<bool name="Archivable">true</bool>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Headgrow</string>
					<ProtectedString name="Source">--LegoGuyExtreme
deb = false

function onTouch(hit) 
if deb == true then return end
deb = true
 find = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
 if find ~= nil then
  headlol = hit.Parent:findFirstChild(&quot;Head&quot;)
  if headlol == nil then return end
  if hit.Parent.Head.Mesh.Scale == Vector3.new(2.65,2.65,2.65) then
  print(&quot;Already touched&quot;)
  else
   wait(1)
   hit.Parent.Head.Mesh.Scale = Vector3.new(2.55,2.55,2.55)
   wait(.1)
   hit.Parent.Head.Mesh.Scale = Vector3.new(2.65,2.65,2.65)
   script.Parent.Sound:Play()
deb = false
   end
  end
end

script.Parent.Touched:connect(onTouch)</ProtectedString>
