		<Item class="Script" referent="RBX1002">
			<Properties>
				<bool name="Archivable">true</bool>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">MessageScript</string>
				<ProtectedString name="Source">--LegoGuyExtreme

while true do
wait()
wait(math.random(120,200)) --Change 120 to the minimum amount of time it requires to make a message, and 200 to the maximum
random = math.random(1,4) --Change 4 to how many messages there are.
mes = Instance.new(&quot;Message&quot;)
mes.Parent = game.Workspace
--[[ Change the messages found below to your liking.&quot;]]--
  if random == 1 then
  mes.Text = &quot;Tip: Giant head getting in your way? Click the &apos;Reset Head&apos; button on the very top of the screen!&quot;  
  wait(4)
  mes:Remove()
  end
  if random == 2 then
  mes.Text = &quot;I hope you are having a good time here! About only 10% of my place is made with free models!&quot;
  wait(4)
  mes:Remove()
  end
  if random == 3 then
  mes.Text = &quot;If you like this game, be sure to try out my other games!&quot;
  wait(4)
  mes:Remove()
  end
  if random == 4 then
  mes.Text = &quot;Paddytheduck and nikolas3115 are both idiots. Please do me a favor and laugh at their ignorance.&quot;
  wait(4)
  mes:Remove()
  end
end

--Script made by LegoGuyExtreme. No stealing, please.
</ProtectedString>
