							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">SpikeScript</string>
							<ProtectedString name="Source">function up()
script.Parent.Transparency = 0
script.Parent.CanCollide = true
script.Parent.Sound:Play()
script.Parent.Up.Value = 0
end

function down()
script.Parent.Transparency = 1
script.Parent.CanCollide = false
script.Parent.Up.Value = 1
end

while true do
wait(3)
down()
wait(3)
up()
end


</ProtectedString>
						</Properties>
					</Item>
					<Item class="Script" referent="RBX227">
						<Properties>
							<bool name="Archivable">true</bool>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Hurt</string>
							<ProtectedString name="Source">function onTouched(hit)
find = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
if find ~= nil then
if script.Parent.Up.Value == 0 then
hit.Parent.Humanoid.Health = hit.Parent.Humanoid.Health - 50
end
end
end

script.Parent.Touched:connect(onTouched)

</ProtectedString>
						</Properties>
					</Item>
