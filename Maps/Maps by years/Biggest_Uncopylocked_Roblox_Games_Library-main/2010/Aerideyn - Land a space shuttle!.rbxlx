								<string name="Name">LocalScript</string>
								<ProtectedString name="Source">function clicken()
&#9;if script.Parent.Parent.Parent.camera.Value == false then
&#9;&#9;if script.Parent.Parent.Parent.listening.Value ~= nil then
&#9;&#9;&#9;if script.Parent.Parent.Parent.listening.Value:FindFirstChild(&quot;openpayload&quot;) ~= nil then
&#9;&#9;&#9;&#9;workspace.CurrentCamera.CameraSubject = script.Parent.Parent.Parent.listening.Value.seat
&#9;&#9;&#9;&#9;workspace.CurrentCamera.CameraType = 4
&#9;&#9;&#9;&#9;script.Parent.Parent.Parent.camera.Value = true 
&#9;&#9;&#9;&#9;Game.Players.LocalPlayer.PlayerGui.ScreenGui.camera.Visible = true&#9;&#9;
&#9;&#9;&#9;elseif script.Parent.Parent.Parent.listening.Value.Name == &quot;returnfrommoon&quot; then
&#9;&#9;&#9;&#9;workspace.CurrentCamera.CameraSubject = script.Parent.Parent.Parent.listening.Value.base
&#9;&#9;&#9;&#9;workspace.CurrentCamera.CameraType = 4
&#9;&#9;&#9;&#9;script.Parent.Parent.Parent.camera.Value = true 
&#9;&#9;&#9;&#9;Game.Players.LocalPlayer.PlayerGui.ScreenGui.camera.Visible = true
&#9;&#9;&#9;elseif script.Parent.Parent.Parent.listening.Value.Name == &quot;servicemodule&quot; then
&#9;&#9;&#9;&#9;workspace.CurrentCamera.CameraSubject = script.Parent.Parent.Parent.listening.Value
&#9;&#9;&#9;&#9;workspace.CurrentCamera.CameraType = 4
&#9;&#9;&#9;&#9;script.Parent.Parent.Parent.camera.Value = true 
&#9;&#9;&#9;&#9;Game.Players.LocalPlayer.PlayerGui.ScreenGui.camera.Visible = true
&#9;&#9;&#9;elseif script.Parent.Parent.Parent.listening.Value:FindFirstChild(&quot;servicemodule&quot;) then
&#9;&#9;&#9;&#9;workspace.CurrentCamera.CameraSubject = script.Parent.Parent.Parent.listening.Value.servicemodule.motor
&#9;&#9;&#9;&#9;workspace.CurrentCamera.CameraType = 4
&#9;&#9;&#9;&#9;script.Parent.Parent.Parent.camera.Value = true 
&#9;&#9;&#9;&#9;Game.Players.LocalPlayer.PlayerGui.ScreenGui.camera.Visible = true
&#9;&#9;&#9;elseif script.Parent.Parent.Parent.listening.Value.Name == &quot;LEM&quot; then
&#9;&#9;&#9;&#9;workspace.CurrentCamera.CameraSubject = script.Parent.Parent.Parent.listening.Value
&#9;&#9;&#9;&#9;workspace.CurrentCamera.CameraType = 4
&#9;&#9;&#9;&#9;script.Parent.Parent.Parent.camera.Value = true 
&#9;&#9;&#9;&#9;Game.Players.LocalPlayer.PlayerGui.ScreenGui.camera.Visible = true&#9;&#9;&#9;&#9;
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

