							<ProtectedString name="Source">function round(num, decimals) 
return ( math.floor( num * 10^decimals ) / 10^decimals ) 
end 

function getrrdata(accel,rocket)
&#9;data = {}
&#9;if rocket.Name == &quot;servicemodule&quot; then
&#9;&#9;data[1] = rocket.motor.Position.Y
&#9;&#9;data[2] = rocket.motor.Velocity.Magnitude
&#9;&#9;data[3] =  (rocket.motor.Velocity.Magnitude - accel)*2
&#9;else&#9;
&#9;data[1] = rocket.Engine.Position.Y
&#9;data[2] = rocket.Engine.Velocity.Magnitude
&#9;data[3] =  (rocket.Engine.Velocity.Magnitude - accel)*2
&#9;end
&#9;return(data)
end

function getdata(accel,rocket)
&#9;data = {}
&#9;data[1] = rocket.Engine.Position.Y
&#9;data[2] = rocket.Engine.Velocity.Magnitude
&#9;data[3] =  (rocket.Engine.Velocity.Magnitude - accel)*2
&#9;return(data)
end

function getshuttledata(accel,rocket)
&#9;data = {}
&#9;data[1] = rocket.motor.Position.Y
&#9;data[2] = rocket.motor.Velocity.Magnitude
&#9;data[3] =  (rocket.motor.Velocity.Magnitude - accel)*2
&#9;return(data)
end

function initiate(property)
&#9;wait(1)
&#9;accel = 0
&#9;if property == &quot;Visible&quot; and script.Parent.Parent.Visible == true then
&#9;&#9;if script.Parent.Parent.listening.Value:FindFirstChild(&quot;openpayload&quot;) ~= nil then
&#9;&#9;&#9;while script.Parent.Parent.Visible == true and script.Parent.Parent.listening.Value ~= nil do
&#9;&#9;&#9;&#9;outcome,data = pcall(getshuttledata,accel,script.Parent.Parent.listening.Value)
&#9;&#9;&#9;&#9;accel = script.Parent.Parent.listening.Value.motor.Velocity.Magnitude
&#9;&#9;&#9;&#9;if outcome == false then
&#9;&#9;&#9;&#9;&#9;print(data)
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;script.Parent.alt.Text = &quot;Altitude: &quot; .. round(data[1],0) ..&quot; studs.&quot;
&#9;&#9;&#9;&#9;&#9;script.Parent.speed.Text = &quot;Speed: &quot; .. round(data[2],0) ..&quot; studs/s ?.&quot;
&#9;&#9;&#9;&#9;&#9;script.Parent.accel.Text = &quot;Acceleration: &quot; .. round(data[3],0) ..&quot; studs/s^2&quot;
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;wait(0.5)
&#9;&#9;&#9;end&#9;&#9;&#9;
&#9;&#9;elseif script.Parent.Parent.listening.Value.Name == &quot;returnfrommoon&quot; then
&#9;&#9;&#9;while script.Parent.Parent.Visible == true and script.Parent.Parent.listening.Value ~= nil do
&#9;&#9;&#9;&#9;outcome,data = pcall(getrrdata,accel,script.Parent.Parent.listening.Value)
&#9;&#9;&#9;&#9;accel = script.Parent.Parent.listening.Value.Engine.Velocity.Magnitude
&#9;&#9;&#9;&#9;if outcome == false then
&#9;&#9;&#9;&#9;&#9;print(data)
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;script.Parent.alt.Text = &quot;Altitude: &quot; .. round(data[1],0) ..&quot; studs.&quot;
&#9;&#9;&#9;&#9;&#9;script.Parent.speed.Text = &quot;Speed: &quot; .. round(data[2],0) ..&quot; studs/s ?.&quot;
&#9;&#9;&#9;&#9;&#9;script.Parent.accel.Text = &quot;Acceleration: &quot; .. round(data[3],0) ..&quot; studs/s^2&quot;
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;wait(0.5)
&#9;&#9;&#9;end
&#9;&#9;else
&#9;&#9;&#9;while script.Parent.Parent.Visible == true and script.Parent.Parent.listening.Value ~= nil do
&#9;&#9;&#9;&#9;if script.Parent.Parent.listening.Value.Name == &quot;servicemodule&quot; then
&#9;&#9;&#9;&#9;&#9;outcome,data = pcall(getrrdata,accel,script.Parent.Parent.listening.Value)
&#9;&#9;&#9;&#9;&#9;accel = script.Parent.Parent.listening.Value.manned.Engine.Velocity.Magnitude
&#9;&#9;&#9;&#9;elseif script.Parent.Parent.listening.Value.Name == &quot;LEM&quot; then
&#9;&#9;&#9;&#9;&#9;outcome,data = pcall(getdata,accel,script.Parent.Parent.listening.Value)
&#9;&#9;&#9;&#9;&#9;accel = script.Parent.Parent.listening.Value.Engine.Velocity.Magnitude
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;if outcome == false then
&#9;&#9;&#9;&#9;&#9;print(data)
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;script.Parent.alt.Text = &quot;Altitude: &quot; .. round(data[1],0) ..&quot; studs.&quot;
&#9;&#9;&#9;&#9;&#9;script.Parent.speed.Text = &quot;Speed: &quot; .. round(data[2],0) ..&quot; studs/s ?.&quot;
&#9;&#9;&#9;&#9;&#9;script.Parent.accel.Text = &quot;Acceleration: &quot; .. round(data[3],0) ..&quot; studs/s^2&quot;
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;wait(0.5)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

script.Parent.Parent.Changed:connect(initiate)</ProtectedString>
