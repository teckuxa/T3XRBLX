					<Item class="Script" referent="RBX4509">
						<Properties>
							<bool name="Archivable">true</bool>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">script.Parent.DialogChoiceSelected:connect(function(p,i)
&#9;if i == script.Parent.DialogChoice.DialogChoice1 then
&#9;&#9;if p then
&#9;&#9;&#9;p.PlayerGui.ScreenGui.tutorial2.frame.Value = 1
&#9;&#9;&#9;p.PlayerGui.ScreenGui.tutorial2.astronaughtdecals.Frame1.Visible = true
&#9;&#9;&#9;p.PlayerGui.ScreenGui.tutorial2.previous.Visible = false
&#9;&#9;&#9;wait(1)
&#9;&#9;&#9;p.PlayerGui.ScreenGui.tutorial2.Visible = true
&#9;&#9;end
&#9;end
end)
</ProtectedString>
						</Properties>
