function launch()
&#9;empty = false
&#9;count = 0
&#9;for i,v in pairs(Game.Players:GetChildren()) do
&#9;&#9;if v.PlayerGui.ScreenGui.astronaught.Visible == true or v.PlayerGui.ScreenGui.openastro.Visible == true then
&#9;&#9;&#9;if v.PlayerGui.ScreenGui.astronaught.listening.Value == script.Parent then
&#9;&#9;&#9;&#9;count = count + 1
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;if count == 0 then
&#9;&#9;if workspace.ISS.dock2.occupied.Value == true then
&#9;&#9;&#9;script.Parent.status.Value = &quot;Sabortempty&quot;
&#9;&#9;&#9;wait(5)
