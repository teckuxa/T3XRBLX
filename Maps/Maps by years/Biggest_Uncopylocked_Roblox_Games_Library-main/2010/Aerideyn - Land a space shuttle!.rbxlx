&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;elseif RRelevon &lt; -10 then
&#9;&#9;&#9;&#9;&#9;if RRelevon +3 &gt; -10 then
&#9;&#9;&#9;&#9;&#9;&#9;RRelevon = -10
&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;RRelevon = RRelevon + 3
&#9;&#9;&#9;&#9;&#9;end&#9;&#9;
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end&#9;&#9;&#9;
&#9;&#9;&#9;for i,v in pairs(frontrightelevon) do
&#9;&#9;&#9;&#9;v[1].Weld.C0 = CFrame.new(v[3].X, v[3].Y + math.sin(math.rad(FRelevon)),v[3].Z + math.cos(math.rad(FRelevon)) ) * CFrame.Angles(v[2].X - math.rad(FRelevon),v[2].Y,v[2].Z)&#9;&#9;&#9;&#9;&#9;
&#9;&#9;&#9;end
&#9;&#9;&#9;for i,v in pairs(frontleftelevon) do
&#9;&#9;&#9;&#9;v[1].Weld.C0 = CFrame.new(v[3].X, v[3].Y + math.sin(math.rad(FLelevon)),v[3].Z + math.cos(math.rad(FLelevon)) ) * CFrame.Angles(v[2].X - math.rad(FLelevon),v[2].Y,v[2].Z)&#9;&#9;&#9;&#9;&#9;
&#9;&#9;&#9;end
&#9;&#9;&#9;for i,v in pairs(rearleftelevon) do
&#9;&#9;&#9;&#9;v[1].Weld.C0 = CFrame.new(v[3].X, (v[3].Y + math.sin(math.rad(RLelevon))),v[3].Z -((1-(math.cos(math.rad(RLelevon)))) *2)) * CFrame.Angles(v[2].X - math.rad(RLelevon),v[2].Y,v[2].Z)&#9;&#9;&#9;&#9;&#9;
&#9;&#9;&#9;end&#9;&#9;&#9;
&#9;&#9;&#9;for i,v in pairs(rearrightelevon) do
&#9;&#9;&#9;&#9;v[1].Weld.C0 = CFrame.new(v[3].X, (v[3].Y + math.sin(math.rad(RRelevon))),v[3].Z -((1-(math.cos(math.rad(RRelevon)))) *2)) * CFrame.Angles(v[2].X - math.rad(RRelevon),v[2].Y,v[2].Z)&#9;&#9;&#9;&#9;&#9;
&#9;&#9;&#9;end
&#9;&#9;&#9;
&#9;&#9;&#9;for i,v in pairs(rearelevator) do
&#9;&#9;&#9;&#9;v[1].Weld.C0 = CFrame.new(v[3].X, v[3].Y + math.sin(math.rad(elevs)),v[3].Z + math.cos(math.rad(elevs)) ) * CFrame.Angles(v[2].X - math.rad(elevs),v[2].Y,v[2].Z)&#9;&#9;&#9;&#9;&#9;
&#9;&#9;&#9;end
&#9;&#9;&#9;for i,v in pairs(frontelevator) do
&#9;&#9;&#9;&#9;v[1].Weld.C0 = CFrame.new(v[3].X, v[3].Y + math.sin(math.rad(-elevs)),v[3].Z + math.cos(math.rad(-elevs)) ) * CFrame.Angles(v[2].X - math.rad(-elevs),v[2].Y,v[2].Z)&#9;&#9;&#9;&#9;&#9;
&#9;&#9;&#9;end
&#9;&#9;&#9;for i,v in pairs(leftaileron) do
&#9;&#9;&#9;&#9;v[1].Weld.C0 = CFrame.new(v[3].X, (v[3].Y + math.sin(math.rad(-aileron))),v[3].Z -((1-(math.cos(math.rad(-aileron)))) *2)) * CFrame.Angles(v[2].X - math.rad(-aileron),v[2].Y,v[2].Z)&#9;&#9;&#9;&#9;&#9;
&#9;&#9;&#9;end&#9;&#9;&#9;
&#9;&#9;&#9;for i,v in pairs(rightaileron) do
&#9;&#9;&#9;&#9;v[1].Weld.C0 = CFrame.new(v[3].X, (v[3].Y + math.sin(math.rad(aileron))),v[3].Z -((1-(math.cos(math.rad(aileron)))) *2)) * CFrame.Angles(v[2].X - math.rad(aileron),v[2].Y,v[2].Z)&#9;&#9;&#9;&#9;&#9;
&#9;&#9;&#9;end&#9;&#9;&#9;
&#9;&#9;&#9;wait()
&#9;&#9;end
&#9;end
end) 


script.Parent.Parent.Parent.dockingport.CanCollide = false
script.Parent.Parent.Parent.dockingport.Transparency = 1
db = true
dp = true
function regen(a)
&#9;if db then&#9;
&#9;&#9;db = false
&#9;&#9;for i,v in pairs(game.Players:GetPlayers()) do
&#9;&#9;&#9;if v.PlayerGui.ScreenGui.astronaught.Visible == true or v.PlayerGui.ScreenGui.openastro.Visible == true then
&#9;&#9;&#9;&#9;if v.PlayerGui.ScreenGui.astronaught.listening.Value == script.Parent.Parent.Parent then
&#9;&#9;&#9;&#9;&#9;v.PlayerGui.ScreenGui.astronaught.Visible = false
&#9;&#9;&#9;&#9;&#9;v.PlayerGui.ScreenGui.astronaught.listening.Value = nil
&#9;&#9;&#9;&#9;&#9;v.PlayerGui.ScreenGui.openastro.Visible = false
&#9;&#9;&#9;&#9;&#9;v.PlayerGui.ScreenGui.vsi.Visible = false
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end&#9;
&#9;&#9;if a ~= nil then
&#9;&#9;&#9;if script.Parent:FindFirstChild(&quot;SeatWeld&quot;) then
&#9;&#9;&#9;&#9;if game.Players:GetPlayerFromCharacter(script.Parent.SeatWeld.Part1.Parent) then
&#9;&#9;&#9;&#9;&#9;p = game.Players:GetPlayerFromCharacter(script.Parent.SeatWeld.Part1.Parent)
&#9;&#9;&#9;&#9;&#9;if workspace.playerdata:FindFirstChild(p.Name) then
&#9;&#9;&#9;&#9;&#9;&#9;workspace.playerdata[p.Name].shuttleslanded.Value = workspace.playerdata[p.Name].shuttleslanded.Value +1
&#9;&#9;&#9;&#9;&#9;&#9;workspace.playerdata[p.Name].consecutivelandings.Value = workspace.playerdata[p.Name].consecutivelandings.Value +1
&#9;&#9;&#9;&#9;&#9;&#9;if workspace.playerdata[p.Name].consecutivelandings.Value &gt;= 3 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if Game:GetService(&quot;BadgeService&quot;):UserHasBadge(p.userId,64012737) == false then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;game:GetService(&quot;BadgeService&quot;):AwardBadge(p.userId,64012737)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end&#9;&#9;&#9;&#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end&#9;
&#9;&#9;end
&#9;&#9;script.Parent.Parent.active.Value = false
&#9;&#9;for i,v in pairs(script.Parent.Parent:GetChildren()) do
&#9;&#9;&#9;if v:FindFirstChild(&quot;SeatWeld&quot;) ~= nil then
&#9;&#9;&#9;&#9;p = game.Players:GetPlayerFromCharacter(v.SeatWeld.Part1.Parent)
&#9;&#9;&#9;&#9;v.SeatWeld:remove()
&#9;&#9;&#9;&#9;if p then
&#9;&#9;&#9;&#9;&#9;p.Character.Torso.CFrame = workspace.flighttraining.CFrame + Vector3.new(0,2,0)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end&#9;&#9;
&#9;&#9;local backup = game.Lighting.shuttle:Clone()
&#9;&#9;backup.Parent = workspace
&#9;&#9;backup:MakeJoints()
&#9;&#9;wait(5)
&#9;&#9;script.Parent.Parent.Parent:Remove()
&#9;end
end

