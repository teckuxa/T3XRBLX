				<Item class="Script" referent="RBX5041">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">localplayer = script.Parent.Parent.Parent.Parent
function click()
&#9;script.Parent.Parent.Parent.Parent.Character.Torso:remove()
end
script.Parent.reset.MouseButton1Down:connect(click)

repeat wait() until workspace.playerdata:FindFirstChild(localplayer.Name) 

script.Parent.safe.Text = workspace.playerdata[localplayer.Name].shuttleslanded.Value
script.Parent.crash.Text = workspace.playerdata[localplayer.Name].shuttlescrashed.Value
script.Parent.consec.Text = workspace.playerdata[localplayer.Name].consecutivelandings.Value

workspace.playerdata[localplayer.Name].consecutivelandings.Changed:connect(function()
&#9;script.Parent.consec.Text = workspace.playerdata[localplayer.Name].consecutivelandings.Value
end)

workspace.playerdata[localplayer.Name].shuttlescrashed.Changed:connect(function()
&#9;script.Parent.crash.Text = workspace.playerdata[localplayer.Name].shuttlescrashed.Value
end)

workspace.playerdata[localplayer.Name].shuttleslanded.Changed:connect(function()
&#9;script.Parent.safe.Text = workspace.playerdata[localplayer.Name].shuttleslanded.Value
end)</ProtectedString>
					</Properties>
				</Item>
			</Item>
		</Item>
	</Item>
