				<Item class="LocalScript" referent="RBX4821">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">LocalScript</string>
						<ProtectedString name="Source">script.Parent.Changed:connect(function(p)
&#9;if p == &quot;Visible&quot; and script.Parent.Visible == true then
&#9;&#9;for i,v in pairs(workspace.bans:GetChildren()) do
&#9;&#9;&#9;if string.lower(v.Name) == string.lower(game.Players.LocalPlayer.Name) then
&#9;&#9;&#9;&#9;if v.reason.Value ~= nil then
&#9;&#9;&#9;&#9;&#9;script.Parent.reason.Text = &quot;FOR: &quot; .. v.reason.Value
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;script.Parent.reason.Text = &quot;FOR: [NONE GIVEN]&quot;
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;for i = 1,10 do
&#9;&#9;&#9;wait(1)
&#9;&#9;&#9;for i,v in pairs(workspace.bans:GetChildren()) do
&#9;&#9;&#9;&#9;if string.lower(v.Name) == string.lower(game.Players.LocalPlayer.Name) then
&#9;&#9;&#9;&#9;&#9;start = v.timestamp.Value
&#9;&#9;&#9;&#9;&#9;endt = (v.timestamp.Value + (86400*v.duration.Value))
&#9;&#9;&#9;&#9;&#9;days = math.floor((endt&#9;- tick())/86400)
&#9;&#9;&#9;&#9;&#9;hours = math.floor((endt- (days*86400) - tick())/3600)
&#9;&#9;&#9;&#9;&#9;minutes = math.floor((endt - (days*86400) - (hours*3600) - tick())/60)
&#9;&#9;&#9;&#9;&#9;seconds = math.floor((endt - (days*86400) - (hours*3600) - (minutes*60) - tick()))
&#9;&#9;&#9;&#9;&#9;script.Parent.timetill.Text = &quot;UNTIL: &quot; .. days .. &quot; MORE DAYS, &quot; .. hours .. &quot; HOURS &quot; ..minutes..&quot; MINUTES &quot;.. seconds.. &quot; SECONDS.&quot;
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end)
</ProtectedString>
					</Properties>
				</Item>
			</Item>
