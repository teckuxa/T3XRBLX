function land()
&#9;pos = Vector3.new(3919,1000,745)
&#9;while (script.Parent.motor.Position - pos).Magnitude &gt; 200 do
&#9;&#9;script.Parent.motor.moveablegyro.cframe = CFrame.new(script.Parent.motor.Position,pos)
&#9;&#9;wait()
&#9;&#9;ratio = (script.Parent.motor.Position - pos).Unit
&#9;&#9;script.Parent.motor.BodyVelocity.velocity = Vector3.new(ratio.X*-200,200*-ratio.Y,-ratio.Z*200)
&#9;end
&#9;script.Parent.motor.BodyPosition.maxForce = Vector3.new(0,0,6e+020)
&#9;while (script.Parent.motor.Position - pos).Magnitude &gt; 50 do
&#9;&#9;script.Parent.motor.moveablegyro.cframe = CFrame.new(script.Parent.motor.Position,pos)
&#9;&#9;wait()
&#9;&#9;ratio = (script.Parent.motor.Position - pos).Unit
&#9;&#9;script.Parent.motor.BodyVelocity.velocity = Vector3.new(ratio.X*-50,50*-ratio.Y,-ratio.Z*50)
&#9;end&#9;
&#9;script.Parent.motor.moveablegyro.cframe = workspace.runway.aimer3.CFrame 
&#9;while (script.Parent.motor.Position - pos).Magnitude &gt; 5 do
&#9;&#9;wait()
&#9;&#9;ratio = (script.Parent.motor.Position - pos).Unit
