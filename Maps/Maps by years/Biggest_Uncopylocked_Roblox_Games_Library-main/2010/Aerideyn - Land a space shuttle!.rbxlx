			<Item class="Script" referent="RBX4420">
				<Properties>
					<bool name="Archivable">true</bool>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">open = false
db = false

script.Parent.Touched:connect(function(p)
&#9;if p.Parent:FindFirstChild(&quot;Humanoid&quot;) then
&#9;&#9;if workspace.playerdata:FindFirstChild(p.Parent.Name) then
&#9;&#9;&#9;if workspace.playerdata[p.Parent.Name].exam2complete.Value then
&#9;&#9;&#9;&#9;if db == true then return end
&#9;&#9;&#9;&#9;db = true
&#9;&#9;&#9;&#9;open = true
&#9;&#9;&#9;&#9;for i = 0.5,1,0.05 do
&#9;&#9;&#9;&#9;&#9;script.Parent.Transparency = i
&#9;&#9;&#9;&#9;&#9;wait()
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;script.Parent.CanCollide = false
&#9;&#9;&#9;&#9;wait(1)
&#9;&#9;&#9;&#9;for i = 1,0.5,-0.05 do
&#9;&#9;&#9;&#9;&#9;script.Parent.Transparency = i
&#9;&#9;&#9;&#9;&#9;wait()
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;script.Parent.CanCollide = true
&#9;&#9;&#9;&#9;open = false
&#9;&#9;&#9;&#9;db = false
&#9;&#9;&#9;elseif open == true then
&#9;&#9;&#9;&#9;p.Parent.Torso.CFrame = workspace.advancedtheory.CFrame + Vector3.new(0,3,0)
&#9;&#9;&#9;end
&#9;&#9;elseif open == true then
&#9;&#9;&#9;p.Parent.Torso.CFrame = workspace.advancedtheory.CFrame + Vector3.new(0,3,0)
&#9;&#9;end
&#9;end
end)
</ProtectedString>
				</Properties>
			</Item>
		</Item>
