&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;while script.Parent.landinggear.rearwheel.Position.Y &gt;85 do
&#9;&#9;wait()
&#9;end
&#9;script.Parent.motor.BodyVelocity.velocity = Vector3.new(-100,0,0)
&#9;while script.Parent.landinggear.rearwheel.Position.X &gt;1736 do
&#9;&#9;wait()
&#9;end
&#9;script.Parent.motor.BodyVelocity.velocity = Vector3.new(-100,-5,0)
&#9;while script.Parent.landinggear.rearwheel.Position.Y &gt;78 do
&#9;&#9;wait()
&#9;end&#9;
&#9;for i,v in pairs(script.Parent.parachute:GetChildren()) do
&#9;&#9;v.Transparency = 0
&#9;end

&#9;coroutine.resume(coroutine.create(lowernose))
&#9;x = -100
&#9;while script.Parent.dockingport.Velocity.Magnitude &gt; 25 do
&#9;&#9;x = x+1
&#9;&#9;script.Parent.motor.BodyVelocity.velocity = Vector3.new(x,0,0)&#9;
&#9;&#9;wait(0.066)
&#9;end
&#9;script.Parent.motor.BodyVelocity.maxForce = Vector3.new(2e+009,0,2e+009)
&#9;for i,v in pairs(script.Parent.parachute:GetChildren()) do
&#9;&#9;v.Transparency = 1
&#9;end&#9;&#9;
&#9;while script.Parent.dockingport.Position.X &gt; 240 do
