&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end&#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;end&#9;&#9;
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;
&#9;coroutine.resume(coroutine.create(function() 
&#9;&#9;wait(10) 
&#9;&#9;if script.Parent:FindFirstChild(&quot;Tankandboosters&quot;) then
&#9;&#9;&#9;script.Parent.Tankandboosters:Remove()
&#9;&#9;end
&#9;end))

&#9;script.Parent.motor.moveablegyro.cframe = CFrame.new(script.Parent.motor.Position,pos)&#9;
&#9;while (script.Parent.motor.Position - pos).Magnitude &gt; 5 do 
&#9;&#9;if script.Parent.que.Value ~= 99 then&#9;
&#9;&#9;&#9;p1 = pos-Vector3.new(script.Parent.que.Value*200,0,0)
&#9;&#9;else
&#9;&#9;&#9;p1 = pos
&#9;&#9;end
&#9;&#9;t = 1
&#9;&#9;while (script.Parent.motor.Position - p1).Magnitude &gt; 5 do
&#9;&#9;&#9;t = t + 0.5
&#9;&#9;&#9;speed = t
&#9;&#9;&#9;if speed &gt;= (script.Parent.motor.Position - p1).Magnitude/2 +10 then speed = (script.Parent.motor.Position - p1).Magnitude/2 +10 end
&#9;&#9;&#9;ratio = (script.Parent.motor.Position - p1).Unit&#9;&#9;&#9;
&#9;&#9;&#9;script.Parent.motor.BodyVelocity.velocity = Vector3.new(-ratio.X*speed,speed*-ratio.Y,-ratio.Z*speed)
&#9;&#9;&#9;wait()
&#9;&#9;end
&#9;&#9;script.Parent.motor.BodyVelocity.velocity = Vector3.new(0,0,0)
&#9;&#9;wait(1)
&#9;end

