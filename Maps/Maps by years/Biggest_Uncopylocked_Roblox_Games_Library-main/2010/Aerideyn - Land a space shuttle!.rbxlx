&#9;&#9;v.CanCollide = true
&#9;end&#9;
&#9;script.Parent.motor.moveablegyro.cframe = workspace.runway.aimer4.CFrame 
&#9;script.Parent.motor.BodyVelocity.velocity = Vector3.new(-100,-10,0)
&#9;while script.Parent.landinggear.rearwheel.Position.Y &gt;95 do
&#9;&#9;wait()
&#9;end
&#9;script.Parent.motor.moveablegyro.cframe = workspace.runway.aimer1.CFrame
&#9;script.Parent.motor.BodyVelocity.velocity = Vector3.new(-100,-5,0)
&#9;players = {}
&#9;for i,v in pairs(script.Parent.seat:GetChildren()) do
&#9;&#9;if v:FindFirstChild(&quot;SeatWeld&quot;) then
&#9;&#9;&#9;player = game.Players:GetPlayerFromCharacter(v.SeatWeld.Part1.Parent)
&#9;&#9;&#9;if player then
