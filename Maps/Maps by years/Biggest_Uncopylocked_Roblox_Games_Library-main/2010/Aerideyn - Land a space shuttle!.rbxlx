&#9;&#9;while (Vector2.new(script.Parent.dockingport.Position.X,script.Parent.dockingport.Position.Z) -p).magnitude &gt; 1 do
&#9;&#9;&#9;if script.Parent.dockingport.Position.X &gt; 212 then
&#9;&#9;&#9;&#9;script.Parent.motor.BodyVelocity.velocity = Vector3.new(-5,0,0)
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;script.Parent.motor.BodyVelocity.velocity = Vector3.new(5,0,0)
&#9;&#9;&#9;end
&#9;&#9;&#9;wait()
&#9;&#9;end
&#9;&#9;script.Parent.motor.BodyVelocity.velocity = Vector3.new(0,0,0)&#9;
&#9;&#9;wait(1)
&#9;end

&#9;script.Parent.motor.BodyVelocity.velocity = Vector3.new(0,0,0)
&#9;script.Parent.motor.Anchored = true
&#9;workspace.disembark.open.Value = true
&#9;for i,v in pairs(players) do
&#9;&#9;if game.Players:FindFirstChild(v) then
&#9;&#9;&#9;game.Players[v].TeamColor = BrickColor.new(&quot;White&quot;)
&#9;&#9;end
&#9;end&#9;
&#9;wait(5)
&#9;script.Parent.motor.BodyPosition.maxForce = Vector3.new(0,0,0)
&#9;wait(25)
&#9;script.Parent.Parent = workspace.rentering
&#9;for i,v in pairs(game.Players:GetPlayers()) do
&#9;&#9;if v.PlayerGui.ScreenGui.launchgui.Visible == true then
&#9;&#9;&#9;v.PlayerGui.ScreenGui.launchgui.Visible = false
&#9;&#9;&#9;v.PlayerGui.ScreenGui.launchgui.Visible = true
&#9;&#9;end
&#9;&#9;if v.PlayerGui.ScreenGui.launchgui.listening.Value == script.Parent then
&#9;&#9;&#9;v.PlayerGui.ScreenGui.launchgui.listening.Value = nil
&#9;&#9;end
&#9;&#9;if v.PlayerGui.ScreenGui.astronaught.Visible == true or v.PlayerGui.ScreenGui.openastro.Visible == true then
&#9;&#9;&#9;if v.PlayerGui.ScreenGui.astronaught.listening.Value == script.Parent then
&#9;&#9;&#9;&#9;v.PlayerGui.ScreenGui.astronaught.Visible = false
&#9;&#9;&#9;&#9;v.PlayerGui.ScreenGui.astronaught.listening.Value = nil
&#9;&#9;&#9;&#9;v.PlayerGui.ScreenGui.openastro.Visible = false
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end&#9;

&#9;workspace.disembark.open.Value = false
&#9;script.Parent.seat.active.Value = false
&#9;for i,v in pairs(script.Parent.seat:GetChildren()) do
&#9;&#9;if v:FindFirstChild(&quot;SeatWeld&quot;) ~= nil then
&#9;&#9;&#9;v.SeatWeld:remove()
&#9;&#9;end
&#9;end
&#9;script.Parent:remove()
end

</ProtectedString>
