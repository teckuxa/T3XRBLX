&#9;&#9;&#9;temp.TextLabel.Text = t&#9;
&#9;&#9;&#9;temp.telemetry.data1.Text = m
&#9;&#9;&#9;temp.Position = UDim2.new(0,0,#v.PlayerGui.ScreenGui.countdowns:GetChildren()/5,0)
&#9;&#9;&#9;temp.LocalScript.waits.Value = x
&#9;&#9;&#9;temp.Parent = v.PlayerGui.ScreenGui.countdowns
&#9;&#9;end
&#9;end&#9;
end

