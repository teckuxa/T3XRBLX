							<string name="Name">DialogChoice</string>
							<string name="ResponseDialog">Right, before you can fly the shuttle you will need to complete 2 theory exams.</string>
							<string name="UserDialog">Hi! im here for training.</string>
						</Properties>
						<Item class="DialogChoice" referent="RBX4483">
							<Properties>
								<bool name="Archivable">true</bool>
								<string name="Name">DialogChoice1</string>
								<string name="ResponseDialog">Of course! Let us begin.</string>
								<string name="UserDialog">Can you teach me the things i need to know? </string>
							</Properties>
						</Item>
						<Item class="DialogChoice" referent="RBX4484">
							<Properties>
								<bool name="Archivable">true</bool>
								<string name="Name">DialogChoice</string>
								<string name="ResponseDialog">Just around the corner, sit in a chair and it should begin. take as much time as you need, just ask me if you need lessons.</string>
								<string name="UserDialog">So where can i take the exam?</string>
							</Properties>
						</Item>
