&#9;&#9;&#9;if script.Parent.listening.Value:FindFirstChild(&quot;status&quot;) ~= nil then
&#9;&#9;&#9;&#9;script.Parent.status.Value = script.Parent.listening.Value.status.Value
&#9;&#9;&#9;end&#9;&#9;&#9;&#9;&#9;
&#9;&#9;else&#9;&#9;
&#9;&#9;&#9;if script.Parent.listening.Value:FindFirstChild(&quot;status&quot;) ~= nil then
