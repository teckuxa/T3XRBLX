function statuschanged()
&#9;if script.Parent.status.Value == &quot;launched&quot; then
&#9;&#9;script.Parent.controls.launch.Visible = false
&#9;elseif script.Parent.status.Value == &quot;dockinglem&quot; then
&#9;&#9;script.Parent.notices.data1.Text = &quot;WARNING&quot;
