&#9;&#9;&#9;regen(1)
&#9;&#9;end
&#9;end)

&#9;script.Parent.Parent.Parent.motor.Touched:connect(function(p)
&#9;&#9;if motordb == true then return end
&#9;&#9;if p:IsDescendantOf(script.Parent.Parent.Parent) then return end
&#9;&#9;if p.Parent:FindFirstChild(&quot;Humanoid&quot;) then return end
&#9;&#9;if script.Parent.Parent.Parent.motor.Velocity.Y &lt;= tolerance then
&#9;&#9;&#9;motordb = true
&#9;&#9;&#9;exp = Instance.new(&quot;Explosion&quot;)
&#9;&#9;&#9;exp.BlastPressure = bp
&#9;&#9;&#9;exp.BlastRadius = 5
&#9;&#9;&#9;exp.Parent = workspace
&#9;&#9;&#9;exp.Position = script.Parent.Parent.Parent.motor.Position
&#9;&#9;&#9;wait(1)
&#9;&#9;&#9;motordb = false
&#9;&#9;&#9;repeat wait() until script.Parent.Velocity.Magnitude &lt; 5 
&#9;&#9;&#9;if not toucheddebounce then
&#9;&#9;&#9;&#9;if script.Parent:FindFirstChild(&quot;SeatWeld&quot;) then
&#9;&#9;&#9;&#9;&#9;if game.Players:GetPlayerFromCharacter(script.Parent.SeatWeld.Part1.Parent) then
&#9;&#9;&#9;&#9;&#9;&#9;p = game.Players:GetPlayerFromCharacter(script.Parent.SeatWeld.Part1.Parent)
&#9;&#9;&#9;&#9;&#9;&#9;if workspace.playerdata:FindFirstChild(p.Name) then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;workspace.playerdata[p.Name].shuttlescrashed.Value = workspace.playerdata[p.Name].shuttlescrashed.Value +1
&#9;&#9;&#9;&#9;&#9;&#9;&#9;workspace.playerdata[p.Name].consecutivelandings.Value = 0
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;toucheddebounce = true
&#9;&#9;&#9;end&#9;&#9;&#9;
&#9;&#9;&#9;regen()
&#9;&#9;else
&#9;&#9;&#9;wait(1)&#9;
&#9;&#9;&#9;deploy()
&#9;&#9;&#9;repeat wait() until script.Parent and script.Parent.Velocity.Magnitude &lt; 5  
&#9;&#9;&#9;regen(1)
&#9;&#9;end
&#9;end)
end

while wait() do
&#9;if script.Parent.Parent.Parent.motor.Position.Y &lt; 200 and script.Parent.Parent.Parent.motor.Position.Y &gt; 75 then
&#9;&#9;touches()
&#9;&#9;for i,v in pairs(script.Parent.Parent.Parent.landinggear:GetChildren()) do
&#9;&#9;&#9;if v:IsA(&quot;BasePart&quot;) then
&#9;&#9;&#9;&#9;v.Transparency = 0
&#9;&#9;&#9;&#9;v.CanCollide = true&#9;&#9;&#9;
&#9;&#9;&#9;end
&#9;&#9;end
&#9;elseif script.Parent.Parent.Parent.motor.Position.Y &lt;= 75 then
&#9;&#9;regen()
&#9;end 
end
