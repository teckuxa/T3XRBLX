							<string name="Name">VSscript</string>
							<ProtectedString name="Source">repeat wait() until workspace.disembark.ready.Value
model = script.Parent.Parent.Parent
mass = 0
workspace.disembark.open.Value = true
wait(2)
script.Parent.Parent.Parent:MoveTo(Vector3.new(3919, 1709, 745))
for i,v in pairs(script.Parent.Parent.Parent:GetChildren()) do
&#9;if v:IsA(&quot;BasePart&quot;) then
&#9;&#9;v.Velocity = Vector3.new(0,0.1,0)
&#9;&#9;v.Anchored = false
&#9;end
end

for i,v in pairs(script.Parent.Parent.Parent.sme:GetChildren()) do
&#9;if v:IsA(&quot;BasePart&quot;) then
&#9;&#9;v.Velocity = Vector3.new(0,0.1,0)&#9;&#9;
&#9;&#9;v.Anchored = false
&#9;end
end

for i,v in pairs(script.Parent.Parent.Parent.parachute:GetChildren()) do
&#9;if v:IsA(&quot;BasePart&quot;) then
&#9;&#9;v.Velocity = Vector3.new(0,0.1,0)&#9;&#9;
&#9;&#9;v.Anchored = false
&#9;end
end

for i,v in pairs(script.Parent.Parent.Parent.seat:GetChildren()) do
&#9;if v:IsA(&quot;BasePart&quot;) then
&#9;&#9;v.Velocity = Vector3.new(0,0.1,0)&#9;
&#9;&#9;if v.Name ~= &quot;Seat3&quot; then
&#9;&#9;&#9;v.Anchored = false
&#9;&#9;end
&#9;end
end
for i,v in pairs(script.Parent.Parent.Parent.landinggear:GetChildren()) do
&#9;if v:IsA(&quot;BasePart&quot;) then
&#9;&#9;v.Velocity = Vector3.new(0,0.1,0)
&#9;&#9;v.Anchored = false&#9;&#9;
&#9;end
end



R = Vector3.new(0,0,0)
function getcog(mod)
&#9;for _,v in pairs(mod:GetChildren()) do
&#9;&#9;if v:IsA(&quot;BasePart&quot;) then
&#9;&#9;&#9;local M = v:GetMass()
&#9;&#9;&#9;vector = model.motor.CFrame:pointToObjectSpace(v.Position)
&#9;&#9;&#9;R = Vector3.new(R.X +(vector.X*M),R.Y +(vector.Y*M),R.Z +(vector.Z*M))
&#9;&#9;&#9;mass = mass + M
&#9;&#9;elseif v:IsA(&quot;Model&quot;) then
&#9;&#9;&#9;getcog(v)
&#9;&#9;end
&#9;end
end&#9;
getcog(model)
cog = Vector3.new(R.X/mass,R.Y/mass,R.Z/mass)


leftaileron = {}
rightaileron = {}
frontelevator = {}
rearelevator = {}

rearleftelevon = {}
rearrightelevon = {}
frontleftelevon = {}
frontrightelevon = {}

for i,v in pairs(script.Parent.Parent.Parent:GetChildren()) do
&#9;if v.Name == &quot;aileron&quot; then
&#9;&#9;local w = Instance.new(&quot;Weld&quot;)
&#9;&#9;w.Part0 = model.motor
&#9;&#9;w.Part1 = v
&#9;&#9;w.C0  = model.motor.CFrame:toObjectSpace(v.CFrame)
&#9;&#9;local x,y,z = w.C0:toEulerAnglesXYZ() 
&#9;&#9;w.Parent = v
&#9;&#9;local tab = {v,Vector3.new(x,y,z),model.motor.CFrame:pointToObjectSpace(v.Position)}
&#9;&#9;if model.motor.CFrame:pointToObjectSpace(v.Position).X &gt; 0 then
&#9;&#9;&#9;table.insert(leftaileron,tab)
&#9;&#9;else
&#9;&#9;&#9;table.insert(rightaileron,tab)
&#9;&#9;end
&#9;elseif v.Name == &quot;elevator&quot; then
&#9;&#9;v:BreakJoints()
&#9;&#9;local w = Instance.new(&quot;Weld&quot;)
&#9;&#9;w.Part0 = model.motor
&#9;&#9;w.Part1 = v
&#9;&#9;w.C0  = model.motor.CFrame:toObjectSpace(v.CFrame)
&#9;&#9;local x,y,z = w.C0:toEulerAnglesXYZ()  
&#9;&#9;w.Parent = v
&#9;&#9;local tab = {v,Vector3.new(x,y,z),model.motor.CFrame:pointToObjectSpace(v.Position)}
&#9;&#9;if model.motor.CFrame:pointToObjectSpace(v.Position).Z &lt; 0 then
&#9;&#9;&#9;table.insert(frontelevator,tab)
&#9;&#9;else
&#9;&#9;&#9;table.insert(rearelevator,tab)
&#9;&#9;end&#9;&#9;
&#9;elseif v.Name == &quot;elevon&quot; then
&#9;&#9;v:BreakJoints()
&#9;&#9;script.Parent.Parent.Parent.elevon2:MakeJoints()
&#9;&#9;script.Parent.Parent.Parent.elevon3:MakeJoints()
&#9;&#9;local w = Instance.new(&quot;Weld&quot;)
&#9;&#9;w.Part0 = model.motor
&#9;&#9;w.Part1 = v
&#9;&#9;w.C0  = model.motor.CFrame:toObjectSpace(v.CFrame)
&#9;&#9;local x,y,z = w.C0:toEulerAnglesXYZ() 
&#9;&#9;w.Parent = v
&#9;&#9;v.Anchored = false
&#9;&#9;local tab = {v,Vector3.new(x,y,z),model.motor.CFrame:toObjectSpace(v.CFrame)}
&#9;&#9;if model.motor.CFrame:pointToObjectSpace(v.Position).Z &lt; 0 then
&#9;&#9;&#9;if model.motor.CFrame:pointToObjectSpace(v.Position).X &gt; 0 then
&#9;&#9;&#9;&#9;table.insert(frontrightelevon,tab)
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;table.insert(frontleftelevon,tab)
&#9;&#9;&#9;end
&#9;&#9;else
&#9;&#9;&#9;if model.motor.CFrame:pointToObjectSpace(v.Position).X &gt; 0 then
&#9;&#9;&#9;&#9;table.insert(rearrightelevon,tab)
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;table.insert(rearleftelevon,tab)
&#9;&#9;&#9;end&#9;&#9;&#9;
&#9;&#9;end&#9;&#9;&#9;&#9;
&#9;end
end

elevs = 0
aileron = 0

FLelevon = 0
FRelevon = 0
RLelevon = 0
RRelevon = 0
--script.Parent.Anchored = false
--wait()
--wait()
--script.Parent.Anchored = true

cw = game.Lighting.counterweight:Clone()
cw.Parent = model
cww = Instance.new(&quot;Weld&quot;)
cww.Part0 = model.motor
cww.Part1 = cw
cww.C0 = CFrame.new(cog)
cww.Parent = model.motor

script.Parent.ChildRemoved:connect(function(c)
&#9;if c:IsA(&quot;Weld&quot;) and c.Name == &quot;SeatWeld&quot; then
&#9;&#9;p = game.Players:GetPlayerFromCharacter(c.Part1.Parent)
&#9;&#9;if p ~= nil then 
&#9;&#9;&#9;p.Backpack.localaerodyn.glider.Value = nil
&#9;&#9;end  
&#9;end
end)

function papi()
&#9;while wait() do
&#9;&#9;wwww = (script.Parent.Position.X - workspace.runway.threashold.Part.Position.X+160)*0.7
&#9;&#9;wwwr = (script.Parent.Position.X - workspace.runway.threashold.Part.Position.X+100)*0.7
&#9;&#9;wwrr = (script.Parent.Position.X - workspace.runway.threashold.Part.Position.X+40)*0.7
&#9;&#9;wrrr = (script.Parent.Position.X - workspace.runway.threashold.Part.Position.X-10)*0.7
&#9;&#9;rrrr = (script.Parent.Position.X - workspace.runway.threashold.Part.Position.X-70)*0.7
&#9;&#9;if model.motor.Position.Y &gt;= wwrr then
&#9;&#9;&#9;workspace.runway.papi1.light1.BrickColor = BrickColor.new(&quot;Institutional white&quot;) 
&#9;&#9;&#9;workspace.runway.papi1.light2.BrickColor = BrickColor.new(&quot;Institutional white&quot;)
&#9;&#9;&#9;workspace.runway.papi2.light1.BrickColor = BrickColor.new(&quot;Institutional white&quot;) 
&#9;&#9;&#9;workspace.runway.papi2.light2.BrickColor = BrickColor.new(&quot;Institutional white&quot;)&#9;&#9;&#9;
&#9;&#9;&#9;if model.motor.Position.Y &lt; wwww then
&#9;&#9;&#9;&#9;workspace.runway.papi1.light4.BrickColor = BrickColor.new(&quot;Bright red&quot;)
&#9;&#9;&#9;&#9;workspace.runway.papi2.light4.BrickColor = BrickColor.new(&quot;Bright red&quot;)&#9;&#9;&#9;
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;workspace.runway.papi1.light4.BrickColor = BrickColor.new(&quot;Institutional white&quot;)
&#9;&#9;&#9;&#9;workspace.runway.papi2.light4.BrickColor = BrickColor.new(&quot;Institutional white&quot;)&#9;&#9;&#9;
&#9;&#9;&#9;end
&#9;&#9;&#9;if model.motor.Position.Y &lt; wwwr then
&#9;&#9;&#9;&#9;workspace.runway.papi1.light3.BrickColor = BrickColor.new(&quot;Bright red&quot;)
&#9;&#9;&#9;&#9;workspace.runway.papi2.light3.BrickColor = BrickColor.new(&quot;Bright red&quot;)
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;workspace.runway.papi1.light3.BrickColor = BrickColor.new(&quot;Institutional white&quot;)
&#9;&#9;&#9;&#9;workspace.runway.papi2.light3.BrickColor = BrickColor.new(&quot;Institutional white&quot;)
&#9;&#9;&#9;end
&#9;&#9;else
&#9;&#9;&#9;workspace.runway.papi1.light4.BrickColor = BrickColor.new(&quot;Bright red&quot;) 
&#9;&#9;&#9;workspace.runway.papi1.light3.BrickColor = BrickColor.new(&quot;Bright red&quot;)
&#9;&#9;&#9;workspace.runway.papi2.light4.BrickColor = BrickColor.new(&quot;Bright red&quot;) 
&#9;&#9;&#9;workspace.runway.papi2.light3.BrickColor = BrickColor.new(&quot;Bright red&quot;)&#9;&#9;&#9;
&#9;&#9;&#9;if model.motor.Position.Y &gt; rrrr then
&#9;&#9;&#9;&#9;workspace.runway.papi1.light1.BrickColor = BrickColor.new(&quot;Institutional white&quot;)
&#9;&#9;&#9;&#9;workspace.runway.papi2.light1.BrickColor = BrickColor.new(&quot;Institutional white&quot;)
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;workspace.runway.papi1.light1.BrickColor = BrickColor.new(&quot;Bright red&quot;)
&#9;&#9;&#9;&#9;workspace.runway.papi2.light1.BrickColor = BrickColor.new(&quot;Bright red&quot;)&#9;&#9;&#9;
&#9;&#9;&#9;end
&#9;&#9;&#9;if model.motor.Position.Y &gt; wrrr then
&#9;&#9;&#9;&#9;workspace.runway.papi1.light2.BrickColor = BrickColor.new(&quot;Institutional white&quot;)
&#9;&#9;&#9;&#9;workspace.runway.papi2.light2.BrickColor = BrickColor.new(&quot;Institutional white&quot;)&#9;&#9;&#9;
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;workspace.runway.papi1.light2.BrickColor = BrickColor.new(&quot;Bright red&quot;)
&#9;&#9;&#9;&#9;workspace.runway.papi2.light2.BrickColor = BrickColor.new(&quot;Bright red&quot;)&#9;&#9;
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end&#9;
end

script.Parent.ChildAdded:connect(function(c)
&#9;script.Parent.Parent.Parent.beginflight.Changed:wait()
&#9;workspace.disembark.open.Value = false
&#9;script.Parent.Parent.Parent.openpayload.Value = false
&#9;wait(2)
&#9;script.Parent.Anchored = false
&#9;coroutine.resume(coroutine.create(papi))
&#9;for i,v in pairs(model:GetChildren()) do
&#9;&#9;if v:IsA(&quot;BasePart&quot;) then
&#9;&#9;&#9;v.Velocity = Vector3.new(0,0.1,0)
&#9;&#9;&#9;v.CanCollide = false
&#9;&#9;end
&#9;end
&#9;for i,v in pairs(model.seat:GetChildren()) do
&#9;&#9;if v:IsA(&quot;BasePart&quot;) then
&#9;&#9;&#9;v.Velocity = Vector3.new(0,0.1,0)
&#9;&#9;&#9;v.CanCollide = false
&#9;&#9;end
&#9;end&#9;
&#9;if c:IsA(&quot;Weld&quot;) and c.Name == &quot;SeatWeld&quot; then
&#9;&#9;p = game.Players:GetPlayerFromCharacter(c.Part1.Parent)
&#9;&#9;if p ~= nil then 
&#9;&#9;&#9;p.Backpack.localaerodyn.glider.Value = script.Parent.Parent.Parent
&#9;&#9;end
&#9;&#9;if script.Parent:FindFirstChild(&quot;SeatWeld&quot;) then
&#9;&#9;&#9;temp = game.Players:GetPlayerFromCharacter(script.Parent.SeatWeld.Part1.Parent)
&#9;&#9;&#9;if  temp ~= p then return end
&#9;&#9;end
&#9;&#9;player = p
&#9;&#9;toucheddebounce = false
&#9;&#9;while script.Parent:FindFirstChild(&quot;SeatWeld&quot;) do
&#9;&#9;&#9;if script.Parent.Throttle == -1 and script.Parent.Steer == 0 then 
