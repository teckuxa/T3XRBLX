					<string name="Name">Script</string>
					<ProtectedString name="Source">repeat wait() until workspace.master.ready.Value
if script.Parent.status.Value ~= &quot;Sspawning&quot; then
&#9;script.Parent:Remove()
end
workspace.disembark.open.Value = true
workspace.master.sts.Value = workspace.master.sts.Value +1
sts = workspace.master.sts.Value

list = {&quot;Endeavour&quot;,&quot;Atlantis&quot;,&quot;Discovery&quot;}
script.Parent:MoveTo(Vector3.new(120,194,1983))
if (script.Parent.Mover.motor.Position - Vector3.new(82.2, 403.7, 1983)).Magnitude &gt; 5 then&#9;
&#9;script.Parent:Remove()
&#9;new = game.Lighting.rocket.shuttle:Clone()
&#9;new.Parent = workspace.rockets
&#9;new:MakeJoints()
end
function btouched(p)
&#9;if p.Parent == script.Parent then return end
&#9;if p.Parent:FindFirstChild(&quot;openpayload&quot;) ~= nil then
&#9;&#9;local exp = Instance.new(&quot;Explosion&quot;)
&#9;&#9;exp.Position = p.Position
&#9;&#9;exp.Parent = workspace
&#9;&#9;wait(10)
&#9;&#9;script.Parent.Parent = workspace.rentering
&#9;&#9;p.Parent.Parent = workspace.rentering
&#9;&#9;for i,v in pairs(game.Players:GetPlayers()) do
&#9;&#9;&#9;if v.PlayerGui.ScreenGui.launchgui.Visible == true then
&#9;&#9;&#9;&#9;v.PlayerGui.ScreenGui.launchgui.Visible = false
&#9;&#9;&#9;&#9;v.PlayerGui.ScreenGui.launchgui.Visible = true
&#9;&#9;&#9;end
&#9;&#9;&#9;if v.PlayerGui.ScreenGui.launchgui.listening.Value == script.Parent or v.PlayerGui.ScreenGui.launchgui.listening.Value == p.Parent then
&#9;&#9;&#9;&#9;v.PlayerGui.ScreenGui.launchgui.listening.Value = nil
&#9;&#9;&#9;end
&#9;&#9;&#9;if v.PlayerGui.ScreenGui.astronaught.Visible == true then
&#9;&#9;&#9;&#9;if v.PlayerGui.ScreenGui.astronaught.listening.Value == script.Parent or v.PlayerGui.ScreenGui.astronaught.listening.Value == p.Parent then
&#9;&#9;&#9;&#9;&#9;v.PlayerGui.ScreenGui.astronaught.Visible = false
&#9;&#9;&#9;&#9;&#9;v.PlayerGui.ScreenGui.astronaught.listening.Value = nil
&#9;&#9;&#9;&#9;&#9;v.PlayerGui.ScreenGui.openastro.Visible = false
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end&#9;&#9;
&#9;&#9;p.Parent:Remove()
&#9;&#9;script.Parent:Remove()
&#9;end
end

function givexp(name,xps,s)
&#9;if workspace.playerdata:FindFirstChild(name) ~= nil then
&#9;&#9;workspace.playerdata[name][s].Value = workspace.playerdata[name][s].Value + 1
&#9;&#9;workspace.playerdata[name].xp.Value = workspace.playerdata[name].xp.Value + xps
&#9;else
&#9;&#9;local new = game.Lighting.temp:clone()
&#9;&#9;new.Name = name
&#9;&#9;new.Parent = workspace.playerdata&#9;&#9;&#9;&#9;
&#9;&#9;workspace.playerdata[name][s].Value = workspace.playerdata[name][s].Value + 1
&#9;&#9;workspace.playerdata[name].xp.Value = workspace.playerdata[name].xp.Value + xps&#9;&#9;&#9;
&#9;end
end

function updatestatus()&#9;
&#9;for _,v in pairs(game.Players:GetPlayers()) do
&#9;&#9;if v.PlayerGui.ScreenGui.launchgui.Visible == true then
&#9;&#9;&#9;if v.PlayerGui.ScreenGui.launchgui.listening.Value == script.Parent then
&#9;&#9;&#9;&#9;v.PlayerGui.ScreenGui.launchgui.rocketstatus.Value = script.Parent.status.Value
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;if v.PlayerGui.ScreenGui.astronaught.Visible == true then
&#9;&#9;&#9;if v.PlayerGui.ScreenGui.astronaught.listening.Value == script.Parent then
&#9;&#9;&#9;&#9;v.PlayerGui.ScreenGui.astronaught.status.Value = script.Parent.status.Value
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;
&#9;if script.Parent.status.Value == &quot;launched&quot; then
&#9;&#9;if script.Parent.launcher.Value ~= nil then
&#9;&#9;&#9;if Game:GetService(&quot;BadgeService&quot;):UserHasBadge(script.Parent.launcher.Value.userId,58222109) == false then
&#9;&#9;&#9;&#9;game:GetService(&quot;BadgeService&quot;):AwardBadge(script.Parent.launcher.Value.userId,58222109)
&#9;&#9;&#9;end
&#9;&#9;&#9;o,e = pcall(givexp,script.Parent.launcher.Value.Name,50,&quot;rocketslaunched&quot;)
&#9;&#9;&#9;if o == false then
&#9;&#9;&#9;&#9;script.Parent.launcher.Value.PlayerGui.ScreenGui.errorcode.Visible = true
&#9;&#9;&#9;&#9;script.Parent.launcher.Value.PlayerGui.ScreenGui.errorcode.TextBox.Text = &quot;mission control launch error: &quot; .. e .. &quot; version:&quot; .. workspace.version.Value&#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;for i,v in pairs(script.Parent.seat:GetChildren()) do
&#9;&#9;&#9;&#9;&#9;if v:FindFirstChild(&quot;SeatWeld&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;player = game.Players:GetPlayerFromCharacter(v.SeatWeld.Part1.Parent)
&#9;&#9;&#9;&#9;&#9;&#9;if player then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;player.PlayerGui.ScreenGui.errorcode.Visible = true
&#9;&#9;&#9;&#9;&#9;&#9;&#9;player.PlayerGui.ScreenGui.errorcode.TextBox.Text = &quot;mission control launch error: &quot; .. e .. &quot; version:&quot; .. workspace.version.Value
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end&#9;&#9;&#9;&#9;
&#9;&#9;&#9;end&#9;&#9;&#9;
&#9;&#9;end
&#9;&#9;launch()
&#9;elseif script.Parent.status.Value == &quot;Seundock&quot; then
&#9;&#9;script.Parent.dockingport.Anchored = false
&#9;&#9;script.Parent.dockingport.Transparency = 0
&#9;&#9;script.Parent.dockingport.CanCollide = true&#9;
&#9;&#9;workspace.ISS.dock2.dockingport.Transparency = 0
&#9;&#9;workspace.ISS.dock2.dockingport.CanCollide = true
&#9;&#9;workspace.ISS.dock2.occupied.Value = false
&#9;&#9;while (script.Parent.dockingport.Position - dock).Magnitude &lt; 20 do
&#9;&#9;&#9;wait (1)
&#9;&#9;&#9;script.Parent.motor.BodyVelocity.velocity = Vector3.new(-5,0,0)
&#9;&#9;end&#9;
&#9;&#9;script.Parent.openpayload.Value = false
&#9;&#9;wait (4)
&#9;&#9;land()
&#9;end
end

script.Parent.status.Changed:connect(updatestatus)
exp = 50
name = nil
while script.Parent.Name == &quot;shuttle&quot; do
&#9;name = list[math.random(1,#list)]&#9;
&#9;if workspace.rockets:FindFirstChild(name) == nil then 
&#9;&#9;script.Parent.Name = name
&#9;elseif workspace.rockets:FindFirstChild(list[1]) ~= nil and workspace.rockets:FindFirstChild(list[2]) ~= nil and workspace.rockets:FindFirstChild(list[3]) ~= nil then
&#9;&#9;script.Parent.Name = name
&#9;end
&#9;wait()
end
workspace.crawler.motor.Anchored = false
workspace.crawler.motor.BodyVelocity.velocity = Vector3.new(-30,0,0)
while workspace.crawler.motor.Position.X &gt; 455 do
&#9;wait()&#9;
end
for i = 1,84 do
&#9;workspace.shuttlepad.door1.CFrame = CFrame.new(workspace.shuttlepad.door1.Position.X,workspace.shuttlepad.door1.Position.Y,2030 + i)
&#9;workspace.shuttlepad.door2.CFrame = CFrame.new(workspace.shuttlepad.door2.Position.X,workspace.shuttlepad.door2.Position.Y,1944 - i)
wait()
end
while workspace.crawler.motor.Position.X &gt; 111 do
&#9;wait()&#9;
end
workspace.crawler.motor.BodyVelocity.velocity = Vector3.new(0,0,0)
for i = 1,84 do
&#9;workspace.shuttlepad.door1.CFrame = CFrame.new(workspace.shuttlepad.door1.Position.X,workspace.shuttlepad.door1.Position.Y,2114 - i)
&#9;workspace.shuttlepad.door2.CFrame = CFrame.new(workspace.shuttlepad.door2.Position.X,workspace.shuttlepad.door2.Position.Y,1860 + i)
wait()
end
