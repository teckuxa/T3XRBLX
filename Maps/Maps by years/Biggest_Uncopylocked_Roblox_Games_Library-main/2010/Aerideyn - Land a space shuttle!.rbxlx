&#9;&#9;&#9;&#9;if num == 1 then
&#9;&#9;&#9;&#9;&#9;count = count + num
&#9;&#9;&#9;&#9;&#9;v.PlayerGui.ScreenGui.requestlaunch.Visible = true
&#9;&#9;&#9;&#9;&#9;v.PlayerGui.ScreenGui.requestlaunch.listening.Value = script.Parent.Parent.Parent.Parent
&#9;&#9;&#9;&#9;&#9;if rocket:FindFirstChild(&quot;openpayload&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;v.PlayerGui.ScreenGui.requestlaunch.Text = script.Parent.Parent.Parent.Parent.Name .. &quot; of &quot; .. script.Parent.listening.Value.Name .. &quot; has requested a launch!&quot;&#9;&#9;&#9;&#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;v.PlayerGui.ScreenGui.requestlaunch.Text = script.Parent.Parent.Parent.Parent.Name .. &quot; of &quot; .. script.Parent.listening.Value.Parent.Name .. &quot; has requested a launch!&quot;
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;script.Parent.notices.data1.Text = &quot;ERROR&quot;
&#9;&#9;&#9;&#9;script.Parent.notices.data2.Text = &quot;pm aerideyn with this:&quot;
