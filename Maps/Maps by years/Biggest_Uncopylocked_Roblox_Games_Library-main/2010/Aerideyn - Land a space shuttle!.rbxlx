function openastro()
&#9;script.Parent.Visible = true
&#9;script.Parent.Parent.openastro.Visible = false
end

function close()
&#9;script.Parent.Visible = false
&#9;script.Parent.Parent.openastro.Visible = true
end

function open(property)
&#9;if property == &quot;Visible&quot; and script.Parent.Visible == true then
&#9;&#9;script.Parent.dockingport.Visible = false
&#9;&#9;script.Parent.notices.data1.TextColor3 = Color3.new(27/255,42/255,53/255)
&#9;&#9;script.Parent.notices.data1.Text = &quot;Watch this panel for&quot;
&#9;&#9;script.Parent.notices.data2.Text = &quot;important instructions.&quot;
