function deploy()
&#9;if dp then
&#9;&#9;dp = false
&#9;&#9;for i,v in pairs(script.Parent.Parent.Parent.parachute:GetChildren()) do
&#9;&#9;&#9;v.Transparency = 0
&#9;&#9;end
&#9;&#9;if script.Parent.Parent.Parent:FindFirstChild(&quot;counterweight&quot;) then
&#9;&#9;&#9;script.Parent.Parent.Parent.counterweight:remove()
&#9;&#9;end
&#9;end
end

