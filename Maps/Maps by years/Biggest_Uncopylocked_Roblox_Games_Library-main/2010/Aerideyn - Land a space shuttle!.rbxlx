							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">dptemp = script.Parent.dp1:Clone()
script.Parent.dp1:Remove()

for i,v in pairs(game.workspace.ISS.dockingport:GetChildren()) do
&#9;local newport = dptemp:Clone()
&#9;newport.Position = UDim2.new(0,0,((i-1)*0.1)+0.05,0)
&#9;newport.port.Value = v
&#9;newport.Text = &quot;Docking port: &quot; .. v.portnumber.Value
&#9;newport.Parent = script.Parent
end

script.Parent.close.MouseButton1Down:connect(function()
&#9;script.Parent.Visible = false
end)
</ProtectedString>
