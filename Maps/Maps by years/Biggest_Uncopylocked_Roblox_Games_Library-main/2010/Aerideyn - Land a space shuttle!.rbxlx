						<string name="Name">Script</string>
						<ProtectedString name="Source">function next()
&#9;script.Parent.frame.Value = script.Parent.frame.Value +1
end

function prev()
&#9;script.Parent.frame.Value = script.Parent.frame.Value -1
end

function framechanged()
&#9;if script.Parent.frame.Value &gt; 1 then
&#9;&#9;script.Parent.previous.Visible = true
&#9;else
&#9;&#9;script.Parent.previous.Visible = false
&#9;end
&#9;if script.Parent.frame.Value &lt; #script.Parent.astronaughtdecals:GetChildren() then
&#9;&#9;script.Parent.next.Visible = true
&#9;else
&#9;&#9;script.Parent.next.Visible = false
&#9;end
&#9;for i,v in pairs(script.Parent.astronaughtdecals:GetChildren()) do
&#9;&#9;v.Visible = false
&#9;end
&#9;script.Parent.astronaughtdecals[&quot;Frame&quot;..script.Parent.frame.Value].Visible = true&#9;&#9;&#9;
end
&#9;
function close()
&#9;script.Parent.Visible = false
&#9;script.Parent.frame.Value = 1
end

script.Parent.frame.Changed:connect(function() 
&#9;o,e = pcall(framechanged)
&#9;if not o then
&#9;&#9;script.Parent.TextLabel.Text = &quot;ERROR!!!: &quot; .. e
&#9;end
end)

script.Parent.close.MouseButton1Click:connect(function() 
&#9;o,e = pcall(close)
&#9;if not o then
&#9;&#9;script.Parent.TextLabel.Text = &quot;ERROR!!!: &quot; .. e
&#9;end
end)
script.Parent.previous.MouseButton1Click:connect(function() 
