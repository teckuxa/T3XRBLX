						<Item class="TextLabel" referent="RBX4848">
							<Properties>
								<bool name="Active">false</bool>
								<bool name="Archivable">true</bool>
								<Color3 name="BackgroundColor3">4288914085</Color3>
								<float name="BackgroundTransparency">0</float>
