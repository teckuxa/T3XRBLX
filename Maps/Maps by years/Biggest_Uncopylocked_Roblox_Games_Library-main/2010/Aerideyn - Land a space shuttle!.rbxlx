&#9;&#9;script.Parent.Tankandboosters:remove()
&#9;end

&#9;script.Parent.openpayload.Value = true
&#9;script.Parent.status.Value = &quot;Sissapproach&quot;
&#9;if empty == true then
&#9;&#9;dock = workspace.ISS.dock2.dockingport.Position
&#9;&#9;cf = workspace.cframestates.emptydock.CFrame&#9;&#9;
&#9;&#9;wait(5)
&#9;else
&#9;&#9;dock = workspace.ISS.dock.dockingport.Position
&#9;&#9;cf = workspace.cframestates.level.CFrame&#9;
&#9;end&#9;
&#9;script.Parent.motor.moveablegyro.cframe = cf&#9;&#9;&#9;
&#9;while (script.Parent.dockingport.Position - dock).Magnitude &gt; 1 do
&#9;&#9;wait()
&#9;&#9;ratio = (script.Parent.dockingport.Position - dock).Unit
&#9;&#9;script.Parent.motor.BodyVelocity.velocity = Vector3.new(ratio.X*-5,5*-ratio.Y,-ratio.Z*5)
&#9;end&#9;

&#9;script.Parent.status.Value = &quot;Sharddock&quot;
&#9;script.Parent.dockingport.Anchored = true
&#9;script.Parent.dockingport.Transparency = 1
&#9;script.Parent.dockingport.CanCollide = false&#9;
&#9;if empty == true then
&#9;&#9;for i,v in pairs(workspace.ISS:GetChildren()) do&#9;&#9;
