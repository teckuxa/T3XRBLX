&#9;&#9;script.Parent.notices.data3.Text = &quot;Landing gear armed.&quot;&#9;&#9;
&#9;end
end
cooldown = false

function pending()
&#9;script.Parent.controls.launch.Text = &quot;Pending...&quot;
&#9;timer = 0
&#9;while script.Parent.controls.launch.buisy.Value == true and count &gt; 0 and timer &lt; 30 do
&#9;&#9;timer = timer + 1
&#9;&#9;if timer &gt; 10 then
&#9;&#9;&#9;count = 0
&#9;&#9;&#9;for i,v in pairs(game.Players:GetPlayers()) do&#9;
&#9;&#9;&#9;&#9;outcome,num = pcall(check,v)
&#9;&#9;&#9;&#9;if outcome then
&#9;&#9;&#9;&#9;&#9;if num == 1 then
&#9;&#9;&#9;&#9;&#9;&#9;count = count + 1 
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;script.Parent.notices.data1.Text = &quot;ERROR&quot;
&#9;&#9;&#9;&#9;&#9;script.Parent.notices.data2.Text = &quot;pm aerideyn with this:&quot;
&#9;&#9;&#9;&#9;&#9;script.Parent.notices.data3.Text = &quot;pending:check()&quot;&#9;&#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end&#9;&#9;&#9;
&#9;&#9;end&#9;&#9;&#9;
&#9;&#9;wait(1)
&#9;end&#9;&#9;&#9;
&#9;if count == 0 or timer &gt;= 30 then
&#9;&#9;script.Parent.controls.launch.Text = &quot;Failed.&quot;&#9;&#9;&#9;&#9;
&#9;&#9;script.Parent.notices.data1.Text = &quot;Mission controlers.&quot;
&#9;&#9;script.Parent.notices.data2.Text = &quot;Either AFK or have left.&quot;
&#9;&#9;script.Parent.notices.data3.Text = &quot;the game; try again.&quot;
&#9;&#9;for i,v in pairs(game.Players:GetPlayers()) do
&#9;&#9;&#9;if v.PlayerGui.ScreenGui.launchgui.Visible == true then
&#9;&#9;&#9;&#9;--if v.PlayerGui.ScreenGui.launchgui.listening.Value == script.Parent.listening.Value then
&#9;&#9;&#9;&#9;v.PlayerGui.ScreenGui.requestlaunch.Visible = false&#9;&#9;
&#9;&#9;&#9;&#9;--end
&#9;&#9;&#9;end
&#9;&#9;end&#9;
&#9;&#9;wait(3)
&#9;&#9;for i = 10,1,-1 do
&#9;&#9;&#9;script.Parent.controls.launch.Text = &quot;Try again in: &quot;..i
&#9;&#9;&#9;wait(1)
&#9;&#9;end
&#9;&#9;script.Parent.controls.launch.Text = &quot;Request Launch.&quot;
&#9;&#9;script.Parent.notices.data1.Text = &quot;Watch this panel for&quot;
&#9;&#9;script.Parent.notices.data2.Text = &quot;important instructions.&quot;
&#9;&#9;script.Parent.notices.data3.Text = &quot;enjoy your flight.&quot;&#9;&#9;&#9;
&#9;end
end

function check(v)
&#9;if v.PlayerGui.ScreenGui.launchgui.Visible == true then
&#9;&#9;if v.PlayerGui.ScreenGui.requestlaunch.Visible == false then
&#9;&#9;&#9;return(1)
&#9;&#9;end
&#9;end
&#9;return(0)
end

function keepchecking(rocket)
&#9;while script.Parent.listening.Value == rocket and script.Parent.listening.Value.status.Value ~= &quot;launched&quot; and (script.Parent.Visible == true or script.Parent.Parent.openastro.Visible == true) do
&#9;&#9;wait()
