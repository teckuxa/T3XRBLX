&#9;&#9;workspace.ISS.dock.dockingport.CanCollide = false
&#9;end
&#9;wait(50)
&#9;script.Parent.dockingport.Anchored = false
&#9;script.Parent.dockingport.Transparency = 0
&#9;script.Parent.dockingport.CanCollide = true&#9;
&#9;workspace.ISS.dock.dockingport.Transparency = 0
&#9;workspace.ISS.dock.dockingport.CanCollide = true
&#9;while (script.Parent.dockingport.Position - dock).Magnitude &lt; 20 do
