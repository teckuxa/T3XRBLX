&#9;&#9;&#9;end
&#9;&#9;&#9;
&#9;&#9;&#9;for i,v in pairs(rearelevator) do
&#9;&#9;&#9;&#9;v[1].Weld.C0 = CFrame.new(v[3].X, v[3].Y + math.sin(math.rad(elevs)),v[3].Z + math.cos(math.rad(elevs)) ) * CFrame.Angles(v[2].X - math.rad(elevs),v[2].Y,v[2].Z)&#9;&#9;&#9;&#9;&#9;
&#9;&#9;&#9;end
&#9;&#9;&#9;for i,v in pairs(frontelevator) do
&#9;&#9;&#9;&#9;v[1].Weld.C0 = CFrame.new(v[3].X, v[3].Y + math.sin(math.rad(-elevs)),v[3].Z + math.cos(math.rad(-elevs)) ) * CFrame.Angles(v[2].X - math.rad(-elevs),v[2].Y,v[2].Z)&#9;&#9;&#9;&#9;&#9;
&#9;&#9;&#9;end
&#9;&#9;&#9;for i,v in pairs(leftaileron) do
&#9;&#9;&#9;&#9;v[1].Weld.C0 = CFrame.new(v[3].X, (v[3].Y + math.sin(math.rad(-aileron))),v[3].Z -((1-(math.cos(math.rad(-aileron)))) *2)) * CFrame.Angles(v[2].X - math.rad(-aileron),v[2].Y,v[2].Z)&#9;&#9;&#9;&#9;&#9;
&#9;&#9;&#9;end&#9;&#9;&#9;
