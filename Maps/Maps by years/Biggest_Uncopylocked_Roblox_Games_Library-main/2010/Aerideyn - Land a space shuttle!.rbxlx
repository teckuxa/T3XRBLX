									<YS>0</YS>
									<YO>0</YO>
								</UDim2>
								<token name="SizeConstraint">0</token>
								<string name="Text">This means that elevators would not be able to be attached to a shuttle.</string>
								<Color3 name="TextColor3">4279970357</Color3>
								<float name="TextTransparency">0</float>
