			<Item class="Script" referent="RBX648">
				<Properties>
					<bool name="Archivable">true</bool>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">script.Parent.Seat.ChildAdded:connect(function(c)
&#9;if c:IsA(&quot;Weld&quot;) then 
&#9;&#9;player = game.Players:GetPlayerFromCharacter(c.Part1.Parent)
&#9;&#9;if player then
&#9;&#9;&#9;if workspace.playerdata:FindFirstChild(player.Name) then
&#9;&#9;&#9;&#9;if workspace.playerdata[player.Name].exam1complete.Value == false then
&#9;&#9;&#9;&#9;&#9;player.PlayerGui.ScreenGui.exam1.frame.Value = 1
&#9;&#9;&#9;&#9;&#9;player.PlayerGui.ScreenGui.exam1.Visible = true
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;local new = game.Lighting.temp:clone()
&#9;&#9;&#9;&#9;new.Name = player.Name
&#9;&#9;&#9;&#9;new.Parent = workspace.playerdata
&#9;&#9;&#9;&#9;player.PlayerGui.ScreenGui.exam1.frame.Value = 1
&#9;&#9;&#9;&#9;player.PlayerGui.ScreenGui.exam1.Visible = true
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end)

script.Parent.Seat.ChildRemoved:connect(function(c)
&#9;if c:IsA(&quot;Weld&quot;) then 
&#9;&#9;player = game.Players:GetPlayerFromCharacter(c.Part1.Parent)
&#9;&#9;if player then
&#9;&#9;&#9;if workspace.playerdata:FindFirstChild(player.Name) then
&#9;&#9;&#9;&#9;if workspace.playerdata[player.Name].exam1complete.Value == false then
&#9;&#9;&#9;&#9;&#9;player.PlayerGui.ScreenGui.exam1.frame.Value = 1
&#9;&#9;&#9;&#9;&#9;player.PlayerGui.ScreenGui.exam1.Visible = false
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;local new = game.Lighting.temp:clone()
&#9;&#9;&#9;&#9;new.Name = player.Name
&#9;&#9;&#9;&#9;new.Parent = workspace.playerdata
&#9;&#9;&#9;&#9;player.PlayerGui.ScreenGui.exam1.frame.Value = 1
&#9;&#9;&#9;&#9;player.PlayerGui.ScreenGui.exam1.Visible = false
&#9;&#9;&#9;end&#9;&#9;&#9;
&#9;&#9;end
&#9;end
end)</ProtectedString>
				</Properties>
			</Item>
		</Item>
