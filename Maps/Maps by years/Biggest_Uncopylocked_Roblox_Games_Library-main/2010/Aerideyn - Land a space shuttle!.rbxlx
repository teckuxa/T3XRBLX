				<Item class="Script" referent="RBX5030">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">finish = false
score = 0
localplayer = script.Parent.Parent.Parent.Parent
function parentchanged(p)
&#9;if p == &quot;Visible&quot; then
&#9;&#9;if script.Parent.Visible == true then
&#9;&#9;&#9;score = 0
&#9;&#9;&#9;script.Parent.frame.Value = 1
&#9;&#9;&#9;script.Parent.astronaughtdecals[&quot;Frame&quot;..script.Parent.frame.Value].Visible = true
&#9;&#9;end
&#9;end
end

function framechanged()
&#9;for i,v in pairs(script.Parent.astronaughtdecals:GetChildren()) do
&#9;&#9;v.Visible = false
&#9;end
&#9;script.Parent.astronaughtdecals[&quot;Frame&quot;..script.Parent.frame.Value].Visible = true&#9;&#9;&#9;
end
&#9;
function close()
&#9;script.Parent.Visible = false
&#9;script.Parent.frame.Value = 1
end

function checkfinish()
&#9;if script.Parent.frame.Value == 7 then
&#9;&#9;for i,v in pairs(script.Parent.astronaughtdecals:GetChildren()) do
&#9;&#9;&#9;v.Visible = false
&#9;&#9;end
&#9;&#9;if score == 6 then
&#9;&#9;&#9;script.Parent.astronaughtdecals[&quot;Frame&quot;..script.Parent.frame.Value].score.Text = &quot;Score: 100%. PASS&quot; 
&#9;&#9;&#9;if workspace.playerdata:FindFirstChild(localplayer.Name) ~= nil then
&#9;&#9;&#9;&#9;workspace.playerdata[localplayer.Name].exam2complete.Value = true
&#9;&#9;&#9;&#9;localplayer.TeamColor = BrickColor.new(&quot;Bright blue&quot;)
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;local new = game.Lighting.temp:clone()
&#9;&#9;&#9;&#9;new.Name = localplayer.Name
&#9;&#9;&#9;&#9;new.Parent = workspace.playerdata&#9;&#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;workspace.playerdata[localplayer.Name].exam2complete.Value = true
&#9;&#9;&#9;end
&#9;&#9;else&#9;
&#9;&#9;&#9;script.Parent.astronaughtdecals[&quot;Frame&quot;..script.Parent.frame.Value].score.Text = &quot;Score: &quot; .. math.floor((score/6)*100) .. &quot;% FAIL&quot; 
&#9;&#9;end
&#9;&#9;script.Parent.astronaughtdecals[&quot;Frame&quot;..script.Parent.frame.Value].Visible = true
&#9;end
end

function correct()
&#9;score = score +1
&#9;script.Parent.frame.Value = script.Parent.frame.Value +1
&#9;o,e = pcall(checkfinish)
&#9;if not o then
&#9;&#9;script.Parent.TextLabel.Text = &quot;ERROR!!!: &quot; .. e
&#9;end
end

function incorrect()
&#9;script.Parent.frame.Value = script.Parent.frame.Value +1
&#9;o,e = pcall(checkfinish)
&#9;if not o then
&#9;&#9;script.Parent.TextLabel.Text = &quot;ERROR!!!: &quot; .. e
&#9;end
end

script.Parent.Changed:connect(function(p) 
&#9;o,e = pcall(parentchanged,p)
&#9;if not o then
&#9;&#9;script.Parent.TextLabel.Text = &quot;ERROR!!!: &quot; .. e
&#9;end
end)

script.Parent.frame.Changed:connect(function() 
&#9;o,e = pcall(framechanged)
&#9;if not o then
&#9;&#9;script.Parent.TextLabel.Text = &quot;ERROR!!!: &quot; .. e
&#9;end
end)

script.Parent.close.MouseButton1Click:connect(function() 
&#9;o,e = pcall(close)
&#9;if not o then
&#9;&#9;script.Parent.TextLabel.Text = &quot;ERROR!!!: &quot; .. e
&#9;end
end)


script.Parent.astronaughtdecals.Frame1.answer1.MouseButton1Click:connect(incorrect)
script.Parent.astronaughtdecals.Frame1.answer2.MouseButton1Click:connect(incorrect)
script.Parent.astronaughtdecals.Frame1.answer3.MouseButton1Click:connect(incorrect)
script.Parent.astronaughtdecals.Frame1.answer4.MouseButton1Click:connect(correct)

script.Parent.astronaughtdecals.Frame2.answer1.MouseButton1Click:connect(incorrect)
script.Parent.astronaughtdecals.Frame2.answer2.MouseButton1Click:connect(incorrect)
script.Parent.astronaughtdecals.Frame2.answer3.MouseButton1Click:connect(correct)
script.Parent.astronaughtdecals.Frame2.answer4.MouseButton1Click:connect(incorrect)

script.Parent.astronaughtdecals.Frame3.answer1.MouseButton1Click:connect(correct)
