					<string name="Name">Script</string>
					<ProtectedString name="Source">d = 30
while true do
&#9;for i = 1,360*d do
&#9;&#9;wait()
&#9;&#9;script.Parent.outer.CFrame = CFrame.new(881.5, 149.3, 1245)* CFrame.Angles(0,math.rad(i/d),0)
&#9;&#9;script.Parent.inner.CFrame = CFrame.new(881.5, 149.3, 1245)* CFrame.Angles(0,math.rad(i/d),0)
&#9;&#9;script.Parent.inneratmosphere.CFrame = CFrame.new(881.5, 149.3, 1245)* CFrame.Angles(0,math.rad(i/d),0)
&#9;end
end
</ProtectedString>
