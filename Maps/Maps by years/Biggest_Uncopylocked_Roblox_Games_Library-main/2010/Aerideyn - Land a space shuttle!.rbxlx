								<string name="Name">LocalScript</string>
								<ProtectedString name="Source">script.Parent.MouseButton1Down:connect(function()
&#9;if script.Parent.port.Value.occupied.Value == false then
&#9;&#9;script.Parent.Parent.Parent.listening.Value.target.Value = script.Parent.port.Value
