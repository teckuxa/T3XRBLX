		<Item class="Script" referent="RBX4403">
			<Properties>
				<bool name="Archivable">true</bool>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">master</string>
				<ProtectedString name="Source">game.Players.PlayerRemoving:connect(function(p)
&#9;local temp = workspace.playerdata:FindFirstChild(p.Name)
&#9;if temp then
&#9;&#9;pcall(function() p:SaveInstance(&quot;playerdata&quot;,temp) end)
&#9;&#9;temp:remove()
&#9;end
end)

function respawn(character) 
&#9;p = Game.Players:GetPlayerFromCharacter(character)
&#9;if p then
&#9;&#9;p.PlayerGui.ScreenGui.exam1.LocalScript.Disabled = true
&#9;&#9;p.PlayerGui.ScreenGui.exam2.LocalScript.Disabled = true
&#9;&#9;p.PlayerGui.ScreenGui.tutorial1.LocalScript.Disabled = true
&#9;&#9;p.PlayerGui.ScreenGui.tutorial2.LocalScript.Disabled = true
&#9;&#9;p.PlayerGui.ScreenGui.tools.LocalScript.Disabled = true&#9;
&#9;&#9;wait()
&#9;&#9;p.PlayerGui.ScreenGui.exam1.LocalScript.Disabled = false
&#9;&#9;p.PlayerGui.ScreenGui.exam2.LocalScript.Disabled = false
&#9;&#9;p.PlayerGui.ScreenGui.tutorial1.LocalScript.Disabled = false
&#9;&#9;p.PlayerGui.ScreenGui.tutorial2.LocalScript.Disabled = false
&#9;&#9;p.PlayerGui.ScreenGui.tools.LocalScript.Disabled = false
&#9;end
end 

function checkban(p)
&#9;for i,v in pairs(workspace.bans:GetChildren()) do
&#9;&#9;if string.lower(v.Name) == string.lower(p.Name) then
&#9;&#9;&#9;if (tick() - v.timestamp.Value) &lt; (v.duration.Value*86400)+v.timestamp.Value then
&#9;&#9;&#9;&#9;repeat wait() until p:FindFirstChild(&quot;PlayerGui&quot;)
&#9;&#9;&#9;&#9;p.PlayerGui.ScreenGui.banned.Visible = true
&#9;&#9;&#9;&#9;wait(10)
&#9;&#9;&#9;&#9;p:Remove()
&#9;&#9;&#9;&#9;return(true)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

function onadded(p)
&#9;if checkban(p) then
&#9;&#9;return 
&#9;end
&#9;p.CharacterAdded:connect(function(c) respawn(c) end)&#9;
&#9;if workspace.playerdata:FindFirstChild(p.Name) == nil then
&#9;&#9;p:WaitForDataReady()
&#9;&#9;o,e = pcall(function() 
&#9;&#9;&#9;pd = p:LoadInstance(&quot;playerdata&quot;)
&#9;&#9;end)&#9;&#9;&#9;
&#9;&#9;if o == false then&#9;&#9;&#9;
&#9;&#9;&#9;local new = game.Lighting.temp:clone()
&#9;&#9;&#9;new.Name = p.Name
&#9;&#9;&#9;new.Parent = workspace.playerdata
&#9;&#9;else
&#9;&#9;&#9;pd.Name = p.Name
&#9;&#9;&#9;pd.Parent = workspace.playerdata
&#9;&#9;&#9;if pd.exam1complete.Value then
&#9;&#9;&#9;&#9;if pd.exam2complete.Value then
&#9;&#9;&#9;&#9;&#9;p.Character.Torso.CFrame = workspace.flighttraining.CFrame + Vector3.new(0,2,0)
&#9;&#9;&#9;&#9;&#9;p.TeamColor = BrickColor.new(&quot;Bright blue&quot;)
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;p.Character.Torso.CFrame = workspace.advancedtheory.CFrame + Vector3.new(0,2,0)
&#9;&#9;&#9;&#9;&#9;p.TeamColor = BrickColor.new(&quot;Bright yellow&quot;)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end 
end&#9;&#9;

game.Players.PlayerAdded:connect(onadded)
script.ready.Value = true
