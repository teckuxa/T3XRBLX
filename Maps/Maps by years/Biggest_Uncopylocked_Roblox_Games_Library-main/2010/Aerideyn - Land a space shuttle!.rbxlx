&#9;&#9;&#9;&#9;&#9;&#9;RLelevon = RLelevon - 3
&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;RLelevon = RLelevon - 3
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
