			<Item class="Script" referent="RBX699">
				<Properties>
					<bool name="Archivable">true</bool>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">function MoveModel(Model, StartCFrame, EndCFrame) 
&#9;for i, v in pairs(Model:GetChildren()) do 
&#9;&#9;if v:isA(&quot;BasePart&quot;) then 
&#9;&#9;&#9;v.CFrame = EndCFrame * StartCFrame:toObjectSpace(v.CFrame) 
&#9;&#9;end 
&#9;end 
end

script.Parent.open.Changed:connect(function() 
&#9;if script.Parent.open.Value == true then
&#9;&#9;cf = CFrame.new(script.Parent.arm2.hinge.CFrame.X,script.Parent.arm2.hinge.CFrame.Y,script.Parent.arm2.hinge.CFrame.Z)*CFrame.Angles(math.rad(90),math.rad(0),math.rad(0))
&#9;&#9;MoveModel(script.Parent.arm2,script.Parent.arm2.hinge.CFrame,cf)&#9;
&#9;&#9;for i = 1,90 do
&#9;&#9;&#9;wait()
&#9;&#9;&#9;cf = CFrame.new(script.Parent.arm2.hinge.CFrame.X,script.Parent.arm2.hinge.CFrame.Y,script.Parent.arm2.hinge.CFrame.Z)*CFrame.Angles(math.rad(90-i),math.rad(0),math.rad(0))
&#9;&#9;&#9;MoveModel(script.Parent.arm2,script.Parent.arm2.hinge.CFrame,cf)&#9;
&#9;&#9;end
&#9;else
&#9;&#9;cf = CFrame.new(script.Parent.arm2.hinge.CFrame.X,script.Parent.arm2.hinge.CFrame.Y,script.Parent.arm2.hinge.CFrame.Z)*CFrame.Angles(math.rad(90),math.rad(0),math.rad(0))
&#9;&#9;MoveModel(script.Parent.arm2,script.Parent.arm2.hinge.CFrame,cf)&#9;
&#9;&#9;for i = 90,1,-1 do
&#9;&#9;&#9;wait()
&#9;&#9;&#9;cf = CFrame.new(script.Parent.arm2.hinge.CFrame.X,script.Parent.arm2.hinge.CFrame.Y,script.Parent.arm2.hinge.CFrame.Z)*CFrame.Angles(math.rad(90-i),math.rad(0),math.rad(0))
&#9;&#9;&#9;MoveModel(script.Parent.arm2,script.Parent.arm2.hinge.CFrame,cf)&#9;
&#9;&#9;end
&#9;end
end)
script.Parent.ready.Value = true
--script.Parent.open.Value = false
</ProtectedString>
				</Properties>
			</Item>
