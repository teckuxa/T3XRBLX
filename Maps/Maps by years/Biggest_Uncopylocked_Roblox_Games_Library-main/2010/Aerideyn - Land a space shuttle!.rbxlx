				<Item class="Script" referent="RBX8683">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">function regen()
&#9;script.Parent.Parent:MoveTo(Vector3.new(0,40000,0))
&#9;for i,v in pairs(script.Parent:GetChildren()) do
&#9;&#9;if v:FindFirstChild(&quot;SeatWeld&quot;) ~= nil then
&#9;&#9;&#9;p = game.Players:GetPlayerFromCharacter(v.SeatWeld.Part1.Parent)
&#9;&#9;&#9;v.SeatWeld:remove()
&#9;&#9;&#9;if p then
&#9;&#9;&#9;&#9;p.Character.Torso.CFrame = workspace.flighttraining.CFrame + Vector3.new(0,2,0)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end&#9;&#9;
&#9;wait(2)
&#9;local backup = game.Lighting.shuttle:Clone()
&#9;backup.Parent = workspace
&#9;backup:MakeJoints()
&#9;script.Parent.Parent:Remove()
end

inflight = false
script.Parent.Parent.status.Changed:connect(function()
&#9;if script.Parent.Parent.status.Value == &quot;Sissapproach&quot; then
&#9;&#9;inflight = true
&#9;elseif script.Parent.Parent.status.Value == &quot;Sunlock&quot; then
&#9;&#9;inflight = false
&#9;end
end)

script.Parent.Seat1.ChildAdded:connect(function(c)
&#9;if script.Parent.active.Value == true then
&#9;&#9;if c:IsA(&quot;Weld&quot;) then
&#9;&#9;&#9;player = game.Players:GetPlayerFromCharacter(c.Part1.Parent)
&#9;&#9;&#9;if player ~= nil then
&#9;&#9;&#9;&#9;--player.TeamColor = BrickColor.new(&quot;Bright blue&quot;)
&#9;&#9;&#9;&#9;player.PlayerGui.ScreenGui.astronaught.listening.Value = script.Parent.Parent
&#9;&#9;&#9;&#9;player.PlayerGui.ScreenGui.openastro.Visible = true
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end)

script.Parent.Seat2.ChildAdded:connect(function(c)
&#9;if script.Parent.active.Value == true then
