		<Item class="LocalScript" referent="RBX4745">
			<Properties>
				<bool name="Archivable">true</bool>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">localaerodyn</string>
				<ProtectedString name="Source">repeat wait() until game.Players.LocalPlayer.Character

density = workspace.density.Value
char = game.Players.LocalPlayer.Character
cam = workspace.CurrentCamera
if cam:FindFirstChild(&quot;plane&quot;) == nil then
&#9;terra = Instance.new(&quot;Model&quot;,cam)
&#9;terra.Name = &quot;plane&quot;
elseif cam:FindFirstChild(&quot;plane&quot;) ~= nil then
&#9;cam.plane:Remove()
&#9;terra = Instance.new(&quot;Model&quot;,cam)
&#9;terra.Name = &quot;plane&quot;&#9;&#9;&#9;
end&#9;

function getCL(aoa)
&#9;if aoa ~= aoa then CL = 0 return end
&#9;local CL = 0
&#9;if aoa &lt; 35 then
&#9;&#9;if aoa &gt; -5 then
&#9;&#9;&#9;CL = -((aoa-25)/20)^2+2.5
&#9;&#9;else
&#9;&#9;&#9;CL = 0
&#9;&#9;end
&#9;else
&#9;&#9;CL = -(aoa-35)^2+2.24
&#9;&#9;if CL &lt; 0 then
&#9;&#9;&#9;CL = 0 
&#9;&#9;end
&#9;end
&#9;return(CL)
end

function getaerofoils(model)
&#9;for i,v in pairs(model:GetChildren()) do
&#9;&#9;if v:IsA(&quot;BasePart&quot;) then
&#9;&#9;&#9;if v:FindFirstChild(&quot;aerodynamic&quot;) then
&#9;&#9;&#9;&#9;if v.aerodynamic.Value ~= -1 then
&#9;&#9;&#9;&#9;&#9;table.insert(parts,v)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;elseif v:IsA(&quot;Model&quot;) then
&#9;&#9;&#9;getaerofoils(v)
&#9;&#9;end
&#9;end
end

script.glider.Changed:connect(function()
&#9;aerofoils = {}
&#9;game.Players.LocalPlayer.PlayerGui.ScreenGui.vsi.speed.Position = UDim2.new(0.05,0,0,0)
&#9;if script.glider.Value ~= nil then
&#9;&#9;game.Players.LocalPlayer.PlayerGui.ScreenGui.vsi.Visible = true
&#9;&#9;parts = {}
&#9;&#9;getaerofoils(script.glider.Value)
&#9;&#9;for i,v in pairs(parts) do
&#9;&#9;&#9;p = script.Aerofoil:Clone()
&#9;&#9;&#9;--area = v3.new(top,side,front)
&#9;&#9;&#9;p.area.Value = Vector3.new(v.Size.X * v.Size.Z,v.Size.Y * v.Size.Z,v.Size.Y * v.Size.X)
&#9;&#9;&#9;p.mode.Value = v.aerodynamic.Value
&#9;&#9;&#9;local w = Instance.new(&quot;Weld&quot;)
&#9;&#9;&#9;w.Parent = v
&#9;&#9;&#9;w.Part0 = v
&#9;&#9;&#9;w.Part1 = p
&#9;&#9;&#9;p.Parent = terra
&#9;&#9;&#9;table.insert(aerofoils,p)
&#9;&#9;end
&#9;&#9;while script.glider.Value ~= nil do
&#9;&#9;&#9;speed = script.glider.Value.motor.Velocity.Y
&#9;&#9;&#9;if speed &gt; 50 then 
&#9;&#9;&#9;&#9;p = 0
&#9;&#9;&#9;elseif speed &lt; -50 then
&#9;&#9;&#9;&#9;p = 1
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;p = 0.5-(speed*0.01)
&#9;&#9;&#9;end
&#9;&#9;&#9;game.Players.LocalPlayer.PlayerGui.ScreenGui.vsi.speed.Position = UDim2.new(0.05,0,p,0)
&#9;&#9;&#9;game.Players.LocalPlayer.PlayerGui.ScreenGui.vsi.TextLabel.Text = math.floor(speed) .. &quot; Studs/second&quot;
&#9;&#9;&#9;for i,v in pairs(aerofoils) do
&#9;&#9;&#9;&#9;windv = (workspace.windv.Value + v.Velocity)
&#9;&#9;&#9;&#9;dynp = (density*(windv.Magnitude^2))/2
&#9;
&#9;&#9;&#9;&#9;upv =  CFrame.new(v.CFrame.p, (v.CFrame * CFrame.new(0,5,0)).p ).lookVector
&#9;&#9;&#9;&#9;uprot = upv:Dot(windv.Unit)&#9;
&#9;&#9;&#9;&#9;upAproj = v.area.Value.X * uprot
&#9;&#9;&#9;&#9;upforce = (dynp*upAproj)*upv
&#9;&#9;&#9;&#9;upaoa = math.acos(uprot)-math.rad(90)
&#9;
&#9;&#9;&#9;&#9;sidev =  CFrame.new(v.CFrame.p, (v.CFrame * CFrame.new(5,0,0)).p ).lookVector
&#9;&#9;&#9;&#9;siderot = sidev:Dot(windv.Unit)
&#9;&#9;&#9;&#9;sideAproj = v.area.Value.Y * siderot
&#9;&#9;&#9;&#9;sideforce = (dynp*sideAproj)*sidev

&#9;&#9;&#9;&#9;frontv =  CFrame.new(v.CFrame.p, (v.CFrame * CFrame.new(0,0,5)).p ).lookVector
&#9;&#9;&#9;&#9;frontrot = frontv:Dot(windv.Unit)
&#9;&#9;&#9;&#9;frontAproj = v.area.Value.Z * frontrot
&#9;&#9;&#9;&#9;frontforce = (dynp*frontAproj)*frontv
&#9;&#9;&#9;&#9;aoa = math.acos(frontrot)
&#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;if v.mode.Value == 1 then
&#9;&#9;&#9;&#9;&#9;if upaoa &lt; 0 then
&#9;&#9;&#9;&#9;&#9;&#9;aoa = -aoa
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;CL = getCL(math.deg(aoa))
&#9;&#9;&#9;&#9;&#9;if CL == nil then CL = 0 end
&#9;&#9;&#9;&#9;&#9;if aoa &gt;= -5 and aoa &lt;= 0 then
&#9;&#9;&#9;&#9;&#9;&#9;upforcelift = Vector3.new(0,-upforce.Y*CL,0)
&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;upforcelift = Vector3.new(0,upforce.Y*CL,0)
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;if CL &gt; 0 then
&#9;&#9;&#9;&#9;&#9;&#9;upforcedrag = Vector3.new(0,0,-upforce.Z*(CL/5))
&#9;&#9;&#9;&#9;&#9;&#9;--print(&quot;flying&quot;)
&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;--print(&quot;STALL&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;upforcedrag = Vector3.new(0,0,0)
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;upforce = upforce + (upforcelift) + (upforcedrag)
&#9;&#9;&#9;&#9;elseif v.mode.Value == 2 then
&#9;&#9;&#9;&#9;&#9;if upaoa &lt; 0 then
&#9;&#9;&#9;&#9;&#9;&#9;aoa = -aoa
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;CL = getCL(math.deg(aoa))
&#9;&#9;&#9;&#9;&#9;if CL == nil then CL = 0 end
&#9;&#9;&#9;&#9;&#9;upforcelift = Vector3.new(0,0,0)
&#9;&#9;&#9;&#9;&#9;if CL &gt; 0 then
&#9;&#9;&#9;&#9;&#9;&#9;upforcedrag = Vector3.new(0,0,-upforce.Z*(CL/5))
&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;upforcedrag = Vector3.new(0,0,0)
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;upforce = upforce + (upforcelift) + (upforcedrag)&#9;&#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;reaction = v.CFrame:pointToObjectSpace((-upforce*2) + (-sideforce) + (-frontforce))
&#9;&#9;&#9;&#9;v.surface.force = reaction/5
&#9;&#9;&#9;end
&#9;&#9;&#9;wait()
&#9;&#9;end&#9;
&#9;else
&#9;&#9;if cam:FindFirstChild(&quot;plane&quot;) ~= nil then
&#9;&#9;&#9;cam.plane:Remove()
&#9;&#9;&#9;terra = Instance.new(&quot;Model&quot;,cam)
&#9;&#9;&#9;terra.Name = &quot;plane&quot;&#9;&#9;&#9;
&#9;&#9;end&#9;&#9;
&#9;end
&#9;game.Players.LocalPlayer.PlayerGui.ScreenGui.vsi.Visible = false
end)


</ProtectedString>
