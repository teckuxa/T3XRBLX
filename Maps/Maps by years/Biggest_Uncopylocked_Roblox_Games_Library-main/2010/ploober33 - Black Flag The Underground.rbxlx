				<Item class="Script" referent="RBX30">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">--RobloPhysco
function stick(x, y)

	weld = Instance.new(&quot;Weld&quot;) 



	weld.Part0 = x

	weld.Part1 = y



	local HitPos = x.Position



	local CJ = CFrame.new(HitPos) 

	local C0 = x.CFrame:inverse() *CJ 

	local C1 = y.CFrame:inverse() * CJ 



	weld.C0 = C0 

	weld.C1 = C1 

	

	weld.Parent = x

end



function onTouched(part)

	local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
 local m = part.Parent:findFirstChild(&quot;Torso&quot;)
	if h~=nil then

wait(0.001)
m.Anchored = true
children = h.Parent:children()

	for i=1,#children do

		if(children[i].className == &quot;Part&quot; and children[i].Name ~= &quot;Torso&quot;) then stick(children[i], h.Parent.Torso) end

		if(children[i].className == &quot;Hat&quot;) then stick(children[i].Handle, h.Parent.Torso) end

	end

	h.Parent.Head.Velocity = h.Parent.Head.Velocity + Vector3.new(5,0,0)

	end

end



script.Parent.Touched:connect(onTouched)</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
		</Item>
