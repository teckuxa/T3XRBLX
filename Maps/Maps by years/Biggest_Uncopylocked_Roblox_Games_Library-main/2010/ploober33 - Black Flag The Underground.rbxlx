						<string name="Name">Script</string>
						<ProtectedString name="Source">--Info GUI by Biohazard000

local main = script.Parent
local ex = script.Parent.Text
local t = 4 -- time before next line of text

debounce = false

function msg()

if debounce == false then
debounce = true

main.Text = &quot;Join the Ranks of Black Flag&quot; --First Line Of Text
wait(t) --wait before next textline will appear (Config Time &quot;In Line 5&quot;)
main.Text = &quot;We Show no mercy to our enemies&quot;
wait(t)
main.Text = &quot;Defeat is not an option in Black Flag&quot;
wait(t)
main.Text = &quot;Our Leader is Ploober33, Known for working to bring down FEAR&quot;
wait(t)
main.Text = &quot;Our Clan is very active and is still growing, So please Join!&quot;
wait(t)
main.Text = &quot;We Rally Under the Black Flag&quot;
wait(t)


main.Text = ex
debounce = false
end
end

main.MouseButton1Down:connect(msg)</ProtectedString>
