						<token name="MeshType">5</token>
						<string name="Name">Mesh</string>
						<Vector3 name="Offset">
							<X>0</X>
							<Y>0</Y>
							<Z>0</Z>
						</Vector3>
						<Vector3 name="Scale">
							<X>0.300000012</X>
							<Y>0.300000012</Y>
							<Z>0.300000012</Z>
						</Vector3>
						<Content name="TextureId"><url>http://www.roblox.com/asset/?id=8417231</url></Content>
						<Vector3 name="VertexColor">
							<X>2</X>
							<Y>2</Y>
							<Z>2</Z>
