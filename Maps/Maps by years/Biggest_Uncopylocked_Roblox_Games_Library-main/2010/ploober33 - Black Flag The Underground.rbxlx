					<Item class="Script" referent="RBX146">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">FunctionScript</string>
							<ProtectedString name="Source">local isOn = true

function on()
	isOn = true
	script.Parent.PosA1.Transparency = 0
	script.Parent.PosA1.CanCollide = true
	script.Parent.PosB1.Transparency = 0
	script.Parent.PosB1.CanCollide = true
	script.Parent.PosA2.Transparency = 1
	script.Parent.PosA2.CanCollide = false
	script.Parent.PosB2.Transparency = 1
	script.Parent.PosB2.CanCollide = false
        script.Parent.lol.Transparency = 1 
end

function off()
	isOn = false
	script.Parent.PosA1.Transparency = 1
	script.Parent.PosA1.CanCollide = false
	script.Parent.PosB1.Transparency = 1
	script.Parent.PosB1.CanCollide = false
	script.Parent.PosA2.Transparency = 0
	script.Parent.PosA2.CanCollide = true
	script.Parent.PosB2.Transparency = 0
	script.Parent.PosB2.CanCollide = true
        script.Parent.lol.Transparency = 0.5
end

function onClicked()
	
	if isOn == true then off() else on() end

end

script.Parent.PosA1.ClickDetector.MouseClick:connect(onClicked)
script.Parent.PosB1.ClickDetector.MouseClick:connect(onClicked)
script.Parent.PosA2.ClickDetector.MouseClick:connect(onClicked)
script.Parent.PosB2.ClickDetector.MouseClick:connect(onClicked)

on()</ProtectedString>
