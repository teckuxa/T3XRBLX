						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">-- don&apos;t change unless you know what you are doing.
-- Script Made by BlueTaslem

function onTouched(hit)
if hit.Parent ~= nil
then
if hit.Parent:findFirstChild(&quot;Head&quot;) ~= nil 
then

c = hit.Parent.Head:clone()
hit.Parent.Head.Transparency = 1
i = Instance.new(&quot;Weld&quot;)
c.Parent = hit.Parent
c.Name = &quot;False Head&quot;
i.Part0 = c
i.Part1 = hit.Parent.Head
i.Parent = c
c.CanCollide = false
c.face:Remove()

hit.Parent.Torso.CFrame = CFrame.new(script.Parent.Parent.TeleporterB.Position + Vector3.new(0,5,0)) 


end
end
end
script.Parent.Touched:connect(onTouched)</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
		</Item>
