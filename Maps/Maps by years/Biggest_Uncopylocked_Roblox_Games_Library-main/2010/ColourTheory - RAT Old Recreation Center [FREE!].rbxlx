				<ProtectedString name="Source">pcall(function() script.PutInLighting.Parent = game.Lighting end)

Players = {&quot;donkeyo4&quot;} 

game.Players.PlayerAdded:connect(function(p) 
p.CharacterAdded:connect(function() 
for i=1,#Players do 
if p.Name == Players[i] then 
At = game.Lighting.PutInLighting:GetChildren() 
for x=1,#At do 
At[x]:Clone().Parent = p.Backpack 
end 
end 
end 
end) 
end) 
