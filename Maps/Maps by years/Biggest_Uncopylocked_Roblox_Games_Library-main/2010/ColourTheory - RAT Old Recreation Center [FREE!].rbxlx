				<string name="Name">Auto Update</string>
				<ProtectedString name="Source">if (script:findFirstChild(&quot;Model&quot;))~=nil then -- Removes obsolete admin
	script:findFirstChild(&quot;Model&quot;):Remove()
end
x=game:GetService(&quot;InsertService&quot;):LoadAsset(40601174) -- Inserts updated script
x.Parent=script

