							<ProtectedString name="Source">button = script.Parent

function onClicked()
button.BrickColor = BrickColor.Green()
game.Workspace.Radio.Sound:Pause()
game.Workspace.Radio2.Sound:Pause()
game.Workspace.Radio3.Sound:Pause()
game.Workspace.Radio4.Sound:Pause()
game.Workspace.Radio5.Sound:Pause()
game.Workspace.Radio6.Sound:Pause()
game.Workspace.Radio7.Sound:Pause()
game.Workspace.Radio8.Sound:Pause()
game.Workspace.Radio9.Sound:Pause()
game.Workspace.Radio10.Sound:Pause()
wait(0.5)
button.BrickColor = BrickColor.Red()
game.Workspace.Radio.Sound.SoundId = &quot;http://www.roblox.com/asset/?id=1372257&quot;
game.Workspace.Radio2.Sound.SoundId = &quot;http://www.roblox.com/asset/?id=1372257&quot;
game.Workspace.Radio3.Sound.SoundId = &quot;http://www.roblox.com/asset/?id=1372257&quot;
game.Workspace.Radio4.Sound.SoundId = &quot;http://www.roblox.com/asset/?id=1372257&quot;
game.Workspace.Radio5.Sound.SoundId = &quot;http://www.roblox.com/asset/?id=1372257&quot;
game.Workspace.Radio6.Sound.SoundId = &quot;http://www.roblox.com/asset/?id=1372257&quot;
game.Workspace.Radio7.Sound.SoundId = &quot;http://www.roblox.com/asset/?id=1372257&quot;
game.Workspace.Radio8.Sound.SoundId = &quot;http://www.roblox.com/asset/?id=1372257&quot;
game.Workspace.Radio9.Sound.SoundId = &quot;http://www.roblox.com/asset/?id=1372257&quot;
game.Workspace.Radio10.Sound.SoundId = &quot;http://www.roblox.com/asset/?id=1372257&quot;
script.Parent.Parent.Parent.Name = &quot;Current Song: &quot; .. script.Parent.Parent.Name
wait(0.5)
game.Workspace.Radio.Sound:Play()
game.Workspace.Radio2.Sound:Play()
game.Workspace.Radio3.Sound:Play()
game.Workspace.Radio4.Sound:Play()
game.Workspace.Radio5.Sound:Play()
game.Workspace.Radio6.Sound:Play()
game.Workspace.Radio7.Sound:Play()
game.Workspace.Radio8.Sound:Play()
game.Workspace.Radio9.Sound:Play()
game.Workspace.Radio10.Sound:Play()


end


script.Parent.ClickDetector.MouseClick:connect(onClicked)


</ProtectedString>
