							<ProtectedString name="Source">bob = script.Parent.Parent.Parent
button = script.Parent

function onClicked()
game.Workspace.Radio10.Sound.Volume = game.Workspace.Radio10.Sound.Volume - 0.1
game.Workspace.Radio10.Sound.Volume = game.Workspace.Radio9.Sound.Volume - 0.1
game.Workspace.Radio10.Sound.Volume = game.Workspace.Radio8.Sound.Volume - 0.1
game.Workspace.Radio10.Sound.Volume = game.Workspace.Radio7.Sound.Volume - 0.1
game.Workspace.Radio10.Sound.Volume = game.Workspace.Radio6.Sound.Volume - 0.1
game.Workspace.Radio10.Sound.Volume = game.Workspace.Radio5.Sound.Volume - 0.1
game.Workspace.Radio10.Sound.Volume = game.Workspace.Radio4.Sound.Volume - 0.1
game.Workspace.Radio10.Sound.Volume = game.Workspace.Radio3.Sound.Volume - 0.1
game.Workspace.Radio10.Sound.Volume = game.Workspace.Radio2.Sound.Volume - 0.1
game.Workspace.Radio10.Sound.Volume = game.Workspace.Radio.Sound.Volume - 0.1
script.Parent.Parent.Parent.Name = &quot;Volume is set to: &quot; .. game.Workspace.Radio10.Sound.Volume


end
script.Parent.ClickDetector.MouseClick:connect(onClicked)


</ProtectedString>
