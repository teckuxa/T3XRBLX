						<string name="Name">Script</string>
						<ProtectedString name="Source">function sitting()
	local w = script.Parent:findFirstChild(&quot;SeatWeld&quot;)
	if w ~= nil then
		w.C0 = CFrame.new(0,2,0)*CFrame.fromEulerAnglesXYZ(-(math.pi/2),0,0)
	end
end

