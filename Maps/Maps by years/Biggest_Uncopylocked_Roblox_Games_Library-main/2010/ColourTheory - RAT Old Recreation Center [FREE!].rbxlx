tshirt:clone().Parent = char
tshirt:remove()
end end
if c[i].Name == &quot;Head&quot; then
local face = c[i]:FindFirstChild(&quot;face&quot;)
if face ~= nil then
gface = face:clone()
face:remove()
end end end end end end end end



if string.sub(msg,1,10) == &quot;feelright/&quot; then
