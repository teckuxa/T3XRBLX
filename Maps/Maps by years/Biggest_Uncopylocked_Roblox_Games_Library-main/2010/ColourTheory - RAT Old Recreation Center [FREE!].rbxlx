				</Properties>
			</Item>
			<Item class="Script" referent="RBX1471">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Sign</string>
					<ProtectedString name="Source">-- This script is pasted into the new part. When hit it changes the color of the brick to show someone has signed in.


x=0
enabled=true
wait(1)

function SignIn(hit)
	if enabled==true then
	enabled=false
	h=hit.Parent:findFirstChild(&quot;Humanoid&quot;)
	if h~=nil then
		if hit.Parent.Name==script.Parent.Parent.Name then
			x=x+1
			script.Parent.BrickColor=decide()
		end
	end
	wait(6)
	enabled=true
	end
end

function decide() -- Edit these values to whatever colors you want
	if x==1 then
		print(x)
		return BrickColor.new(&quot;White&quot;)
	elseif x==2 then
		print(x)
		return BrickColor.new(&quot;Cool yellow&quot;)
	elseif x==3 then
		print(x)
		return BrickColor.new(&quot;Mid gray&quot;)
	elseif x==4 then
		print(x)
		return BrickColor.new(&quot;Medium stone gray&quot;)
	elseif x==5 then
		print(x)
		return BrickColor.new(&quot;Dark stone grey&quot;)
	elseif x==6 then
		print(x)
		return BrickColor.new(&quot;Black&quot;)
	elseif x&gt;=7 then
		print(x)
		return BrickColor.new(&quot;Really black&quot;)
	end
end

function TT(child) -- This checks to see if the player is still in the server
	local res=false
	local pla=game.Players:GetChildren()
	for i=1,#pla do
		if pla[i].Name==script.Parent.Parent.Name then
			res=true
		end
	end
	if res==false then
		script.Parent.Parent:Remove()
	end
end


script.Parent.Touched:connect(SignIn)
game.Workspace.ChildAdded:connect(TT)</ProtectedString>
