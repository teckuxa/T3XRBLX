			<Item class="Script" referent="RBX1469">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">General</string>
					<ProtectedString name="Source">y=0
z=0

-- This script creates a brick that allows people to touch it and &quot;Sign in&quot;

function SignIn(child)
	

	local x=math.random(1,2)
	a=script.Parent:findFirstChild(x)
	p=Instance.new(&quot;Part&quot;)
	p.formFactor=&quot;Plate&quot;
	p.Size=Vector3.new(6,0.4,6)
	if x==1 then
		y=y+1 -- The values here are the spaces between each &quot;sign in&quot; part
		p.CFrame=a.CFrame+Vector3.new(0,y,0)
	else 
		z=z+1
		p.CFrame=a.CFrame+Vector3.new(0,z,0)
	end

	m=Instance.new(&quot;Model&quot;)
	m.Parent=game.Workspace:findFirstChild(&quot;Sign in&quot;).Sign2
	p.Parent=m
	p.Anchored=true
	p.Name=&quot;Head&quot;
	p.Color=Color3.new(255,255,255)
	m.Name=child.Name
	h=Instance.new(&quot;Humanoid&quot;)
	h.Parent=m
	h.MaxHealth=0
	script.Parent.Sign:clone().Parent=p
end




game.Players.ChildAdded:connect(SignIn)</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="StringValue" referent="RBX1470">
				<Properties>
					<string name="Name">Full Credit to TDFall</string>
					<string name="Value">For this original model</string>
