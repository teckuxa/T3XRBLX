			<Item class="Script" referent="RBX5898">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">--sticckmasterluke

answers={&quot;door 3 25&quot;}		--dont mind caps
openduration=5

sp=script.Parent
open=false

game.Players.PlayerAdded:connect(function(plr)
	plr.Chatted:connect(function(msg)
		if msg~=nil and not open then
			for i=1,#answers do
				if msg:lower()==answers[i]:lower() then
					sp.Transparency=1
					sp.CanCollide=false
					open=true
					wait(openduration)
					open=false
					sp.Transparency=0
					sp.CanCollide=true
				end
			end
		end
	end)
end)
</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
		</Item>
