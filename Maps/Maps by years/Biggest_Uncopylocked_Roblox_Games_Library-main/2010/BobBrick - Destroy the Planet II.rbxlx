				<Item class="Script" referent="RBX3105">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">--[[ Place this button and the model you want to regen in the workspace.
Don&apos;t group them together, or it won&apos;t work. ]]

model = script.Parent.Parent.Parent.Earth -- Change &quot;Compressor&quot; to the name of your model.
new = model:clone()
enabled = true

function onClicked()
if enabled then
enabled = false
script.Parent.BrickColor = BrickColor.new(26)
model:remove()
wait(0.7) -- This is how long it will take to regen
model = new:clone()
model.Parent = game.Workspace
model:MakeJoints()
wait(300) -- This is how long it will take for the regen button to be enabled after being used
script.Parent.BrickColor = BrickColor.new(194)
enabled = true
end
end

script.Parent.ClickDetector.MouseClick:connect(onClicked)

-- Created by gam3r2009</ProtectedString>
