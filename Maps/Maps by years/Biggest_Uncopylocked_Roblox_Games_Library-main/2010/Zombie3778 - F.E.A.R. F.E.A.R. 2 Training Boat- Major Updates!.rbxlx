		<Item class="ScreenGui" referent="RBX9509">
			<Properties>
				<string name="Name">ScreenGui</string>
				<bool name="archivable">true</bool>
			</Properties>
			<Item class="LocalScript" referent="RBX9510">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">ANIM_Local</string>
					<ProtectedString name="Source">--[[
History:
	-Oct 6th 2009 - created
	-Oct 7th 2009 - V1 framework finished
	-Oct 10th 2009 - functional prototype
	-Oct 13th 2009 - V1 animation builder operational

Name: 
	Local animation manager script

Purpose:
	-Registers animation resources when they are loaded
	-Animates players on the client
	-Listens for animation notifications
]]

--debuging, start the script on que
--repeat wait() until _G.startanim

local resourceAnimLocation = game.Workspace.AnimationPack --[[
where are the animation resources located
]]

_G.resourceAnims = {} --[[
	the animation resources loaded for this client
	(an anim is loaded when a player uses it)

	Key := animation&apos;s name
	Value := { animation&apos;s data }

	animation format
	{
		bool		override	does the animation override or blend with other animations
		number	frames	number of frames in the animation
		bool		noloop	only play the animation once and autoremove the notification
		--
		table	data		the data for an animation
		{
			[RightArmRoll = angle,]
			[RightArmPitch = angle, ]
			[LeftArm...]
			[RightLeg...]
			[HandleC0 = CFrame]
			[HandleC1 = CFrame]
		}
	}
]]

_G.playerAnims = {} --[[
	animations running for a certain player

	Key := player
	Value := { RightArmRoll = angle, LeftArmRoll = angle [etc...], [index] = table of animations }

	animation instance format
	{
		number	frame	current frame index
		number	frames	max frame index
		table	data		reference to the animation&apos;s data
		Instance	object	reference to the notification that started this anim
		bool		dead	true when the animation is done
	}	
]]	

--[[
Run animations for a player
]]
local print_tmp = 1
function runAnimations(player)
	local torso = (player.Character or script):FindFirstChild(&quot;Torso&quot;)
	if not torso then return end
	--tags
	local rightS = torso:FindFirstChild(&quot;Right Shoulder&quot;) or {}
	local leftS = torso:FindFirstChild(&quot;Left Shoulder&quot;) or {}
	local rightH = torso:FindFirstChild(&quot;Right Hip&quot;) or {}
	local leftH = torso:FindFirstChild(&quot;Left Hip&quot;) or {}
	-------------
	local grip = (player.Character:FindFirstChild(&quot;Right Arm&quot;) or script):FindFirstChild(&quot;RightGrip&quot;) or {}
	local anims = playerAnims[player]
	--angles
	local rightSPitch = 0
	local rightSRoll = 0
	local leftSPitch = 0
	local leftSRoll = 0
	--
	local rightHPitch = 0
	local rightHRoll = 0
	local leftHPitch = 0
	local leftHRoll = 0
	--calculate the angles
	for i = 1, #anims do
		--tags
		local anim = anims[i]
		local framedata = anim.data.data[anim.frame]
		--if there&apos;s an override, replace angles
		--[[
			There&apos;s probably a way to condense this code, but I doubt it would be any faster, if not slower
		]]
		rightSPitch = framedata.RightArmPitch or rightSPitch
		rightSRoll = framedata.RightArmRoll or rightSRoll
		--
		leftSPitch = framedata.LeftArmPitch or leftSPitch
		leftSRoll = framedata.LeftArmRoll or leftSRoll
		--
		rightHPitch = framedata.RightLegPitch or rightHPitch
		rightHRoll = framedata.RightLegRoll or rightHRoll
		--
		leftHPitch = framedata.LeftLegPitch or leftHPitch
		leftHRoll = framedata.LeftLegRoll or leftHRoll

		if framedata.HandleC0 then
			grip.C0 = framedata.HandleC0
		end
		if framedata.HandleC1 then
			grip.C1 = framedata.HandleC1
		end

		--anim removed, kill it
		if not anim.object.Parent then
			anim.dead = true
		elseif anim.frame &lt; anim.frames then
			--incriment the frame
			anim.frame = anim.frame + 1	
		elseif anim.object.Parent and not anim.data.noloop then
			--repeat the anim
			anim.frame = 1
		else
			--anim ended with no repeat, kill it
			anim.dead = true
		end
	end
	---------------------------------------
	---- remove any dead anims
	do
		local i = 1
		while true do
			if anims[i] then
				if anims[i].dead then
					print(&quot;Notification removed : ~&quot;..tostring(anims[i].object.Value))
					if anims[i].data.noloop then
						anims[i].object:remove()
					end
					table.remove(anims, i)
				else
					i = i + 1
				end
			else
				break
			end
		end
	end	
	----------------------------
	---- apply Rolls
	if rightSRoll ~= anims.RightArmRoll then
		anims.RightArmRoll = rightSRoll
		rightS.C0 = CFrame.new(1.5, 0.5, 0) * CFrame.fromEulerAnglesXYZ(0, math.pi/2, 0) * CFrame.fromEulerAnglesXYZ(-rightSRoll, 0, 0)
		rightS.C1 = CFrame.new(0, 0.5, 0) * CFrame.fromEulerAnglesXYZ(0, math.pi/2, 0)
	end
	if leftSRoll ~= anims.LeftArmRoll then
		anims.LeftArmRoll = leftSRoll
		leftS.C0 = CFrame.new(-1.5, 0.5, 0) * CFrame.fromEulerAnglesXYZ(0, -math.pi/2, 0) * CFrame.fromEulerAnglesXYZ(-leftSRoll, 0, 0)
		leftS.C1 = CFrame.new(0, 0.5, 0) * CFrame.fromEulerAnglesXYZ(0, -math.pi/2, 0)
	end
	if rightHRoll ~= anims.RightLegRoll then
		anims.RightLegRoll = rightHRoll
		rightH.C0 = CFrame.new(0.5, -1, 0) * CFrame.fromEulerAnglesXYZ(0, math.pi/2, 0) * CFrame.fromEulerAnglesXYZ(-rightHRoll, 0, 0)
		rightH.C1 = CFrame.new(0, 1, 0) * CFrame.fromEulerAnglesXYZ(0, math.pi/2, 0)
	end
	if leftHRoll ~= anims.LeftArmRoll then
		anims.LeftHipRoll = leftSRoll
		leftH.C0 = CFrame.new(-0.5, -1, 0) * CFrame.fromEulerAnglesXYZ(0, -math.pi/2, 0) * CFrame.fromEulerAnglesXYZ(-leftHRoll, 0, 0)
		leftH.C1 = CFrame.new(0, 1, 0) * CFrame.fromEulerAnglesXYZ(0, -math.pi/2, 0)
	end
	----------------------------
	---- change motor speeds
	rightS.MaxVelocity = 2
	leftS.MaxVelocity = 2
	rightH.MaxVelocity = 2
	leftH.MaxVelocity = 2
	----------------------------
	----  apply angles
	rightS.DesiredAngle = rightSPitch
	leftS.DesiredAngle = leftSPitch
	rightH.DesiredAngle = rightHPitch
	leftH.DesiredAngle = leftHPitch
end

--[[
Load a new animation resource from a StringValue
]] function loadAnimResource(object)
	print(&quot;Loaded animation resource :&quot;, object.Name)
	--stringvalues should hold a chunk which returns thier animation
	resourceAnims[object.Name] = loadstring(object.Value)()
end

--[[
Attach a new animation to a player, anim is the notification Instance 
]] function startAnimation(player, anim, overrideindex)
	--animation has not been loaded
	if not resourceAnims[anim.Value] then 
		print(&quot;&gt; Missing animation:&quot;, anim.Value)
		print(&quot;&gt;&gt; Animations loaded:&quot;)
		for k, v in pairs(resourceAnims) do
			print(&quot;&gt;&gt;&gt; {&quot;..tostring(k)..&quot; = &quot;..tostring(v)..&quot;}&quot;)
		end
		return 
	end 
	--build the animation instance
	local data = resourceAnims[anim.Value]
	local tb = {
		frame = 1,
		frames = data.frames,
		data = data,
		object = anim,
		dead = false
	}
	if overrideindex then
		table.insert(playerAnims[player], overrideindex, tb)
	else
		table.insert(playerAnims[player], tb)
	end
end

--[[
shortcut, create an animation notification
]] function createNotification(anim)
	local nw = Instance.new(&quot;StringValue&quot;)
	nw.Name = &quot;ANIM&quot;
	nw.Value = anim
	return nw
end

--player respawed, listen for animations being started / run animations
function onPlayerSpawn(player)
	print(&quot;&gt; Player spawning...&quot;)
	local newHumanoid = (player.Character or script):FindFirstChild(&quot;Humanoid&quot;)
	if not newHumanoid then return end
	--the notification that brough the humanoid into it&apos;s current state
	local newHumanoidStateNotification = nil
	local newHumanoidState = &quot;&quot;
	local newHumanoidLastJump = 0
	--the support for tools without special anims
	local toolAnimNotification = nil
	local toolChildAddedSignal = nil

	--debug, remove the animate
	if player.Character.Animate then
		player.Character.Animate:remove()
	end

	------------------------------------
	---- Humanoid events
	--stop anims on died
	local animating = true
	newHumanoid.Died:connect(function()
		print(&quot;&gt; Player died&quot;)
		animating = false
		playerAnims[player] = {}	
	end)
	newHumanoid.Running:connect(function(s)
		if (newHumanoidStateNotification) then
			newHumanoidStateNotification:remove()
		end
		if newHumanoidState == &quot;Jump&quot; then
			createNotification(&quot;EndJumpAnim&quot;).Parent = player.Character
		end
		if s &gt; 0 then
			newHumanoidStateNotification = createNotification(&quot;WalkAnim&quot;)
			newHumanoidState = &quot;Run&quot;
		else	
			newHumanoidStateNotification = createNotification(&quot;StandAnim&quot;)
			newHumanoidState = &quot;Stand&quot;
		end
		newHumanoidStateNotification.Parent = player.Character
	end)
	--local jumps = 1
	newHumanoid.Changed:connect(function(pr)
		if pr == &quot;Jump&quot; and newHumanoid.Jump == true then
			--jumps = jumps + 1
			--game.Players.Player.PlayerGui.GuiMain_ANIM.FrameInfo.Duration.Text = &quot;Jumps [F]: &quot;..tostring(jumps)
			--game.Players.Player.PlayerGui.GuiMain_ANIM.FrameInfo.Duration.Text = &quot;Jumps [T]: &quot;..tostring(jumps)
			if (newHumanoidStateNotification) then
				newHumanoidStateNotification:remove()
			end
			newHumanoidLastJump = time()
			local begin = createNotification(&quot;BeginJumpAnim&quot;)
			begin.Parent = player.Character
			newHumanoidStateNotification = createNotification(&quot;JumpAnim&quot;)
			newHumanoidStateNotification.Parent = player.Character
			newHumanoidState = &quot;Jump&quot;
		end
	end)
	newHumanoid.FreeFalling:connect(function(active)
		if (time() - newHumanoidLastJump) &lt; 1 or not active then return end
		if newHumanoidState == &quot;Seated&quot; or newHumanoidState == &quot;Jump&quot; then return end
		newHumanoidState = &quot;Freefall&quot;
		wait(0.2)
		if newHumanoidState ~= &quot;Freefall&quot; then return end
		if (newHumanoidStateNotification) then
			newHumanoidStateNotification:remove()
		end
		newHumanoidStateNotification = createNotification(&quot;FreefallAnim&quot;)
		newHumanoidStateNotification.Parent = player.Character
		createNotification(&quot;BeginJumpAnim&quot;).Parent = player.Character		
	end)
	newHumanoid.Seated:connect(function(active)
		if not active then return end
		newHumanoidState = &quot;Seated&quot;
		if (newHumanoidStateNotification) then
			newHumanoidStateNotification:remove()
		end
		newHumanoidStateNotification = createNotification(&quot;SeatedAnim&quot;)
		newHumanoidStateNotification.Parent = player.Character
		createNotification(&quot;BeginSeatedAnim&quot;).Parent = player.Character	
	end)
	newHumanoid.Climbing:connect(function(speed)
		--print(&quot;Climbing(speed = &quot;..tostring(speed)..&quot;)&quot;)
		newHumanoidState = &quot;Climb&quot;
		wait(0.2)
		if newHumanoidState ~= &quot;Climb&quot; then return end
		if (newHumanoidStateNotification) then
			newHumanoidStateNotification:remove()
		end
		if speed &gt; 0 then
			newHumanoidStateNotification = createNotification(&quot;ClimbAnim&quot;)
			newHumanoidStateNotification.Parent = player.Character
		else
			newHumanoidStateNotification = createNotification(&quot;ClimbStillAnim&quot;)
			newHumanoidStateNotification.Parent = player.Character
		end
	end)
	---------------------------------
	---- listen for animations and tools
	player.Character.ChildAdded:connect(function(obj)
		if obj.Name == &quot;ANIM&quot; and obj:IsA(&quot;StringValue&quot;) then
			print(&quot;&gt; Notification added :&quot;, obj.Value)
			--give priority low priority to the base animations
			if obj.Value == &quot;WalkAnim&quot; or obj.Value == &quot;StandAnim&quot; then
				startAnimation(player, obj, 1)
			else
				startAnimation(player, obj)
			end
		elseif obj:IsA(&quot;Tool&quot;) then
			toolChildAddedSignal = obj.ChildAdded:connect(function(o)
				if o.Name == &quot;toolanim&quot; then
					if o.Value == &quot;Slash&quot; then
						createNotification(&quot;LegacyRightSlash&quot;).Parent = player.Character
					elseif o.Value == &quot;Lunge&quot; then
						createNotification(&quot;LegacyRightLunge&quot;).Parent = player.Character
					end
					o:remove()
				end
			end)
			if not obj:findFirstChild(&quot;ANIM&quot;) then
				if toolAnimNotification then
					toolAnimNotification:remove()
				end
				toolAnimNotification = createNotification(&quot;LegacyRightGrip&quot;)
				toolAnimNotification.Parent = player.Character
				createNotification(&quot;LegacyBeginRightGrip&quot;).Parent = player.Character
			end
		end
	end)
	player.Character.ChildRemoved:connect(function(obj)
		if obj:IsA(&quot;Tool&quot;) then
			toolChildAddedSignal:disconnect()
			toolChildAddedSignal = nil
			if toolAnimNotification then
				toolAnimNotification:remove()
				toolAnimNotification = nil
			end
		end
	end)
	print(&quot;&gt; Player spawned&quot;)

	--while this character is alive, animate it
	while animating do
		runAnimations(player)
		wait()
	end
end
--player added 
function onPlayerEnter(player)
	--make an entry in the player anims table
	playerAnims[player] = {}
	--if they allready have a character call spawed on it
	if player.Character then
		onPlayerSpawn(player)	
	end
	--listen for player spawning
	player.Changed:connect(function(property)
		if property == &quot;Character&quot; then
			onPlayerSpawn(player)
		end
	end)
end
--call on any players allready ingame
for _, p in pairs(game.Players:GetChildren()) do
	Spawn(function() onPlayerEnter(p) end)
end
--hook up the signal
game.Players.ChildAdded:connect(onPlayerEnter)


--hook up signal to new animation resources
resourceAnimLocation.ChildAdded:connect(function(obj)
	if obj:IsA(&quot;StringValue&quot;) then
		loadAnimResource(obj)
	end
end)
--load any existing ones
for _, obj in pairs(resourceAnimLocation:GetChildren()) do
	if obj:IsA(&quot;StringValue&quot;) then
		loadAnimResource(obj)
	end
end









	
	

























