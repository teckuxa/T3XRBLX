		<Item class="Script" referent="RBX367">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">TeamChangeCmds</string>
				<ProtectedString name="Source">--[[

-------------------------------------------
* Team-Change command script *
-------------------------------------------

100% scripted by crazyman32 for bluemew. 

Here is what you do:

while online, use the chat and say &quot;join/TEAMNAME&quot; but without the quotes and replacing &quot;TEAMNAME&quot; with the team you wish to join.

If you have any questions, comments, or script suggestions, then please PM me, crazyman32.


]]

Kill_Player_On_Switch = true  -- if &apos;true&apos; then your character will die when they command a team switch. If false, they will not die on the command to switch

function commands(msg, recipient, speaker) 
	N = 0  -- This is needed!
	if string.sub(msg:lower(),1,5) == &quot;join/&quot; then 
		print(speaker.Name.. &quot;activated \&quot;Join\&quot; command&quot;)
		a = game:service(&quot;Teams&quot;):GetChildren() 
		local m = Instance.new(&quot;Message&quot;) 
		for i = 1, #a do 
			if string.sub(msg:lower(),6) == a[i].Name:lower() then 
				if speaker.TeamColor ~= a[i].TeamColor then 
					speaker.TeamColor = a[i].TeamColor
					print(speaker.Name..&quot; joined new team | New team: &quot;..a[i].Name) 
					if Kill_Player_On_Switch then 
						speaker.Character[&quot;Humanoid&quot;].Health = 0
					end 
					m.Parent = speaker
					m.Text = &quot;Team joined: &quot;..a[i].Name
					wait(3)
					m.Parent = nil 
				elseif speaker.TeamColor == a[i].TeamColor then 
					print(speaker.Name..&quot; attempted to join team &quot;..a[i].Name..&quot; denied: &quot;..speaker.Name..&quot; already on this team&quot;)
					m.Parent = speaker
					m.Text = &quot;You are already on this team!&quot;
					wait(3) 
					m.Parent = nil 
				end 
			elseif string.sub(msg:lower(),6) ~= a[i].Name:lower() then 
				N = N +1  -- This is why that pointless &apos;N&apos; at the top is needed
				if N &gt;= #a then 
					N = 0 -- Reset &apos;N&apos;
					print(speaker.Name..&quot; tried to join team \&quot;&quot;..string.sub(msg,6)..&quot;\&quot; failed: No such team exists within server&quot;)
					m.Parent = speaker
					m.Text = &quot;\&quot;&quot;..string.sub(msg,6)..&quot;\&quot; is not a team!&quot;  -- Those slashes with quotes make a quotation mark since you can&apos;t put one in the script normally
					wait(3)
					m.Parent = nil 
				end 
			end 
		end 
	end 
end 



-- Below just sets the rest of the script above up. This basically looks for a player to chat:

function findVoice(player) 
	player.Chatted:connect(function(msg, recipient) commands(msg, recipient, player) end) 
end 
game.Players.ChildAdded:connect(findVoice) </ProtectedString>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
