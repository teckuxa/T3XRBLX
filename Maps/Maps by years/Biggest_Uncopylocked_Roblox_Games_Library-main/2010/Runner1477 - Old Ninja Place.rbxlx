				<Item class="Script" referent="RBX2339">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">--Made By: Zach123456789,:builderman
wait(1)
script.Parent.Blade1.CFrame = script.Parent.Spin1.CFrame * CFrame.fromEulerAnglesXYZ(0,0,0)
script.Parent.Blade2.CFrame = script.Parent.Spin2.CFrame * CFrame.fromEulerAnglesXYZ(0,0,0)
script.Parent.Blade3.CFrame = script.Parent.Spin3.CFrame * CFrame.fromEulerAnglesXYZ(0,0,0)
script.Parent.Blade4.CFrame = script.Parent.Spin4.CFrame * CFrame.fromEulerAnglesXYZ(0,0,0)
script.Parent.Blade5.CFrame = script.Parent.Spin5.CFrame * CFrame.fromEulerAnglesXYZ(0,0,0)
script.Parent.Blade6.CFrame = script.Parent.Spin6.CFrame * CFrame.fromEulerAnglesXYZ(0,0,0)
script.Parent.Blade7.CFrame = script.Parent.Spin7.CFrame * CFrame.fromEulerAnglesXYZ(0,0,0)
wait(1)
l = script.Parent
while true do
&#9;wait()
&#9;local h = l:GetChildren()
&#9;for i = 1, #h do
&#9;&#9;if h[i].className == &quot;Part&quot; and h[i].Name ~= &quot;Ground&quot; and h[i].Name ~= &quot;Ground1&quot; and string.sub(h[i].Name, 4) ~= &quot;Spin&quot; then
&#9;&#9;&#9;h[i].CFrame = h[i].CFrame * CFrame.fromEulerAnglesXYZ(0,0.02,0)
&#9;&#9;end
&#9;end
&#9;mr = math.random(1,10)
&#9;if mr == 5 then
&#9;&#9;meh = script.Parent.KillScript:Clone()
