			<Item class="Script" referent="RBX10849">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Paintball</string>
					<ProtectedString name="Source">wait(1)
script.Parent.Anchored=true
script.Parent.Transparency=1
script.Parent.Sparkles.Enabled=true
script.Parent.Sparkles:clone().Parent=script.Parent
explosion = Instance.new(&quot;Explosion&quot;)
explosion.Position = script.Parent.Position
explosion.BlastPressure = 100
explosion.BlastRadius = 5
explosion.Parent=Workspace
wait(24)
script.Parent.Parent=nul
</ProtectedString>
