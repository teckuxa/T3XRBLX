&#9;label.Size = UDim2.new(0.0, 0, 0.0, height)
&#9;label.BorderSizePixel = 0
&#9;label.TextColor3 = frameTextColor
&#9;label.Parent = descriptionFrame
&#9;
&#9;local assetLabel = Instance.new(&quot;TextLabel&quot;)
