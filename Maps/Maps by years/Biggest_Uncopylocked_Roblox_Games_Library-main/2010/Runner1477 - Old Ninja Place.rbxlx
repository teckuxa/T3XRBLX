			<Item class="LocalScript" referent="RBX10669">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">LocalScript</string>
					<ProtectedString name="Source">med = false

function _restoreproperties() 
&#9;local player = game.Players.LocalPlayer
&#9;if player == nil then return end
&#9;Holder = player.Character 
&#9;Torso = Holder:FindFirstChild(&quot;Torso&quot;) 
&#9;RightS = Torso:FindFirstChild(&quot;Right Shoulder&quot;) 
&#9;LeftS = Torso:FindFirstChild(&quot;Left Shoulder&quot;) 
&#9;RightH = Torso:FindFirstChild(&quot;Right Hip&quot;) 
&#9;LeftH = Torso:FindFirstChild(&quot;Left Hip&quot;) 
&#9;RightS.MaxVelocity = .15 
&#9;LeftS.MaxVelocity = .15 
&#9;RightH.MaxVelocity = .1 
&#9;LeftH.MaxVelocity = .1 
&#9;RightS.DesiredAngle = 0 
&#9;LeftS.DesiredAngle = 0 
&#9;LeftH.DesiredAngle = 0 
&#9;RightH.DesiredAngle = 0 
end 

function ManageAnimation(value) 
&#9;local player = game.Players.LocalPlayer
&#9;if player == nil then return end
&#9;Holder = player.Character 
&#9;Player = player 
&#9;if value == &quot;no anim&quot; then 
&#9;&#9;Anim = Holder:FindFirstChild(&quot;Animate&quot;) 
&#9;&#9;if Anim~=nil then 
&#9;&#9;&#9;Anim.Disabled = true 
&#9;&#9;&#9;Anim.Parent = Player 
&#9;&#9;end 
&#9;elseif value == &quot;re-anim&quot; then 
&#9;&#9;Anim = Player:FindFirstChild(&quot;Animate&quot;) 
&#9;&#9;if Anim~=nil then 
&#9;&#9;&#9;Anim.Disabled = false 
&#9;&#9;&#9;Anim.Parent = Holder 
&#9;&#9;end 
&#9;end 
end 

function Stance() 
&#9;local player = game.Players.LocalPlayer
&#9;if player == nil then return end
&#9;Char = player.Character 
&#9;L = Char.Torso:FindFirstChild(&quot;Left Shoulder&quot;) 
&#9;R = Char.Torso:FindFirstChild(&quot;Right Shoulder&quot;) 
&#9;if L~=nil then 
&#9;&#9;L.DesiredAngle = 3.2 
&#9;&#9;L.MaxVelocity = 3 
&#9;end 
&#9;if R~=nil then 
&#9;&#9;R.DesiredAngle = 3.2 
&#9;&#9;R.MaxVelocity = 3 
&#9;end 
&#9;L = Char.Torso:FindFirstChild(&quot;Left Hip&quot;) 
&#9;R = Char.Torso:FindFirstChild(&quot;Right Hip&quot;) 
&#9;if L~=nil then 
&#9;&#9;L.DesiredAngle = 0 
&#9;&#9;L.MaxVelocity = 3 
&#9;end 
&#9;if R~=nil then 
&#9;&#9;R.DesiredAngle = 0 
&#9;&#9;R.MaxVelocity = 3 
&#9;end 
end 

function Down(ml) 
&#9;for i=1, ml.velocity.y/3 do 
&#9;&#9;ml.velocity = ml.velocity+Vector3.new(0,-4.25,0) 
&#9;&#9;wait() 
&#9;end 
&#9;ml:Remove() 
end 

function FrontFlip() 
&#9;local player = game.Players.LocalPlayer
&#9;if player == nil then return end
&#9;Char = player.Character 
&#9;Human = Char.Humanoid 
&#9;Torso = Char.Torso 
&#9;CF = Torso.CFrame 
&#9;ManageAnimation(&quot;re anim&quot;) 
&#9;Stance() 
&#9;Human.Jump = true
&#9;VelUp = Instance.new(&quot;BodyVelocity&quot;) 
&#9;VelUp.velocity = Vector3.new(0,72.5,0)+Torso.CFrame.lookVector*30 
&#9;VelUp.P = VelUp.P*2 
&#9;VelUp.maxForce = Vector3.new(10000,10000,10000)*999 
&#9;VelUp.Parent = Torso 
&#9;coroutine.resume(coroutine.create(Down),VelUp) 
&#9;Gyro = Instance.new(&quot;BodyGyro&quot;) 
&#9;Gyro.P = Gyro.P*10 
&#9;Gyro.maxTorque = Vector3.new(100000,100000,100000)*999 
&#9;Gyro.cframe = CF 
&#9;Gyro.Parent = Torso 
&#9;for i=1, 32 do 
&#9;&#9;Gyro.cframe = Gyro.cframe*CFrame.fromEulerAnglesXYZ(math.pi/-16,0,0) 
&#9;&#9;wait() 
&#9;end 
&#9;Gyro.cframe = CF 
&#9;game:GetService(&quot;Debris&quot;):AddItem(Gyro,2) 
&#9;ManageAnimation(&quot;re-anim&quot;) 
&#9;_restoreproperties() 
end 

function Meditate() 
&#9;local player = game.Players.LocalPlayer
&#9;if player == nil then return end
&#9;Char = player.Character 
&#9;Human = Char.Humanoid 
&#9;Torso = Char.Torso 
&#9;CP = Torso.Position 
&#9;if med == false then
&#9;&#9;Human.Sit = true
&#9;&#9;up = Instance.new(&quot;BodyPosition&quot;) 
&#9;&#9;up.position = CP
&#9;&#9;up.maxForce = Vector3.new(100000,100000,100000)
&#9;&#9;up.Parent = Torso
&#9;&#9;Gyro = Instance.new(&quot;BodyGyro&quot;) 
&#9;&#9;Gyro.P = Gyro.P*10 
&#9;&#9;Gyro.maxTorque = Vector3.new(100000,100000,100000)*999 
&#9;&#9;Gyro.cframe = Torso.CFrame
&#9;&#9;Gyro.Parent = Torso 
&#9;&#9;Torso[&quot;Left Shoulder&quot;].C1 = CFrame.new(0.4, 0.5, 0, -0, -0, -1, 0, 1, 0, 1, 0, 0) * CFrame.fromEulerAnglesXYZ(0,0,0)
&#9;&#9;Torso[&quot;Right Shoulder&quot;].C1 = CFrame.new(-0.4, 0.5, 0, 0, 0, 1, 0, 1, 0, -1, -0, -0) * CFrame.fromEulerAnglesXYZ(0,0,0)
&#9;&#9;wait(0.05)
&#9;&#9;Torso[&quot;Left Shoulder&quot;].C1 = CFrame.new(0.4, 0.5, 0, -0, -0, -1, 0, 1, 0, 1, 0, 0) * CFrame.fromEulerAnglesXYZ(-math.pi/16,0,0)
&#9;&#9;Torso[&quot;Right Shoulder&quot;].C1 = CFrame.new(-0.4, 0.5, 0, 0, 0, 1, 0, 1, 0, -1, -0, -0) * CFrame.fromEulerAnglesXYZ(-math.pi/16,0,0)
&#9;&#9;wait(0.05)
&#9;&#9;Torso[&quot;Left Shoulder&quot;].C1 = CFrame.new(0.4, 0.5, 0, -0, -0, -1, 0, 1, 0, 1, 0, 0) * CFrame.fromEulerAnglesXYZ(-math.pi/8,0,0)
&#9;&#9;Torso[&quot;Right Shoulder&quot;].C1 = CFrame.new(-0.4, 0.5, 0, 0, 0, 1, 0, 1, 0, -1, -0, -0) * CFrame.fromEulerAnglesXYZ(-math.pi/8,0,0)
&#9;&#9;wait(0.05)
&#9;&#9;Torso[&quot;Left Shoulder&quot;].C1 = CFrame.new(0.4, 0.5, 0, -0, -0, -1, 0, 1, 0, 1, 0, 0) * CFrame.fromEulerAnglesXYZ(-math.pi/6,0,0)
&#9;&#9;Torso[&quot;Right Shoulder&quot;].C1 = CFrame.new(-0.4, 0.5, 0, 0, 0, 1, 0, 1, 0, -1, -0, -0) * CFrame.fromEulerAnglesXYZ(-math.pi/6,0,0)
&#9;&#9;wait(0.05)
&#9;&#9;Torso[&quot;Left Shoulder&quot;].C1 = CFrame.new(0.4, 0.5, 0, -0, -0, -1, 0, 1, 0, 1, 0, 0) * CFrame.fromEulerAnglesXYZ(-math.pi/3.5,0,0)
&#9;&#9;Torso[&quot;Right Shoulder&quot;].C1 = CFrame.new(-0.4, 0.5, 0, 0, 0, 1, 0, 1, 0, -1, -0, -0) * CFrame.fromEulerAnglesXYZ(-math.pi/3.5,0,0)
&#9;&#9;med = true
&#9;elseif med == true then
&#9;&#9;Human.Jump = true
&#9;&#9;Torso.BodyPosition:Remove()
&#9;&#9;Torso.BodyGyro:Remove()
&#9;&#9;Torso[&quot;Left Shoulder&quot;].C1 = CFrame.new(0.5, 0.5, 0, -0, -0, -1, 0, 1, 0, 1, 0, 0)
&#9;&#9;Torso[&quot;Right Shoulder&quot;].C1 = CFrame.new(-0.5, 0.5, 0, 0, 0, 1, 0, 1, 0, -1, -0, -0)
&#9;&#9;med = false
&#9;end
end 

function BackFlip() 
&#9;local player = game.Players.LocalPlayer
&#9;if player == nil then return end
&#9;Char = player.Character 
&#9;Human = Char.Humanoid 
&#9;Torso = Char.Torso 
&#9;CF = Torso.CFrame 
&#9;ManageAnimation(&quot;re anim&quot;) 
&#9;Stance() 
&#9;Human.Jump = true
&#9;VelUp = Instance.new(&quot;BodyVelocity&quot;) 
&#9;VelUp.velocity = Vector3.new(0,72.5,0)-Torso.CFrame.lookVector*30 
&#9;VelUp.P = VelUp.P*2 
&#9;VelUp.maxForce = Vector3.new(10000,10000,10000)*999 
&#9;VelUp.Parent = Torso 
&#9;coroutine.resume(coroutine.create(Down),VelUp) 
&#9;Gyro = Instance.new(&quot;BodyGyro&quot;) 
&#9;Gyro.P = Gyro.P*10 
&#9;Gyro.maxTorque = Vector3.new(100000,100000,100000)*999 
&#9;Gyro.cframe = CF 
&#9;Gyro.Parent = Torso 
&#9;for i=1, 32 do 
&#9;&#9;Gyro.cframe = Gyro.cframe*CFrame.fromEulerAnglesXYZ(math.pi/16,0,0) 
&#9;&#9;wait() 
&#9;end 
&#9;Gyro.cframe = CF 
&#9;game:GetService(&quot;Debris&quot;):AddItem(Gyro,2) 
&#9;ManageAnimation(&quot;re-anim&quot;) 
&#9;_restoreproperties() 
end 

bin = script.Parent
enabled = true

function onSelected(mouse)
&#9;local Message = Instance.new(&quot;Hint&quot;)
&#9;Message.Parent = bin.Parent.Parent
&#9;Message.Text = &quot;q - Front Flip, e - Back Flip, r - Reset, z - Fast Walk, x - Normal Walk, c - Stealth Walk, f - Meditate&quot;
&#9;mouse.Icon = &quot;rbxasset://textures\\ArrowCursor.png&quot;
&#9;mouse.KeyDown:connect(onKeyDown) 
end

function onKeyDown(key) 
&#9;if (key~=nil) then 
&#9;local key = key:lower() 
&#9;&#9;if (key==&quot;e&quot;) then 
&#9;&#9;&#9;BackFlip()
&#9;&#9;end
&#9;&#9;if (key==&quot;q&quot;) then 
&#9;&#9;&#9;FrontFlip()
&#9;&#9;end
&#9;&#9;if (key==&quot;f&quot;) then 
