		<Item class="Tool" referent="RBX10671">
			<Properties>
				<bool name="CanBeDropped">true</bool>
				<bool name="Enabled">true</bool>
				<CoordinateFrame name="Grip">
					<X>0</X>
					<Y>0</Y>
					<Z>-2.20000005</Z>
					<R00>0</R00>
					<R01>0</R01>
					<R02>1</R02>
