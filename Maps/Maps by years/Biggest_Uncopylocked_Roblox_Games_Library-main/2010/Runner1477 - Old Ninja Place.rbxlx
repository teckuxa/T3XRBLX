				<Item class="Script" referent="RBX10601">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Splat</string>
						<ProtectedString name="Source">local larm = script.Parent.Parent:FindFirstChild(&quot;Left Arm&quot;)
local rarm = script.Parent.Parent:FindFirstChild(&quot;Right Arm&quot;)
function onTouched(part)
&#9;if (part.Name == &quot;Splat&quot;) then
&#9;&#9;script.Parent.Parent.Alien.Health = script.Parent.Parent.Alien.Health -100
&#9;&#9;wait(0.1)
&#9;end
end

script.Parent.Touched:connect(onTouched)
script.Parent.Parent.Head.Touched:connect(onTouched)
larm.Touched:connect(onTouched)
rarm.Touched:connect(onTouched)
script.Parent.Parent.Sphere.Touched:connect(onTouched)
</ProtectedString>
