					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">bin = script.Parent

function onTouched(hit)
&#9;me = hit.Parent
&#9;if me:FindFirstChild(&quot;Humanoid&quot;) ~= nil then
&#9;&#9;if me.Humanoid.Health &gt; 0 then
&#9;&#9;&#9;if me:findFirstChild(&quot;Ninja&quot;) == nil then
&#9;&#9;&#9;&#9;nin = game.Lighting.Ninja1:Clone()
&#9;&#9;&#9;&#9;nin.Name = &quot;Ninja&quot;
&#9;&#9;&#9;&#9;nin.Parent = me
&#9;&#9;&#9;&#9;wait()

&#9;&#9;&#9;&#9;--Torso Parts

&#9;&#9;&#9;&#9;local weld_h = Instance.new(&quot;Weld&quot;)
&#9;&#9;&#9;&#9;weld_h.Parent = me.Torso
&#9;&#9;&#9;&#9;weld_h.Part0 = me:findFirstChild(&quot;Torso&quot;)
&#9;&#9;&#9;&#9;weld_h.Part1 = me.Ninja.P1
&#9;&#9;&#9;&#9;weld_h.C1 = CFrame.fromEulerAnglesXYZ(0, 0, 0) * CFrame.new(0, 0, 0)

&#9;&#9;&#9;&#9;local weld_h = Instance.new(&quot;Weld&quot;)
&#9;&#9;&#9;&#9;weld_h.Parent = me.Torso
&#9;&#9;&#9;&#9;weld_h.Part0 = me:findFirstChild(&quot;Torso&quot;)
&#9;&#9;&#9;&#9;weld_h.Part1 = me.Ninja.P2
&#9;&#9;&#9;&#9;weld_h.C1 = CFrame.fromEulerAnglesXYZ(0, 0, 0) * CFrame.new(0, 0.8, 0)

&#9;&#9;&#9;&#9;local weld_h = Instance.new(&quot;Weld&quot;)
&#9;&#9;&#9;&#9;weld_h.Parent = me.Torso
&#9;&#9;&#9;&#9;weld_h.Part0 = me:findFirstChild(&quot;Torso&quot;)
&#9;&#9;&#9;&#9;weld_h.Part1 = me.Ninja.P3
&#9;&#9;&#9;&#9;weld_h.C1 = CFrame.fromEulerAnglesXYZ(-0.1, 0, 0) * CFrame.new(-0.55, -0.5, 0.05)

&#9;&#9;&#9;&#9;local weld_h = Instance.new(&quot;Weld&quot;)
&#9;&#9;&#9;&#9;weld_h.Parent = me.Torso
&#9;&#9;&#9;&#9;weld_h.Part0 = me:findFirstChild(&quot;Torso&quot;)
&#9;&#9;&#9;&#9;weld_h.Part1 = me.Ninja.P4
&#9;&#9;&#9;&#9;weld_h.C1 = CFrame.fromEulerAnglesXYZ(-0.1, 0, 0) * CFrame.new(0.55, -0.5, 0.05)

&#9;&#9;&#9;&#9;local weld_h = Instance.new(&quot;Weld&quot;)
&#9;&#9;&#9;&#9;weld_h.Parent = me.Torso
&#9;&#9;&#9;&#9;weld_h.Part0 = me:findFirstChild(&quot;Torso&quot;)
&#9;&#9;&#9;&#9;weld_h.Part1 = me.Ninja.P5
&#9;&#9;&#9;&#9;weld_h.C1 = CFrame.fromEulerAnglesXYZ(-0.1, 0, 0) * CFrame.new(0.75, -0.5, 0.25)

&#9;&#9;&#9;&#9;local weld_h = Instance.new(&quot;Weld&quot;)
&#9;&#9;&#9;&#9;weld_h.Parent = me.Torso
&#9;&#9;&#9;&#9;weld_h.Part0 = me:findFirstChild(&quot;Torso&quot;)
&#9;&#9;&#9;&#9;weld_h.Part1 = me.Ninja.P6
&#9;&#9;&#9;&#9;weld_h.C1 = CFrame.fromEulerAnglesXYZ(-0.1, 0, 0) * CFrame.new(-0.75, -0.5, 0.25)

&#9;&#9;&#9;&#9;local weld_h = Instance.new(&quot;Weld&quot;)
&#9;&#9;&#9;&#9;weld_h.Parent = me.Torso
&#9;&#9;&#9;&#9;weld_h.Part0 = me:findFirstChild(&quot;Torso&quot;)
&#9;&#9;&#9;&#9;weld_h.Part1 = me.Ninja.P7
&#9;&#9;&#9;&#9;weld_h.C1 = CFrame.fromEulerAnglesXYZ(0.05, 0, 0) * CFrame.new(0.75, 0.5, 0.25)

&#9;&#9;&#9;&#9;local weld_h = Instance.new(&quot;Weld&quot;)
&#9;&#9;&#9;&#9;weld_h.Parent = me.Torso
&#9;&#9;&#9;&#9;weld_h.Part0 = me:findFirstChild(&quot;Torso&quot;)
&#9;&#9;&#9;&#9;weld_h.Part1 = me.Ninja.P8
&#9;&#9;&#9;&#9;weld_h.C1 = CFrame.fromEulerAnglesXYZ(0.05, 0, 0) * CFrame.new(-0.75, 0.5, 0.25)

