					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">TeleportScript</string>
					<ProtectedString name="Source">--- SonOfSevenless
bin = script.Parent

function findNearestTorso(mouse, pos)
&#9;local torso = nil
&#9;dist = 100
&#9;temp = mouse.Hit
&#9;if (temp ~= nil) then
&#9;&#9;if (temp.p - pos).magnitude &lt; dist then
&#9;&#9;&#9;torso = mouse.Hit.p
&#9;&#9;&#9;dist = (temp.p - pos).magnitude
&#9;&#9;end
&#9;end
&#9;return torso
end

function teleportPlayer(pos)

&#9;local player = game.Players.LocalPlayer
&#9;if player == nil or player.Character == nil then return end

&#9;local char = player.Character.Torso

&#9;char.CFrame = CFrame.new(Vector3.new(pos.x, pos.y + 4, pos.z))

end


enabled = true
function onButton1Down(mouse)
&#9;if not enabled then
&#9;&#9;return
&#9;end

&#9;local player = game.Players.LocalPlayer
&#9;if player == nil then return end
&#9;local target = findNearestTorso(mouse, player.Character.Torso.Position)
&#9;if target ~= nil then
&#9;&#9;enabled = false
&#9;&#9;local cf = mouse.Hit
&#9;&#9;spin = Instance.new(&quot;BodyAngularVelocity&quot;)
&#9;&#9;spin.maxTorque = Vector3.new(0,9e+009,0)
&#9;&#9;spin.angularvelocity = Vector3.new(0,250,0)
&#9;&#9;spin.Parent = player.Character.Torso
&#9;&#9;player.Character.Humanoid.WalkSpeed = 0
&#9;&#9;wait(0.2)
&#9;&#9;smoke = game.Lighting.Smoke:Clone()
&#9;&#9;smoke.Parent = player.Character
&#9;&#9;smoke.CFrame = player.Character.Torso.CFrame
&#9;&#9;wait(0.04)
&#9;&#9;smoke.Transparency = 0.8
&#9;&#9;wait(0.04)
&#9;&#9;smoke.Transparency = 0.6
&#9;&#9;wait(0.04)
&#9;&#9;smoke.Transparency = 0.4
&#9;&#9;wait(0.04)
&#9;&#9;smoke.Transparency = 0.2
&#9;&#9;wait(0.04)
&#9;&#9;smoke.Transparency = 0
&#9;&#9;wait(0.04)
&#9;&#9;smoke.Transparency = 0.2
&#9;&#9;wait(0.04)
&#9;&#9;smoke.Transparency = 0.4
&#9;&#9;wait(0.04)
&#9;&#9;smoke.Transparency = 0.6
&#9;&#9;wait(0.04)
&#9;&#9;smoke.Transparency = 0.8
&#9;&#9;wait(0.04)
&#9;&#9;spin:Remove()
&#9;&#9;smoke:Remove()
&#9;&#9;teleportPlayer(cf.p)
&#9;&#9;spin = Instance.new(&quot;BodyAngularVelocity&quot;)
&#9;&#9;spin.maxTorque = Vector3.new(0,9e+009,0)
&#9;&#9;spin.angularvelocity = Vector3.new(0,250,0)
&#9;&#9;spin.Parent = player.Character.Torso
&#9;&#9;smoke = game.Lighting.Smoke:Clone()
&#9;&#9;smoke.Parent = player.Character
&#9;&#9;smoke.CFrame = player.Character.Torso.CFrame
&#9;&#9;wait(0.04)
&#9;&#9;smoke.Transparency = 0.8
&#9;&#9;wait(0.04)
&#9;&#9;smoke.Transparency = 0.6
&#9;&#9;wait(0.04)
&#9;&#9;smoke.Transparency = 0.4
&#9;&#9;wait(0.04)
&#9;&#9;smoke.Transparency = 0.2
&#9;&#9;wait(0.04)
&#9;&#9;smoke.Transparency = 0
&#9;&#9;wait(0.04)
&#9;&#9;smoke.Transparency = 0.2
&#9;&#9;wait(0.04)
&#9;&#9;smoke.Transparency = 0.4
&#9;&#9;wait(0.04)
&#9;&#9;smoke.Transparency = 0.6
&#9;&#9;wait(0.04)
&#9;&#9;smoke.Transparency = 0.8
&#9;&#9;wait(0.04)
&#9;&#9;smoke:Remove()
&#9;&#9;wait(0.2)
&#9;&#9;player.Character.Humanoid.WalkSpeed = 16
&#9;&#9;spin:remove()
&#9;end
&#9;enabled = true
end

function onSelected(mouse)
&#9;mouse.Icon = &quot;rbxasset://textures\\ArrowCursor.png&quot;
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end

bin.Selected:connect(onSelected)

function onUnselected(mouse)
&#9;local player = game.Players.LocalPlayer
&#9;if player == nil then return end
&#9;smo = player.Character:getChildren()
&#9;for i = 1, #smo do
&#9;&#9;if smo[i].Name == &quot;Smoke&quot; then
&#9;&#9;&#9;smo[i]:Remove()
&#9;&#9;elseif smo[i].Name == &quot;Torso&quot; then
&#9;&#9;&#9;if smo[i]:findFirstChild(&quot;BodyAngularVelocity&quot;) ~= nil then
&#9;&#9;&#9;&#9;smo[i].BodyAngularVelocity:Remove()
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;script:Clone().Parent = script.Parent
&#9;script:Remove()
end

bin.Deselected:connect(onUnselected)

