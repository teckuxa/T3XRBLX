						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">KillScript</string>
						<ProtectedString name="Source">function OnTouch(hit)
&#9;a = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
&#9;if a ~= nil then
&#9;&#9;a.Health = 0
&#9;end
end

script.Parent.Blade1.Touched:connect(OnTouch)
script.Parent.Blade2.Touched:connect(OnTouch)
script.Parent.Blade3.Touched:connect(OnTouch)
script.Parent.Blade4.Touched:connect(OnTouch)
script.Parent.Blade5.Touched:connect(OnTouch)
script.Parent.Blade6.Touched:connect(OnTouch)
script.Parent.Blade7.Touched:connect(OnTouch)
script.Parent.Ground.Touched:connect(OnTouch)
script.Parent.Ground1.Touched:connect(OnTouch)</ProtectedString>
					</Properties>
				</Item>
