&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;elseif string.lower(script.Parent.Commander.Value)==string.lower(Player.Name) then
&#9;&#9;&#9;Player.Chatted:connect(function(msg, recipient) onChatted(msg, recipient) end) 
&#9;&#9;end
