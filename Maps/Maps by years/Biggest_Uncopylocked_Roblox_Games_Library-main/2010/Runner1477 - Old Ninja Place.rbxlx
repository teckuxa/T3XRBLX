				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">l = script.Parent
while true do
wait()
local h = l:GetChildren()
for i = 1, #h do
if h[i].className == &quot;Part&quot; then
h[i].CFrame = h[i].CFrame * CFrame.fromEulerAnglesXYZ(-0.01,0,0)
end
end
end
</ProtectedString>
