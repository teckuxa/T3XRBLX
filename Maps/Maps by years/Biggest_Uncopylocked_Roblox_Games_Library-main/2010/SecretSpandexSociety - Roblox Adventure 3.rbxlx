						<ProtectedString name="Source">script.Parent.BodyGyro.cframe = script.Parent.CFrame
script.Parent.BodyPosition.position = script.Parent.Position
local debounce = true
wait(0.2)
script.Parent.Anchored = false 

function OnTouch(hit)
if hit.Parent == nil then return end
a = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
if a ~= nil and debounce == true then
	if a.Health ~= 0 then
	debounce = false
	wait(0.2)
	script.Parent.BodyPosition.position = Vector3.new(script.Parent.BodyPosition.position.x,script.Parent.BodyPosition.position.y-32,script.Parent.BodyPosition.position.z)
	wait(2.5)
	script.Parent.BodyPosition.position = Vector3.new(script.Parent.BodyPosition.position.x,script.Parent.BodyPosition.position.y+32,script.Parent.BodyPosition.position.z)
	wait(1)
	debounce = true
	end
end
end
