					<Item class="Script" referent="RBX4965">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">function onTouched(part)
	local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if h~=nil then
		if (script.Parent.Parent.Smoker.Smoke.Enabled == true) then
			h.Health = 0
		end
	end
end

script.Parent.Touched:connect(onTouched)

while true do
wait(4)
script.Parent.Parent.Smoker.Smoke.Enabled = true
script.Parent.Parent.Smoker.Velocity = Vector3.new(0,8,0)
wait(0.1)
script.Parent.Parent.Smoker.CanCollide = false
wait(4)
script.Parent.Parent.Smoker.Velocity = Vector3.new(0,0,0)
script.Parent.Parent.Smoker.Smoke.Enabled = false
script.Parent.Parent.Smoker.CanCollide = true
end

</ProtectedString>
							<bool name="archivable">true</bool>
