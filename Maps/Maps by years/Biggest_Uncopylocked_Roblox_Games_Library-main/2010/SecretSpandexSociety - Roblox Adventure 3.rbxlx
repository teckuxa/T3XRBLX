						<Item class="Script" referent="RBX1652">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Drive</string>
								<ProtectedString name="Source">MaxSpeed=34
engine = script.Parent.Parent.Part

function check()
	if (script.Parent.Throttle==1) then
	script.Parent.Parent.Part.BodyVelocity.velocity=engine.CFrame.lookVector*MaxSpeed
	elseif (script.Parent.Throttle==0) then
	script.Parent.Parent.Part.BodyVelocity.velocity=Vector3.new(0,0,0)
	elseif(script.Parent.Throttle==-1) then
	script.Parent.Parent.Part.BodyVelocity.velocity=engine.CFrame.lookVector*-MaxSpeed/2
	end
	if (script.Parent.Steer==-1) then
		script.Parent.Parent.Part.BodyGyro.cframe=script.Parent.CFrame*CFrame.fromEulerAnglesXYZ(0,math.pi/50,0)
		elseif (script.Parent.Steer==1) then
		script.Parent.Parent.Part.BodyGyro.cframe=script.Parent.CFrame*CFrame.fromEulerAnglesXYZ(0,math.pi/-50,0)
	end
end

while true do
	wait()
	if (script.Parent.Anchored == false) then
	check()
	end
end
</ProtectedString>
								<bool name="archivable">true</bool>
							</Properties>
						</Item>
						<Item class="Script" referent="RBX1653">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<ProtectedString name="Source">local inseat = false

script.Parent.ChildAdded:connect(function(p)
	if (p.Part1.Name == &quot;Torso&quot;) then
		inseat = true
		local thisplr = game.Players:findFirstChild(p.Part1.Parent.Name)
		if thisplr == nil then return end
		if (thisplr:findFirstChild(&quot;token1&quot;) ~= nil) then
			print(&quot;Allowed&quot;)
			script.Parent.Anchored = false
			inseat = true
			if (thisplr.PlayerGui.Talk.geoff_boatwarn.page2.Visible == false) and (thisplr:findFirstChild(&quot;boatwarn2&quot;) == nil) then
				thisplr.PlayerGui.Talk.geoff_boatwarn.page2.Visible = true
				local pp = Instance.new(&quot;ObjectValue&quot;)
				pp.Parent = thisplr
				pp.Name = &quot;boatwarn2&quot;
			end
		elseif (thisplr.PlayerGui.Talk.geoff_boatwarn.page1.Visible == false) then
			print(&quot;Not allowed&quot;) 
			thisplr.PlayerGui.Talk.geoff_boatwarn.page1.Visible = true
		end
	end
end)

script.Parent.ChildRemoved:connect(function()
	wait(1)
	print(&quot;Removing boat&quot;)
	script.Parent.Parent:remove()
end)
	</ProtectedString>
