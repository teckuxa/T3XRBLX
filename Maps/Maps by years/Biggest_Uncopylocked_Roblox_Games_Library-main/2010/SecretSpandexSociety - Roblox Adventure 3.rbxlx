							</UDim2>
							<token name="SizeConstraint">0</token>
							<string name="Text">Oh joy, it&apos;s yet another clueless adventurer. Are you even properly dressed for this horrid place?</string>
							<Color3 name="TextColor3">4278190080</Color3>
