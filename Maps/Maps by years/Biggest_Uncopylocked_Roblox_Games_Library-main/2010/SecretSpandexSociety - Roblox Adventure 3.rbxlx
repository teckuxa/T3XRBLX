					<Item class="Script" referent="RBX7212">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">local barrel = script.Parent

local debounce = false

local cannonBall = Instance.new(&quot;Part&quot;)
cannonBall.Size = Vector3.new(2,2,2)
cannonBall.BrickColor = BrickColor.new(21) -- red
cannonBall.BottomSurface = 0
cannonBall.TopSurface = 0
cannonBall.Name = &quot;Cannon Shot&quot;
cannonBall.Elasticity = .1
cannonBall.Reflectance = 0
cannonBall.Friction = 1
cannonBall.CanCollide = true

function fire(player)

	local sound = script.Parent:findFirstChild(&quot;GunSound&quot;)
	if sound == nil then
		sound = Instance.new(&quot;Sound&quot;)
		sound.Name = &quot;GunSound&quot;
		sound.SoundId = &quot;rbxasset://sounds\\bass.wav&quot;
		sound.Volume = 0.5
		sound.Parent = script.Parent
	end
	sound:play()



	
	local missile = Instance.new(&quot;Part&quot;)
	

	local spawnPos = barrel.CFrame * Vector3.new(-2, 0, 0)

	local dx = 0
	local dy = 0
	local dz = 0
	local mag = -90

	local v = barrel.CFrame:vectorToWorldSpace(Vector3.new(mag + dx,dy+math.random(0,10),dz))
	
	local missile = cannonBall:clone()

	missile.Position = spawnPos
	missile.Velocity = v

	local bpb = Instance.new(&quot;SpecialMesh&quot;)
	bpb.MeshId = &quot;rbxasset://fonts/trowel.mesh&quot;
	bpb.TextureId = &quot;rbxasset://textures/TrowelTexture.png&quot;
	bpb.Parent = missile

	local new_script = script.Parent.CannonBall:clone()
	new_script.Disabled = false
	new_script.Parent = missile

	missile.Parent = game.Workspace

end

while true do
	if script.Parent.Parent.Parent.Boss.Health == 0 then return end
	wait(1)
	if (script.Parent.Parent.Parent.canfire.Value == true) then
		if script.Parent.Parent.Parent.Boss.Health == 0 then return end
		fire(player)
		wait(script.Parent.Parent.Parent.Boss.Health/2.2)
		if script.Parent.Parent.Parent.Boss.Health == 0 then return end
		fire(player)
		wait(script.Parent.Parent.Parent.Boss.Health/2.2)
		if script.Parent.Parent.Parent.Boss.Health == 0 then return end
		fire(player)
		wait(script.Parent.Parent.Parent.Boss.Health/2.2)
		if script.Parent.Parent.Parent.Boss.Health == 0 then return end
		fire(player)
		if (script.Parent.Parent.Parent.Boss.Health &lt; 3) then
			wait(script.Parent.Parent.Parent.Boss.Health/2.2)
			if script.Parent.Parent.Parent.Boss.Health == 0 then return end
			fire(player)	
			wait(script.Parent.Parent.Parent.Boss.Health/2.2)
			if script.Parent.Parent.Parent.Boss.Health == 0 then return end
			fire(player)
			wait(script.Parent.Parent.Parent.Boss.Health/2.2)
			if script.Parent.Parent.Parent.Boss.Health == 0 then return end
			fire(player)
			if (script.Parent.Parent.Parent.Boss.Health &lt; 2) then
				wait(script.Parent.Parent.Parent.Boss.Health/2.2)
				if script.Parent.Parent.Parent.Boss.Health == 0 then return end
				fire(player)
				wait(script.Parent.Parent.Parent.Boss.Health/2.2)
				if script.Parent.Parent.Parent.Boss.Health == 0 then return end
				fire(player)
				wait(script.Parent.Parent.Parent.Boss.Health/2.2)
				if script.Parent.Parent.Parent.Boss.Health == 0 then return end
				fire(player)
				wait(script.Parent.Parent.Parent.Boss.Health/2.2)
				if script.Parent.Parent.Parent.Boss.Health == 0 then return end
				fire(player)
				wait(script.Parent.Parent.Parent.Boss.Health/2.2)
				if script.Parent.Parent.Parent.Boss.Health == 0 then return end
				fire(player)
				wait(script.Parent.Parent.Parent.Boss.Health/2.2)
				if script.Parent.Parent.Parent.Boss.Health == 0 then return end
				fire(player)
			end
		end
		script.Parent.Anchored = true
		wait(6+(script.Parent.Parent.Parent.Boss.Health/2))
		script.Parent.Anchored = false
	end
end
</ProtectedString>
