						</Item>
						<Item class="Script" referent="RBX1768">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<ProtectedString name="Source">local inseat = false

script.Parent.ChildAdded:connect(function(p)
	if (p.Part1.Name == &quot;Torso&quot;) then
		inseat = true
		local thisplr = game.Players:findFirstChild(p.Part1.Parent.Name)
		if thisplr == nil then return end
		if (thisplr:findFirstChild(&quot;token1&quot;) ~= nil) then
			print(&quot;Allowed&quot;)
			script.Parent.Anchored = false
			inseat = true
			if (thisplr.PlayerGui.Talk.geoff_boatwarn.page2.Visible == false) and (thisplr:findFirstChild(&quot;boatwarn2&quot;) == nil) then
				thisplr.PlayerGui.Talk.geoff_boatwarn.page2.Visible = true
				local pp = Instance.new(&quot;ObjectValue&quot;)
				pp.Parent = thisplr
				pp.Name = &quot;boatwarn2&quot;
			end
		elseif (thisplr.PlayerGui.Talk.geoff_boatwarn.page1.Visible == false) then
			print(&quot;Not allowed&quot;) 
			thisplr.PlayerGui.Talk.geoff_boatwarn.page1.Visible = true
		end
	end
end)

script.Parent.ChildRemoved:connect(function()
	wait(1)
	print(&quot;Removing boat&quot;)
	script.Parent.Parent:remove()
end)
	</ProtectedString>
