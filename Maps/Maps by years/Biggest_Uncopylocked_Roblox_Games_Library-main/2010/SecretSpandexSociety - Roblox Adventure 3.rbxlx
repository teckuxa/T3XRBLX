							<ProtectedString name="Source">self = script.Parent

function onTouched(part)
	if part.Parent ~= nil then
		local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
			if h~=nil then
				
self.Boing:play()
h.Parent.Torso.Velocity=Vector3.new(0,160,0)
wait(0.5)
self.Boing:stop()
			end			
	end
end

script.Parent.Touched:connect(onTouched)
