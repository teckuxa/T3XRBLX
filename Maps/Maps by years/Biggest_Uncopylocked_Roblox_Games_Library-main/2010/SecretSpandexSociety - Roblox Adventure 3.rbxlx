					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Deteriorate</string>
					<ProtectedString name="Source">healthy = script.Parent:findFirstChild(&quot;Zombie&quot;)
debounce = false

while true do
	wait(0.1)
	if (healthy.Health == 0) then
		if (debounce == true) then return end
		debounce = true
		wait(1)
		t = game.Lighting.winportn:Clone()
		t.Parent = game.Workspace
		t:MakeJoints()
		wait(18)
		script.Parent:remove()
		game.Workspace.winportn:Remove()
	end
end
