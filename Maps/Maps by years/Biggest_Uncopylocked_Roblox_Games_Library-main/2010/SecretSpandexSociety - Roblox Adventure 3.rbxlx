								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Drivep</string>
								<ProtectedString name="Source">MaxSpeed=32
MaxTurn=30
engine = script.Parent
mt = 0

function check()
	if (script.Parent.Steer==-1) then
		if (mt &gt; -MaxTurn) then
		mt = mt - 9
		script.Parent.BodyVelocity.velocity = Vector3.new(script.Parent.BodyVelocity.velocity.x-9,script.Parent.BodyVelocity.velocity.y,-48)
		end
		elseif (script.Parent.Steer==1) then
		if (mt &lt; MaxTurn) then
		mt = mt + 9
		script.Parent.BodyVelocity.velocity = Vector3.new(script.Parent.BodyVelocity.velocity.x+9,script.Parent.BodyVelocity.velocity.y,-48)
		end
	end
end

while true do
	wait()
	if (script.Parent.Throttle==1) then
		if (script.Parent.Anchored == true) then
			script.Parent.Anchored = false
		end
	end
	check()
end
</ProtectedString>
