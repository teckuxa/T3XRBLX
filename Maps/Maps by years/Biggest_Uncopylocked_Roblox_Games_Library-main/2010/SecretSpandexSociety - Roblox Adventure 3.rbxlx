				<Item class="Script" referent="RBX7283">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">FireGun</string>
						<ProtectedString name="Source">local barrel = script.Parent

local debounce = false

local cannonBall = Instance.new(&quot;Part&quot;)
cannonBall.Size = Vector3.new(2,2,2)
cannonBall.BrickColor = BrickColor.new(21) -- red
cannonBall.Shape = 1
cannonBall.BottomSurface = 0
cannonBall.TopSurface = 0
cannonBall.Name = &quot;shot&quot;
cannonBall.Elasticity = .1
cannonBall.Reflectance = 0
cannonBall.Friction = 1
cannonBall.CanCollide = false

function getPlayer(humanoid)
	-- find the owning player of a humanoid.
	local players = game.Players:children()
	for i = 1, #players do
		if players[i].Character ~= nil then
			if players[i].Character.Humanoid == humanoid then return players[i] end
		end
	end
	return nil
end

function fire(player)
	if script.Parent.Parent.Boss.Health == 0 then script.Parent.Parent.Torso.BodyPosition:remove() return end
	local sound = script.Parent:findFirstChild(&quot;GunSound&quot;)
	if sound == nil then
		sound = Instance.new(&quot;Sound&quot;)
		sound.Pitch = math.random(0.8,1.2)
		sound.Name = &quot;GunSound&quot;
		sound.SoundId = &quot;http://www.roblox.com/asset/?id=13775480&quot;
		sound.Volume = 0.5
		sound.Parent = script.Parent
	end
	sound:play()



	
	local missile = Instance.new(&quot;Part&quot;)
	

	local spawnPos = barrel.CFrame * Vector3.new(2+math.random(-3,3), 0, 0+math.random(-3,3))

	local dx = 0
	local dy = 0
	local dz = 0
	local mag = 100

	local v = barrel.CFrame:vectorToWorldSpace(Vector3.new(mag + dx+math.random(-3,3),dy,dz+math.random(-3,3)))
	
	local missile = cannonBall:clone()

	missile.Position = spawnPos
	missile.Velocity = v

	local bpb = Instance.new(&quot;BodyPosition&quot;)
	bpb.position = barrel.Position
	bpb.maxForce = Vector3.new(0,80000,0)
	bpb.Parent = missile

	local new_script = script.Parent.CannonBall:clone()
	new_script.Disabled = false
	new_script.Parent = missile

	missile.Parent = game.Workspace

end

while true do
	if barrel.Parent.canfire.Value == true then
		fire(player)
	end
wait(barrel.speed.Value)
end


script.Parent.Touched:connect(onTouched)


