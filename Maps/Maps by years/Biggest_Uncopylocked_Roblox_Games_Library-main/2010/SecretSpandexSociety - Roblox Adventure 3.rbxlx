		<Item class="Script" referent="RBX6552">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">AdventureScript</string>
				<ProtectedString name="Source">--by TylerMcBride.

function onPlayerEntered(newPlayer)

	local stats = Instance.new(&quot;IntValue&quot;) --Show leaderboard
	stats.Name = &quot;leaderstats&quot;

	local st = Instance.new(&quot;IntValue&quot;) --Stars
	st.Name = &quot;Tokens&quot;
	st.Value = 0

	st.Parent = stats

	local cp = Instance.new(&quot;Vector3Value&quot;) --Initialize checkpoint values
	cp.Name = &quot;Checkpoint&quot;
	cp.Value = Vector3.new(-1,-1,-1)

	cp.Parent = newPlayer

	local bc = Instance.new(&quot;IntValue&quot;) --Initialize values
	bc.Name = &quot;lose1&quot;
	bc.Value = 0

	bc.Parent = newPlayer

	local bc = Instance.new(&quot;IntValue&quot;) --Initialize values
	bc.Name = &quot;lose2&quot;
	bc.Value = 0

	bc.Parent = newPlayer

	local bc = Instance.new(&quot;IntValue&quot;) --Initialize values
	bc.Name = &quot;lose3&quot;
	bc.Value = 0

	bc.Parent = newPlayer

	local bc = Instance.new(&quot;IntValue&quot;) --Initialize values
	bc.Name = &quot;bluecoins&quot;
	bc.Value = 0

	bc.Parent = newPlayer

	local bc = Instance.new(&quot;BoolValue&quot;) --Initialize values
	bc.Name = &quot;desertcoins&quot;
	bc.Value = false

	bc.Parent = newPlayer

	local bc = Instance.new(&quot;BoolValue&quot;) --Initialize values
	bc.Name = &quot;coins1&quot;
	bc.Value = false

	bc.Parent = newPlayer

	local bc = Instance.new(&quot;BoolValue&quot;) --Initialize values
	bc.Name = &quot;coins2&quot;
	bc.Value = false

	bc.Parent = newPlayer

	local bc = Instance.new(&quot;BoolValue&quot;) --Initialize values
	bc.Name = &quot;coins3&quot;
	bc.Value = false

	bc.Parent = newPlayer

	local bc = Instance.new(&quot;BoolValue&quot;) --Initialize values
	bc.Name = &quot;coins4&quot;
	bc.Value = false

	bc.Parent = newPlayer

	local bc = Instance.new(&quot;BoolValue&quot;) --Initialize values
	bc.Name = &quot;coins5&quot;
	bc.Value = false

	bc.Parent = newPlayer

	stats.Parent = newPlayer

	if (newPlayer.Name == &quot;TylerMcBride&quot;) then --Let everyone know of my arrival!
		local m = Instance.new(&quot;Message&quot;)
		m.Parent = game.Workspace
		m.Text = &quot;The creator, TylerMcBride, is here!&quot;
		wait(4)
		m:Remove()
	end
end

function onPlayerEntered2(newPlayer) 
newPlayer.Changed:connect(function(property) 
if (property == &quot;Character&quot;) then
	if (newPlayer.Checkpoint.Value ~= Vector3.new(-1,-1,-1)) then
		wait(0.2)
		newPlayer.Character:MoveTo(Vector3.new(newPlayer.Checkpoint.Value.x,newPlayer.Checkpoint.Value.y+2,newPlayer.Checkpoint.Value.z))
		newPlayer.Character.Torso.Velocity = Vector3.new(0,0,0)
		newPlayer.Character.Torso.RotVelocity = Vector3.new(0,0,0)
		wait(1.5)		

	end
end
end) 
end 

game.Players.PlayerAdded:connect(onPlayerEntered2) 


game.Players.ChildAdded:connect(onPlayerEntered)
