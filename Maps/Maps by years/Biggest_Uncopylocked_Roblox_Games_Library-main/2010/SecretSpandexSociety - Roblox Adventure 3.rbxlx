					<Item class="Script" referent="RBX3603">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">AimScript</string>
							<ProtectedString name="Source">bin = script.Parent
debounce = false

function findNearestTorso(pos)
	local list = game.Workspace:GetChildren()
	local torso = nil
	local dist = 40
	local temp = nil
	local human = nil
	local temp2 = nil
	for x = 1, #list do
		temp2 = list[x]
		if (temp2.className == &quot;Model&quot;) and (temp2 ~= script.Parent) then
			temp = temp2:findFirstChild(&quot;Torso&quot;)
			human = temp2:findFirstChild(&quot;Humanoid&quot;)
			if (temp ~= nil) and (human ~= nil) and (human.Health &gt; 0) then
				if (temp.Position - pos).magnitude &lt; dist then
					torso = temp
					dist = (temp.Position - pos).magnitude
				end
			end
		end
	end
	return torso
end

while true do
	local torso = findNearestTorso(bin.Position)
	if torso~=nil then
		script.Parent.Parent.canfire.Value = true
	else script.Parent.Parent.canfire.Value = false
	end
	wait()
end

</ProtectedString>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
					<Item class="Script" referent="RBX3604">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">FireGun</string>
							<ProtectedString name="Source">local barrel = script.Parent
wait(1)


while true do
wait(7)
	if (barrel.Parent.canfire.Value == true) then
		local sp = game.Lighting.Lovebomb:clone()
		sp.Name = &quot;LovebombC&quot;
		sp.Parent = game.Workspace
		sp:MakeJoints()
		sp.Head.LoveBomb.Disabled = false
		sp:MoveTo(barrel.Position)
		sp.Heh.Anchored = false
		sp.Head.LoveBomb.Disabled = false
		sp.canrun.Value = true
	end

end


script.Parent.Touched:connect(onTouched)


</ProtectedString>
							<bool name="archivable">true</bool>
