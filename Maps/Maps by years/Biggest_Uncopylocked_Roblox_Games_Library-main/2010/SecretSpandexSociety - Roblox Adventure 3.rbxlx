								<string name="Name">Drivep</string>
								<ProtectedString name="Source">function check()
	if (script.Parent.Steer==-1) then
		script.Parent.BodyVelocity.velocity = Vector3.new(-32,script.Parent.BodyVelocity.velocity.y,-46)
		elseif (script.Parent.Steer==1) then
		script.Parent.BodyVelocity.velocity = Vector3.new(32,script.Parent.BodyVelocity.velocity.y,-46)
		elseif (script.Parent.Steer==0) then
		script.Parent.BodyVelocity.velocity = Vector3.new(0,script.Parent.BodyVelocity.velocity.y,-46)
	end
end

while true do
	wait()
	if (script.Parent.Throttle==1) then
		if (script.Parent.Anchored == true) then
			script.Parent.Anchored = false
			script.Parent.BodyVelocity.velocity = Vector3.new(0,script.Parent.BodyVelocity.velocity.y,-46)
		end
	end
	check()
end
