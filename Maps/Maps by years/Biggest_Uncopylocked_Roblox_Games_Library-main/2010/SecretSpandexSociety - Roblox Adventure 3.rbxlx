						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Checkpoint</string>
						<ProtectedString name="Source">local debounce = true
script.Parent.Transparency = 1

function onTouched(part)
	local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if (h~=nil) and (h.Health ~= 0) then
		local thisplr = game.Players:findFirstChild(h.Parent.Name)
		if (thisplr~=nil) then
				local cash = thisplr:findFirstChild(&quot;Checkpoint&quot;)
				if (cash ~= nil) then
					debounce = false
					cash.Value = Vector3.new(script.Parent.Position.x,script.Parent.Position.y+4,script.Parent.Position.z)
					debounce = true
				end
		end
	end
end

