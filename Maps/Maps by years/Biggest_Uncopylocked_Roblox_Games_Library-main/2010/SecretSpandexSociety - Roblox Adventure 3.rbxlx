				<Item class="Script" referent="RBX3834">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">enabled = true

function onTouched(part)
	h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
		if (h ~= nil) then
			local thisplr = game.Players:findFirstChild(h.Parent.Name)
			if (thisplr.lose2.Value == 2) and (enabled == true) then
				enabled = false
				script.Parent.Transparency = 0.5
				script.Parent.CanCollide = false
				wait(2)
				enabled = true
				script.Parent.Transparency = 0
				script.Parent.CanCollide = true
				elseif (thisplr.lose2.Value ~= 2) then
					h.Health = 0
			end
		end
end

script.Parent.Touched:connect(onTouched)</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
