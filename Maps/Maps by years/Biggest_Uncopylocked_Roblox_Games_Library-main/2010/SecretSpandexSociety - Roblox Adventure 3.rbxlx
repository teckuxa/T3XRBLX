				<Item class="Script" referent="RBX3150">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">function onTouch(part) 
	if part.Parent == nil then return end
	local humanoid = part.Parent:FindFirstChild(&quot;Humanoid&quot;) 
	if (humanoid ~= nil) then	-- if a humanoid exists, then
		humanoid.Health = 0	-- damage the humanoid
	end 
end

script.Parent.Touched:connect(onTouch)
</ProtectedString>
