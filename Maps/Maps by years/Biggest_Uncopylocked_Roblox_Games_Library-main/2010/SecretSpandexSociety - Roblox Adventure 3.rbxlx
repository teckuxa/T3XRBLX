				<Item class="Script" referent="RBX2380">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">function sitDown(hit)
	if hit.Parent == nil then return end
	h = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
	if (h ~= nil) then
		if (h.WalkSpeed ~= 42) then
		h.Parent.Torso.Velocity = Vector3.new(script.Parent.Velocity.x*32,0,script.Parent.Velocity.z*32)
		h.Parent.Torso.RotVelocity = Vector3.new(script.Parent.Velocity.x*32,0,script.Parent.Velocity.z*32)
		end
	end
end

