					<string name="Name">Script</string>
					<ProtectedString name="Source">function onTouched(part)
	if part.Parent == nil then return end
	h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
		if (h ~= nil) then
			h.Parent:MoveTo(game.Workspace.level1start.Position)
		end
end

