							<string name="Name">Script</string>
							<ProtectedString name="Source">script.Parent.BodyPosition.position = script.Parent.Position
wait(0.5)
script.Parent.Anchored = false
script.Parent.BodyGyro.cframe = script.Parent.CFrame

while true do
wait(1.2)
script.Parent.BodyVelocity.velocity = Vector3.new(30,0,0)
wait(1.2)
script.Parent.BodyVelocity.velocity = Vector3.new(-30,0,0)
end
</ProtectedString>
