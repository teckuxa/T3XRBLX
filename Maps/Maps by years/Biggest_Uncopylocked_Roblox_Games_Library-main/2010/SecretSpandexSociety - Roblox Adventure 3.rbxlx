					<Item class="Script" referent="RBX5044">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Get</string>
							<ProtectedString name="Source">local debounce = false

function sitDown(hit)
	if hit.Parent == nil then return end
	h = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
	if (h ~= nil) then
		if (h.Parent:findFirstChild(&quot;powerup&quot;) == nil) and (debounce == false) then
			debounce = true
			local cs = script.Parent.Speed:clone()
			cs.Parent = h.Parent
			cs.Disabled = false
			local p = Instance.new(&quot;ObjectValue&quot;)
			p.Parent = h.Parent
			p.Name = &quot;powerup&quot;
			script.Parent:remove()
		elseif (h.Parent:findFirstChild(&quot;Speed&quot;) ~= nil) and (debounce == false) then
			debounce = true
			local ss = h.Parent.Torso:findFirstChild(&quot;sparkle&quot;)
			if ss ~= nil then ss.SparkleColor = script.c1.Value end
			h.Parent.Speed:Remove()
			local cs = script.Parent.Speed:clone()
			cs.Parent = h.Parent
			cs.Disabled = false
			script.Parent:remove()
		end
	end
end

script.Parent.Touched:connect(sitDown)</ProtectedString>
