		<Item class="Script" referent="RBX1856">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">onEnter</string>
				<ProtectedString name="Source">local playr = game.Players.LocalPlayer

function onPlayerRespawned(newPlayer)
	wait(1)
	if (game:GetService(&quot;BadgeService&quot;):UserHasBadge(newPlayer.userId, 16662185) ~= false) then
		local d = Instance.new(&quot;Decal&quot;)
		d.Parent = newPlayer.Character.Torso
		d.Texture = &quot;http://www.roblox.com/asset/?id=18878502&quot;
		d.Face = &quot;Front&quot;
	end
end

function onPlayerEntered(newPlayer)
	newPlayer.Changed:connect(function (property)
		if (property == &quot;Character&quot;) then
			onPlayerRespawned(newPlayer)
		end
	end)
end

game.Players.PlayerAdded:connect(onPlayerEntered)
</ProtectedString>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
