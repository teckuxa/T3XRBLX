							<ProtectedString name="Source">function OnTouch(hit)
if hit.Parent == nil then return end
a = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
if a ~= nil then
a.Health = 0
end

end
script.Parent.Touched:connect(OnTouch)</ProtectedString>
