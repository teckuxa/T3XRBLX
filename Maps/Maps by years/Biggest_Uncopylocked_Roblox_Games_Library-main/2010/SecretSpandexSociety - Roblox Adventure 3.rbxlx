				<Item class="Script" referent="RBX3238">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">kill</string>
						<ProtectedString name="Source">local debounce = false
script.Parent.BrickColor = script.Parent.co1.Value
script.Parent.Mesh.Offset = Vector3.new(0.5,0,0)

function OnTouch(hit)
a = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
if (a ~= nil) and (debounce == false) then
	debounce = true
	script.Parent.PressSound:Play()
	script.Parent.BrickColor = script.Parent.co2.Value
	script.Parent.Mesh.Offset = Vector3.new(0.8,0,0)
	script.Parent.Parent.AdminDoor.CanCollide = false
	script.Parent.Parent.AdminDoor.Transparency = 1
	wait(21)
	script.Parent.BrickColor = script.Parent.co1.Value
	script.Parent.Mesh.Offset = Vector3.new(0.5,0,0)
	script.Parent.Parent.AdminDoor.CanCollide = true
	script.Parent.Parent.AdminDoor.Transparency = 0
	debounce = false
end
end
script.Parent.Touched:connect(OnTouch)</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
