			<Item class="Script" referent="RBX6582">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">player = script.Parent.Parent.Parent

function onButton1Down(mouse)
	if mouse.Target == nil then return end
	obj=mouse.Target
	pos1=obj.Position
	head=player.Character:findFirstChild(&quot;Head&quot;)
	if head==nil then return end
	pos2=head.Position
	dist=(pos1-pos2).magnitude
	dist=dist-math.max(math.max(obj.Size.x, obj.Size.z), obj.Size.y)
	if dist &lt;15 then
		--Gear Lagoon Characters
		if (obj.Parent.Name == &quot;Geoff&quot;) then
			if (player:findFirstChild(&quot;token1&quot;) == nil) and (player.lose1.Value ~= 1) then
				player.PlayerGui.Talk.geoff_talk1.page1.Visible = true
				elseif (player:findFirstChild(&quot;token1&quot;) ~= nil) and (player.lose1.Value ~= 1) and (player.lose1.Value ~= 2) then 
					player.PlayerGui.Talk.geoff_talk1.page1b.Visible = true
				elseif (player.lose1.Value == 1) or (player.lose1.Value == 2) then
					if (player:findFirstChild(&quot;token5&quot;) == nil) then
						player.lose1.Value = 2
						player.PlayerGui.Talk.geoff_talk1.page4.Visible = true			
					elseif (player:findFirstChild(&quot;token5&quot;) ~= nil) then
						player.PlayerGui.Talk.geoff_talk1.page6.Visible = true
					end
			end
		elseif (obj.Parent.Name == &quot;Joe&quot;) then
			if (player.lose1.Value ~= 2) and (player:findFirstChild(&quot;token5&quot;) == nil) then
				player.PlayerGui.Talk.joe_talk1.page1.Visible = true
			elseif (player.lose1.Value == 2) and (player:findFirstChild(&quot;token5&quot;) == nil) then
				player.PlayerGui.Talk.joe_talk1.page4.Visible = true
				if (player.Backpack:findFirstChild(&quot;JoeNum&quot;) == nil) then
					local prize = script.Parent.JoeNum:clone()
					prize.Parent = player.Backpack
				end
			elseif (player:findFirstChild(&quot;token5&quot;) ~= nil) then 
				player.PlayerGui.Talk.joe_talk1.page6.Visible = true
			end
		elseif (obj.Parent.Name == &quot;Mrs. Loseit&quot;) and (obj.Parent:findFirstChild(&quot;ml1&quot;) ~= nil) then
			if (player:findFirstChild(&quot;token5&quot;) == nil) and (player.Backpack:findFirstChild(&quot;JoeNum&quot;) == nil) then
					player.PlayerGui.Talk.wife_talk1.page1.Visible = true
					player.lose1.Value = 1
			elseif (player.Backpack:findFirstChild(&quot;JoeNum&quot;) ~= nil) and (player:findFirstChild(&quot;token5&quot;) == nil) then
					player.PlayerGui.Talk.wife_talk1.page6.Visible = true
					local gp = player.Backpack:findFirstChild(&quot;JoeNum&quot;)
					if (gp ~= nil) then gp:remove() end
					local t = Instance.new(&quot;ObjectValue&quot;)
					t.Parent = player
					t.Name = &quot;token5&quot;
					player.leaderstats.Tokens.Value = player.leaderstats.Tokens.Value + 1
					local h = player.PlayerGui.Message.msg1
					h.Visible = true
					h.Text = script.Parent.StarDes1.Value
					wait(4)
					h.Visible = false
			elseif (player:findFirstChild(&quot;token5&quot;) ~= nil) then
				player.PlayerGui.Talk.wife_talk1.page7.Visible = true
			end
		elseif (obj.Parent.Name == &quot;dude195&quot;) then
			player.PlayerGui.Talk.dude.page1.Visible = true			
		end
	--Cave of Bad Places Characters
		if (obj.Parent.Name == &quot;Jerry Valdez&quot;) then
			if (player.lose2.Value == 0) or (player.Backpack:findFirstChild(&quot;tix&quot;) == nil) then
					player.PlayerGui.Talk.jerry_talk.page1.Visible = true
					player.lose2.Value = 1
			elseif (player.Backpack:findFirstChild(&quot;tix&quot;) ~= nil) and (player.lose2.Value == 1) then
					player.PlayerGui.Talk.jerry_talk.page5.Visible = true
					player.lose2.Value = 2
					local gp = player.Backpack:findFirstChild(&quot;tix&quot;)
					if (gp ~= nil) then gp:remove() end
			elseif (player.lose2.Value == 2) then
				player.PlayerGui.Talk.jerry_talk.page6.Visible = true
			end
		end

	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	end
end
end

function onSelected(mouse)
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
	mouse.KeyDown:connect(onKeyDown)
end

script.Parent.Selected:connect(onSelected)</ProtectedString>
