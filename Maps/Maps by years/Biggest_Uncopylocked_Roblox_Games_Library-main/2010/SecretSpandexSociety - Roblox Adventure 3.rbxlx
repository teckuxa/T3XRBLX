					<Item class="Script" referent="RBX3009">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">ScriptH</string>
							<ProtectedString name="Source">function sitDown(hit)
	h = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
	if (h ~= nil) and (script.Parent.debounce.Value == false) then
		script.Parent.debounce.Value = true
		script.Parent.Parent.snd.fallsound:Play()
		h.Sit = true
		h.Health = h.Health - 10
		wait(1)
		h.Sit = false
		wait(3)
		script.Parent.debounce.Value = false
	end
end

