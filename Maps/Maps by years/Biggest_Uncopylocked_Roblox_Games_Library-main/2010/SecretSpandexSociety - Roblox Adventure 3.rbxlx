					<Item class="Script" referent="RBX3000">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">function sitDown(hit)
	h = hit.Parent:findFirstChild(&quot;Zombie&quot;)
	if (h ~= nil) and (script.Parent.debounce.Value == false) then
		script.Parent.debounce.Value = true
		script.Parent.Parent.snd.fallsound2:Play()
		h.Sit = true
		h.Health = h.Health - 21
		wait(0.8)
		h.Sit = false
		wait(3)
		script.Parent.debounce.Value = false
	end
end

script.Parent.Touched:connect(sitDown)</ProtectedString>
