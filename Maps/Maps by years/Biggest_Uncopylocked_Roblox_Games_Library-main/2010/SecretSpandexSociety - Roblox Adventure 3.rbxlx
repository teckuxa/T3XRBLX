				</Properties>
				<Item class="Script" referent="RBX3099">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">debounce = false

function onTouch(part) 
	local humanoid = part.Parent:FindFirstChild(&quot;Humanoid&quot;) 
	if (humanoid ~= nil) and (debounce == false) then	-- if a humanoid exists, then
		debounce = true
		local b = script.Parent.Parent:findFirstChild(&quot;Brickwall&quot;)
		if b == nil then return end
		wait(0.5)
		b:remove()
		wait(1)
		local bb = game.Lighting.Brickwall:clone()
		bb.Parent = game.Workspace
		bb:MakeJoints()
		wait(15)
		debounce = false
	end 
end

script.Parent.Touched:connect(onTouch)
</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
