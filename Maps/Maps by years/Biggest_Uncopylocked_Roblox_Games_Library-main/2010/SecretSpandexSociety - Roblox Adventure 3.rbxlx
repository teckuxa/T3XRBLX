			<Item class="Script" referent="RBX2649">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">function onTouched(part)
	h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
		if (h ~= nil) then

			h.Parent:MoveTo(game.Workspace.secret1t.Position)

		end
end

