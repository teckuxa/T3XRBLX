				</Item>
				<Item class="Script" referent="RBX2930">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">local debounce = true

function onTouched(part)
	if (debounce == true) then
	debounce = false
        p = game.Players:playerFromCharacter(part.Parent)
        if p == nil then return end
	gun = script.Parent.tix:clone() --Change WEAPONNAMEHERE to the name of the weapon
        if p.Backpack:findFirstChild(gun.Name) ~= nil then return end
        gun.Parent = p.Backpack
	wait(1)
	debounce = true
	end
end

script.Parent.Touched:connect(onTouched)
</ProtectedString>
