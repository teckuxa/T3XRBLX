			<Item class="Script" referent="RBX7287">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Deteriorate</string>
					<ProtectedString name="Source">healthy = script.Parent:findFirstChild(&quot;Boss&quot;)
debounce = false

while true do
	wait(0.1)
	if (healthy.Health == 0) then
		if (debounce == true) then return end
		debounce = true
		wait(1)
		t = game.Lighting.winportc:Clone()
		t.Parent = game.Workspace
		wait(18)
		script.Parent.Parent.bossweight:remove()
		wait(1)
		game.Workspace.winportc:Remove()
		script.Parent:remove()
	end
end
