							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">local car = script.Parent.Parent.Car:Clone()

while true do 

	wait(5)

	
	local n = script.Parent.Parent:FindFirstChild(&quot;Car&quot;) == nil
	if (n or (script.Parent.Position - script.Parent.Parent.Car.Sled.Position).magnitude &gt; 30) then
		if (n ~= true) then
			script.Parent.Parent.Car.Parent = game.Workspace
		end
		local c = car:Clone()
		c.Parent = script.Parent.Parent
		c:makeJoints()
	end

end</ProtectedString>
