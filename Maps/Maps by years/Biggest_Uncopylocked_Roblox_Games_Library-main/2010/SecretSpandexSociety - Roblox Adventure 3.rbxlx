					thisplr.Checkpoint.Value = Vector3.new(-1,-1,-1)
					thisplr.leaderstats.Tokens.Value = thisplr.leaderstats.Tokens.Value + 1
					local c = Instance.new(&quot;ObjectValue&quot;)
