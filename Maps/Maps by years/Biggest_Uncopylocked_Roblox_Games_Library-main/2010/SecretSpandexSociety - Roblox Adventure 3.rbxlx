						<string name="Name">Script</string>
						<ProtectedString name="Source">script.Parent.BodyPosition.position = script.Parent.Position
script.Parent:MakeJoints()
script.Parent.Anchored = false

while true do
wait(0.2)
script.Parent.RotVelocity = Vector3.new(0,-2,0)
script.Parent.CFrame = script.Parent.CFrame * CFrame.fromEulerAnglesXYZ(0,-0.2,0)
end
</ProtectedString>
