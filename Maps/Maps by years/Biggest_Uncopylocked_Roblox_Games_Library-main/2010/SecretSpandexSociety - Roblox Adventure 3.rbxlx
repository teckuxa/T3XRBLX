				<Item class="Script" referent="RBX4462">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">CoinScript</string>
						<ProtectedString name="Source">local debounce = true
one = &quot;bluecoin2a&quot;
two = &quot;bluecoin2b&quot;
three = &quot;bluecoin2c&quot;

function onTouched(part)
	local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if (h~=nil) then
		local thisplr = game.Players:findFirstChild(h.Parent.Name)
		if (thisplr~=nil) then
				local cash = thisplr:findFirstChild(script.Parent.Parent.Name)
				if (cash ~= nil) and (debounce == true) then
					debounce = false
					local h = thisplr.PlayerGui.Message.msg1
					h.Visible = true
					h.Text = &quot;You already got this blue coin.&quot;
					wait(4)
					h.Visible = false
					debounce = true
				else if (cash == nil) and (debounce == true) then
					debounce = false
					thisplr.bluecoins.Value = thisplr.bluecoins.Value + 1
					local c = Instance.new(&quot;ObjectValue&quot;)
					c.Parent = thisplr
					c.Name = script.Parent.Parent.Name
			if (thisplr:findFirstChild(one) ~= nil) and (thisplr:findFirstChild(two) ~= nil) and (thisplr:findFirstChild(three) ~= nil) and (thisplr.coins2.Value == false) then
				thisplr.coins2.Value = true
				local tokens = thisplr.leaderstats.Tokens
				tokens.Value = tokens.Value + 1
						local b = game:GetService(&quot;BadgeService&quot;)
						b:AwardBadge(thisplr.userId, script.Parent.BadgeID.Value)
					local h = thisplr.PlayerGui.Message.msg1
					h.Visible = true
					h.Text = &quot;You got the 3 coins and earned a token!&quot;
					wait(4)
					h.Visible = false
					debounce = true
				else
					local h = thisplr.PlayerGui.Message.msg1
					h.Visible = true
					h.Text = script.Parent.Parent.StarDes.Value
					wait(4)
					h.Visible = false
					debounce = true
				end
				end
		end
	end
end
end

