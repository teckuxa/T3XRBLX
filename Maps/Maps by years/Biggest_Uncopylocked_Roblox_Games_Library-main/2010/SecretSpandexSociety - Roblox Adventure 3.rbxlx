				<Item class="Script" referent="RBX7233">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">local debounce = false

function OnTouch(hit)
if hit.Parent == nil then return end
a = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
if a ~= nil and debounce == false then
	debounce = true
	script.Parent.Sound:Play()
	script.Parent.Parent.Boss.Health = script.Parent.Parent.Boss.Health - 1
	a.Parent.Torso.Velocity = Vector3.new(96,96,96)
	script.Parent.BrickColor = script.Parent.hurt.Value
	wait(8)
	script.Parent.BrickColor = script.Parent.nothurt.Value
	debounce = false
end
end
script.Parent.Touched:connect(OnTouch)</ProtectedString>
