								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<ProtectedString name="Source">local c = script.Parent.Parent.Parent.RedBlocks:GetChildren()
local debounce = false

function OnTouch(hit)
if hit.Parent == nil then return end
a = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
if a ~= nil and debounce == false then
	debounce = true
	for i=1,#c do
		if (c[i].className == &quot;Part&quot;) then
			c[i].Transparency = 0
			c[i].CanCollide = true
		end
	end
	script.Parent.Mesh.Offset = Vector3.new(0,-1.4,0)
	wait(16)
	script.Parent.Mesh.Offset = Vector3.new(0,-1,0)
	debounce = false
	for i=1,#c do
		if (c[i].className == &quot;Part&quot;) then
			c[i].Transparency = 1
			c[i].CanCollide = false
		end
	end
end
end
script.Parent.Touched:connect(OnTouch)</ProtectedString>
