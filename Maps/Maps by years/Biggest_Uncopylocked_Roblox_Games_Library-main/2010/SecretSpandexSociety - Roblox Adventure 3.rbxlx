				<Item class="Script" referent="RBX6348">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">local debounce = false

function onTouched(hit)
if (hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil) and (debounce == false) then
	debounce = true
	script.Parent.Color = script.Parent.co2.Value
	wait(1.5)
	script.Parent.BodyPosition.position = Vector3.new(script.Parent.BodyPosition.position.x,script.Parent.BodyPosition.position.y-6,script.Parent.BodyPosition.position.z)
	script.Parent.Color = script.Parent.co3.Value
	wait(2.5)
	script.Parent.BodyPosition.position = Vector3.new(script.Parent.BodyPosition.position.x,script.Parent.BodyPosition.position.y+6,script.Parent.BodyPosition.position.z)
	script.Parent.Color = script.Parent.co1.Value
	wait(1)
	debounce = false
end 
end
script.Parent.Touched:connect(onTouched) 
</ProtectedString>
