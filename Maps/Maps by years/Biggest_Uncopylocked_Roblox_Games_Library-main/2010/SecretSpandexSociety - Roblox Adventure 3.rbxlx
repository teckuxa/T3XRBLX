							<ProtectedString name="Source">local car = script.Parent.Parent.SpeedPower:Clone()

while true do 

	wait(2.33)

	
	local n = script.Parent.Parent:FindFirstChild(&quot;SpeedPower&quot;) == nil
		if (n == true) then
		local c = car:Clone()
		c.Parent = script.Parent.Parent
	end

end
