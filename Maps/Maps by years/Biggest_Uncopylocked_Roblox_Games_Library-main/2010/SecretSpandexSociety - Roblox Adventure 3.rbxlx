				<Item class="Script" referent="RBX6881">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Distance</string>
						<ProtectedString name="Source">player = script.Parent.Parent.Parent.Parent
obj = game.Workspace:findFirstChild(&quot;Mrs. Loseit&quot;).Head
print(player.Name)

while true do
	wait(2)
	pos1=obj.Position
	head=player.Character:findFirstChild(&quot;Head&quot;)
	if head==nil then return end
	pos2=head.Position
	dist=(pos1-pos2).magnitude
	dist=dist-math.max(math.max(obj.Size.x, obj.Size.z), obj.Size.y)
	if dist &gt;32 then
		script.Parent.page1.Visible = false
		script.Parent.page2.Visible = false
		script.Parent.page3.Visible = false
		script.Parent.page4.Visible = false
		script.Parent.page5.Visible = false
		script.Parent.page6.Visible = false
		script.Parent.page7.Visible = false
	end
end
</ProtectedString>
