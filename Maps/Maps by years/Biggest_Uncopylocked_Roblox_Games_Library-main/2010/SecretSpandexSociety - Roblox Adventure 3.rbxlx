						<Item class="Script" referent="RBX1744">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Drive</string>
								<ProtectedString name="Source">MaxSpeed=34
engine = script.Parent.Parent.Part

function check()
	if (script.Parent.Throttle==1) then
	script.Parent.Parent.Part.BodyVelocity.velocity=engine.CFrame.lookVector*MaxSpeed
	elseif (script.Parent.Throttle==0) then
	script.Parent.Parent.Part.BodyVelocity.velocity=Vector3.new(0,0,0)
	elseif(script.Parent.Throttle==-1) then
	script.Parent.Parent.Part.BodyVelocity.velocity=engine.CFrame.lookVector*-MaxSpeed/2
	end
	if (script.Parent.Steer==-1) then
		script.Parent.Parent.Part.BodyGyro.cframe=script.Parent.CFrame*CFrame.fromEulerAnglesXYZ(0,math.pi/50,0)
		elseif (script.Parent.Steer==1) then
		script.Parent.Parent.Part.BodyGyro.cframe=script.Parent.CFrame*CFrame.fromEulerAnglesXYZ(0,math.pi/-50,0)
	end
end

while true do
	wait()
	if (script.Parent.Anchored == false) then
	check()
	end
end
</ProtectedString>
