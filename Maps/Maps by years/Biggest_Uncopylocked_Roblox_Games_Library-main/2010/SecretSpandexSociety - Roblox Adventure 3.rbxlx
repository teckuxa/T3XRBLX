				<Properties>
					<string name="Name">StarDes1</string>
					<string name="Value">You got &quot;Token 5: Wooing the Widow&quot;</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="StringValue" referent="RBX6581">
				<Properties>
					<string name="Name">StarDes2</string>
					<string name="Value">You got &quot;Token 4: Very Important Person&quot;</string>
