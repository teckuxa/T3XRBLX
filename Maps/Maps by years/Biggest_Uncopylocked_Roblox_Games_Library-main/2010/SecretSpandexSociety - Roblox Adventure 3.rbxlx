					<Item class="Script" referent="RBX3921">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">FindScript</string>
							<ProtectedString name="Source">bin = script.Parent
debounce = false
bin.BodyPosition.position = script.Parent.Position
bin.BodyGyro.cframe = bin.CFrame

function findNearestTorso(pos)
	local list = game.Workspace:GetChildren()
	local torso = nil
	local dist = 42
	local temp = nil
	local human = nil
	local temp2 = nil
	for x = 1, #list do
		temp2 = list[x]
		if (temp2.className == &quot;Model&quot;) and (temp2 ~= script.Parent) then
			temp = temp2:findFirstChild(&quot;Torso&quot;)
			human = temp2:findFirstChild(&quot;Humanoid&quot;)
			if (temp ~= nil) and (human ~= nil) and (human.Health &gt; 0) then
				if (temp.Position - pos).magnitude &lt; dist then
					torso = temp
					dist = (temp.Position - pos).magnitude
				end
			end
		end
	end
	return torso
end

while true do
	local torso = findNearestTorso(bin.Position)
	if torso~=nil then
		script.Parent.Parent.canfire.Value = true
	else script.Parent.Parent.canfire.Value = false
		bin.face.Texture = &quot;http://www.roblox.com/asset/?id=21298213&quot;
	end
	wait()
end

</ProtectedString>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
					<Item class="Script" referent="RBX3922">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">ThwompScript</string>
							<ProtectedString name="Source">face2 = &quot;http://www.roblox.com/asset/?id=21298223&quot;
face3 = &quot;http://www.roblox.com/asset/?id=21298233&quot;
wait(3)
script.Parent.Anchored = false

while true do
wait(0.1)
if (script.Parent.Parent.canfire.Value == true) then
	script.Parent.face.Texture = face2
	wait(1)
	script.Parent.BodyPosition.position = Vector3.new(script.Parent.BodyPosition.position.x,script.Parent.BodyPosition.position.y-32,script.Parent.BodyPosition.position.z)
	script.Parent.face.Texture = face3
	wait(2)
	script.Parent.BodyPosition.position = Vector3.new(script.Parent.BodyPosition.position.x,script.Parent.BodyPosition.position.y+32,script.Parent.BodyPosition.position.z)
	if (script.Parent.Parent.canfire.Value == true) then
		script.Parent.face.Texture = face2
	end
	wait(1.2)
end
wait(0.1)
end
</ProtectedString>
