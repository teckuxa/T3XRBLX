					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">while true do
cbr = math.random(1,3)
wait(2)
if (cbr == 1) then game.Lighting.cballs.cannonball1:clone().Parent = game.Workspace
elseif (cbr == 2) then game.Lighting.cballs.cannonball2:clone().Parent = game.Workspace
else game.Lighting.cballs.cannonball3:clone().Parent = game.Workspace
end
end
</ProtectedString>
