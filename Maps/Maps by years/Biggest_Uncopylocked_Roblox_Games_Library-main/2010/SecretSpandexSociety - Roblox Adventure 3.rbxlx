							<string name="Name">Speed</string>
							<ProtectedString name="Source">wait()
script.Sound1.Parent = script.Parent.Torso
wait(0.1)
script.Sound2.Parent = script.Parent.Torso
script.Parent.Humanoid.WalkSpeed = 42
script.Parent.Torso.Sound1:Play()
if (script.Parent.Torso:findFirstChild(&quot;sparkle&quot;) == nil) then
local s = script.sparkle:clone()
s.Name = &quot;sparkle&quot;
s.Parent = script.Parent.Torso
s.Enabled = true
end
wait(6)
script.Parent.Torso.sparkle.SparkleColor = script.sc2.Value
wait(2.5)
script.Parent.Torso.sparkle.SparkleColor = script.sc3.Value
wait(1.5)
script.Parent.Torso.Sound2:Play()
wait(0.05)
script.Parent.Humanoid.WalkSpeed = 20
if script == nil then return end
script.Parent.Torso.sparkle:Remove()
script.Parent.powerup:Remove()
script.Parent.Torso.Sound1:Remove()
script.Parent.Torso.Sound2:Remove()
script:Remove()</ProtectedString>
