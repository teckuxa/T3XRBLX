			<Item class="Script" referent="RBX3606">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">deb = false

function vaporize(player)
mo = Instance.new(&quot;Model&quot;)
mo.Parent = workspace
mo.Name = &quot;Burn&quot;
local childs = game.Players[player.Name].Character:GetChildren()
for i=1,#childs do
if (childs[i].className == &quot;Part&quot;) then
--colors[i] = childs[i].BrickColor
childs[i].BrickColor = BrickColor.new(26)
childs[i].CanCollide = true
childs[i].Anchored = true
end
if (childs[i].Name == &quot;Head&quot;) then
local mm = childs[i]:FindFirstChild(&quot;Mesh&quot;)
if (mm ~= nil) then
mm:Remove()
end
skull = Instance.new(&quot;SpecialMesh&quot;)
skull.MeshType = &quot;FileMesh&quot;
skull.MeshId = &quot;http://www.roblox.com/asset/?id=4770583&quot;
skull.TextureId = &quot;http://www.roblox.com/asset/?id=4770560&quot;
skull.Scale = Vector3.new(3.2,3.2,3.2)
skull.Parent = childs[i]
childs[i].Anchored = false
end
end
wait(.25)
local limit = 1
for i=1,#childs do
if (childs[i].className == &quot;Part&quot; and childs[i].Name ~= &quot;Head&quot;) then
for n=0,limit do
local p = Instance.new(&quot;Part&quot;)
p.formFactor = 2
p.Size = Vector3.new(1,.4,1)
p.BrickColor = BrickColor.new(26)
p.Material = Enum.Material.Concrete
p.TopSurface = 0
p.BottomSurface = 0
p.CFrame = childs[i].CFrame + Vector3.new(0,n,0)
childs[i]:Remove()
p.Parent = mo
--debris:AddItem(p, 60)
--debris:AddItem(p, 60)
end
end
end
end

function onTouch(part)
if part.Parent:findFirstChild(&quot;Humanoid&quot;) then
if deb == false then
deb = true
print(&quot;touched&quot;)
--wait(5)
script.Parent.Transparency = 0.4
vaporize(part.Parent)
wait(1)
script.Parent.Transparency = 1
deb = false
end
end
end
script.Parent.Touched:connect(onTouch)
</ProtectedString>
