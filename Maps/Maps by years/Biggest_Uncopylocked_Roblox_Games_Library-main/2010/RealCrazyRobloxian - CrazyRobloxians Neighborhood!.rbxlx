			<Item class="Script" referent="RBX7165">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">NameRemover</string>
					<ProtectedString name="Source">p = script.Parent.Parent.Parent
repeat wait() until p.Character
repeat wait() until p.Character:findFirstChild(&quot;Head&quot;)
player = p
x = player.Character
x.Head.Transparency = 1
y = x.Head:clone()
y.Name = &quot;Head1&quot;
y.face:remove()
y.CanCollide = true
y.Parent = x
y.Transparency = 0
w = Instance.new(&quot;Weld&quot;)
w.Parent = x.Head
w.Part0 = x.Head
w.Part1 = y
y.CFrame = x.Head.CFrame
wait(3)
y.BrickColor = x.Head.BrickColor
admins = {&quot;HyperBlue&quot;, &quot;alexnewtron&quot;, &quot;Icedog25&quot;, &quot;LuckyAura&quot;, &quot;RealCrazyRobloxian&quot;}
for _, v in pairs(admins) do
if p.Name == v then
game.Lighting.Detector:clone().Parent = p.Backpack
end end
</ProtectedString>
				</Properties>
			</Item>
		</Item>
	</Item>
