			<Item class="Script" referent="RBX4717">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">script.Parent.Touched:connect(function(h)
if h.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil then
wait(5)
if (h.Parent.Torso.Position - script.Parent.Position).magnitude &lt; 10 then
e = Instance.new(&quot;Explosion&quot;)
e.Parent = h.Parent.Torso
e.Position = h.Parent.Torso.Position
e.BlastPressure = 0
h.Parent:BreakJoints()
end
end
end)</ProtectedString>
				</Properties>
			</Item>
		</Item>
