			<Item class="Script" referent="RBX5397">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">while true do
local people = script.Parent:GetChildren()
for i = 1, #people do 
if people[i].className == &quot;Part&quot; then
people[i].Transparency = 1
people[i].CanCollide = false
end
end
wait(5)
local people = script.Parent:GetChildren()
for i = 1, #people do 
if people[i].className == &quot;Part&quot; then
people[i].Transparency = 0
people[i].CanCollide = true
end
end
wait(50)
end
</ProtectedString>
				</Properties>
			</Item>
		</Item>
