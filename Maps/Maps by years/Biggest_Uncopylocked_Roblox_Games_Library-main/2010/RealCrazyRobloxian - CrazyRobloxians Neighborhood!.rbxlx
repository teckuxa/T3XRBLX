				<Item class="Script" referent="RBX817">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">value = script.Parent.Parent.Number

function OnClicked()
if value.Value ==-1 then
value.Value = 0
script.Parent.Parent.Name = &quot;click my head&quot;
elseif value.Value == 0 then 
value.Value = 1
script.Parent.Parent.Name = &quot;RAN RAN RUUUUUUUU&quot;
elseif value.Value == 1 then 
value.Value = 2
script.Parent.Parent.Name = &quot;Donaldo riskanando, threeasunda&quot;
elseif value.Value == 2 then 
value.Value = 3
script.Parent.Parent.Name = &quot;mindavoiceavinoino. vio?&quot;
elseif value.Value == 3 then 
value.Value = 4
script.Parent.Parent.Name = &quot;RAN RAN RUUUUUUUUUUUUUUUUUU!&quot;

end

script.Parent.ClickDetector.MouseClick:connect(OnClicked)</ProtectedString>
					</Properties>
				</Item>
