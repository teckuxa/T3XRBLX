				<Item class="Script" referent="RBX4785">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">visible = true
function onClicked()
&#9;if visible == true then
&#9;&#9;visible = false
&#9;&#9;local people = script.Parent.Parent:GetChildren()
&#9;&#9;&#9;for i = 1, #people do 
&#9;&#9;&#9;&#9;people[i].Transparency = 1
&#9;&#9;&#9;&#9;people[i].CanCollide = false
&#9;&#9;&#9;end
&#9;elseif visible == false then
&#9;&#9;visible = true
&#9;&#9;local people = script.Parent.Parent:GetChildren()
&#9;&#9;&#9;for i = 1, #people do 
&#9;&#9;&#9;&#9;if people[i].Name == &quot;Part&quot; then
&#9;&#9;&#9;&#9;&#9;people[i].Transparency = 0
&#9;&#9;&#9;&#9;&#9;people[i].CanCollide = true
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;people[i].CanCollide = true
&#9;&#9;&#9;end
&#9;end
end
script.Parent.ClickDetector.MouseClick:connect(onClicked)
</ProtectedString>
					</Properties>
				</Item>
			</Item>
