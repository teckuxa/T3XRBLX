		<Item class="HopperBin" referent="RBX7184">
			<Properties>
				<bool name="Active">false</bool>
				<token name="BinType">0</token>
				<string name="Name">CF.Move.{+x}.1</string>
				<Content name="TextureId"><null></null></Content>
			</Properties>
			<Item class="Script" referent="RBX7185">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">bin = script.Parent 
local n = 1 
local n2 = 1 
local modes = { &quot;x&quot;, &quot;y&quot;, &quot;z&quot; } 
local choices = { &quot;+&quot;, &quot;-&quot; } 
local power = 1 
local Mode = &quot;Move&quot; 

function checkForMode(item) 
if modes[item] == modes[n] then 
if choices[n2] == &quot;+&quot; then 
return modes[item + 1] 
end 
if choices[n2] == &quot;-&quot; then 
return modes[item - 1] 
end 
end 
end 

function update() 
script.Parent.Name = &quot;CF.&quot; .. Mode .. &quot;.{&quot; .. choices[n2] .. modes[n] .. &quot;}.&quot; .. power 
end 
update() 

function onClicked(mouse) 
local player = bin.Parent.Parent 
if player == nil then return end 
local target = mouse.Target 
if target == nil then return end 
target.CFrame = target.CFrame + Vector3.new(checkForMode(&quot;x&quot;), checkForMode(&quot;y&quot;), checkForMode(&quot;z&quot;)) 
if Mode == &quot;Move&quot; then 
if n == 1 and n2 == 1 then 
target.CFrame = target.CFrame + Vector3.new(power,0,0) 
else 
if n == 1 and n2 == 2 then 
target.CFrame = target.CFrame + Vector3.new(-(power),0,0) 
else 
if n == 2 and n2 == 1 then 
target.CFrame = target.CFrame + Vector3.new(0,power,0) 
else 
if n == 2 and n2 == 2 then 
target.CFrame = target.CFrame + Vector3.new(0,-(power),0) 
else 
if n == 3 and n2 == 1 then 
target.CFrame = target.CFrame + Vector3.new(0,0,power) 
else 
if n == 3 and n2 == 2 then 
target.CFrame = target.CFrame + Vector3.new(0,0,-(power)) 
end 
end 
end 
end 
end 
end 
else 
if Mode == &quot;Rotate&quot; then 
if n == 1 and n2 == 1 then 
target.CFrame = target.CFrame * CFrame.fromEulerAnglesXYZ(power,0,0) 
else 
if n == 1 and n2 == 2 then 
target.CFrame = target.CFrame * CFrame.fromEulerAnglesXYZ(-(power),0,0) 
else 
if n == 2 and n2 == 1 then 
target.CFrame = target.CFrame * CFrame.fromEulerAnglesXYZ(0,power,0) 
else 
if n == 2 and n2 == 2 then 
target.CFrame = target.CFrame * CFrame.fromEulerAnglesXYZ(0,-(power),0) 
else 
if n == 3 and n2 == 1 then 
target.CFrame = target.CFrame * CFrame.fromEulerAnglesXYZ(0,0,power) 
else 
if n == 3 and n2 == 2 then 
target.CFrame = target.CFrame * CFrame.fromEulerAnglesXYZ(0,0,-(power)) 
end 
end 
end 
end 
end 
end 
end 
end 
end 

function onKeyDown(key,mouse) 
if key == nil then return end 
key = key:lower() 
if key == &quot;t&quot; then 
if Mode == &quot;Move&quot; then 
Mode = &quot;Rotate&quot; 
update() 
else 
if Mode == &quot;Rotate&quot; then 
Mode = &quot;Move&quot; 
update() 
end 
end 
end 
if key == &quot;q&quot; then 
if power == 1 then 
power = .2 
update() 
else 
power = power - 1 
update() 
end 
end 
if key == &quot;e&quot; then 
if power == .2 then 
power = 1 
update() 
else 
power = power + 1 
update() 
end 
end 
if key == &quot;z&quot; then 
if n == 1 then 
n = 3 
update() 
else 
n = n - 1 
update() 
end 
end 
if key == &quot;x&quot; then 
if n == 3 then 
n = 1 
update() 
else 
n = n + 1 
update() 
end 
end 
if key == &quot;f&quot; then 
local target = mouse.Target 
if not target then 
return nil 
end 
target.CFrame = CFrame.new(target.Position) 
end 
if key == &quot;n&quot; then 
if n2 == 1 then 
n2 = 2 
update() 
else 
n2 = n2 - 1 
update() 
end 
end 
if key == &quot;t&quot; then 
if n2 == 2 then 
n2 = 1 
update() 
else 
n2 = n2 + 1 
update() 
end 
end 
end 

function onSelected(mouse) 
mouse.Icon = &quot;rbxasset://Textures\\GunCursor.png&quot; 
mouse.Button1Down:connect(function() onClicked(mouse) end) 
mouse.KeyDown:connect(function(key) onKeyDown(key,mouse) end) 
end 

bin.Selected:connect(onSelected) </ProtectedString>
