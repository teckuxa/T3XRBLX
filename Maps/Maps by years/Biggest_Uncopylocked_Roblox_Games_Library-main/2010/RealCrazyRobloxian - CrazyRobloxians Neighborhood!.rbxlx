&#9;&#9;subitem.Text = &quot;[none]&quot;
&#9;&#9;subitem.TextWrap = true
&#9;&#9;subitem.TextXAlignment = Enum.TextXAlignment.Left
&#9;&#9;subitem.BorderSizePixel = 0
