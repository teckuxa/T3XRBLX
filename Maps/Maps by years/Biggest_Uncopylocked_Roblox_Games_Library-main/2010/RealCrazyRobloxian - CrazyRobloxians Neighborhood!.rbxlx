end

function mode5()
--reg
script.Parent.Color = Color3.new(math.random(),math.random(),math.random())
wait(1)
mode5()
end

function mode6()
--slow
script.Parent.Color = Color3.new(math.random(),math.random(),math.random())
wait(5)
mode6()
end

function mode7()
--slowest
-- ONLY ONE MODE AT A TIME, LOLOLOLOL
script.Parent.Color = Color3.new(math.random(),math.random(),math.random())
wait(10)
mode7()
end

function mode8()
--blacknwhite
