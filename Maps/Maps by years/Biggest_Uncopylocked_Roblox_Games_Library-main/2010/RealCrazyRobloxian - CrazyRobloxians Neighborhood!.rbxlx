		<Item class="Script" referent="RBX4730">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">PlayerEnter</string>
				<ProtectedString name="Source">function onEnter(player)

s = script.Spawn:Clone()
s.Disabled = false
s.name.Value = player.Name
s.Parent = workspace
wait(.5)
p = script.Spawn.PWNED:Clone()
p.Disabled = false
p.Parent = player.Character


--if player.Name == &quot;asimo3089&quot; then
--player:remove()
--m = Instance.new(&quot;Message&quot;)
--m.Parent = workspace
--m.Text = &quot;PWNED!&quot;
--wait(5)
--m:remove()
--end

end
game.Players.ChildAdded:connect(onEnter)</ProtectedString>
			</Properties>
			<Item class="Script" referent="RBX4731">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Spawn</string>
					<ProtectedString name="Source">function onSpawn()

s = script.PWNED:clone()
s.Disabled = false
s.Parent = game.Players[script.name.Value].Character

end
game.Players[script.name.Value].CharacterAdded:connect(onSpawn)</ProtectedString>
				</Properties>
				<Item class="StringValue" referent="RBX4732">
					<Properties>
						<string name="Name">name</string>
						<string name="Value"></string>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX4733">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">PWNED</string>
						<ProtectedString name="Source">Character = script.Parent
human = script.Parent.Humanoid

function onDied()

p = game.Lighting.PWNED:Clone()
p.Parent = game.Players[Character.Name].PlayerGui


end
human.Died:connect(onDied)</ProtectedString>
					</Properties>
				</Item>
			</Item>
