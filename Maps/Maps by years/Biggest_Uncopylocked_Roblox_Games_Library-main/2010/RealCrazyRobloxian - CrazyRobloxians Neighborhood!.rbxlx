					<Item class="Script" referent="RBX10902">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Operation</string>
							<ProtectedString name="Source">local x = script.Parent
local kill = x.KILL
local kick = x.KICK
local obj = x.OBJ

kill.MouseButton1Down:connect(function()
if game.Players:playerFromCharacter(obj.Value) then
local p = game.Players:playerFromCharacter(obj.Value)
p.Character:BreakJoints()
end
local k = obj.Value
k:BreakJoints()
end)

kick.MouseButton1Down:connect(function()
if game.Players:playerFromCharacter(obj.Value) then
local p = game.Players:playerFromCharacter(obj.Value)
p.Character:BreakJoints()
end
end)</ProtectedString>
						</Properties>
					</Item>
				</Item>
			</Item>
			<Item class="Script" referent="RBX10903">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Operator</string>
					<ProtectedString name="Source">local bin = script.Parent
local x = script.Parent.Parent.Parent
local n = bin.NameDetector
local o = n.Operator
local obj = o.OBJ
local na = o.NAME
local cl = o.CLASS
repeat wait() until x:findFirstChild(&quot;PlayerGui&quot;)
local p = x:findFirstChild(&quot;PlayerGui&quot;)
local nd = &quot;NameDetector&quot;

function D(mouse)
t = mouse.Target
if t then
if p:findFirstChild(nd) then
p:findFirstChild(nd):remove()
end
obj.Value = t
na.Text = &quot;Name: &quot;..t.Name
cl.Text = &quot;Class: &quot;..tostring(t.className)
n:clone().Parent = p
end end


bin.Selected:connect(function(mouse)
mouse.Button1Down:connect(function() D(mouse) end)
end)

bin.Deselected:connect(function(mouse)
if p:findFirstChild(nd) then
p:findFirstChild(nd):remove()
end
end)</ProtectedString>
				</Properties>
			</Item>
		</Item>
	</Item>
