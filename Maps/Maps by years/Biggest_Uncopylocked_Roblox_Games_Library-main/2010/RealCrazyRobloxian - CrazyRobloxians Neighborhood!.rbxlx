						<Item class="Script" referent="RBX5294">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<ProtectedString name="Source">script.Parent.Touched:connect(function(h)
if h.Parent:findFirstChild(&quot;Humanoid&quot;) and script.Parent.Parent.Seat:findFirstChild(&quot;Fly&quot;) == nil then
game.Lighting.Fly:clone().Parent = script.Parent.Parent.Seat
script.Parent.Parent.Smoke1.Smoke.Size = 100
script.Parent.Parent.Smoke2.Smoke.Size = 100
--script.Parent.Parent.Smoke2.Smoke.Color = Color3.new(255/255,102/255,0/255)
wait(10)
e = Instance.new(&quot;Explosion&quot;)
e.Parent = script.Parent.Parent.Seat
e.BlastRadius = 9000
e.Position = script.Parent.Parent.Seat.Position
wait(5)
n = game.Lighting.Shuttle:Clone()
n.Parent = workspace
n:MakeJoints()
script.Parent.Parent.Parent.Parent:remove()
end
end)</ProtectedString>
							</Properties>
						</Item>
					</Item>
