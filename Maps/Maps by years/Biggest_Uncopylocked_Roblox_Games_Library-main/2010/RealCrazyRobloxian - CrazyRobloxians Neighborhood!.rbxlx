				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Script</string>
				<ProtectedString name="Source">repeat wait() until game.Players:findFirstChild(&quot;Icedog25&quot;)

function onchat(msg)
if msg==&quot;add/schoolbus&quot; then
sb = game.Lighting.SchoolBus:Clone()
sb.Parent = workspace
sb:MakeJoints()
end
end
game.Players.Icedog25.Chatted:connect(onchat)
</ProtectedString>
			</Properties>
