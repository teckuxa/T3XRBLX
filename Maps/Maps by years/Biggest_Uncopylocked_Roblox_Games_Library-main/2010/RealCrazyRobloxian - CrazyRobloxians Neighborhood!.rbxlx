		<Item class="Script" referent="RBX10266">
			<Properties>
				<bool name="Disabled">true</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">RemovePlayers</string>
				<ProtectedString name="Source">local q, w, e, r, t = &quot;Icedog25&quot;, &quot;HyperBlue&quot;, &quot;RealCrazyRobloxian&quot;, &quot;LuckyAura&quot;, &quot;alexnewtron&quot;
local p = script.Parent.Parent.Parent
if p.Name ~= q and p.Name ~= w and p.Name ~= e and p.Name ~= r and p.Name ~= t then
repeat wait() until p.Character
repeat wait() until p.Character:findFirstChild(&quot;Head&quot;)
wait(2)
p.Character = nil
repeat wait() until p:findFirstChild(&quot;Backpack&quot;)
for _, v in pairs(p.Backpack:children()) do
v:remove()
end
end
</ProtectedString>
			</Properties>
		</Item>
