						<ProtectedString name="Source">local Tool = script.Parent;

enabled = true




function onActivated()
&#9;if not enabled  then
&#9;&#9;return
&#9;end

&#9;enabled = false
&#9;Tool.GripForward = Vector3.new(-0.707,-0,-0.707)
&#9;Tool.GripPos = Vector3.new(-0.75,-1.5,0)
&#9;Tool.GripRight = Vector3.new(0,-1,0)
&#9;Tool.GripUp = Vector3.new(0.707,0,-0.707)


&#9;Tool.Handle.DrinkSound:Play()

&#9;wait(3)
&#9;
&#9;local h = Tool.Parent:FindFirstChild(&quot;Humanoid&quot;)
&#9;if (h ~= nil) then
&#9;&#9;if (h.MaxHealth &gt; h.Health + 5) then
&#9;&#9;&#9;h.Health = h.Health + 5
&#9;&#9;else&#9;
&#9;&#9;&#9;h.Health = h.MaxHealth
&#9;&#9;end
&#9;end

&#9;Tool.GripForward = Vector3.new(0,-0,-1)
&#9;Tool.GripPos = Vector3.new(0,0,0.2)
&#9;Tool.GripRight = Vector3.new(0,-1,0)
&#9;Tool.GripUp = Vector3.new(1,0,0)

&#9;wait(1)
&#9;--explode em for fun
&#9;ex = Instance.new(&quot;Explosion&quot;)
&#9;ex.Parent = Tool.Parent
&#9;ex.Position = Tool.Parent.Torso.Position
&#9;Tool.Parent.Humanoid.Health = 0

&#9;enabled = true

end

function onEquipped()
&#9;Tool.Handle.OpenSound:play()
end

script.Parent.Activated:connect(onActivated)
script.Parent.Equipped:connect(onEquipped)
