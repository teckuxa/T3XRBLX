			<Item class="Script" referent="RBX5850">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">deb = 0
function onTouch(part)
if deb == 0 then
if part.Parent:findFirstChild(&quot;Humanoid&quot;) then
deb = 1
script.Parent.Transparency = 0.1
wait()
script.Parent.Transparency = 0.2
wait()
script.Parent.Transparency = 0.3
wait()
script.Parent.Transparency = 0.4
wait()
script.Parent.Transparency = 0.5
wait()
script.Parent.Transparency = 0.6
wait()
script.Parent.Transparency = 0.7
wait()
script.Parent.Transparency = 0.8
wait()
script.Parent.Transparency = 0.9
wait()
script.Parent.Transparency = 1
wait(5)
deb = 0
script.Parent.Transparency = 0
end
end
end
script.Parent.Touched:connect(onTouch)</ProtectedString>
				</Properties>
			</Item>
		</Item>
