				<Item class="Script" referent="RBX5640">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Fountain 1</string>
						<ProtectedString name="Source">local lifetime = 0.6

while true do
&#9;wait(.1)
&#9;local pos = script.Parent
&#9;local b = Instance.new(&quot;Part&quot;)&#9;

&#9;b.Position = pos.Position + pos.CFrame.lookVector
&#9;b.Size = Vector3.new(1, 1, 1)
&#9;b.Shape = 0
&#9;b.Material = &quot;Ice&quot;
        b.BrickColor=BrickColor.new(&quot;Bright blue&quot;)
&#9;b.Transparency = 0.3
&#9;b.TopSurface = &quot;Smooth&quot;
&#9;b.BottomSurface = &quot;Smooth&quot;
&#9;b.CanCollide = true
&#9;b.Parent = game.Workspace
&#9;b.Velocity = Vector3.new(1, 75, 1)
&#9;game:GetService(&quot;Debris&quot;):AddItem(b, lifetime)
end
</ProtectedString>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX5641">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Fountain 2</string>
						<ProtectedString name="Source">bin = script.Parent

function onTouched(part)
&#9;part.BrickColor = BrickColor.new(26)
&#9;wait(.3)
&#9;part.Transparency = .2
&#9;wait(.1)
&#9;part.Transparency = .4
&#9;wait(.1)
&#9;part.Transparency = .6
&#9;wait(.1)
&#9;part.Transparency = .8
&#9;wait(.1)
&#9;part.Parent = nil
end

connection = bin.Touched:connect(onTouched)
</ProtectedString>
					</Properties>
				</Item>
			</Item>
