							<string name="Name">RocketScript</string>
							<ProtectedString name="Source">r = game:service(&quot;RunService&quot;)

shaft = script.Parent
position = shaft.Position

function fly()
	direction = shaft.CFrame.lookVector 
	position = position + 35*direction
	error = position - shaft.Position
	shaft.Velocity = 5*error
end

function blow(hit)
	swoosh:stop()
	explosion = Instance.new(&quot;Explosion&quot;)
	explosion.Position = shaft.Position
	explosion.BlastRadius = 7

	-- find instigator tag
	local creator = script.Parent:findFirstChild(&quot;creator&quot;)
	if creator ~= nil then
		explosion.Hit:connect(function(part, distance)  onPlayerBlownUp(part, distance, creator) end)
		if (hit.Parent.Parent:findFirstChild(&quot;LastHit&quot;) ~= nil) then
			hit.Parent.Parent.LastHit.Value = creator.Value.Name
			hit.Parent.Parent.LastHitTimer.Value = 900
		end
	end

	explosion.Parent = game.Workspace
	connection:disconnect()
	wait(.1)
	shaft:remove()
end

function onTouch(hit)
	if hit.Name == &quot;BuildingRemover&quot; then return end
	if hit.Name == &quot;Building&quot; or
	hit.Name == &quot;Safe&quot; then
		swoosh:stop()
		shaft:remove()
	return end

	if hit.Name == &quot;Shield&quot; then
		shieldpoints = hit.ShieldPower
		if (shieldpoints.Value &gt; 0) then
			shieldpoints.Value = shieldpoints.Value - 5
			shieldtransparency = hit.Transparent
			shieldtransparency.Value = shieldtransparency.Value - 5
			swoosh:stop()
			shaft:remove()
		end
	return end

	local shield = nil

	if (hit.Parent.Parent:FindFirstChild(&quot;Parts&quot;) ~= nil) then
		local shield = hit.Parent.Parent.Parts:FindFirstChild(&quot;Shield&quot;)
	end

	if shield ~= nil then
		shieldpoints = shield.ShieldPower
		if (shieldpoints.Value &gt; 0) then
			shieldpoints.Value = shieldpoints.Value - 5
			shieldtransparency = hit.Transparent
			shieldtransparency.Value = shieldtransparency.Value - 5
			swoosh:stop()
			shaft:remove()
		end
	return end

	local parent = hit.Parent.Parent
	local owner = shaft.Owner
	if owner ~= nil then
		if parent ~= nil and owner.Value ~= nil then
			if parent ~= owner.Value then
				local stunt = parent:FindFirstChild(&quot;Stunt&quot;)
				if stunt ~= nil then
					if stunt.Value ~= 1 then
						blow(hit)
					end
				else
					blow(hit)
				end
			end
		end
	end
end

function onPlayerBlownUp(part, distance, creator)
	if part.Name == &quot;Head&quot; then
		local humanoid = part.Parent:FindFirstChild(&quot;Humanoid&quot;)
		if (humanoid ~= nil) then
			tagHumanoid(humanoid, creator)
		end
		if (humanoid == nil) then
			local humanoid = part.Parent:FindFirstChild(&quot;Reactor&quot;)
			if (humanoid ~= nil) then
				distance = (explosion.Position - part.Position).magnitude
				if (distance &lt; 5) then
					humanoid.Value = humanoid.Value - 187.5
				else humanoid.Value = humanoid.Value - 4687.5/(distance*distance)
				end
			end
		end
	end
end

function tagHumanoid(humanoid, creator)
	if creator ~= nil then
		local new_tag = creator:clone()
		new_tag.Parent = humanoid
	end
end

function untagHumanoid(humanoid)
	if humanoid ~= nil then
		local tag = humanoid:findFirstChild(&quot;creator&quot;)
		if tag ~= nil then
			tag:Remove()
		end
	end
end

t, s = r.Stepped:wait()

swoosh = script.Parent.Swoosh
swoosh:play()

d = t + 0.5 - s
connection = shaft.Touched:connect(onTouch)

while t &lt; d do
	fly()
	t = r.Stepped:wait()
end

-- at max range
script.Parent.Explosion.PlayOnRemove = false
swoosh:stop()
shaft:remove()
