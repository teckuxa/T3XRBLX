plane=nil
hold=false
local debounce = false
local planedebounce = false
local stuntdebounce = false
local controlling = false
boostDB = 0

function findPlane(player)
	local list = player.Character:GetChildren()
	for x = 1, #list do
		if (list[x].Name == &quot;Rhino&quot;) then
			local weld = list[x]:FindFirstChild(&quot;Parts&quot;):FindFirstChild(&quot;Seat&quot;):FindFirstChild(&quot;SeatWeld&quot;)
			if (weld ~= nil) and (weld.Part1 == player.Character:FindFirstChild(&quot;Torso&quot;)) then
				return list[x]
			end
		end
	end
	return nil
end

function move(target, engine)
	local origincframe = engine:findFirstChild(&quot;BodyGyro&quot;).cframe
	local dir = (target - engine.Position).unit
	local spawnPos = engine.Position
	local bv = engine:findFirstChild(&quot;BodyVelocity&quot;)
	local pos = spawnPos + (dir * 1)

	engine:findFirstChild(&quot;BodyGyro&quot;).maxTorque = Vector3.new(40000, 40000, 40000)
	engine:findFirstChild(&quot;BodyGyro&quot;).cframe = CFrame.new(pos,  pos + dir)
	wait(0.1)
	if bv~=nil then
	bv.velocity = (engine.CFrame.lookVector * script.Speed.Value) end


end



function onButton1Down(mouse)
	local vehicle = findPlane(script.Parent.Parent.Parent)
	if vehicle ~= nil and debounce == false and planedebounce == false then
	debounce = true

	controlling = true

	while true do
		wait()
		local engine = vehicle.Parts.Engine
		local position = mouse.Hit
		local target = position.p
		if engine:findFirstChild(&quot;BodyVelocity&quot;) ~= nil then
		move(target, engine)
		end
		if planedebounce == true or
		controlling == false then break end
	end
	wait(.1)
	debounce = false
	end
end

function onButton1Up(mouse)
	controlling = false
end

function onSelected(mouse)
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
	mouse.Button1Up:connect(function() onButton1Up(mouse) end)
	mouse.KeyDown:connect(onKeyDown)
end



function onKeyDown(key)
	if (key~=nil) then
		key = key:lower()
		local vehicle = findPlane(script.Parent.Parent.Parent)
		if (vehicle==nil) then return end
		plane = vehicle.Parts
		local engine = vehicle.Parts.Engine
			if (key==&quot;f&quot;) and (bin.RhinoFlyer.Reload.Value == 0) then
				f = Instance.new(&quot;ForceField&quot;)
				f.Parent = script.Parent.Parent.Parent.Character
				bin.RhinoFlyer.Reload.Value = 1
				wait(5)
				f:Remove()
				wait(10)
				bin.RhinoFlyer.Reload.Value = 0
			end

			if (key==&quot;x&quot;) and planedebounce == false then
				if engine:findFirstChild(&quot;BodyGyro&quot;)~=nil then engine:findFirstChild(&quot;BodyGyro&quot;).maxTorque = Vector3.new(0, 0, 0) end
				local power = plane.Engine:findFirstChild(&quot;BodyVelocity&quot;)
				if (power ~= nil) then
				if script.Speed.Value == 40 then
				power:remove()
				script.Speed.Value = 80
				else
				script.Speed.Value = 40
				power.velocity = (power.Parent.CFrame.lookVector * script.Speed.Value)
				end				
			end
			end
			if (key==&quot;y&quot;) then
				
				local power = plane.Engine:findFirstChild(&quot;BodyVelocity&quot;)
				if (power == nil) then
				local fly = vehicle.BodyVelocity:clone()
				fly.Parent = plane.Engine
				fly.velocity = (plane.Engine.CFrame.lookVector * 100)
				if script.Speed.Value ~= 80 then script.Speed.Value = 80 end
				elseif power ~=nil and script.Boost.Value ~= 1 then
				power.velocity = (plane.Engine.CFrame.lookVector * 100)
				if script.Speed.Value ~= 80 then script.Speed.Value = 80 end
				end
				if power ~=nil then
				if boostDB == 0 then
				boostDB = 1
				wait (1)
				boostDB = 0
				elseif boostDB == 1 and script.Boost.Value == 0 then
				script.Boost.Value = 1
				script.Speed.Value = 160
				power.velocity = (plane.Engine.CFrame.lookVector * script.Speed.Value)
				wait (5)
				script.Speed.Value = 80
				power.velocity = (plane.Engine.CFrame.lookVector * 100)
				script.Boost.Value = 2
				wait (15)
				script.Boost.Value = 0
				end
				end
				end
			
			end

end

bin.Selected:connect(onSelected)

