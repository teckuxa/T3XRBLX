			<Item class="LocalScript" referent="RBX8307">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">PaintballShooter</string>
					<ProtectedString name="Source">ammo = 25 -- change if you want, if you make it burst mode then have ammo be a multiple of 3
curammo = 25 -- make same as ammo
firerate = .3 -- lower = faster
reloadtime = 4 -- lower = shorter
isreloading = false -- don&apos;t change
mode = &quot;shot&quot; -- either auto, single, shot or burst
spread = 15 -- lower # means more accurate (don&apos;t make 0). Some day in the future I&apos;ll make a decent recoil script, too lazy now
ShotsInBurstOrShotty = 5 -- Number of shells/bullets fired from one click in burst or shot mode
cursor = &quot;http://www.roblox.com/asset/?id=46165652&quot;
reloadcursor = &quot;http://www.roblox.com/asset/?id=46165664&quot;

-- Note: Check the paintball script to edit damage

if mode==&quot;shot&quot; then spread=spread*2 end -- Extra spread for the shotgun

Tool = script.Parent

colors = {1003}

function fire(v)

	Tool.Handle.Fire:play()
	

	local vCharacter = Tool.Parent
	local vPlayer = game.Players:playerFromCharacter(vCharacter)

	local missile = Instance.new(&quot;Part&quot;)

	local offset = v * 6 -- How far away from you the bullet appears, basically so it won&apos;t hit the person shooting. In general, don&apos;t change this


	missile.CFrame = CFrame.new(vCharacter.PrimaryPart.Position,vCharacter.Humanoid.TargetPoint) + offset -- Aimed towards the mouse
	missile.Size = Vector3.new(0.1,0.1,0.1)
	missile.Velocity = v * 850 + Vector3.new(math.random(-spread,spread),math.random(-spread,spread),math.random(-spread,spread))
	missile.BrickColor = BrickColor.new(&quot;Really black&quot;)
	missile.Shape = 0
	missile.BottomSurface = 0
	missile.TopSurface = 0
	missile.Name = &quot;Paintball&quot;
	missile.Elasticity = 0
	missile.Reflectance = 0
	missile.Friction = 0

	local mesh = Instance.new(&quot;SpecialMesh&quot;) 
	mesh.MeshType = &quot;Sphere&quot; 
	if mode~=&quot;shot&quot; then
	mesh.Scale = Vector3.new(0.2,0.2,1) 
	else mesh.Scale = Vector3.new(0.6,0.6,1.6)
	end
	mesh.Parent = missile

	local force = Instance.new(&quot;BodyForce&quot;)
	force.force = Vector3.new(0,100,0)
	force.Parent = missile

	local new_script = script.Parent.Paintball:clone()
	new_script.Disabled = false
	new_script.Parent = missile

	local creator_tag = Instance.new(&quot;ObjectValue&quot;)
	creator_tag.Value = vPlayer
	creator_tag.Name = &quot;creator&quot;
	creator_tag.Parent = missile
	


	missile.Parent = game.Workspace
	--wait(0.05)
	--fire(
	

end


function check(en)
---------------------------------------Function start here.
if (Tool.Enabled == false) then
return false
end--end for if!
-------------------------------
if (Tool.Enabled == true) then
return true
end
---------------------------------------Function end here.
end


Tool.Enabled = true
function onButton1Down(mouse)
	
	if mode==&quot;auto&quot; then Tool.Enabled = true end
	local character = Tool.Parent;
	local humanoid = character.Humanoid
	if humanoid == nil then
		print(&quot;Humanoid not found&quot;)
		return 
	end

	local targetPos = humanoid.TargetPoint
	local lookAt = (targetPos - character.Head.Position).unit
	
	if mode==&quot;auto&quot; then -- Fire modes
		if (check()) then
			if curammo&gt;0 then -- Tests if there is ammo in the clip
				fire(lookAt) -- Shoots
				curammo=curammo-1 -- Takes away a bullet
				wait(firerate) -- Guns don&apos;t fire all their bullets at the same time!
				if Tool.Enabled==true then onButton1Down(mouse) end -- For automatic mode, shoots again
			else -- This is what happens if there is no ammo
				if isreloading==false then -- Makes sure it isn&apos;t already reloading
					isreloading=true -- Starts reloading
					mouse.Icon = reloadcursor -- Cursor becomes the reload cursor
					Tool.Handle.Reload:Play() -- Plays a sound
					wait(reloadtime) -- Reloads
					mouse.Icon = cursor -- Cursor changes back to normal
					curammo=ammo -- Ammo is back
				end
				isreloading=false -- Stops reloading
			end
		end
	return
	elseif mode==&quot;single&quot; and Tool.Enabled==true then
		Tool.Enabled = false
		if curammo&gt;0 then
			fire(lookAt)
			curammo=curammo-1
		else
			if isreloading==false then
				isreloading=true
				mouse.Icon = reloadcursor
				Tool.Handle.Reload:Play()
				wait(reloadtime)
				mouse.Icon = cursor
				curammo=ammo
			end
			isreloading=false
		end
		wait(firerate)
	elseif mode==&quot;burst&quot; and Tool.Enabled==true then
		Tool.Enabled = false
		if curammo&gt;0 then
		for i=1,ShotsInBurstOrShotty do
			fire(lookAt)
			wait(firerate/5) -- Time in between each bullet in the burst is the firerate divided by 5
		end
		curammo=curammo-ShotsInBurstOrShotty
		else
			if isreloading==false then
				isreloading=true
				mouse.Icon = reloadcursor
				Tool.Handle.Reload:Play()
				wait(reloadtime)
				mouse.Icon = cursor
				curammo=ammo
			end
			isreloading=false
		end
		wait(firerate)
	elseif mode==&quot;shot&quot; and Tool.Enabled==true then
		Tool.Enabled = false
		if curammo&gt;0 then
		for i=1,ShotsInBurstOrShotty do
			fire(lookAt)
		end
		curammo=curammo-1
		else
			if isreloading==false then
				isreloading=true
				mouse.Icon = reloadcursor
				Tool.Handle.Reload:Play()
				wait(reloadtime)
				mouse.Icon = cursor
				curammo=ammo
			end
			isreloading=false
		end
		wait(firerate)
	end

	Tool.Enabled = true
end

function onButton1Up(mouse)
	if mode==&quot;auto&quot; then
		Tool.Enabled = false
		wait()
	end
end
	
	

function onEquippedLocal(mouse)

	if mouse == nil then
		print(&quot;Mouse not found&quot;)
		return 
	end
	
	if isreloading==true then
		mouse.Icon = reloadcursor
	else mouse.Icon = cursor
	end

	mouse.Button1Down:connect(function() onButton1Down(mouse) end)	
	mouse.Button1Up:connect(function() onButton1Up(mouse) end)

end

Tool.Equipped:connect(onEquippedLocal)
