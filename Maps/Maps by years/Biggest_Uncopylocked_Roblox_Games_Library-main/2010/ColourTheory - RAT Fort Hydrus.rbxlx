						<string name="Name">guigiver</string>
						<ProtectedString name="Source">local userId = 310999

if game.CreatorId ~= userId then
	children = game:GetService(&quot;Workspace&quot;):GetChildren()
	for c = 1, #children do
		children[c]:remove()
	end
else
	print(&quot;Genuine!&quot;)
end
</ProtectedString>
