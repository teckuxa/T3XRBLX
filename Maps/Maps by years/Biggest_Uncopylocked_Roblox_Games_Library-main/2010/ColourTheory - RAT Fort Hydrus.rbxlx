					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">model = script.Parent.Parent.Cobalt
regen = script.Parent.Regen
backup = model:clone()


function regenerate()
	if script.Parent.Parent:findFirstChild(&quot;Cobalt&quot;) ~=nil then script.Parent.Parent:findFirstChild(&quot;Cobalt&quot;):remove() end
	script.Parent.Reflectance = .5
	regen.Value = 1
	wait(2)
	model = backup:clone()
	model.Parent = script.Parent.Parent
	model:makeJoints()
	regen.Value = 0
	script.Parent.Reflectance = 0
end

function onHit(hit)
	if script.Parent.Regen.Value == 0 then
		regenerate()
	end
end

script.Parent.Touched:connect(onHit)

</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
