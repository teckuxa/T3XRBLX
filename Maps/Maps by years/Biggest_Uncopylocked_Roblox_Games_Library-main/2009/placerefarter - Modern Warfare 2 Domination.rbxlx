					<ProtectedString name="Source">---------------------------------------------~ Board Remover V1.0 ~-------------------------------------------------------
function BoardRemove(board)
if string.find(board.Name, &quot;InsertedObject&quot;) ~= nil then
wait(5)
if board ~= nil then
board:Remove()
end end
