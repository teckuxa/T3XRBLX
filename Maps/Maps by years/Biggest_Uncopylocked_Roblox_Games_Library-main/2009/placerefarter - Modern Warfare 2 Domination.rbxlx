			<Item class="Script" referent="RBX15981">
				<Properties>
					<bool name="Archivable">true</bool>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Damage</string>
					<ProtectedString name="Source">on=true
function onhit(hit)
if not on then return end
on=false
Dmg=100
if hit.Parent:findFirstChild(&quot;Humanoid&quot;)then
hit.Parent.Humanoid:TakeDamage(Dmg)
script.Parent.Anchored=true
script.Parent.CanCollide=false
script.Parent.Anchored=true
script.Parent.CanCollide=false
script.Parent.Throw.Looped=false
script.Parent.Throw.Volume=0

wait(2)

script.Parent:remove()
end


script.Parent.Anchored=true
script.Parent.CanCollide=false
script.Parent.Throw.Looped=false
script.Parent.Throw.Volume=0
script.Parent.Throw:stop()

wait(2)

script.Parent:remove()
end
script.Parent.Touched:connect(onhit)</ProtectedString>
