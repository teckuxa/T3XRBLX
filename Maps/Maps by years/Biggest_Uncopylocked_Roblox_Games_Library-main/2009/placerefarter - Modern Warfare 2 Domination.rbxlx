					<Item class="Script" referent="RBX4899">
						<Properties>
							<bool name="Archivable">true</bool>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">CapturableScript</string>
							<ProtectedString name="Source">--~~[[Legolas2000 modified this script so it wont be for spawn at all]]~~--
--[[sorry placerefarter - i had no time to create one of my own, so i modified one.]]--


team = script.Parent
Flag = script.Parent.FlagGroup.Flag.Flag

Ftarg = script.Parent.FlagGroup.Flag.Flag.Position

FUp = Ftarg.y
FDown = FUp-5  -- max down
F= FUp
teamnameorwhateverxd = team.BrickColor


debounce = false


function onTouch(hit) 


        if debounce then
		return
	end

	debounce = true


        local user = game.Players:GetPlayerFromCharacter(hit.Parent)
        
        while (user ~= nil) and (user.TeamColor ~= team.BrickColor) do
                   
                  F = F - .1
             
                  Flag.Parent:MoveTo (Vector3.new(Ftarg.x, F, Ftarg.z))
                 
                  if F &lt; FDown then

                             team.BrickColor = user.TeamColor 
                                   Flag.BrickColor = team.BrickColor -- hmmm... Maybe i should remove that if later XD
			user.leaderstats.score.Value = user.leaderstats.score.Value + 10
                   
                 else

                        if ((hit.Position - team.Position).magnitude &gt; 30)  or (hit.Parent.Humanoid.Health &lt; 1) then -- change the 30 to the distance you want
                    
                            user = nil
                        else
                             wait(.3)
                        end
 
               end 
 
        end 
        debounce = false

end


script.Parent.Touched:connect(onTouch) 


while true do

  if F &lt; FUp and debounce == false then

     F = F + .1
     script.Parent.FlagGroup.Flag:MoveTo (Vector3.new (Ftarg.x, F, Ftarg.z ))
     wait(.3)
   else
      wait(2) 
  end

end
</ProtectedString>
						</Properties>
					</Item>
				</Item>
