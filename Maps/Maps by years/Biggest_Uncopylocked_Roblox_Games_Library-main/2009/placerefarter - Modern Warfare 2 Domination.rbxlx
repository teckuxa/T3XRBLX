			<Item class="Script" referent="RBX12565">
				<Properties>
					<bool name="Archivable">true</bool>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">InstaWeld (Read Me Inside here)</string>
					<ProtectedString name="Source">local prev 
local parts = script.Parent:GetChildren() 

for i = 1,#parts do 
	if (parts[i].className == &quot;Part&quot;) then 
		if (prev ~= nil)then 
			local weld = Instance.new(&quot;Weld&quot;) 
			weld.Part0 = prev 
			weld.Part1 = parts[i] 
			weld.C0 = prev.CFrame:inverse() 
			weld.C1 = parts[i].CFrame:inverse() 
			weld.Parent = prev 
		end 
		prev = parts[i] 
	end 
end
 
-- DO NOT CHANGE ANYTHING! --
-- This script puts a weld in every brick that needs one.--

-- MAKE SURE YOU ONLY HAVE 1 BRICK NAMED [Handle] !!! --
</ProtectedString>
