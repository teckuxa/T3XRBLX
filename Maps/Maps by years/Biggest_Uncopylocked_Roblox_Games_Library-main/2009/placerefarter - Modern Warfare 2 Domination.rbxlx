wait(.05)
weld55.C1 = CFrame.new(-0.35, 1.2, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), -0.2, math.rad(-90))
wait(.05)
weld55.C1 = CFrame.new(-0.35, 1.2, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), -0.4, math.rad(-90))
wait(.05)
weld55.C1 = CFrame.new(-0.35, 1.2, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), -0.6, math.rad(-90))
wait(.05)
weld55.C1 = CFrame.new(-0.35, 1.2, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), -0.8, math.rad(-80))
wait(.05)
weld55.C1 = CFrame.new(-0.35, 1.2, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(280), -1, math.rad(-70))
wait(.05)
weld55.C1 = CFrame.new(-0.35, 1.2, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(270), -1.2, math.rad(-60))
wait(.05)
local mag2 = Tool.Drum:clone()
mag2.Parent = game.Workspace
mag2.Transparency = 1
local magweld = Instance.new(&quot;Weld&quot;)
leftarm = Tool.Parent[&quot;Left Arm&quot;]
magweld.Parent = mag2
magweld.Part0 = mag2
magweld.Part1 = leftarm
magweld.C0 = CFrame.new(-1,0,0.3)
magweld.C0 = magweld.C0 * CFrame.fromEulerAnglesXYZ(0,0.6,1.6)
wait(.2)
weld55.C1 = CFrame.new(-0.35, 1.2, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(260), -1.2, math.rad(-50))
wait(.1)
weld55.C1 = CFrame.new(-0.35, 1.2, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(270), -1, math.rad(-60))
