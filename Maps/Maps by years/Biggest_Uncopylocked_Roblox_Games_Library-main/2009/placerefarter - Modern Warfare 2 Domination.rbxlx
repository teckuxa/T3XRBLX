						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">DiedScript</string>
						<ProtectedString name="Source">function weld(x, y) 
	if x == y then return end
	local w = Instance.new(&quot;Weld&quot;) 
	w.Name = &quot;Welding&quot;
	w.Part0 = x 
	w.Part1 = y 
	local HitPos = x.Position 
	local CJ = CFrame.new(HitPos) 
	local C0 = x.CFrame:inverse() *CJ 
	local C1 = y.CFrame:inverse() * CJ 
	w.C0 = C0 
	w.C1 = C1 
	w.Parent = x 
end 

function getKillerOfHumanoidIfStillInGame(humanoid)
	-- returns the player object that killed this humanoid
	-- returns nil if the killer is no longer in the game

	-- check for kill tag on humanoid - may be more than one - todo: deal with this
	local tag = humanoid:findFirstChild(&quot;creator&quot;)

	-- find player with name on tag
	if tag ~= nil then
		
		local killer = tag.Value
		if killer.Parent ~= nil then -- killer still in game
			return killer, tag:FindFirstChild(&quot;UsedWeapon&quot;)
		end
	end

	return nil, nil
end

function onDied()
	wait(.1)
	local killer, weap = getKillerOfHumanoidIfStillInGame(script.Parent.Humanoid)
	if killer ~= nil then
		if killer == game.Players:GetPlayerFromCharacter(script.Parent) then return end

		if weap ~= nil then
			if weap.Value ~= &quot;&quot; then
				weap = weap.Value
			end
		end

		local m = shared.Instancenew(&quot;Hint&quot;)
		m.Name = &quot;Killcam&quot;
		if weap ~= nil then
			m.Text = &quot;You were killed by &quot; .. killer.Name .. &quot; with &quot; .. weap .. &quot;!&quot;
		else
			m.Text = &quot;You were killed by &quot; .. killer.Name .. &quot;!&quot;
		end
		m.Parent = game.Players:GetPlayerFromCharacter(script.Parent)
		local p = shared.Instancenew(&quot;Part&quot;)
		p.Name = &quot;CamLookHere&quot; .. m.Parent.Name
		p.Size = Vector3.new(1,1,1)
		p.Transparency = 1
		p.CanCollide = false
		p.CFrame = CFrame.new(killer.Character.Head.Position + killer.Character.Head.CFrame.lookVector*10, killer.Character.Head.Position)
		p.Parent = game.Workspace
		weld(p, killer.Character.Head)
		local sc = script.CamScript:clone()
		sc.Disabled = false
		local killer2 = shared.Instancenew(&quot;StringValue&quot;)
		killer2.Name = &quot;creator2&quot;
		killer2.Value = killer.Name
		killer2.Parent = script.Parent.Humanoid
		sc.Parent = m.Parent.Backpack
	else
		print(&quot;Killed by something else&quot;)
	end
end

script.Parent.Humanoid.Died:connect(onDied)
