		<Item class="Script" referent="RBX5776">
			<Properties>
				<bool name="Archivable">true</bool>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">TeamGameScript</string>
				<ProtectedString name="Source">--Version: 1.1

--PM me, MrgamesNwatch is you have any problems or the script does NOT work. i have not tested it,but it SHOULD work :D
-- i&apos;ll add a winners announcement as soon as i can, it will announce the winning team and in another future update, announce the top player.
--Just follow the instructions provided below!

team1 = CFrame.new(20,10,20)--change to where team1 spawns(red team) Note: use Vector3 cordinates
team2 = CFrame.new(50,10,50)--change to where team2 spawns(blue team)
lobby = CFrame.new(100,10,100)-- change the the position of the lobby(where the players go before/after the game)
--weapon = game.Lighting[&quot;Sword&quot;]-- change &quot;Sword&quot; to the name of the weapon you want players to have during the game. put the weapon in Lighting.if you want no weapons then remove this line.
Maps = {&quot;Map1&quot;}-- change Map1,Map2,Map3 to the name of your maps and put them in Lighting. you can add more just add: ,&quot;another map&quot; after Map3 and so on.
random = Maps[math.random(1,#Maps)]

while true do 
wait(15)-- how long between games.
script.map.Value = random
local m = Instance.new(&quot;Message&quot;)
m.Parent = game.Workspace
m.Text = &quot;prepare for a new game&quot;
wait(4)
m.Text = &quot;Game starting&quot;
wait(3)
m:remove()
--d = weapon:Clone()
--c = weapon:Clone()
local pplz = game.Players:GetChildren()
for i = 1,#pplz do 
if pplz[i].TeamColor == BrickColor.new(&quot;Bright red&quot;) and pplz[i] ~= nil and pplz[i].Character:FindFirstChild(&quot;Torso&quot;) ~= nil then-- change to team1&apos;s TeamColor
--c.Parent = pplz[i].StarterGear
--d.Parent = pplz[i].Backpack
pplz[i].Character.Torso.CFrame = team1
--d = weapon:Clone()
--c = weapon:Clone()
elseif pplz[i].TeamColor == BrickColor.new(&quot;Bright blue&quot;) and  pplz[i] ~= nil and pplz[i].Character:FindFirstChild(&quot;Torso&quot;) ~= nil then--change to team2&apos;s TeamColor
pplz[i].Character.Torso.CFrame = team2
--d.Parent = pplz[i].Backpack
--c.Parent = pplz[i].StarterGear
end end 
wait(300)-- how long each game lasts.
local pla = game.Players:children() 
	for x = 1, #pla do 
		pla[x].Character.Humanoid.Health = 0
	end

local m = Instance.new(&quot;Message&quot;)
m.Parent = game.Workspace
m.Text = &quot;game is over!&quot;
wait(4)
game.Workspace[script.map.Value]:remove()
m.Text = winner..&quot; has won!&quot;
m:remove()
end
</ProtectedString>
