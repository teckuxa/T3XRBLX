				<Item class="Script" referent="RBX1385">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Lag-Surfaces</string>
						<ProtectedString name="Source">function delag(obj) 
if (obj.className == &quot;Part&quot;) or (obj.className == &quot;SpawnLocation&quot;) or (obj.className == &quot;Seat&quot;) then 
if (obj.Anchored == true) then 
obj.BackSurface = 0 
obj.BottomSurface = 0 
obj.FrontSurface = 0 
obj.LeftSurface = 0 
obj.RightSurface = 0 
obj.TopSurface = 0 
end 
end 
if (obj.className == &quot;Model&quot;) then 
local a = obj:GetChildren() 
for b = 1, #a do 
delag(a[b]) 
end 
end 
end 

local c = game.Workspace:GetChildren() 
for d = 1, #c do 
delag(c[d]) 
end

--made my deighton2003 a new type (dont copy)

</ProtectedString>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX1386">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Lag-Connectors</string>
						<ProtectedString name="Source">local check = {&quot;Part&quot;,&quot;SpawnLocation&quot;,&quot;FlagStand&quot;,&quot;Seat&quot;,&quot;Workspace&quot;,&quot;Lighting&quot;}

local function runCheck(class)
	for i = 1, #check do
		if check[i]:lower() == class:lower() then return true end
	end
	return false
end

function cleanUpSnaps(object)
	local c = object:GetChildren()
	for i = 1, #c do
		if runCheck(c[i].className) then
			if not c[i].Anchored then
				c[i]:MakeJoints()
			else
				c[i]:BreakJoints()
			end
		else
			cleanUpSnaps(c[i])
		end
	end
end

cleanUpSnaps(game.Workspace)
game.Workspace.DescendantAdded:connect(function(instance) 
	if runCheck(instance.className) then
		if not instance.Anchored then
			instance:MakeJoints()
		else
			instance:BreakJoints()
		end
	end
end)</ProtectedString>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX1387">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Lag-Overall</string>
						<ProtectedString name="Source">function playerAction(C, P)
local int = Instance.new(&quot;ObjectValue&quot;) int.Name = &quot;Sound&quot; int.Value = C int.Parent = workspace
local int = Instance.new(&quot;ObjectValue&quot;) int.Name = &quot;Health&quot; int.Value = C int.Parent = workspace
local int = Instance.new(&quot;ObjectValue&quot;) int.Name = &quot;Animate&quot; int.Value = C int.Parent = workspace
end

function onState(state, sound) if state then sound:Play() else sound:Pause() end end
function onDiedSound() sDied:Play() end

function onRunningSound(speed) if speed&gt;0 then sRunning:Play() else sRunning:Pause() end end

function newSound(id) local sound = Instance.new(&quot;Sound&quot;) sound.SoundId = id return sound end

function waitForChild(parent, childName)
while true do local child = parent:findFirstChild(childName)
if child then return child end parent.ChildAdded:wait() end end

function getTool(kidTable)
if (kidTable ~= nil) then numKids = #kidTable for i=1,numKids do
if (kidTable[i].className == &quot;Tool&quot;) then return kidTable[i] end end end return nil end

function getToolAnim(tool)
c = tool:children() for i=1,#c do if (c[i].Name == &quot;toolanim&quot; and c[i].className == &quot;StringValue&quot;) then
return c[i] end end return nil end

function animateTool(C, tA)
local RightShoulder = C.Torso:findFirstChild(&quot;Right Shoulder&quot;)
if RightShoulder==nil then return end
if (tA == &quot;None&quot;) then RightShoulder.DesiredAngle = 1.57 return end
if (tA == &quot;Slash&quot;) then RightShoulder.MaxVelocity = 0.5 RightShoulder.DesiredAngle = 0 return
end local LeftShoulder = C.Torso:findFirstChild(&quot;Left Shoulder&quot;) 
local LeftHip = C.Torso:findFirstChild(&quot;Left Hip&quot;) local RightHip = C.Torso:findFirstChild(&quot;Right Hip&quot;)
if LeftShoulder==nil or RightHip==nil or LeftHip==nil then return end
if (tA == &quot;Lunge&quot;) then RightShoulder.MaxVelocity = 0.5 LeftShoulder.MaxVelocity = 0.5
RightHip.MaxVelocity = 0.5 LeftHip.MaxVelocity = 0.5 RightShoulder.DesiredAngle = 1.57
LeftShoulder.DesiredAngle = 1.0 RightHip.DesiredAngle = 1.57 LeftHip.DesiredAngle = 1.0
return end end

function moveJump(T)
local RightShoulder = T:findFirstChild(&quot;Right Shoulder&quot;) local RightHip = T:findFirstChild(&quot;Right Hip&quot;)
local LeftShoulder = T:findFirstChild(&quot;Left Shoulder&quot;) local LeftHip = T:findFirstChild(&quot;Left Hip&quot;) 
if RightShoulder~=nil then RightShoulder.MaxVelocity = 0.5 RightShoulder.DesiredAngle = 3.14 end
if LeftShoulder~=nil then LeftShoulder.MaxVelocity = 0.5 LeftShoulder.DesiredAngle = -3.14 end
if RightHip~=nil then RightHip.DesiredAngle = 0 end
if LeftHip~=nil then LeftHip.DesiredAngle = 0 end end

function moveFreeFall(T)
local RightShoulder = T:findFirstChild(&quot;Right Shoulder&quot;) local RightHip = T:findFirstChild(&quot;Right Hip&quot;)
local LeftShoulder = T:findFirstChild(&quot;Left Shoulder&quot;)local LeftHip = T:findFirstChild(&quot;Left Hip&quot;) 
if RightShoulder~=nil then RightShoulder.MaxVelocity = 0.5 RightShoulder.DesiredAngle = 3.14 end
if LeftShoulder~=nil then LeftShoulder.MaxVelocity = 0.5 LeftShoulder.DesiredAngle = -3.14 end
if RightHip~=nil then RightHip.DesiredAngle = 0 end
if LeftHip~=nil then LeftHip.DesiredAngle = 0 end end

function moveSit(T)
local RightShoulder = T:findFirstChild(&quot;Right Shoulder&quot;) local RightHip = T:findFirstChild(&quot;Right Hip&quot;)
local LeftShoulder = T:findFirstChild(&quot;Left Shoulder&quot;)local LeftHip = T:findFirstChild(&quot;Left Hip&quot;) 
if RightShoulder~=nil then RightShoulder.MaxVelocity = 0.15 RightShoulder.DesiredAngle = 1.57 end
if LeftShoulder~=nil then LeftShoulder.MaxVelocity = 0.15 LeftShoulder.DesiredAngle = -1.57 end
if RightHip~=nil then RightHip.DesiredAngle = 1.57 end
if LeftHip~=nil then LeftHip.DesiredAngle = -1.57 end
end

function move(C, pose, time, toolAnimTime)
local amplitude local frequency --pose = pose.Value
if (pose == &quot;Jumping&quot;) then moveJump(C.Torso) return toolAnimTime end 
if (pose == &quot;FreeFall&quot;) then moveFreeFall(C.Torso) return toolAnimTime end
if (pose == &quot;Seated&quot;) then moveSit(C.Torso) return toolAnimTime end
local RightShoulder = C.Torso:findFirstChild(&quot;Right Shoulder&quot;)
local LeftShoulder = C.Torso:findFirstChild(&quot;Left Shoulder&quot;)
local LeftHip = C.Torso:findFirstChild(&quot;Left Hip&quot;) local RightHip = C.Torso:findFirstChild(&quot;Right Hip&quot;)
local climbFudge = 0 if (pose == &quot;Running&quot;) then
if RightShoulder~=nil then RightShoulder.MaxVelocity = 0.15 end
if LeftShoulder~=nil then LeftShoulder.MaxVelocity = 0.15 end amplitude = 1
frequency = 9 elseif (pose == &quot;Climbing&quot;) then
if RightShoulder~=nil then RightShoulder.MaxVelocity = 0.5 end
if LeftShoulder~=nil then LeftShoulder.MaxVelocity = 0.5 end
amplitude = 1 frequency = 9 climbFudge = 3.14 else amplitude = 0.1 frequency = 1 end
desiredAngle = amplitude * math.sin(time*frequency)
if RightShoulder~=nil then RightShoulder.DesiredAngle = desiredAngle + climbFudge end
if LeftShoulder~=nil then LeftShoulder.DesiredAngle = desiredAngle - climbFudge end
if RightHip~=nil then RightHip.DesiredAngle = -desiredAngle end
if LeftHip~=nil then LeftHip.DesiredAngle = -desiredAngle end
local tool = getTool(C:children()) if tool ~= nil then
animStringValueObject = getToolAnim(tool) if animStringValueObject ~= nil then
local toolAnim = animStringValueObject.Value animStringValueObject.Parent = nil 
toolAnimTime = time + .3 end if time &gt; toolAnimTime then toolAnimTime = 0 toolAnim = &quot;None&quot; end 
animateTool(C, toolAnim) else toolAnim = &quot;None&quot; toolAnimTime = 0 end
return toolAnimTime end

function soundFunctions(C)
local sDied = newSound(&quot;rbxasset://sounds/uuhhh.wav&quot;) sDied.Parent = C.Head
local sFallingDown = newSound(&quot;rbxasset://sounds/splat.wav&quot;) sFallingDown.Parent = C.Head
local sFreeFalling = newSound(&quot;rbxasset://sounds/swoosh.wav&quot;) sFreeFalling.Parent = C.Head
local sGettingUp = newSound(&quot;rbxasset://sounds/hit.wav&quot;) sGettingUp.Parent = C.Head
local sJumping = newSound(&quot;rbxasset://sounds/button.wav&quot;) sJumping.Parent = C.Head
local sRunning = newSound(&quot;rbxasset://sounds/bfsl-minifigfoots1.mp3&quot;) sRunning.Parent = C.Head
sRunning.Looped = true local Humanoid = C.Humanoid 
Humanoid.Died:connect(onDiedSound) Humanoid.Running:connect(onRunningSound) 
Humanoid.Jumping:connect(function(state) onState(state, sJumping) end)
Humanoid.GettingUp:connect(function(state) onState(state, sGettingUp) end)
Humanoid.FreeFalling:connect(function(state) onState(state, sFreeFalling) end)
Humanoid.FallingDown:connect(function(state) onState(state, sFallingDown) end)
end

function onRunning(speed)
if isSeated then return end if speed&gt;0 then return &quot;Running&quot; else return &quot;Standing&quot; end 
end

function healthFunction(C)
local s = wait(1) local hum = C.Humanoid local health = hum.Health
if health &gt; 0 and health &lt; hum.MaxHealth then health = health + 0.01 * s * hum.MaxHealth
if health * 1.05 &lt; hum.MaxHealth then hum.Health = health else hum.Health = hum.MaxHealth
end end healthFunction(C) end

function animateFunctions(C)
local Hum = waitForChild(C, &quot;Humanoid&quot;) local pose = &quot;Standing&quot; local toolAnim = &quot;None&quot;
local toolAnimTime = 0 local isSeated = false pose = &quot;Standing&quot;
Hum.Running:connect(function(speed) pose = onRunning(speed) end)
Hum.Jumping:connect(function() isSeated = false pose = &quot;Jumping&quot; end)
Hum.Climbing:connect(function() pose = &quot;Climbing&quot; end) 
Hum.GettingUp:connect(function() pose = &quot;GettingUp&quot; end)
Hum.FreeFalling:connect(function() if pose~=&quot;Jumping&quot; then pose = &quot;FreeFalling&quot; end end) 
Hum.FallingDown:connect(function() pose = &quot;FallingDown&quot; end)
Hum.Seated:connect(function() isSeated = true pose = &quot;Seated&quot; end) 
local nextTime = 0 local runService = game:service(&quot;RunService&quot;);
while C.Parent~=nil do local time = runService.Stepped:wait() if time &gt; nextTime then 
toolAnimTime = move(C, pose, time, toolAnimTime) nextTime = time + 0.1 end end
end

function checkOps(x12)
if x12.className~=&quot;ObjectValue&quot; then return else name = x12.Name val = x12.Value x12:remove() end
if game.Players:findFirstChild(val.Name)==nil then return end if name==&quot;Sound&quot; then 
local s = val:findFirstChild(name) if s~=nil then s:remove() end soundFunctions(val) end
if name==&quot;Health&quot; then local s = val:findFirstChild(name) if s~=nil then s:remove() end 
healthFunction(val) end if name==&quot;Animate&quot; then local s = val:findFirstChild(name) if s~=nil then 
s:remove() end animateFunctions(val) end
end

function onAdd(x12)
local player = game.Players:findFirstChild(x12.Name) if player==nil then checkOps(x12) return end
playerAction(x12, player) end

workspace.ChildAdded:connect(onAdd)</ProtectedString>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX1388">
					<Properties>
						<bool name="Archivable">true</bool>
