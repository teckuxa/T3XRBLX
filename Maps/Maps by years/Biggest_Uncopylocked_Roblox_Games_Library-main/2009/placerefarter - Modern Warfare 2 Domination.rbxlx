					<string name="Name">game loop</string>
					<ProtectedString name="Source">wait(10) -- this will start after 10 sec.
while true do 
	local h = Instance.new (&quot;Message&quot;)
	h.Parent = game.Workspace
	h.Text = &quot;New Round Starting!&quot;
	wait(5)
	h.Parent = game.Lighting
	 p = game.Players:GetChildren()
	wait(300)  
	local pla = game.Players:children() 
	for x = 1, #pla do 
		pla[x].Character.Humanoid.Health = 0
	end
	h.Parent = game.Workspace
	h.Text = &quot;Round Over!&quot;
	wait(5)
	h:Remove()
	local m = Instance.new (&quot;Hint&quot;)
	m.Parent = game.Workspace
	m.Text = &quot;Prepare for a new round&quot;
	wait(1)
	m:Remove()
end </ProtectedString>
