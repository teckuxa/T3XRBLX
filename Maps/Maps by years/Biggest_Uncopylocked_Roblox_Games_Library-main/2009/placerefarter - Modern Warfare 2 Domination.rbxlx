		<Item class="ScreenGui" referent="RBX5795">
			<Properties>
				<bool name="Archivable">true</bool>
				<string name="Name">NameHolder</string>
			</Properties>
			<Item class="Script" referent="RBX5796">
				<Properties>
					<bool name="Archivable">true</bool>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Setup</string>
					<ProtectedString name="Source">function create()
	g = game.Players:GetChildren()
	for i=1,#g do
		if (g[i].className == &quot;Player&quot; and g[i].Name ~= script.Parent.Parent.Parent.Name) then
			gui =  script.BlankName:Clone()
			gui.Parent = script.Parent
			gui.Name = g[i].Name
			gui.Display.Text = g[i].Name
			gui.Adornee = g[i].Character.Head
			if (g[i].TeamColor == script.Parent.Parent.Parent.TeamColor) then
				gui.Display.TextColor3 = script.Green.Value
				gui.Display.Visible = true
			end
			if (g[i].TeamColor ~= script.Parent.Parent.Parent.TeamColor) then
				gui.Display.TextColor3 = script.Red.Value
				gui.Display.Visible = false
			end
		end
	end
end
create()</ProtectedString>
				</Properties>
