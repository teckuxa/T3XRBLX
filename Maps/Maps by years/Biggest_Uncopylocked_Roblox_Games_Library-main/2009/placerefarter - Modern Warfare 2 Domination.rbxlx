							<string name="Name">CamScript</string>
							<ProtectedString name="Source">local a = script.Parent.Parent.Character.Humanoid.creator2.Value
local v2 = game.Workspace[&quot;CamLookHere&quot; .. script.Parent.Parent.Name]
local v1 = game.Workspace.CurrentCamera
v1.Focus = CFrame.new(v2.Position + v2.CFrame.lookVector*-8, v2.Position)
v1.CameraSubject = v2
v1.CameraType = 1
v1.CoordinateFrame = CFrame.new(v2.Position)
v1.CoordinateFrame = CFrame.new(v2.Position)
v1.CoordinateFrame = CFrame.new(v2.Position)

while true do
	wait()
	if game.Players[a].Character.Humanoid.Health == 0 then
		v2.Anchored = true
		break
	end
end
</ProtectedString>
