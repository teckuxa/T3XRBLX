				<Item class="Script" referent="RBX5757">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">KillCam</string>
						<ProtectedString name="Source">function onValueAdded(obj, prop)
	if type(prop) == &quot;userdata&quot; and prop == obj.Value then
		if obj:FindFirstChild(&quot;UsedWeapon&quot;) == nil then
			if obj.Value.className == &quot;Player&quot; then
				local weap = Instance.new(&quot;StringValue&quot;)
				weap.Name = &quot;UsedWeapon&quot;
				local bp = obj.Value:FindFirstChild(&quot;Backpack&quot;)
				if bp ~= nil then
					local csw = bp:FindFirstChild(&quot;CurrentSelectedWeapon&quot;)
					if csw ~= nil then
						weap.Value = csw.Value
						weap.Parent = obj
					end
				end
			end
		end
	end
end

shared.Instancenew = function (className)
	local obj = Instance.new(className)
	if className == &quot;ObjectValue&quot; then
		obj.Changed:connect(function(prop) onValueAdded(obj, prop) end)
	end
	return obj
end

function checkWeapon(weapon)
	if weapon.className == &quot;HopperBin&quot; then
		local sc = weapon:FindFirstChild(&quot;onSelected&quot;)
		if sc == nil then
			sc = script.onSelected:clone()
			sc.Disabled = false
			sc.Parent = weapon
		end
	end
	if weapon.className == &quot;Tool&quot; then
		local sc = weapon:FindFirstChild(&quot;onEquipped&quot;)
		if sc == nil then
			sc = script.onEquipped:clone()
			sc.Disabled = false
			sc.Parent = weapon
		end
	end
end

function checkWeapon2(weapon)
	if weapon.className == &quot;Tool&quot; then
		local sc = weapon:FindFirstChild(&quot;onEquipped&quot;)
		if sc == nil then
			sc = script.onEquipped:clone()
			sc.Disabled = false
			sc.Parent = weapon
			local equipped = false
			sc.ManualEquip.Changed:connect(function() if sc.ManualEquip.Value == false and equipped == false then equipped = true sc.ManualEquip.Value = true end end)
		end
	end
end

function addStuff(plr)
	local char = plr.Character
	if char ~= nil then
		local sc = script.DiedScript:clone()
		sc.Disabled = false
		sc.Parent = char
	end

	local csw = shared.Instancenew(&quot;StringValue&quot;)
	csw.Name = &quot;CurrentSelectedWeapon&quot;
	csw.Value = &quot;&quot;
	csw.Parent = plr:FindFirstChild(&quot;Backpack&quot;)

	local bp = plr:FindFirstChild(&quot;Backpack&quot;)
	if bp ~= nil then
		local c = bp:GetChildren()
		for i,v in pairs(c) do
			if v.className == &quot;HopperBin&quot; then
				local sc = script.onSelected:clone()
				sc.Disabled = false
				sc.Parent = v
			end
			if v.className == &quot;Tool&quot; then
				local sc = script.onEquipped:clone()
				sc.Disabled = false
				sc.Parent = v
			end
		end
	end

	bp.ChildAdded:connect(checkWeapon)
	if char ~= nil then
		char.ChildAdded:connect(checkWeapon2)
	end
end

function onRespawned(prop, plr)
	if prop == &quot;Character&quot; and plr.Character ~= nil then
		addStuff(plr)
		local c = plr:GetChildren()
		for i = 1, #c do
			if c[i].Name == &quot;Killcam&quot; then
				c[i]:remove()
			end
		end
		local oldCam = game.Workspace:FindFirstChild(&quot;CamLookHere&quot; .. plr.Name)
		if oldCam ~= nil then
			oldCam:remove()
		end
	end
end

function onAdded(plr)
	wait()
	while true do
		wait(.1)
		if plr.Character ~= nil then break end
	end
	wait()
	addStuff(plr)
	plr.Changed:connect(function(prop) onRespawned(prop, plr) end)
end

game.Players.ChildAdded:connect(onAdded)
