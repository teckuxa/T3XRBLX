						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">while true do
wait(.3)
if script.Parent.Value &gt; 5 then
script.Parent.Value = script.Parent.Value - 1
end
end
</ProtectedString>
					</Properties>
				</Item>
			</Item>
			<Item class="NumberValue" referent="RBX12484">
				<Properties>
