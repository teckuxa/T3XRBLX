			<Item class="Script" referent="RBX15978">
				<Properties>
					<bool name="Archivable">true</bool>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">ThrowKnife</string>
					<ProtectedString name="Source">Tool = script.Parent
Tool.TextureId=&quot;&quot;
function fire(v)
	local vCharacter = Tool.Parent
	local vPlayer = game.Players:playerFromCharacter(vCharacter)

local knife=Tool.Handle:clone()
Tool.Handle.Transparency=1
        

	local spawnPos = Tool.Handle.Position


	spawnPos  = spawnPos + (v * 8)
knife.Parent=game.Workspace
knife.Position=spawnPos
knife.Velocity = v * 100
knife.CanCollide=true
knife.Name=&quot;Knife&quot;
knife.Throw.Looped=true
knife.Throw.Pitch=2
knife.Throw:play()
	local force = Instance.new(&quot;BodyForce&quot;)
	force.force = Vector3.new(0,90,0)
	force.Parent = knife


	local new_script = script.Parent.Damage:clone()
	new_script.Disabled = false
	new_script.Parent = knife

	local creator_tag = Instance.new(&quot;ObjectValue&quot;)
	creator_tag.Value = vCharacter
	creator_tag.Name = &quot;creator&quot;
	creator_tag.Parent = knife
	
local spin=script.Spin:clone()
spin.Parent=knife

	knife.Parent = game.Workspace

end



Tool.Enabled = true
function onActivated()

	if not Tool.Enabled then
		return
	end

	Tool.Enabled = false

	local character = Tool.Parent;
	local humanoid = character.Humanoid
	if humanoid == nil then
		print(&quot;Humanoid not found&quot;)
		return 
	end

	local targetPos = humanoid.TargetPoint
	local lookAt = (targetPos - character.Head.Position).unit
	Tool.Parent.Torso:findFirstChild(&quot;Right Shoulder&quot;).DesiredAngle=3.57
	Tool.Parent.Torso:findFirstChild(&quot;Right Shoulder&quot;).CurrentAngle=3.57
wait(.2)
Tool.Handle.Throw:play()
wait(.2)
	fire(lookAt)

	wait(1.3)
ks=Tool.Knives
ks.Value=ks.Value-1
if ks.Value&lt;=0 then
Tool:remove()
end
Tool.Handle.Transparency=0
	Tool.Enabled = true
end


script.Parent.Activated:connect(onActivated)

</ProtectedString>
				</Properties>
				<Item class="BodyAngularVelocity" referent="RBX15979">
