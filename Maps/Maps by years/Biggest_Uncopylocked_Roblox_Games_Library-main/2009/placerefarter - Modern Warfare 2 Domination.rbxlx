				<Item class="LocalScript" referent="RBX5801">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">NameDisplay</string>
						<ProtectedString name="Source">local green = script.Green.Value
function display(mouse) 
	if (mouse.Target:findFirstChild(&quot;Humanoid&quot;) ~= nil) then
		local hit = mouse.Target
		if (game.Players:findFirstChild(mouse.Target.Name) ~= nil) then
			user = game.Players:findFirstChild(mouse.Target.Name)
			current = game.Players:findFirstChild(script.Parent.Parent.Name)
			if (current == nil) then return end
			if (user.TeamColor ~= current.TeamColor) then
				gui = current.PlayerGui.NameHolder:findFirstChild(mouse.Target.Name)
				if (gui == nil) then return end
				gui.Display.Visible = true
			end
		end
	else
		current = game.Players:findFirstChild(script.Parent.Parent.Name)
		gui = current.PlayerGui.NameHolder:findFirstChild(mouse.Target.Name)
		if (gui == nil) then return end
		parts = gui:GetChildren()
		for i=1,#parts do
			if (parts[i].className == &quot;BillboardGui&quot; and parts[i].Display.TextColor3 ~= green) then
				parts[i].Display.Visible = false
			end
		end		
	end
end 

function onSelected(mouse)
	mouse.Move:connect(function() display(mouse) end)
end
script.Parent.Equipped:connect(onSelected)</ProtectedString>
					</Properties>
