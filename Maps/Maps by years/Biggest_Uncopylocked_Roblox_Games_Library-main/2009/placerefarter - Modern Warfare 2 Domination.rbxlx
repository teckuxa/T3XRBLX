							<string name="Name">WalkSpeed Changer</string>
							<ProtectedString name="Source">function onTouched(hit)
	local h = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
	if h ~= nil then
		h.WalkSpeed = 25

	end
end

script.Parent.Touched:connect(onTouched)
</ProtectedString>
