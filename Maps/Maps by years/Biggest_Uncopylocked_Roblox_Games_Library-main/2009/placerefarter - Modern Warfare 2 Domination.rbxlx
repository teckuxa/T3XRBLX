					<Item class="Script" referent="RBX5760">
						<Properties>
							<bool name="Archivable">true</bool>
							<bool name="Disabled">true</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">onSelected</string>
							<ProtectedString name="Source">bin = script.Parent
lastAdd = &quot;&quot;

function onSelected()
	local cws = bin.Parent:FindFirstChild(&quot;CurrentSelectedWeapon&quot;)
	if cws ~= nil then
		local add = bin.Name
		if string.sub(add, 1, 6):lower() == &quot;linked&quot; and string.len(add) &gt; 6 then
			add = string.sub(add, 7)
		end
		cws.Value = add
		lastAdd = add
	end
end

function onDeselected()
	wait()
	local cws = bin.Parent:FindFirstChild(&quot;CurrentSelectedWeapon&quot;)
	if cws ~= nil then
		if cws.Value == lastAdd then
			cws.Value = &quot;&quot;
		end
	end
end

bin.Selected:connect(onSelected)
bin.Deselected:connect(onDeselected)

</ProtectedString>
						</Properties>
					</Item>
					<Item class="Script" referent="RBX5761">
						<Properties>
							<bool name="Archivable">true</bool>
							<bool name="Disabled">true</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">onEquipped</string>
							<ProtectedString name="Source">bin = script.Parent
lastAdd = &quot;&quot;
lastPlayer = nil

function onSelected()
	if bin.Parent.className == &quot;Backpack&quot; then
		local cws = bin.Parent:FindFirstChild(&quot;CurrentSelectedWeapon&quot;)
		if cws ~= nil then
			local add = bin.Name
			if string.sub(add, 1, 6):lower() == &quot;linked&quot; and string.len(add) &gt; 6 then
				add = string.sub(add, 7)
			end
			cws.Value = add
			lastAdd = add
			lastPlayer = bin.Parent.Parent
		end
	else
		local plr = game.Players:GetPlayerFromCharacter(bin.Parent)
		if plr ~= nil then
			local bp = plr:FindFirstChild(&quot;Backpack&quot;)
			if bp ~= nil then
				local cws = bp:FindFirstChild(&quot;CurrentSelectedWeapon&quot;)
				if cws ~= nil then
					local add = bin.Name
					if string.sub(add, 1, 6):lower() == &quot;linked&quot; and string.len(add) &gt; 6 then
						add = string.sub(add, 7)
					end
					cws.Value = add
					lastAdd = add
					lastPlayer = plr
				end
			end
		end
	end
end

function onDeselected()
	wait()
	if lastPlayer ~= nil then
		local bp = lastPlayer:FindFirstChild(&quot;Backpack&quot;)
		if bp ~= nil then
			local cws = bp:FindFirstChild(&quot;CurrentSelectedWeapon&quot;)
			if cws ~= nil then
				if cws.Value == lastAdd then
					cws.Value = &quot;&quot;
				end
			end
		end
	end
end

bin.Equipped:connect(onSelected)
bin.Unequipped:connect(onDeselected)
script.ManualEquip.Changed:connect(function() if script.ManualEquip.Value == true then script.ManualEquip.Value = false onSelected() end end)
script.ManualEquip.Value = false
