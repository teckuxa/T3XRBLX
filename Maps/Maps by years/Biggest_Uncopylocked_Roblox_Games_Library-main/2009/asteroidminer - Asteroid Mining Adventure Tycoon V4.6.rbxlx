						<Item class="ClickDetector" referent="RBX6557">
							<Properties>
								<bool name="FrontendMouseClick">false</bool>
								<float name="MaxActivationDistance">3</float>
								<string name="Name">ClickDetector</string>
								<bool name="archivable">true</bool>
