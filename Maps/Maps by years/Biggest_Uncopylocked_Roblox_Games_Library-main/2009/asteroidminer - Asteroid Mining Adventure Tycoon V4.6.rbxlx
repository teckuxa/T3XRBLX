						<Item class="Script" referent="RBX2990">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<string name="Source">wait(1)
ship = script.Parent.Parent.Parent.Plane
copy = ship:Clone()
skip = 0

function ontouch(part)
	if part.Parent == game.Workspace then return end
	if part.Parent:FindFirstChild(&quot;Humanoid&quot;) == nil then return end
	if part.Parent.Name ~= script.Parent.Parent.Parent.Parent.OwnerName.Value then return end
	if skip == 1 then return end

	skip = 1
	if ship ~= nil then
		ship:Remove()
	end
	if part.Parent:FindFirstChild(&quot;Plane&quot;) ~= nil then
		part.Parent:FindFirstChild(&quot;Plane&quot;):Remove()
	end
	new = copy:Clone()
	new.Parent = game.Workspace
	new:MakeJoints()
	wait(10)
