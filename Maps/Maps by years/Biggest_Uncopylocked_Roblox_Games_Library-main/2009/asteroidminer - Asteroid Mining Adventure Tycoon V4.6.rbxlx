				<Item class="Script" referent="RBX1003">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<string name="Source">while true do

time = math.random(1,30)

wait(time)

print(&quot;Go&quot;)

players = game.Players:GetChildren()
if players ~= nil then
	if #players &gt; 0 then
		choice = math.random(1,#players)
		targplayer = players[choice].Name
		targ = game.Workspace:FindFirstChild(targplayer)
		if targ ~= nil then
			new = game.Lighting.Alien:Clone()
			new.Parent = game.Workspace
			new:MakeJoints()
			new:MoveTo(game.Workspace.AlienStation.Spawn.Position)
			bp = Instance.new(&quot;BodyPosition&quot;)
			bp.Parent = new:FindFirstChild(&quot;Torso&quot;)
			if targ:FindFirstChild(&quot;Torso&quot;) ~= nil then
				pos = targ:FindFirstChild(&quot;Torso&quot;).Position
				bp.position = pos + Vector3.new(0,10,0)
				bp.D = 4000
				bp.maxForce = Vector3.new(18100,4000,18100)
			end
		end

	end
end

objs = game.Workspace:GetChildren()
for i =1, #objs do
	if objs[i].className == &quot;Model&quot; or objs[i].className == &quot;Part&quot; then
	if objs[i].Name ~= &quot;Tycoon&quot; and objs[i].Name ~= &quot;Starbase&quot; and objs[i].Name ~= &quot;Alien2&quot; and objs[i].Name ~= &quot;AlienStation&quot; and objs[i].Name ~= &quot;Huge Planet&quot; and objs[i].Name ~= &quot;Planet&quot; and objs[i].Name ~= &quot;Ringed Planet&quot; and objs[i].Name ~= &quot;Treasure&quot; then
	if objs[i].Name ~= &quot;Hub&quot; and objs[i].Name ~= &quot;Meeting1&quot; and objs[i].Name ~= &quot;Meeting2&quot; and objs[i].Name ~= &quot;Quarters1&quot; and objs[i].Name ~= &quot;Quarters2&quot; and objs[i].Name ~= &quot;Storage1&quot; and objs[i].Name ~= &quot;Storage2&quot; then

		if objs[i]:FindFirstChild(&quot;Die&quot;) == nil then
			if objs[i]:FindFirstChild(&quot;Humanoid&quot;) == nil then
				new = game.Lighting.Die:Clone()
				new.Parent = objs[i]
			end
		end

	end
	end
	end
end

end
</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX1004">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Cashtrack</string>
						<string name="Source">wait(30)

while true do
	players = game.Players:GetChildren()
	for i = 1, #players do
		checkval = script.Parent.Parent:FindFirstChild(players[i].Name .. &quot;CASH&quot;).Value
		players[i].leaderstats.Cash.Value = checkval
	end
	wait(1)
end
