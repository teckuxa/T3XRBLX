						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Splat</string>
						<string name="Source">local larm = script.Parent.Parent:FindFirstChild(&quot;Left Arm&quot;)
local rarm = script.Parent.Parent:FindFirstChild(&quot;Right Arm&quot;)
function onTouched(part)
	if (part.Name == &quot;Splat&quot;) then
		script.Parent.Parent.Alien.Health = script.Parent.Parent.Alien.Health -100
		wait(0.1)
	end
end

script.Parent.Touched:connect(onTouched)
script.Parent.Parent.Head.Touched:connect(onTouched)
larm.Touched:connect(onTouched)
rarm.Touched:connect(onTouched)
script.Parent.Parent.Sphere.Touched:connect(onTouched)
</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
