					<Item class="Script" referent="RBX868">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Glowie</string>
							<string name="Source">while true do
	script.Parent.Reflectance = script.Parent.Reflectance - 0.1
	if script.Parent.Reflectance &lt; 0.1 then
		script.Parent.Reflectance = 1
	end
	wait()

end
</string>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
					<Item class="Script" referent="RBX869">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Touch</string>
							<string name="Source">copy = script.Parent.Parent:Clone()

function ontouch(part)
	if part.Parent ~= nil then
		if part.Parent:FindFirstChild(&quot;Humanoid&quot;) ~= nil then
			char = part.Parent.Name
			cashobject = game.Players:FindFirstChild(char).leaderstats.Cash
			cashobject.Value = cashobject.Value + math.random(1000,5000)
			game.Workspace.Starbase:FindFirstChild( char .. &quot;CASH&quot;).Value = cashobject.Value

			script.Parent.Parent:Remove()
			time = math.random(30,600)
			wait(time)
			copy.Parent = game.Workspace
		end
	end

end

script.Parent.Touched:connect(ontouch)
</string>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
				</Item>
			</Item>
		</Item>
