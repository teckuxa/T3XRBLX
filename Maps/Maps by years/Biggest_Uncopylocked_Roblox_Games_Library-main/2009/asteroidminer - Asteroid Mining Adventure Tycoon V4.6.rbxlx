					<string name="Source">damage = 10
function onTouched(hit)
	if hit.Parent:FindFirstChild(&quot;Alien&quot;) ~= nil then			hit.Parent:FindFirstChild(&quot;Alien&quot;).Health = hit.Parent:FindFirstChild(&quot;Alien&quot;).Health - 15			if hit.Parent:FindFirstChild(&quot;Alien&quot;).Health &lt; 1 then
				cashobject = game.Players:FindFirstChild(script.Parent:FindFirstChild(&quot;owner&quot;).Value).leaderstats.Cash
				cashobject.Value = cashobject.Value + 2000
				game.Workspace.Starbase:FindFirstChild(script.Parent:FindFirstChild(&quot;owner&quot;).Value .. &quot;CASH&quot;).Value = cashobject.Value
				hit.Parent:Remove()
			end
	end	wait()	script.Parent:Remove()
end
