wait()
	if script.Parent.Parent.Mode.Value == 1 then
		script.Parent.BrickColor = BrickColor.new(21)
	end
	if script.Parent.Parent.Mode.Value == -1 then
		script.Parent.BrickColor = BrickColor.new(23)
	end
end
