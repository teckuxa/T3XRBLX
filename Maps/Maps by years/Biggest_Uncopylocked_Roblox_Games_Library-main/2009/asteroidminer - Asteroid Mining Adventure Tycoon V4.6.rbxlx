		<Item class="Script" referent="RBX2">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Tycoon Leader Board</string>
				<string name="Source">--OBS : NOT MY SCRIPT ENTIRELY!
--This is a modified version of a script I got from the &quot;all models&quot; search. I don&apos;t know who the author is.
--Basically it adds a cash-holder to each player.
--The money is stored in &quot;game.Players.--Playername--.Leaderstats.Cash&quot;

print(&quot;Cash Stuffs running!&quot;)

function onPlayerEntered(newPlayer)


	wait(.5)
	local stats = Instance.new(&quot;IntValue&quot;)
	stats.Name = &quot;leaderstats&quot;
	local stats2 = Instance.new(&quot;IntValue&quot;)
	stats2.Name = &quot;Tycoon&quot;

	local cash = Instance.new(&quot;IntValue&quot;)
	cash.Name = &quot;Cash&quot;
	cash.Value = 1000 --This sets the amount of money every player starts with

	local income = Instance.new(&quot;IntValue&quot;)
	income.Name = &quot;Income&quot;
	income.Value = 0 --This sets the amount of money every player starts with

	cash.Parent = stats
	income.Parent = stats
	stats2.Parent = newPlayer	
	stats.Parent = newPlayer

	track = Instance.new(&quot;IntValue&quot;)
	track.Name = newPlayer.Name .. &quot;CASH&quot;
	track.Parent = game.Workspace.Starbase
	track.Value = 1000

end

game.Players.ChildAdded:connect(onPlayerEntered)
</string>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
