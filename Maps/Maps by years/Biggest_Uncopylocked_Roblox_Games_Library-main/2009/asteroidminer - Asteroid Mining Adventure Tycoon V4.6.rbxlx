					<Item class="Script" referent="RBX6416">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<string name="Source">wait(10)

while true do

	closest = 1000000
	aliens = game.Workspace:GetChildren()
	for i = 1, #aliens do
		if aliens[i].Name == &quot;Alien&quot; then
			if aliens[i]:FindFirstChild(&quot;Torso&quot;) ~= nil then
				loc = aliens[i]:FindFirstChild(&quot;Torso&quot;).Position
				pos = script.Parent.Position
				offset = (loc - pos).magnitude
				if offset &lt; closest then
					closest = offset
				end
			end
		end
	end

	if closest &lt; 1000000 then
		msg = string.format(&quot;%.1f&quot;, closest)
		script.Parent.Parent.Name = &quot;Nearest Alien &quot; .. msg
	else
		script.Parent.Parent.Name = &quot;No Alien detected&quot;
	end

	wait(2)

end
</string>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
				</Item>
