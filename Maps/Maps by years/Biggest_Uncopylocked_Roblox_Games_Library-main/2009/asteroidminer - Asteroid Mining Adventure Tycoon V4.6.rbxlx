function dogoal1(part)

end

function dogoal2(part)
	-- cutter

	if script.Parent.Parent:FindFirstChild(&quot;Cutter1&quot;) == nil then return end
	if part.Name == &quot;Gem1&quot; then return end
	if part.Name == &quot;Gem2&quot; then return end

	partmass = part.Size.x * part.Size.y * part.Size.z
	if partmass == 1 then return end

	script.Parent.Parent:FindFirstChild(&quot;Cutter1&quot;):FindFirstChild(&quot;Cutter&quot;).BrickColor = BrickColor.new(21)
	

	newpart = part:Clone()

	parts = newpart:GetChildren()
	for i = 1, #parts do
		if parts[i].className == &quot;Script&quot; then
			parts[i]:Remove()
		end
	end

	newpart:FindFirstChild(&quot;Goal&quot;).Value = newpart:FindFirstChild(&quot;Goal&quot;).Value + 1

	part.Position = part.Position + Vector3.new(0,0,-5)
	part.Size = part.Size - Vector3.new( math.random(0,1),math.random(0,1),math.random(0,1))

	for i = 1, (partmass / 3) do
	--for i = 1, partmass do
		new = newpart:Clone()
		new.Parent = script.Parent:FindFirstChild(&quot;Belt&quot;)
		new.Size = Vector3.new(1,1,1)
		new.Position = new.Position + Vector3.new(    (math.random(1,3)-2) , (math.random(1,3)-2) , (math.random(1,3)-2) )
		wait()
	end

	if partmass &gt; 3 then
		part:Remove()
	end

	script.Parent.Parent:FindFirstChild(&quot;Cutter1&quot;):FindFirstChild(&quot;Cutter&quot;).BrickColor = BrickColor.new(11)

end

function dogoal3(part)
	if script.Parent.Parent:FindFirstChild(&quot;Polisher1&quot;) == nil then return end
	script.Parent.Parent:FindFirstChild(&quot;Polisher1&quot;):FindFirstChild(&quot;Cutter&quot;).BrickColor = BrickColor.new(21)
	part.Reflectance = 0.7
	wait()
	script.Parent.Parent:FindFirstChild(&quot;Polisher1&quot;):FindFirstChild(&quot;Cutter&quot;).BrickColor = BrickColor.new(11)
end

function dogoal4(part)
	if script.Parent.Parent:FindFirstChild(&quot;PhaseInducer1&quot;) == nil then return end
	script.Parent.Parent:FindFirstChild(&quot;PhaseInducer1&quot;):FindFirstChild(&quot;Cutter&quot;).BrickColor = BrickColor.new(21)
	part.Transparency = 0.5
	wait()
	script.Parent.Parent:FindFirstChild(&quot;PhaseInducer1&quot;):FindFirstChild(&quot;Cutter&quot;).BrickColor = BrickColor.new(11)

end

function dogoal5(part)
	

end

function dogoal6(part)
end
function dogoal7(part)
end
function dogoal8(part)

	hit = part
	money = script.Parent.Parent.Cashobject.Money

	if hit.Name == &quot;TycoonBrick&quot; then

	if hit.Transparency &gt; 0 then
		money.Value = money.Value + 10
	end

	if hit.Reflectance &gt; 0 then
		money.Value = money.Value + 10
	end

	hit:remove()

	money.Value = money.Value + 10

	end

	if hit.Name == &quot;Gem1&quot; then
	money.Value = money.Value + 200
	hit:remove()
	end

	if hit.Name == &quot;Gem2&quot; then
	money.Value = money.Value + 100
	hit:remove()
	end


	if hit ~= nil then
	if hit.Parent == nil then
		hit:remove()
	end
	end

	print(&quot;Cash in&quot;)

end

while true do

	bricks = script.Parent:FindFirstChild(&quot;Belt&quot;):GetChildren()
	

	if bricks ~= nil then
		for i = 1, #bricks do
			if bricks[i]:FindFirstChild(&quot;Goal&quot;) ~= nil then
				if bricks[i]:FindFirstChild(&quot;Goal&quot;).Value == 1 then
					targpos = script.Parent:FindFirstChild(&quot;Goal1&quot;).Position + Vector3.new(0,1,0)
				end
				if bricks[i]:FindFirstChild(&quot;Goal&quot;).Value == 2 then
					targpos = script.Parent:FindFirstChild(&quot;Goal2&quot;).Position + Vector3.new(0,1,0)
				end
				if bricks[i]:FindFirstChild(&quot;Goal&quot;).Value == 3 then
					targpos = script.Parent:FindFirstChild(&quot;Goal3&quot;).Position + Vector3.new(0,1,0)
				end
				if bricks[i]:FindFirstChild(&quot;Goal&quot;).Value == 4 then
					targpos = script.Parent:FindFirstChild(&quot;Goal4&quot;).Position + Vector3.new(0,1,0)
				end
				if bricks[i]:FindFirstChild(&quot;Goal&quot;).Value == 5 then
					targpos = script.Parent:FindFirstChild(&quot;Goal5&quot;).Position + Vector3.new(0,1,0)
				end
				if bricks[i]:FindFirstChild(&quot;Goal&quot;).Value == 6 then
					targpos = script.Parent:FindFirstChild(&quot;Goal6&quot;).Position + Vector3.new(0,1,0)
				end
				if bricks[i]:FindFirstChild(&quot;Goal&quot;).Value == 7 then
					targpos = script.Parent:FindFirstChild(&quot;Goal7&quot;).Position + Vector3.new(0,1,0)
				end
				if bricks[i]:FindFirstChild(&quot;Goal&quot;).Value == 8 then
					targpos = script.Parent:FindFirstChild(&quot;Goal8&quot;).Position + Vector3.new(0,1,0)
				end

				offset = targpos - bricks[i].Position
				dist = offset.magnitude
				if dist &lt; 2 then
					if bricks[i]:FindFirstChild(&quot;Goal&quot;).Value == 1 then
						dogoal1(bricks[i])
					end
					if bricks[i]:FindFirstChild(&quot;Goal&quot;).Value == 2 then
						dogoal2(bricks[i])
					end
					if bricks[i] ~= nil then
					if bricks[i]:FindFirstChild(&quot;Goal&quot;) ~= nil then
					if bricks[i]:FindFirstChild(&quot;Goal&quot;).Value == 3 then
						dogoal3(bricks[i])
					end
					end
					end
					if bricks[i] ~= nil then
					if bricks[i]:FindFirstChild(&quot;Goal&quot;) ~= nil then
					if bricks[i]:FindFirstChild(&quot;Goal&quot;).Value == 4 then
						dogoal4(bricks[i])
					end
					end
					end

					if bricks[i] ~= nil then
					if bricks[i]:FindFirstChild(&quot;Goal&quot;) ~= nil then
					if bricks[i]:FindFirstChild(&quot;Goal&quot;).Value == 5 then
						dogoal5(bricks[i])
					end
					end
					end


					if bricks[i] ~= nil then
					if bricks[i]:FindFirstChild(&quot;Goal&quot;) ~= nil then
					if bricks[i]:FindFirstChild(&quot;Goal&quot;).Value == 6 then
						dogoal6(bricks[i])
					end
					end
					end
					if bricks[i] ~= nil then
					if bricks[i]:FindFirstChild(&quot;Goal&quot;) ~= nil then
					if bricks[i]:FindFirstChild(&quot;Goal&quot;).Value == 7 then
						dogoal7(bricks[i])
					end
					end
					end
					if bricks[i] ~= nil then
					if bricks[i]:FindFirstChild(&quot;Goal&quot;) ~= nil then
					if bricks[i]:FindFirstChild(&quot;Goal&quot;).Value == 8 then
						dogoal8(bricks[i])
					end
					end
					end

					if bricks[i] ~= nil then
						if bricks[i]:FindFirstChild(&quot;Goal&quot;) ~= nil then
							bricks[i]:FindFirstChild(&quot;Goal&quot;).Value = bricks[i]:FindFirstChild(&quot;Goal&quot;).Value + 1
						end
					end
				end


				xchange = 0
				ychange = 0
				zchange = 0
				if targpos ~= nil then

					diff = bricks[i].Position.x - targpos.x
					if bricks[i].Position.x &gt; targpos.x then
						if diff &gt; 0.99 or diff &lt; -0.99 then
						xchange = -1
						end
					end
					if bricks[i].Position.x &lt; targpos.x then
						if diff &gt; 0.99 or diff &lt; -0.99 then
						xchange = 1
						end
					end

					diff = bricks[i].Position.y - targpos.y
					if bricks[i].Position.y &gt; targpos.y then
						if diff &gt; 0.99 or diff &lt; -0.99 then
						ychange = -1
						end
					end
					if bricks[i].Position.y &lt; targpos.y then
						if diff &gt; 0.99 or diff &lt; -0.99 then
						ychange = 1
						end
					end

					diff = bricks[i].Position.z - targpos.z
					if bricks[i].Position.z &gt; targpos.z then
						if diff &gt; 0.99 or diff &lt; -0.99 then
						zchange = - 1
						end
					end
					if bricks[i].Position.z &lt; targpos.z then
						if diff &gt; 0.99 or diff &lt; -0.99 then
						zchange = 1
						end
					end

				end
				xchange = xchange + ((math.random(1,3)-2) / 10)
				ychange = ychange + ((math.random(1,3)-2) / 10)
				zchange = zchange + ((math.random(1,3)-2) / 10)

				bricks[i].Position = Vector3.new(bricks[i].Position.x + xchange, bricks[i].Position.y + ychange, bricks[i].Position.z + zchange)

			end
		end

	end


	wait()

end
