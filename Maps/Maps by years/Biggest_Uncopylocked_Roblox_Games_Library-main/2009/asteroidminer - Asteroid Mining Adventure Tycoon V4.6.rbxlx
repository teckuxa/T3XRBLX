						<string name="Name">Script</string>
						<string name="Source">local debounce = false

function ontouch(part)

	print(&quot;touch&quot;)

	if debounce == true then return end

	debounce = true

	objects = game.Workspace:GetChildren()
	for i = 1, #objects do
		if objects[i].Name == &quot;Tycoon&quot; then
			if objects[i]:FindFirstChild(&quot;OwnerName&quot;) ~= nil then
				if objects[i]:FindFirstChild(&quot;OwnerName&quot;).Value == part.Parent.Name then
					newloc = objects[i]:FindFirstChild(&quot;spawn&quot;)
					if newloc ~= nil then
						newcframe = newloc.CFrame
							if part.Parent:FindFirstChild(&quot;Torso&quot;) ~= nil then
								part.Parent:FindFirstChild(&quot;Torso&quot;).CFrame = newcframe + Vector3.new(0,2,0)
								wait(2)
								debounce = false
								return
							end
					end
				end
			end
		end
	end


	if game.Workspace:FindFirstChild(&quot;Become Owner&quot;,true) ~= nil then
	newloc = game.Workspace:FindFirstChild(&quot;Become Owner&quot;,true):FindFirstChild(&quot;Head&quot;)
	if newloc ~= nil then
		newcframe = newloc.CFrame
		if part.Parent:FindFirstChild(&quot;Torso&quot;) ~= nil then
		part.Parent:FindFirstChild(&quot;Torso&quot;).CFrame = newcframe + Vector3.new(0,2,0)
		end
	end
	end
	wait(2)
	debounce = false
end

