						<Item class="Script" referent="RBX1537">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<string name="Source">function Clicked()
	if script.Parent.Parent.Parent.Name ~= &quot;Jetpack Set&quot; then
	if script.Parent.Parent.On.Value == true then
		script.Parent.Parent.On.Value = false
		script.Parent.Parent.Flame1.Transparency = 1
		script.Parent.Parent.Flame2.Transparency = 1
		if script.Parent.Parent.Pack:findFirstChild(&quot;BodyVelocity&quot;) ~= nil then
			script.Parent.Parent.Pack.BodyVelocity:remove()
		end
		if script.Parent.Parent.OwnerModel.Value:findFirstChild(&quot;Torso&quot;) ~= nil then
			if script.Parent.Parent.OwnerModel.Value.Torso:findFirstChild(&quot;BodyVelocity&quot;) ~= nil then
				script.Parent.Parent.OwnerModel.Value.Torso.BodyVelocity:remove()
			end
		end
	else
		script.Parent.Parent.On.Value = true
		script.Parent.Parent.Flame1.Transparency = 0.3
		script.Parent.Parent.Flame2.Transparency = 0.3
		local BV = Instance.new(&quot;BodyVelocity&quot;)
		BV.Parent = script.Parent.Parent.Pack
		BV.velocity = Vector3.new(0, (5 * script.Parent.Parent.Mode.Value), 0)
		BV.maxForce = Vector3.new(0, 4e+003, 0)
		local BV = Instance.new(&quot;BodyVelocity&quot;)
		BV.Parent = script.Parent.Parent.OwnerModel.Value.Torso
		BV.velocity = Vector3.new(0, (5 * script.Parent.Parent.Mode.Value), 0)
		BV.maxForce = Vector3.new(0, 4e+003, 0)
	end
	end
end
script.Parent.ClickDetector.MouseClick:connect(Clicked)
