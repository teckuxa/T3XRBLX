							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<string name="Source">while true do
wait()
local P = script.Parent:GetChildren()
	if #P ~= 9 then
		if script.Parent.Parent.Name == &quot;Jetpack Set&quot; then
			script.Parent:remove()
		end
		if script.Parent.OwnerModel.Value:findFirstChild(&quot;Torso&quot;) ~= nil then
			if script.Parent.Parent.Torso:findFirstChild(&quot;BodyVelocity&quot;) ~= nil then
				script.Parent.Parent.Torso.BodyVelocity:remove()
			end
		end
		if script.Parent:findFirstChild(&quot;Pack&quot;) ~= nil then
			if script.Parent.Pack:findFirstChild(&quot;BodyVelocity&quot;) ~= nil then
				script.Parent.Pack.BodyVelocity:remove()
			end
		end
		if script.Parent:findFirstChild(&quot;Pack&quot;) == nil then
			script.Parent:remove()
		end
	end
end
