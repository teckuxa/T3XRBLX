						<Item class="Script" referent="RBX6612">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">GetCash</string>
								<string name="Source">function onTouched(part)
	local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if (h~=nil) then
		local owner = script.Parent.Parent.Parent.Parent.OwnerName
		if h.Parent.Name == owner.Value then --If the one who pressed the button is the owner then
			local thisplr = game.Players:findFirstChild(h.Parent.Name)
			if (thisplr~=nil) then
				local stats = thisplr:findFirstChild(&quot;leaderstats&quot;)
				if (stats~=nil) then


					local income = stats:findFirstChild(&quot;Income&quot;)
					if (income ~= nil) then
						income.Value = income.Value + script.Parent.Parent.Parent.Money.Value
					end
					local score = stats:findFirstChild(&quot;Cash&quot;)
					if (score~=nil) then
						score.Value = score.Value + script.Parent.Parent.Parent.Money.Value
					end
					script.Parent.Parent.Parent.Money.Value = 0

				end
			end
		end
	end
end

script.Parent.Touched:connect(onTouched)
</string>
								<bool name="archivable">true</bool>
							</Properties>
						</Item>
