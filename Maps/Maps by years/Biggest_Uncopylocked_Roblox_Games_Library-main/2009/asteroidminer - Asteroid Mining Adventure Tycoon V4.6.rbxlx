							<string name="Name">CloakScript</string>
							<string name="Source">--[[ 
Created By TGazza


]]--
parts = {}
num = 1;

function isValidPart(part)	-- returns className if its a part or model otherwise returns false
	if part.className == &quot;Part&quot;or part.className == &quot;Seat&quot; or part.className == &quot;Model&quot; then
		return part.className
	end
      return false -- not a part or an model
end

function retriveParts(model)
	local raw_model = model:GetChildren()
        for i=1,#raw_model do
           if(isValidPart(raw_model[i])) then
		if(raw_model[i].className == &quot;Model&quot;) then
			retriveParts(raw_model[i]);
		else
			parts[num] = raw_model[i];
			num = num + 1;
		end
           end
        end
       return parts;
end

function retriveHat(plr)
   local bits = plr:GetChildren()
   for b=1,#bits do
	if(bits[b].className == &quot;Hat&quot;) then
		return bits[b]
	end
   end
	return nil
end

function test()
	local player = script.Parent.Parent;
	local parts = retriveParts(player)
	local Cloak = script.Parent.Cloaked.Value;
	local body = player:FindFirstChild(&quot;Torso&quot;);
	local head = player:FindFirstChild(&quot;Head&quot;);
	local Hat = retriveHat(player)

	for c = 0,1, 0.1 do
		for i=1, #parts do
			if(Cloak == 1) then
				if(parts[i].Shape.Value ~= 1) then
					if(parts[i]:findFirstChild(&quot;isShape&quot;) == nil) then
						local ShapeTag = Instance.new(&quot;StringValue&quot;)
						ShapeTag.Name = &quot;isShape&quot;
						ShapeTag.Parent = parts[i]
						ShapeTag.Value = parts[i].Shape.Value
					end
					parts[i].Shape = 1;
				end
				parts[i].Transparency = c
				if(parts[i].Transparency &gt;= 0.9)then 
					parts[i].Transparency=1
 				end
			else
				if (parts[i]:findFirstChild(&quot;isShape&quot;) ~= nil) then
					parts[i].Shape = parts[i].isShape.Value;
				end			
				parts[i].Transparency = 1-c
				if(parts[i].Transparency &lt;= 0.1)then 
					parts[i].Transparency=0;
				end
			end
		end
		wait(.1)
	end
	if (body ~= nil) then
		bodyshirt = body:FindFirstChild(&quot;roblox&quot;)
		if (bodyshirt ~= nil) then
			backupshirt = bodyshirt:clone()
		end
	end
	if (head ~= nil) then
		bodyface = head:FindFirstChild(&quot;face&quot;)
		if (bodyface ~= nil) then
			backupface = bodyface:clone()
		end
	end
	if (script.Parent.Cloaked.Value == 1) then
		body = player:FindFirstChild(&quot;Torso&quot;)
		head = player:FindFirstChild(&quot;Head&quot;)
		
		if (body ~= nil) then
			bodyshirt = body:FindFirstChild(&quot;roblox&quot;)
			if (bodyshirt ~= nil) then
				bodyshirt:Remove()
				backupshirt = bodyshirt:clone()
			end
		end
		if (head ~= nil) then
			bodyface = head:FindFirstChild(&quot;face&quot;)
			if (bodyface ~= nil) then
				bodyface:Remove()
				backupface = bodyface:clone()
			end
		end
		if(Hat ~= nil) then
			Hat:Remove();
		end
	end

	if (script.Parent.Cloaked.Value == 0) then
		body = player:FindFirstChild(&quot;Torso&quot;)
		head = player:FindFirstChild(&quot;Head&quot;)
		if (body ~= nil) then
			bodyshirt = body:FindFirstChild(&quot;roblox&quot;)
			if (bodyshirt == nil) and (backupshirt ~= nil) then
				bodyshirt = backupshirt:clone()
				bodyshirt.Parent = player.Torso
			end
		end
		if (head ~= nil) then
			bodyface = head:FindFirstChild(&quot;face&quot;)
			if (bodyface == nil) and (backupface ~= nil) then
				bodyface = backupface:clone()
				bodyface.Parent = player.Head
			end
		end
	end
end
local active = true
while active==true do -- loop twice if Cloaked is nil
	if(script.Parent:findFirstChild(&quot;Cloaked&quot;) ~= nil) then
		script.Parent.Cloaked.changed:connect(test)
		active = false
	else
		temp = Instance.new(&quot;IntValue&quot;)
		temp.Name=&quot;Cloaked&quot;
		temp.Parent = script.Parent;
	end
end
