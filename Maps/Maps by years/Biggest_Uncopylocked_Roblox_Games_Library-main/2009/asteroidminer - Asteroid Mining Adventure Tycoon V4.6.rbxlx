						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<string name="Source">copy = script.Parent.Parent:Clone()

name = script.Parent
owner = name.Parent.OwnerName

while true do
	if owner.Value ~= &quot;&quot; then
		name.Name = &quot;Asteroid Mine Owner : &quot; .. owner.Value
		if game.Players:FindFirstChild(owner.Value) == nil then
			script.Parent.Parent:Remove()
			copy.Parent = game.Workspace
			copy:MakeJoints()
			copy:FindFirstChild(&quot;OwnerName&quot;).Value = &quot;&quot;
		end
	else
		name.Name = &quot;Asteroid Mine Owner : No One&quot;
	end
	wait(2)

end
