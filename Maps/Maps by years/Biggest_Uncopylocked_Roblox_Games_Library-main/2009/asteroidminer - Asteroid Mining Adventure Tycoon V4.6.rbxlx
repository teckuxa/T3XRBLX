					<Item class="Script" referent="RBX4534">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<string name="Source">local lol = false

function ontouch(part)
if lol == false then

	if part.Parent == nil then return end
	if part.Parent:FindFirstChild(&quot;Humanoid&quot;) == nil then return end

	cashobject = game.Players:FindFirstChild(part.Parent.Name).leaderstats.Cash
	if cashobject.Value &gt; 499 then
	lol = true
	b = script.Parent.Parent.Brick:clone()
	b.Anchored = false
	b.Parent = script.Parent.Parent.Parent
	b.Name = &quot;BrickClone&quot;
	b.Position = script.Parent.Parent.Dispensor.Position
	b.Locked = false
	cashobject.Value = cashobject.Value - 500
	wait(1)
	lol = false
	end
end
end

script.Parent.Touched:connect(ontouch)
</string>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
				</Item>
