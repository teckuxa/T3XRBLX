					</Properties>
				</Item>
				<Item class="Script" referent="RBX4745">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<string name="Source">while true do
	wait(2)
	count = 0
	things = game.Workspace:GetChildren()
	for i = 1, #things do
		if things[i].Name == &quot;Alien2&quot; then
			count = count + 1
		end
	end
	if count &lt; 2 then
		new = game.Lighting.Alien2:Clone()
		new.Parent = game.Workspace
		new:MakeJoints()
		spot = math.random(1,3)
		if spot == 1 then
			new:MoveTo(script.Parent.Parent.spot1.Position)
		end
		if spot == 2 then
			new:MoveTo(script.Parent.Parent.spot2.Position)
		end
		if spot == 3 then
			new:MoveTo(script.Parent.Parent.spot3.Position)
		end


	end

end
</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
