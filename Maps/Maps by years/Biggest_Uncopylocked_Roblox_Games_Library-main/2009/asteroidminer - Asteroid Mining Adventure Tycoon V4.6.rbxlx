						<Item class="Script" referent="RBX5190">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<string name="Source">function fire()
     local p = Instance.new(&quot;Part&quot;)
     p.Position = script.Parent.Position + Vector3.new(0,-4,0)
   p.Size = Vector3.new(math.random(1,3),math.random(1,3),math.random(1,3))
   p.BrickColor = BrickColor.new(math.random(28))
     p.Name = &quot;TycoonBrick&quot; --DO NOT CHANGE/REMOVE
	p.Anchored = true
	intval = Instance.new(&quot;IntValue&quot;)
	intval.Name = &quot;Goal&quot;
	intval.Value = 1
	intval.Parent = p
	p.CanCollide = false

	--if math.random(1,100) &lt; 50 then
	--	new = script.Parent.Parent.Meshholder.rockmesh:Clone()
	--	new.Parent = p
	--end
	choice = math.random(1,100)
	if choice &lt; 5 then
		new = script.Parent.Parent.Meshholder.Mesh1:Clone()
		new.Parent = p
		p.Size = Vector3.new(2,3,1)
		p.Reflectance = 0.1
		p.Transparency = 0.2
		p.Name = &quot;Gem1&quot;
	else
		if choice &lt; 15 then
		new = script.Parent.Parent.Meshholder.Mesh2:Clone()
		new.Parent = p
		p.Size = Vector3.new(1,0.5,1)
		p.Reflectance = 0.2
		p.Transparency = 0
		p.Name = &quot;Gem2&quot;
		else
			if math.random(1,2) == 1 then
				new = script.Parent.Parent.Meshholder.rockmesh:Clone()
				new.Parent = p
			end
		end
	end


     p.BottomSurface = 0
     p.TopSurface = 0
     p.Parent = script.Parent.Parent.Parent:FindFirstChild(&quot;Conveyor&quot;):FindFirstChild(&quot;Belt&quot;)
end 


while true do
     wait(5) --Alter Rate Of Drop
     fire()
end
</string>
