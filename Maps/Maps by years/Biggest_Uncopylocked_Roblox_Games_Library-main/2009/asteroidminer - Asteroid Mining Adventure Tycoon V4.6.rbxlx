							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<string name="Source">function ontouch(part)
	if part ~= nil then
	if part.Parent == nil then
		part:Remove()
	else
		if part.Parent:FindFirstChild(&quot;Humanoid&quot;) == nil and if part.Parent:FindFirstChild(&quot;Alien&quot;) == nil then
			part.Parent:Remove()
		end
	end
	end
end

script.Parent.Touched:connect(ontouch)</string>
							<bool name="archivable">true</bool>
