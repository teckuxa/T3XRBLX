				<Item class="Script" referent="RBX5038">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">MakeSoda</string>
						<string name="Source">co = script.Parent.BrickColor


function onClicked()
	local drink = Instance.new(&quot;Part&quot;)
	script.Parent.BrickColor = BrickColor:new(1)
	wait(1)
	script.Parent.BrickColor = co
	drink.Position = script.Parent.Parent.SodaSpawn.Position
	drink.Size = Vector3.new(1,1,1)
	drink.BrickColor = co
	drink.Shape = 2
	drink.BottomSurface = 0
	drink.TopSurface = 0
	drink.Reflectance = 0.2
	drink.Name = &quot;Soda&quot;
	drink.Locked = true
	drink.Parent = game.Workspace
	wait(10)
	drink:remove()

end

script.Parent.ClickDetector.MouseClick:connect(onClicked)
</string>
