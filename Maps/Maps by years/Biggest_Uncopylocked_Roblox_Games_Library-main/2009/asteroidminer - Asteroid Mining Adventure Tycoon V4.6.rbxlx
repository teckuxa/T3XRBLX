					<string name="Name">TeleportScript</string>
					<string name="Source">-- This script was made by Dued1 &lt;&lt;&lt; See. Kreds 2 this guy. Edited buy RoboSanta --

bin = script.Parent

enabled = true

function onButton1Down(mouse)
	if not enabled then
		return
	end

	print(&quot;Start Copy&quot;)
	local player = game.Players.LocalPlayer
	if player == nil then return end
		
	enabled = false
	mouse.Icon = &quot;rbxasset://textures\\ArrowFarCursor.png&quot;

if (mouse.Target ~= nil) and (mouse.Target.Locked == false) then

	cashobject = game.Players:FindFirstChild(game.Players.LocalPlayer.Name).leaderstats.Cash
	objs = game.Workspace:GetChildren()
	for i = 1, #objs do
		if objs[i].Name == &quot;Tycoon&quot; then
			if objs[i]:FindFirstChild(&quot;OwnerName&quot;) ~= nil then
				if objs[i]:FindFirstChild(&quot;OwnerName&quot;).Value == game.Players.LocalPlayer.Name then
					tycoon = objs[i]

					break
				end
			end
		end
	end
	
	if tycoon ~= nil and cashobject ~= nil and cashobject.Value &gt; 249 then
		new = mouse.Target:Clone()
		new.Parent = tycoon
		cashobject.Value = cashobject.Value - 250
	end


end
		wait(0.01337)
	mouse.Icon = &quot;rbxasset://textures\\ArrowCursor.png&quot;
	enabled = true
	print(&quot;End Copy&quot;)

end

function onSelected(mouse)
	 b = Instance.new(&quot;Message&quot;)
               b.Parent = script.Parent.Parent.Parent
               b.Text = &quot;Copy Brick&quot;
     
        h = Instance.new(&quot;Hint&quot;)
               h.Parent = script.Parent.Parent.Parent
               h.Text = &quot;Copy costs 500&quot; 
               h.Name = &quot;Hint&quot;
        mouse.Icon = &quot;rbxasset://textures\\ArrowCursor.png&quot;
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
 
end

bin.Selected:connect(onSelected)

function onDeS(mouse) 
script.Parent.Parent.Parent.Hint:remove() 
script.Parent.Parent.Parent.Message:remove() 
end 
script.Parent.Deselected:connect(onDeS)
</string>
