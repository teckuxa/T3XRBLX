	script.Parent.Parent.Mode.Value = script.Parent.Parent.Mode.Value * -1
	if script.Parent.Parent.Pack:findFirstChild(&quot;BodyVelocity&quot;) ~= nil then
		script.Parent.Parent.Pack.BodyVelocity.velocity = Vector3.new(0, (5 * script.Parent.Parent.Mode.Value), 0)
	end
	if script.Parent.Parent.OwnerModel.Value:findFirstChild(&quot;Torso&quot;) ~= nil then
		if script.Parent.Parent.OwnerModel.Value.Torso:findFirstChild(&quot;BodyVelocity&quot;) ~= nil then
			script.Parent.Parent.OwnerModel.Value.Torso.BodyVelocity.velocity = Vector3.new(0, (5 * script.Parent.Parent.Mode.Value), 0)
		end
	end
	end
end
script.Parent.ClickDetector.MouseClick:connect(Clicked)
</string>
								<bool name="archivable">true</bool>
							</Properties>
						</Item>
					</Item>
					<Item class="Script" referent="RBX2453">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<string name="Source">while true do
wait()
local P = script.Parent:GetChildren()
	if #P ~= 9 then
		if script.Parent.Parent.Name == &quot;Jetpack Set&quot; then
			script.Parent:remove()
		end
		if script.Parent.OwnerModel.Value:findFirstChild(&quot;Torso&quot;) ~= nil then
			if script.Parent.Parent.Torso:findFirstChild(&quot;BodyVelocity&quot;) ~= nil then
				script.Parent.Parent.Torso.BodyVelocity:remove()
			end
		end
		if script.Parent:findFirstChild(&quot;Pack&quot;) ~= nil then
			if script.Parent.Pack:findFirstChild(&quot;BodyVelocity&quot;) ~= nil then
				script.Parent.Pack.BodyVelocity:remove()
			end
		end
		if script.Parent:findFirstChild(&quot;Pack&quot;) == nil then
			script.Parent:remove()
		end
	end
end
