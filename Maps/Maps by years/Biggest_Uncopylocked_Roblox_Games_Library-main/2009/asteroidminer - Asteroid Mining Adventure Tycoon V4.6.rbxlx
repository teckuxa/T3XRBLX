			<Item class="Script" referent="RBX7015">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<string name="Source">---------------------------------------------------------
rotation = 16 -- # clicks to make one full turn
---------------------------------------------------------

bin = script.Parent
mode = &quot;free&quot;

function Message(text)
	local m = Instance.new(&quot;Message&quot;)
	m.Text = text
	m.Parent = game.Players.LocalPlayer
	wait(1)
	m:Remove()
end

e = true
function onButton1Down(mouse)
	if not e then return end
	e = false
	local target = mouse.Target
	if target ~= nil then
		if target.Locked == false then
			target.Anchored = true
			if mode == &quot;x&quot; then
				target.CFrame = target.CFrame * CFrame.fromAxisAngle(Vector3.new(1,0,0),math.pi/(rotation/2))
				e = true
			elseif mode == &quot;y&quot; then
				target.CFrame = target.CFrame * CFrame.fromAxisAngle(Vector3.new(0,1,0),math.pi/(rotation/2))
				e = true
			elseif mode == &quot;z&quot; then
				target.CFrame = target.CFrame * CFrame.fromAxisAngle(Vector3.new(0,0,1),math.pi/(rotation/2))
				e = true
			elseif mode == &quot;reset&quot; then
				target.CFrame = CFrame.new(target.Position)
				e = true
			else
				while not e do
					local point = mouse.Hit.p
					target.CFrame = CFrame.new(target.Position,point)
					wait()
				end
			end
		end
	end	
end

function onButton1Up(mouse)
	e = true
end

function onKeyDown(key)
	key = key:lower()
	if key == &quot;x&quot; or key == &quot;y&quot; or key == &quot;z&quot; then
		print(key)
		coroutine.resume(coroutine.create(Message),key:upper())
		mode = key
	elseif key == &quot;f&quot; then
		print(&quot;free&quot;)
		coroutine.resume(coroutine.create(Message),&quot;Free Rotate&quot;)
		mode = &quot;free&quot;
	elseif key == &quot;r&quot; then
		print(&quot;reset&quot;)
		coroutine.resume(coroutine.create(Message),&quot;Reset&quot;)
		mode = &quot;reset&quot;
	end
end

function onSelected(mouse)
	local c = game.Players.LocalPlayer:GetChildren()
	for i = 1,#c do
		if c[i].Name == &quot;Message&quot; then
			c[i]:Remove()
		end
	end

	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
	mouse.Button1Up:connect(function() onButton1Up(mouse) end)
	mouse.KeyDown:connect(onKeyDown)

	local h = Instance.new(&quot;Hint&quot;)
	h.Parent = game.Players.LocalPlayer
	h.Text = &quot;Key:   X,Y,Z: Rotate respective vector;   F: Free Rotate;   R: Reset CFrame;   Click: Apply to brick&quot;
	wait(3)
	h:Remove()
end

bin.Selected:connect(onSelected)
</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
		</Item>
		<Item class="HopperBin" referent="RBX7016">
			<Properties>
				<token name="BinType">0</token>
				<string name="Name">Shield</string>
				<Content name="TextureId"><null></null></Content>
				<bool name="archivable">true</bool>
			</Properties>
			<Item class="Script" referent="RBX7017">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Reset Script</string>
					<string name="Source">--clockwork

bin = script.Parent

function onSelected(mouse)
	player = game.Players.LocalPlayer.Character

	shield = script.Parent:FindFirstChild(&quot;ForceField&quot;):Clone()
	shield.Parent = player.Torso
	shield2 = script.Parent:FindFirstChild(&quot;ForceField&quot;):Clone()
	shield2.Parent = player.Head

	shield3 = script.Parent:FindFirstChild(&quot;ForceField&quot;):Clone()
	shield3.Parent = player:FindFirstChild(&quot;Left Leg&quot;)
	shield4 = script.Parent:FindFirstChild(&quot;ForceField&quot;):Clone()
	shield4.Parent = player:FindFirstChild(&quot;Right Leg&quot;)
	shield5 = script.Parent:FindFirstChild(&quot;ForceField&quot;):Clone()
	shield5.Parent = player:FindFirstChild(&quot;Right Arm&quot;)
	shield6 = script.Parent:FindFirstChild(&quot;ForceField&quot;):Clone()
	shield6.Parent = player:FindFirstChild(&quot;Left Arm&quot;)

end

function onDeselected(mouse)
	
	player = game.Players.LocalPlayer.Character

	player:FindFirstChild(&quot;Torso&quot;):FindFirstChild(&quot;ForceField&quot;):Remove()
	player:FindFirstChild(&quot;Head&quot;):FindFirstChild(&quot;ForceField&quot;):Remove()
	player:FindFirstChild(&quot;Left Arm&quot;):FindFirstChild(&quot;ForceField&quot;):Remove()
	player:FindFirstChild(&quot;Right Arm&quot;):FindFirstChild(&quot;ForceField&quot;):Remove()
	player:FindFirstChild(&quot;Left Leg&quot;):FindFirstChild(&quot;ForceField&quot;):Remove()
	player:FindFirstChild(&quot;Right Leg&quot;):FindFirstChild(&quot;ForceField&quot;):Remove()

end

bin.Selected:connect(onSelected)
bin.Deselected:connect(onDeselected)
