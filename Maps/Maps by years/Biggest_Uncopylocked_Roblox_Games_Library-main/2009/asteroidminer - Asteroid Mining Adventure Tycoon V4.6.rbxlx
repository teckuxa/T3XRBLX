		<Item class="HopperBin" referent="RBX7003">
			<Properties>
				<token name="BinType">0</token>
				<string name="Name">Copy</string>
				<Content name="TextureId"><url>http://www.roblox.com/asset/?id=2259961</url></Content>
				<bool name="archivable">true</bool>
			</Properties>
			<Item class="Script" referent="RBX7004">
