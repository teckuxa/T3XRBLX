							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<string name="Source">-------------------------------------------------------------------------------------------------------------------------
Upgradecost = 5000   --This is what you want it to cost. the Example costs 100 cash.
-------------------------------------------------------------------------------------------------------------------------

wait(1)

local ting = 0

function onTouched(hit)
	if ting == 0 then
	ting = 1
	check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)

	if check ~= nil then
		local user = game.Players:GetPlayerFromCharacter(hit.Parent)
		local stats = user:findFirstChild(&quot;leaderstats&quot;)

		if stats ~= nil then
			local cash = stats:findFirstChild(&quot;Cash&quot;)
			if cash.Value &gt; (Upgradecost-1) then

				cash.Value = cash.Value - Upgradecost

				hub = game.Lighting.Hub:Clone()
				hub.Parent = game.Workspace
				hub:MakeJoints()
				mycenter = script.Parent.Parent.Parent.center.Position
				newspot = mycenter + Vector3.new(0,-1,-42)
				hub:MoveTo(newspot)
				
				--newcenter = hub.center.Position
				--hub:MoveTo(Vector3.new(newcenter.x,(newcenter.y - mycenter.y),newcenter.z))

				script.Parent.Parent:Remove()

			end
		end
	end

	ting = 0
	end
end

script.Parent.Touched:connect(onTouched)
