								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<string name="Source">-------------------------------------------------------------------------------------------------------------------------
model = script.Parent.Parent.Parent.Extractor2   --This is the MODELNAME. you made a desk in the instructions SO name the part called MODELNAME to &quot;Desk&quot;. Then change price to what you want.
Upgradecost = 10000   --This is what you want it to cost. the Example costs 100 cash.
-------------------------------------------------------------------------------------------------------------------------
upgradeStuff = model:clone()

wait(1)

model:remove()
owner = script.Parent.Parent.Parent.OwnerName 
local ting = 0

function onTouched(hit)
	if ting == 0 then
	ting = 1
	check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)

	if check ~= nil then
	if hit.Parent.Name == owner.Value then
		local user = game.Players:GetPlayerFromCharacter(hit.Parent)
		local stats = user:findFirstChild(&quot;leaderstats&quot;)

		if stats ~= nil then
			local cash = stats:findFirstChild(&quot;Cash&quot;)
			if cash.Value &gt; (Upgradecost-1) then

				cash.Value = cash.Value - Upgradecost
				upgradeStuff.Parent = script.Parent.Parent.Parent
				script.Parent.Parent:remove()

			end
		end
	end
	end

	ting = 0
	end
end

script.Parent.Touched:connect(onTouched)
