					<Item class="Script" referent="RBX1000">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<string name="Source">function ontouch(part)

	if part.Parent:FindFirstChild(&quot;Humanoid&quot;) == nil then return end

	print(&quot;teleporter reset&quot;)
	if script.Parent.Parent.Parent:FindFirstChild(&quot;Teleporter1&quot;) ~= nil then
		script.Parent.Parent.Parent:FindFirstChild(&quot;Teleporter1&quot;):Remove()
	end
	if script.Parent.Parent.Parent:FindFirstChild(&quot;Teleporter2&quot;) ~= nil then
		script.Parent.Parent.Parent:FindFirstChild(&quot;Teleporter2&quot;):Remove()
	end
	if script.Parent.Parent.Parent:FindFirstChild(&quot;Teleporter3&quot;) ~= nil then
		script.Parent.Parent.Parent:FindFirstChild(&quot;Teleporter3&quot;):Remove()
	end

	copy = game.Lighting:FindFirstChild(&quot;Teleporter1&quot;):Clone()
	copy2 = game.Lighting:FindFirstChild(&quot;Teleporter2&quot;):Clone()
	copy3 = game.Lighting:FindFirstChild(&quot;Teleporter3&quot;):Clone()

	copy.Parent = script.Parent.Parent.Parent
	copy2.Parent = script.Parent.Parent.Parent
	copy3.Parent = script.Parent.Parent.Parent
	print(&quot;teleporter reset done&quot;)

end

