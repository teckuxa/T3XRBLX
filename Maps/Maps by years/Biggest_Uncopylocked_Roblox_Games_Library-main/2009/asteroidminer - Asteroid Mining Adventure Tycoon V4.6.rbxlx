				</Properties>
				<Item class="StockSound" referent="RBX6984">
					<Properties>
						<bool name="Looped">false</bool>
						<string name="Name">7r9y910</string>
						<int name="PlayCount">-1</int>
						<bool name="PlayOnRemove">false</bool>
