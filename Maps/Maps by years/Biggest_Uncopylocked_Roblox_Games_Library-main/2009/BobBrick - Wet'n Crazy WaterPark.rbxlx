				<Item class="Script" referent="RBX5578">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">messagetxt = &quot;&quot; -- Leave this blank if you don&apos;t want a message
model = script.Parent.Parent -- Group it with the Model you want regened


newmodel = model:clone()
newmodel.Parent = game.Lighting

function regenerate()
&#9;enabled = true
&#9;if enabled == true then
&#9;&#9;message=Instance.new(&quot;Message&quot;)
&#9;&#9;message.Parent = game.Workspace
&#9;&#9;message.Text = messagetxt
&#9;&#9;model:Remove()
&#9;&#9;wait(1)
&#9;&#9;m = newmodel:clone()
&#9;&#9;m.Parent = game.Workspace
&#9;&#9;m:makeJoints()
&#9;&#9;enabled = false
&#9;end
end

function onTouched(hit)
&#9;h = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;if h ~= nil then
&#9;&#9;regenerate()
&#9;end
end

script.Parent.Touched:connect(onTouched)
&#9;

</ProtectedString>
					</Properties>
				</Item>
