			<Item class="Script" referent="RBX86">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">OpenDoorScript</string>
					<ProtectedString name="Source">function onClicked()
 script.Parent.Transparency = .5 --Makes door transparent. (Note: the number doesn&apos;t matter if it is .5 or 0.5. It is the same. 1 = transparent)
 script.Parent.CanCollide = false --Makes door un-colidable.
wait(20)
 script.Parent.Transparency = 0 --Makes door NON-transparent.
 script.Parent.CanCollide = true --Makes door Collidable (solid).
end

script.Parent.ClickDetector.MouseClick:connect(onClicked)













































--[[~-?Somebody121?-~]]--

--I do this to make sure no one copys. :D</ProtectedString>
