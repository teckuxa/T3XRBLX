		<Item class="Script" referent="RBX509">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">HeadGive</string>
				<ProtectedString name="Source">function spn(NewP)
Part = Instance.new(&quot;Part&quot;)
Part.Name = &quot;Head&quot;
T = Instance.new(&quot;Decal&quot;)
T.Parent = Part
script.Headmesh:clone().Parent = Part
w = Instance.new(&quot;Weld&quot;)
w.Parent = NewP.Character.Head
w.Part0 = w.Parent
w.Part1 = Part
Part.FormFactor = 0
Part.Size = Vector3.new(1,1,1)
Part.Parent = NewP.Character
Part.BrickColor = NewP.Character.Head.BrickColor
NewP.Character.Head.Transparency = 1
end

function A(new)
new.Changed:connect(function(N) if N == &quot;Character&quot; then spn(new) end end)
end


game.Players.ChildAdded:connect(A)</ProtectedString>
