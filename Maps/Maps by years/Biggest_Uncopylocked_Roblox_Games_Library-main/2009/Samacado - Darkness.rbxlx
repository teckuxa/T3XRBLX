						<string name="Name">Sounds</string>
						<ProtectedString name="Source">sounds = {script.Parent.Moan, script.Parent.Growl}

while true do
wait()
	if script.Parent.Parent:findFirstChild(&quot;Zombie&quot;).Health &gt; 0 then
	wait(math.random(1,10))
	sounds[math.random(1, #sounds)]:play()
	end
end
</ProtectedString>
