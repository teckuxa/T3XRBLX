		<Item class="Script" referent="RBX450">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">VIP</string>
				<ProtectedString name="Source">function onPlayerRespawned(newPlayer) 
wait(2) 
		if newPlayer.Character.Torso.roblox.Texture == &quot;http://www.roblox.com/asset/?id=15146873&quot; then 
		clone = game.Lighting.Socom1:clone()
		clone.Parent = newPlayer.Backpack
		newPlayer.Character.Humanoid.MaxHealth = 300
		newPlayer.Character.Humanoid.Health = 300
	end 
end 

function onPlayerAdded(newPlayer) 
newPlayer.Changed:connect(function(property) 
if property == &quot;Character&quot; then 
onPlayerRespawned(newPlayer) 
end 
end) 
end 

game.Players.PlayerAdded:connect(onPlayerAdded)</ProtectedString>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
