			<Item class="Script" referent="RBX2737">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">GunScript</string>
					<ProtectedString name="Source">tool = script.Parent
enabled = true

function computeDirection(vec)	local lenSquared = vec.magnitude^2	local invSqrt = 1 / math.sqrt(lenSquared)	return Vector3.new(vec.x * invSqrt, vec.y * invSqrt, vec.z * invSqrt)
end
function fire(v)
	script.Parent.Bullets.Value = script.Parent.Bullets.Value - 1
	if script.Parent.Bullets.Value &lt;= 0 then
	tool.Handle.Reload:play()
	enabled = false
	while script.Parent.Bullets.Value &lt; 7 do
		wait(5)
		tool.Bullets.Value=tool.Bullets.Value + 6
		enabled = true
		end
	end 
	
	if enabled ~= true then return end
	enabled = false	script.Parent.Handle.Fire:play()
	tool.Parent.Torso:findFirstChild(&quot;Right Shoulder&quot;).CurrentAngle = 3
		local dir = v - script.Parent[&quot;Handle&quot;].Position	dir = computeDirection(dir)	local pos = script.Parent.Handle.Position + (dir * 4)	local p = Instance.new(&quot;Part&quot;)	p.Name = &quot;Projectile&quot;	p.CFrame = CFrame.new(pos, pos + dir)	p.BrickColor = BrickColor.new(24)	p.Reflectance = 0.3	p.Velocity = (script.Parent.Parent[&quot;Head&quot;].Position - v).unit * -160	p.Size = Vector3.new(1, 0.4, 1)	p.formFactor = 2	local mesh = script.Parent.Mesh:clone()	mesh.Parent = p	local upforce = Instance.new(&quot;BodyForce&quot;)	upforce.force = Vector3.new(0, 60, 0)	upforce.Parent = p	local s = script.Parent[&quot;ProjectileScript&quot;]:Clone()	s.Disabled = false	s.Parent = p
	p.Parent = game.Workspace
	tool.Parent.Torso:findFirstChild(&quot;Right Shoulder&quot;).CurrentAngle = 3
	wait(1)
	enabled = true
end

function onActivated()
	if script.Parent.Enabled == true then
			fire(script.Parent.Parent[&quot;Humanoid&quot;].TargetPoint)	endend
script.Parent.Activated:connect(onActivated)script.Parent.Equipped:connect(onEquipped)script.Parent.Unequipped:connect(onUnequipped)</ProtectedString>
