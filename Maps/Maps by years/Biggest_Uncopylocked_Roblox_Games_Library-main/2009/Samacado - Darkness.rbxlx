						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">LocalMelee</string>
						<ProtectedString name="Source">local canmelee = true;
local tool = script.Parent.Parent;

function onKeyDown(key)
	key:lower();
	if key == &quot;v&quot; then
		if canmelee == false then
			return;
		end

		tool.Handle.Melee:play()
		canmelee = false;
		local rgrip = tool.Parent[&quot;Right Arm&quot;].RightGrip;
		script.melee.Value = true;
		for i = 1,6 do
			rgrip.C1 = rgrip.C1 * CFrame.fromEulerAnglesXYZ(-0.55,0,0);
			wait();
		end
		wait(0.25);
		for i = 1, 6 do
			rgrip.C1 = rgrip.C1 * CFrame.fromEulerAnglesXYZ(0.55,0,0);
			wait();
		end
		script.melee.Value = false;
		wait(2);
		canmelee = true;
	end
end

function onSelect(mouse)
	mouse.KeyDown:connect(onKeyDown);
end

tool.Equipped:connect(onSelect);</ProtectedString>
