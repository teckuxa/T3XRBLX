itrs=miked.Torso:findFirstChild(&quot;Right Shoulder&quot;)
itrs.Part1=miked.Torso
itrs.C0=CFrame.new(-2, 0.5, 0, 0, 0, 1, 0, 1, 0, -1, 0, 0)
