wait(0.1)
decal.Texture = noise4
wait(0.1)
decal.Texture = news
wait(3)
decal.Texture = dif
wait(0.5)
decal.Texture = noise4
wait(0.1)
decal.Texture = noise3
wait(0.1)
decal.Texture = noise2
wait(0.1)
decal.Texture = noise1
wait(0.1)
decal.Texture = news
wait(0.3)
decal.Texture = noise1
wait(0.1)
decal.Texture = noise2
wait(0.1)
decal.Texture = noise3
wait(0.1)
decal.Texture = noise4
wait(0.1)
decal.Texture = dif
wait(1.2)
decal.Texture = noise1
wait(0.1)
decal.Texture = noise3
wait(0.1)
decal.Texture = noise4
wait(0.1)
decal.Texture = noise2
wait(0.1)
decal.Texture = noise4
wait(0.1)
decal.Texture = news
wait(1)
decal.Texture = symp
wait(4)
decal.Texture = noise1
wait(0.1)
decal.Texture = noise2
wait(0.1)
decal.Texture = noise3
wait(0.1)
decal.Texture = noise4
wait(0.1)
decal.Texture = symp
wait(0.9)
decal.Texture = dif
wait(1)
decal.Texture = noise1
wait(0.1)
decal.Texture = noise2
wait(0.1)
decal.Texture = noise3
wait(0.1)
decal.Texture = noise4
wait(0.1)
decal.Texture = noise2
wait(0.1)
decal.Texture = noise1
wait(0.1)
decal.Texture = noise3
wait(0.1)
decal.Texture = noise4
wait(0.1)
decal.Texture = noise2
wait(0.1)
