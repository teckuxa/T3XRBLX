wait(0.1)
decal.Texture = dif
wait(0.5)
decal.Texture = noise1
wait(0.1)
decal.Texture = noise2
wait(0.1)
decal.Texture = noise3
wait(0.1)
decal.Texture = noise4
wait(0.1)
decal.Texture = noise2
wait(0.1)
decal.Texture = noise1
wait(0.1)
decal.Texture = noise3
wait(0.1)
decal.Texture = noise4
wait(0.1)
decal.Texture = noise2
wait(0.1)
decal.Texture = noise4
wait(0.1)
end
</ProtectedString>
