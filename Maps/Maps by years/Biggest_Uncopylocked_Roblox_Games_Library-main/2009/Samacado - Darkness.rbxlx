						<string name="Name">Script</string>
						<ProtectedString name="Source">door1 = script.Parent.Parent.Doors.Door1
door2 = script.Parent.Parent.Doors.Door2
door4 = script.Parent.Parent.Doors.Door4
door5 = script.Parent.Parent.Doors.Door5
on = (&quot;http://www.roblox.com/asset/?id=14076423&quot;)
off = (&quot;http://www.roblox.com/asset/?id=14076409&quot;)
function onClicked (mouse)
	door1.CanCollide = false
	door2.CanCollide = false
	door4.CanCollide = false
	door5.CanCollide = false
	script.Parent.Parent.Sign.Decal.Texture = on
	wait(30)
	door1.CanCollide = true
	door2.CanCollide = true
	door4.CanCollide = true
	door5.CanCollide = true
	script.Parent.Parent.Sign.Decal.Texture = off
end
script.Parent.ClickDetector.MouseClick:connect(onClicked)

</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
