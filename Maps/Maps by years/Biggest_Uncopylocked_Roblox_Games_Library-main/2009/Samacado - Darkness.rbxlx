			<Item class="Script" referent="RBX2822">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Bullet</string>
					<ProtectedString name="Source">Tool = script.Parent
function fire(v)
script.Parent.Bullets.Value=script.Parent.Bullets.Value - 1
	Tool.Handle.Bang:play()
        Tool.Parent.Torso:FindFirstChild(&quot;Right Shoulder&quot;).DesiredAngle = 2
	if (script.Parent.Bullets.Value == 0) then
		while script.Parent.Bullets.Value &lt;= 7 do
		wait(1)
		Tool.Bullets.Value=Tool.Bullets.Value + 1
		Tool.Handle.Reload:play()	
		end
	end 

        local rarm = Tool.Parent:FindFirstChild(&quot;Right Arm&quot;)
	local vCharacter = Tool.Parent
	local vPlayer = game.Players:playerFromCharacter(vCharacter)

	local missile = Instance.new(&quot;Part&quot;)

        

	local spawnPos = Tool.Handle.Position

	missile.Position = spawnPos + (v * 3)
	missile.Size = Vector3.new(1,1,1)
	missile.Velocity = v * 1000
	missile.BrickColor = BrickColor.new(&quot;Bright yellow&quot;)
	missile.Shape = 0
	missile.BottomSurface = 0
	missile.TopSurface = 0
	missile.Name = &quot;Bullet&quot;
	missile.Elasticity = 0
	missile.Reflectance = 0
	missile.Friction = .9
	
	

local shell = Instance.new(&quot;Part&quot;)
shell.Parent = game.Workspace
shell.Position = script.Parent.Handle.Position
shell.Anchored = false
shell.Shape = &quot;Ball&quot;
shell.Friction = 0
shell.BottomSurface = &quot;Smooth&quot;
shell.TopSurface = &quot;Smooth&quot;
shell.Elasticity = 0
shell.Size = Vector3.new(1,1,1)
shell.BrickColor = BrickColor.new(&quot;Bright yellow&quot;)
local mesh = Tool.ShellMesh:clone()
mesh.Parent = shell

        local bullet = Instance.new(&quot;SpecialMesh&quot;)
        bullet.MeshType = &quot;Sphere&quot;
        bullet.Scale = Vector3.new(.3,.3,.3)
        bullet.Parent = missile

	local force = Instance.new(&quot;BodyForce&quot;)
	force.force = Vector3.new(0,90,0)
	force.Parent = missile

	local new_script = script.Parent.Damage:clone()
	
	new_script.Disabled = false
	new_script.Parent = missile

	local new_script = script.Parent.Cleanup:clone()
	
	new_script.Disabled = false
	new_script.Parent = missile


	local new_script = script.Parent.Cleanup:clone()
	
	new_script.Disabled = false
	new_script.Parent = shell

	missile.Parent = game.Workspace

        local rarm = Tool.Parent:FindFirstChild(&quot;Right Arm&quot;)
	local vCharacter = Tool.Parent
	local vPlayer = game.Players:playerFromCharacter(vCharacter)

