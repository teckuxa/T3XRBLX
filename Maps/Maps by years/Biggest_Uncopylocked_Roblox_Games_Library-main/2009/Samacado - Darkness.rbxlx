									<string name="Name">Script</string>
									<ProtectedString name="Source">while true do
--Set&apos;s decal textures
noise1 = (&quot;http://www.roblox.com/asset/?id=13114597&quot;)
noise2 = (&quot;http://www.roblox.com/asset/?id=13114565&quot;)
noise3 = (&quot;http://www.roblox.com/asset/?id=13114541&quot;)
noise4 = (&quot;http://www.roblox.com/asset/?id=13114526&quot;)
