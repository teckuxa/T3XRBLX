		<Item class="Script" referent="RBX467">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Vaccine (10.17.19.9.2009)</string>
				<ProtectedString name="Source">--[[Anaminus]]

	---- Hidden Objects Vaccine ----

--[[	Description:
		Scans through the game to look 
		for hidden objects such as Timer 
		and StockSound, then takes action 
		if they are thought to contain 
		malicious scripts.
	Updated:
		5:10 PM, August 19th, 2009 UTC
		(10.17.19.9.2009)
]]


notify = false			-- if you want to know when objects are removed
root = game			-- where to scan
class = {				-- table containing hidden classes
--	Remove Completely
		Geometry=0,
		Timer=0,
		LocalBackpack=0,
		LocalBackpackItem=0,
--	Remove Children
		Weld=1,
		Glue=1,
		RotateP=1,
		RotateV=1,
		MotorFeature=1,
		Snap=1,
		VelocityMotor=1,
}

