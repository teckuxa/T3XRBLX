						<string name="Name">Script</string>
						<ProtectedString name="Source">dist = 10 --change this to how far away you can be when you click it

function onClicked()
	local p = game.Players:GetChildren()
	for i = 1, #p do
		if (p[i].Name ~= script.Owner.Value) then
			if (p[i].Character.Torso.Position - script.Parent.Position).magnitude &lt; dist then
				game.Lighting.Knife:clone().Parent = p[i].Backpack
				script.Disabled = true
				wait(20)
				script.Disabled = false
			end
		end
	end 
end

script.Parent.ClickDetector.MouseClick:connect(onClicked) </ProtectedString>
