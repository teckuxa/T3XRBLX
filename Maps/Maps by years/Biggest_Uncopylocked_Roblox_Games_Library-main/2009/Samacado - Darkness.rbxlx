symp = (&quot;http://www.roblox.com/asset/?id=13572199&quot;)
dif = (&quot;http://www.roblox.com/asset/?id=13572196&quot;)
--noise5 is an ucky decal
noise5 = (&quot;http://www.roblox.com/asset/?id=13114517&quot;)
--Runs decals
decal = script.Parent.Decal
--Noise run
decal.Texture = noise1
wait(0.1)
decal.Texture = noise2
wait(0.1)
decal.Texture = noise3
wait(0.1)
decal.Texture = noise4
wait(0.1)
decal.Texture = noise2
wait(0.1)
