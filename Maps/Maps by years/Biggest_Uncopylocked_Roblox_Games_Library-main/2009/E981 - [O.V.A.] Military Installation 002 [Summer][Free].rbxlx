							<string name="Name">PlayerEnter</string>
							<ProtectedString name="Source">game.Players.PlayerAdded:connect(function(p) 
p.CharacterAdded:connect(function(v) 
if p:IsInGroup(4606) then -- Change the number here to be the ID of whatever group you want to spawn here
v.Torso.CFrame = script.Parent.CFrame 
end 
end) 
end)

-- ProbeIke3.14
--Group ID# is the number on the Url of the group&apos;s page</ProtectedString>
