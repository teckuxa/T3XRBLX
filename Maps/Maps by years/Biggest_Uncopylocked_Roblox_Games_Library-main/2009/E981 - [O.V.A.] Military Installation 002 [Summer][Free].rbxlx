			</Properties>
			<Item class="Frame" referent="RBX5841">
				<Properties>
					<bool name="Active">false</bool>
					<bool name="Archivable">true</bool>
					<Color3 name="BackgroundColor3">4284940287</Color3>
					<float name="BackgroundTransparency">0.899999976</float>
					<Color3 name="BorderColor3">4284940287</Color3>
					<int name="BorderSizePixel">1</int>
					<bool name="Draggable">false</bool>
					<string name="Name">Chat</string>
					<UDim2 name="Position">
						<XS>0</XS>
						<XO>2</XO>
						<YS>1</YS>
						<YO>0</YO>
					</UDim2>
					<UDim2 name="Size">
						<XS>0</XS>
						<XO>0</XO>
						<YS>0</YS>
						<YO>14</YO>
					</UDim2>
					<token name="SizeConstraint">0</token>
					<token name="Style">0</token>
					<bool name="Visible">true</bool>
					<int name="ZIndex">7</int>
				</Properties>
				<Item class="Script" referent="RBX5842">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Run</string>
						<ProtectedString name="Source">config = {
&#9;history = 8,
&#9;spacing = 14,
&#9;color = Color3.new(0,255,255),
}

local history = {}
local Text = Instance.new(&quot;TextLabel&quot;)
Text.Text = &quot;[blocked]&quot;
Text.TextXAlignment = 0
Text.TextYAlignment = 0
Text.TextColor3 = config.color
Text.ZIndex = script.Parent.ZIndex
script.Parent.Size = UDim2.new(0,0,0,config.spacing)

function AddPlayer(player)
&#9;player.Chatted:connect(function(msg)
&#9;&#9;local new = Text:Clone()
&#9;&#9;new.archivable = false
&#9;&#9;new.Text = player.Name .. &quot;_ [Transmission]&quot; .. msg
&#9;&#9;new.Parent = script.Parent
&#9;&#9;table.insert(history,1,new)
&#9;&#9;for pos,item in ipairs(history) do
&#9;&#9;&#9;if pos &lt;= config.history then
&#9;&#9;&#9;&#9;item.Position = UDim2.new(0,0,-pos,0)
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;item:Remove()
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end)
end
for _,player in pairs(game.Players:GetPlayers()) do AddPlayer(player) end
game.Players.PlayerAdded:connect(AddPlayer)</ProtectedString>
					</Properties>
				</Item>
			</Item>
		</Item>
