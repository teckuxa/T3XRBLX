							<X>0.75</X>
							<Y>0.75</Y>
							<Z>0.75</Z>
						</Vector3>
						<Content name="TextureId"><url>http://www.roblox.com/asset/?id=58101289</url></Content>
						<Vector3 name="VertexColor">
							<X>1</X>
