							<string name="Name">Script</string>
							<ProtectedString name="Source">-- Type the assets below.
-------------------------------------------------------------
Asset1 = &quot;http://www.roblox.com/asset/?id=1&quot; -- First picture
Asset2 = &quot;http://www.roblox.com/asset/?id=47018931&quot; -- Second picture
Asset3 = &quot;http://www.roblox.com/asset/?id=47018988&quot; -- Third picture
