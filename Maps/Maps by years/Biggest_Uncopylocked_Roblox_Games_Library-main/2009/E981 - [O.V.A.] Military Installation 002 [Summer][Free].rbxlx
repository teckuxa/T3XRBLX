Asset5 = &quot;http://www.roblox.com/asset/?id=1&quot; -- Fifth picture
-- NO EDITING BELOW!
-------------------------------------------------------------
--[[
Do NOT edit ANYTHING below!
Only edit the things above.
The assets go in order too, so it will go:
Asset1, Asset2, Asset3, Asset4, Asset5.
]]
-------------------------------------------------------------
local val = false
script.Parent.MouseEnter:connect(function()
if not val then
script.Parent.Label2.Visible = false
script.Parent.Image = Asset1
wait(0.5)
if not val then
script.Parent.Image = Asset2
wait(1)
if not val then
script.Parent.Image = Asset3
wait(1)
if not val then
script.Parent.Image = Asset4
wait(8)
if not val then
script.Parent.Image = Asset5
wait(0.5)
if not val then
script.Parent.Image = &quot;http://www.roblox.com/asset/?id=1&quot;
val = false
end
end
end
end
end
end
end)

