							<string name="Name">Script</string>
							<ProtectedString name="Source">-- Type the assets below.
-------------------------------------------------------------
Asset1 = &quot;http://www.roblox.com/asset/?id=1&quot; -- First picture
Asset2 = &quot;http://www.roblox.com/asset/?id=1&quot; -- Second picture
Asset3 = &quot;http://www.roblox.com/asset/?id=1&quot; -- Third picture
Asset4 = &quot;http://www.roblox.com/asset/?id=1&quot; -- Fourth picture
Asset5 = &quot;http://www.roblox.com/asset/?id=1&quot; -- Fifth picture
-- NO EDITING BELOW!
-------------------------------------------------------------
--[[
Do NOT edit ANYTHING below!
Only edit the things above.
The assets go in order too, so it will go:
Asset1, Asset2, Asset3, Asset4, Asset5.
]]
-------------------------------------------------------------
local val = false
script.Parent.MouseEnter:connect(function()
if not val then
script.Parent.Label2.Visible = false
script.Parent.Image = Asset1
wait(9999)
if not val then
script.Parent.Image = Asset2
wait(0.1)
if not val then
script.Parent.Image = Asset3
wait(0.1)
if not val then
script.Parent.Image = Asset4
wait(0.1)
if not val then
script.Parent.Image = Asset5
wait(0.1)
if not val then
script.Parent.Image = &quot;http://www.roblox.com/asset/?id=1&quot;
val = false
end
end
end
end
end
end
end)

script.Parent.MouseLeave:connect(function()
val = true
script.Parent.Label2.Visible = true
script.Parent.Label2.Text = &quot;&quot;
script.Parent.Image = &quot;http://www.roblox.com/asset/?id=1&quot;
wait(0.1)
script.Parent.Label2.Text = &quot;&quot;
val = false
end)
</ProtectedString>
