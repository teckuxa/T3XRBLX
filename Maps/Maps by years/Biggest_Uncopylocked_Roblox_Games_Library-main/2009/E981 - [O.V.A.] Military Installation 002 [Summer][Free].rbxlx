						<Item class="Script" referent="RBX5349">
							<Properties>
								<bool name="Archivable">true</bool>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<ProtectedString name="Source">mesh = script.Parent.Mesh
brick = script.Parent

function changeSize(property)
&#9;if property ~= &quot;Size&quot; then return end
&#9;mesh.Scale = Vector3.new(brick.Size.x * 1, brick.Size.y * 1, brick.Size.z * 1)
end

brick.Changed:connect(changeSize)

changeSize(&quot;Size&quot;)</ProtectedString>
							</Properties>
