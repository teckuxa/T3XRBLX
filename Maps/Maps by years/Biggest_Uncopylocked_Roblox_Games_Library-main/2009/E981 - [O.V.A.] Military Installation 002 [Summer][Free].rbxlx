		<Item class="Script" referent="RBX5741">
			<Properties>
				<bool name="Archivable">true</bool>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">raids</string>
				<ProtectedString name="Source">clo = script.MovieGUI:Clone()

function onChatted(msg, recipient, speaker)
local source = string.lower(speaker.Name)
msg = string.lower(msg)
if (msg == &quot;raids&quot;) then
local ds = clo:Clone()
ds.Parent = speaker.PlayerGui
elseif (msg == &quot;close&quot;) then
local roblox = speaker.PlayerGui:findFirstChild(&quot;MovieGUI&quot;)
if (roblox ~= nil) then
roblox:Remove()
end
end
end

function onPlayerEntered(newPlayer)
newPlayer.Chatted:connect(function(msg, recipient)
onChatted(msg, recipient, newPlayer)
end)
end

game.Players.PlayerAdded:connect(onPlayerEntered)

</ProtectedString>
