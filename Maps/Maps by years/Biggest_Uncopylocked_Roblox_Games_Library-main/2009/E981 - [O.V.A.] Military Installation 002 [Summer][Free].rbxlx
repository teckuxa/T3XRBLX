						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">print(&quot;OSE GUI&quot;) 
news = script.Parent 
while true do 
news.Text = &quot;----[_ [] ]&quot; 
wait(10.5) 
news.Text = &quot;----[C_ [] ]&quot; 
wait(0.1) 
news.Text = &quot;----[Cl_ [] ]&quot; 
wait(0.1) 
