						<string name="Name">Script</string>
						<ProtectedString name="Source">print(&quot;teleport&quot;)
brick = workspace[&quot;SurrenderBrick&quot;]
player = script.Parent.Parent.Parent.Parent.Character
function tele()
player.Torso.CFrame = brick.CFrame + Vector3.new(0,4,0)
end

script.Parent.MouseButton1Down:connect(tele)</ProtectedString>
