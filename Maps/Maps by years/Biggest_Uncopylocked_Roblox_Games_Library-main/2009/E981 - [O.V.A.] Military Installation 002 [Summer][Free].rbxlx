					</Properties>
					<Item class="Script" referent="RBX5884">
						<Properties>
							<bool name="Archivable">true</bool>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">--Scroll to the right?
right = false

--Scroll to the Left?
left = true

--Speed (Higher = Slower)
speed = 1000

while true do
&#9;wait()
&#9;if right then
&#9;&#9;for i=1, speed do
&#9;&#9;&#9;script.Parent.Position = UDim2.new(i / speed,0,0.5,0)
&#9;&#9;&#9;wait()
&#9;&#9;end
&#9;end
&#9;if left then
&#9;&#9;for i=1, speed  do
&#9;&#9;&#9;script.Parent.Position = UDim2.new((speed - i) / speed,0,0.5,0)
&#9;&#9;&#9;wait()
&#9;&#9;end
&#9;end
end
</ProtectedString>
						</Properties>
