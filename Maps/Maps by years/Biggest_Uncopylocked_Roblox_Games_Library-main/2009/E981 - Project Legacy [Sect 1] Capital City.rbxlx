		<Item class="LocalScript" referent="RBX5466">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">LocalScript1</string>
				<ProtectedString name="Source">wait(1)
if script.Parent.Name==&quot;Backpack&quot; then
g=workspace:GetChildren()
for i = 1, #g do
if g[i].Name == &quot;DistancePart1&quot; then
newc1=g[i]:clone()
newc1.Transparency=1
newc1.Parent = workspace.CurrentCamera
newc2=script.BillboardGui:clone()
newc2.Creator.Value=script.Parent.Parent.Name
newc2.Parent=newc1
newc2.Adornee=newc1
end
end
end </ProtectedString>
