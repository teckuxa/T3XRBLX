				<string name="Name">ChangeDist1</string>
				<ProtectedString name="Source">wait(3)
while true do
workspace.CurrentCamera.DistancePart1.BillboardGui.Dist.Text = &quot;[Dist]: &quot; .. math.ceil((script.Parent.Parent.Character.Torso.Position-workspace.CurrentCamera.DistancePart1.Position).magnitude) .. &quot;_STDS&quot;
wait()
end </ProtectedString>
