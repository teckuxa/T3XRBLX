					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">1</string>
					<ProtectedString name="Source">--[[
Put this script into game.StarterGui for it to work

Published by steffanno, Made by MasterOfDeathOnes, June 2012
--]]

game.Selection.SelectionChanged:connect(function()
