				<Item class="Script" referent="RBX851">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">brick = script.Parent 
local vel = 0
while true do
repeat
brick.Position = Vector3.new(brick.Position.x+0,45.9,brick.Position.z+0.1) 
wait(0.003)
vel = vel + 0.1
until vel &gt;= 23

repeat
brick.Position = Vector3.new(brick.Position.x+0,45.9,brick.Position.z-0.1)
wait(0.003)
vel = vel - 0.1
until vel &lt;= 0
end
</ProtectedString>
