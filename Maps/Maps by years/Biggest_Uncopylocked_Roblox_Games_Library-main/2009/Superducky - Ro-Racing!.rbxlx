		<Item class="Script" referent="RBX3252">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">RaceLeaderboard</string>
				<ProtectedString name="Source">function onPlayerEntered(newPlayer)
	wait(.5)
	local stats = Instance.new(&quot;IntValue&quot;)
	stats.Name = &quot;leaderstats&quot;
	local stats2 = Instance.new(&quot;IntValue&quot;)
	stats2.Name = &quot;Checkpoint&quot;

	local points = Instance.new(&quot;IntValue&quot;)
	
	points.Name = &quot;Score&quot;
	points.Value = 0

	local lap = Instance.new(&quot;IntValue&quot;)
	
	lap.Name = &quot;Lap&quot;
	lap.Value = 0 

	lap.Parent = stats
	points.Parent = stats
	stats2.Parent = newPlayer	
	stats.Parent = newPlayer

			local b = game:GetService(&quot;BadgeService&quot;)
			b:AwardBadge(newPlayer.userId, script.Parent.BadgeID.Value)
wait(3600)
local b = game:GetService(&quot;BadgeService&quot;)
b:AwardBadge(newPlayer.userId, script.Parent.hour.BadgeID.Value)
wait(3600)
local b = game:GetService(&quot;BadgeService&quot;)
b:AwardBadge(newPlayer.userId, script.Parent.twohour.BadgeID.Value)
end

game.Players.ChildAdded:connect(onPlayerEntered)
</ProtectedString>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX3253">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">racescript</string>
				<ProtectedString name="Source">local time = 0
local track = 0
local play = false
model = game.Workspace.raceway
robloxraceway = model:clone()
mode = game.Workspace.dirttrack
dirttrack2 = mode:clone()
mod = game.Workspace.space
space2 = mod:clone()
mo = game.Workspace.coins
coins2 = mo:clone()
m = game.Workspace.quick
quick2 = m:clone()
wait(0.1)
m:remove()
mo:remove()
mod:remove()
mode:remove()
model:remove()


function playersearch()
if game.Players.NumPlayers &lt;= 1 then
game.Workspace.Hint.Text = &quot;Not enough players to race! Stick around, More should show up soon!&quot;
play = false--REMEMBER THIS DAKOTA
elseif game.Players.NumPlayers &gt;= 2 then
game.Workspace.Hint.Text = &quot;A game will start soon! Get ready to race!&quot;
play = true
end
end


while true do

playersearch()
if play == true then
wait(20)
playersearch()
if play == true then
msg = Instance.new(&quot;Message&quot;)
msg.Parent = game.Workspace
msg.Text = &quot;Picking a random Racetrack...&quot;
wait(5)
track = math.random(1,5) -- AND THIS

if track == 1 then
msg.Text = &quot;Get ready for Roblox Raceway!&quot;
wait(5)
time = 360
msg:remove()
players = game.Players:GetChildren() 
for i=1,#players do 
players[i].Character:moveTo(Vector3.new((math.random(130,138)),14,(math.random(-22,-14))))
end
robloxraceway1 = robloxraceway:clone()
robloxraceway1.Parent = game.Workspace
robloxraceway1:MakeJoints()
repeat
time = time - 1
game.Workspace.Hint.Text = &quot;A race is underway! There are &quot; ..time.. &quot; seconds left!&quot;
wait(1)
until time == 20 or game.Workspace.raceway.carcount.Value == 1337
game.Workspace.Hint.Text = &quot;Hurry!&quot;
ms = Instance.new(&quot;Message&quot;)
ms.Parent = game.Workspace
ms.Text = &quot;Hurry up! The Track is about to disappear!&quot;
wait(5)
ms:remove()
wait(15)
msc = Instance.new(&quot;Message&quot;)
msc.Parent = game.Workspace
msc.Text = &quot;The race is over! &quot; ..game.Workspace.raceway.End.Nobody.Value.. &quot; got 1st place!&quot;
			
players = game.Players:GetChildren() 
for i=1,#players do
if players[i].Name == game.Workspace.raceway.End.Nobody.Value then 
local b = game:GetService(&quot;BadgeService&quot;)
b:AwardBadge(players[i].userId, script.BadgeID.Value)
end 
end

wait(3)
msc:remove()
robloxraceway1:remove()



elseif track == 2 then
msg.Text = &quot;Get ready for Pwn Derby!&quot;
wait(5)
time = 360
msg:remove()
players = game.Players:GetChildren() 
for i=1,#players do 
players[i].Character:moveTo(Vector3.new((math.random(215,223)),31.6,(math.random(-130,-122))))
end
dirttrack3 = dirttrack2:clone()
dirttrack3.Parent = game.Workspace
dirttrack3:MakeJoints()
repeat
time = time - 1
game.Workspace.Hint.Text = &quot;A race is underway! There are &quot; ..time.. &quot; seconds left!&quot;
wait(1)
until time == 20 or game.Workspace.dirttrack.carcount.Value == 1337
game.Workspace.Hint.Text = &quot;Hurry!&quot;
ms = Instance.new(&quot;Message&quot;)
ms.Parent = game.Workspace
ms.Text = &quot;Hurry up! The Track is about to disappear!&quot;
wait(5)
ms:remove()
wait(15)
msc = Instance.new(&quot;Message&quot;)
msc.Parent = game.Workspace
msc.Text = &quot;The race is over! &quot; ..game.Workspace.dirttrack.End.Nobody.Value.. &quot; got 1st place!&quot;
			
players = game.Players:GetChildren() 
for i=1,#players do
if players[i].Name == game.Workspace.dirttrack.End.Nobody.Value then 
local b = game:GetService(&quot;BadgeService&quot;)
b:AwardBadge(players[i].userId, script.BadgeID.Value)
end 
end

wait(3)
msc:remove()
dirttrack3:remove()

elseif track == 3 then
msg.Text = &quot;Get ready for Space Station Speedway!&quot;
game.Lighting.TimeOfDay = &quot;24:00:00&quot;
wait(5)
time = 400
msg:remove()
players = game.Players:GetChildren() 
for i=1,#players do
players[i].Character:moveTo(Vector3.new((math.random(655,670)),64,(math.random(-374,-362))))
end
space3 = space2:clone()
space3.Parent = game.Workspace
space3:MakeJoints()
repeat
time = time - 1
game.Workspace.Hint.Text = &quot;A race is underway! There are &quot; ..time.. &quot; seconds left!&quot;
wait(1)
until time == 20 or game.Workspace.space.carcount.Value == 1337
game.Workspace.Hint.Text = &quot;Hurry!&quot;
ms = Instance.new(&quot;Message&quot;)
ms.Parent = game.Workspace
ms.Text = &quot;Hurry up! The Track is about to disappear!&quot;
wait(5)
ms:remove()
wait(15)
msc = Instance.new(&quot;Message&quot;)
msc.Parent = game.Workspace
msc.Text = &quot;The race is over! &quot; ..game.Workspace.space.End.Nobody.Value.. &quot; got 1st place!&quot;
			
players = game.Players:GetChildren() 
for i=1,#players do
if players[i].Name == game.Workspace.space.End.Nobody.Value then 
local b = game:GetService(&quot;BadgeService&quot;)
b:AwardBadge(players[i].userId, script.BadgeID.Value)
end 
end

wait(3)
msc:remove()
space3:remove()
game.Lighting.TimeOfDay = &quot;14:00:00&quot;

elseif track == 4 then
msg.Text = &quot;Bonus Round! Get the Coins!&quot;
wait(5)
time = 120
msg:remove()
players = game.Players:GetChildren() 
for i=1,#players do 
players[i].Character:moveTo(Vector3.new((math.random(335,345)),124,(math.random(-297,-287))))
end
coins3 = coins2:clone()
coins3.Parent = game.Workspace
coins3:MakeJoints()
repeat
time = time - 1
game.Workspace.Hint.Text = &quot;Bonus Round is underway! There are &quot; ..time.. &quot; seconds left!&quot;
wait(1)
until time == 20
game.Workspace.Hint.Text = &quot;Hurry!&quot;
ms = Instance.new(&quot;Message&quot;)
ms.Parent = game.Workspace
ms.Text = &quot;Hurry up! The round is almost over&quot;
wait(5)
ms:remove()
wait(15)
msc = Instance.new(&quot;Message&quot;)
msc.Parent = game.Workspace
msc.Text = &quot;The Bonus Round is over! Did you get a lot of coins?&quot;
wait(3)
msc:remove()
coins3:remove()

elseif track == 5 then
msg.Text = &quot;Get ready for Nitro Circuit!&quot;
wait(5)
time = 260
msg:remove()
players = game.Players:GetChildren() 
for i=1,#players do 
players[i].Character:moveTo(Vector3.new((math.random(471,479)),80,(math.random(-252,-242))))
end
quick3 = quick2:clone()
quick3.Parent = game.Workspace
quick3:MakeJoints()
repeat
time = time - 1
game.Workspace.Hint.Text = &quot;A race is underway! There are &quot; ..time.. &quot; seconds left!&quot;
wait(1)
until time == 20 or game.Workspace.quick.carcount.Value == 1337
game.Workspace.Hint.Text = &quot;Hurry!&quot;
ms = Instance.new(&quot;Message&quot;)
ms.Parent = game.Workspace
ms.Text = &quot;Hurry up! The Track is about to disappear!&quot;
wait(5)
ms:remove()
wait(15)
msc = Instance.new(&quot;Message&quot;)
msc.Parent = game.Workspace
msc.Text = &quot;The race is over! &quot; ..game.Workspace.quick.End.Nobody.Value.. &quot; got 1st place!&quot;
			
players = game.Players:GetChildren() 
for i=1,#players do
if players[i].Name == game.Workspace.quick.End.Nobody.Value then 
local b = game:GetService(&quot;BadgeService&quot;)
b:AwardBadge(players[i].userId, script.BadgeID.Value)
end 
end


wait(3)
msc:remove()
quick3:remove()
end
end
end
wait(1)
end

