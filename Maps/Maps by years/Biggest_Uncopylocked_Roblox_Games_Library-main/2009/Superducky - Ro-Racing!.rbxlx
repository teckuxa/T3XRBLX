						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">local ting = false

function onTouched(part)
if ting == false then

	local player = game.Players:playerFromCharacter(part.Parent)
	local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if h~=nil then
ting = true
player.leaderstats.Score.Value = player.leaderstats.Score.Value + 1
script.Parent:remove()
ting = false
end 
end
end

script.Parent.Touched:connect(onTouched)
