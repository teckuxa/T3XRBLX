				<Item class="Script" referent="RBX3287">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">while true do
repeat
script.Parent.Transparency = script.Parent.Transparency + 0.05
wait(0.2)
until script.Parent.Transparency &gt;= 1
wait(5)
repeat
script.Parent.Transparency = script.Parent.Transparency - 0.05
wait(0.2)
until script.Parent.Transparency &lt;= 0
wait(5)
end
</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
