				<Item class="Script" referent="RBX788">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">local ting = 0
function onTouched(hit)
if ting == 0 then
ting = 1
local check = hit.Parent.Parent:FindFirstChild(&quot;Humanoid&quot;)
if check ~= nil then
local thisplr = game.Players:findFirstChild(hit.Parent.Parent.Name)
if (thisplr~=nil) then
local ownstyc = thisplr:findFirstChild(&quot;leaderstats&quot;)
if (ownstyc~=nil) then
local lap = ownstyc:findFirstChild(&quot;Lap&quot;)
if (lap~=nil) then
if thisplr.Checkpoint.Value == 1 then
lap.Value = lap.Value + 1
thisplr.Checkpoint.Value = 0
end
end
end
end
end
ting = 0
end
end


script.Parent.Touched:connect(onTouched)
