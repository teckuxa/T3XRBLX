				<Item class="Script" referent="RBX838">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Speed</string>
						<ProtectedString name="Source">local cake = false
function onHit(hit)
local human = hit:findFirstChild(&quot;Sense&quot;)
if (human ~= nil) and cake == false then               
cake = true
hit.Parent.Seat.MaxSpeed = 30
wait(0.1)
cake = false
wait(2.4)
hit.Parent.Seat.MaxSpeed = 50
end
end

script.Parent.Touched:connect(onHit)
</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
