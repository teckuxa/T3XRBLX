				<Item class="Script" referent="RBX2683">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">local ting = 0
function onTouched(hit)
if ting == 0 then
ting = 1
local check = hit.Parent.Parent:FindFirstChild(&quot;Humanoid&quot;)
if check ~= nil then
local thisplr = game.Players:findFirstChild(hit.Parent.Parent.Name)
if (thisplr~=nil) then
local ownstyc = thisplr:findFirstChild(&quot;Checkpoint&quot;)
if (ownstyc~=nil) then
if ownstyc.Value == 0 then
ownstyc.Value = 1
end
end
end
end
ting = 0
end
end

script.Parent.Touched:connect(onTouched)
</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
