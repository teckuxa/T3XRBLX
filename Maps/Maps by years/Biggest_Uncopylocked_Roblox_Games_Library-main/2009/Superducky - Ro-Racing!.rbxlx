					<Item class="Script" referent="RBX3032">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">seat = script.Parent

function onChildAdded(part)
if part.className == &quot;Weld&quot; then
local torso = part.Part1
if torso ~= nil then
local parent = torso.Parent
if parent ~= nil then
script.Parent.Parent.Parent = parent
p = game.Players:playerFromCharacter(parent)
	gun = game.Lighting.Flipper:clone() --Change WEAPONNAMEHERE to the name of the weapon
        gun.Parent = p.Backpack
if parent.ColorChange ~= nil then
chasis = script.Parent.Parent.ColorChasis:GetChildren() 
for i=1,#chasis do 
chasis[i].BrickColor = parent.ColorChange.Handle.BrickColor
chasis[i].Reflectance = parent.ColorChange.Handle.Reflectance
chasis[i].Transparency = parent.ColorChange.Handle.Transparency
end
end
end
end
end
end
seat.ChildAdded:connect(onChildAdded)
</ProtectedString>
							<bool name="archivable">true</bool>
						</Properties>
