		<Item class="Tool" referent="RBX4041">
			<Properties>
				<bool name="Enabled">true</bool>
				<CoordinateFrame name="Grip">
					<X>0</X>
					<Y>0</Y>
					<Z>-0.400000006</Z>
					<R00>0</R00>
