				<Item class="Dialog" referent="RBX2322">
					<Properties>
						<float name="ConversationDistance">25</float>
						<string name="InitialPrompt">Hello there, Can I help you?</string>
						<string name="Name">Dialog</string>
						<token name="Purpose">1</token>
						<token name="Tone">0</token>
						<bool name="archivable">true</bool>
					</Properties>
					<Item class="DialogChoice" referent="RBX2323">
						<Properties>
							<string name="Name">DialogChoiceA</string>
							<string name="ResponseDialog">This is the Waiting Room!</string>
							<string name="UserDialog">Um... What is this Place?</string>
							<bool name="archivable">true</bool>
						</Properties>
						<Item class="DialogChoice" referent="RBX2324">
							<Properties>
								<string name="Name">DialogChoice</string>
								<string name="ResponseDialog">You can drive around in the cars, use your points to get items, or just wait for the next round.</string>
								<string name="UserDialog">What can I do here?</string>
								<bool name="archivable">true</bool>
							</Properties>
							<Item class="DialogChoice" referent="RBX2325">
								<Properties>
									<string name="Name">DialogChoice</string>
									<string name="ResponseDialog">Hush up and wait for the next race then.</string>
									<string name="UserDialog">Boooooooring.</string>
									<bool name="archivable">true</bool>
								</Properties>
							</Item>
							<Item class="DialogChoice" referent="RBX2326">
								<Properties>
									<string name="Name">DialogChoice</string>
									<string name="ResponseDialog">Goodbye!</string>
									<string name="UserDialog">That sounds pretty fun, Bye!</string>
									<bool name="archivable">true</bool>
								</Properties>
							</Item>
						</Item>
						<Item class="DialogChoice" referent="RBX2327">
							<Properties>
								<string name="Name">DialogChoice</string>
								<string name="ResponseDialog">Well, be patient. A race should start soon.</string>
								<string name="UserDialog">Ugh... I hate waiting.</string>
								<bool name="archivable">true</bool>
							</Properties>
						</Item>
					</Item>
					<Item class="DialogChoice" referent="RBX2328">
						<Properties>
							<string name="Name">DialogChoiceB</string>
							<string name="ResponseDialog">First you have to wait for the next race to start.</string>
							<string name="UserDialog">How do I race?</string>
							<bool name="archivable">true</bool>
						</Properties>
						<Item class="DialogChoice" referent="RBX2329">
							<Properties>
								<string name="Name">DialogChoice</string>
								<string name="ResponseDialog">Then, you pick a car and sit in it.</string>
								<string name="UserDialog">Then what?</string>
								<bool name="archivable">true</bool>
							</Properties>
							<Item class="DialogChoice" referent="RBX2330">
								<Properties>
									<string name="Name">DialogChoice</string>
									<string name="ResponseDialog">When the race starts, use your arrow keys to move your car.</string>
									<string name="UserDialog">And then?</string>
									<bool name="archivable">true</bool>
								</Properties>
								<Item class="DialogChoice" referent="RBX2331">
									<Properties>
										<string name="Name">DialogChoice</string>
										<string name="ResponseDialog">Then you race around the track until you make 5 laps!</string>
										<string name="UserDialog">What next?</string>
										<bool name="archivable">true</bool>
									</Properties>
									<Item class="DialogChoice" referent="RBX2332">
										<Properties>
											<string name="Name">DialogChoice</string>
											<string name="ResponseDialog">Select the flipper tool and click ONCE.</string>
											<string name="UserDialog">What do I do if my car flips over?</string>
											<bool name="archivable">true</bool>
										</Properties>
										<Item class="DialogChoice" referent="RBX2333">
											<Properties>
												<string name="Name">DialogChoice</string>
												<string name="ResponseDialog">The winner gets 100 points and a badge, second place gets 50 points, and everyone else who finishes gets 10 points!</string>
												<string name="UserDialog">How many points do I get?</string>
												<bool name="archivable">true</bool>
											</Properties>
										</Item>
									</Item>
									<Item class="DialogChoice" referent="RBX2334">
										<Properties>
											<string name="Name">DialogChoice</string>
											<string name="ResponseDialog">The winner gets 100 points and a badge, second place gets 50 points, and everyone else who finishes gets 10 points!</string>
											<string name="UserDialog">How many points do I get?</string>
											<bool name="archivable">true</bool>
										</Properties>
									</Item>
								</Item>
							</Item>
						</Item>
						<Item class="DialogChoice" referent="RBX2335">
							<Properties>
								<string name="Name">DialogChoice</string>
								<string name="ResponseDialog">Goodbye, have fun!</string>
								<string name="UserDialog">That&apos;s all I needed to know, thanks!</string>
								<bool name="archivable">true</bool>
							</Properties>
						</Item>
					</Item>
					<Item class="DialogChoice" referent="RBX2336">
						<Properties>
							<string name="Name">DialogChoiceC</string>
							<string name="ResponseDialog">It was made by the user Phinix. Superducky would like to thank Phinix for use of his suit.</string>
							<string name="UserDialog">Where did you get that great suit?</string>
							<bool name="archivable">true</bool>
						</Properties>
						<Item class="DialogChoice" referent="RBX2337">
							<Properties>
								<string name="Name">DialogChoice</string>
								<string name="ResponseDialog">That is because Superducky is a divine being of holy power. He is god&apos;s gift to humanity.</string>
								<string name="UserDialog">It sure is nice of Superducky to give credit!</string>
								<bool name="archivable">true</bool>
							</Properties>
							<Item class="DialogChoice" referent="RBX2338">
								<Properties>
									<string name="Name">DialogChoice</string>
									<string name="ResponseDialog">It&apos;s true. Have a good day!</string>
									<string name="UserDialog">Erm...</string>
									<bool name="archivable">true</bool>
								</Properties>
							</Item>
							<Item class="DialogChoice" referent="RBX2339">
								<Properties>
									<string name="Name">DialogChoice</string>
									<string name="ResponseDialog">Yes. He is. Send him a message with the subject &quot;I am unworthy&quot;, and he will reply!</string>
									<string name="UserDialog">Wow! He sure is great!</string>
