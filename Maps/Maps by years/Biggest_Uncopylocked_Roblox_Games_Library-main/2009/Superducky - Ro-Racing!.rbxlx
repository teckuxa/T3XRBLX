				<string name="Name">regen</string>
				<ProtectedString name="Source">model = game.Workspace.Regenerate
backup = model:clone()

while true do
	wait(300)
	model:remove()
	model = backup:clone()
	model.Parent = game.Workspace
	model:makeJoints()
end
</ProtectedString>
				<bool name="archivable">true</bool>
			</Properties>
