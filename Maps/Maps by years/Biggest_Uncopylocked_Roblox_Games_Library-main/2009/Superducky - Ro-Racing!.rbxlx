						<string name="Name">Script</string>
						<ProtectedString name="Source">local ting = 0
function onTouched(hit)
if ting == 0 then
ting = 1
local check = hit.Parent.Parent:FindFirstChild(&quot;Humanoid&quot;)
if check ~= nil then
local thisplr = game.Players:findFirstChild(hit.Parent.Parent.Name)
if (thisplr~=nil) then
local ownstyc = thisplr:findFirstChild(&quot;leaderstats&quot;)
if (ownstyc~=nil) then
local lap = ownstyc:findFirstChild(&quot;Lap&quot;)
if (lap~=nil) then
if lap.Value == 5 then
lap.Value = 0
script.Parent.Parent.Finished.Value = script.Parent.Parent.Finished.Value+1
if script.Parent.Parent.Finished.Value == 1 then
ownstyc.Score.Value = ownstyc.Score.Value + 100
script.Parent.Nobody.Value = check.Parent.Name
check.Health = 0
elseif script.Parent.Parent.Finished.Value == 2 then
ownstyc.Score.Value = ownstyc.Score.Value + 50
check.Health = 0
elseif script.Parent.Parent.Finished.Value &gt;= 3 then
ownstyc.Score.Value = ownstyc.Score.Value + 10
check.Health = 0
end
end
end
end
end
end
ting = 0
end
end


