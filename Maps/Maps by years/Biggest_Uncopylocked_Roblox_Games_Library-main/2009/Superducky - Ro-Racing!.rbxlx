		<Item class="Script" referent="RBX781">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">NolapsforYou</string>
				<ProtectedString name="Source">function onSpawn(Char)
local thisplr = game.Players:findFirstChild(Char.Name)
if (thisplr~=nil) then
local ownstyc = thisplr:findFirstChild(&quot;leaderstats&quot;)
if (ownstyc~=nil) then
local lap = ownstyc:findFirstChild(&quot;Lap&quot;)
if (lap~=nil) then
lap.Value = 0
thisplr.Checkpoint.Value = 0
end
end
end
end
game.Workspace.ChildAdded:connect(onSpawn)</ProtectedString>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
