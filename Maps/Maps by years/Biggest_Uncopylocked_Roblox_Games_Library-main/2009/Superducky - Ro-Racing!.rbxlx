		<Item class="Script" referent="RBX2311">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">VIP</string>
				<ProtectedString name="Source">function onPlayerRespawned(newPlayer) 
wait(2) 
if newPlayer.Character.Torso.roblox.Texture == &quot;http://www.roblox.com/asset/?id=17551679&quot; then 
clone = game.Lighting.Slingshot:clone() --put your tool in the Lighting and change &quot;TOOL&quot; to the name of our tool.
clone.Parent = newPlayer.Backpack
newPlayer.leaderstats.Score.Value = newPlayer.leaderstats.Score.Value + 50
end 
end 

function onPlayerAdded(newPlayer) 
newPlayer.Changed:connect(function(property) 
if property == &quot;Character&quot; then 
onPlayerRespawned(newPlayer) 
end 
end) 
end 

game.Players.PlayerAdded:connect(onPlayerAdded)</ProtectedString>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
