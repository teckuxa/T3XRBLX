				<Item class="Script" referent="RBX141">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">while true do
wait(5)
script.Parent.Value = 0
wait(5)
if script.Parent.Value == 0 then
wait(1)
if script.Parent.Value == 0 then
script.Parent.Value = 1337
end
end
end

</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
			<Item class="Script" referent="RBX142">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">local time = 15
repeat
script.Start.Text = &quot;Get in your cars now! You have &quot; ..time.. &quot; seconds left!&quot;
wait(1)
time = time - 1
until time==0
script.Start.Text = &quot;Get Ready!&quot;
wait(2)
script.Start.Text = &quot;Get Set!&quot;
wait(2)
script.Start.Text = &quot;Go!&quot;
wait(2)
script.Start:remove()</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
