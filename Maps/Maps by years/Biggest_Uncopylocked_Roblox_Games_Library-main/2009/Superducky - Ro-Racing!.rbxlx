				<Item class="Script" referent="RBX3260">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Speed</string>
						<ProtectedString name="Source">local bounce = false
function onHit(hit)
local human = hit:findFirstChild(&quot;Sense&quot;)
if (human ~= nil) and bounce == false then               
bounce = true
hit.Parent.Seat.MaxSpeed = 100
wait(0.1)
bounce = false
wait(2.9)
hit.Parent.Seat.MaxSpeed = 50
end
end

script.Parent.Touched:connect(onHit)
</ProtectedString>
