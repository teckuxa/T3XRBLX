						<string name="Name">Start</string>
						<string name="Text"></string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
			<Item class="Script" referent="RBX144">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">while true do
wait(1.4)
droplet = game.Workspace.quick.Drop:clone()
droplet.Parent = game.Workspace
droplet.Anchored = false
droplet.Position = Vector3.new(453,80,math.random(-206,-190))
end
</ProtectedString>
