&#9;&#9;&#9;&#9;&#9;if h[lol].Value == &quot;&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;h[lol].Value = newitemid
&#9;&#9;&#9;&#9;&#9;&#9;gotit = true
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;failed = false
&#9;&#9;&#9;script.Parent.Main.CraftInfo.amount.Value = 1
&#9;&#9;&#9;script.Parent.Main.CraftInfo.ItemID.Value = newitemid
&#9;&#9;&#9;script.Parent.Main.CraftInfo.good.Visible = true
&#9;&#9;&#9;wait(6)
&#9;&#9;&#9;script.Parent.Main.CraftInfo.good.Visible = false
&#9;&#9;end
&#9;end
end
elseif itemnum == 1 then
slot = nil
for i = 1,#c do
if c[i].Value ~= &quot;&quot; then
slot = c[i]
end
end
if slot ~= nil then
dbitem = itemdb:findFirstChild(invslots:findFirstChild(slot.Value).Value)
if dbitem ~= nil then
if dbitem:findFirstChild(&quot;WepSlot&quot;) ~= nil then
invslots:findFirstChild(slot.Value).Value = &quot;&quot;
slot.Value = &quot;&quot;

newitemid = &quot;X404&quot;
h = invslots:GetChildren()
