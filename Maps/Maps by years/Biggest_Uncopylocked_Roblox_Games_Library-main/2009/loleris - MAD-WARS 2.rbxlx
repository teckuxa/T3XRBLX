end)



cinv:findFirstChild(&quot;C1&quot;).MouseMoved:connect(function ()
onMouseOver(cinv:findFirstChild(&quot;C1&quot;))
end)
cinv:findFirstChild(&quot;C2&quot;).MouseMoved:connect(function ()
