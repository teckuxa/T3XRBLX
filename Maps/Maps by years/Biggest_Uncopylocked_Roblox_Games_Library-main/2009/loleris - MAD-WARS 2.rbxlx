function onChatted(msg, speaker)
    

    --you need capitals
    
    source = string.lower(speaker.Name)
    
    --the below &quot;if then&quot; statement is necessary for this script.
    if string.sub(msg, 1, 4) == &quot;get/&quot; then
        local thing = itemdb:findFirstChild(string.sub(msg, 5))
        if thing ~= nil then
&#9;&#9;pp = game.Workspace.playerpacks:findFirstChild(speaker.Name)
&#9;&#9;if pp ~= nil then
&#9;&#9;&#9;val = Instance.new(&quot;IntValue&quot;)
&#9;&#9;&#9;val.Value = 0
&#9;&#9;&#9;val.Name = string.sub(msg, 5)
&#9;&#9;&#9;val.Parent = pp:findFirstChild(&quot;Pending&quot;)
&#9;&#9;end
        elseif string.sub(msg, 5) == &quot;SpecAmmo&quot; then
&#9;&#9;print(&quot;Giving specammo&quot;)
&#9;&#9;p = game.Players:GetChildren()
&#9;&#9;for i = 1,#p do
&#9;&#9;pp = game.Workspace.playerpacks:findFirstChild(p[i].Name)
&#9;&#9;if pp ~= nil then
&#9;&#9;&#9;val = Instance.new(&quot;IntValue&quot;)
&#9;&#9;&#9;val.Value = 2
&#9;&#9;&#9;val.Name = &quot;SpecAmmo&quot;
&#9;&#9;&#9;val.Parent = pp:findFirstChild(&quot;Pending&quot;)
&#9;&#9;end
&#9;&#9;end
&#9;end
    end

    if string.sub(msg, 1, 8) == &quot;giveall/&quot; then
        local thing = itemdb:findFirstChild(string.sub(msg, 9))
        if thing ~= nil then
&#9;&#9;p = game.Players:GetChildren()
&#9;&#9;for i = 1,#p do
&#9;&#9;pp = game.Workspace.playerpacks:findFirstChild(p[i].Name)
&#9;&#9;if pp ~= nil then
&#9;&#9;&#9;val = Instance.new(&quot;IntValue&quot;)
&#9;&#9;&#9;val.Value = 1
&#9;&#9;&#9;val.Name = string.sub(msg, 9)
&#9;&#9;&#9;val.Parent = pp:findFirstChild(&quot;Pending&quot;)
&#9;&#9;end
&#9;&#9;end
        elseif string.sub(msg, 9) == &quot;SpecAmmo&quot; then
&#9;&#9;p = game.Players:GetChildren()
&#9;&#9;for i = 1,#p do
&#9;&#9;pp = game.Workspace.playerpacks:findFirstChild(p[i].Name)
&#9;&#9;if pp ~= nil then
&#9;&#9;&#9;val = Instance.new(&quot;IntValue&quot;)
&#9;&#9;&#9;val.Value = 2
&#9;&#9;&#9;val.Name = &quot;SpecAmmo&quot;
&#9;&#9;&#9;val.Parent = pp:findFirstChild(&quot;Pending&quot;)
&#9;&#9;end
&#9;&#9;end
&#9;end
    end

end

--Again, you need this last part.

