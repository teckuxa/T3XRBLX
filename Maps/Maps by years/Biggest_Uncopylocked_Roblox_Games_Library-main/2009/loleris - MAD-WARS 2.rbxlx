		<Item class="Script" referent="RBX650">
			<Properties>
				<bool name="Archivable">true</bool>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">TeamColors</string>
				<ProtectedString name="Source">while true do
wait()
p = game.Players:GetChildren()
for i = 1,#p do
char = p[i].Character
if char ~= nil then
torso = char:findFirstChild(&quot;Torso&quot;)
if torso ~= nil then
if torso.BrickColor ~= p[i].TeamColor then
torso.BrickColor = p[i].TeamColor
end
end
end
end

end </ProtectedString>
			</Properties>
