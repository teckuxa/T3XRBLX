						<Item class="Script" referent="RBX5285">
							<Properties>
								<bool name="Archivable">true</bool>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">junk launcher</string>
								<ProtectedString name="Source">while true do 
wait(math.random(5,8))
p = Instance.new(&quot;Part&quot;)
p.formFactor = &quot;Symmetric&quot;
p.Size = Vector3.new(2,2,2)
p.TopSurface = 0
p.BottomSurface = 0
p.BrickColor = script.Parent.BrickColor
p.Transparency = 0
p.Reflectance = 0
p.Name = &quot;Junk&quot;
p.Parent = game.Workspace
p.Anchored = false

p.CFrame = script.Parent.CFrame * CFrame.new(script.Parent.CFrame.lookVector * -1)
p.Velocity = script.Parent.CFrame.lookVector * 50

sc = script.cleanup:clone()
sc.Disabled = false
sc.Parent = p
end </ProtectedString>
							</Properties>
							<Item class="Script" referent="RBX5286">
								<Properties>
									<bool name="Archivable">true</bool>
									<bool name="Disabled">true</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">cleanup</string>
									<ProtectedString name="Source">wait(5)
script.Parent.Parent = nil </ProtectedString>
								</Properties>
							</Item>
						</Item>
					</Item>
				</Item>
