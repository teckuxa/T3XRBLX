function playerVIP(newPlayer)
wait(1)
print(&quot;Giving VIP...&quot;)
while newPlayer.Character == nil do
wait()
end
if newPlayer.Character:findFirstChild(&quot;Humanoid&quot;) ~= nil then
newPlayer.Character:findFirstChild(&quot;Humanoid&quot;).Health = newPlayer.Character:findFirstChild(&quot;Humanoid&quot;).Health + 10
end
end


function onPlayerEntered(newPlayer) 
