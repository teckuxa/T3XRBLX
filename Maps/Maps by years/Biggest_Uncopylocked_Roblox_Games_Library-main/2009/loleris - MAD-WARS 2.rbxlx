		<Item class="Script" referent="RBX4">
			<Properties>
				<bool name="Archivable">true</bool>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Weapon Shop Giver</string>
				<ProtectedString name="Source">heavydutyid = script.HeavyDutyID.Value
prismcannonid = script.PrismCannonID.Value
forceanatureid = script.ForceANatureID.Value

function GiveItem(p,itemid)
pp = game.Workspace:findFirstChild(&quot;playerpacks&quot;)
ppack = pp:findFirstChild(p.Name)
if ppack ~= nil then
inv = ppack:findFirstChild(&quot;Inv&quot;)

done = false
for i = 4,16 do
&#9;if done == false then
&#9;&#9;if inv:findFirstChild(&quot;S&quot; .. i).Value == &quot;&quot; then
&#9;&#9;&#9;inv:findFirstChild(&quot;S&quot; .. i).Value = itemid
&#9;&#9;&#9;done = true
&#9;&#9;&#9;print(itemid .. &quot; was given to &quot; .. p.Name)
&#9;&#9;end
&#9;end
end

end

end


function giveboughtweapons(player)
----------------------------Heavy Duty
check = game:GetService(&quot;BadgeService&quot;):UserHasBadge(player.userId, heavydutyid)
if check == true then
&#9;print(player.Name .. &quot; has Heavy Duty bought&quot;)
&#9;GiveItem(player,&quot;X005&quot;)
end
----------------------------Prism Cannon
check = game:GetService(&quot;BadgeService&quot;):UserHasBadge(player.userId, prismcannonid)
if check == true then
&#9;print(player.Name .. &quot; has Prism Cannon bought&quot;)
&#9;GiveItem(player,&quot;X006&quot;)
end
----------------------------Force-A-Nature
check = game:GetService(&quot;BadgeService&quot;):UserHasBadge(player.userId, forceanatureid)
if check == true then
&#9;print(player.Name .. &quot; has Force-A-Nature bought&quot;)
&#9;GiveItem(player,&quot;X106&quot;)
end
----------------------------

----------------------------

----------------------------
end


function onPlayerEntered(newPlayer)
wait(5)
if (newPlayer == nil) then return end
giveboughtweapons(newPlayer)
end
 
game.Players.ChildAdded:connect(onPlayerEntered)



--GiveItem(game.Players.loleris,&quot;X005&quot;)

</ProtectedString>
