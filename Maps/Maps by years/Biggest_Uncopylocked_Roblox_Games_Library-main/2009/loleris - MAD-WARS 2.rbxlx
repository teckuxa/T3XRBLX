				<Item class="Script" referent="RBX1183">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Languages</string>
						<ProtectedString name="Source">wait()
player = script.Parent.Parent.Parent.Parent
pp = game.Workspace.playerpacks:findFirstChild(player.Name)
if pp ~= nil then
lang = pp:findFirstChild(&quot;LANGUAGE&quot;)
end 

function langstart()
lpack = game.Lighting.LanguagePacks:findFirstChild(lang.Value)
if lpack ~= nil then
script.Parent:findFirstChild(&quot;blueprints&quot;).Text = lpack.Words:findFirstChild(&quot;blueprints&quot;).Value
script.Parent:findFirstChild(&quot;inv&quot;).Text = lpack.Words:findFirstChild(&quot;inventory&quot;).Value
script.Parent:findFirstChild(&quot;shop&quot;).Text = lpack.Words:findFirstChild(&quot;shop&quot;).Value
script.Parent.Recieving:findFirstChild(&quot;recieve&quot;).Text = lpack.Words:findFirstChild(&quot;yourecieved&quot;).Value
elseif lang.Value == &quot;English&quot; then
script.Parent:findFirstChild(&quot;blueprints&quot;).Text = &quot;Blueprints&quot;
script.Parent:findFirstChild(&quot;inv&quot;).Text = &quot;Inventory&quot;
script.Parent:findFirstChild(&quot;shop&quot;).Text = &quot;Shop&quot;
script.Parent.Recieving:findFirstChild(&quot;recieve&quot;).Text = &quot;You recieved:&quot;
end
end

langstart()

lang.Changed:connect(function()
langstart()
end)</ProtectedString>
