							<ProtectedString name="Source">script.Parent.s1.Text = &quot;&quot;
script.Parent.s2.Text = &quot;&quot;
script.Parent.s3.Text = &quot;&quot;
script.Parent.s4.Text = &quot;&quot;
script.Parent.s5.Text = &quot;&quot;
script.Parent.s6.Text = &quot;&quot;

history = game.Workspace:findFirstChild(&quot;LAGGPANEL&quot;).history

while true do
wait(0.4)
script.Parent.s1.Text = history.s1.Value
script.Parent.s2.Text = history.s2.Value
script.Parent.s3.Text = history.s3.Value
script.Parent.s4.Text = history.s4.Value
script.Parent.s5.Text = history.s5.Value
script.Parent.s6.Text = history.s6.Value
end </ProtectedString>
