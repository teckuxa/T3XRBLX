									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">Images</string>
									<ProtectedString name="Source">wait(2.5)
player = script.Parent.Parent.Parent.Parent.Parent.Parent
playerpacks = game.Workspace:findFirstChild(&quot;playerpacks&quot;)
pack = playerpacks:findFirstChild(player.Name)
while pack == nil do
pack = playerpacks:findFirstChild(player.Name)
wait(0.5)
end
eqp = pack:findFirstChild(&quot;Equipped&quot;):GetChildren()
for i = 1,#eqp do
eqp[i].Changed:connect(function ()
OnCh()
end)
end


function OnCh()
if player ~= nil then
&#9;playerpacks = game.Workspace:findFirstChild(&quot;playerpacks&quot;)
&#9;if playerpacks ~= nil then
&#9;&#9;pack = playerpacks:findFirstChild(player.Name)
&#9;&#9;if pack ~= nil then
&#9;&#9;&#9;equipped = pack:findFirstChild(&quot;Equipped&quot;)

&#9;&#9;&#9;rocket = equipped:findFirstChild(&quot;Primary&quot;)
&#9;&#9;&#9;bullet = equipped:findFirstChild(&quot;Secondary&quot;)
&#9;&#9;&#9;melle = equipped:findFirstChild(&quot;Melee&quot;)
&#9;&#9;&#9;special = equipped:findFirstChild(&quot;Special&quot;)

&#9;&#9;&#9;rocket2 = script.Parent:findFirstChild(&quot;E1&quot;)
&#9;&#9;&#9;bullet2 = script.Parent:findFirstChild(&quot;E2&quot;)
&#9;&#9;&#9;melle2 = script.Parent:findFirstChild(&quot;E3&quot;)
&#9;&#9;&#9;special2 = script.Parent:findFirstChild(&quot;E4&quot;)

&#9;&#9;&#9;itemserver = game.Workspace:findFirstChild(&quot;ItemServer&quot;)
&#9;&#9;&#9;itemdb = itemserver:findFirstChild(&quot;ItemDB&quot;)

&#9;&#9;&#9;if rocket.Value ~= &quot;&quot; then
&#9;&#9;&#9;&#9;item = itemdb:findFirstChild(rocket.Value)
&#9;&#9;&#9;&#9;if item ~= nil then
&#9;&#9;&#9;&#9;&#9;if item:findFirstChild(&quot;Picture&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;if rocket2.Image ~= item:findFirstChild(&quot;Picture&quot;).Value then
&#9;&#9;&#9;&#9;&#9;&#9;rocket2.Image = item:findFirstChild(&quot;Picture&quot;).Value
&#9;&#9;&#9;&#9;&#9;&#9;rocket2.BackgroundColor3 = script.Parent.Parent.clyellow.Value
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;if rocket2.Image ~= &quot;http://www.roblox.com/asset/?id=30036926&quot; then
&#9;&#9;&#9;&#9;rocket2.Image = &quot;http://www.roblox.com/asset/?id=30036926&quot;
&#9;&#9;&#9;&#9;rocket2.BackgroundColor3 = script.Parent.Parent.clgrey.Value
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end

&#9;&#9;&#9;if bullet.Value ~= &quot;&quot; then
&#9;&#9;&#9;&#9;item = itemdb:findFirstChild(bullet.Value)
&#9;&#9;&#9;&#9;if item ~= nil then
&#9;&#9;&#9;&#9;&#9;if item:findFirstChild(&quot;Picture&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;if bullet2.Image ~= item:findFirstChild(&quot;Picture&quot;).Value then
&#9;&#9;&#9;&#9;&#9;&#9;bullet2.Image = item:findFirstChild(&quot;Picture&quot;).Value
&#9;&#9;&#9;&#9;&#9;&#9;bullet2.BackgroundColor3 = script.Parent.Parent.clyellow.Value
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;if bullet2.Image ~= &quot;http://www.roblox.com/asset/?id=34443453&quot; then
&#9;&#9;&#9;&#9;bullet2.Image = &quot;http://www.roblox.com/asset/?id=34443453&quot;
&#9;&#9;&#9;&#9;bullet2.BackgroundColor3 = script.Parent.Parent.clgrey.Value
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end

&#9;&#9;&#9;if melle.Value ~= &quot;&quot; then
&#9;&#9;&#9;&#9;item = itemdb:findFirstChild(melle.Value)
&#9;&#9;&#9;&#9;if item ~= nil then
&#9;&#9;&#9;&#9;&#9;if item:findFirstChild(&quot;Picture&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;if melle2.Image ~= item:findFirstChild(&quot;Picture&quot;).Value then
&#9;&#9;&#9;&#9;&#9;&#9;melle2.Image = item:findFirstChild(&quot;Picture&quot;).Value
&#9;&#9;&#9;&#9;&#9;&#9;melle2.BackgroundColor3 = script.Parent.Parent.clyellow.Value
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;if melle2.Image ~= &quot;http://www.roblox.com/asset/?id=34525870&quot; then
&#9;&#9;&#9;&#9;melle2.Image = &quot;http://www.roblox.com/asset/?id=34525870&quot;
&#9;&#9;&#9;&#9;melle2.BackgroundColor3 = script.Parent.Parent.clgrey.Value
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end

&#9;&#9;&#9;if special.Value ~= &quot;&quot; then
&#9;&#9;&#9;&#9;item = itemdb:findFirstChild(special.Value)
&#9;&#9;&#9;&#9;if item ~= nil then
&#9;&#9;&#9;&#9;&#9;if item:findFirstChild(&quot;Picture&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;if special2.Image ~= item:findFirstChild(&quot;Picture&quot;).Value then
&#9;&#9;&#9;&#9;&#9;&#9;special2.Image = item:findFirstChild(&quot;Picture&quot;).Value
&#9;&#9;&#9;&#9;&#9;&#9;special2.BackgroundColor3 = script.Parent.Parent.clyellow.Value
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;if special2.Image ~= &quot;http://www.roblox.com/asset/?id=23831244&quot; then
&#9;&#9;&#9;&#9;special2.Image = &quot;http://www.roblox.com/asset/?id=23831244&quot;
&#9;&#9;&#9;&#9;special2.BackgroundColor3 = script.Parent.Parent.clgrey.Value
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end

&#9;&#9;end
&#9;end
end 



end 

