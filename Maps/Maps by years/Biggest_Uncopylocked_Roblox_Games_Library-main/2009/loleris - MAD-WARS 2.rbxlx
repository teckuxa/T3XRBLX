&#9;&#9;&#9;itemdb = script.Parent.Parent.Parent.Parent.GItemDB

&#9;&#9;&#9;if rocket.Value ~= &quot;&quot; then
&#9;&#9;&#9;&#9;item = itemdb:findFirstChild(rocket.Value)
&#9;&#9;&#9;&#9;if item ~= nil then
&#9;&#9;&#9;&#9;&#9;if item:findFirstChild(&quot;Picture&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;if rocket2.Image ~= item:findFirstChild(&quot;Picture&quot;).Value then
&#9;&#9;&#9;&#9;&#9;&#9;rocket2.Image = item:findFirstChild(&quot;Picture&quot;).Value
&#9;&#9;&#9;&#9;&#9;&#9;rocket2.BackgroundColor3 = script.Parent.Parent.clyellow.Value
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;if rocket2.Image ~= &quot;http://www.roblox.com/asset/?id=30036926&quot; then
&#9;&#9;&#9;&#9;rocket2.Image = &quot;http://www.roblox.com/asset/?id=30036926&quot;
&#9;&#9;&#9;&#9;rocket2.BackgroundColor3 = script.Parent.Parent.clgrey.Value
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end

&#9;&#9;&#9;if bullet.Value ~= &quot;&quot; then
&#9;&#9;&#9;&#9;item = itemdb:findFirstChild(bullet.Value)
&#9;&#9;&#9;&#9;if item ~= nil then
&#9;&#9;&#9;&#9;&#9;if item:findFirstChild(&quot;Picture&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;if bullet2.Image ~= item:findFirstChild(&quot;Picture&quot;).Value then
&#9;&#9;&#9;&#9;&#9;&#9;bullet2.Image = item:findFirstChild(&quot;Picture&quot;).Value
&#9;&#9;&#9;&#9;&#9;&#9;bullet2.BackgroundColor3 = script.Parent.Parent.clyellow.Value
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;if bullet2.Image ~= &quot;http://www.roblox.com/asset/?id=34443453&quot; then
&#9;&#9;&#9;&#9;bullet2.Image = &quot;http://www.roblox.com/asset/?id=34443453&quot;
&#9;&#9;&#9;&#9;bullet2.BackgroundColor3 = script.Parent.Parent.clgrey.Value
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end

&#9;&#9;&#9;if melle.Value ~= &quot;&quot; then
&#9;&#9;&#9;&#9;item = itemdb:findFirstChild(melle.Value)
&#9;&#9;&#9;&#9;if item ~= nil then
&#9;&#9;&#9;&#9;&#9;if item:findFirstChild(&quot;Picture&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;if melle2.Image ~= item:findFirstChild(&quot;Picture&quot;).Value then
&#9;&#9;&#9;&#9;&#9;&#9;melle2.Image = item:findFirstChild(&quot;Picture&quot;).Value
&#9;&#9;&#9;&#9;&#9;&#9;melle2.BackgroundColor3 = script.Parent.Parent.clyellow.Value
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;if melle2.Image ~= &quot;http://www.roblox.com/asset/?id=34525870&quot; then
&#9;&#9;&#9;&#9;melle2.Image = &quot;http://www.roblox.com/asset/?id=34525870&quot;
&#9;&#9;&#9;&#9;melle2.BackgroundColor3 = script.Parent.Parent.clgrey.Value
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end

&#9;&#9;&#9;if special.Value ~= &quot;&quot; then
&#9;&#9;&#9;&#9;item = itemdb:findFirstChild(special.Value)
&#9;&#9;&#9;&#9;if item ~= nil then
&#9;&#9;&#9;&#9;&#9;if item:findFirstChild(&quot;Picture&quot;) ~= nil then
