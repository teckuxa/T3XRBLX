						<Item class="Script" referent="RBX5887">
							<Properties>
								<bool name="Archivable">true</bool>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Item show</string>
								<ProtectedString name="Source">ccyan = script.Parent.Parent.ccyan.Value
cred = script.Parent.Parent.cred.Value
while true do
wait()
if script.Parent.Visible == true then
itemid = script.Parent.ItemID.Value

itemserver = game.Workspace:findFirstChild(&quot;ItemServer&quot;)
itemdb = game.Lighting.LanguagePacks.Sweden:findFirstChild(&quot;ItemDB&quot;)

theitem = itemdb:findFirstChild(itemid)
if theitem ~= nil then

if theitem:findFirstChild(&quot;ItemName2&quot;) ~= nil then
script.Parent.RecieveName.Text = theitem:findFirstChild(&quot;ItemName2&quot;).Value
script.Parent.RecieveName2.Text = theitem:findFirstChild(&quot;ItemName2&quot;).Value
else
script.Parent.RecieveName.Text = &quot;&quot;
script.Parent.RecieveName2.Text = &quot;&quot;
end

if theitem:findFirstChild(&quot;ItemName&quot;) ~= nil and theitem:findFirstChild(&quot;ItemLevel&quot;) ~= nil then
script.Parent.type.Text = &quot;Level &quot; .. theitem:findFirstChild(&quot;ItemLevel&quot;).Value .. &quot; &quot; .. theitem:findFirstChild(&quot;ItemName&quot;).Value
else
script.Parent.type.Text = &quot;&quot;
end

if theitem:findFirstChild(&quot;WepSlot&quot;) ~= nil and theitem:findFirstChild(&quot;ItemClass&quot;) ~= nil then
script.Parent.WepSlot.Text = theitem:findFirstChild(&quot;WepSlot&quot;).Value .. &quot; &quot; .. theitem:findFirstChild(&quot;ItemClass&quot;).Value
else
script.Parent.WepSlot.Text = &quot;&quot;
end

if script.Parent.sell.Value == false then
if theitem:findFirstChild(&quot;ShopBuy&quot;) ~= nil then
script.Parent.Cost.Text = &quot;Affar ska kopa till: &quot; .. theitem:findFirstChild(&quot;ShopBuy&quot;).Value .. &quot; Pts.&quot;
else
script.Parent.Cost.Text = &quot;Affar kommer inte att kopa det har objektet.&quot;
end
else
if theitem:findFirstChild(&quot;ShopSell&quot;) ~= nil then
script.Parent.Cost.Text = &quot;Affar kommer att salja for: &quot; .. theitem:findFirstChild(&quot;ShopSell&quot;).Value .. &quot; Pts.&quot;
else
script.Parent.Cost.Text = &quot;Affar kommer inte att salja det har objektet.&quot;
end
end

if theitem:findFirstChild(&quot;WepAbility&quot;) ~= nil then
abilities = theitem:findFirstChild(&quot;WepAbility&quot;)
script.Parent.spec1.Text = abilities.Abil1.Value
script.Parent.spec2.Text = abilities.Abil2.Value
script.Parent.spec3.Text = abilities.Abil3.Value

if abilities.Abil1.good.Value == true then
script.Parent.spec1.TextColor3 = ccyan
else
script.Parent.spec1.TextColor3 = cred
end

if abilities.Abil2.good.Value == true then
script.Parent.spec2.TextColor3 = ccyan
else
script.Parent.spec2.TextColor3 = cred
end

if abilities.Abil3.good.Value == true then
script.Parent.spec3.TextColor3 = ccyan
else
script.Parent.spec3.TextColor3 = cred
end

else
script.Parent.spec1.Text = &quot;&quot;
script.Parent.spec2.Text = &quot;&quot;
script.Parent.spec3.Text = &quot;&quot;
end

end
end
end </ProtectedString>
