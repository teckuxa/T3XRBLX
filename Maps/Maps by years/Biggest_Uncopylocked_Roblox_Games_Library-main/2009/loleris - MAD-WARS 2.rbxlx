							<ProtectedString name="Source">wait(2.5)
player = script.Parent.Parent.Parent.Parent.Parent.Parent
playerpacks = game.Workspace:findFirstChild(&quot;playerpacks&quot;)
pack = playerpacks:findFirstChild(player.Name)
while pack == nil do
pack = playerpacks:findFirstChild(player.Name)
wait(0.5)
end
invc = pack:findFirstChild(&quot;Inv&quot;):GetChildren()
for i = 1,#invc do
invc[i].Changed:connect(function ()
OnCh()
end)
end
craftc = pack:findFirstChild(&quot;CraftInv&quot;):GetChildren()
for i = 1,#craftc do
craftc[i].Changed:connect(function ()
OnCh()
end)
end



function OnCh()
if player ~= nil then
&#9;playerpacks = game.Workspace:findFirstChild(&quot;playerpacks&quot;)
&#9;if playerpacks ~= nil then
&#9;&#9;pack = playerpacks:findFirstChild(player.Name)
&#9;&#9;if pack ~= nil then
&#9;&#9;&#9;inv = pack:findFirstChild(&quot;Inv&quot;)
&#9;&#9;&#9;for i = 1,16 do
&#9;&#9;&#9;&#9;slot = inv:findFirstChild(&quot;S&quot; .. i)
&#9;&#9;&#9;&#9;slot2 = script.Parent:findFirstChild(&quot;I&quot; .. i)
&#9;&#9;&#9;&#9;if slot ~= nil and  slot2 ~= nil then
&#9;&#9;&#9;&#9;&#9;if slot.Value == &quot;&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;if slot2.Image ~= &quot;http://www.roblox.com/asset/?id=29610183&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;slot2.Image = &quot;http://www.roblox.com/asset/?id=29610183&quot;
&#9;&#9;&#9;&#9;&#9;&#9;print(&quot;1 changed&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;itemserver = game.Workspace:findFirstChild(&quot;ItemServer&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;itemdb = itemserver:findFirstChild(&quot;ItemDB&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;item = itemdb:findFirstChild(slot.Value)
&#9;&#9;&#9;&#9;&#9;&#9;if item ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if item:findFirstChild(&quot;Picture&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;if slot2.Image ~= item:findFirstChild(&quot;Picture&quot;).Value then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;slot2.Image = item:findFirstChild(&quot;Picture&quot;).Value
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;print(&quot;2 changed&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;craftinv = pack:findFirstChild(&quot;CraftInv&quot;)
&#9;&#9;&#9;&#9;used = false
&#9;&#9;&#9;&#9;for i = 1,6 do
&#9;&#9;&#9;&#9;&#9;cslot = craftinv:findFirstChild(&quot;S&quot; .. i)
&#9;&#9;&#9;&#9;&#9;if cslot.Value == slot.Name then
&#9;&#9;&#9;&#9;&#9;&#9;used = true
&#9;&#9;&#9;&#9;&#9;&#9;cslot2 = script.Parent.Parent:findFirstChild(&quot;CraftingInv&quot;):findFirstChild(&quot;C&quot; .. i)
&#9;&#9;&#9;&#9;&#9;&#9;if cslot2.Image ~= slot2.Image then
&#9;&#9;&#9;&#9;&#9;&#9;cslot2.Image = slot2.Image
&#9;&#9;&#9;&#9;&#9;&#9;print(&quot;3 changed&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;if cslot.Value == &quot;&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;cslot2 = script.Parent.Parent:findFirstChild(&quot;CraftingInv&quot;):findFirstChild(&quot;C&quot; .. i)
&#9;&#9;&#9;&#9;&#9;&#9;if cslot2.Image ~= &quot;http://www.roblox.com/asset/?id=29610183&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;cslot2.Image = &quot;http://www.roblox.com/asset/?id=29610183&quot;
&#9;&#9;&#9;&#9;&#9;&#9;print(&quot;4 changed&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;if used == true then
&#9;&#9;&#9;&#9;&#9;if slot2.BackgroundColor3 ~= script.Parent.Parent.ccyan.Value then
&#9;&#9;&#9;&#9;&#9;slot2.BackgroundColor3 = script.Parent.Parent.ccyan.Value
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;if slot2.BackgroundColor3 ~= script.Parent.Parent.cgrey.Value then
&#9;&#9;&#9;&#9;&#9;slot2.BackgroundColor3 = script.Parent.Parent.cgrey.Value
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end 



end 

OnCh()
wait(3)
OnCh()
wait(2)
OnCh()</ProtectedString>
