					<int name="BorderSizePixel">0</int>
					<bool name="Draggable">false</bool>
					<Content name="Image"><url>http://www.roblox.com/asset/?id=30153100</url></Content>
					<string name="Name">CraftingSpace</string>
					<UDim2 name="Position">
						<XS>0</XS>
						<XO>400</XO>
						<YS>0</YS>
						<YO>30</YO>
					</UDim2>
					<UDim2 name="Size">
						<XS>0</XS>
						<XO>153</XO>
						<YS>0</YS>
						<YO>20</YO>
