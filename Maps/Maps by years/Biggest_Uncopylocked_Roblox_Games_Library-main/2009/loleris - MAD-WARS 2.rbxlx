if pp ~= nil then
lang = pp:findFirstChild(&quot;LANGUAGE&quot;)
end 

function onClick()
script.Parent.Parent.Visible = false
lang.Value = &quot;Sweden&quot;
end

script.Parent.MouseButton1Up:connect(function ()
onClick()
end)
