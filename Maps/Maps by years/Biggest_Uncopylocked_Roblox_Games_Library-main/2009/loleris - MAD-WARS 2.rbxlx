									<Properties>
										<bool name="Archivable">true</bool>
										<string name="Name">txtCrafting3</string>
										<string name="Value">Gor samma sak med Glas Sword - klicka pa den...</string>
									</Properties>
								</Item>
								<Item class="StringValue" referent="RBX6317">
									<Properties>
