					<Item class="Script" referent="RBX1266">
						<Properties>
							<bool name="Archivable">true</bool>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">infogather</string>
							<ProtectedString name="Source">player = script.Parent.Parent.Parent.Parent.Parent

while true do
wait()
pf = script.Parent.Parent.Parent.Ginfo
if pf ~= nil then
script.Parent.kwd.Value = pf.kwd.Value

d = pf.dom:GetChildren()
domcount = 0
for i = 1,#d do
if d[i].Value &gt;= 3 then
domcount = domcount + 1
end
end

script.Parent.dominations.Text = &quot;Dominations: &quot; .. domcount
script.Parent.killstreak.Text = &quot;Kills Without Dying: &quot; .. pf.kwd.Value
end 
end </ProtectedString>
						</Properties>
					</Item>
				</Item>
