										<Content name="LinkedSource"><null></null></Content>
										<string name="Name">clickdetector</string>
										<ProtectedString name="Source">function onClick()
if script.Parent.allow.Value == true then
script.Parent.allow.Value = false
script.Parent.Parent.nxt.Value = true
end
end

script.Parent.MouseButton1Up:connect(function ()
onClick()
end)</ProtectedString>
