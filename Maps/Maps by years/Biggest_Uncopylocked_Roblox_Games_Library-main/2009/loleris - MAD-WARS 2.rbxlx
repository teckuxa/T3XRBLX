function GiveItem(p,itemid)
pp = game.Workspace:findFirstChild(&quot;playerpacks&quot;)
ppack = pp:findFirstChild(p.Name)
if ppack ~= nil then
inv = ppack:findFirstChild(&quot;Inv&quot;)

done = false
for i = 4,16 do
&#9;if done == false then
&#9;&#9;if inv:findFirstChild(&quot;S&quot; .. i).Value == &quot;&quot; then
&#9;&#9;&#9;inv:findFirstChild(&quot;S&quot; .. i).Value = itemid
&#9;&#9;&#9;done = true
&#9;&#9;&#9;print(itemid .. &quot; was given to &quot; .. p.Name)
&#9;&#9;end
&#9;end
end

end

end


function buy(player,dec)
----------------------------Heavy Duty
if dec == heavyduty then
print(player.Name .. &quot; has a buy shirt&quot;)
&#9;check = game:GetService(&quot;BadgeService&quot;):UserHasBadge(player.userId, heavydutyid)
&#9;if check == false then
&#9;&#9;print(&quot;Awarding BadgeID: &quot; .. heavydutyid .. &quot; to UserID: &quot; .. player.userId)
&#9;&#9;local b = game:GetService(&quot;BadgeService&quot;)
&#9;&#9;b:AwardBadge(player.userId, heavydutyid)
&#9;&#9;GiveItem(player,&quot;X005&quot;)
&#9;&#9;if player:findFirstChild(&quot;PlayerGui&quot;) ~= nil then
&#9;&#9;&#9;script.buycomplete:clone().Parent = player:findFirstChild(&quot;PlayerGui&quot;)
&#9;&#9;end
&#9;end
end
----------------------------Prism Cannon
if dec == prismcannon then
print(player.Name .. &quot; has a buy shirt&quot;)
&#9;check = game:GetService(&quot;BadgeService&quot;):UserHasBadge(player.userId, prismcannonid)
&#9;if check == false then
&#9;&#9;print(&quot;Awarding BadgeID: &quot; .. prismcannonid .. &quot; to UserID: &quot; .. player.userId)
&#9;&#9;local b = game:GetService(&quot;BadgeService&quot;)
&#9;&#9;b:AwardBadge(player.userId, prismcannonid)
&#9;&#9;GiveItem(player,&quot;X006&quot;)
&#9;&#9;if player:findFirstChild(&quot;PlayerGui&quot;) ~= nil then
&#9;&#9;&#9;script.buycomplete:clone().Parent = player:findFirstChild(&quot;PlayerGui&quot;)
&#9;&#9;end
&#9;end
end
----------------------------Force-A-Nature
if dec == forceanature then
print(player.Name .. &quot; has a buy shirt&quot;)
&#9;check = game:GetService(&quot;BadgeService&quot;):UserHasBadge(player.userId, forceanatureid)
&#9;if check == false then
&#9;&#9;print(&quot;Awarding BadgeID: &quot; .. forceanatureid .. &quot; to UserID: &quot; .. player.userId)
&#9;&#9;local b = game:GetService(&quot;BadgeService&quot;)
