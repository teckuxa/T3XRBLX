end)


while true do
wait()
langp = game.Lighting.LanguagePacks:findFirstChild(lang.Value)
if langp ~= nil then
script.Parent.LangBtt.Image = langp:findFirstChild(&quot;Flag&quot;).Value
elseif lang.Value == &quot;English&quot; then
script.Parent.LangBtt.Image = enflag
end
