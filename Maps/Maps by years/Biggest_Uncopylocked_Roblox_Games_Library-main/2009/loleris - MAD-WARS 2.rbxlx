				<Item class="Script" referent="RBX4951">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">SandwichScript</string>
						<ProtectedString name="Source">local Tool = script.Parent;

enabled = true

function heal(hum,add)
if hum ~= nil then

if (hum.MaxHealth &gt; hum.Health + add) then
&#9;hum.Health = hum.Health + add
else&#9;
&#9;hum.Health = hum.MaxHealth
end

end
end

function playnom(pt,wt,hl,hm)
script.Parent.Handle.DrinkSound.Pitch = pt
script.Parent.Handle.DrinkSound:Play()
wait(wt)
script.Parent.Handle.DrinkSound:Stop()
heal(hm,hl)
end




function onActivated()
&#9;if not enabled  then
&#9;&#9;return
&#9;end

&#9;local h = Tool.Parent:FindFirstChild(&quot;Humanoid&quot;)
&#9;if (h ~= nil) then
&#9;if script.Parent.Charge.Value &gt;= 1 then

&#9;script.Parent.Charge.Value = script.Parent.Charge.Value - 1 

&#9;enabled = false
&#9;Tool.GripForward = Vector3.new(-0.976,0,-0.217)
&#9;Tool.GripPos = Vector3.new(.95,-0.76,1.4)
&#9;Tool.GripRight = Vector3.new(0.217,0, 0.976)
&#9;Tool.GripUp = Vector3.new(0,1,0)
&#9;----------------nom nom&apos;s
&#9;gui = script.Parent:findFirstChild(&quot;Sandwich INFO&quot;):clone()
&#9;gui.Hits.Disabled = false
&#9;gui.Show.Disabled = false
&#9;gui:findFirstChild(&quot;t&quot; .. math.random(1,3)).Value = true
&#9;gui.Parent = script.Parent.Parent.Head
&#9;
&#9;cup = script.Parent.cleanup:clone()
&#9;cup.Disabled = false
&#9;cup.Parent = gui

&#9;une = script.Parent.unequiper:clone()
&#9;une.Disabled = false
&#9;une.Parent = script.Parent.Parent

&#9;cup = script.Parent.cleanup:clone()
&#9;cup.Disabled = false
&#9;cup.Parent = une
&#9;
&#9;oldspeed = h.WalkSpeed
&#9;h.WalkSpeed = 0


&#9;playnom(0.5,1,5,h) -- pitch, wait, heal, humanoid
&#9;playnom(0.6,1.1,5,h) -- pitch, wait, heal, humanoid
&#9;playnom(0.7,1,5,h) -- pitch, wait, heal, humanoid
&#9;playnom(0.6,1.1,5,h) -- pitch, wait, heal, humanoid
&#9;playnom(0.5,1,5,h) -- pitch, wait, heal, humanoid
&#9;playnom(0.4,1.2,5,h) -- pitch, wait, heal, humanoid
&#9;playnom(0.3,1.5,5,h) -- pitch, wait, heal, humanoid
&#9;playnom(0.2,2,15,h) -- pitch, wait, heal, humanoid


&#9;----------------nom nom&apos;s
&#9;wait(0.1)
&#9;h.WalkSpeed = oldspeed

&#9;Tool.GripForward = Vector3.new(-0.976,0,-0.217)
&#9;Tool.GripPos = Vector3.new(0.65, 0, 0)
&#9;Tool.GripRight = Vector3.new(0.217,0,-0.976)
&#9;Tool.GripUp = Vector3.new(0,1,0)


&#9;enabled = true
&#9;else
&#9;&#9;boom = Instance.new(&quot;Explosion&quot;)
&#9;&#9;boom.BlastPressure = 0
&#9;&#9;boom.Position = script.Parent.Handle.Position
&#9;&#9;boom.Parent = game.Workspace
&#9;&#9;script.Parent.Parent = nil
&#9;end
&#9;end

end

function onEquipped()
&#9;Tool.Handle.OpenSound:play()
end

script.Parent.Activated:connect(onActivated)
script.Parent.Equipped:connect(onEquipped)
</ProtectedString>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX4952">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">unequiper</string>
						<ProtectedString name="Source">function runt()
wait()
s = script.Parent:GetChildren()
for i = 1,#s do
if s[i].Name ~= &quot;Sandwich&quot; and s[i].className == &quot;Tool&quot; then
local vCharacter = script.Parent
local vPlayer = game.Players:playerFromCharacter(vCharacter)

if vPlayer ~= nil then
s[i].Parent = vPlayer.Backpack
end

end
end
end 

script.Parent.ChildAdded:connect(function ()
runt()
end)</ProtectedString>
					</Properties>
