							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Regen</string>
							<ProtectedString name="Source">enabled = true

function onHit()
if enabled == true then
enabled = false
for i = 1,18 do
script.Parent.CFrame = CFrame.new(script.Parent.Position - Vector3.new(0,0.1,0))
wait()
end
script.Parent.Flush:play()
script.Parent.Parent.water.Flush:play()

p = game.Players:GetChildren()

for q = 1,8 do
for i = 1,#p do
if p[i].Character ~= nil then
if p[i].Character:findFirstChild(&quot;Torso&quot;) ~= nil and p[i].Character:findFirstChild(&quot;Humanoid&quot;) ~= nil then
if (script.Parent.Parent.water.Position - p[i].Character:findFirstChild(&quot;Torso&quot;).Position).magnitude &lt;= 11 then

if p[i].Character:findFirstChild(&quot;Humanoid&quot;).Health ~= 0 then
p[i].Character:findFirstChild(&quot;Humanoid&quot;).Health = 0 
p[i].Character:BreakJoints()
pp = p[i].Character:GetChildren()
for e = 1,#pp do

if pp[e].className == &quot;Part&quot; then
pp[e].Velocity = Vector3.new(math.random(-200,200),0,math.random(-200,200))
end

if pp[e].className == &quot;Hat&quot; then
if pp[e]:findFirstChild(&quot;Handle&quot;) ~= nil then
pp[e].Handle.Velocity = Vector3.new(math.random(-200,200),0,math.random(-200,200))
end
end

if pp[e].className == &quot;Tool&quot; then
if pp[e]:findFirstChild(&quot;Handle&quot;) ~= nil then
pp[e].Handle.Velocity = Vector3.new(math.random(-200,200),0,math.random(-200,200))
end
end

end

end

end
end
end
end
script.Parent.Parent.water.Flush:play()
wait(1)
end
script.Parent.reload:play()
for i = 1,18 do
script.Parent.CFrame = CFrame.new(script.Parent.Position + Vector3.new(0,0.1,0))
wait()
end
enabled = true
end
end

script.Parent.Touched:connect(function()
onHit()
end)</ProtectedString>
