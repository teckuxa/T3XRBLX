			<Item class="Script" referent="RBX6848">
				<Properties>
					<bool name="Archivable">true</bool>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">ItemWiew</string>
					<ProtectedString name="Source">player = script.Parent.Parent.Parent.Parent

pack = script.Parent.Parent.Gpack

itemdb = script.Parent.Parent.GItemDB
itemcraft = script.Parent.Parent.GItemCraft

btt = nil
oldbtt = nil

function onMouseOver(btt)
if oldbtt ~= btt then
oldbtt = btt
class = string.sub(btt.Name,1,1)
num = string.sub(btt.Name,2,3)

if class == &quot;I&quot; then
class = &quot;Inv&quot;
elseif class == &quot;C&quot; then
class = &quot;CraftInv&quot;
elseif class == &quot;E&quot; then
class = &quot;Equipped&quot;
end

category = pack:findFirstChild(class)
if category ~= nil then
p1 = &quot;&quot;

if class == &quot;Inv&quot; then
p1 = &quot;S&quot; .. num
elseif class == &quot;CraftInv&quot; then
p1 = &quot;S&quot; .. num
elseif class == &quot;Equipped&quot; then
if num == &quot;1&quot; then -- E1 = Primary; E2 = Secondary; E3 = Melee; E3 = Special.
p1 = &quot;Primary&quot;
elseif num == &quot;2&quot; then
p1 = &quot;Secondary&quot;
elseif num == &quot;3&quot; then
p1 = &quot;Melee&quot;
elseif num == &quot;4&quot; then
p1 = &quot;Special&quot;
end
end

script.Parent.Main.ItemWiew.Visible = false

p2 = category:findFirstChild(p1)
if p2 ~= nil then
if p2.Value ~= &quot;&quot; and class ~= &quot;CraftInv&quot; then
itemid = p2.Value
item = itemdb:findFirstChild(itemid)
if item ~= nil then
script.Parent.Main.ItemWiew.ItemID.Value = item.Name
script.Parent.Main.ItemWiew.Visible = true
end
else
script.Parent.Main.ItemWiew.Visible = false
end

if p2.Value ~= &quot;&quot; and class == &quot;CraftInv&quot; then
inventory = pack:findFirstChild(&quot;Inv&quot;)
slot1 = inventory:findFirstChild(p2.Value)
if slot1 ~= nil then
if slot1.Value ~= &quot;&quot; then
script.Parent.Main.ItemWiew.ItemID.Value = slot1.Value
script.Parent.Main.ItemWiew.Visible = true
end
end
end

if p2.Value == &quot;&quot; and class == &quot;Equipped&quot; then
if num == &quot;1&quot; then
script.Parent.Main.ItemWiew.ItemID.Value = &quot;X001&quot;
script.Parent.Main.ItemWiew.Visible = true
elseif num == &quot;2&quot; then
script.Parent.Main.ItemWiew.ItemID.Value = &quot;X101&quot;
script.Parent.Main.ItemWiew.Visible = true
elseif num == &quot;3&quot; then
script.Parent.Main.ItemWiew.ItemID.Value = &quot;X201&quot;
script.Parent.Main.ItemWiew.Visible = true
elseif num == &quot;4&quot; then
script.Parent.Main.ItemWiew.ItemID.Value = &quot;X301&quot;
script.Parent.Main.ItemWiew.Visible = true
end
end


end
end
end
end

inv = script.Parent.Main.Inventory
eq = script.Parent.Main.Equipped
cinv = script.Parent.Main.CraftingInv


inv:findFirstChild(&quot;I1&quot;).MouseMoved:connect(function ()
onMouseOver(inv:findFirstChild(&quot;I1&quot;))
