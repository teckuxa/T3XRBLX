					<string name="Name">ShopWiew</string>
					<ProtectedString name="Source">itemserver = game.Workspace:findFirstChild(&quot;ItemServer&quot;)
itemdb = itemserver:findFirstChild(&quot;ItemDB&quot;)
btt = nil
oldbtt = nil

function onMouseOver(btt)

script.Parent.ItemWiew.Visible = false

if btt.Item.Value ~= &quot;&quot; then
itemid = btt.Item.Value
item = itemdb:findFirstChild(itemid)
if item ~= nil then
script.Parent.ItemWiew.sell.Value = true
script.Parent.ItemWiew.ItemID.Value = item.Name
script.Parent.ItemWiew.Visible = true
end
else
script.Parent.ItemWiew.Visible = false
end

end

