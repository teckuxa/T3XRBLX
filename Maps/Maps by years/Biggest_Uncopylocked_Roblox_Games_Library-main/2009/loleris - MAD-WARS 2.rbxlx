pp = game.Workspace.playerpacks:findFirstChild(player.Name)
if pp ~= nil then
lang = pp:findFirstChild(&quot;LANGUAGE&quot;)
end 

function onClick(btt)
if on.Value == false then
on.Value = true

langp = game.Lighting.LanguagePacks:findFirstChild(lang.Value)
if langp ~= nil then
bp = langp:findFirstChild(&quot;Blueprints&quot;):clone()
elseif lang.Value == &quot;English&quot; then
bp = game.Lighting:findFirstChild(&quot;Blueprints&quot;):clone()
end
bp.Parent = script.Parent

langp = game.Lighting.LanguagePacks:findFirstChild(lang.Value)
if langp ~= nil then
script.Parent.blueprints.Text = langp.Words:findFirstChild(&quot;close&quot;).Value
elseif lang.Value == &quot;English&quot; then
script.Parent.blueprints.Text = &quot;CLOSE&quot;
end

else
on.Value = false

bp = script.Parent:findFirstChild(&quot;Blueprints&quot;)
if bp ~= nil then
bp.Parent = nil
end

langp = game.Lighting.LanguagePacks:findFirstChild(lang.Value)
if langp ~= nil then
script.Parent.blueprints.Text = langp.Words:findFirstChild(&quot;blueprints&quot;).Value
elseif lang.Value == &quot;English&quot; then
script.Parent.blueprints.Text = &quot;Blueprints&quot;
end

end
end

script.Parent.blueprints.MouseButton1Up:connect(function ()
onClick(script.Parent.inv)
end)
