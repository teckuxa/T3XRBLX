									</Properties>
								</Item>
								<Item class="Script" referent="RBX5981">
									<Properties>
										<bool name="Archivable">true</bool>
										<bool name="Disabled">false</bool>
										<Content name="LinkedSource"><null></null></Content>
										<string name="Name">KWD</string>
										<ProtectedString name="Source">player = script.Parent.Parent.Parent.Parent.Parent.Parent

kwd = script.Parent.Parent.kwd
ksn = script.Parent.KSN
mode = &quot;&quot;

function msg(txt)
m = Instance.new(&quot;Message&quot;)
m.Text = txt
cup = script.Parent.c_up:clone()
cup.Disabled = false
cup.Parent = m
m.Parent = game.Workspace
end 

while true do 
wait()
if kwd.Value &lt;= 2 then
script.Parent.Text = &quot;&quot;
else
ks = ksn:findFirstChild(kwd.Value)
if ks ~= nil then
if ks.Name ~= mode then
mode = ks.Name 
script.Parent.Text = ks.Value
if ks:findFirstChild(&quot;txt&quot;) ~= nil then
msg(string.upper(player.Name) .. &quot; &quot; .. ks:findFirstChild(&quot;txt&quot;).Value .. &quot; &quot; .. ks.Value)
else
msg(string.upper(player.Name) .. &quot; &quot; .. ks.Value)
end
end
end
end
end </ProtectedString>
									</Properties>
								</Item>
							</Item>
							<Item class="TextLabel" referent="RBX5982">
								<Properties>
									<bool name="Active">false</bool>
									<bool name="Archivable">true</bool>
									<Color3 name="BackgroundColor3">4294374904</Color3>
									<float name="BackgroundTransparency">1</float>
									<Color3 name="BorderColor3">4279970357</Color3>
									<int name="BorderSizePixel">0</int>
									<bool name="Draggable">false</bool>
									<token name="Font">0</token>
									<token name="FontSize">1</token>
									<string name="Name">stuff</string>
									<UDim2 name="Position">
										<XS>0</XS>
										<XO>0</XO>
										<YS>0</YS>
										<YO>5</YO>
									</UDim2>
									<UDim2 name="Size">
										<XS>0</XS>
										<XO>120</XO>
										<YS>0</YS>
										<YO>12</YO>
									</UDim2>
									<token name="SizeConstraint">0</token>
									<string name="Text"></string>
									<Color3 name="TextColor3">4294901760</Color3>
									<float name="TextTransparency">0</float>
									<bool name="TextWrap">false</bool>
									<token name="TextXAlignment">2</token>
									<token name="TextYAlignment">1</token>
									<bool name="Visible">false</bool>
									<int name="ZIndex">1</int>
								</Properties>
								<Item class="Script" referent="RBX5983">
									<Properties>
										<bool name="Archivable">true</bool>
										<bool name="Disabled">false</bool>
										<Content name="LinkedSource"><null></null></Content>
										<string name="Name">Informer</string>
										<ProtectedString name="Source">player = script.Parent.Parent.Parent.Parent.Parent.Parent
pinfo = game.Workspace:findFirstChild(&quot;playergameinfo&quot;)

while true do
wait()
pf = pinfo:findFirstChild(player.Name)
if pf ~= nil then

if pf.idom.Value == true then
pf.idom.Value.Value = false
script.Parent.Text = &quot;DOMINATED&quot;
for i = 1,8 do
script.Parent.Visible = true
wait(0.4)
script.Parent.Visible = false
wait(0.4)
end
script.Parent.Text = &quot;&quot;
end 

if pf.irevenge.Value == true then
pf.irevenge.Value = false
script.Parent.Text = &quot;REVENGE!&quot;
for i = 1,8 do
script.Parent.Visible = true
wait(0.4)
script.Parent.Visible = false
wait(0.4)
end
script.Parent.Text = &quot;&quot;
end 

if pf.inewdom.Value == true then
pf.inewdom.Value = false
script.Parent.Text = &quot;NEW DOMINATION!&quot;
for i = 1,8 do
script.Parent.Visible = true
wait(0.4)
script.Parent.Visible = false
wait(0.4)
end
script.Parent.Text = &quot;&quot;
end 


end
end
</ProtectedString>
									</Properties>
								</Item>
							</Item>
							<Item class="IntValue" referent="RBX5984">
								<Properties>
									<bool name="Archivable">true</bool>
									<string name="Name">kwd</string>
									<int name="Value">0</int>
								</Properties>
							</Item>
							<Item class="Script" referent="RBX5985">
								<Properties>
									<bool name="Archivable">true</bool>
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">infogather</string>
									<ProtectedString name="Source">player = script.Parent.Parent.Parent.Parent.Parent
pinfo = game.Workspace:findFirstChild(&quot;playergameinfo&quot;)
ppacks = game.Workspace:findFirstChild(&quot;playerpacks&quot;)

while true do
wait()
pf = pinfo:findFirstChild(player.Name)
if pf ~= nil then
script.Parent.kwd.Value = pf.kwd.Value

d = pf.dom:GetChildren()
domcount = 0
for i = 1,#d do
if d[i].Value &gt;= 3 then
domcount = domcount + 1
end
end

pp = ppacks:findFirstChild(player.Name)
if pp ~= nil then
lang = pp:findFirstChild(&quot;LANGUAGE&quot;)
lpack = game.Lighting.LanguagePacks:findFirstChild(lang.Value)
if lpack ~= nil then

script.Parent.dominations.Text = lpack.Words:findFirstChild(&quot;dominations&quot;).Value .. &quot;: &quot; .. domcount
script.Parent.killstreak.Text = lpack.Words:findFirstChild(&quot;killswithoutdying&quot;).Value .. &quot;: &quot; .. pf.kwd.Value

elseif lang.Value == &quot;English&quot; then
script.Parent.dominations.Text = &quot;Dominations: &quot; .. domcount
script.Parent.killstreak.Text = &quot;Kills Without Dying: &quot; .. pf.kwd.Value
end

end 

end 

end </ProtectedString>
								</Properties>
							</Item>
							<Item class="Script" referent="RBX5986">
								<Properties>
									<bool name="Archivable">true</bool>
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">Tutorialbtt</string>
									<ProtectedString name="Source">player = script.Parent.Parent.Parent.Parent.Parent

while true do
wait()
if player:findFirstChild(&quot;TDONE&quot;) == nil then
if script.Parent:findFirstChild(&quot;GBTT&quot;) == nil then
gb = game.Lighting:findFirstChild(&quot;GBTT&quot;):clone()
gb.Parent = script.Parent
end
elseif script.Parent:findFirstChild(&quot;GBTT&quot;) ~= nil then
script.Parent:findFirstChild(&quot;GBTT&quot;).Parent = nil
end
end </ProtectedString>
								</Properties>
