							<string name="Name">Pending recieving</string>
							<ProtectedString name="Source">itemdb = script.Parent.Parent.Parent.GItemDB

sam = script.Parent

while true do
wait()
ppack = script.Parent.Parent.Parent:findFirstChild(&quot;Gpack&quot;)
if ppack ~= nil then
SA = ppack:findFirstChild(&quot;SpecAmmo&quot;)
if SA.Value &lt;= 0 then
sam.Visible = false
sam.Text = &quot;&quot;
else
sam.Visible = true
sam.Text = &quot;SPECIAL AMMO: &quot; .. SA.Value
end
end
end </ProtectedString>
