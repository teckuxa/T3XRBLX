							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">EBG script</string>
							<ProtectedString name="Source">Tool = script.Parent -- EBG 2!!!


function fire(v)

&#9;local vCharacter = Tool.Parent
&#9;local vPlayer = game.Players:playerFromCharacter(vCharacter)
&#9;ppack = game.Workspace.playerpacks:findFirstChild(vPlayer.Name)
&#9;if ppack ~= nil then
&#9;SA = ppack:findFirstChild(&quot;SpecAmmo&quot;)
&#9;if SA.Value &gt;= 1 then
&#9;SA.Value = SA.Value - 1

&#9;Tool.Handle.Boing:play()

&#9;local part = Instance.new(&quot;Part&quot;)

        

