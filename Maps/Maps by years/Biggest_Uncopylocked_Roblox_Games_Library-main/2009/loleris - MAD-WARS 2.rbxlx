function OnCh()
if player ~= nil then
&#9;&#9;pack = script.Parent.Parent.Parent.Parent.Gpack
&#9;&#9;if pack ~= nil then
&#9;&#9;&#9;equipped = pack:findFirstChild(&quot;Equipped&quot;)

&#9;&#9;&#9;rocket = equipped:findFirstChild(&quot;Primary&quot;)
&#9;&#9;&#9;bullet = equipped:findFirstChild(&quot;Secondary&quot;)
&#9;&#9;&#9;melle = equipped:findFirstChild(&quot;Melee&quot;)
&#9;&#9;&#9;special = equipped:findFirstChild(&quot;Special&quot;)

&#9;&#9;&#9;rocket2 = script.Parent:findFirstChild(&quot;E1&quot;)
&#9;&#9;&#9;bullet2 = script.Parent:findFirstChild(&quot;E2&quot;)
&#9;&#9;&#9;melle2 = script.Parent:findFirstChild(&quot;E3&quot;)
