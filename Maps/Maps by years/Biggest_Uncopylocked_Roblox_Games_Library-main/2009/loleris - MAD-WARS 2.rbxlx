						<Item class="StringValue" referent="RBX1275">
							<Properties>
								<bool name="Archivable">true</bool>
								<string name="Name">txtStart</string>
								<string name="Value">Welcome to MAD-WARS 2 TUTORIAL! Press the &quot;Next&quot; button to continue...</string>
							</Properties>
						</Item>
						<Item class="StringValue" referent="RBX1276">
							<Properties>
								<bool name="Archivable">true</bool>
								<string name="Name">txtStart2</string>
								<string name="Value">This tutorial will tell you the meaning of the information bars and how to use your inventory, the shop and how to CRAFT items!</string>
							</Properties>
						</Item>
						<Item class="StringValue" referent="RBX1277">
							<Properties>
								<bool name="Archivable">true</bool>
								<string name="Name">txtRecieving</string>
								<string name="Value">You will sometimes recieve items for killing players (Drops). Notice the DARK BAR that shows you recieved something!</string>
							</Properties>
						</Item>
						<Item class="StringValue" referent="RBX1278">
							<Properties>
								<bool name="Archivable">true</bool>
								<string name="Name">txtRecieving2</string>
								<string name="Value">Lets check your inventory if you have any items in there! Press the yellow &quot;Inventory&quot; button!</string>
							</Properties>
						</Item>
						<Item class="StringValue" referent="RBX1279">
							<Properties>
								<bool name="Archivable">true</bool>
								<string name="Name">txtInventory</string>
								<string name="Value">The boxes below the &quot;Inventory&quot; sign shows your inventory slots (16 in total). The boxes below the &quot;Equipped&quot; sign shows your equipped items. The boxes below the sign &quot;Crafting Space&quot; shows your selected items for crafting.</string>
							</Properties>
						</Item>
						<Item class="StringValue" referent="RBX1280">
							<Properties>
								<bool name="Archivable">true</bool>
								<string name="Name">txtInventory2</string>
								<string name="Value">You have been given some items! Lets equip them! First click on the rocket launcher.</string>
							</Properties>
						</Item>
						<Item class="StringValue" referent="RBX1281">
							<Properties>
								<bool name="Archivable">true</bool>
								<string name="Name">txtInventory3</string>
								<string name="Value">Now click on the Primary weapon slot!</string>
							</Properties>
						</Item>
						<Item class="StringValue" referent="RBX1282">
							<Properties>
								<bool name="Archivable">true</bool>
								<string name="Name">txtInventory4</string>
								<string name="Value">Lets do the same with the revolver! click on the revolver...</string>
							</Properties>
						</Item>
						<Item class="StringValue" referent="RBX1283">
							<Properties>
								<bool name="Archivable">true</bool>
								<string name="Name">txtInventory5</string>
								<string name="Value">...Then click on the Secondary weapon slot.</string>
							</Properties>
						</Item>
						<Item class="StringValue" referent="RBX1284">
							<Properties>
								<bool name="Archivable">true</bool>
								<string name="Name">txtInventory6</string>
								<string name="Value">There are four weapon classes - Primary, Secondary, Melee and Special. After you change your equipped weapons you will have to respawn to get the new ones.</string>
							</Properties>
						</Item>
						<Item class="StringValue" referent="RBX1285">
							<Properties>
								<bool name="Archivable">true</bool>
								<string name="Name">txtCrafting</string>
								<string name="Value">You have been given some crafting materials! you can use them to create a weapon! Click on the crystal...</string>
							</Properties>
						</Item>
						<Item class="StringValue" referent="RBX1286">
							<Properties>
								<bool name="Archivable">true</bool>
								<string name="Name">txtCrafting2</string>
								<string name="Value">Now click on a crafting slot below the &quot;Crafting Space&quot; sign.</string>
							</Properties>
						</Item>
						<Item class="StringValue" referent="RBX1287">
							<Properties>
								<bool name="Archivable">true</bool>
								<string name="Name">txtCrafting3</string>
								<string name="Value">Do the same with the Glass Sword - click on it...</string>
							</Properties>
						</Item>
						<Item class="StringValue" referent="RBX1288">
							<Properties>
								<bool name="Archivable">true</bool>
								<string name="Name">txtCrafting4</string>
								<string name="Value">And then on a crafting slot...</string>
							</Properties>
						</Item>
						<Item class="StringValue" referent="RBX1289">
							<Properties>
								<bool name="Archivable">true</bool>
								<string name="Name">txtCrafting5</string>
								<string name="Value">Theese items are required to make a sword called Illumina. You can see more blue prints (crafting combinations) by clicking on the blue &quot;Blueprints&quot; button. Lets click the &quot;Craft it!&quot; button!</string>
							</Properties>
						</Item>
						<Item class="StringValue" referent="RBX1290">
							<Properties>
								<bool name="Archivable">true</bool>
								<string name="Name">txtCrafting6</string>
								<string name="Value">You created Illumina!</string>
							</Properties>
						</Item>
						<Item class="StringValue" referent="RBX1291">
							<Properties>
								<bool name="Archivable">true</bool>
								<string name="Name">txtCrafting7</string>
								<string name="Value">Lets equip it - click on Illumina!</string>
							</Properties>
						</Item>
						<Item class="StringValue" referent="RBX1292">
							<Properties>
								<bool name="Archivable">true</bool>
								<string name="Name">txtCrafting8</string>
								<string name="Value">Now, click on the Melee weapon slot!</string>
							</Properties>
						</Item>
						<Item class="StringValue" referent="RBX1293">
							<Properties>
								<bool name="Archivable">true</bool>
								<string name="Name">txtEnd</string>
								<string name="Value">Very good... Now close the Inventory with the same yellow button.</string>
							</Properties>
						</Item>
						<Item class="StringValue" referent="RBX1294">
							<Properties>
								<bool name="Archivable">true</bool>
								<string name="Name">txtEnd2</string>
								<string name="Value">You can access the shop by clicking the yellow &quot;SHOP&quot; button. It will be easy to understand how it works ;D.</string>
							</Properties>
						</Item>
						<Item class="StringValue" referent="RBX1295">
							<Properties>
								<bool name="Archivable">true</bool>
								<string name="Name">txtEnd3</string>
								<string name="Value">And also if you have too many weapons and most of them are junk you can remove them with the &quot;Discard&quot; button.</string>
							</Properties>
						</Item>
						<Item class="StringValue" referent="RBX1296">
							<Properties>
								<bool name="Archivable">true</bool>
								<string name="Name">txtEnd4</string>
								<string name="Value">Happy play time!</string>
							</Properties>
						</Item>
						<Item class="StringValue" referent="RBX1297">
							<Properties>
								<bool name="Archivable">true</bool>
								<string name="Name">txtBars2</string>
								<string name="Value">This is the Kills without dying bar! It shows how many players you killed without dying! everyone will get informed about your Kills without dying!</string>
							</Properties>
						</Item>
						<Item class="StringValue" referent="RBX1298">
							<Properties>
								<bool name="Archivable">true</bool>
								<string name="Name">txtBars</string>
								<string name="Value">This is the Domination counter! if you manage to kill a player 3 times without getting killed by him you earn a domination!</string>
							</Properties>
						</Item>
						<Item class="StringValue" referent="RBX1299">
							<Properties>
								<bool name="Archivable">true</bool>
								<string name="Name">txtBars3</string>
								<string name="Value">You will be informed like this when you recieve special ammo. Notice the RED BAR that shows &quot;Special Ammo: 4&quot;. Some weapons work on special ammo ONLY.</string>
							</Properties>
						</Item>
						<Item class="StringValue" referent="RBX1300">
							<Properties>
								<bool name="Archivable">true</bool>
								<string name="Name">txtTheEnd</string>
								<string name="Value">You completed the tutorial! I hope you will have some great fun! Press the &quot;END&quot; button to finish the tutorial</string>
							</Properties>
						</Item>
					</Item>
					<Item class="BoolValue" referent="RBX1301">
						<Properties>
							<bool name="Archivable">true</bool>
							<string name="Name">nxt</string>
							<bool name="Value">false</bool>
						</Properties>
					</Item>
					<Item class="BoolValue" referent="RBX1302">
						<Properties>
							<bool name="Archivable">true</bool>
							<string name="Name">cncl</string>
