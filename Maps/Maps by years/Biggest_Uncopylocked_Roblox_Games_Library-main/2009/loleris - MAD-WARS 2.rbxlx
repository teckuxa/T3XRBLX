									<string name="Name">MasterScript</string>
									<ProtectedString name="Source">print(&quot;Guide MASTER SCRIPT loaded...&quot;)

mainbox = script.Parent
lines = script.Parent.Lines
nxtb = script.Parent.Next
nxt = script.Parent.nxt
allownxt = script.Parent.Next.allow
nxthint = script.Parent.nxtHint
windowopening = script.Parent.Parent:findFirstChild(&quot;open windows&quot;)

rec = script.Parent.Parent.Recieving
itemdb = game.Lighting.LanguagePacks:findFirstChild(&quot;Sweden&quot;).ItemDB ---X002---X003---X102---X202---X203---X302---

-----------------------------------------------------------------------------The start
mainbox.Text = lines:findFirstChild(&quot;txtStart&quot;).Value
nxt.Value = false
allownxt.Value = true 
nxthint.Visible = true 
nxtb.Visible = true

while nxt.Value == false do
wait()
end 
-----------------------------------------------------------------------------The start2
mainbox.Text = lines:findFirstChild(&quot;txtStart2&quot;).Value
nxt.Value = false
allownxt.Value = true
nxthint.Visible = true 
nxtb.Visible = true

while nxt.Value == false do
wait()
end 
-----------------------------------------------------------------------------The Recieving
mainbox.Text = lines:findFirstChild(&quot;txtRecieving&quot;).Value
nxt.Value = false
allownxt.Value = true
nxthint.Visible = true 
nxtb.Visible = true

randitemcount = 1

while nxt.Value == false do
wait()

if randitemcount == 1 then
dbitem = itemdb:findFirstChild(&quot;X002&quot;)
elseif randitemcount == 2 then
dbitem = itemdb:findFirstChild(&quot;X003&quot;)
elseif randitemcount == 3 then
dbitem = itemdb:findFirstChild(&quot;X102&quot;)
elseif randitemcount == 4 then
dbitem = itemdb:findFirstChild(&quot;X202&quot;)
elseif randitemcount == 5 then
dbitem = itemdb:findFirstChild(&quot;X203&quot;)
elseif randitemcount == 6 then
dbitem = itemdb:findFirstChild(&quot;X302&quot;)
end

if dbitem ~= nil then
iname = dbitem:findFirstChild(&quot;ItemName2&quot;)
ilvl = dbitem:findFirstChild(&quot;ItemLevel&quot;)
iwslot = dbitem:findFirstChild(&quot;WepSlot&quot;)
iclass = dbitem:findFirstChild(&quot;ItemName&quot;)
if iwslot ~= nil then
line1 = iname.Value
line2 = &quot;lvl &quot; .. ilvl.Value .. &quot; &quot; .. iwslot.Value .. &quot; &quot; .. iclass.Value .. &quot;.&quot;
line3 = &quot;&quot;
else
line1 = iname.Value
line2 = &quot;lvl &quot; .. ilvl.Value .. &quot; &quot; .. iclass.Value .. &quot;.&quot;
line3 = &quot;&quot;
end
rec.Visible = true
rec.recievename.Text = line1
rec.recieveclass.Text = line2
rec.recieveinfo.Text = line3
wait(0.5)
end

randitemcount = randitemcount + 1

if randitemcount &gt;= 7 then
randitemcount = 1
end

end 
-----------------------------------------------------------------------------The Recieving2

rec.recievename.Text = &quot;&quot;
rec.recieveclass.Text = &quot;&quot;
rec.recieveinfo.Text = &quot;&quot;
rec.Visible = false
--- end of Recieving1 ---

