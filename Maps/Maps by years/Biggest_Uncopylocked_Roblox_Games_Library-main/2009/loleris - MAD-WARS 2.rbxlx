script.Parent.Main.CraftInfo.nes.Visible = true
wait(2)
script.Parent.Main.CraftInfo.nes.Visible = false
end
end
------------------------------------------------------------------------------
if dbitem.Name == &quot;X406&quot; then
h = invslots:GetChildren()
enough = 0
for lol = 1,#h do
&#9;if h[lol].Value == &quot;&quot; then
&#9;&#9;enough = enough + 1
&#9;end
end
if enough &gt;= 2 then
invslots:findFirstChild(slot.Value).Value = &quot;&quot;
slot.Value = &quot;&quot;

newitemid = &quot;X405&quot;
h = invslots:GetChildren()
gotenough = 0
for lol = 1,#h do
&#9;if gotenough ~= 3 then
&#9;&#9;if h[lol].Value == &quot;&quot; then
&#9;&#9;&#9;h[lol].Value = newitemid
&#9;&#9;&#9;gotenough = gotenough + 1
&#9;&#9;end
&#9;end
end
failed = false
script.Parent.Main.CraftInfo.amount.Value = 3
script.Parent.Main.CraftInfo.ItemID.Value = newitemid
script.Parent.Main.CraftInfo.good.Visible = true
wait(6)
script.Parent.Main.CraftInfo.good.Visible = false

else
failed = false
script.Parent.Main.CraftInfo.nes.Visible = true
wait(2)
script.Parent.Main.CraftInfo.nes.Visible = false
end
end
------------------------------------------------------------------------------
end
end
end
end



if failed == true then
script.Parent.Main.CraftInfo.bad.Visible = true
wait(2)
script.Parent.Main.CraftInfo.bad.Visible = false
end


selected.Value = &quot;&quot;
end

else
craftslots = pack:findFirstChild(&quot;CraftInv&quot;)
craftslot1 = craftslots:findFirstChild(&quot;S&quot; .. string.sub(btt.Name,2,2))
if craftslot1.Value ~= &quot;&quot; then
craftslot1.Value = &quot;&quot; 
end
selected.Value = &quot;&quot;
end
end
