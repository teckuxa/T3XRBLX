				<Item class="Script" referent="RBX1881">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Images</string>
						<ProtectedString name="Source">player = script.Parent.Parent.Parent.Parent.Parent
while true do
wait()
for i = 1,16 do
&#9;wait()
&#9;slot = script.Parent:findFirstChild(&quot;I&quot; .. i)
&#9;if slot ~= nil then
&#9;&#9;if slot.Item.Value == &quot;&quot; then
&#9;&#9;&#9;if slot.Image ~= &quot;http://www.roblox.com/asset/?id=29610183&quot; then
&#9;&#9;&#9;&#9;slot.Image = &quot;http://www.roblox.com/asset/?id=29610183&quot;
&#9;&#9;&#9;&#9;print(&quot;1 changed&quot;)
&#9;&#9;&#9;end
&#9;&#9;else
&#9;&#9;&#9;itemdb = script.Parent.Parent.Parent.GItemDB
&#9;&#9;&#9;item = itemdb:findFirstChild(slot.Item.Value)
&#9;&#9;&#9;if item ~= nil then
&#9;&#9;&#9;&#9;if item:findFirstChild(&quot;Picture&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;if slot.Image ~= item:findFirstChild(&quot;Picture&quot;).Value then
&#9;&#9;&#9;&#9;&#9;&#9;slot.Image = item:findFirstChild(&quot;Picture&quot;).Value
&#9;&#9;&#9;&#9;&#9;&#9;print(&quot;2 changed&quot;)
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end 



end </ProtectedString>
					</Properties>
				</Item>
			</Item>
			<Item class="Script" referent="RBX1882">
				<Properties>
					<bool name="Archivable">true</bool>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">ItemWiew</string>
					<ProtectedString name="Source">player = script.Parent.Parent.Parent.Parent

pack = script.Parent.Parent.Gpack

itemdb = script.Parent.Parent.GItemDB
itemcraft = script.Parent.Parent.GItemCraft

btt = nil
oldbtt = nil

function onMouseOver(btt)
class = string.sub(btt.Name,1,1)
num = string.sub(btt.Name,2,3)

if class == &quot;I&quot; then
class = &quot;Inv&quot;
elseif class == &quot;C&quot; then
class = &quot;CraftInv&quot;
elseif class == &quot;E&quot; then
class = &quot;Equipped&quot;
end

category = pack:findFirstChild(class)
if category ~= nil then
p1 = &quot;&quot;

if class == &quot;Inv&quot; then
p1 = &quot;S&quot; .. num
elseif class == &quot;CraftInv&quot; then
p1 = &quot;S&quot; .. num
elseif class == &quot;Equipped&quot; then
if num == &quot;1&quot; then -- E1 = Primary; E2 = Secondary; E3 = Melee; E3 = Special.
p1 = &quot;Primary&quot;
elseif num == &quot;2&quot; then
p1 = &quot;Secondary&quot;
elseif num == &quot;3&quot; then
p1 = &quot;Melee&quot;
elseif num == &quot;4&quot; then
p1 = &quot;Special&quot;
end
end

script.Parent.ItemWiew.Visible = false

p2 = category:findFirstChild(p1)
if p2 ~= nil then
if p2.Value ~= &quot;&quot; and class ~= &quot;CraftInv&quot; then
itemid = p2.Value
item = itemdb:findFirstChild(itemid)
if item ~= nil then
script.Parent.ItemWiew.sell.Value = false
script.Parent.ItemWiew.ItemID.Value = item.Name
script.Parent.ItemWiew.Visible = true
end
else
script.Parent.ItemWiew.Visible = false
end

end
end
end

inv = script.Parent.Inventory

