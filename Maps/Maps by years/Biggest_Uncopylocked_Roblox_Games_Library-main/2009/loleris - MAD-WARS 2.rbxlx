function OnChangeGive()
if give.Value == true then 
give.Value = false
print(&quot;Giving players they&apos;re weapons...&quot;)
p = game.Players:GetChildren()
for i = 1,#p do
print(&quot;Giving &quot; .. p[i].Name .. &quot; weapons...&quot;)

local backpack = p[i]:findFirstChild(&quot;Backpack&quot;)
local playerpack = game.Workspace.playerpacks:findFirstChild(p[i].Name)

if backpack ~= nil and playerpack ~= nil then

equipped = playerpack:findFirstChild(&quot;Equipped&quot;)
w1 = equipped:findFirstChild(&quot;Primary&quot;)
w2 = equipped:findFirstChild(&quot;Secondary&quot;)
w3 = equipped:findFirstChild(&quot;Melee&quot;)
w4 = equipped:findFirstChild(&quot;Special&quot;)

if w1.Value ~= &quot;&quot; and primary.Value == true then
item = itemdb:findFirstChild(w1.Value)
print(&quot;Giving &quot; .. p[i].Name .. &quot; &quot; .. item)
&#9;if item ~= nil then
&#9;&#9;name = item:findFirstChild(&quot;ItemName2&quot;)
&#9;&#9;if name ~= nil then
&#9;&#9;&#9;theweapon = weapons:findFirstChild(name.Value)
&#9;&#9;&#9;if theweapon ~= nil then
&#9;&#9;&#9;&#9;theweapon:clone().Parent = backpack
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
else
item = itemdb:findFirstChild(&quot;X001&quot;)
print(&quot;Giving &quot; .. p[i].Name .. &quot; &quot; .. item.Name)
&#9;if item ~= nil then
&#9;&#9;name = item:findFirstChild(&quot;ItemName2&quot;)
&#9;&#9;if name ~= nil then
&#9;&#9;&#9;theweapon = weapons:findFirstChild(name.Value)
&#9;&#9;&#9;if theweapon ~= nil then
&#9;&#9;&#9;&#9;theweapon:clone().Parent = backpack
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

if w2.Value ~= &quot;&quot; and secondary.Value == true then
item = itemdb:findFirstChild(w2.Value)
print(&quot;Giving &quot; .. p[i].Name .. &quot; &quot; .. item.Name)
&#9;if item ~= nil then
&#9;&#9;name = item:findFirstChild(&quot;ItemName2&quot;)
&#9;&#9;if name ~= nil then
&#9;&#9;&#9;theweapon = weapons:findFirstChild(name.Value)
&#9;&#9;&#9;if theweapon ~= nil then
