&#9;&#9;else
&#9;&#9;slot3 = &quot;&quot;
&#9;&#9;end
&#9;&#9;if craftslots:findFirstChild(&quot;S4&quot;).Value ~= &quot;&quot; then
&#9;&#9;slot4 = invslots:findFirstChild(craftslots:findFirstChild(&quot;S4&quot;).Value).Value
&#9;&#9;else
&#9;&#9;slot4 = &quot;&quot;
&#9;&#9;end
&#9;&#9;if craftslots:findFirstChild(&quot;S5&quot;).Value ~= &quot;&quot; then
&#9;&#9;slot5 = invslots:findFirstChild(craftslots:findFirstChild(&quot;S5&quot;).Value).Value
&#9;&#9;else
&#9;&#9;slot5 = &quot;&quot;
&#9;&#9;end
&#9;&#9;if craftslots:findFirstChild(&quot;S6&quot;).Value ~= &quot;&quot; then
&#9;&#9;slot6 = invslots:findFirstChild(craftslots:findFirstChild(&quot;S6&quot;).Value).Value
&#9;&#9;else
&#9;&#9;slot6 = &quot;&quot;
&#9;&#9;end
&#9;&#9;slot = {slot1, slot2, slot3, slot4, slot5, slot6}
&#9;&#9;print(slot[1] .. slot[2] .. slot[3] .. slot[4] .. slot[5] .. slot[6])

&#9;&#9;pass = true
&#9;&#9;cn = cr[i]:findFirstChild(&quot;Items&quot;):GetChildren()
&#9;&#9;for w = 1,#cn do
&#9;&#9;&#9;pass2 = false

&#9;&#9;&#9;for q = 1,6 do
&#9;&#9;&#9;&#9;if pass2 == false then
&#9;&#9;&#9;&#9;&#9;if slot[q] == cn[w].Value then
&#9;&#9;&#9;&#9;&#9;pass2 = true
&#9;&#9;&#9;&#9;&#9;slot[q] = &quot;&quot;
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end

