					<Item class="Script" referent="RBX1182">
						<Properties>
							<bool name="Archivable">true</bool>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Pending recieving</string>
							<ProtectedString name="Source">player = script.Parent.Parent.Parent.Parent.Parent
itemdb = game.Workspace:findFirstChild(&quot;ItemServer&quot;).ItemDB
playerpacks = game.Workspace:findFirstChild(&quot;playerpacks&quot;)

sam = script.Parent

while true do
wait()
ppack = playerpacks:findFirstChild(player.Name)
if ppack ~= nil then
SA = ppack:findFirstChild(&quot;SpecAmmo&quot;)
if SA.Value &lt;= 0 then
sam.Visible = false
sam.Text = &quot;&quot;
else
sam.Visible = true
sam.Text = &quot;SPECIAL AMMO: &quot; .. SA.Value
end
end
end </ProtectedString>
