			<Item class="Script" referent="RBX4758">
				<Properties>
					<bool name="Archivable">true</bool>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">commands</string>
					<ProtectedString name="Source">char = script.Parent.Parent.Parent

skull = script.Parent.Skull
dom = script.Parent.Domination
lol = script.Parent.lol

mode = &quot;&quot;

while true do
wait()
p = game.Players:playerFromCharacter(char)
if p ~= nil then
h = char:findFirstChild(&quot;Humanoid&quot;)
if h ~= nil then
if h.Health ~= 0 then
ps = game.Workspace.playergameinfo:findFirstChild(p.Name)
if ps ~= nil then
domination = false
kwd = ps:findFirstChild(&quot;kwd&quot;)
d = ps:findFirstChild(&quot;dom&quot;):GetChildren()

if kwd.Value &gt;= 3 and (kwd.Value/3) == math.floor(kwd.Value/3) then
if mode ~= &quot;K&quot; .. kwd.Value then
mode = &quot;K&quot; .. kwd.Value

dom.Visible = false
skull.Visible = false

lol.Visible = true

for i = 1,30 do
wait(0.06)
script.Parent.StudsOffset = script.Parent.StudsOffset + Vector3.new(0,0.05,0)
end

script.Parent.StudsOffset = Vector3.new(0,4,0)


lol.Visible = false

end
end



for i = 1,#d do
if d[i].Value &gt;= 3 then
dom.Visible = true
domination = true
end
end

if domination == false then
dom.Visible = false
end

end
else
dom.Visible = false
lol.Visible = false
skull.Visible = true
end
end
end
end </ProtectedString>
				</Properties>
			</Item>
