						<string name="Name">Paintball</string>
						<ProtectedString name="Source">ball = script.Parent
damage = 15
headdamage = 30
done = false


function onTouched(hit)
if done == false then
done = true
&#9;if hit.Parent.className == &quot;Hat&quot; then
&#9;humanoid = hit.Parent.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;else
&#9;humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;end
&#9;-- make a splat
&#9;--for i=1,3 do
&#9;--&#9;local s = Instance.new(&quot;Part&quot;)
&#9;--&#9;s.Shape = 1 -- block
&#9;--&#9;s.formFactor = 2 -- plate
&#9;--&#9;s.Size = Vector3.new(1,.4,1)
&#9;--&#9;s.BrickColor = BrickColor.new(21)
&#9;--&#9;local v = Vector3.new(math.random(-1,1), math.random(0,1), math.random(-1,1))
&#9;--&#9;s.Velocity = 15 * v--15
&#9;--&#9;s.CFrame = CFrame.new(ball.Position + v, v)
&#9;---&#9;ball.BrickCleanup:clone().Parent = s
&#9;--&#9;s.BrickCleanup.Disabled = false
&#9;--&#9;s.Parent = game.Workspace
&#9;--&#9;
&#9;--end
&#9;

&#9;if humanoid ~= nil then
&#9;if humanoid.Parent.Torso.BrickColor ~= ball.BrickColor then
&#9;if hit.Name == &quot;Handle&quot; or hit.Name == &quot;Head&quot; then
&#9;&#9;tagHumanoid(humanoid)
&#9;&#9;humanoid.Health = humanoid.Health - headdamage
&#9;&#9;print(&quot;HEADSHOT!&quot;)

&#9;&#9;-- teh fun hits!
&#9;&#9;hd = humanoid.Parent:findFirstChild(&quot;Head&quot;)
&#9;&#9;if hd ~= nil then
&#9;&#9;pinfo = hd:findFirstChild(&quot;Player INFO&quot;)
&#9;&#9;if pinfo ~= nil then
&#9;&#9;hitt = math.random(1,2)
&#9;&#9;if hitt == 1 then
&#9;&#9;&#9;pinfo.ch.Value = true
&#9;&#9;else
&#9;&#9;&#9;pinfo.eh.Value = true
&#9;&#9;end
&#9;&#9;end
&#9;&#9;end
&#9;&#9;-- teh fun hits!

&#9;&#9;game.Workspace.Headshot:play()
&#9;&#9;wait()
&#9;&#9;untagHumanoid(humanoid)
&#9;&#9;if humanoid.Health &lt;= 0 and humanoid.Parent:findFirstChild(&quot;Head&quot;) ~= nil then
&#9;&#9;&#9;for i=1,5 do
&#9;&#9;&#9;&#9;local s = Instance.new(&quot;Part&quot;)
&#9;&#9;&#9;&#9;s.Shape = 1 -- block
&#9;&#9;&#9;&#9;s.formFactor = 2 -- plate
&#9;&#9;&#9;&#9;s.Size = Vector3.new(1,.4,1)
&#9;&#9;&#9;&#9;s.BrickColor = BrickColor.new(21)
&#9;&#9;&#9;&#9;local v = Vector3.new(math.random(-1,1), math.random(0,1), math.random(-1,1))
&#9;&#9;&#9;&#9;s.Velocity = 15 * v--15
&#9;&#9;&#9;&#9;s.CFrame = CFrame.new(humanoid.Parent.Head.Position + v, v)
&#9;&#9;&#9;&#9;ball.BrickCleanup:clone().Parent = s
&#9;&#9;&#9;&#9;s.BrickCleanup.Disabled = false
&#9;&#9;&#9;&#9;s.Parent = game.Workspace
&#9;&#9;&#9;end
&#9;&#9;end
&#9;else
&#9;&#9;tagHumanoid(humanoid)
&#9;&#9;humanoid.Health = humanoid.Health - damage
&#9;&#9;wait()
&#9;&#9;untagHumanoid(humanoid)
&#9;end
&#9;end
&#9;end

&#9;connection:disconnect()
&#9;ball.Parent = nil
end
end

function tagHumanoid(humanoid)
