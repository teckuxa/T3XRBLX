					<Item class="Script" referent="RBX8178">
						<Properties>
							<bool name="Archivable">true</bool>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">PushBack</string>
							<ProtectedString name="Source">door = script.Parent

function onTouch(hit)
&#9;if hit.Parent == nil then return end
&#9;local h = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
&#9;if h ~= nil then
&#9;&#9;if h.Parent:findFirstChild(&quot;Torso&quot;) ~= nil then
&#9;&#9;if h.Parent:findFirstChild(&quot;Torso&quot;).BrickColor ~= script.Parent.team.Value then
&#9;&#9;hit.Parent.Torso.Velocity = door.CFrame.lookVector * 40
&#9;&#9;else
&#9;&#9;&#9;if h.Parent:findFirstChild(&quot;GFF&quot;) ~= nil then
&#9;&#9;&#9;&#9;h.Parent:findFirstChild(&quot;GFF&quot;).Parent = nil
&#9;&#9;&#9;end
&#9;&#9;&#9;if h.Parent:findFirstChild(&quot;Guard&quot;) ~= nil then
&#9;&#9;&#9;&#9;h.Parent:findFirstChild(&quot;Guard&quot;).Parent = nil
&#9;&#9;&#9;&#9;print(&quot;Guard for &quot; .. h.Parent.Name .. &quot; was removed&quot;)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;end
&#9;end
end
door.Touched:connect(onTouch)</ProtectedString>
						</Properties>
					</Item>
					<Item class="Script" referent="RBX8179">
						<Properties>
							<bool name="Archivable">true</bool>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">door mover</string>
							<ProtectedString name="Source">while true do
wait()
openit = false
p = game.Players:GetChildren()
for i = 1,#p do
if p[i].TeamColor == script.Parent.team.Value then
char = p[i].Character
if char ~= nil then
if char:findFirstChild(&quot;Humanoid&quot;) ~= nil and  char:findFirstChild(&quot;Torso&quot;) ~= nil then
count = (script.Parent.Position - char:findFirstChild(&quot;Torso&quot;).Position).magnitude
if count &lt;= 23 then
openit = true
end
end
end
end
end

if openit == true then
if script.Parent.Mesh.Offset.y &lt; 14 then
script.Parent.Mesh.Offset = script.Parent.Mesh.Offset + Vector3.new(0,0.5,0)
end
else
if script.Parent.Mesh.Offset.y &gt; 0 then
script.Parent.Mesh.Offset = script.Parent.Mesh.Offset - Vector3.new(0,0.5,0)
end
end


end
</ProtectedString>
						</Properties>
					</Item>
