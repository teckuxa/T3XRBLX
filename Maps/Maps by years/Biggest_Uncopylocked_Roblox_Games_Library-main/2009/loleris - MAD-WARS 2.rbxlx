&#9;&#9;&#9;&#9;&#9;craftslots:findFirstChild(&quot;S&quot; .. e).Value = &quot;&quot;
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;newitemid = cr[i].Name
&#9;&#9;&#9;h = invslots:GetChildren()
&#9;&#9;&#9;gotit = false
&#9;&#9;&#9;for lol = 1,#h do
