					<Item class="Script" referent="RBX4980">
						<Properties>
							<bool name="Archivable">true</bool>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Animation</string>
							<ProtectedString name="Source">brick = script.Parent.Parent.spinner

script.Parent.shoot.Changed:connect(function()
if script.Parent.shoot.Value == true then
script.Parent.shoot.Value = false
shoot()
end
end)

script.Parent.charge.Changed:connect(function()
if script.Parent.charge.Value == true then
charge()
end
end)

function shoot()
brick.BrickColor = BrickColor.new(21)
wait()
brick.BrickColor = BrickColor.new(37)
wait()
brick.BrickColor = BrickColor.new(23)
wait()
script.Parent.shootsound:play()
script.Parent.Parent.tip.Reflectance = 0.5
for i = 1,5 do
wait(0.1)
end
script.Parent.Parent.tip.Reflectance = 0.2
brick.BrickColor = BrickColor.new(26)
end 

function charge()
brick.BrickColor = BrickColor.new(1)
wait()
script.Parent.charge1sound.Pitch = 4
script.Parent.charge1sound:play()
for i = 1,10 do
wait(0.1)
script.Parent.Parent.tip.Reflectance = script.Parent.Parent.tip.Reflectance + 0.4
end

count = 8
while script.Parent.charge.Value == true do
script.Parent.Parent.Charge.on2.Value = false
if count &gt;= 8 then
count = 1
script.Parent.charge1sound.Pitch = 5
script.Parent.charge1sound:play()
brick.Color = Color3.new(math.random(),math.random(),math.random())
else
count = count + 1
end
wait()
end

script.Parent.charge2sound:play()
script.Parent.Parent.tip.Reflectance = 0.2

for i = 1,5 do
wait()
end
brick.BrickColor = BrickColor.new(26)
end </ProtectedString>
