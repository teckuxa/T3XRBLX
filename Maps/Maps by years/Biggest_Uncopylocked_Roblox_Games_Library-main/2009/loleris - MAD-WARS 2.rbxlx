							<string name="Name">Script</string>
							<ProtectedString name="Source">enabled = true

function activate()
if enabled == true then
enabled = false
script.Parent.Parent.ButtonBlock.open.Value = false
wait(1)
script.Parent.Parent.Signal.Looped = true
script.Parent.Parent.Signal:play()

for i = 1,230 do
&#9;script.Parent.Parent.BunkerDoor.CFrame = CFrame.new(script.Parent.Parent.BunkerDoor.Position - Vector3.new(0,0.1,0))
&#9;wait(0.2)
end
wait()
script.Parent.Parent.Signal.Looped = false
script.Parent.Parent.Signal:stop()
wait(4)
script.Parent.Parent.TowerDoor1.open.Value = false
script.Parent.Parent.TowerDoor2.open.Value = false
script.Parent.Parent.Window1.open.Value = false
script.Parent.Parent.Window2.open.Value = false
script.Parent.Parent.Swoosh:play()
wait(7)
script.Parent.Parent.Swoosh:stop()
wait()
nuke()
script.Parent.Parent.Nuke:play()
for i = 1,30 do
&#9;script.Parent.Parent.BunkerDoor.CFrame = CFrame.new(script.Parent.Parent.BunkerDoor.Position + Vector3.new(0,0.1,0))
&#9;wait(0.01)
end

script.Parent.Parent.TowerDoor1.open.Value = true
script.Parent.Parent.TowerDoor2.open.Value = true
script.Parent.Parent.Window1.open.Value = true
script.Parent.Parent.Window2.open.Value = true

for i = 1,200 do
&#9;script.Parent.Parent.BunkerDoor.CFrame = CFrame.new(script.Parent.Parent.BunkerDoor.Position + Vector3.new(0,0.1,0))
&#9;wait(0.01)
end

script.Parent.Parent.Nuke:stop()
wait(40)
script.Parent.Parent.ButtonBlock.open.Value = true
wait(4)
enabled = true
end
end


function nuke()
p = game.Players:GetChildren()
f = script.Parent.Parent.fields:GetChildren()
for e = 1,#f do

px = f[e].Pos.Value.x
py = f[e].Pos.Value.y
pz = f[e].Pos.Value.z

sx = f[e].Siz.Value.x/2
sy = f[e].Siz.Value.y/2
sz = f[e].Siz.Value.z/2

for i = 1,#p do
if p[i].Character:findFirstChild(&quot;Torso&quot;) ~= nil and p[i].Character:findFirstChild(&quot;Humanoid&quot;) ~= nil then

pos = p[i].Character:findFirstChild(&quot;Torso&quot;).Position
posx = pos.x
posy = pos.y
posz = pos.z

if posx - px &lt; 0 then
countx = (posx - px)*-1
else
countx = (posx - px)
end

if posy - py &lt; 0 then
county = (posy - py)*-1
else
county = (posy - py)
end

if posz - pz &lt; 0 then
countz = (posz - pz)*-1
else
countz = (posz - pz)
end

if countx &lt;= sx and county &lt;= sy and countz &lt;= sz then
if p[i].Character:findFirstChild(&quot;Humanoid&quot;).Health ~= 0 then
p[i].Character:findFirstChild(&quot;Humanoid&quot;).Health = 0
p[i].Character:BreakJoints()
pp = p[i].Character:GetChildren()
for eh = 1,#pp do
if pp[eh].className == &quot;Part&quot; then
pp[eh].Velocity = Vector3.new(math.random(-1000,1000),math.random(-1000,1000),math.random(-1000,1000))
end
end

end
else
-- nuthin...
end

end
end 

end

for i = 1,#p do
game.Lighting:findFirstChild(&quot;NukeFlash&quot;):clone().Parent = p[i].PlayerGui
end




end

script.Parent.Touched:connect(function()
activate()
end)</ProtectedString>
