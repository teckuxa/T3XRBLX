					<string name="Name">MSC</string>
					<ProtectedString name="Source">function createpack(player)
mainm = Instance.new(&quot;Model&quot;)
mainm.Name = player.Name

inv = Instance.new(&quot;Model&quot;)
inv.Name = &quot;Inv&quot;
inv.Parent = mainm

for i = 1,16 do -- generating slot info section
newval = Instance.new(&quot;StringValue&quot;)
newval.Name = &quot;S&quot; .. i
--if newval.Name == &quot;S2&quot; then -- EVENT GIVER!
--newval.Value = &quot;X105&quot;
--else
newval.Value = &quot;&quot;
--end
newval.Parent = inv
end

eq = Instance.new(&quot;Model&quot;)
eq.Name = &quot;Equipped&quot;
eq.Parent = mainm

pending = Instance.new(&quot;Model&quot;)
pending.Name = &quot;Pending&quot;
pending.Parent = mainm

rckt = Instance.new(&quot;StringValue&quot;)
rckt.Name = &quot;Primary&quot;
rckt.Value = &quot;&quot;
rckt.Parent = eq

bll = Instance.new(&quot;StringValue&quot;)
bll.Name = &quot;Secondary&quot;
bll.Value = &quot;&quot;
bll.Parent = eq

melle = Instance.new(&quot;StringValue&quot;)
melle.Name = &quot;Melee&quot;
melle.Value = &quot;&quot;
melle.Parent = eq

spc = Instance.new(&quot;StringValue&quot;)
spc.Name = &quot;Special&quot;
spc.Value = &quot;&quot;
spc.Parent = eq



cinv = Instance.new(&quot;Model&quot;)
cinv.Name = &quot;CraftInv&quot;
cinv.Parent = mainm

for i = 1,6 do -- generating crafting slot info section
newval = Instance.new(&quot;StringValue&quot;)
newval.Name = &quot;S&quot; .. i
newval.Value = &quot;&quot;
newval.Parent = cinv
end

pval = Instance.new(&quot;ObjectValue&quot;)
pval.Name = &quot;Owner&quot;
pval.Value = player
pval.Parent = mainm

lang = Instance.new(&quot;StringValue&quot;)
lang.Name = &quot;LANGUAGE&quot;
lang.Value = &quot;English&quot;
lang.Parent = mainm

pval = Instance.new(&quot;IntValue&quot;)
pval.Name = &quot;SpecAmmo&quot;
pval.Value = 0
pval.Parent = mainm

mainm.Parent = script.Parent
print(&quot;Inventory for &quot; .. player.Name .. &quot; has been created.&quot;)
end



while true do
wait()

p = game.Players:GetChildren()

for i = 1,#p do
&#9;if p[i] ~= nil then
&#9;&#9;if script.Parent:findFirstChild(p[i].Name) == nil then
&#9;&#9;&#9;createpack(p[i])
&#9;&#9;end
&#9;end
end

m = script.Parent:GetChildren()

for i = 1,#m do
&#9;if m[i].className == &quot;Model&quot; then
&#9;&#9;if game.Players:findFirstChild(m[i].Name) == nil then
&#9;&#9;&#9;print(m[i].Name .. &quot;&apos;s Inventory removed - the player has leaved.&quot;)
&#9;&#9;&#9;m[i].Parent = nil
&#9;&#9;end
&#9;end
end

end
</ProtectedString>
				</Properties>
