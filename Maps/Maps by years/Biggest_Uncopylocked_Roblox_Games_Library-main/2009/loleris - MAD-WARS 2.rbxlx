									<ProtectedString name="Source">player = script.Parent.Parent.Parent.Parent.Parent
itemdb = game.Workspace:findFirstChild(&quot;ItemServer&quot;).ItemDB
playerpacks = game.Workspace:findFirstChild(&quot;playerpacks&quot;)

sam = script.Parent

while true do
wait()
ppack = playerpacks:findFirstChild(player.Name)
if ppack ~= nil then
SA = ppack:findFirstChild(&quot;SpecAmmo&quot;)
if SA.Value &lt;= 0 then
