					<Item class="Script" referent="RBX5937">
						<Properties>
							<bool name="Archivable">true</bool>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">BAINV</string>
							<ProtectedString name="Source">player = script.Parent.Parent.Parent.Parent
bouncy = script.Parent.BusyClick
bouncy.Value = false

playerpacks = game.Workspace:findFirstChild(&quot;playerpacks&quot;)
pack = playerpacks:findFirstChild(player.Name)

itemserver = game.Workspace:findFirstChild(&quot;ItemServer&quot;)
itemdb = itemserver:findFirstChild(&quot;ItemDB&quot;)

selected = script.Parent.Selected
selected.Value = &quot;&quot;
function onClick(btt)
if btt ~= nil then
if bouncy.Value ~= true then
bouncy.Value = true
if selected.Value ~= &quot;i&quot; .. btt.Name then
selected.Value = &quot;i&quot; .. btt.Name


num = string.sub(btt.Name,2,3)
inv = pack:findFirstChild(&quot;Inv&quot;)
slot1 = inv:findFirstChild(&quot;S&quot; .. num)
if slot1 ~= nil then
if slot1.Value ~= nil then
item = itemdb:findFirstChild(slot1.Value)
if item ~= nil then
leaderstats = player:findFirstChild(&quot;leaderstats&quot;)
if leaderstats ~= nil then
pts = leaderstats:findFirstChild(&quot;Pts&quot;)
if pts ~= nil then
shopbuy = item:findFirstChild(&quot;ShopBuy&quot;)
if shopbuy ~= nil then


script.Parent.Trade.Slot.Value = btt.Name
script.Parent.Trade.Cost.Value = shopbuy.Value
script.Parent.Trade.TradeName.Text = item:findFirstChild(&quot;ItemName2&quot;).Value
script.Parent.Trade.sell.Value = false
script.Parent.Trade.Visible = true


else
script.Parent.Trade.Visible = false
script.Parent.Trade.Slot.Value = &quot;&quot;
script.Parent.Trade.Cost.Value = 0
script.Parent.Trade.TradeName.Text = &quot;&quot;

script.Parent.Error.Text = &quot;Shop won&apos;t buy this item!&quot;
wait(3)
script.Parent.Error.Text = &quot;&quot;
selected.Value = &quot;&quot;
end
end
end
end
else
script.Parent.Trade.Visible = false
script.Parent.Trade.Slot.Value = &quot;&quot;
script.Parent.Trade.Cost.Value = 0
script.Parent.Trade.TradeName.Text = &quot;&quot;

selected.Value = &quot;&quot;
end
end

else
script.Parent.Trade.Visible = false
script.Parent.Trade.Slot.Value = &quot;&quot;
script.Parent.Trade.Cost.Value = 0
script.Parent.Trade.TradeName.Text = &quot;&quot;
selected.Value = &quot;&quot;
end
bouncy.Value = false
end
end
end
