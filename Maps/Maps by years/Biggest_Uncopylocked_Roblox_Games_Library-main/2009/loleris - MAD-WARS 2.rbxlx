				<Item class="BoolValue" referent="RBX1890">
					<Properties>
						<bool name="Archivable">true</bool>
						<string name="Name">Busy</string>
						<bool name="Value">false</bool>
					</Properties>
				</Item>
				<Item class="NumberValue" referent="RBX1891">
					<Properties>
						<bool name="Archivable">true</bool>
