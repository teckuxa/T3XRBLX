						<token name="SizeConstraint">0</token>
						<string name="Text">You have changed your equipped weapons. You will get the new weapons after you respawn.</string>
						<Color3 name="TextColor3">4279970357</Color3>
						<float name="TextTransparency">0.300000012</float>
						<bool name="TextWrap">true</bool>
