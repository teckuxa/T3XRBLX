			<Item class="Script" referent="RBX7096">
				<Properties>
					<bool name="Archivable">true</bool>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">selected color</string>
					<ProtectedString name="Source">selected = script.Parent:findFirstChild(&quot;Button action&quot;).Selected
inv = script.Parent.Main.Inventory:GetChildren()
eq = script.Parent.Main.Equipped:GetChildren()
cinv = script.Parent.Main.CraftingInv:GetChildren()

function OnChange()
wait()

for i = 1,#inv do
if inv[i].className == &quot;ImageButton&quot; then
if selected.Value == inv[i].Name then
inv[i].BorderColor3 = script.Parent.Main.cgreen.Value
else
inv[i].BorderColor3 = script.Parent.Main.cblack.Value
end
end
end 

for i = 1,#eq do
if eq[i].className == &quot;ImageButton&quot; then
if selected.Value == eq[i].Name then
eq[i].BorderColor3 = script.Parent.Main.cgreen.Value
else
eq[i].BorderColor3 = script.Parent.Main.cblack.Value
end
end
end 

for i = 1,#cinv do
if cinv[i].className == &quot;ImageButton&quot; then
if selected.Value == cinv[i].Name then
cinv[i].BorderColor3 = script.Parent.Main.cgreen.Value
else
cinv[i].BorderColor3 = script.Parent.Main.cblack.Value
end
end
end 

end 

selected.Changed:connect(OnChange)</ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX7097">
				<Properties>
					<bool name="Archivable">true</bool>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Button action</string>
					<ProtectedString name="Source">selected = script.Selected


player = script.Parent.Parent.Parent.Parent

playerpacks = game.Workspace:findFirstChild(&quot;playerpacks&quot;)
pack = playerpacks:findFirstChild(player.Name)


itemserver = game.Workspace:findFirstChild(&quot;ItemServer&quot;)
itemdb = itemserver:findFirstChild(&quot;ItemDB&quot;)
itemcraft = itemserver:findFirstChild(&quot;ItemCraft&quot;)


function onClick(btt)
checkbtt = string.sub(btt.Name,1,1)
if checkbtt ~= &quot;C&quot; and selected.Value == &quot;&quot; or  selected.Value ~= &quot;&quot; or btt.Name == &quot;CraftIt&quot; then
if btt.Name ~= &quot;CraftIt&quot; then
&#9;if selected.Value == &quot;&quot; then
&#9;&#9;if btt.Name ~= &quot;Discard&quot; then
&#9;&#9;&#9;selected.Value = btt.Name
&#9;&#9;end
&#9;else
&#9;&#9;if btt.Name ~= &quot;Discard&quot; and selected.Value ~= &quot;Discard&quot; then
&#9;&#9;btt1class = &quot;&quot;
&#9;&#9;btt2class = &quot;&quot;
&#9;&#9;btt1num = &quot;&quot;
&#9;&#9;btt2num = &quot;&quot;
&#9;&#9;btt1 = selected.Value
&#9;&#9;selected.Value = &quot;&quot;
&#9;&#9;btt2 = btt.Name
&#9;&#9;print(&quot;We got a combination: &quot; .. btt1 .. &quot; and &quot; .. btt2 .. &quot;.&quot;)
&#9;&#9;bttc1 = string.sub(btt1,1,1)
&#9;&#9;bttc2 = string.sub(btt2,1,1)
&#9;&#9;bttn1 = string.sub(btt1,2,3)
&#9;&#9;bttn2 = string.sub(btt2,2,3)

&#9;&#9;btt1num = bttn1
&#9;&#9;btt2num = bttn2


&#9;&#9;if bttc1 == &quot;C&quot; then
&#9;&#9;btt1class = &quot;CraftInv&quot;
&#9;&#9;elseif bttc1 == &quot;E&quot; then&#9;&#9;
&#9;&#9;btt1class = &quot;Equipped&quot;
&#9;&#9;elseif bttc1 == &quot;I&quot; then&#9;
&#9;&#9;btt1class = &quot;Inv&quot;
&#9;&#9;end

&#9;&#9;if bttc2 == &quot;C&quot; then
&#9;&#9;btt2class = &quot;CraftInv&quot;
&#9;&#9;elseif bttc2 == &quot;E&quot; then&#9;&#9;
&#9;&#9;btt2class = &quot;Equipped&quot;
&#9;&#9;elseif bttc2 == &quot;I&quot; then&#9;
&#9;&#9;btt2class = &quot;Inv&quot;
&#9;&#9;end

&#9;&#9;print(&quot;1properties-    &quot; .. btt1class .. &quot;,   &quot; .. btt1num .. &quot;   .&quot; .. &quot;              2properties-   &quot; .. btt2class .. &quot;,   &quot; .. btt2num .. &quot;   .&quot;)
&#9;&#9;if btt1class == &quot;Equipped&quot; and  btt2class == &quot;CraftInv&quot; or  btt1class == &quot;CraftInv&quot; and  btt2class == &quot;Equipped&quot; then
&#9;&#9;print(&quot;No action for this combination.&quot;)
&#9;&#9;elseif btt1class == &quot;Inv&quot; and  btt2class == &quot;Equipped&quot; then
&#9;&#9;print(&quot;Equipped slot---Inventory slot.&quot;)
&#9;&#9;invslots = pack:findFirstChild(&quot;Inv&quot;)
&#9;&#9;invslot1 = invslots:findFirstChild(&quot;S&quot; .. btt1num)
&#9;&#9;if invslot1.Value ~= &quot;&quot; then
&#9;&#9;eqslots = pack:findFirstChild(&quot;Equipped&quot;)

&#9;&#9;if btt2num == &quot;1&quot; then
&#9;&#9;eqslot1 = eqslots:findFirstChild(&quot;Primary&quot;)
&#9;&#9;elseif btt2num == &quot;2&quot; then
&#9;&#9;eqslot1 = eqslots:findFirstChild(&quot;Secondary&quot;)
&#9;&#9;elseif btt2num == &quot;3&quot; then
&#9;&#9;eqslot1 = eqslots:findFirstChild(&quot;Melee&quot;)
&#9;&#9;elseif btt2num == &quot;4&quot; then
&#9;&#9;eqslot1 = eqslots:findFirstChild(&quot;Special&quot;)
&#9;&#9;end

&#9;&#9;theitem = itemdb:findFirstChild(invslot1.Value)
&#9;&#9;if theitem:findFirstChild(&quot;WepSlot&quot;) ~= nil then -- E1 = Primary; E2 = Secondary; E3 = Melee; E3 = Special.
&#9;&#9;if theitem:findFirstChild(&quot;WepSlot&quot;).Value == eqslot1.Name then
&#9;&#9;eqslot1m = &quot;&quot;
&#9;&#9;eqslot1m = eqslot1.Value
&#9;&#9;eqslot1.Value = invslot1.Value
&#9;&#9;invslot1.Value = eqslot1m
&#9;&#9;else
&#9;&#9;print(&quot;Wrong weapon type&quot;)
&#9;&#9;end
&#9;&#9;else
&#9;&#9;print(&quot;This Item isn&apos;t equippable.&quot;)
&#9;&#9;end
&#9;&#9;else
&#9;&#9;eqslots = pack:findFirstChild(&quot;Equipped&quot;)

&#9;&#9;if btt2num == &quot;1&quot; then
&#9;&#9;eqslot1 = eqslots:findFirstChild(&quot;Primary&quot;)
&#9;&#9;elseif btt2num == &quot;2&quot; then
&#9;&#9;eqslot1 = eqslots:findFirstChild(&quot;Secondary&quot;)
&#9;&#9;elseif btt2num == &quot;3&quot; then
&#9;&#9;eqslot1 = eqslots:findFirstChild(&quot;Melee&quot;)
&#9;&#9;elseif btt2num == &quot;4&quot; then
&#9;&#9;eqslot1 = eqslots:findFirstChild(&quot;Special&quot;)
&#9;&#9;end
&#9;&#9;if eqslot1.Value ~= &quot;&quot; then

&#9;&#9;invslot1.Value = eqslot1.Value
&#9;&#9;eqslot1.Value = &quot;&quot;

&#9;&#9;end
&#9;&#9;end
&#9;&#9;selected.Value = &quot;&quot;
&#9;&#9;elseif btt1class == &quot;Equipped&quot; and  btt2class == &quot;Inv&quot; then
&#9;&#9;print(&quot;Equipped slot---Inventory slot.&quot;)
&#9;&#9;invslots = pack:findFirstChild(&quot;Inv&quot;)
&#9;&#9;invslot1 = invslots:findFirstChild(&quot;S&quot; .. btt2num)
&#9;&#9;if invslot1.Value ~= &quot;&quot; then
&#9;&#9;eqslots = pack:findFirstChild(&quot;Equipped&quot;)

&#9;&#9;if btt1num == &quot;1&quot; then
&#9;&#9;eqslot1 = eqslots:findFirstChild(&quot;Primary&quot;)
&#9;&#9;elseif btt1num == &quot;2&quot; then
&#9;&#9;eqslot1 = eqslots:findFirstChild(&quot;Secondary&quot;)
&#9;&#9;elseif btt1num == &quot;3&quot; then
&#9;&#9;eqslot1 = eqslots:findFirstChild(&quot;Melee&quot;)
&#9;&#9;elseif btt1num == &quot;4&quot; then
&#9;&#9;eqslot1 = eqslots:findFirstChild(&quot;Special&quot;)
&#9;&#9;end

&#9;&#9;theitem = itemdb:findFirstChild(invslot1.Value)
&#9;&#9;if theitem:findFirstChild(&quot;WepSlot&quot;) ~= nil then -- E1 = Primary; E2 = Secondary; E3 = Melee; E3 = Special.
&#9;&#9;if theitem:findFirstChild(&quot;WepSlot&quot;).Value == eqslot1.Name then
&#9;&#9;eqslot1m = &quot;&quot;
&#9;&#9;eqslot1m = eqslot1.Value
&#9;&#9;eqslot1.Value = invslot1.Value
&#9;&#9;invslot1.Value = eqslot1m
&#9;&#9;else
&#9;&#9;print(&quot;Wrong weapon type&quot;)
&#9;&#9;end
&#9;&#9;else
&#9;&#9;print(&quot;This Item isn&apos;t equippable.&quot;)
&#9;&#9;end
&#9;&#9;else
&#9;&#9;eqslots = pack:findFirstChild(&quot;Equipped&quot;)

&#9;&#9;if btt1num == &quot;1&quot; then
&#9;&#9;eqslot1 = eqslots:findFirstChild(&quot;Primary&quot;)
&#9;&#9;elseif btt1num == &quot;2&quot; then
&#9;&#9;eqslot1 = eqslots:findFirstChild(&quot;Secondary&quot;)
&#9;&#9;elseif btt1num == &quot;3&quot; then
&#9;&#9;eqslot1 = eqslots:findFirstChild(&quot;Melee&quot;)
&#9;&#9;elseif btt1num == &quot;4&quot; then
&#9;&#9;eqslot1 = eqslots:findFirstChild(&quot;Special&quot;)
&#9;&#9;end
&#9;&#9;if eqslot1.Value ~= &quot;&quot; then

&#9;&#9;invslot1.Value = eqslot1.Value
&#9;&#9;eqslot1.Value = &quot;&quot;

&#9;&#9;end
&#9;&#9;end
&#9;&#9;selected.Value = &quot;&quot;
&#9;&#9;elseif btt1class == &quot;Inv&quot; and  btt2class == &quot;CraftInv&quot; then
&#9;&#9;print(&quot;Crafting slot---Inventory slot.&quot;)
&#9;&#9;craftslots = pack:findFirstChild(&quot;CraftInv&quot;)
&#9;&#9;craftslot1 = craftslots:findFirstChild(&quot;S&quot; .. btt2num)
&#9;&#9;invslots = pack:findFirstChild(&quot;Inv&quot;)
&#9;&#9;invslot1 = invslots:findFirstChild(&quot;S&quot; .. btt1num)
&#9;&#9;if invslot1.Value ~= &quot;&quot; then
&#9;&#9;craftslot1.Value = invslot1.Name
&#9;&#9;end
&#9;&#9;selected.Value = &quot;&quot;
&#9;&#9;elseif btt1class == &quot;Inv&quot; and  btt2class == &quot;Inv&quot; then
&#9;&#9;print(&quot;Inventory slot---Inventory slot.&quot;)
&#9;&#9;invslot1m = &quot;&quot;
&#9;&#9;invslots = pack:findFirstChild(&quot;Inv&quot;)
&#9;&#9;invslot1 = invslots:findFirstChild(&quot;S&quot; .. btt1num)
&#9;&#9;invslot2 = invslots:findFirstChild(&quot;S&quot; .. btt2num)
&#9;&#9;invslot1m = invslot1.Value
&#9;&#9;invslot1.Value = invslot2.Value 
&#9;&#9;invslot2.Value = invslot1m
&#9;&#9;craftslots = pack:findFirstChild(&quot;CraftInv&quot;)
&#9;&#9;c = craftslots:GetChildren()
&#9;&#9;for i = 1,#c do
&#9;&#9;if c[i].Value == invslot1.Name or  c[i].Value == invslot2.Name then
&#9;&#9;c[i].Value = &quot;&quot;
&#9;&#9;end
&#9;&#9;end
&#9;&#9;print(&quot;END.&quot;)
&#9;&#9;selected.Value = &quot;&quot;
&#9;&#9;end
&#9;&#9;else -- Discarding
&#9;&#9;if selected.Value ~= &quot;&quot; then
&#9;&#9;btt1class = &quot;&quot;
&#9;&#9;btt1num = &quot;&quot;
&#9;&#9;btt1class = string.sub(selected.Value,1,1)
&#9;&#9;btt1num = string.sub(selected.Value,2,3)
&#9;&#9;selected.Value = &quot;&quot;
&#9;&#9;if btt1class == &quot;I&quot; then
&#9;&#9;invslots = pack:findFirstChild(&quot;Inv&quot;)
&#9;&#9;invslot1 = invslots:findFirstChild(&quot;S&quot; .. btt1num)
&#9;&#9;if invslot1.Value ~= &quot;&quot; then
&#9;&#9;print(&quot;Item &quot; .. invslot1.Value .. &quot; deleted&quot;)
&#9;&#9;invslot1.Value = &quot;&quot;
&#9;&#9;craftslots = pack:findFirstChild(&quot;CraftInv&quot;)
&#9;&#9;c = craftslots:GetChildren()
&#9;&#9;for i = 1,#c do
&#9;&#9;if c[i].Value == invslot1.Name then
&#9;&#9;c[i].Value = &quot;&quot;
&#9;&#9;end
&#9;&#9;end
&#9;&#9;else
&#9;&#9;print(&quot;This slot was already empty&quot;)
&#9;&#9;end
&#9;&#9;else
&#9;&#9;print(&quot;Discard works on inventory slots only.&quot;)
&#9;&#9;end
&#9;&#9;end
&#9;&#9;end
&#9;end
else -- Crafting
craftslots = pack:findFirstChild(&quot;CraftInv&quot;)
invslots = pack:findFirstChild(&quot;Inv&quot;)

failed = true
itemnum = 0
c = craftslots:GetChildren()
for i = 1,#c do
if c[i].Value ~= &quot;&quot; then
itemnum = itemnum + 1
end
end

if itemnum &gt;= 2 then

cr = itemcraft:GetChildren()
for i = 1,#cr do
cn = cr[i]:findFirstChild(&quot;Items&quot;):GetChildren()
itemnum2 = 0
for w = 1,#cn do
itemnum2 = itemnum2 + 1
end
&#9;if itemnum2 == itemnum then
&#9;&#9;if craftslots:findFirstChild(&quot;S1&quot;).Value ~= &quot;&quot; then
&#9;&#9;slot1 = invslots:findFirstChild(craftslots:findFirstChild(&quot;S1&quot;).Value).Value
&#9;&#9;else
&#9;&#9;slot1 = &quot;&quot;
&#9;&#9;end
&#9;&#9;if craftslots:findFirstChild(&quot;S2&quot;).Value ~= &quot;&quot; then
&#9;&#9;slot2 = invslots:findFirstChild(craftslots:findFirstChild(&quot;S2&quot;).Value).Value
&#9;&#9;else
