function refresh(couse,fault)
txt = couse .. &quot; (&quot; .. fault .. &quot;)&quot;
print(txt)
s1 = script.Parent:findFirstChild(&quot;history&quot;).s1
s2 = script.Parent:findFirstChild(&quot;history&quot;).s2
