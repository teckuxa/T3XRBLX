							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">moover</string>
							<ProtectedString name="Source">function move()
&#9;if script.Parent.open.Value == true then
&#9;&#9;for i = 1,90 do
&#9;&#9;&#9;script.Parent.CFrame = CFrame.new(script.Parent.Position - Vector3.new(0,0,0.1))
&#9;&#9;&#9;wait(0.01)
&#9;&#9;end
&#9;else
&#9;&#9;for i = 1,90 do
&#9;&#9;&#9;script.Parent.CFrame = CFrame.new(script.Parent.Position + Vector3.new(0,0,0.1))
&#9;&#9;&#9;wait(0.01)
&#9;&#9;end
&#9;end
end


script.Parent.open.Changed:connect(function()
move()
end)

</ProtectedString>
