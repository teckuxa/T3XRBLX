&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;if special2.Image ~= &quot;http://www.roblox.com/asset/?id=23831244&quot; then
&#9;&#9;&#9;&#9;special2.Image = &quot;http://www.roblox.com/asset/?id=23831244&quot;
&#9;&#9;&#9;&#9;special2.BackgroundColor3 = script.Parent.Parent.clgrey.Value
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;end
end 



end 

