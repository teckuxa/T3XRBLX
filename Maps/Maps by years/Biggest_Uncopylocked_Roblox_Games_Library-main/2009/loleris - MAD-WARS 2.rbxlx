					<Item class="Script" referent="RBX6838">
						<Properties>
							<bool name="Archivable">true</bool>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">colors</string>
							<ProtectedString name="Source">while true do
wait(0.3)
script.Parent.BackgroundColor3 = script.Parent.green.Value
wait(0.3)
script.Parent.BackgroundColor3 = script.Parent.yellow.Value
end </ProtectedString>
						</Properties>
					</Item>
					<Item class="Script" referent="RBX6839">
						<Properties>
							<bool name="Archivable">true</bool>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">player = script.Parent.Parent.Parent.Parent.Parent.Parent
function tutorial(btt)
if player.Character.Humanoid.Health ~= 0 then
player.Character.Parent = game.Lighting
gm = game.Lighting.LanguagePacks.Sweden:findFirstChild(&quot;GuideMenu&quot;):clone()
gm.Parent = player.PlayerGui

if player.PlayerGui:findFirstChild(&quot;Menu&quot;) ~= nil then
player.PlayerGui:findFirstChild(&quot;Menu&quot;).Parent = nil
end

end
end

function off(btt)
val = Instance.new(&quot;ObjectValue&quot;)
val.Name = &quot;TDONE&quot;
val.Parent = player
end

script.Parent.MouseButton1Up:connect(function ()
tutorial()
end)

script.Parent.Exit.MouseButton1Up:connect(function ()
off()
end)
</ProtectedString>
