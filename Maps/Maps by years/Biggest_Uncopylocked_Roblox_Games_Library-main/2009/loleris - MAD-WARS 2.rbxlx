						<Item class="Script" referent="RBX6280">
							<Properties>
								<bool name="Archivable">true</bool>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">open blueprints</string>
								<ProtectedString name="Source">on = script.on
function onClick(btt)
if on.Value == false then
on.Value = true

bp = game.Lighting.LanguagePacks.Sweden:findFirstChild(&quot;Blueprints&quot;):clone()
bp.Parent = script.Parent
script.Parent.blueprints.Text = &quot;STANG&quot;

else
on.Value = false

bp = script.Parent:findFirstChild(&quot;Blueprints&quot;)
if bp ~= nil then
bp.Parent = nil
end
script.Parent.blueprints.Text = &quot;Blakopia&quot;

end
end

script.Parent.blueprints.MouseButton1Up:connect(function ()
onClick(script.Parent.inv)
end)
</ProtectedString>
							</Properties>
							<Item class="BoolValue" referent="RBX6281">
								<Properties>
									<bool name="Archivable">true</bool>
									<string name="Name">on</string>
									<bool name="Value">false</bool>
								</Properties>
							</Item>
						</Item>
						<Item class="Script" referent="RBX6282">
							<Properties>
								<bool name="Archivable">true</bool>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">open windows</string>
								<ProtectedString name="Source">mode = script.Parent.mode
function onClick(btt)
if mode.Value ~= &quot;busy&quot; then
if btt.Name == &quot;inv&quot; and mode.Value == &quot;inv&quot; and script.CloseInventory.Value == true then
script.CloseInventory.Value = false

mode.Value = &quot;busy&quot;
inv = script.Parent.Parent:findFirstChild(&quot;GInventory&quot;)
if inv ~= nil then
for i = 1, 75 do
inv.Position = inv.Position-UDim2.new(0,8,x,0,0,y)
wait(0.0000000000001)
end 
wait(0.5)
inv.Parent = nil
end
btt.Text = &quot;Ryggsack&quot;
mode.Value = &quot;free&quot;

elseif btt.Name == &quot;inv&quot; and mode.Value == &quot;shop&quot; and script.ShopInventory.Value == true then
script.ShopInventory.Value = false

mode.Value = &quot;busy&quot;

shop = script.Parent.Parent:findFirstChild(&quot;GShop&quot;)
if shop ~= nil then
for i = 1, 76 do
shop.Position = shop.Position-UDim2.new(0,8,x,0,0,y)
wait(0.0000000000001)
end 
wait(0.5)
shop.Parent = nil
end
script.Parent.shop.Text = &quot;Affar&quot;

inv = game.Lighting.LanguagePacks.Sweden:findFirstChild(&quot;GInventory&quot;):clone()
inv.Parent = script.Parent.Parent
wait(0.5)

for i = 1, 75 do
inv.Position = inv.Position+UDim2.new(0,8,x,0,0,y)
wait(0.0000000000001)
end 

btt.Text = &quot;STANG&quot;

mode.Value = &quot;inv&quot;



elseif btt.Name == &quot;shop&quot; and mode.Value == &quot;shop&quot; and script.CloseShop.Value == true then
script.CloseShop.Value = false

mode.Value = &quot;busy&quot;

mode.Value = &quot;busy&quot;
shop = script.Parent.Parent:findFirstChild(&quot;GShop&quot;)
if shop ~= nil then
for i = 1, 76 do
shop.Position = shop.Position-UDim2.new(0,8,x,0,0,y)
wait(0.0000000000001)
end 
wait(0.5)
shop.Parent = nil
end
btt.Text = &quot;Affar&quot;
mode.Value = &quot;free&quot;

elseif btt.Name == &quot;shop&quot; and mode.Value == &quot;inv&quot; and script.InventoryShop.Value == true then
script.InventoryShop.Value = false

mode.Value = &quot;busy&quot;
inv = script.Parent.Parent:findFirstChild(&quot;GInventory&quot;)
if inv ~= nil then
for i = 1, 75 do
inv.Position = inv.Position-UDim2.new(0,8,x,0,0,y)
wait(0.0000000000001)
end 
wait(0.5)
inv.Parent = nil
end
script.Parent.inv.Text = &quot;Ryggsack&quot;

shop = game.Lighting:findFirstChild(&quot;GShop&quot;):clone()
shop.Parent = script.Parent.Parent
wait(0.5)

for i = 1, 76 do
shop.Position = shop.Position+UDim2.new(0,8,x,0,0,y)
wait(0.0000000000001)
end 

btt.Text = &quot;STANG&quot;

mode.Value = &quot;shop&quot;



elseif btt.Name == &quot;shop&quot; and mode.Value == &quot;free&quot; and script.Shop.Value == true then
script.Shop.Value = false

mode.Value = &quot;busy&quot;

shop = game.Lighting:findFirstChild(&quot;GShop&quot;):clone()
shop.Parent = script.Parent.Parent
wait(0.5)

for i = 1, 76 do
shop.Position = shop.Position+UDim2.new(0,8,x,0,0,y)
wait(0.0000000000001)
end 

btt.Text = &quot;STANG&quot;
mode.Value = &quot;shop&quot;



elseif btt.Name == &quot;inv&quot; and mode.Value == &quot;free&quot; and script.Inventory.Value == true then
script.Inventory.Value = false

mode.Value = &quot;busy&quot;

inv = game.Lighting.LanguagePacks.Sweden:findFirstChild(&quot;GInventory&quot;):clone()
inv.Parent = script.Parent.Parent
wait(0.5)

for i = 1, 75 do
inv.Position = inv.Position+UDim2.new(0,8,x,0,0,y)
wait(0.0000000000001)
end 

btt.Text = &quot;STANG&quot;
mode.Value = &quot;inv&quot;

end
end
end

script.Parent.inv.MouseButton1Up:connect(function ()
onClick(script.Parent.inv)
end)

script.Parent.shop.MouseButton1Up:connect(function ()
onClick(script.Parent.shop)
end)</ProtectedString>
