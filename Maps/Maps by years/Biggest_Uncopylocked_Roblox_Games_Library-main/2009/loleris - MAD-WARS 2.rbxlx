								<bool name="Archivable">true</bool>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Pending recieving</string>
								<ProtectedString name="Source">player = script.Parent.Parent.Parent.Parent
itemdb = game.Workspace:findFirstChild(&quot;ItemServer&quot;).ItemDB
playerpacks = game.Workspace:findFirstChild(&quot;playerpacks&quot;)

rec = script.Parent.Recieving

while true do
wait()
ppack = playerpacks:findFirstChild(player.Name)
if ppack ~= nil then
pend = ppack:findFirstChild(&quot;Pending&quot;)
pendch = pend:GetChildren()
if #pendch ~= 0 then
item = pendch[1]
if item ~= nil then
lang = ppack:findFirstChild(&quot;LANGUAGE&quot;)
lpack = game.Lighting.LanguagePacks:findFirstChild(lang.Value)
if lpack ~= nil then
dbitem = lpack.ItemDB:findFirstChild(item.Name)
else
dbitem = itemdb:findFirstChild(item.Name)
end
if dbitem ~= nil then
item.Parent = nil
iname = dbitem:findFirstChild(&quot;ItemName2&quot;)
ilvl = dbitem:findFirstChild(&quot;ItemLevel&quot;)
iwslot = dbitem:findFirstChild(&quot;WepSlot&quot;)
iclass = dbitem:findFirstChild(&quot;ItemName&quot;)
if iwslot ~= nil then
line1 = iname.Value
line2 = &quot;lvl &quot; .. ilvl.Value .. &quot; &quot; .. iwslot.Value .. &quot; &quot; .. iclass.Value .. &quot;.&quot;
line3 = &quot;&quot;
else
line1 = iname.Value
line2 = &quot;lvl &quot; .. ilvl.Value .. &quot; &quot; .. iclass.Value .. &quot;.&quot;
line3 = &quot;&quot;
end
inventory = ppack:findFirstChild(&quot;Inv&quot;)

freespace = 0
v = inventory:GetChildren()
for i = 1,#v do
if v[i].Value == &quot;&quot; then
freespace = freespace + 1
end
end

if freespace ~= 0 then
lang = ppack:findFirstChild(&quot;LANGUAGE&quot;)
lpack = game.Lighting.LanguagePacks:findFirstChild(lang.Value)
if lpack ~= nil then
line3 = lpack.Words:findFirstChild(&quot;itemstored&quot;).Value
else
line3 = &quot;The item was stored in your inventory.&quot;
end

gotit = false
for i = 1,#v do
if gotit == false then
&#9;if v[i].Value == &quot;&quot; then
&#9;&#9;gotit = true
&#9;&#9;v[i].Value = dbitem.Name
&#9;end
end
end

else
lang = ppack:findFirstChild(&quot;LANGUAGE&quot;)
lpack = game.Lighting.LanguagePacks:findFirstChild(lang.Value)
if lpack ~= nil then
line3 = lpack.Words:findFirstChild(&quot;itemnotstored&quot;).Value
else
line3 = &quot;Your inventory is full.&quot;
end
end



rec.recievename.Text = line1
rec.recieveclass.Text = line2
rec.recieveinfo.Text = line3
rec.Visible = true

wait(6)

rec.recievename.Text = &quot;&quot;
rec.recieveclass.Text = &quot;&quot;
rec.recieveinfo.Text = &quot;&quot;
rec.Visible = false

else
-- special item drops
if item.Name == &quot;SpecAmmo&quot; then
AC = ppack:findFirstChild(&quot;SpecAmmo&quot;)
AC.Value = AC.Value + item.Value
item.Parent = nil

line1 = &quot;Special Ammo&quot;

lang = ppack:findFirstChild(&quot;LANGUAGE&quot;)
lpack = game.Lighting.LanguagePacks:findFirstChild(lang.Value)
if lpack ~= nil then
line2 = lpack.Words:findFirstChild(&quot;forpowerfullweapons&quot;).Value
else
line2 = &quot;For powerfull weapons.&quot;
end
line3 = &quot;&quot;

rec.recievename.Text = line1
rec.recieveclass.Text = line2
rec.recieveinfo.Text = line3
rec.Visible = true

wait(6)

rec.recievename.Text = &quot;&quot;
rec.recieveclass.Text = &quot;&quot;
rec.recieveinfo.Text = &quot;&quot;
rec.Visible = false

else
item.Parent = nil
end

end
end
end
end
end </ProtectedString>
							</Properties>
