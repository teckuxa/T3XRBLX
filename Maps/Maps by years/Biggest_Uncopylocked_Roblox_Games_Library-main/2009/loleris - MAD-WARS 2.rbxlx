						<Item class="Script" referent="RBX7339">
							<Properties>
								<bool name="Archivable">true</bool>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Regen</string>
								<ProtectedString name="Source">enabled = true

function onHit()
if enabled == true then
enabled = false
wait(1)
script.Parent.Parent:findFirstChild(&quot;lifter&quot;).Plate.BodyVelocity.maxForce = Vector3.new(100000,100000,100000)
script.Parent.Parent:findFirstChild(&quot;lifter&quot;).Plate.BodyVelocity.velocity = Vector3.new(0,10,0)
script.Parent.BrickColor = BrickColor.new(21)
script.Parent.use:play()
wait(15)
script.Parent.Parent:findFirstChild(&quot;lifter&quot;).Plate.BodyVelocity.maxForce = Vector3.new(100000,0,100000)
script.Parent.Parent:findFirstChild(&quot;lifter&quot;).Plate.BodyVelocity.velocity = Vector3.new(0,0,0)
wait(3)
script.Parent.use:play()
script.Parent.BrickColor = BrickColor.new(28)
enabled = true
end
end

script.Parent.Touched:connect(function()
onHit()
end)</ProtectedString>
							</Properties>
