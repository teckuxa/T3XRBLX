							<ProtectedString name="Source">script.Parent.Sound:play()
wait(1)
for i = 1,160 do
wait(0.05)
script.Parent.Transparency = script.Parent.Transparency + 0.005
script.Parent.Mesh.Scale = script.Parent.Mesh.Scale - Vector3.new(0.2,0.1,0.2)
end 
script.Parent.Parent = nil </ProtectedString>
