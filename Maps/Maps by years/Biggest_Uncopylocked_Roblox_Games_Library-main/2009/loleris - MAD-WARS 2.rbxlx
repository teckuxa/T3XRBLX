&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;if melle2.Image ~= &quot;http://www.roblox.com/asset/?id=34525870&quot; then
&#9;&#9;&#9;&#9;melle2.Image = &quot;http://www.roblox.com/asset/?id=34525870&quot;
&#9;&#9;&#9;&#9;melle2.BackgroundColor3 = script.Parent.Parent.clgrey.Value
