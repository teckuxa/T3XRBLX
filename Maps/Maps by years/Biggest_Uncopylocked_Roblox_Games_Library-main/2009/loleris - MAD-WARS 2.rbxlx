						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">eqchange</string>
						<ProtectedString name="Source">while true do
wait()
bp = script.Parent.Parent.Parent.Parent:findFirstChild(&quot;Backpack&quot;)
pp = game.Workspace.playerpacks:findFirstChild(script.Parent.Parent.Parent.Parent.Name)

if bp ~= nil and pp ~= nil then
equipped = pp:findFirstChild(&quot;Equipped&quot;)
w1 = equipped:findFirstChild(&quot;Primary&quot;)
w2 = equipped:findFirstChild(&quot;Secondary&quot;)
w3 = equipped:findFirstChild(&quot;Melee&quot;)
w4 = equipped:findFirstChild(&quot;Special&quot;)
inf = w1.Value .. w2.Value .. w3.Value .. w4.Value .. &quot;&quot;
enow = bp:findFirstChild(&quot;enow&quot;)
if enow ~= nil then
if enow.Value == inf then
script.Parent.Hint.Visible = false
else
script.Parent.Hint.Visible = true
end
end
end 

end
