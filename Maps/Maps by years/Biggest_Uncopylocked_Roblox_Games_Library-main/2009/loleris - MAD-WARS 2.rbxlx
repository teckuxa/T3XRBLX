				<Item class="Script" referent="RBX8738">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">open blueprints</string>
						<ProtectedString name="Source">maxpg = script.Parent.Parent.MaxPg.Value



function onClick()
pg = script.Parent.Parent.Pg.Value
if pg == maxpg then
script.Parent.Parent.Pg.Value = 1
script.Parent.Text = &quot;To Page 2&quot;
f = script.Parent.Parent:GetChildren()
for i = 1,#f do
if f[i].className == &quot;Frame&quot; then
f[i].Visible = false
end
end
script.Parent.Parent:findFirstChild(&quot;p1&quot;).Visible = true
else
script.Parent.Parent.Pg.Value = pg+1
script.Parent.Text = &quot;To Page &quot; .. script.Parent.Parent.Pg.Value+1
f = script.Parent.Parent:GetChildren()
for i = 1,#f do
if f[i].className == &quot;Frame&quot; then
f[i].Visible = false
end
end
script.Parent.Parent:findFirstChild(&quot;p&quot; .. script.Parent.Parent.Pg.Value).Visible = true
if script.Parent.Parent.Pg.Value == maxpg then
script.Parent.Text = &quot;To Page 1&quot;
end

end
end

script.Parent.MouseButton1Up:connect(function ()
onClick()
end)
</ProtectedString>
					</Properties>
				</Item>
			</Item>
		</Item>
