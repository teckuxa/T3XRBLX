					<ProtectedString name="Source">function createpack(player)
mainm = Instance.new(&quot;Model&quot;)
mainm.Name = player.Name

pkills = Instance.new(&quot;Model&quot;)
pkills.Name = &quot;pkills&quot;
pkills.Parent = mainm

deaths = Instance.new(&quot;Model&quot;)
deaths.Name = &quot;deaths&quot;
deaths.Parent = mainm

dom = Instance.new(&quot;Model&quot;)
dom.Name = &quot;dom&quot;
dom.Parent = mainm

domh = Instance.new(&quot;IntValue&quot;)
domh.Name = &quot;domh&quot;
domh.Parent = mainm

kwd = Instance.new(&quot;IntValue&quot;)
kwd.Name = &quot;kwd&quot;
kwd.Parent = mainm

kwdh = Instance.new(&quot;IntValue&quot;)
kwdh.Name = &quot;kwdh&quot;
kwdh.Parent = mainm

idom = Instance.new(&quot;BoolValue&quot;)
idom.Name = &quot;idom&quot;
idom.Parent = mainm

inewdom = Instance.new(&quot;BoolValue&quot;)
inewdom.Name = &quot;inewdom&quot;
inewdom.Parent = mainm

irevenge = Instance.new(&quot;BoolValue&quot;)
irevenge.Name = &quot;irevenge&quot;
irevenge.Parent = mainm



mainm.Parent = script.Parent
print(&quot;Info model for &quot; .. player.Name .. &quot; has been created.&quot;)
end



while true do
wait()

p = game.Players:GetChildren()

for i = 1,#p do
&#9;if p[i] ~= nil then
&#9;&#9;if script.Parent:findFirstChild(p[i].Name) == nil then
&#9;&#9;&#9;createpack(p[i])
&#9;&#9;end
&#9;end
end

m = script.Parent:GetChildren()

for i = 1,#m do
&#9;if m[i].className == &quot;Model&quot; then
&#9;&#9;if game.Players:findFirstChild(m[i].Name) == nil then
&#9;&#9;&#9;print(m[i].Name .. &quot;&apos;s info model removed - the player has leaved.&quot;)
&#9;&#9;&#9;m[i].Parent = nil
&#9;&#9;end
&#9;end
end

end
