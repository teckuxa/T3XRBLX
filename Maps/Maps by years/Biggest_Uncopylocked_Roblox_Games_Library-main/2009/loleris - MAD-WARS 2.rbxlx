						<Item class="Script" referent="RBX5324">
							<Properties>
								<bool name="Archivable">true</bool>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">healing</string>
								<ProtectedString name="Source">healrate = 0.5 -- per 0.1 seconds
function heal(hum)
if hum.Health ~= hum.MaxHealth and hum:findFirstChild(&quot;healing&quot;) == nil then
script.Parent.Use:play()
thing = Instance.new(&quot;ObjectValue&quot;)
thing.Name = &quot;healing&quot;
thing.Parent = hum
script.Parent.used.Value = true
script.Parent.BrickColor = BrickColor.new(194)

dam = hum.MaxHealth - hum.Health
times = math.floor(dam / healrate + 6)

for i = 1,times do
wait(0.1)
if p ~= nil then
hum.Health = hum.Health + healrate
end
end

thing.Parent = nil
script.Parent.BrickColor = BrickColor.new(119)
script.Parent.used.Value = false
script.Parent.Ready:play()
end
end

while true do
wait()
p = game.Players:GetChildren()
for i = 1,#p do
char = p[i].Character
if char ~= nil then
if char:findFirstChild(&quot;Humanoid&quot;) ~= nil and  char:findFirstChild(&quot;Torso&quot;) ~= nil then
count = (script.Parent.Position - char:findFirstChild(&quot;Torso&quot;).Position).magnitude
if count &lt;= 6 then


heal(char:findFirstChild(&quot;Humanoid&quot;))


end
end
end
end
end

script.Parent.Touched:connect(onTouched)</ProtectedString>
