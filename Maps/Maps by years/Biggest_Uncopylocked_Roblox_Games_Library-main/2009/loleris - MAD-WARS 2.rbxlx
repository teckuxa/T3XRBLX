							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">fire = Instance.new(&quot;Fire&quot;)

while true do
wait()
if script.Parent.on.Value == true then
script.Parent.Fire.Enabled = true


p = game.Players:GetChildren()

for i = 1,#p do
if p[i].Character ~= nil then
if p[i].Character:findFirstChild(&quot;Torso&quot;) ~= nil and p[i].Character:findFirstChild(&quot;Humanoid&quot;) ~= nil then
if (script.Parent.Position - p[i].Character:findFirstChild(&quot;Torso&quot;).Position).magnitude &lt;= 8 then

if p[i].Character:findFirstChild(&quot;Humanoid&quot;).Health ~= 0 then
p[i].Character:findFirstChild(&quot;Humanoid&quot;).Health = 0 
script.Parent.Sound:play()
p[i].Character:BreakJoints()
pp = p[i].Character:GetChildren()
for e = 1,#pp do

if pp[e].className == &quot;Part&quot; then
fire:clone().Parent = pp[e]
pp[e].Velocity = Vector3.new(math.random(-80,80),math.random(-80,80),math.random(-80,80))
end

if pp[e].className == &quot;Hat&quot; then
if pp[e]:findFirstChild(&quot;Handle&quot;) ~= nil then
fire:clone().Parent = pp[e].Handle
pp[e].Handle.Velocity = Vector3.new(math.random(-80,80),math.random(-80,80),math.random(-80,80))
end
end

if pp[e].className == &quot;Tool&quot; then
if pp[e]:findFirstChild(&quot;Handle&quot;) ~= nil then
fire:clone().Parent = pp[e].Handle
pp[e].Handle.Velocity = Vector3.new(math.random(-80,80),math.random(-80,80),math.random(-80,80))
end
end

end

end

end
end
end
end


else
script.Parent.Fire.Enabled = false
end
end </ProtectedString>
