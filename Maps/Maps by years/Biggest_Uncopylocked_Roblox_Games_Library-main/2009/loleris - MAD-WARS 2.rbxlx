					<Item class="Script" referent="RBX4992">
						<Properties>
							<bool name="Archivable">true</bool>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">function chargeon()
script.Parent.on.Value = true
end

function chargeoff()
script.Parent.on.Value = false
end



script.Parent.Parent.Equipped:connect(function()
chargeon()
end)
script.Parent.Parent.Unequipped:connect(function()
chargeoff()
end)

while true do
wait(0.1)
if script.Parent.Value &lt; 100 and script.Parent.on2.Value == true and  script.Parent.on.Value == true then
script.Parent.Value = script.Parent.Value + 1
end
end </ProtectedString>
