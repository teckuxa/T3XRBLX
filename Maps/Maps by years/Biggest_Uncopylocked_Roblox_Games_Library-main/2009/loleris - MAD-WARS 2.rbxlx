					<Item class="Script" referent="RBX4896">
						<Properties>
							<bool name="Archivable">true</bool>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">BloxyColaScript</string>
							<ProtectedString name="Source">local Tool = script.Parent;

subboom = &quot;http://www.roblox.com/asset/?id=11984351&quot;
shirtsave = nil
facesave = nil

flash = Instance.new(&quot;Part&quot;)
flash.formFactor = &quot;Symmetric&quot;
flash.TopSurface = 0
flash.BottomSurface = 0
flash.BrickColor = BrickColor.new(1)
flash.Reflectance = 0.2
flash.Transparency = 0.2
flash.Size = Vector3.new(1,1,1)
flash.CanCollide = false
flash.Anchored = true
flash.Name = &quot;FLASH&quot;

mesh = Instance.new(&quot;SpecialMesh&quot;)
mesh.Scale = Vector3.new(50,30,50)
mesh.MeshType = &quot;Sphere&quot;
mesh.Parent = flash

sound = Instance.new(&quot;Sound&quot;)
sound.SoundId = subboom
sound.Volume = 1
sound.Parent = flash

bounce = false




function onActivated()
if bounce == false then
bounce = true
local vCharacter = Tool.Parent
local vPlayer = game.Players:playerFromCharacter(vCharacter)
ppack = game.Workspace.playerpacks:findFirstChild(vPlayer.Name)
if ppack ~= nil then
SA = ppack:findFirstChild(&quot;SpecAmmo&quot;)
if SA.Value &gt;= 1 then
SA.Value = SA.Value - 1

Tool.Handle.Transparency = 1
char = Tool.Parent

if char:findFirstChild(&quot;Humanoid&quot;).Health + 20 &lt; char:findFirstChild(&quot;Humanoid&quot;).MaxHealth then
char:findFirstChild(&quot;Humanoid&quot;).Health = char:findFirstChild(&quot;Humanoid&quot;).Health + 20
else
char:findFirstChild(&quot;Humanoid&quot;).Health = char:findFirstChild(&quot;Humanoid&quot;).MaxHealth 
end
char:findFirstChild(&quot;Humanoid&quot;).WalkSpeed = char:findFirstChild(&quot;Humanoid&quot;).WalkSpeed + 6

une = script.Parent.unequiper:clone()
une.Disabled = false
une.Parent = char

flashbomb(char)
blind(char)
invisible(char)
wait(8)
game.Workspace:findFirstChild(&quot;LAGGPANEL&quot;).couse.Value = &quot;A player turned visible&quot;
game.Workspace:findFirstChild(&quot;LAGGPANEL&quot;).fault.Value = &quot;Player&quot;
game.Workspace:findFirstChild(&quot;LAGGPANEL&quot;).submit.Value = true
visible(char)
char:findFirstChild(&quot;Humanoid&quot;).WalkSpeed = char:findFirstChild(&quot;Humanoid&quot;).WalkSpeed - 6
wait(20)
Tool.Handle.Transparency = 0


end
end
bounce = false
end
end




function invisible(pl)
h = pl:GetChildren()
for i = 1,#h do

if h[i].className == &quot;Part&quot; then
h[i].Transparency = 1
end

if h[i].className == &quot;Hat&quot; then
if h[i]:findFirstChild(&quot;Handle&quot;) ~= nil then
h[i]:findFirstChild(&quot;Handle&quot;).Transparency = 1
end
end

if h[i].Name == &quot;Torso&quot; then
if h[i]:findFirstChild(&quot;roblox&quot;) ~= nil then
shirtsave = h[i]:findFirstChild(&quot;roblox&quot;):clone()
h[i]:findFirstChild(&quot;roblox&quot;).Parent = nil
end
end

if h[i].Name == &quot;Head&quot; then
if h[i]:findFirstChild(&quot;face&quot;) ~= nil then
facesave = h[i]:findFirstChild(&quot;face&quot;):clone()
h[i]:findFirstChild(&quot;face&quot;).Parent = nil
end
if h[i]:findFirstChild(&quot;Player INFO&quot;) ~= nil then
h[i]:findFirstChild(&quot;Player INFO&quot;).Parent = nil
end
end

end

end




function visible(pl)
h = pl:GetChildren()
for i = 1,#h do

if h[i].className == &quot;Part&quot; then
h[i].Transparency = 0
end

if h[i].className == &quot;Hat&quot; then
if h[i]:findFirstChild(&quot;Handle&quot;) ~= nil then
h[i]:findFirstChild(&quot;Handle&quot;).Transparency = 0
end
end

if h[i].Name == &quot;Torso&quot; then
if h[i]:findFirstChild(&quot;roblox&quot;) == nil then
if shirtsave ~= nil then
shirtsave.Parent = h[i]
end
end
end

if h[i].Name == &quot;Head&quot; then
if h[i]:findFirstChild(&quot;face&quot;) == nil then
if facesave ~= nil then
facesave.Parent = h[i]
end
end
if h[i]:findFirstChild(&quot;Player INFO&quot;) == nil then
game.Lighting:findFirstChild(&quot;Player INFO&quot;):clone().Parent = h[i]
end
end

end

end


function flashbomb(pl)
newflash = flash:clone()
newflash.CFrame = pl.Torso.CFrame

sc = script.Parent.flash:clone()
sc.Disabled = false
sc.Parent = newflash

newflash.Parent = game.Workspace
end

function blind(pl)
tpos = pl:findFirstChild(&quot;Torso&quot;).Position
p = game.Players:GetChildren()
for i = 1,#p do
if p[i].Character ~= nil then
if p[i].Character:findFirstChild(&quot;Humanoid&quot;) ~= nil and  p[i].Character:findFirstChild(&quot;Torso&quot;) ~= nil then
if p[i].Character ~= pl then
if p[i].Character:findFirstChild(&quot;Humanoid&quot;).Health ~= 0 then
count = (p[i].Character:findFirstChild(&quot;Torso&quot;).Position - tpos).magnitude
if count &lt;= 25 then
game.Lighting:findFirstChild(&quot;BombFlash&quot;):clone().Parent = p[i].PlayerGui
end
end
end
end
end
end

end


function onEquipped()

end

script.Parent.Activated:connect(onActivated)
script.Parent.Equipped:connect(onEquipped)
