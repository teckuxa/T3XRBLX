						<string name="Name">Local Gui</string>
						<ProtectedString name="Source">local Tool = script.Parent;

enabled = true
function onButton1Down(mouse)
&#9;if not enabled then
&#9;&#9;return
&#9;end

&#9;enabled = false
&#9;mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot;

&#9;wait(0.5)
&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
&#9;enabled = true

end

function onEquippedLocal(mouse)

&#9;if mouse == nil then
&#9;&#9;print(&quot;Mouse not found&quot;)
&#9;&#9;return 
&#9;end

&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
&#9;mouse.KeyDown:connect(onKeyDown) 
end


Tool.Equipped:connect(onEquippedLocal)

function onKeyDown(key) 
&#9;if (key~=nil) then 
&#9;&#9;local key = key:lower() 
&#9;&#9;if (key==&quot;e&quot;) then
&#9;&#9;&#9;if script.Parent.Charge.Value &gt;= 100 and script.Parent.Handle.charge.Value == false and script.Parent.Active.Value == false then
&#9;&#9;&#9;&#9;Tool.Charge.on2.Value = false
&#9;&#9;&#9;&#9;script.Parent.Active.Value = true
&#9;&#9;&#9;&#9;script.Parent.Handle.charge.Value = true
&#9;&#9;&#9;&#9;script.Parent.Charge.Value = script.Parent.Charge.Value - 100
&#9;&#9;&#9;&#9;script.Parent.Charge.on2.Value = true
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end </ProtectedString>
