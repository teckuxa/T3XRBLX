					<Item class="Script" referent="RBX5942">
						<Properties>
							<bool name="Archivable">true</bool>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">SHINV</string>
							<ProtectedString name="Source">player = script.Parent.Parent.Parent.Parent
bouncy = script.Parent.BusyClick
bouncy.Value = false

itemserver = game.Workspace:findFirstChild(&quot;ItemServer&quot;)
itemdb = itemserver:findFirstChild(&quot;ItemDB&quot;)

selected = script.Parent.Selected
selected.Value = &quot;&quot;
function onClick(btt)
if btt ~= nil then
if bouncy.Value ~= true then
bouncy.Value = true
if selected.Value ~= &quot;s&quot; .. btt.Name then
selected.Value = &quot;s&quot; .. btt.Name



if btt.Item.Value ~= &quot;&quot; then
item = itemdb:findFirstChild(btt.Item.Value)
if item ~= nil then
shopsell = item:findFirstChild(&quot;ShopSell&quot;)
if shopsell ~= nil then
leaderstats = player:findFirstChild(&quot;leaderstats&quot;)
if leaderstats ~= nil then
pts = leaderstats:findFirstChild(&quot;Pts&quot;)
if pts ~= nil then
if pts.Value &gt;= shopsell.Value then

script.Parent.Trade.Slot.Value = btt.Name
script.Parent.Trade.Cost.Value = shopsell.Value
script.Parent.Trade.TradeName.Text = item:findFirstChild(&quot;ItemName2&quot;).Value
script.Parent.Trade.sell.Value = true
script.Parent.Trade.Visible = true

else
script.Parent.Trade.Visible = false
script.Parent.Trade.Slot.Value = &quot;&quot;
script.Parent.Trade.Cost.Value = 0
script.Parent.Trade.TradeName.Text = &quot;&quot;

script.Parent.Error.Text = &quot;You don&apos;t have enough points.&quot;
wait(3)
script.Parent.Error.Text = &quot;&quot;
selected.Value = &quot;&quot;
end
end
end
else
script.Parent.Trade.Visible = false
script.Parent.Trade.Slot.Value = &quot;&quot;
script.Parent.Trade.Cost.Value = 0
script.Parent.Trade.TradeName.Text = &quot;&quot;

script.Parent.Error.Text = &quot;Shop won&apos;t sell this item! LMAO...&quot;
wait(3)
script.Parent.Error.Text = &quot;&quot;
selected.Value = &quot;&quot;
end
end
else
script.Parent.Trade.Visible = false
script.Parent.Trade.Slot.Value = &quot;&quot;
script.Parent.Trade.Cost.Value = 0
script.Parent.Trade.TradeName.Text = &quot;&quot;
selected.Value = &quot;&quot;
end



else
script.Parent.Trade.Visible = false
script.Parent.Trade.Slot.Value = &quot;&quot;
script.Parent.Trade.Cost.Value = 0
script.Parent.Trade.TradeName.Text = &quot;&quot;
selected.Value = &quot;&quot;
end
bouncy.Value = false
end
end
end
inv2 = script.Parent.ShopInv

inv2:findFirstChild(&quot;I1&quot;).MouseButton1Up:connect(function ()
onClick(inv2:findFirstChild(&quot;I1&quot;))
end)
inv2:findFirstChild(&quot;I2&quot;).MouseButton1Up:connect(function ()
onClick(inv2:findFirstChild(&quot;I2&quot;))
end)
