			<Item class="Script" referent="RBX4774">
				<Properties>
					<bool name="Archivable">true</bool>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Hits</string>
					<ProtectedString name="Source">bh = script.Parent.bh
ch = script.Parent.ch
eh = script.Parent.eh
fh = script.Parent.fh
lh = script.Parent.lh
dh = script.Parent.dh
deh = script.Parent.deh

bannedhit = script.Parent.BannedHit
crithit = script.Parent.CritHit
epichit = script.Parent.EpicHit
failhit = script.Parent.FailHit
lmaohit = script.Parent.LmaoHit
directhit = script.Parent.DirectHit
derphit = script.Parent.DerpHit

function hit(num)

bannedhit.Visible = false
crithit.Visible = false
epichit.Visible = false
failhit.Visible = false
lmaohit.Visible = false
directhit.Visible = false
derphit.Visible = false

if num == 1 then
bh.Value = false
game.Workspace.HitSounds:findFirstChild(&quot;EpicHit&quot;):play()
bannedhit.Visible = true
wait(3)
bannedhit.Visible = false
end
if num == 2 then
ch.Value = false
game.Workspace.HitSounds:findFirstChild(&quot;CritHit&quot;):play()
crithit.Visible = true
wait(3)
crithit.Visible = false
end
if num == 3 then
eh.Value = false
game.Workspace.HitSounds:findFirstChild(&quot;EpicHit&quot;):play()
epichit.Visible = true
wait(3)
epichit.Visible = false
end
if num == 4 then
fh.Value = false
game.Workspace.HitSounds:findFirstChild(&quot;FailHit&quot;):play()
failhit.Visible = true
wait(3)
failhit.Visible = false
end
if num == 5 then
lh.Value = false
game.Workspace.HitSounds:findFirstChild(&quot;LmaoHit&quot;):play()
lmaohit.Visible = true
wait(3)
lmaohit.Visible = false
end
if num == 6 then
dh.Value = false
game.Workspace.HitSounds:findFirstChild(&quot;DirectHit&quot;):play()
directhit.Visible = true
wait(3)
directhit.Visible = false
end
if num == 7 then
deh.Value = false
game.Workspace.HitSounds:findFirstChild(&quot;LmaoHit&quot;):play()
derphit.Visible = true
wait(3)
derphit.Visible = false
end
end

bh.Changed:connect(function ()
hit(1)
end)

ch.Changed:connect(function ()
hit(2)
end)

eh.Changed:connect(function ()
hit(3)
end)

fh.Changed:connect(function ()
hit(4)
end)

lh.Changed:connect(function ()
hit(5)
end)

dh.Changed:connect(function ()
hit(6)
end)

deh.Changed:connect(function ()
hit(7)
end)</ProtectedString>
