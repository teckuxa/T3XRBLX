				<Item class="LocalScript" referent="RBX4998">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Fuel Script</string>
						<ProtectedString name="Source">local maxFuel = 100

local fuel = script.Parent.Charge

local gui = nil

function onEquippedLocal(mouse)

&#9;player = script.Parent.Parent
&#9;gui = script.Parent.FuelGui:clone()
&#9;updateGUI()
&#9;gui.Parent = game.Players:GetPlayerFromCharacter(player).PlayerGui

end

function updateGUI()

&#9;gui.Frame.Size = UDim2.new(0,40,0,300 * (fuel.Value/maxFuel))
&#9;gui.Frame.Position = UDim2.new(0.9,0,0.2 + (0.2 * ((maxFuel - fuel.Value)/maxFuel)),0)

end

function onUnequippedLocal()
gui:remove()
gui = nil
end

script.Parent.Equipped:connect(onEquippedLocal)
script.Parent.Unequipped:connect(onUnequippedLocal)

fuel.Changed:connect(function()
if gui ~= nil then
updateGUI()
end
end)</ProtectedString>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX4999">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">PaintballShooter</string>
						<ProtectedString name="Source">Tool = script.Parent


function fire(v,pos)
&#9;if script.Parent.Handle.charge.Value ~= true then
&#9;&#9;if Tool.Charge.Value &gt;= 20 then
&#9;&#9;Tool.Charge.on2.Value = false
&#9;&#9;&#9;Tool.Charge.Value = Tool.Charge.Value - 20

&#9;&#9;&#9;script.Parent.Handle.shoot.Value = true

&#9;&#9;&#9;local vCharacter = Tool.Parent
&#9;&#9;&#9;local vPlayer = game.Players:playerFromCharacter(vCharacter)

&#9;&#9;&#9;local missile = Instance.new(&quot;Part&quot;)


&#9;&#9;&#9;local spawnPos = vCharacter.PrimaryPart.Position
&#9;&#9;&#9;


&#9;&#9;&#9;spawnPos  = spawnPos + (v * 2)

&#9;&#9;&#9;spawnPos  = spawnPos + (v * 8)

&#9;killed_object = pos
&#9;Place0 = script.Parent.tip.CFrame 
&#9;cfnew = CFrame.new((Place0.p + killed_object)/2,Place0.p) 

&#9;&#9;&#9;missile.CFrame = cfnew
&#9;&#9;&#9;missile.Position = spawnPos
&#9;&#9;&#9;missile.Size = Vector3.new(1,1,1)
&#9;&#9;&#9;missile.Velocity = v * 400
&#9;&#9;&#9;missile.BrickColor = Tool.Parent.Torso.BrickColor
&#9;&#9;&#9;missile.Shape = 0
&#9;&#9;&#9;missile.BottomSurface = 0
&#9;&#9;&#9;missile.TopSurface = 0
&#9;&#9;&#9;missile.Name = &quot;Paintball&quot;
&#9;&#9;&#9;missile.Elasticity = 0
&#9;&#9;&#9;missile.Reflectance = 0
&#9;&#9;&#9;missile.Friction = .3

&#9;&#9;&#9;local force = Instance.new(&quot;BodyForce&quot;)
&#9;&#9;&#9;force.force = Vector3.new(0,100,0)
&#9;&#9;&#9;force.Parent = missile
&#9;&#9;&#9;
&#9;&#9;&#9;Tool.BrickCleanup:clone().Parent = missile

&#9;&#9;&#9;local new_mesh = Instance.new(&quot;SpecialMesh&quot;)
&#9;&#9;&#9;new_mesh.MeshType = &quot;Sphere&quot;
&#9;&#9;&#9;new_mesh.Scale = Vector3.new(0.2,0.2,20)
&#9;&#9;&#9;new_mesh.Parent = missile

&#9;&#9;&#9;local new_script = script.Parent.Paintball:clone()
&#9;&#9;&#9;new_script.Disabled = false
&#9;&#9;&#9;new_script.Parent = missile

&#9;&#9;&#9;local creator_tag = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;&#9;creator_tag.Value = vPlayer
&#9;&#9;&#9;creator_tag.Name = &quot;creator&quot;
&#9;&#9;&#9;creator_tag.Parent = missile
&#9;&#9;&#9;


&#9;&#9;&#9;missile.Parent = game.Workspace
&#9;&#9;end
&#9;else

&#9;&#9;&#9;Tool.Charge.on2.Value = false

&#9;&#9;&#9;script.Parent.Handle.charge.Value = false

&#9;&#9;&#9;script.Parent.Handle.shoot.Value = true

&#9;&#9;&#9;local vCharacter = Tool.Parent
&#9;&#9;&#9;local vPlayer = game.Players:playerFromCharacter(vCharacter)

&#9;&#9;&#9;local missile = Instance.new(&quot;Part&quot;)


&#9;&#9;&#9;local spawnPos = vCharacter.PrimaryPart.Position
&#9;&#9;&#9;


&#9;&#9;&#9;spawnPos  = spawnPos + (v * 2)

&#9;&#9;&#9;spawnPos  = spawnPos + (v * 8)

&#9;killed_object = pos
&#9;Place0 = script.Parent.tip.CFrame 
&#9;cfnew = CFrame.new((Place0.p + killed_object)/2,Place0.p) 

&#9;&#9;&#9;missile.CFrame = cfnew
&#9;&#9;&#9;missile.Position = spawnPos
&#9;&#9;&#9;missile.Size = Vector3.new(1,1,1)
&#9;&#9;&#9;missile.Velocity = v * 600
&#9;&#9;&#9;missile.BrickColor = Tool.Parent.Torso.BrickColor
&#9;&#9;&#9;missile.Shape = 0
&#9;&#9;&#9;missile.BottomSurface = 0
&#9;&#9;&#9;missile.TopSurface = 0
&#9;&#9;&#9;missile.Name = &quot;Paintball&quot;
&#9;&#9;&#9;missile.Elasticity = 0
&#9;&#9;&#9;missile.Reflectance = 0
&#9;&#9;&#9;missile.Friction = .3

&#9;&#9;&#9;local force = Instance.new(&quot;BodyForce&quot;)
&#9;&#9;&#9;force.force = Vector3.new(0,100,0)
&#9;&#9;&#9;force.Parent = missile
&#9;&#9;&#9;
&#9;&#9;&#9;Tool.BrickCleanup:clone().Parent = missile

&#9;&#9;&#9;local new_mesh = Instance.new(&quot;SpecialMesh&quot;)
&#9;&#9;&#9;new_mesh.MeshType = &quot;Sphere&quot;
&#9;&#9;&#9;new_mesh.Scale = Vector3.new(0.3,0.3,30)
&#9;&#9;&#9;new_mesh.Parent = missile

&#9;&#9;&#9;local new_script = script.Parent.Paintball2:clone()
&#9;&#9;&#9;new_script.Disabled = false
&#9;&#9;&#9;new_script.Parent = missile

&#9;&#9;&#9;local creator_tag = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;&#9;creator_tag.Value = vPlayer
&#9;&#9;&#9;creator_tag.Name = &quot;creator&quot;
&#9;&#9;&#9;creator_tag.Parent = missile
&#9;&#9;&#9;


&#9;&#9;&#9;missile.Parent = game.Workspace
&#9;end

end



Tool.Enabled = true
function onActivated()

&#9;if not Tool.Enabled then
&#9;&#9;return
&#9;end

&#9;Tool.Enabled = false
&#9;Tool.Active.Value = true

&#9;local character = Tool.Parent;
&#9;local humanoid = character.Humanoid
&#9;if humanoid == nil then
&#9;&#9;print(&quot;Humanoid not found&quot;)
&#9;&#9;return 
&#9;end

&#9;local targetPos = humanoid.TargetPoint
&#9;local lookAt = (targetPos - character.Head.Position).unit

&#9;fire(lookAt,targetPos)

&#9;wait(0.5)
&#9;Tool.Charge.on2.Value = true
