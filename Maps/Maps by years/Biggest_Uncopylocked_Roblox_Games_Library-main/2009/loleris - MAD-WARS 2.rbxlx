script.Parent.Parent = nil </ProtectedString>
							</Properties>
						</Item>
						<Item class="Script" referent="RBX1171">
							<Properties>
								<bool name="Archivable">true</bool>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">KWD</string>
								<ProtectedString name="Source">player = script.Parent.Parent.Parent.Parent.Parent.Parent

kwd = script.Parent.Parent.kwd
ksn = script.Parent.KSN
mode = &quot;&quot;
impaward = false

function msg(txt)
m = Instance.new(&quot;Message&quot;)
m.Text = txt
cup = script.Parent.c_up:clone()
cup.Disabled = false
cup.Parent = m
m.Parent = game.Workspace
end 

while true do 
wait()
if kwd.Value &lt;= 2 then
script.Parent.Text = &quot;&quot;
else
ks = ksn:findFirstChild(kwd.Value)
if ks ~= nil then
if ks.Name ~= mode then

if ks.Name == &quot;12&quot; then
if impaward == false then
impaward = true

local b = game:GetService(&quot;BadgeService&quot;)
b:AwardBadge(player.userId, script.Parent.BadgeIDImpossible.Value)

end
end



mode = ks.Name 
script.Parent.Text = ks.Value
if ks:findFirstChild(&quot;txt&quot;) ~= nil then
msg(string.upper(player.Name) .. &quot; &quot; .. ks:findFirstChild(&quot;txt&quot;).Value .. &quot; &quot; .. ks.Value)
else
msg(string.upper(player.Name) .. &quot; &quot; .. ks.Value)
end
end
end
end
end </ProtectedString>
							</Properties>
						</Item>
						<Item class="IntValue" referent="RBX1172">
							<Properties>
								<bool name="Archivable">true</bool>
