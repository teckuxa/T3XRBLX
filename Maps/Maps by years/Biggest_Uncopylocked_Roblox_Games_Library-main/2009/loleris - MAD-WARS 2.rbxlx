				<Item class="Script" referent="RBX4988">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Weld Script</string>
						<ProtectedString name="Source">function Weldnow()
print(&quot;welding...&quot;)

weld1 = Instance.new(&quot;Weld&quot;)
weld1.Part0 = script.Parent.Handle
weld1.Part1 = script.Parent.Part
weld1.C1 = CFrame.new(0, -0.7, 1)
weld1.Parent = script.Parent.Part

weld2 = Instance.new(&quot;Weld&quot;)
weld2.Part0 = script.Parent.Handle
weld2.Part1 = script.Parent.Part2
weld2.C1 = CFrame.new(0, 0.7, 1)
weld2.Parent = script.Parent.Part2

local W = Instance.new(&quot;Weld&quot;)
W.Part0 = script.Parent.Handle
W.Part1 = script.Parent.spinner
W.Parent = script.Parent.Handle
W.C0 = CFrame.new(0, 0, -1)
W.C1 = CFrame.new(0, 0, 0)

weld3 = Instance.new(&quot;Weld&quot;)
weld3.Part0 = script.Parent.tip
weld3.Part1 = script.Parent.Handle
weld3.C1 = CFrame.new(0, 0, -2.5)
weld3.Parent = script.Parent.tip





--script.Parent.spinner:MakeJoints()
script.Parent.tip:MakeJoints()
end
script.Parent.Equipped:connect(Weldnow)
script.Parent.Unequipped:connect(Weldnow)


Weldnow()</ProtectedString>
