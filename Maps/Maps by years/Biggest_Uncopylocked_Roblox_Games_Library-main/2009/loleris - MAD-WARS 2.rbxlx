				<Item class="LocalScript" referent="RBX4970">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">LocalFlashbang</string>
						<ProtectedString name="Source">local tool = script.Parent;
local canthrow = true;
local mousecurs = 1;

local cursors = { &quot;http://www.roblox.com/asset/?id=8541694&quot;, &quot;http://www.roblox.com/asset/?id=8542933&quot;, &quot;http://www.roblox.com/asset/?id=8542939&quot;, &quot;http://www.roblox.com/asset/?id=8542947&quot; };

local parts = {};
local c = tool:GetChildren();

local allparts = {};

for i = 1, #c do
&#9;if c[i].className == &quot;Part&quot; and c[i].Name ~= &quot;Handle&quot; then
&#9;&#9;table.insert(parts, c[i]);
&#9;end
&#9;if c[i].className == &quot;Part&quot; then
&#9;&#9;table.insert(allparts, c[i]);
&#9;end
end

function weld()
&#9;for i = 1, #parts do
&#9;&#9;local w = Instance.new(&quot;Weld&quot;);
&#9;&#9;w.Parent = tool.Handle;
&#9;&#9;w.Part0 = tool.Handle;
&#9;&#9;w.Part1 = parts[i];
&#9;&#9;w.C0 = parts[i].WeldValue.Value;
&#9;end
end

function onButton1Down(mouse)
&#9;if canthrow == false then
&#9;&#9;return;
&#9;end

&#9;canthrow = false;

&#9;local b = tool.Handle:Clone();
&#9;b.CanCollide = true;

&#9;for i = 1, #allparts do
&#9;&#9;allparts[i].Transparency = 1;
&#9;end

&#9;b.Name = &quot;FGrenade&quot;;

&#9;b.Parent = workspace;

&#9;local targ = mouse.Hit.p - tool.Parent.Head.Position;

&#9;local dir = targ / targ.magnitude;


--------------------------------------------------------------------------------------------- EDIT
&#9;local vCharacter = tool.Parent;

&#9;local vPlayer = game.Players:playerFromCharacter(vCharacter)

&#9;b.BrickColor = vCharacter.Torso.BrickColor

&#9;local creator_tag = Instance.new(&quot;ObjectValue&quot;)
&#9;creator_tag.Value =vPlayer
&#9;creator_tag.Name = &quot;creator&quot;
&#9;creator_tag.Parent = b

&#9;m2 = Instance.new(&quot;Sound&quot;)
&#9;m2.SoundId = &quot;http://www.roblox.com/asset/?id=11984254&quot;
&#9;m2.Pitch = 2
&#9;m2.Volume = 1
&#9;m2.Name = &quot;Boom&quot;
&#9;m2.Parent = b
--------------------------------------------------------------------------------------------- EDIT


&#9;local mag = targ.magnitude;

&#9;if mag &gt; 200 then
&#9;&#9;mag = 200;
&#9;end

&#9;local vel = dir * (mag / 2.5);

&#9;local pos = tool.Parent.Head.Position + (dir * 2.5);

&#9;local cfr = CFrame.new(pos, pos + dir);

&#9;b.CFrame = cfr;

&#9;b.Velocity = vel;

&#9;b.RotVelocity = Vector3.new(math.random(-1000, 1000) / 10, math.random(-1000, 1000) / 10, math.random(-1000, 1000) / 10);

&#9;local s = script.FlashbangScript:Clone();
&#9;local s2 = script.CameraManipulate:Clone();

&#9;s.Disabled = false;
&#9;s2.Disabled = false;

&#9;s2.Parent = s;

&#9;s.Parent = b;

&#9;for i = 1, 3 do
&#9;&#9;mousecurs = mousecurs + 1;
&#9;&#9;mouse.Icon = cursors[mousecurs];
&#9;&#9;wait(1.5);
&#9;end

&#9;mousecurs = 1;
&#9;mouse.Icon = cursors[mousecurs];

&#9;canthrow = true;

&#9;for i = 1, #allparts do
&#9;&#9;allparts[i].Transparency = 0;
&#9;end
end

function onEquip(mouse)
&#9;mouse.Icon = cursors[mousecurs];
&#9;weld();
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end);
end

function onUnequip()
&#9;weld();
end

tool.Equipped:connect(onEquip);
tool.Unequipped:connect(onUnequip);

weld();</ProtectedString>
					</Properties>
					<Item class="LocalScript" referent="RBX4971">
						<Properties>
							<bool name="Archivable">true</bool>
							<bool name="Disabled">true</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">CameraManipulate</string>
							<ProtectedString name="Source"></ProtectedString>
						</Properties>
					</Item>
					<Item class="Script" referent="RBX4972">
						<Properties>
							<bool name="Archivable">true</bool>
							<bool name="Disabled">true</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">FlashbangScript</string>
							<ProtectedString name="Source">local b = Instance.new(&quot;Part&quot;);
b.Name = &quot;Bang&quot;;
b.TopSurface = 0;
b.BottomSurface = 0;
b.Shape = 0;
b.Anchored = true;
b.Locked = true;
b.CanCollide = false;
b.BrickColor = BrickColor.new(28);
local size = 20

function detonate()
&#9;script.Parent:findFirstChild(&quot;Boom&quot;):play()

&#9;script.Parent.Anchored = true;

&#9;b.Parent = workspace;
&#9;b.CFrame = CFrame.new(script.Parent.Position);

&#9;local c = game.Players:GetChildren();

&#9;for i = 1, #c do
&#9;&#9;local char = c[i].Character;
&#9;&#9;if char:findFirstChild(&quot;Humanoid&quot;) ~= nil then

&#9;&#9;local head = char.Head;

&#9;&#9;local targ = head.Position - script.Parent.Position;
&#9;&#9;local mag = targ.magnitude;

&#9;&#9;if mag &lt;= 10 then
&#9;&#9;&#9;if c[i].TeamColor ~= script.Parent.BrickColor then
&#9;&#9;&#9;&#9;cr = script.Parent.creator:clone()
&#9;&#9;&#9;&#9;cr.Parent = c[i].Character:findFirstChild(&quot;Humanoid&quot;)
&#9;&#9;&#9;&#9;c[i].Character:findFirstChild(&quot;Humanoid&quot;).Health = c[i].Character:findFirstChild(&quot;Humanoid&quot;).Health - 60
&#9;&#9;&#9;&#9;wait()
&#9;&#9;&#9;&#9;cr.Parent = nil
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;script.Parent.Transparency = 1;

&#9;for i = 1, 20 do
&#9;&#9;wait(0.1);
&#9;&#9;b.Transparency = b.Transparency + 0.033;
&#9;&#9;b.Size = Vector3.new(size, size, size);
&#9;&#9;b.CFrame = CFrame.new(script.Parent.Position);
&#9;end
&#9;b.BrickColor = BrickColor.new(24);
&#9;for i = 1, 10 do
&#9;&#9;wait(0.1);
&#9;&#9;b.Transparency = b.Transparency + 0.033;
&#9;&#9;b.Size = Vector3.new(size, size, size);
&#9;&#9;b.CFrame = CFrame.new(script.Parent.Position);
&#9;end

&#9;b:Remove();
&#9;script.Parent:Remove();
end

wait(math.random(3, 5));

detonate();

wait(5)

</ProtectedString>
						</Properties>
					</Item>
				</Item>
