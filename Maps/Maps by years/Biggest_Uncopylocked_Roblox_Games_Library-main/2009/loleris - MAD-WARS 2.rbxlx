				<string name="Name">Anti Healing</string>
				<ProtectedString name="Source">while true do
wait()
p = game.Players:GetChildren()
for i = 1,#p do
char = p[i].Character
if char ~= nil then
torso = char:findFirstChild(&quot;Health&quot;)
if torso ~= nil then
torso.Parent = nil
end
end
end

end </ProtectedString>
