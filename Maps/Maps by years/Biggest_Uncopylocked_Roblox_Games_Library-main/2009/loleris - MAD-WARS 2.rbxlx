							<string name="Name">Hits</string>
							<ProtectedString name="Source">t1 = script.Parent.t1
t2 = script.Parent.t2
t3 = script.Parent.t3


txt1 = script.Parent.txt1
txt2 = script.Parent.txt2
txt3 = script.Parent.txt3

function hit(num)

txt1.Visible = false
txt2.Visible = false
txt3.Visible = false

if num == 1 then
t1.Value = false
txt1.Visible = true
end
if num == 2 then
t2.Value = false
txt2.Visible = true
end
if num == 3 then
t3.Value = false
txt3.Visible = true
end
end

wait()
if t1.Value == true then
hit(1)
elseif t2.Value == true then
hit(2)
elseif t3.Value == true then
hit(3)
end
</ProtectedString>
