wait(0.5)
end
invc = pack:findFirstChild(&quot;Inv&quot;):GetChildren()
for i = 1,#invc do
invc[i].Changed:connect(function ()
OnCh()
end)
end

function OnCh()
if player ~= nil then
&#9;&#9;pack = script.Parent.Parent.Parent.Gpack
&#9;&#9;if pack ~= nil then
&#9;&#9;&#9;inv = pack:findFirstChild(&quot;Inv&quot;)
&#9;&#9;&#9;for i = 1,16 do
&#9;&#9;&#9;&#9;slot = inv:findFirstChild(&quot;S&quot; .. i)
&#9;&#9;&#9;&#9;slot2 = script.Parent:findFirstChild(&quot;I&quot; .. i)
&#9;&#9;&#9;&#9;if slot ~= nil and  slot2 ~= nil then
&#9;&#9;&#9;&#9;&#9;if slot.Value == &quot;&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;if slot2.Image ~= &quot;http://www.roblox.com/asset/?id=29610183&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;slot2.Image = &quot;http://www.roblox.com/asset/?id=29610183&quot;
&#9;&#9;&#9;&#9;&#9;&#9;print(&quot;1 changed&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;itemdb = script.Parent.Parent.Parent.GItemDB
&#9;&#9;&#9;&#9;&#9;&#9;item = itemdb:findFirstChild(slot.Value)
&#9;&#9;&#9;&#9;&#9;&#9;if item ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if item:findFirstChild(&quot;Picture&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;if slot2.Image ~= item:findFirstChild(&quot;Picture&quot;).Value then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;slot2.Image = item:findFirstChild(&quot;Picture&quot;).Value
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;print(&quot;2 changed&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
end 



end 

OnCh()
wait(3)
OnCh()
wait(2)
OnCh()</ProtectedString>
