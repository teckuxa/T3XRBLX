		<Item class="Script" referent="RBX1092">
			<Properties>
				<bool name="Archivable">true</bool>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Team_changer</string>
				<ProtectedString name="Source">function onChatted(msg, speaker)
    

    --you need capitals
    
    source = string.lower(speaker.Name)
    
    --the below &quot;if then&quot; statement is necessary for this script.
    if string.sub(msg, 1, 5) == &quot;join/&quot; then
        local team = game.Teams:findFirstChild(string.sub(msg, 6))
        if team ~= nil then
            speaker.TeamColor = team.TeamColor
            wait(0.1)
            speaker.Character.Head:Remove()
        end
    end

    if msg == &quot;join/red&quot; then
        speaker.TeamColor = BrickColor.new(21) --Changes speaker&apos;s team color to red
        speaker.Character.Head:remove() --Kills the player to make the switch

    elseif msg == &quot;join/blue&quot; then
        speaker.TeamColor = BrickColor.new(23) --Changes speaker&apos;s team color to blue
        speaker.Character.Head:remove() --Kills the player to make the switch
    end

&#9;if string.lower(msg) == &quot;tutorial&quot; then
&#9;&#9;if speaker:findFirstChild(&quot;TDONE&quot;) ~= nil then
&#9;&#9;&#9;speaker:findFirstChild(&quot;TDONE&quot;).Parent = nil
&#9;&#9;end
&#9;end

end

--Again, you need this last part.

function onPlayerEntered(newPlayer)
        newPlayer.Chatted:connect(function(msg) onChatted(msg, newPlayer) end) 
&#9;wait(0.1)
&#9;&#9;while newPlayer.Character == nil do
&#9;&#9;wait()
&#9;&#9;end
&#9;&#9;while newPlayer.Character:findFirstChild(&quot;Torso&quot;) == nil do
&#9;&#9;wait()
&#9;&#9;end
&#9;&#9;while newPlayer.Character:findFirstChild(&quot;Torso&quot;):findFirstChild(&quot;roblox&quot;) == nil do
&#9;&#9;wait()
&#9;&#9;end
&#9;wait(6)
&#9;script.vip:clone().Parent = newPlayer.PlayerGui:findFirstChild(&quot;Menu&quot;)
&#9;if newPlayer.PlayerGui.Menu:findFirstChild(&quot;eqchange&quot;) ~= nil then
&#9;&#9;newPlayer.PlayerGui.Menu:findFirstChild(&quot;eqchange&quot;).Parent = nil 
&#9;end
&#9;&#9;p = newPlayer.Character:GetChildren()
&#9;&#9;for i = 1,#p do
&#9;&#9;&#9;if p[i].className == &quot;Part&quot; or p[i].className == &quot;Hat&quot; or p[i].className == &quot;Tool&quot; then
&#9;&#9;&#9;&#9;p[i].Parent = nil
&#9;&#9;&#9;end
&#9;&#9;end
end
 
game.Players.ChildAdded:connect(onPlayerEntered)

