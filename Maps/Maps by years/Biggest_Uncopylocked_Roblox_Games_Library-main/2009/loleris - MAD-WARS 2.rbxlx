&#9;end
&#9;newPlayer:findFirstChild(&quot;leaderstats&quot;).Pts.Value = newPlayer:findFirstChild(&quot;leaderstats&quot;).Pts.Value + 10
&#9;while game.Workspace.playerpacks:findFirstChild(newPlayer.Name) == nil do
&#9;wait()
&#9;end
&#9;game.Workspace.playerpacks:findFirstChild(newPlayer.Name).SpecAmmo.Value = game.Workspace.playerpacks:findFirstChild(newPlayer.Name).SpecAmmo.Value + 10
&#9;if game.Workspace.playerpacks:findFirstChild(newPlayer.Name).Equipped.Primary.Value == &quot;&quot; then
&#9;game.Workspace.playerpacks:findFirstChild(newPlayer.Name).Equipped.Primary.Value = &quot;X002&quot;
&#9;end
&#9;game.Workspace.playerpacks:findFirstChild(newPlayer.Name).Equipped.Special.Value = &quot;X304&quot;
&#9;while newPlayer:findFirstChild(&quot;PlayerGui&quot;) == nil do
&#9;wait()
&#9;end
&#9;while newPlayer.PlayerGui:findFirstChild(&quot;Menu&quot;) == nil do
&#9;wait()
&#9;end

&#9;msg = Instance.new(&quot;Message&quot;)
&#9;msg.Text = &quot;PRO STARTER VIP SHIRT&quot;
&#9;msg.Parent = newPlayer
&#9;playerVIP(newPlayer)
&#9;wait(6)
&#9;msg.Parent = nil

&#9;end

&#9;end
&#9;end
end 

