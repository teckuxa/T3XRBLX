					<Item class="Script" referent="RBX1303">
						<Properties>
							<bool name="Archivable">true</bool>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">MasterScript</string>
							<ProtectedString name="Source">print(&quot;Guide MASTER SCRIPT loaded...&quot;)

mainbox = script.Parent
lines = script.Parent.Lines
nxtb = script.Parent.Next
nxt = script.Parent.nxt
allownxt = script.Parent.Next.allow
nxthint = script.Parent.nxtHint
windowopening = script.Parent.Parent:findFirstChild(&quot;open windows&quot;)

rec = script.Parent.Parent.Recieving
itemdb = script.Parent.Parent.Parent.GItemDB ---X002---X003---X102---X202---X203---X302---

-----------------------------------------------------------------------------The start
mainbox.Text = lines:findFirstChild(&quot;txtStart&quot;).Value
nxt.Value = false
allownxt.Value = true 
nxthint.Visible = true 
nxtb.Visible = true

while nxt.Value == false do
wait()
end 
-----------------------------------------------------------------------------The start2
mainbox.Text = lines:findFirstChild(&quot;txtStart2&quot;).Value
nxt.Value = false
allownxt.Value = true
nxthint.Visible = true 
nxtb.Visible = true

while nxt.Value == false do
wait()
end 
-----------------------------------------------------------------------------The Recieving
mainbox.Text = lines:findFirstChild(&quot;txtRecieving&quot;).Value
nxt.Value = false
allownxt.Value = true
nxthint.Visible = true 
nxtb.Visible = true

randitemcount = 1

while nxt.Value == false do
wait()

if randitemcount == 1 then
dbitem = itemdb:findFirstChild(&quot;X002&quot;)
elseif randitemcount == 2 then
dbitem = itemdb:findFirstChild(&quot;X003&quot;)
elseif randitemcount == 3 then
dbitem = itemdb:findFirstChild(&quot;X102&quot;)
elseif randitemcount == 4 then
dbitem = itemdb:findFirstChild(&quot;X202&quot;)
elseif randitemcount == 5 then
dbitem = itemdb:findFirstChild(&quot;X203&quot;)
elseif randitemcount == 6 then
dbitem = itemdb:findFirstChild(&quot;X302&quot;)
end

if dbitem ~= nil then
iname = dbitem:findFirstChild(&quot;ItemName2&quot;)
ilvl = dbitem:findFirstChild(&quot;ItemLevel&quot;)
iwslot = dbitem:findFirstChild(&quot;WepSlot&quot;)
iclass = dbitem:findFirstChild(&quot;ItemName&quot;)
if iwslot ~= nil then
line1 = iname.Value
line2 = &quot;lvl &quot; .. ilvl.Value .. &quot; &quot; .. iwslot.Value .. &quot; &quot; .. iclass.Value .. &quot;.&quot;
line3 = &quot;&quot;
else
line1 = iname.Value
line2 = &quot;lvl &quot; .. ilvl.Value .. &quot; &quot; .. iclass.Value .. &quot;.&quot;
line3 = &quot;&quot;
end
rec.Visible = true
rec.recievename.Text = line1
rec.recieveclass.Text = line2
rec.recieveinfo.Text = line3
wait(0.5)
end

randitemcount = randitemcount + 1

if randitemcount &gt;= 7 then
randitemcount = 1
end

end 
-----------------------------------------------------------------------------The Recieving2

rec.recievename.Text = &quot;&quot;
rec.recieveclass.Text = &quot;&quot;
rec.recieveinfo.Text = &quot;&quot;
rec.Visible = false
--- end of Recieving1 ---

mainbox.Text = lines:findFirstChild(&quot;txtRecieving2&quot;).Value
nxt.Value = false
nxthint.Visible = false
nxtb.Visible = false

windowopening.Inventory.Value = true

while windowopening.Inventory.Value == true do
wait()
end
-----------------------------------------------------------------------------The Inventory
wait(3)

nxt.Value = false
allownxt.Value = true 
nxthint.Visible = true 
nxtb.Visible = true
mainbox.Text = lines:findFirstChild(&quot;txtInventory&quot;).Value

while nxt.Value == false do
wait()
end 

script.Parent.Parent.Parent.Gpack.Inv.S1.Value = &quot;X002&quot;
script.Parent.Parent.Parent.Gpack.Inv.S2.Value = &quot;X102&quot;

mainbox.Text = lines:findFirstChild(&quot;txtInventory2&quot;).Value
nxt.Value = false
nxthint.Visible = false
nxtb.Visible = false

ginv = script.Parent.Parent.Parent:findFirstChild(&quot;GInventory&quot;)

ginv.Main.Inventory.I1.allowed.Value = true

while ginv.Inv.I1.Value == false do
wait()
end 

ginv.Inv.I1.Value = false

ginv.Main.Equipped.E1.allowed.Value = true

ginv.Main.Inventory.I1.BorderColor3 = ginv.Main.cgreen.Value -- ginv.Main.cblack.Value
mainbox.Text = lines:findFirstChild(&quot;txtInventory3&quot;).Value

while ginv.eqpp.E1.Value == false do
wait()
end 

ginv.eqpp.E1.Value = false

ginv.Main.Inventory.I1.BorderColor3 = ginv.Main.cblack.Value

script.Parent.Parent.Parent.Gpack.Inv.S1.Value = &quot;&quot;
script.Parent.Parent.Parent.Gpack.Equipped.Primary.Value = &quot;X002&quot;

mainbox.Text = lines:findFirstChild(&quot;txtInventory4&quot;).Value

ginv.Main.Inventory.I2.allowed.Value = true

while ginv.Inv.I2.Value == false do
wait()
end 

ginv.Inv.I2.Value = false

ginv.Main.Equipped.E2.allowed.Value = true

ginv.Main.Inventory.I2.BorderColor3 = ginv.Main.cgreen.Value -- ginv.Main.cblack.Value
mainbox.Text = lines:findFirstChild(&quot;txtInventory5&quot;).Value

while ginv.eqpp.E2.Value == false do
wait()
end 

ginv.eqpp.E1.Value = false

ginv.Main.Inventory.I2.BorderColor3 = ginv.Main.cblack.Value

script.Parent.Parent.Parent.Gpack.Inv.S2.Value = &quot;&quot;
script.Parent.Parent.Parent.Gpack.Equipped.Secondary.Value = &quot;X102&quot;

mainbox.Text = lines:findFirstChild(&quot;txtInventory6&quot;).Value

ginv.Main.Inventory.I2.allowed.Value = true

nxt.Value = false
allownxt.Value = true 
nxthint.Visible = true 
nxtb.Visible = true

while nxt.Value == false do
wait()
end 

-----------------------------------------------------------------------------------CRAFTING 1!

nxt.Value = false
allownxt.Value = false 
nxthint.Visible = false
nxtb.Visible = false

script.Parent.Parent.Parent.Gpack.Inv.S1.Value = &quot;X401&quot;
script.Parent.Parent.Parent.Gpack.Inv.S2.Value = &quot;X501&quot;

mainbox.Text = lines:findFirstChild(&quot;txtCrafting&quot;).Value

ginv.Main.Inventory.I1.allowed.Value = true

while ginv.Inv.I1.Value == false do
wait()
end 

ginv.Inv.I1.Value = false

ginv.Main.CraftingInv.C1.allowed.Value = true
ginv.Main.CraftingInv.C2.allowed.Value = true
ginv.Main.CraftingInv.C3.allowed.Value = true
ginv.Main.CraftingInv.C4.allowed.Value = true
ginv.Main.CraftingInv.C5.allowed.Value = true
ginv.Main.CraftingInv.C6.allowed.Value = true

ginv.Main.Inventory.I1.BorderColor3 = ginv.Main.cgreen.Value -- ginv.Main.cblack.Value
mainbox.Text = lines:findFirstChild(&quot;txtCrafting2&quot;).Value

while ginv.CInvs.C1.Value == false and ginv.CInvs.C2.Value == false and ginv.CInvs.C3.Value == false and ginv.CInvs.C4.Value == false and ginv.CInvs.C5.Value == false and ginv.CInvs.C6.Value == false do
wait()
end 

ginv.Main.CraftingInv.C1.allowed.Value = false
ginv.Main.CraftingInv.C2.allowed.Value = false
ginv.Main.CraftingInv.C3.allowed.Value = false
ginv.Main.CraftingInv.C4.allowed.Value = false
ginv.Main.CraftingInv.C5.allowed.Value = false
ginv.Main.CraftingInv.C6.allowed.Value = false

ginv.CInvs.C1.Value = false
ginv.CInvs.C2.Value = false
ginv.CInvs.C3.Value = false
ginv.CInvs.C4.Value = false
ginv.CInvs.C5.Value = false
ginv.CInvs.C6.Value = false

script.Parent.Parent.Parent.Gpack.CraftInv.S1.Value = &quot;S1&quot;

ginv.Main.Inventory.I1.BorderColor3 = ginv.Main.cblack.Value

mainbox.Text = lines:findFirstChild(&quot;txtCrafting3&quot;).Value

ginv.Main.Inventory.I2.allowed.Value = true

while ginv.Inv.I2.Value == false do
wait()
end 

ginv.Inv.I2.Value = false

ginv.Main.CraftingInv.C1.allowed.Value = true
ginv.Main.CraftingInv.C2.allowed.Value = true
ginv.Main.CraftingInv.C3.allowed.Value = true
ginv.Main.CraftingInv.C4.allowed.Value = true
ginv.Main.CraftingInv.C5.allowed.Value = true
ginv.Main.CraftingInv.C6.allowed.Value = true

ginv.Main.Inventory.I2.BorderColor3 = ginv.Main.cgreen.Value -- ginv.Main.cblack.Value
mainbox.Text = lines:findFirstChild(&quot;txtCrafting4&quot;).Value

while ginv.CInvs.C1.Value == false and ginv.CInvs.C2.Value == false and ginv.CInvs.C3.Value == false and ginv.CInvs.C4.Value == false and ginv.CInvs.C5.Value == false and ginv.CInvs.C6.Value == false do
wait()
end 

ginv.Main.CraftingInv.C1.allowed.Value = false
ginv.Main.CraftingInv.C2.allowed.Value = false
ginv.Main.CraftingInv.C3.allowed.Value = false
ginv.Main.CraftingInv.C4.allowed.Value = false
ginv.Main.CraftingInv.C5.allowed.Value = false
ginv.Main.CraftingInv.C6.allowed.Value = false

