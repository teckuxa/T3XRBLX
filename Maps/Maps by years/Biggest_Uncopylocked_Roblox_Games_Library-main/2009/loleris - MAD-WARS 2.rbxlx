						<Item class="Script" referent="RBX5932">
							<Properties>
								<bool name="Archivable">true</bool>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Costscript</string>
								<ProtectedString name="Source">while true do
wait()
if script.Parent.Visible == true then
if script.Parent.sell.Value == true then
script.Parent.Costtxt.Text = &quot;Kopa for: &quot; .. script.Parent.Cost.Value .. &quot; Pts.&quot;
else
script.Parent.Costtxt.Text = &quot;Salja for: &quot; .. script.Parent.Cost.Value .. &quot; Pts.&quot;
end
end
end </ProtectedString>
							</Properties>
						</Item>
						<Item class="Script" referent="RBX5933">
							<Properties>
								<bool name="Archivable">true</bool>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Trade script</string>
								<ProtectedString name="Source">script.Parent.Busy.Value = false
player = script.Parent.Parent.Parent.Parent.Parent
playerpacks = game.Workspace:findFirstChild(&quot;playerpacks&quot;)
pack = playerpacks:findFirstChild(player.Name)

function onClick()
if script.Parent.Visible == true and script.Parent.Busy.Value == false then
script.Parent.Busy.Value = true
script.Parent.Parent.BusyClick.Value = true
if script.Parent.sell.Value == true then
slot = script.Parent.Parent.ShopInv:findFirstChild(script.Parent.Slot.Value)
if slot ~= nil then
itemid = slot.Item.Value
if itemid ~= &quot;&quot; then

invslots = pack:findFirstChild(&quot;Inv&quot;)
h = invslots:GetChildren()
gotit = false
for i = 1,#h do
&#9;if gotit == false then
&#9;&#9;if h[i].Value == &quot;&quot; then
&#9;&#9;&#9;leaderstats = player:findFirstChild(&quot;leaderstats&quot;)
&#9;&#9;&#9;if leaderstats ~= nil then
&#9;&#9;&#9;pts = leaderstats:findFirstChild(&quot;Pts&quot;)
&#9;&#9;&#9;if pts.Value &gt;= script.Parent.Cost.Value then
&#9;&#9;&#9;pts.Value = pts.Value - script.Parent.Cost.Value
&#9;&#9;&#9;h[i].Value = itemid
&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;gotit = true
&#9;&#9;end
&#9;end
end
if gotit == false then
script.Parent.Agree.Text = &quot;Overens&quot;
script.Parent.Visible = false
script.Parent.Parent.Selected.Value = &quot;&quot;
script.Parent.Parent.Error.Text = &quot;Inte tillrackligt med utrymme.&quot;
wait(3)
script.Parent.Parent.Error.Text = &quot;&quot;
else
script.Parent.Agree.Text = &quot;KOPT&quot;
wait(2)
script.Parent.Agree.Text = &quot;Overens&quot;
script.Parent.Visible = false
script.Parent.Parent.Selected.Value = &quot;&quot;
end
end
end
else
invslots = pack:findFirstChild(&quot;Inv&quot;)
slot = invslots:findFirstChild(&quot;S&quot; .. string.sub(script.Parent.Slot.Value,2,3))
if slot ~= nil then
itemid = slot.Value
if itemid ~= &quot;&quot; then
leaderstats = player:findFirstChild(&quot;leaderstats&quot;)
if leaderstats ~= nil then
pts = leaderstats:findFirstChild(&quot;Pts&quot;)
slot.Value = &quot;&quot;
pts.Value = pts.Value + script.Parent.Cost.Value
end
script.Parent.Agree.Text = &quot;SALDA&quot;
wait(2)
script.Parent.Agree.Text = &quot;Overens&quot;
script.Parent.Visible = false
script.Parent.Parent.Selected.Value = &quot;&quot;
end
end

end
script.Parent.Busy.Value = false
script.Parent.Parent.BusyClick.Value = false
end
end

script.Parent.Agree.MouseButton1Up:connect(onClick)</ProtectedString>
							</Properties>
						</Item>
