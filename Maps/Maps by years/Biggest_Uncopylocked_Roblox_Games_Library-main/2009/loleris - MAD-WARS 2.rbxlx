&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;
&#9;&#9;if pass == true then
&#9;&#9;
&#9;&#9;if craftslots:findFirstChild(&quot;S1&quot;).Value ~= &quot;&quot; then
&#9;&#9;sslot1 = invslots:findFirstChild(craftslots:findFirstChild(&quot;S1&quot;).Value)
&#9;&#9;else
&#9;&#9;sslot1 = nil
&#9;&#9;end
&#9;&#9;if craftslots:findFirstChild(&quot;S2&quot;).Value ~= &quot;&quot; then
&#9;&#9;sslot2 = invslots:findFirstChild(craftslots:findFirstChild(&quot;S2&quot;).Value)
&#9;&#9;else
&#9;&#9;sslot2 = nil
&#9;&#9;end
&#9;&#9;if craftslots:findFirstChild(&quot;S3&quot;).Value ~= &quot;&quot; then
&#9;&#9;sslot3 = invslots:findFirstChild(craftslots:findFirstChild(&quot;S3&quot;).Value)
&#9;&#9;else
