		<Item class="Script" referent="RBX657">
			<Properties>
				<bool name="Archivable">true</bool>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Leaderboard for MAD-WARS2</string>
				<ProtectedString name="Source">print(&quot;LinkedLeaderboard script version 5.00 loaded&quot;)

vip = &quot;http://www.roblox.com/asset/?id=36310215&quot;
fvip1 = &quot;http://www.roblox.com/asset/?id=36310278&quot;
fvip2 = &quot;http://www.roblox.com/asset/?id=36310339&quot;
fvip3 = &quot;http://www.roblox.com/asset/?id=36310410&quot;
fvip4 = &quot;http://www.roblox.com/asset/?id=36310491&quot;
prostart = &quot;http://www.roblox.com/asset/?id=36310591&quot;
prostart2 = &quot;http://www.roblox.com/asset/?id=39426815&quot;

stands = {}
CTF_mode = false

function msg(txt)
m = Instance.new(&quot;Hint&quot;)
m.Text = txt
cup = script.c_up:clone()
cup.Disabled = false
cup.Parent = m
m.Parent = game.Workspace
end 


function onHumanoidDied(humanoid, player)
&#9;local stats = player:findFirstChild(&quot;leaderstats&quot;)
&#9;if stats ~= nil then

&#9;&#9;-- do short dance to try and find the killer

&#9;&#9;local killer = getKillerOfHumanoidIfStillInGame(humanoid)

&#9;&#9;handleKillCount(humanoid, player)
&#9;&#9;p1pgi = pgi:findFirstChild(player.Name)
&#9;&#9;if p1pgi ~= nil then
&#9;&#9;p1pgi.kwd.Value = 0
&#9;&#9;end
&#9;end
end

function onPlayerRespawn(property, player)
&#9;-- need to connect to new humanoid
&#9;
&#9;if property == &quot;Character&quot; and player.Character ~= nil then
&#9;&#9;local humanoid = player.Character.Humanoid
&#9;&#9;&#9;local p = player
&#9;&#9;&#9;local h = humanoid
&#9;&#9;&#9;humanoid.Died:connect(function() onHumanoidDied(h, p) end )
&#9;end
end

function getKillerOfHumanoidIfStillInGame(humanoid)
&#9;-- returns the player object that killed this humanoid
&#9;-- returns nil if the killer is no longer in the game

&#9;-- check for kill tag on humanoid - may be more than one - todo: deal with this
&#9;local tag = humanoid:findFirstChild(&quot;creator&quot;)

&#9;-- find player with name on tag
&#9;if tag ~= nil then
&#9;&#9;
&#9;&#9;local killer = tag.Value
&#9;&#9;if killer.Parent ~= nil then -- killer still in game
&#9;&#9;&#9;return killer
&#9;&#9;end
&#9;end

&#9;return nil
end

function handleKillCount(humanoid, player)
&#9;local killer = getKillerOfHumanoidIfStillInGame(humanoid)
&#9;if killer ~= nil then
&#9;&#9;local stats = killer:findFirstChild(&quot;leaderstats&quot;)
&#9;&#9;if stats ~= nil then
&#9;&#9;&#9;local kills = stats:findFirstChild(&quot;Kills&quot;)
&#9;&#9;&#9;local pts = stats:findFirstChild(&quot;Pts&quot;)

&#9;&#9;&#9;if killer ~= player then
&#9;&#9;&#9;&#9;kills.Value = kills.Value + 1
&#9;&#9;&#9;&#9;pts.Value = pts.Value + 2
if killer.Character ~= nil then
if killer.Character:findFirstChild(&quot;Shirt Graphic&quot;) ~= nil then
dec = killer.Character:findFirstChild(&quot;Shirt Graphic&quot;).Graphic
if dec == vip or dec == fvip1 or dec == fvip2 or dec == fvip3 or dec == fvip4 or dec == prostart or dec == prostart2 then
pts.Value = pts.Value + 1
end
end
end




&#9;&#9;&#9;pgi = game.Workspace:findFirstChild(&quot;playergameinfo&quot;)
&#9;&#9;&#9;p1pgi = pgi:findFirstChild(player.Name)
&#9;&#9;&#9;p2pgi = pgi:findFirstChild(killer.Name)

&#9;&#9;&#9;if p2pgi ~= nil then
&#9;&#9;&#9;p2pgi.kwd.Value = p2pgi.kwd.Value + 1
&#9;&#9;&#9;if p2pgi.kwd.Value &gt; p2pgi.kwdh.Value then
&#9;&#9;&#9;&#9;p2pgi.kwdh.Value = p2pgi.kwd.Value
&#9;&#9;&#9;end
&#9;&#9;&#9;if p2pgi.dom:findFirstChild(player.Name) == nil then
&#9;&#9;&#9;&#9;newdom = Instance.new(&quot;IntValue&quot;)
&#9;&#9;&#9;&#9;newdom.Name = player.Name
&#9;&#9;&#9;&#9;newdom.Value = 1
&#9;&#9;&#9;&#9;newdom.Parent = p2pgi.dom
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;p2pgi.dom:findFirstChild(player.Name).Value = p2pgi.dom:findFirstChild(player.Name).Value + 1
&#9;&#9;&#9;&#9;if p2pgi.dom:findFirstChild(player.Name).Value &gt;= 3 then
&#9;&#9;&#9;&#9;msg(string.upper(killer.Name) .. &quot; IS DOMINATING &quot; .. string.upper(player.Name) .. &quot;!&quot;)
&#9;&#9;&#9;&#9;p2pgi:findFirstChild(&quot;inewdom&quot;).Value = true
&#9;&#9;&#9;&#9;p1pgi:findFirstChild(&quot;idom&quot;).Value = true
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
