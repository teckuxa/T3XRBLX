								</Properties>
								<Item class="StringValue" referent="RBX6304">
									<Properties>
										<bool name="Archivable">true</bool>
										<string name="Name">txtStart</string>
										<string name="Value">Valkomen till MAD-WARS 2 HANDLEDNING! Tryck pa &quot;Nasta&quot; knappen for att fortsatta...</string>
									</Properties>
								</Item>
								<Item class="StringValue" referent="RBX6305">
									<Properties>
										<bool name="Archivable">true</bool>
										<string name="Name">txtStart2</string>
										<string name="Value">Denna handledning kommer saga till dig informationer och hur du spelar detta spel.</string>
									</Properties>
								</Item>
								<Item class="StringValue" referent="RBX6306">
									<Properties>
										<bool name="Archivable">true</bool>
										<string name="Name">txtRecieving</string>
										<string name="Value">Du kommer ibland fa nya saker nar du dodar spelare (Drops). Kolla pa det MORKA FONSTRET som visas sig nar du fick nanting!</string>
									</Properties>
								</Item>
								<Item class="StringValue" referent="RBX6307">
									<Properties>
										<bool name="Archivable">true</bool>
										<string name="Name">txtRecieving2</string>
										<string name="Value">Nu titta pa din ryggsack om du har nagra saker dar! Tryck den gula &quot;Ryggsack&quot; knappen!</string>
									</Properties>
								</Item>
								<Item class="StringValue" referent="RBX6308">
									<Properties>
										<bool name="Archivable">true</bool>
										<string name="Name">txtInventory</string>
										<string name="Value">Boxarna under &quot;Ryggsacken&quot; skylten visar dig ryggsacks luckorna (16 totalt). Boxarna under &quot;Anvands&quot; skylt visar dig anvands saker. Boxarna under skylten &quot;Hantverk Utrymme&quot; visar dig markerade saker for hantverk.</string>
									</Properties>
								</Item>
								<Item class="StringValue" referent="RBX6309">
									<Properties>
										<bool name="Archivable">true</bool>
										<string name="Name">txtInventory2</string>
										<string name="Value">Du har fatt nagra saker! Anvand dem! Forst klicka pa Raketgevar.</string>
									</Properties>
								</Item>
								<Item class="StringValue" referent="RBX6310">
									<Properties>
										<bool name="Archivable">true</bool>
										<string name="Name">txtInventory3</string>
										<string name="Value">Nu klicka pa Forsta vapen luckan!</string>
									</Properties>
								</Item>
								<Item class="StringValue" referent="RBX6311">
									<Properties>
										<bool name="Archivable">true</bool>
										<string name="Name">txtInventory4</string>
										<string name="Value">Gor likadant med revolvern! Klicka pa revolvern...</string>
									</Properties>
								</Item>
								<Item class="StringValue" referent="RBX6312">
									<Properties>
										<bool name="Archivable">true</bool>
										<string name="Name">txtInventory5</string>
										<string name="Value">...Sen klicka pa Andra vapen luckan.</string>
									</Properties>
								</Item>
								<Item class="StringValue" referent="RBX6313">
									<Properties>
										<bool name="Archivable">true</bool>
										<string name="Name">txtInventory6</string>
										<string name="Value">Det ar 4 vapen klasser - Forsta, Andra, Melee och Special. Efter nar du har bytt dina anvanda vapen sa kommer du respawn for att fa dom nya vapnen.</string>
									</Properties>
								</Item>
								<Item class="StringValue" referent="RBX6314">
									<Properties>
										<bool name="Archivable">true</bool>
										<string name="Name">txtCrafting</string>
										<string name="Value">Du har fatt lite hantverk matrial! Du kan anvanda dem for att gora vapen! Klicka pa kristallen...</string>
									</Properties>
								</Item>
								<Item class="StringValue" referent="RBX6315">
									<Properties>
										<bool name="Archivable">true</bool>
										<string name="Name">txtCrafting2</string>
