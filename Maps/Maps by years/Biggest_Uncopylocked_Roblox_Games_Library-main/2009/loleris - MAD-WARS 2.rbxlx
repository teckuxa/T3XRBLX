				<Item class="Script" referent="RBX1980">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Images</string>
						<ProtectedString name="Source">player = script.Parent.Parent.Parent.Parent.Parent
while true do
wait()
for i = 1,16 do
&#9;wait()
&#9;slot = script.Parent:findFirstChild(&quot;I&quot; .. i)
&#9;if slot ~= nil then
&#9;&#9;if slot.Item.Value == &quot;&quot; then
&#9;&#9;&#9;if slot.Image ~= &quot;http://www.roblox.com/asset/?id=29610183&quot; then
&#9;&#9;&#9;&#9;slot.Image = &quot;http://www.roblox.com/asset/?id=29610183&quot;
&#9;&#9;&#9;&#9;print(&quot;1 changed&quot;)
&#9;&#9;&#9;end
&#9;&#9;else
&#9;&#9;&#9;itemserver = game.Workspace:findFirstChild(&quot;ItemServer&quot;)
&#9;&#9;&#9;itemdb = itemserver:findFirstChild(&quot;ItemDB&quot;)
&#9;&#9;&#9;item = itemdb:findFirstChild(slot.Item.Value)
&#9;&#9;&#9;if item ~= nil then
&#9;&#9;&#9;&#9;if item:findFirstChild(&quot;Picture&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;if slot.Image ~= item:findFirstChild(&quot;Picture&quot;).Value then
&#9;&#9;&#9;&#9;&#9;&#9;slot.Image = item:findFirstChild(&quot;Picture&quot;).Value
&#9;&#9;&#9;&#9;&#9;&#9;print(&quot;2 changed&quot;)
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end 



end </ProtectedString>
					</Properties>
				</Item>
			</Item>
			<Item class="Script" referent="RBX1981">
				<Properties>
					<bool name="Archivable">true</bool>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">ItemWiew</string>
					<ProtectedString name="Source">player = script.Parent.Parent.Parent.Parent
playerpacks = game.Workspace:findFirstChild(&quot;playerpacks&quot;)
pack = playerpacks:findFirstChild(player.Name)

itemserver = game.Workspace:findFirstChild(&quot;ItemServer&quot;)
itemdb = itemserver:findFirstChild(&quot;ItemDB&quot;)
btt = nil
oldbtt = nil

function onMouseOver(btt)
class = string.sub(btt.Name,1,1)
num = string.sub(btt.Name,2,3)

if class == &quot;I&quot; then
class = &quot;Inv&quot;
elseif class == &quot;C&quot; then
class = &quot;CraftInv&quot;
elseif class == &quot;E&quot; then
class = &quot;Equipped&quot;
end

category = pack:findFirstChild(class)
if category ~= nil then
p1 = &quot;&quot;

if class == &quot;Inv&quot; then
p1 = &quot;S&quot; .. num
elseif class == &quot;CraftInv&quot; then
p1 = &quot;S&quot; .. num
elseif class == &quot;Equipped&quot; then
if num == &quot;1&quot; then -- E1 = Primary; E2 = Secondary; E3 = Melee; E3 = Special.
p1 = &quot;Primary&quot;
elseif num == &quot;2&quot; then
p1 = &quot;Secondary&quot;
elseif num == &quot;3&quot; then
p1 = &quot;Melee&quot;
elseif num == &quot;4&quot; then
p1 = &quot;Special&quot;
end
end

script.Parent.ItemWiew.Visible = false

p2 = category:findFirstChild(p1)
if p2 ~= nil then
if p2.Value ~= &quot;&quot; and class ~= &quot;CraftInv&quot; then
itemid = p2.Value
item = itemdb:findFirstChild(itemid)
if item ~= nil then
script.Parent.ItemWiew.sell.Value = false
script.Parent.ItemWiew.ItemID.Value = item.Name
script.Parent.ItemWiew.Visible = true
end
else
script.Parent.ItemWiew.Visible = false
end

end
end
end

inv = script.Parent.Inventory

inv:findFirstChild(&quot;I1&quot;).MouseMoved:connect(function ()
onMouseOver(inv:findFirstChild(&quot;I1&quot;))
end)
inv:findFirstChild(&quot;I2&quot;).MouseMoved:connect(function ()
onMouseOver(inv:findFirstChild(&quot;I2&quot;))
end)
inv:findFirstChild(&quot;I3&quot;).MouseMoved:connect(function ()
onMouseOver(inv:findFirstChild(&quot;I3&quot;))
end)
inv:findFirstChild(&quot;I4&quot;).MouseMoved:connect(function ()
onMouseOver(inv:findFirstChild(&quot;I4&quot;))
end)
inv:findFirstChild(&quot;I5&quot;).MouseMoved:connect(function ()
onMouseOver(inv:findFirstChild(&quot;I5&quot;))
end)
inv:findFirstChild(&quot;I6&quot;).MouseMoved:connect(function ()
onMouseOver(inv:findFirstChild(&quot;I6&quot;))
end)
inv:findFirstChild(&quot;I7&quot;).MouseMoved:connect(function ()
onMouseOver(inv:findFirstChild(&quot;I7&quot;))
end)
inv:findFirstChild(&quot;I8&quot;).MouseMoved:connect(function ()
onMouseOver(inv:findFirstChild(&quot;I8&quot;))
end)
inv:findFirstChild(&quot;I9&quot;).MouseMoved:connect(function ()
onMouseOver(inv:findFirstChild(&quot;I9&quot;))
end)
inv:findFirstChild(&quot;I10&quot;).MouseMoved:connect(function ()
onMouseOver(inv:findFirstChild(&quot;I10&quot;))
end)
inv:findFirstChild(&quot;I11&quot;).MouseMoved:connect(function ()
onMouseOver(inv:findFirstChild(&quot;I11&quot;))
end)
inv:findFirstChild(&quot;I12&quot;).MouseMoved:connect(function ()
onMouseOver(inv:findFirstChild(&quot;I12&quot;))
end)
inv:findFirstChild(&quot;I13&quot;).MouseMoved:connect(function ()
onMouseOver(inv:findFirstChild(&quot;I13&quot;))
end)
inv:findFirstChild(&quot;I14&quot;).MouseMoved:connect(function ()
onMouseOver(inv:findFirstChild(&quot;I14&quot;))
end)
inv:findFirstChild(&quot;I15&quot;).MouseMoved:connect(function ()
onMouseOver(inv:findFirstChild(&quot;I15&quot;))
end)
inv:findFirstChild(&quot;I16&quot;).MouseMoved:connect(function ()
onMouseOver(inv:findFirstChild(&quot;I16&quot;))
end)
</ProtectedString>
				</Properties>
			</Item>
