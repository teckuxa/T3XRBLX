				<Item class="Script" referent="RBX1807">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">pts script</string>
						<ProtectedString name="Source">while true do
wait()
player = script.Parent.Parent.Parent.Parent.Parent
leaderstats = player:findFirstChild(&quot;leaderstats&quot;)
if leaderstats ~= nil then
pts = leaderstats:findFirstChild(&quot;Pts&quot;)
if pts ~= nil then
if pts.Value == 1 then
script.Parent.Text = &quot;You got &quot; .. pts.Value .. &quot; point&quot;
else
script.Parent.Text = &quot;You got &quot; .. pts.Value .. &quot; points&quot;
end
end
end
end
</ProtectedString>
					</Properties>
				</Item>
			</Item>
