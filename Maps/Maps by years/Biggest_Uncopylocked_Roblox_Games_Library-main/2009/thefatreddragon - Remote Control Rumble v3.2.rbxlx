								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">SpeedChangev4</string>
								<ProtectedString name="Source">function onTouch(hit)
	local hume=hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
	if(hume) then
		local succ,red = pcall(function() game.Players:FindFirstChild(hume.Parent.Name).Speed.Value=script.Parent.Parent.ASpeed.Value end)
		if succ then
			script.Parent.BrickColor=BrickColor.new(1003)
			wait(1)
			script.Parent.BrickColor=BrickColor.new(104)
		else
			script.Parent.BrickColor=BrickColor.new(1004)
			wait(1)
			script.Parent.BrickColor=BrickColor.new(104)			
		end
		--[[game.Players:FindFirstChild(hume.Parent.Name).Speed.Value=script.Parent.Parent.ASpeed.Value
		game.Players:FindFirstChild(hume.Parent.Name).Turn.Value=script.Parent.Parent.ATurn.Value
		script.Parent.BrickColor=BrickColor.new(1003)
		wait(1)
		script.Parent.BrickColor=BrickColor.new(104)--]]
	end
end

