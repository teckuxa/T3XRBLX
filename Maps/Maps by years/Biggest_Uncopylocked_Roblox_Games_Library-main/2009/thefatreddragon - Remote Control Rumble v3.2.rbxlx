						<Item class="Dialog" referent="RBX71">
							<Properties>
								<float name="ConversationDistance">32</float>
								<string name="InitialPrompt">Hello! How can I help you?</string>
								<string name="Name">Dialog(EDIT ME)</string>
								<token name="Purpose">1</token>
								<token name="Tone">0</token>
								<bool name="archivable">true</bool>
							</Properties>
							<Item class="DialogChoice" referent="RBX72">
								<Properties>
									<string name="Name">DialogChoice</string>
									<string name="ResponseDialog">Find a seat and use WSAD or the arrow keys to control your remote control car!</string>
									<string name="UserDialog">How do I play?</string>
									<bool name="archivable">true</bool>
								</Properties>
								<Item class="DialogChoice" referent="RBX73">
									<Properties>
										<string name="Name">DialogChoice</string>
										<string name="ResponseDialog">The remote control cars are controlled from the same color seats!</string>
										<string name="UserDialog">Which one is mine?</string>
										<bool name="archivable">true</bool>
									</Properties>
								</Item>
								<Item class="DialogChoice" referent="RBX74">
									<Properties>
										<string name="Name">DialogChoice</string>
										<string name="ResponseDialog">This happens when the car is flipped over! You just have to put up with it.</string>
										<string name="UserDialog">The car&apos;s controls are reversed!</string>
										<bool name="archivable">true</bool>
									</Properties>
								</Item>
								<Item class="DialogChoice" referent="RBX75">
									<Properties>
										<string name="Name">DialogChoice</string>
										<string name="ResponseDialog">The car the seat controls must of exploded already! Try another seat or wait for the automatic regen.</string>
										<string name="UserDialog">Nothing is happening when I try!</string>
										<bool name="archivable">true</bool>
									</Properties>
								</Item>
							</Item>
							<Item class="DialogChoice" referent="RBX76">
								<Properties>
									<string name="Name">DialogChoice</string>
									<string name="ResponseDialog">Damage other cars by hitting the back of them at speed. Cars will let off smoke, catch fire, and then explode!</string>
									<string name="UserDialog">What is the aim of the game?</string>
									<bool name="archivable">true</bool>
								</Properties>
								<Item class="DialogChoice" referent="RBX77">
									<Properties>
										<string name="Name">DialogChoice</string>
										<string name="ResponseDialog">Plan ahead! Don&apos;t let yourself be ambushed, or ganged up on.</string>
										<string name="UserDialog">Any tips?</string>
										<bool name="archivable">true</bool>
									</Properties>
								</Item>
								<Item class="DialogChoice" referent="RBX78">
									<Properties>
										<string name="Name">DialogChoice</string>
										<string name="ResponseDialog">They explode after 10 seconds of being on fire!</string>
										<string name="UserDialog">How do I know when a car will explode?</string>
										<bool name="archivable">true</bool>
									</Properties>
								</Item>
							</Item>
							<Item class="DialogChoice" referent="RBX79">
								<Properties>
									<string name="Name">DialogChoice</string>
									<string name="ResponseDialog">Manually regening the cars could be abused which wouldn&apos;t be any fun. It also means nobody has to sit out for long!</string>
									<string name="UserDialog">Why are the cars regened every 3 minutes?</string>
									<bool name="archivable">true</bool>
								</Properties>
								<Item class="DialogChoice" referent="RBX80">
									<Properties>
										<string name="Name">DialogChoice</string>
										<string name="ResponseDialog">Lag makes the count longer then it should be.</string>
										<string name="UserDialog">But 3 minutes have passed already!</string>
										<bool name="archivable">true</bool>
									</Properties>
								</Item>
							</Item>
							<Item class="DialogChoice" referent="RBX81">
								<Properties>
									<string name="Name">DialogChoice</string>
									<string name="ResponseDialog">If an RC has been controlled once already in the round, it&apos;s bumper won&apos;t change.</string>
									<string name="UserDialog">The RC&apos;s bumper won&apos;t change!</string>
									<bool name="archivable">true</bool>
								</Properties>
							</Item>
						</Item>
