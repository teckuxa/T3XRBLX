					<Item class="Script" referent="RBX1505">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">DamageScriptv19</string>
							<ProtectedString name="Source">local Glass = script.Parent
local HP = Glass.Parent.HP.Value
local broken = false

---------------------

function GetImpactVelocity(Own,Other) --  main function handling the forces of impact
	pPos = Own.Velocity;
	oPos = Other.Velocity;

	pRspeed = {x=0,y=0,z=0}
	oRspeed = {x=0,y=0,z=0}

	pRspeed.x = math.floor(pPos.x);
	pRspeed.y = math.floor(pPos.y);
	pRspeed.z = math.floor(pPos.z);

	oRspeed.x = math.floor(oPos.x);
	oRspeed.y = math.floor(oPos.y);
	oRspeed.z = math.floor(oPos.z);

	IForce = {x=0,y=0,z=0}
	IForce.x = pRspeed.x + -oRspeed.x
	IForce.y = pRspeed.y + -oRspeed.y
	IForce.z = pRspeed.z + -oRspeed.z

	if(IForce.x &lt; 0)then IForce.x = -IForce.x; end
	if(IForce.y &lt; 0)then IForce.y = -IForce.y; end
	if(IForce.z &lt; 0)then IForce.z = -IForce.z; end

	speed = math.max(IForce.x,IForce.y,IForce.z);

	return ((speed/4)*3);
end

---------------------

function onTouched(hit)
	if broken == false and hit.Parent~=Glass.Parent and hit.CanCollide==true or hit.Name==&quot;INSTAKILL&quot; then
		if(hit.Anchored==false or hit.Name==&quot;INSTAKILL&quot;) then
			--print(hit:GetMass()-Glass:GetMass())
			--print(Glass.Velocity.Magnitude+hit.Velocity.Magnitude)
			--print((hit:GetMass()-Glass:GetMass())*(Glass.Velocity.Magnitude+hit.Velocity.Magnitude))
			if(hit.Name==&quot;INSTAKILL&quot;)then
				HP=0
			end
			if(hit.Name~=&quot;Debris&quot; and hit.Name~=&quot;INSTAKILL&quot; and (GetImpactVelocity(Glass,hit))&gt;=10) then
				
				local damage = GetImpactVelocity(Glass,hit)
				print(damage);
				HP = HP-damage

				for i=1,1 do
					local g = Instance.new(&quot;Part&quot;)
					g.formFactor = &quot;Plate&quot;
					g.Name=&quot;Debris&quot;
					g.CanCollide=false
					g.TopSurface=0
					g.BottomSurface=0
					g.Size = Vector3.new(1, 0.2, 1)
					g.Parent = Glass.Parent
					g.Position = Glass.Position
					local v = Vector3.new(math.random(-1.5,1.5), math.random(2.5,5), math.random(-1.5,1.5))
					g.RotVelocity = Vector3.new(math.random(-120,120), math.random(-120,120), math.random(-120,120))
					g.Velocity = 10 * v
					g.BrickColor = Glass.BrickColor
				end
			end
				if HP &lt;= 33.3 then
					Glass.Smoke.Enabled=true
				end
				if HP &lt;= 0 and broken==false then
					local deaddrive = script.Parent.Parent.Driver.Value
					local killer
					if hit.Parent.Name == &quot;Bot&quot; then
						if hit.Parent.Driver ~= nil then
							killer = hit.Parent.Driver.Value
						end
					elseif hit.Parent.Parent.Parent.Name == &quot;Bot&quot; then
						if hit.Parent.Parent.Parent.Driver ~= nil then
							killer = hit.Parent.Parent.Parent.Driver.Value
						end						
					end

					broken = true

					Glass.Fire.Enabled=true
					wait(10)

					game.Workspace.RCCount.Value=game.Workspace.RCCount.Value-1

					if deaddrive ~= nil then
						if game.Players:FindFirstChild(deaddrive.Name) ~= nil then
							local hume = game.Players:FindFirstChild(deaddrive.Name)
							local deadstats = hume:findFirstChild(&quot;leaderstats&quot;)
							if deadstats ~= nil then
								local deaths = deadstats:findFirstChild(&quot;WOs&quot;)
								deaths.Value=deaths.Value+1
							end
						end
					end
					if killer ~= nil then
						if game.Players:FindFirstChild(killer.Name) ~= nil then
							local humen = game.Players:FindFirstChild(killer.Name)
							local killstats = humen:findFirstChild(&quot;leaderstats&quot;)
							if killstats~= nil then
								local kills = killstats:findFirstChild(&quot;KOs&quot;)
								kills.Value=kills.Value+1
							end
						end
					end

					local Decal = Instance.new(&quot;Decal&quot;, Glass.Parent.ChairBack)
					Decal.Face = &quot;Top&quot;
					Decal.Texture = &quot;http://www.roblox.com/asset/?id=42803459&quot;

					Glass.Explosion:Play()
					explosion = Instance.new(&quot;Explosion&quot;)
					explosion.BlastRadius=3
					explosion.BlastPressure=0
					explosion.Position = Glass.Position
					explosion.Parent = game.Workspace

					local g = script.Parent.Parent:getChildren()
					for i = 1, #g do
						if g[i].className==&quot;Part&quot; and g[i].Name~=&quot;Part&quot; and g[i].Anchored==false then
							g[i]:BreakJoints()
							g[i].Name = &quot;Debris&quot;
							g[i].CanCollide = false
							g[i].Velocity = Vector3.new(math.random(-2.5,2.5), math.random(5,10), math.random(-2.5,2.5))
							g[i].RotVelocity = Vector3.new(math.random(-120,120), math.random(-120,120), math.random(-120,120))
						elseif g[i].Name==&quot;Bumpers&quot; then
							local l = g[i]:getChildren()
							for b=1, #l do
								if l[b].className==&quot;Model&quot; then
									local p = l[b]:getChildren()
									for a=1, #p do
										p[a]:BreakJoints()
										p[a].Name = &quot;Debris&quot;
										p[a].CanCollide = false
										p[a].Velocity = Vector3.new(math.random(-2.5,2.5), math.random(5,10), math.random(-2.5,2.5))
										p[a].RotVelocity = Vector3.new(math.random(-120,120), math.random(-120,120), math.random(-120,120))
									end
								end
							end
						end
					end

					Glass.Fire.Enabled=false
					Glass.Smoke.Enabled=false
			end
		end
	end
end

