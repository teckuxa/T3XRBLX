				<Item class="Script" referent="RBX3131">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">UnanchorWheels2</string>
						<ProtectedString name="Source">wait(2)
script.Parent.R1.Anchored=false
script.Parent.R2.Anchored=false
script.Parent.L1.Anchored=false
script.Parent.L2.Anchored=false
</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
				<Item class="BoolValue" referent="RBX3132">
					<Properties>
						<string name="Name">Driven</string>
						<bool name="Value">false</bool>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
				<Item class="ObjectValue" referent="RBX3133">
					<Properties>
						<string name="Name">Driver</string>
						<Ref name="Value">null</Ref>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
				<Item class="NumberValue" referent="RBX3134">
					<Properties>
						<string name="Name">ATurn</string>
						<double name="Value">1</double>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
				<Item class="NumberValue" referent="RBX3135">
					<Properties>
						<string name="Name">ASpeed</string>
						<double name="Value">2</double>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX3136">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">4Wheelerv4</string>
						<ProtectedString name="Source">local seat = script.Parent.VehicleSeat
r1=script.Parent.R1
r2=script.Parent.R2
l1=script.Parent.L1
l2=script.Parent.L2
while true do
wait()
Speed = script.Parent.ASpeed.Value
TurnSpeed = script.Parent.ATurn.Value
if seat.Throttle == -1 then
	if seat.Steer==0 then
		l1.RightParamA=Speed
		l1.RightParamB=-Speed
		l2.RightParamA=Speed
		l2.RightParamB=-Speed 
		r1.RightParamA=-Speed 
		r1.RightParamB=Speed 
		r2.RightParamA=-Speed 
		r2.RightParamB=Speed
	end
	if seat.Steer == -1 then
	l1.RightParamA=(-TurnSpeed+Speed)/2 
	l1.RightParamB=(TurnSpeed-Speed)/2 
	l2.RightParamA=(-TurnSpeed+Speed)/2
	l2.RightParamB=(TurnSpeed-Speed)/2
	r1.RightParamA=(-TurnSpeed-Speed)/2
	r1.RightParamB=(TurnSpeed+Speed)/2
	r2.RightParamA=(-TurnSpeed-Speed)/2
	r2.RightParamB=(TurnSpeed+Speed)/2
	end 
	if seat.Steer == 1 then
	l1.RightParamA=(TurnSpeed+Speed)/2 
	l1.RightParamB=(-TurnSpeed-Speed)/2 
	l2.RightParamA=(TurnSpeed+Speed)/2
	l2.RightParamB=(-TurnSpeed-Speed)/2
	r1.RightParamA=(TurnSpeed-Speed)/2
	r1.RightParamB=(-TurnSpeed+Speed)/2
	r2.RightParamA=(TurnSpeed-Speed)/2
	r2.RightParamB=(-TurnSpeed+Speed)/2
	end 
end 
if seat.Throttle == 1 then 
	if seat.Steer==0 then
	l1.RightParamA=-Speed
	l1.RightParamB=Speed
	l2.RightParamA=-Speed
	l2.RightParamB=Speed
	r1.RightParamA=Speed
	r1.RightParamB=-Speed
	r2.RightParamA=Speed 
	r2.RightParamB=-Speed
	end
	if seat.Steer == 1 then
	l1.RightParamA=(-TurnSpeed-Speed)/2 
	l1.RightParamB=(TurnSpeed+Speed)/2 
	l2.RightParamA=(-TurnSpeed-Speed)/2
	l2.RightParamB=(TurnSpeed+Speed)/2
	r1.RightParamA=(-TurnSpeed+Speed)/2
	r1.RightParamB=(TurnSpeed-Speed)/2
	r2.RightParamA=(-TurnSpeed+Speed)/2
	r2.RightParamB=(TurnSpeed-Speed)/2
	end 
	if seat.Steer == -1 then
	l1.RightParamA=(TurnSpeed-Speed)/2 
	l1.RightParamB=(-TurnSpeed+Speed)/2 
	l2.RightParamA=(TurnSpeed-Speed)/2
	l2.RightParamB=(-TurnSpeed+Speed)/2
	r1.RightParamA=(TurnSpeed+Speed)/2
	r1.RightParamB=(-TurnSpeed-Speed)/2
	r2.RightParamA=(TurnSpeed+Speed)/2
	r2.RightParamB=(-TurnSpeed-Speed)/2
	end 
end
if seat.Throttle == 0 then
	if seat.Steer == -1 then 
	l1.RightParamA=TurnSpeed
	l1.RightParamB=-TurnSpeed
	l2.RightParamA=TurnSpeed 
	l2.RightParamB=-TurnSpeed
	r1.RightParamA=TurnSpeed 
	r1.RightParamB=-TurnSpeed 
	r2.RightParamA=TurnSpeed 
	r2.RightParamB=-TurnSpeed
	end 
	if seat.Steer == 1 then
	l1.RightParamA=-TurnSpeed 
	l1.RightParamB=TurnSpeed
	l2.RightParamA=-TurnSpeed 
	l2.RightParamB=TurnSpeed
	r1.RightParamA=-TurnSpeed 
	r1.RightParamB=TurnSpeed
	r2.RightParamA=-TurnSpeed 
	r2.RightParamB=TurnSpeed
	end
	if seat.Steer == 0 then
	l1.RightParamA=0
	l1.RightParamB=0
	l2.RightParamA=0
	l2.RightParamB=0 
	r1.RightParamA=0
	r1.RightParamB=0
	r2.RightParamA=0
	r2.RightParamB=0
	end
end 
end
</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
