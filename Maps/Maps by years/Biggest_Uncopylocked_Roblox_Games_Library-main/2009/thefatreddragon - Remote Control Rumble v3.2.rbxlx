								<ProtectedString name="Source">function onTouch(hit)
	local hume=hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
	if(hume) then
		local succ,red = pcall(function() game.Players:FindFirstChild(hume.Parent.Name).Bumper.Value=script.Parent.Parent.Bumper.Value end)
		if succ then
			script.Parent.BrickColor=BrickColor.new(1003)
			wait(1)
			script.Parent.BrickColor=BrickColor.new(104)
		else
			script.Parent.BrickColor=BrickColor.new(1004)
			wait(1)
			script.Parent.BrickColor=BrickColor.new(104)			
		end
	end
end

