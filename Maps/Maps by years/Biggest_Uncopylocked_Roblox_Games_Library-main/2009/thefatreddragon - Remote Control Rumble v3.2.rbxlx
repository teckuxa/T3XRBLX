		<Item class="Script" referent="RBX187">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">LinkedLeaderboardv2</string>
				<ProtectedString name="Source">local KOKey = &quot;KO&quot;
local WOKey = &quot;Wipe&quot;
local PlKey = &quot;Play&quot;

function onPlayerEntered(newPlayer)

		local fir = Instance.new(&quot;NumberValue&quot;)
		local sec = Instance.new(&quot;NumberValue&quot;)
		local bum = Instance.new(&quot;NumberValue&quot;)
		fir.Name=&quot;Speed&quot; 
		sec.Name=&quot;Turn&quot;
		bum.Name=&quot;Bumper&quot;
		fir.Value=2
		sec.Value=1
		bum.Value=0
		fir.Parent=newPlayer
		sec.Parent=newPlayer
		bum.Parent=newPlayer

		local stats = Instance.new(&quot;IntValue&quot;)
		stats.Name = &quot;leaderstats&quot;

		local kills = Instance.new(&quot;IntValue&quot;)
		kills.Name = &quot;KOs&quot;
		kills.Value = 0

		local deaths = Instance.new(&quot;IntValue&quot;)
		deaths.Name = &quot;WOs&quot;
		deaths.Value = 0

		local plays = Instance.new(&quot;IntValue&quot;)
		plays.Name = &quot;Plays&quot;
		plays.Value = 1

		kills.Parent = stats
		deaths.Parent = stats
		plays.Parent = stats

		
		local succ,ret = pcall(function() player:LoadNumber(KOKey) end)
		if succ then
			if ret ~= 0 then
				player.leaderstats.KOs.Value = ret
			else
				print(&quot;Nothing to load/KOs were 0&quot;)
			end
		else
			print(&quot;Error:&quot;,ret)
		end

		local succ,red = pcall(function() player:LoadNumber(WOKey) end)
		if succ then
			if red ~= 0 then
				player.leaderstats.Wipeouts.Value = red
			else
				print(&quot;Nothing to load/WOs were 0&quot;)
			end
		else
			print(&quot;Error:&quot;,red)
		end

		local succ,reb = pcall(function() player:LoadNumber(PlKey) end)
		if succ then
			if reb ~= 0 and reb ~= 1 then
				player.leaderstats.Played.Value = reb
			else
				print(&quot;Nothing to load&quot;)
			end
		else
			print(&quot;Error:&quot;,red)
		end

		-- VERY UGLY HACK
		-- Will this leak threads?
		-- Is the problem even what I think it is (player arrived before character)?
		while true do
			if newPlayer.Character ~= nil then break end
			wait(5)
		end

		local humanoid = newPlayer.Character.Humanoid

		humanoid.Died:connect(function() onHumanoidDied(humanoid, newPlayer) end )

		-- start to listen for new humanoid
		newPlayer.Changed:connect(function(property) onPlayerRespawn(property, newPlayer) end )


		stats.Parent = newPlayer

end

game.Players.ChildAdded:connect(onPlayerEntered)

game.Players.PlayerRemoving:connect(function(player)
	local succ,ret = pcall(function() player:SaveNumber(KOKey,player.leaderstats.KOs) end) --if a player leaves before the leaderstats have been created, as it&apos;s in a pcall it won&apos;t crash the script
	if succ then
		print(&quot;Successfully saved&quot;)
	else
		print(&quot;Saving error:&quot;,ret)
	end
	local succ,red = pcall(function() player:SaveNumber(WOKey,player.leaderstats.WOs) end) --if a player leaves before the leaderstats have been created, as it&apos;s in a pcall it won&apos;t crash the script
	if succ then
		print(&quot;Successfully saved&quot;)
	else
		print(&quot;Saving error:&quot;,ret)
	end
	local succ,reb = pcall(function() player:SaveNumber(PlKey,player.leaderstats.Plays) end) --if a player leaves before the leaderstats have been created, as it&apos;s in a pcall it won&apos;t crash the script
	if succ then
		print(&quot;Successfully saved&quot;)
	else
		print(&quot;Saving error:&quot;,ret)
	end
end)


