					<Item class="Script" referent="RBX1037">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">Car = script.Parent.Parent
Seat = script.Parent

Seat.ChildAdded:connect(function(p)
local t = p.Part1
local player = game.Players:playerFromCharacter(t.Parent)

if player then
Car.Driver.Value = player.Character
Car.ASpeed.Value= player.Speed.Value
Car.ATurn.Value= player.Turn.Value

if Car.Driven.Value==false then
--if Car.Driven.Value==0 then
	Car.Driven.Value=true
	local one = Car.Bumpers.StockBumper:GetChildren()
	local two = Car.Bumpers.WedgePanel:GetChildren()
	local thr = Car.Bumpers.RoundedBumper:GetChildren()
	local fou = Car.Bumpers.SpikePanel:GetChildren()
	local fiv = Car.Bumpers.WedgeTrap:GetChildren()
	local six = Car.Bumpers.PincerBumper:GetChildren()
	local sev = Car.Bumpers.Arrowhead:GetChildren()
	local eig = Car.Bumpers.RamPlate:GetChildren()
	local nin = Car.Bumpers.RampBumper:GetChildren()
	local ten = Car.Bumpers.FormulaWing:GetChildren()
	if player.Bumper.Value==0 then
		for i = 1, #one do
			one[i].CanCollide=true
			one[i].Transparency=0
		end
		--Car.Bumpers.StockBumper:Remove()
		Car.Bumpers.WedgePanel:Remove()
		Car.Bumpers.RoundedBumper:Remove()
		Car.Bumpers.SpikePanel:Remove()
		Car.Bumpers.WedgeTrap:Remove()

		Car.Bumpers.PincerBumper:Remove()
		Car.Bumpers.Arrowhead:Remove()
		Car.Bumpers.RamPlate:Remove()
		Car.Bumpers.RampBumper:Remove()
		Car.Bumpers.FormulaWing:Remove()
	end
	if player.Bumper.Value==1 then
		for i = 1, #two do
			two[i].CanCollide=true
			two[i].Transparency=0
		end
		Car.Bumpers.StockBumper:Remove()
		--Car.Bumpers.WedgePanel:Remove()
		Car.Bumpers.RoundedBumper:Remove()
		Car.Bumpers.SpikePanel:Remove()
		Car.Bumpers.WedgeTrap:Remove()

		Car.Bumpers.PincerBumper:Remove()
		Car.Bumpers.Arrowhead:Remove()
		Car.Bumpers.RamPlate:Remove()
		Car.Bumpers.RampBumper:Remove()
		Car.Bumpers.FormulaWing:Remove()
	end
	if player.Bumper.Value==2 then
		for i = 1, #thr do
			thr[i].CanCollide=true
			thr[i].Transparency=0
		end
		Car.Bumpers.StockBumper:Remove()
		Car.Bumpers.WedgePanel:Remove()
		--Car.Bumpers.RoundedBumper:Remove()
