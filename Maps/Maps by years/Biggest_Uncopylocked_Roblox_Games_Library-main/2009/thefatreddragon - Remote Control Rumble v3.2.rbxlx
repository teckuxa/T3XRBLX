					<string name="Name">JointRemover</string>
					<ProtectedString name="Source">local p = script.Parent:GetChildren()
for i = 1, #p do
	if p[i].className==&quot;Part&quot; then
		if p[i].Anchored==true then
			p[i]:BreakJoints()
		end
	end
end </ProtectedString>
