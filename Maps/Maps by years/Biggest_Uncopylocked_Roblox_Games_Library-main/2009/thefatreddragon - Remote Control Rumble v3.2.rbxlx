						<string name="Name">UnanchorWheels2</string>
						<ProtectedString name="Source">wait(2)
script.Parent.R1.Anchored=false
script.Parent.R2.Anchored=false
script.Parent.L1.Anchored=false
script.Parent.L2.Anchored=false
</ProtectedString>
