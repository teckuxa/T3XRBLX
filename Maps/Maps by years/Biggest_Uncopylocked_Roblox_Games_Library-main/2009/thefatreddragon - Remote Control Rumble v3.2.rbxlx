				</Item>
				<Item class="NumberValue" referent="RBX2168">
					<Properties>
						<string name="Name">ATurn</string>
						<double name="Value">1</double>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
				<Item class="NumberValue" referent="RBX2169">
