				<Item class="Script" referent="RBX4659">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Bumperv9</string>
						<ProtectedString name="Source">bumper = script.Parent

function onTouched(hit)
if hit.CanCollide==true then
	local a = hit.Parent:findFirstChild(&quot;Chassis&quot;)
	local b = hit.Parent.Parent.Parent:findFirstChild(&quot;Chassis&quot;)
	local zx = hit.Position.X
	local zy = hit.Position.Y
	local zz = hit.Position.Z
	if a~=nil then
		a.Velocity = Vector3.new((zx-bumper.Position.X)*10,(zy-bumper.Position.Y)*10,(zz-bumper.Position.Z)*10)
	elseif b~=nil then
		b.Velocity = Vector3.new((zx-bumper.Position.X)*10,(zy-bumper.Position.Y)*10,(zz-bumper.Position.Z)*10)		
	else
		hit.Velocity = Vector3.new((zx-bumper.Position.X)*10,(zy-bumper.Position.Y)*10,(zz-bumper.Position.Z)*10)
		end
	bumper.Bumper:Play()
	print(hit.Velocity.Magnitude)
	bumper.BrickColor=BrickColor.new(1004)
	wait(0.1)
	bumper.BrickColor=BrickColor.new(21)
end
end

bumper.Touched:connect(onTouched)</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
