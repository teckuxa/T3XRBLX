							<string name="Name">Script</string>
							<ProtectedString name="Source">Car = script.Parent.Parent
Seat = script.Parent

Seat.ChildAdded:connect(function(p)
local t = p.Part1
local player = game.Players:playerFromCharacter(t.Parent)

if player then
Car.Driver.Value = player.Character
Car.ASpeed.Value= player.Speed.Value
Car.ATurn.Value= player.Turn.Value

if Car.Driven.Value==false then
--if Car.Driven.Value==0 then
	Car.Driven.Value=true
	local one = Car.Bumpers.StockBumper:GetChildren()
	local two = Car.Bumpers.WedgePanel:GetChildren()
