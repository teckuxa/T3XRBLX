						<float name="BottomParamA">-0.5</float>
						<float name="BottomParamB">0.5</float>
						<token name="BottomSurface">0</token>
						<token name="BottomSurfaceInput">0</token>
						<int name="BrickColor">1028</int>
						<CoordinateFrame name="CFrame">
							<X>16</X>
							<Y>13.4000006</Y>
							<Z>-37.2999992</Z>
							<R00>0</R00>
