		Car.Bumpers.WedgeTrap:Remove()

		--Car.Bumpers.PincerBumper:Remove()
		Car.Bumpers.Arrowhead:Remove()
		Car.Bumpers.RamPlate:Remove()
		Car.Bumpers.RampBumper:Remove()
		Car.Bumpers.FormulaWing:Remove()
	end
	if player.Bumper.Value==6 then
		for i = 1, #sev do
			sev[i].CanCollide=true
			sev[i].Transparency=0
		end
		Car.Bumpers.StockBumper:Remove()
