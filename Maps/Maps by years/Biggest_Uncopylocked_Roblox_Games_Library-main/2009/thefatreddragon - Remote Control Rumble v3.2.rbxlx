		<Item class="Script" referent="RBX3796">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Timed Regen Script v3</string>
				<ProtectedString name="Source">function Round(num)
local Int, Num = math.modf(num)
	if Num &gt;= 0.5 then
	Int = Int + 1
	elseif Num &lt; 0.5 then
	Int = Int
	end
	return Int
end

-----

model = game.Workspace.RC --Change MODELNAME to the model you want to regenerate
messageText = &quot;Auto-regenerating Remote Control Cars (Happens every 4 minutes)&quot; --Change MESSAGEHERE to the message you want to show when it regenerates. Delete MESSAGEHERE if you want no message.
messagetwoText = &quot;10 seconds until the Remote Control Cars are regened!&quot;

KOfinish=0
message = Instance.new(&quot;Message&quot;)
message.Text = messageText
messagetwo = Instance.new(&quot;Message&quot;)
messagetwo.Text = messagetwoText
messagemap = Instance.new(&quot;Message&quot;)
backup = model:clone()

map1 = game.Lighting:findFirstChild(&quot;Classic&quot;)
map2 = game.Lighting:findFirstChild(&quot;TwoStory&quot;)
map3 = game.Lighting:findFirstChild(&quot;Flat&quot;)
map4 = game.Lighting:findFirstChild(&quot;Hill&quot;)
map5 = game.Lighting:findFirstChild(&quot;IceFlat&quot;)
map6 = game.Lighting:findFirstChild(&quot;Ditch&quot;)
map7 = game.Lighting:findFirstChild(&quot;DeathPit&quot;)
map8 = game.Lighting:findFirstChild(&quot;Sumo&quot;)
map9 = game.Lighting:findFirstChild(&quot;Pinball&quot;)
map10 = game.Lighting:findFirstChild(&quot;RobotWars&quot;)

while true do
game.Workspace.RCCount.Value=20
local random= Round(math.random(1,10))
local map
if random == 1 then
	map = map1
	map.Parent = game.Workspace
	messagemap.Text=&quot;Battle in the extended Classic Arena!&quot;
	messagemap.Parent=game.Workspace
end
if random == 2 then
	map = map2
	map.Parent = game.Workspace
	messagemap.Text=&quot;Drive carefully in this Two Story Arena!&quot;
	messagemap.Parent=game.Workspace
end
if random == 3 then
	map = map3
	map.Parent = game.Workspace
	messagemap.Text=&quot;Absolutely no gimmicks in the Flat Arena!&quot;
	messagemap.Parent=game.Workspace
end
if random == 4 then
	map = map4
	map.Parent = game.Workspace
	messagemap.Text=&quot;Can you be the King of the Hill in this arena?&quot;
	messagemap.Parent=game.Workspace
end
if random == 5 then
	map = map5
	map.Parent = game.Workspace
	messagemap.Text=&quot;Try not to slide to your doom in the Ice Arena!&quot;
	messagemap.Parent=game.Workspace
end
if random == 6 then
	map = map6
	map.Parent = game.Workspace
	messagemap.Text=&quot;Fight in the dips of this arena layout!&quot;
	messagemap.Parent=game.Workspace
end
if random == 7 then
	map = map7
	map.Parent = game.Workspace
	messagemap.Text=&quot;You won&apos;t like it you drop into this arena&apos;s Pit of Doom!&quot;
	messagemap.Parent=game.Workspace
end
if random == 8 then
	map = map8
	map.Parent = game.Workspace
	messagemap.Text=&quot;Don&apos;t let yourself be pushed off the sides in the NEW Sumo Arena!&quot;
	messagemap.Parent=game.Workspace
end
if random == 9 then
	map = map9
	map.Parent = game.Workspace
	messagemap.Text=&quot;Bounce and battle in the giant Pinball Arena!&quot;
	messagemap.Parent=game.Workspace
end
if random == 10 then
	map = map10
	map.Parent = game.Workspace
	messagemap.Text=&quot;Have a REAL Annihilator in the Robot Wars Arena!&quot;
	messagemap.Parent=game.Workspace
end
game.Workspace.Begin:Play()
wait(5)
messagemap.Parent=nil
--wait(165)


KOfinish=0
wait(5)
for i=1,220 do
	if(game.Workspace.RCCount.Value&lt;2) then 
		KOfinish=1
	break end
	wait(1)
end
if KOfinish == 1 then
	messagetwo.Text = &quot;The round is over! 10 seconds until the Remote Control Cars are regened.&quot;
	game.Workspace.Applause:Play()
else
	messagetwo.Text = &quot;No absolute winner this time. 10 seconds until the Remote Control Cars are regened!&quot;
end


messagetwo.Parent = game.Workspace
wait(10)
messagetwo.Parent = nil 
message.Parent = game.Workspace
model:remove()

map.Parent=game.Lighting

wait(3) --Change 3 to the amount of time the message will show. 

model = backup:clone()
model.Parent = game.Workspace
model:makeJoints()
message.Parent = nil 
end

</ProtectedString>
