welds[1].Parent = nil
welds[2].Parent = nil
end
end
--
end
else
print(&quot;sh&quot;)
end
else
print(&quot;arms&quot;)
end
end
function Key(key)
if key then
key = string.lower(key)
if (key==&quot;c&quot;) then
if on == 1 then
on = 0
elseif on == 0 then
on = 1
end
Crouch(on)
end
end
end
function Equip(mouse)
mouse.KeyDown:connect(Key)
end
