						<ProtectedString name="Source">mode = 0
Tool = script.Parent

script.Parent.Equipped:connect(function(m)
	m.KeyDown:connect(function(k)
		if k == &quot;q&quot; then
			if mode==0 then
				mode=1
				Tool:findFirstChild(&quot;Server Launcher&quot;).Disabled=false
				Tool:findFirstChild(&quot;LocalGui&quot;).Disabled=true
				Tool.FireIndicator.Decal.Texture=&quot;http://www.roblox.com/asset/?id=47487135&quot;
				m.Icon = &quot;http://www.roblox.com/asset/?id=46165664&quot;
				wait(0.5)
				m.Icon = &quot;http://www.roblox.com/asset/?id=46165652&quot;
			else
				mode=0
				Tool:findFirstChild(&quot;Server Launcher&quot;).Disabled=true
				Tool:findFirstChild(&quot;LocalGui&quot;).Disabled=false
				Tool.FireIndicator.Decal.Texture=&quot;http://www.roblox.com/asset/?id=47487152&quot;
				m.Icon = &quot;http://www.roblox.com/asset/?id=46165664&quot;
