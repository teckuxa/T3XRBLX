							<ProtectedString name="Source">function damage(hit)
posi = script.Parent.CFrame
--Kill People
if hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil then
hit.Parent.Humanoid.Health = hit.Parent.Humanoid.Health - 75
end
--BreakJointer
if hit.Name == &quot;BrokenWood&quot; or hit.Name == &quot;BrokenGlass&quot; then
hit:BreakJoints()
hit.Velocity = script.Parent.Velocity / Vector3.new(10,10,10)
remo = script.Remover:clone()
remo.Disabled = false
remo.Parent = hit
end
--GlassBreaker
if hit.Name == &quot;Glass&quot; then
x = hit.Size.X
y = hit.Size.Y
hit.CanCollide = false
home = Instance.new(&quot;Model&quot;)
home.Name = &quot;BrokenDebris&quot;
home.Parent = game.Workspace
for a = 1, x do
block = hit:clone()
block.formFactor = &quot;Plate&quot;
block.Mesh.Scale = Vector3.new(1,0,1)
block.Size = Vector3.new(1,0.4,1)
block.Anchored = false
block.CanCollide = true
block.FrontSurface = &quot;Weld&quot;
block.LeftSurface = &quot;Weld&quot;
block.RightSurface = &quot;Weld&quot;
block.BackSurface = &quot;Weld&quot;
block.CFrame = hit.CFrame * CFrame.new((-x / 2) - 0.5 + a,(-y/2) + 0.5,0) * CFrame.fromEulerAnglesXYZ(1.57,0,0)
block.Parent = home
block.Name = &quot;BrokenGlass&quot;
for b = 1, y do
block2 = block:clone()
block2.CFrame = block.CFrame * CFrame.new(0,0,-b)
block2.Parent = home
end
end
home:MakeJoints()
hit:remove()
end
--WoodBreaker
if hit.Name == &quot;Wood&quot; then
x = hit.Size.X
z = hit.Size.Z
home = Instance.new(&quot;Model&quot;)
home.Name = &quot;BrokenDebris&quot;
home.Parent = game.Workspace
if z%2 == 1 then
zblah = &quot;odd&quot;
else
zblah = &quot;even&quot;
end
hit.CanCollide = false

for a = 1, x do
block = hit:clone()
block.Name = &quot;BrokenWood&quot;
block.formFactor = &quot;Plate&quot;
block.CanCollide = true
if a%2 == 1 then
block.Size = Vector3.new(1,hit.Size.Y,2)
else
block.Size = Vector3.new(1,hit.Size.Y,1)
end
block.CFrame = hit.CFrame * CFrame.new((-x/2) - 0.5 + a,0,(-z/2) + (block.Size.Z / 2))
for b = 1, math.floor(z/2) - 1 do
block2 = block:clone()
block2.Size = Vector3.new(1,hit.Size.Y,2)
block2.CFrame = block.CFrame * CFrame.new(0,0,(block.Size.Z / 2) + (2 * b) - 1)
block2.Parent = home
end
if zblah == &quot;odd&quot; then
if a%2 == 1 then
block3 = block:clone()
block3.Size = Vector3.new(1,hit.Size.Y,1)
block3.CFrame = block.CFrame * CFrame.new(0,0,z - 1.5)
block3.Parent = home
else
block3 = block:clone()
block3.Size = Vector3.new(1,hit.Size.Y,2)
block3.CFrame = block.CFrame * CFrame.new(0,0,z - 1.5)
block3.Parent = home
end
else
if a%2 == 0 then
block3 = block:clone()
block3.Size = Vector3.new(1,hit.Size.Y,1)
block3.CFrame = block.CFrame * CFrame.new(0,0,z - 1)
block3.Parent = home
end
end
block.Parent = home
home:MakeJoints()
hit:remove()
end

end
--Spark
if hit.Name == &quot;Metal&quot; then
block = Instance.new(&quot;Part&quot;)
block.formFactor = &quot;Symmetric&quot;
block.Size = Vector3.new(1,1,1)
block.Anchored = true
block.CanCollide = false
block.Transparency = 1
block.CFrame = posi
remo = script.Remover2:clone()
remo.Disabled = false
remo.Parent = block
spark = script.Spark:clone()
spark.Parent = block
block.Parent = game.Workspace
end
--Smoke
if hit.Name == &quot;Concrete&quot; then
block = Instance.new(&quot;Part&quot;)
block.formFactor = &quot;Symmetric&quot;
block.Size = Vector3.new(1,1,1)
block.Anchored = true
block.CanCollide = false
block.Transparency = 1
block.CFrame = posi
remo = script.Remover2:clone()
remo.Disabled = false
remo.Parent = block
smoke = script.Smoke:clone()
smoke2 = script.Smoke2:clone()
smoke.Parent = block
smoke2.Parent = block
block.Parent = game.Workspace
end
--BlockRemover
if hit.className == &quot;Part&quot; and hit.CanCollide == true then
script.Parent:remove()
end
end
script.Parent.Touched:connect(damage)
wait(3)
script.Parent:remove()</ProtectedString>
