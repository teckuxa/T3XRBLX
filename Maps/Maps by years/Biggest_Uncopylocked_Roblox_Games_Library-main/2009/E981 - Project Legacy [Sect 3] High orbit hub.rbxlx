	<Item class="StarterPack" referent="RBX5851">
		<Properties>
			<string name="Name">StarterPack</string>
		</Properties>
		<Item class="LocalScript" referent="RBX5852">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">ChangeDist1</string>
				<ProtectedString name="Source">wait(3)
while true do
workspace.CurrentCamera.DistancePart1.BillboardGui.Dist.Text = &quot;[Dist]: &quot; .. math.ceil((script.Parent.Parent.Character.Torso.Position-workspace.CurrentCamera.DistancePart1.Position).magnitude) .. &quot;_KM&quot;
wait()
end </ProtectedString>
			</Properties>
		</Item>
		<Item class="LocalScript" referent="RBX5853">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">LocalScript1</string>
				<ProtectedString name="Source">wait(1)
if script.Parent.Name==&quot;Backpack&quot; then
g=workspace:GetChildren()
for i = 1, #g do
if g[i].Name == &quot;DistancePart1&quot; then
newc1=g[i]:clone()
newc1.Transparency=1
newc1.Parent = workspace.CurrentCamera
newc2=script.BillboardGui:clone()
newc2.Creator.Value=script.Parent.Parent.Name
newc2.Parent=newc1
newc2.Adornee=newc1
end
end
end </ProtectedString>
			</Properties>
			<Item class="BillboardGui" referent="RBX5854">
				<Properties>
					<bool name="Active">true</bool>
					<Ref name="Adornee">null</Ref>
					<bool name="AlwaysOnTop">true</bool>
					<bool name="Enabled">true</bool>
