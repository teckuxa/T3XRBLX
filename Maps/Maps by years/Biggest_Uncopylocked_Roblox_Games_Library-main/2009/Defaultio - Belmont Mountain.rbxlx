			<Item class="Script" referent="RBX1001">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">BadgeAwarderScript</string>
					<ProtectedString name="Source">function OnTouch(part)
if part.Parent ~= nil then
local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
if h~=nil then
torso=part.Parent:findFirstChild(&quot;Torso&quot;)
if torso~=nil then
local p = game.Players:GetPlayerFromCharacter(part.Parent)
if p ~= nil then
local teleportto=script.Parent.Top
local b = game:GetService(&quot;BadgeService&quot;)
if b:UserHasBadge(p.userId, script.Parent.BadgeID.Value) then
torso.CFrame = CFrame.new(Vector3.new(script.Parent.Top.Position.x,script.Parent.Top.Position.y+3,script.Parent.Top.Position.z), Vector3.new(0,script.Parent.Top.Position.y,0))
end
torso.Velocity=Vector3.new(0,140,0)
end
end
end
end
end
script.Parent.Bottom.Touched:connect(OnTouch)</ProtectedString>
