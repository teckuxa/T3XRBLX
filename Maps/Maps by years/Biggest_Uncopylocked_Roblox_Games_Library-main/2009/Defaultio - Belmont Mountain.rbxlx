						<string name="Name">Script</string>
						<ProtectedString name="Source">TrunkPos=script.Parent.Trunk.Position
TopPos=script.Parent.Top.Position
Trunk=script.Parent.Trunk:clone()
Top=script.Parent.Top:clone()
script.Parent.Top:remove()
script.Parent.Trunk:remove()
Top.CFrame = CFrame.fromEulerAnglesXYZ(0, math.random(0,6.28), 0)
Top.Mesh.Scale=Vector3.new(math.random(11,17),math.random(11,17),math.random(15,21))
Trunk.Mesh.Scale=Vector3.new(math.random(7,15)/10,1.5,math.random(7,15)/10)
Trunk.Position=Vector3.new(TrunkPos.x,TrunkPos.y,TrunkPos.z)
Top.Position=Vector3.new(TopPos.x,TopPos.y-(math.random(0,40)/10),TopPos.z)
Top.Parent=script.Parent
Trunk.Parent=script.Parent
C=math.random(1,4)
if C==2 then
Top.BrickColor=BrickColor.new(&quot;Dark green&quot;)
elseif C==3 then
Top.BrickColor=BrickColor.new(&quot;Bright green&quot;)
elseif C==4 then
Top.BrickColor=BrickColor.new(&quot;Camo&quot;)
end
C=math.random(1,4)
if C==2 then
Trunk.BrickColor=BrickColor.new(&quot;Nougat&quot;)
elseif C==3 then
Trunk.BrickColor=BrickColor.new(&quot;Dark orange&quot;)
elseif C==4 then
Trunk.BrickColor=BrickColor.new(&quot;CGA brown&quot;)
elseif C==5 then
Trunk.BrickColor=BrickColor.new(&quot;Reddish brown&quot;)
end
