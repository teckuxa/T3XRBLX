							<string name="Name">Script</string>
							<string name="Source">de = 0

function touch(hit)
if game.Players:playerFromCharacter(hit.Parent) == nil or de == 1 then return end
de = 1
script.Parent.CanCollide = false
wait(1)
script.Parent.CanCollide = true
de = 0
end

script.Parent.Touched:connect(touch)</string>
