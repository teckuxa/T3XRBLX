					<token name="FrontSurface">0</token>
					<token name="FrontSurfaceInput">0</token>
					<float name="LeftParamA">-0.5</float>
					<float name="LeftParamB">0.5</float>
					<token name="LeftSurface">0</token>
					<token name="LeftSurfaceInput">0</token>
					<bool name="Locked">false</bool>
					<token name="Material">256</token>
					<string name="Name">GiverBrick</string>
					<float name="Reflectance">0</float>
					<float name="RightParamA">-0.5</float>
					<float name="RightParamB">0.5</float>
					<token name="RightSurface">0</token>
					<token name="RightSurfaceInput">0</token>
					<Vector3 name="RotVelocity">
						<X>0</X>
						<Y>0</Y>
						<Z>0</Z>
					</Vector3>
					<float name="TopParamA">-0.5</float>
					<float name="TopParamB">0.5</float>
					<token name="TopSurface">0</token>
					<token name="TopSurfaceInput">0</token>
					<float name="Transparency">0</float>
					<Vector3 name="Velocity">
						<X>0</X>
						<Y>0</Y>
						<Z>0</Z>
					</Vector3>
					<bool name="archivable">true</bool>
					<token name="shape">1</token>
					<Vector3 name="size">
						<X>1</X>
						<Y>1.20000005</Y>
						<Z>5</Z>
					</Vector3>
				</Properties>
				<Item class="Script" referent="RBX2523">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">GiverScript</string>
						<string name="Source">toolNames = {&quot;NOGUEST&quot;}
toolstore = game.Lighting.Tools
payment = 5
cashtype = &quot;Points&quot;

actools = {}

for i = 1, #toolNames do
curtoolsa = toolstore:findFirstChild(toolNames[i])
if curtoolsa ~= nil then actools[#actools+1] = curtoolsa:Clone() end
end

function getPlayer(humanoid) 
local players = game.Players:children() 
for i = 1, #players do 
if players[i].Character.Humanoid == humanoid then return players[i] end 
end 
return nil 
end 

function pay(player)
if payment &lt;= 0 then return true end
local stats = player:findFirstChild(&quot;leaderstats&quot;)
if stats == nil then return false end
local cash = stats:findFirstChild(cashtype)
if cash == nil then return false end
if cash.Value &lt; payment then return false end
cash.Value = cash.Value - payment
return true
end

function chek(player)
for m = 1, #actools do
if (player.Backpack:findFirstChild(actools[m].Name) == nil and player.Character:findFirstChild(actools[m].Name) == nil) then
return true
end
end
return false
end

function onTouch(part) 
if part == nil then return end
if part.Parent == nil then return end
local human = part.Parent:findFirstChild(&quot;Humanoid&quot;) 
if human ~= nil then
local player = getPlayer(human) 
if (player == nil) then return end
if chek(player) == false then return end
if pay(player) ~= true then return end
for i = 1, #actools do
if (player.Backpack:findFirstChild(actools[i].Name) == nil and player.Character:findFirstChild(actools[i].Name) == nil) then 
actools[i]:Clone().Parent = player.Backpack
end
end
end
end


script.Parent.Touched:connect(onTouch) 
