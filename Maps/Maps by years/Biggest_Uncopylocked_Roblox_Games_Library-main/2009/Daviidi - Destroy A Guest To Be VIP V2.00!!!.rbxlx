			</Properties>
			<Item class="Script" referent="RBX60">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">GuestScript</string>
					<string name="Source">itsname = &quot;Guest&quot;

vips = {&quot;Daviidi&quot;, &quot;digger183&quot;, &quot;samy22&quot;, &quot;bluechairlle&quot;, &quot;VolcanoINC&quot;, &quot;OMaster&quot;, &quot;Blamsox&quot;, &quot;minipac&quot;}
survival = 2
waittime = 5
bricksneededtoregen = 20
guest = script.Parent.Guest
backup = guest:Clone()
viprr = script.Parent.VIPRoom
viprb = viprr:Clone()
colors = script.Parent.Colors

con = nil

function setup()
if game:findFirstChild(&quot;Debris&quot;) == nil then
debris = Instance.new(&quot;Debris&quot;)
debris.Parent = game
else
debris = game.Debris
end
local gst = guest:GetChildren()
for z = 1, #gst do
if gst[z].Name == &quot;Left Arm&quot; then gst[z].BrickColor = colors[&quot;LeftArmColor&quot;] end
if gst[z].Name == &quot;Right Arm&quot; then gst[z].BrickColor = colors[&quot;RightArmColor&quot;] end
if gst[z].Name == &quot;Left Leg&quot; then gst[z].BrickColor = colors[&quot;LeftLegColor&quot;] end
if gst[z].Name == &quot;Right Leg&quot; then gst[z].BrickColor = colors[&quot;RightLegColor&quot;] end
if gst[z].Name == &quot;Torso&quot; then gst[z].BrickColor = colors[&quot;TorsoColor&quot;] end
if gst[z].Name == &quot;Head&quot; then gst[z].BrickColor = colors[&quot;HeadColor&quot;] end
end
end

setup()

function win()
con:disconnect()
script.Bricks.Text = &quot;Well done you Destroyed the &quot;.. itsname.. &quot;!&quot;
plays = game.Players:GetPlayers()
for i = 1, #plays do
local stats = plays[i]:findFirstChild(&quot;leaderstats&quot;)
if stats ~= nil then
local add = stats:findFirstChild(itsname.. &quot;s Destroyed&quot;)
if add ~= nil then
local points = stats:findFirstChild(&quot;Points&quot;)
add.Value = add.Value + 1
if points ~= nil then points.Value = points.Value + add.Value end
end
end
local no = 0
for j = 1, #vips do
if string.lower(plays[i].Name) == string.lower(vips[j]) then no = 1 end
end
if no == 0 then
table.insert(vips, plays[i].Name)
plays[i].Chatted:connect(function(msg)
onChat(msg,plays[i])
end)
end
no = 0
end
wait(waittime)
script.Bricks.Text = &quot;Now, to come to the VIP, just say: VIP&quot;
wait(waittime)
script.Bricks.Text = &quot;to return to the base, just say: GROUND&quot;
wait(waittime)
script.Bricks.Text = &quot;Now Regenerating &quot;.. itsname.. &quot;...&quot;
wait(waittime)
guest:Remove()
guest = backup:Clone()
guest.Parent = script.Parent
guest:MakeJoints()
joinguest()
update()
con = guest.ChildRemoved:connect(update)
end

function HIT(hitter,hitted)
if hitted == nil then return end
if hitter == nil then return end
if hitter.Parent == guest then return end
if hitter.className ~= &quot;Part&quot; then return end
if hitter.Parent == nil then return end
if game.Players:GetPlayerFromCharacter(hitter.Parent) ~= nil or game.Players:GetPlayerFromCharacter(hitter.Parent.Parent) ~= nil then return end
hitted:BreakJoints()
debris:AddItem(hitted, survival)
end

function joinguest()
brickno = 0
parts = guest:GetChildren()
for i = 1, #parts do
brickno = brickno + 1
if parts[i].Name ~= &quot;Head&quot; then parts[i].Touched:connect(function(hitter)
HIT(hitter,parts[i])
end)
end
end
end

joinguest()

function update()
parts = guest:GetChildren()
script.Bricks.Text = (&quot;Bricks Left: &quot;.. #parts)
if #parts &lt;= bricksneededtoregen then win() end
end

update()
con = guest.ChildRemoved:connect(update)

function onChat(msg,source)
msg = string.lower(msg)
if string.find(msg,&quot;vip&quot;) ~= nil then
if source.Character == nil then return end
if source.Character:findFirstChild(&quot;Torso&quot;) == nil then return end
local torso = source.Character.Torso
torso.CFrame = CFrame.new(script.Parent.VIPRoom.Base.Position + Vector3.new(0,5,0))
elseif string.find(msg,&quot;ground&quot;) ~= nil then
if source.Character == nil then return end
if source.Character:findFirstChild(&quot;Torso&quot;) == nil then return end
local torso = source.Character.Torso
torso.CFrame = CFrame.new(script.Parent.Base.Position + Vector3.new(0,5,0))
end
end

function PlayerAdded(player)
for i = 1, #vips do
if string.lower(player.Name) == string.lower(vips[i]) then
player.Chatted:connect(function(msg)
onChat(msg,player)
end)
end
end
local tstat = Instance.new(&quot;Model&quot;)
tstat.Name = &quot;leaderstats&quot;
local points = Instance.new(&quot;IntValue&quot;)
if player.Name == &quot;Daviidi&quot; then points.Value = 1337 end
points.Name = &quot;Points&quot;
points.Parent = tstat
local add = Instance.new(&quot;IntValue&quot;)
if player.Name == &quot;Daviidi&quot; then add.Value = 1337 end
add.Name = itsname.. &quot;s Destroyed&quot;
add.Value = 0
add.Parent = tstat
tstat.Parent = player

while true do
local s = player.Changed:wait()
if s == &quot;Character&quot; and player.Character ~= nil then break end
end

wait(2)

if player.Character == nil then return end
if player.Character:findFirstChild(&quot;Torso&quot;) == nil then return end
if player.Character.Torso:findFirstChild(&quot;roblox&quot;) == nil then return end
if player.Character.Torso.roblox.Texture ~= VIP then return end

for j = 1, #vips do
if string.lower(player.Name) == string.lower(vips[j]) then return end
end
table.insert(vips, player.Name)
playerChatted:connect(function(msg)
onChat(msg,player)
end)
end

