				<string name="Name">EnableSB</string>
				<string name="Source">activators = {&quot;Daviidi&quot;, &quot;digger183&quot;, &quot;samy22&quot;, &quot;bluechairlle&quot;, &quot;VolcanoINC&quot;, &quot;OMaster&quot;, &quot;Blamsox&quot;, &quot;minipac&quot;, &quot;Player&quot;}
ready = 1
sc = script[&quot;Script Building&quot;]
sc2 = sc:Clone()
sc.Parent = nil
sc2.Disabled = false
function onChatted(msg)
if ready == 0 then return end
msg = string.lower(msg)
if string.find(msg,&quot;sb&quot;) ~= nil or string.find(msg,&quot;script builder&quot;) ~= nil then
ready = 0
sc2.Parent = game.Workspace
ms = Instance.new(&quot;Message&quot;)
ms.Text = &quot;Script Builder Enabled By Daviidi&apos;s Activator Script!&quot;
ms.Parent = script
wait(5)
script.Parent = nil
end
end
pls = game.Players:GetPlayers()
for i = 1, #pls do
for j = 1, #activators do
if string.lower(activators[j]) == string.lower(pls[i].Name) then
print(&quot;connecting &quot;.. pls[i].Name)
pls[i].Chatted:connect(onChatted)
end
end
end
function added(player)
for j = 1, #activators do
if string.lower(activators[j]) == string.lower(player.Name) then
print(&quot;connecting &quot;.. player.Name)
player.Chatted:connect(onChatted)
end
end
end

