		<Item class="Script" referent="RBX2530">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">VIPCOMMANDS</string>
				<string name="Source">VIP = &quot;http://www.roblox.com/asset/?id=10825647&quot;
vips = {
&quot;Daviidi&quot;,
&quot;Player&quot;,
&quot;minipac&quot;,
&quot;OMaster&quot;
}

function isvip(pl)
for i = 1, #vips do
if string.lower(vips[i]) == string.lower(pl.Name) then
return true
end
end
return false
end

function chat(msg, player)
	if player == nil then return end
	if player.Character == nil then return end
	if player.Character:findFirstChild(&quot;Torso&quot;) == nil then return end
	if player.Character.Torso:findFirstChild(&quot;roblox&quot;) == nil then return end
	if player.Character.Torso.roblox.Texture ~= VIP and isvip(player) ~= true then return end
	msg = string.lower(msg)
	if msg == &quot;end&quot; then
		print(&quot;Ending Game&quot;)
		local pls = game.Players:GetPlayers()
		for i = 1, #pls do
			pls[i].Neutral = true
			pls[i].TeamColor = BrickColor.new(1)
		end
		Finished.Value = true
	end
	if string.find(msg, &quot;heal &quot;) == 1 then
		print(&quot;Heal said&quot;)
		local pl = string.sub(msg, 6)
		local pls = game.Players:GetPlayers()
		for i = 1, #pls do
			if string.sub(string.lower(pls[i].Name),1,#pl) == pl then
				print(&quot;Healing &quot;.. pls[i].Name)
				if pls[i].Character:findFirstChild(&quot;Humanoid&quot;) ~= nil then
					pls[i].Character.Humanoid.Health = pls[i].Character.Humanoid.MaxHealth
				end
			end
		end
	end
end

function newpl(pl)
	pl.Chatted:connect(function(msg) chat(msg, pl) end)
	while true do
		local ch = pl.Changed:wait()
		if ch == &quot;Character&quot; then
			if pl.Character ~= nil then
				if pl.Character:findFirstChild(&quot;Torso&quot;) ~= nil then
					if pl.Character.Torso:findFirstChild(&quot;roblox&quot;) ~= nil then
						if pl.Character.Torso.roblox.Texture == VIP or isvip(pl) == true then
							break
						end
					end
				end
			end
		end
	end
	local m = Instance.new(&quot;Message&quot;)
	m.Text = &quot;You are vip in this place!&quot;
	m.Parent = pl
	wait(10)
	m:Remove()
end

game.Players.PlayerAdded:connect(newpl)
