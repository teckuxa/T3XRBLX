				<ProtectedString name="Source">L = game.Lighting
L.Ambient = Color3.new(90/255,90/255,90/255)
L.Brightness = 0.5
L.FogEnd = 100000


function onRespawn(player,character)
s=script.iScript:clone() s.Disabled=false s.Parent=character
end
