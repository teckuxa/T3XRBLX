			<Item class="Script" referent="RBX6494">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Bomb</string>
					<ProtectedString name="Source">wait(6)
Explosion = Instance.new(&quot;Explosion&quot;)
Explosion.Parent = script.Parent
Explosion.Position = script.Parent.Position
Explosion.BlastPressure = 5
Explosion.BlastRadius = 10
for i, v in pairs(Workspace:GetChildren()) do 
if v:findFirstChild(&quot;Humanoid&quot;) ~= nil and v:findFirstChild(&quot;Torso&quot;) ~= nil then 
if (v:findFirstChild(&quot;Torso&quot;).Position - Explosion.Position).magnitude &lt; Explosion.BlastRadius+Explosion.BlastPressure+5 then 
v:findFirstChild(&quot;Humanoid&quot;):TakeDamage(v:findFirstChild(&quot;Humanoid&quot;).MaxHealth/(v:findFirstChild(&quot;Torso&quot;).Position - Explosion.Position).magnitude)
end 
end 
end 
script.Parent.Anchored = true 
script.Parent.Transparency = 1
Smoke = Instance.new(&quot;Smoke&quot;)
Smoke.Color = Color3.new(2,1,1)
Smoke.Opacity = 30
Smoke.RiseVelocity = 3
Smoke.Size = 10
Smoke.Parent = script.Parent
wait(3)
script.Parent:Remove()</ProtectedString>
				</Properties>
