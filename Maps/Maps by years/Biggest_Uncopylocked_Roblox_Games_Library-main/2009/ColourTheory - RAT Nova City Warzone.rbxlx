M2.Name = &quot;Fog&quot;
M2.Parent = C
for f=1,10 do
P = Instance.new(&quot;Part&quot;)
P.Size = Vector3.new(1,1,1)
P.CanCollide = false
P.Parent = M2
P.BrickColor = BrickColor.new(&quot;Light stone grey&quot;)
P.Anchored = true
Me = Instance.new(&quot;SpecialMesh&quot;)
Me.MeshId = &quot;http://www.roblox.com/asset/?id=1185246&quot;
Me.Parent = P
Me.Scale = Vector3.new(-750*f,-750*f,-750*f)
if f == 10 then
P.Transparency = 0.55
else
P.Transparency = 0.90
end
P.CFrame = CFrame.new(C.CoordinateFrame.p)
end

S = game.Lighting.SnowSounds:clone()
S.Parent = C
S.Sound1:play()
wait(1)
S.Sound2:play()
wait(1)
S.Sound3:play()
wait(1)
S.Sound4:play()

while true do
wait()
F = M2:getChildren()
for f=1,#F do
F[f].CFrame = CFrame.new(C.CoordinateFrame.p)
end
end

end


