			<Item class="Script" referent="RBX10">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Countdown</string>
					<string name="Source">countdown = 30

while true do
	wait(30)
		hintchoice = math.random(1,6)
		if hintchoice &lt; 3 then
			msg = Instance.new(&quot;Hint&quot;)
			msg.Text = &quot;Win the game by reaching 5000 worth, or forcing someone to go bankrupt&quot;
			msg.Parent = game.Workspace
			wait(5)
			msg:Remove()
		end


		if hintchoice &gt; 2 and hintchoice &lt; 5 then
			msg = Instance.new(&quot;Hint&quot;)
			msg.Text = &quot;Get better weapons by increasing your Monopoly worth!&quot;
			msg.Parent = game.Workspace
			wait(5)
			msg:Remove()
		end

		if hintchoice &gt; 4 then
			msg = Instance.new(&quot;Hint&quot;)
			msg.Text = &quot;Players start the game with 3 properties, everyone starts with 1500 worth&quot;
			msg.Parent = game.Workspace
			wait(5)
			msg:Remove()
		end

	wait(25)

	countdown = countdown - 1

	if countdown &gt; 1 then
		msg = Instance.new(&quot;Hint&quot;)
		msg.Text = &quot;Game ends in &quot; .. countdown .. &quot; minutes, highest worth wins&quot;
		msg.Parent = game.Workspace
		wait(5)
		msg:Remove()
	end
	if countdown == 0 then

		msg = Instance.new(&quot;Message&quot;)
		msg.Text = &quot;Time is UP!&quot;
		msg.Parent = game.Workspace
		wait(4)
		msg:Remove()
		
		players = game.Players:GetChildren()
		highest = 0
		winner = &quot;&quot;
		for i = 1, #players do
			worthobject = game.Players:FindFirstChild(players[i].Name):FindFirstChild(&quot;leaderstats&quot;):FindFirstChild(&quot;Worth&quot;)
			if worthobject.Value &gt; highest then
				highest = worthobject.Value
				winner = players[i].Name
			end
		end

		msg = Instance.new(&quot;Message&quot;)
		msg.Text = &quot;Winner is &quot; .. winner .. &quot; with a worth of $&quot; .. highest
		msg.Parent = game.Workspace
		wait(10)
		msg:Remove()

		msg = Instance.new(&quot;Message&quot;)
		msg.Text = &quot;Game will reset in 30 seconds&quot;
		msg.Parent = game.Workspace
		wait(30)
		msg:Remove()
		
		objects = game.Workspace:GetChildren()
		for i = 1, #objects do
			if objects[i]:FindFirstChild(&quot;Humanoid&quot;) == nil then
				if objects[i].className == &quot;Part&quot; or objects[i].className == &quot;Model&quot; then
					objects[i]:Remove()
				end
			end
		end

		
		boardcopy = game.Lighting:FindFirstChild(&quot;Gameboard&quot;):Clone()
		boardcopy.Parent = game.Workspace
		boardcopy:MakeJoints()

		braincopy = game.Lighting:FindFirstChild(&quot;brainbrick&quot;):Clone()
		braincopy.Parent = game.Workspace

		while game.Workspace:FindFirstChild(&quot;Message&quot;) ~= nil do
			game.Workspace:FindFirstChild(&quot;Message&quot;):Remove()
		end
		
		break
	end

end
