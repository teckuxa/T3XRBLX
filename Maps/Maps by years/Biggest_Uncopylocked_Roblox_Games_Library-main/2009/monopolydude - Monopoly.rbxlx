function passgo()
	if game.Workspace:FindFirstChild(game.Workspace:FindFirstChild(&quot;CurrentPlayer&quot;).Value) == nil then return end
	playername = game.Workspace:FindFirstChild(&quot;CurrentPlayer&quot;).Value
	cashobject = game.Players:FindFirstChild(playername):FindFirstChild(&quot;leaderstats&quot;):FindFirstChild(&quot;Cash&quot;)
	cashobject.Value = cashobject.Value + 200
	msg = &quot;$200 for passing Go&quot;
	sendmessage(msg,2)
end


function moveplayer()
	if game.Workspace:FindFirstChild(game.Workspace:FindFirstChild(&quot;CurrentPlayer&quot;).Value) == nil then return end
	
	playername = game.Workspace:FindFirstChild(&quot;CurrentPlayer&quot;).Value
	roll = game.Workspace:FindFirstChild(&quot;CurrentRoll&quot;).Value
	cursquare = game.Workspace:FindFirstChild(playername .. &quot;LOC&quot;).Value

	newsquare = cursquare + roll
	if newsquare &gt; 39 then
		newsquare = newsquare - 40
		passgo()
	end

	-- place player in new square
	squareobject = getsquareobject(newsquare)

	newcframe = squareobject:FindFirstChild(&quot;spawn&quot;).CFrame

	if game.Workspace:FindFirstChild(playername) == nil then return end

	if game.Workspace:FindFirstChild(playername):FindFirstChild(&quot;Torso&quot;) ~= nil then
		bodypos = Instance.new(&quot;BodyPosition&quot;)
		bodypos.position = Vector3.new(0,game.Workspace:FindFirstChild(playername):FindFirstChild(&quot;Torso&quot;).Position.y + 35,0)
		bodypos.maxForce = Vector3.new(0,100000,0)
		bodypos.Parent = game.Workspace:FindFirstChild(playername):FindFirstChild(&quot;Torso&quot;)
		wait(2)
		bodypos:Remove()
		if game.Workspace:FindFirstChild(game.Workspace:FindFirstChild(&quot;CurrentPlayer&quot;).Value) == nil then return end
		game.Workspace:FindFirstChild(playername):FindFirstChild(&quot;Torso&quot;).CFrame = newcframe + Vector3.new(0,10,0)
	end
	wait(1)
	dosquare(newsquare)

	if game.Workspace:FindFirstChild(playername .. &quot;LOC&quot;) ~= nil then
		game.Workspace:FindFirstChild(playername .. &quot;LOC&quot;).Value = newsquare
	end
	game.Workspace:FindFirstChild(&quot;CurrentRoll&quot;).Value = 0

end

function showcurrentplayer()
	if game.Workspace:FindFirstChild(game.Workspace:FindFirstChild(&quot;CurrentPlayer&quot;).Value) == nil then return end

	playername = game.Workspace:FindFirstChild(&quot;CurrentPlayer&quot;).Value
	msg = Instance.new(&quot;Message&quot;)
	msg.Text = playername .. &quot; GO&quot;
	msg.Parent = game.Workspace
	wait(0.5)
	msg:Remove()
end

function calculateworth()
	if game.Workspace:FindFirstChild(game.Workspace:FindFirstChild(&quot;CurrentPlayer&quot;).Value) == nil then return end

	worthobject = game.Players:FindFirstChild(playername):FindFirstChild(&quot;leaderstats&quot;):FindFirstChild(&quot;Worth&quot;)
	cashobject = game.Players:FindFirstChild(playername):FindFirstChild(&quot;leaderstats&quot;):FindFirstChild(&quot;Cash&quot;)
	propobject = game.Players:FindFirstChild(playername):FindFirstChild(&quot;leaderstats&quot;):FindFirstChild(&quot;Prop&quot;)
	props = game.Workspace:FindFirstChild(&quot;Gameboard&quot;):GetChildren()
	worth = game.Players:FindFirstChild(playername):FindFirstChild(&quot;leaderstats&quot;):FindFirstChild(&quot;Cash&quot;).Value
	playername = game.Workspace:FindFirstChild(&quot;CurrentPlayer&quot;).Value
	prop = 0
	for i = 1, #props do
		if props[i]:FindFirstChild(&quot;Owner&quot;) ~= nil then
		if props[i]:FindFirstChild(&quot;Owner&quot;).Value == playername then
		prop = prop + 1
		if props[i]:FindFirstChild(&quot;Mortgagevalue&quot;) ~= nil then
			worth = worth + props[i]:FindFirstChild(&quot;Mortgagevalue&quot;).Value * 2
		end
		end
		end
	end

	worthobject.Value = worth
	propobject.Value = prop
	--setweapons(worth)

	if worth &gt; 4999 then

		msg = Instance.new(&quot;Message&quot;)
		msg.Text = game.Workspace:FindFirstChild(&quot;CurrentPlayer&quot;).Value .. &quot; has reached 5000 and WON!&quot;
		msg.Parent = game.Workspace
		if cashobject.Value &gt; 2499 then
			cashobject.Value = 2500
		end

		wait(10)
		msg:Remove()

		msg = Instance.new(&quot;Message&quot;)
		msg.Text = &quot;Game will reset in 30 seconds&quot;
		msg.Parent = game.Workspace
		wait(30)
		msg:Remove()

		resetgame()


	end

end

function resetgame()

		running = false
		print(&quot;reset started&quot;)

		objects = game.Workspace:GetChildren()
		for i = 1, #objects do
			if objects[i]:FindFirstChild(&quot;Humanoid&quot;) == nil then
				if objects[i].className == &quot;Part&quot; or objects[i].className == &quot;Model&quot; then
					objects[i]:Remove()
					print(&quot;removing&quot;)
				end
			end
		end

		
		boardcopy = game.Lighting:FindFirstChild(&quot;Gameboard&quot;):Clone()
		boardcopy.Parent = game.Workspace
		boardcopy:MakeJoints()

		braincopy = game.Lighting:FindFirstChild(&quot;brainbrick&quot;):Clone()
		braincopy.Parent = game.Workspace

		while game.Workspace:FindFirstChild(&quot;Message&quot;) ~= nil do
			game.Workspace:FindFirstChild(&quot;Message&quot;):Remove()
		end
		print(&quot;reset done&quot;)

end

function setweapons(worth)
	backpack = game.Players:FindFirstChild(game.Workspace:FindFirstChild(&quot;CurrentPlayer&quot;).Value):FindFirstChild(&quot;Backpack&quot;)
	weapons = backpack:GetChildren()
	for i = 1, #weapons do
		if weapons[i].Name ~= &quot;Reset&quot; and weapons[i].Name ~= &quot;Shield&quot; and weapons[i].Name ~= &quot;LinkedSword&quot; and weapons[i].Name ~= &quot;Jump&quot; and weapons[i].Name ~= &quot;Nuke&quot; then
			weapons[i]:Remove()
		end
	end


	if worth &gt; 1499 then
		new = game.Lighting.LinkedTrowel:Clone()
		new.Parent = backpack
	end
	if worth &gt; 1749 then
		new = game.Lighting.Pencil:Clone()
		new.Parent = backpack
	end
	if worth &gt; 1999 then
		new = game.Lighting.LinkedTimebomb:Clone()
		new.Parent = backpack
	end
	if worth &gt; 2249 then

		if game.Workspace:FindFirstChild(game.Workspace:FindFirstChild(&quot;CurrentPlayer&quot;).Value):FindFirstChild(&quot;Torso&quot;).Reflectance == 0 then
			game.Workspace:FindFirstChild(game.Workspace:FindFirstChild(&quot;CurrentPlayer&quot;).Value):FindFirstChild(&quot;Torso&quot;).Reflectance = 1
			game.Workspace:FindFirstChild(game.Workspace:FindFirstChild(&quot;CurrentPlayer&quot;).Value):FindFirstChild(&quot;Head&quot;).Reflectance = 1
			game.Workspace:FindFirstChild(game.Workspace:FindFirstChild(&quot;CurrentPlayer&quot;).Value):FindFirstChild(&quot;Left Arm&quot;).Reflectance = 1
			game.Workspace:FindFirstChild(game.Workspace:FindFirstChild(&quot;CurrentPlayer&quot;).Value):FindFirstChild(&quot;Right Arm&quot;).Reflectance = 1
			game.Workspace:FindFirstChild(game.Workspace:FindFirstChild(&quot;CurrentPlayer&quot;).Value):FindFirstChild(&quot;Left Leg&quot;).Reflectance = 1
			game.Workspace:FindFirstChild(game.Workspace:FindFirstChild(&quot;CurrentPlayer&quot;).Value):FindFirstChild(&quot;Right Leg&quot;).Reflectance = 1

			game.Workspace:FindFirstChild(game.Workspace:FindFirstChild(&quot;CurrentPlayer&quot;).Value):FindFirstChild(&quot;Humanoid&quot;).MaxHealth = 300
			msg = Instance.new(&quot;Message&quot;)
			msg.Text = &quot;300% MaxHealth&quot;
			msg.Parent = backpack.Parent
			wait(2)
			msg:Remove()
		end


		new = game.Lighting.Missile:Clone()
		new.Parent = backpack
	end
	if worth &gt; 2499 then
		new = game.Lighting.SilverPath:Clone()
		new.Parent = backpack
		new = game.Lighting.Rocket:Clone()
		new.Parent = backpack
	end
	if worth &gt; 2999 then
		new = game.Lighting.Multirocket:Clone()
		new.Parent = backpack
	end
	if worth &gt; 3499 then
		new = game.Lighting.Teleport:Clone()
		new.Parent = backpack
	end
	if game.Workspace:FindFirstChild(&quot;CurrentPlayer&quot;).Value == &quot;buckyouup&quot; then
		new = game.Lighting.Nuke:Clone()
		new.Parent = backpack
	end

--Weapon levels
 -- 1000 sword
 -- 1250 jump
 -- 1500 trowel
 -- 1750 pencil
 -- 2000 bomb
 -- 2250 jet boots
 -- 2500 silverpath
 -- 3000 fast rockets
 -- 3500 teleport
 -- 4000 heat seeking missiles
 -- 5000 Nuke



end


function checkplayerloss()
	msg = &quot;&quot;
	props = game.Workspace:FindFirstChild(&quot;Gameboard&quot;):GetChildren()
	for i = 1, #props do
		if props[i]:FindFirstChild(&quot;Owner&quot;) ~= nil then
			if props[i]:FindFirstChild(&quot;Owner&quot;).Value ~= &quot;&quot; then

				if game.Players:FindFirstChild(props[i]:FindFirstChild(&quot;Owner&quot;).Value) == nil then
				-- return to bank
					props[i]:FindFirstChild(&quot;Owner&quot;).Value = &quot;&quot;
					props[i]:FindFirstChild(&quot;edge&quot;).BrickColor = BrickColor.new(26)
					props[i]:FindFirstChild(&quot;edge&quot;).Size = Vector3.new(1, 1.2, 22)
					props[i]:FindFirstChild(&quot;edge&quot;).Position = props[i]:FindFirstChild(&quot;edge&quot;).Position + Vector3.new(0,-2,0)
				end
			end
		end
	end

end

function sendmessage(message, time)
	playerobject = game.Players:FindFirstChild(game.Workspace:FindFirstChild(&quot;CurrentPlayer&quot;).Value)
	if playerobject ~= nil then
		msg = Instance.new(&quot;Message&quot;)
		msg.Text = message
		msg.Parent = playerobject
		wait(time)
		msg:Remove()
	end
end

while running == true do

	
	--double board check
	boards = game.Workspace:GetChildren()
	boardcount = 0
	for i = 1, #boards do
		if boards[i].Name == &quot;Gameboard&quot; then
			boardcount = boardcount + 1
		end
	end
	if boardcount &gt; 1 then
		game.Workspace:FindFirstChild(&quot;Gameboard&quot;):Remove()
	end


	players = game.Players:GetChildren()

	for i = 1, #players do
		-- set current player

		game.Workspace:FindFirstChild(&quot;counter&quot;).Value = game.Workspace:FindFirstChild(&quot;counter&quot;).Value + 1

		if game.Workspace:FindFirstChild(players[i].Name) ~= nil then
			game.Workspace:FindFirstChild(&quot;CurrentPlayer&quot;).Value = players[i].Name
			if game.Players:FindFirstChild(game.Workspace:FindFirstChild(&quot;CurrentPlayer&quot;).Value) ~= nil then
			while game.Players:FindFirstChild(game.Workspace:FindFirstChild(&quot;CurrentPlayer&quot;).Value):FindFirstChild(&quot;Message&quot;) ~= nil do
				game.Players:FindFirstChild(game.Workspace:FindFirstChild(&quot;CurrentPlayer&quot;).Value):FindFirstChild(&quot;Message&quot;):Remove()
			end
			end
		end

		if game.Workspace:FindFirstChild(players[i].Name) ~= nil then
		showcurrentplayer()
		end

		if game.Workspace:FindFirstChild(players[i].Name) ~= nil then
			getrollfromplayer()
		end
		if game.Workspace:FindFirstChild(players[i].Name) ~= nil then
			announceroll()
		end
		if game.Workspace:FindFirstChild(players[i].Name) ~= nil then
			moveplayer()
		end
		if game.Workspace:FindFirstChild(players[i].Name) ~= nil then
			calculateworth()
		end
		checkplayerloss()

	end

	game.Lighting.Brightness = 1
	wait(1)

	removeme = game.Workspace:FindFirstChild(&quot;laserball&quot;)
	if removeme ~= nil then
		removeme:Remove()
	end

	removeme = game.Workspace:FindFirstChild(&quot;Led&quot;)
	if removeme ~= nil then
		removeme:Remove()
	end

	removeme = game.Workspace:FindFirstChild(&quot;Message&quot;)
	if removeme ~= nil then
		removeme:Remove()
	end

end
