					<string name="Name">Script</string>
					<string name="Source">wait(30)

bad = false

local lastcount
lastcount = 0

print(&quot;Brain keepalive loaded&quot;)

while true do
	if game.Workspace:FindFirstChild(&quot;counter&quot;).Value == lastcount then
		if bad == true then
			while game.Workspace:FindFirstChild(&quot;brainbrick&quot;) ~= nil do
				game.Workspace:FindFirstChild(&quot;brainbrick&quot;):Remove()
			end
			braincopy = game.Lighting:FindFirstChild(&quot;brainbrick&quot;):Clone()
			braincopy.Parent = game.Workspace
			break
		end
		bad = true
	end
	if game.Workspace:FindFirstChild(&quot;counter&quot;).Value &gt; lastcount then
		lastcount = game.Workspace:FindFirstChild(&quot;counter&quot;).Value
		bad = false
	end

	wait(30)
end
