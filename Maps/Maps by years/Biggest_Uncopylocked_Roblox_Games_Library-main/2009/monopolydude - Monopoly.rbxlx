				<Item class="Script" referent="RBX2450">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<string name="Source">--prevent spawning into them for the touch

function ontouch(part)

	if part.Parent.Name ~= game.Workspace:FindFirstChild(&quot;CurrentPlayer&quot;).Value then return end

	roll = math.random(1,6) + math.random(1,6)
	game.Workspace:FindFirstChild(&quot;CurrentRoll&quot;).Value = roll
	part.Parent.Parent:Remove()
	-- flash until removed

end

script.Parent.Touched:connect(ontouch)
</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
