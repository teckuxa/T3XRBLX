			<Item class="Script" referent="RBX5985">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Game Engine</string>
					<string name="Source">-- begin game loop
running = true

wait(20)

function getrollfromplayer()

	if game.Workspace:FindFirstChild(game.Workspace:FindFirstChild(&quot;CurrentPlayer&quot;).Value) == nil then return end

	playername = game.Workspace:FindFirstChild(&quot;CurrentPlayer&quot;).Value
	print(playername .. &quot; get roll&quot;)
	body = game.Workspace:FindFirstChild(playername):FindFirstChild(&quot;Torso&quot;)
	currentrollobject = game.Workspace:FindFirstChild(&quot;CurrentRoll&quot;)

	-- dice removed!!
	currentrollobject.Value = math.random(1,6) + math.random(1,6)

	--return

	if body ~= nil then
		squish = game.Lighting.squisher:Clone()
		squish.Parent = game.Workspace
		squish:MoveTo(body.Position + Vector3.new(math.random(-50,50),60,math.random(-50,50)))
		squish2 = game.Lighting.squisher:Clone()
		squish2.Parent = game.Workspace
		squish2:MoveTo(body.Position + Vector3.new(math.random(-50,50),60,math.random(-50,50)))

		--roller = game.Lighting.roller:Clone()
		--roller.Parent = game.Workspace
		--roller:MoveTo(body.Position + Vector3.new(6,-3,0))
		--roller:MakeJoints()
	end

	rolled = false
	waitmax = 20 -- 10 second wait or autoroll
	waitcount = 0
	while rolled == false do
		wait(.5)

		if game.Workspace:FindFirstChild(game.Workspace:FindFirstChild(&quot;CurrentPlayer&quot;).Value) == nil then
			--roller:Remove()
			return
		end

		if game.Workspace:FindFirstChild(&quot;CurrentRoll&quot;).Value &gt; 0 then
			print(&quot;we have a roll!&quot;)
			rolled = true
			--roller:Remove()
			break
		end

		waitcount = waitcount + 1
		if waitcount &gt; waitmax then
			print(&quot;we have auto roll!&quot;)
			currentrollobject.Value = math.random(1,6) + math.random(1,6)

			msg = Instance.new(&quot;Message&quot;)
			msg.Text = playername .. &quot; did not roll, rolling for them&quot;
			msg.Parent = game.Workspace
			wait(1)
			msg:Remove()

			rolled = true
			--roller:Remove()
			break
		end

	end
end

function announceroll()
	if game.Workspace:FindFirstChild(game.Workspace:FindFirstChild(&quot;CurrentPlayer&quot;).Value) == nil then return end

	playername = game.Workspace:FindFirstChild(&quot;CurrentPlayer&quot;).Value
	currentrollobject = game.Workspace:FindFirstChild(&quot;CurrentRoll&quot;)

	msg = &quot;You rolled &quot; .. currentrollobject.Value
	sendmessage(msg,2)

end

function getsquareobject(squareindex)
	squares = game.Workspace:FindFirstChild(&quot;Gameboard&quot;):GetChildren()
	for i = 1, #squares do
		if squares[i]:FindFirstChild(&quot;Boardindex&quot;) ~= nil then
			if squares[i]:FindFirstChild(&quot;Boardindex&quot;).Value == squareindex then
				return squares[i]
			end
		end
	end
end

function auctionsquare(square)
end

function playerpays(amount)

	if game.Workspace:FindFirstChild(game.Workspace:FindFirstChild(&quot;CurrentPlayer&quot;).Value) == nil then return end

	playername = game.Workspace:FindFirstChild(&quot;CurrentPlayer&quot;).Value
	cashobject = game.Players:FindFirstChild(playername):FindFirstChild(&quot;leaderstats&quot;):FindFirstChild(&quot;Cash&quot;)
	if cashobject.Value &gt; amount or cashobject.Value == amount then
		--go ahead with the transaction
		cashobject.Value = cashobject.Value - amount
		return true
	end
	if cashobject.Value &lt; amount then
		return false
	end
end

function choosetobuy(square)
	if game.Workspace:FindFirstChild(game.Workspace:FindFirstChild(&quot;CurrentPlayer&quot;).Value) == nil then return end

	playername = game.Workspace:FindFirstChild(&quot;CurrentPlayer&quot;).Value
	body = game.Workspace:FindFirstChild(playername):FindFirstChild(&quot;Torso&quot;)
	
	if body ~= nil then
		buychoice = game.Lighting.buychoice:Clone()
		buychoice.Parent = game.Workspace
		buychoice:MoveTo(body.Position + Vector3.new(5,-3,0))
		buychoice:MakeJoints()
	end

	chosen = false
	waitmax = 6 -- 10 second wait or autoroll
	waitcount = 0
	while chosen == false do
		wait(1)

		if game.Workspace:FindFirstChild(game.Workspace:FindFirstChild(&quot;CurrentPlayer&quot;).Value) == nil then
			buychoice:Remove()
			return
		end

		if game.Workspace:FindFirstChild(&quot;BuyChoice&quot;).Value ~= &quot;&quot; then
			-- player chose
			buychoice:Remove()
			if game.Workspace:FindFirstChild(&quot;BuyChoice&quot;).Value == &quot;Auction&quot; then
				game.Workspace:FindFirstChild(&quot;BuyChoice&quot;).Value = &quot;&quot;
				auctionsquare(square)
				return
			end

			if game.Workspace:FindFirstChild(&quot;BuyChoice&quot;).Value == &quot;Buy&quot; then
				game.Workspace:FindFirstChild(&quot;BuyChoice&quot;).Value = &quot;&quot;
				result = playerpays(square:FindFirstChild(&quot;Mortgagevalue&quot;).Value * 2) 
				if result == true then
					square:FindFirstChild(&quot;Owner&quot;).Value = playername
					square:FindFirstChild(&quot;edge&quot;).BrickColor = body.BrickColor
					square:FindFirstChild(&quot;edge&quot;).Size = square:FindFirstChild(&quot;edge&quot;).Size + Vector3.new(1,2,-1)
					return
				end
				if result == false then
					auctionsquare(square)
					return
				end

			end
		end
		waitcount = waitcount + 1
		if waitcount &gt; waitmax then
			--default to auction
			chosen = true
			buychoice:Remove()
			auctionsquare(square)
			return
		end
	end

end

