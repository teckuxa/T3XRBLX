					<string name="Source">local Tool = script.Parent; 

enabled = true 
function onButton1Down(mouse) 
if not enabled then 
return 
end 

enabled = false 
mouse.Icon = &quot;http://www.roblox.com/asset/?id=2966012&quot; 
script.Parent.Handle1.Transparency = 1 
script.Parent.Handle2.Transparency = 1 
script.Parent.Handle3.Transparency = 1 
script.Parent.Handle4.Transparency = 1 
script.Parent.Handle5.Transparency = 1 
script.Parent.Handle6.Transparency = 1 

wait(5) 
script.Parent.Handle1.Transparency = 0
script.Parent.Handle2.Transparency = 0
script.Parent.Handle3.Transparency = 0
script.Parent.Handle4.Transparency = 0
script.Parent.Handle5.Transparency = 0
script.Parent.Handle6.Transparency = 0


wait(0) 
mouse.Icon = &quot;http://www.roblox.com/asset/?id=2966012&quot; 
enabled = true 

end 

function onEquippedLocal(mouse) 

if mouse == nil then 
print(&quot;Mouse not found&quot;) 
return 
end 

mouse.Icon = &quot;http://www.roblox.com/asset/?id=2966012&quot; 
mouse.Button1Down:connect(function() onButton1Down(mouse) end) 
end 



Tool.Equipped:connect(onEquippedLocal)</string>
