end

function calculaterent(square)
	baserent = square:FindFirstChild(&quot;Rent&quot;).Value
	--if square:FindFirstChild(&quot;Housecount&quot;).Value &gt; 0 then
		-- find rent bracket
		--return baserent
	--end
	si = square:FindFirstChild(&quot;Boardindex&quot;).Value
	owner = square:FindFirstChild(&quot;Owner&quot;).Value
	double = false
	if si == 1 then
		if owner == getsquareobject(3):FindFirstChild(&quot;Owner&quot;).Value then
			double = true
		end
	end
	if si == 3 then
		if owner == getsquareobject(1):FindFirstChild(&quot;Owner&quot;).Value then
			double = true
		end
	end
	if si == 6 then
		if owner == getsquareobject(8):FindFirstChild(&quot;Owner&quot;).Value and owner == getsquareobject(9):FindFirstChild(&quot;Owner&quot;).Value then
			double = true
		end
	end

	if si == 8 then
		if owner == getsquareobject(6):FindFirstChild(&quot;Owner&quot;).Value and owner == getsquareobject(9):FindFirstChild(&quot;Owner&quot;).Value then
			double = true
		end
	end

	if si == 9 then
		if owner == getsquareobject(6):FindFirstChild(&quot;Owner&quot;).Value and owner == getsquareobject(8):FindFirstChild(&quot;Owner&quot;).Value then
			double = true
		end
	end

	if si == 11 then
		if owner == getsquareobject(13):FindFirstChild(&quot;Owner&quot;).Value and owner == getsquareobject(14):FindFirstChild(&quot;Owner&quot;).Value then
			double = true
		end
	end

	if si == 13 then
		if owner == getsquareobject(11):FindFirstChild(&quot;Owner&quot;).Value and owner == getsquareobject(14):FindFirstChild(&quot;Owner&quot;).Value then
			double = true
		end
	end

	if si == 14 then
		if owner == getsquareobject(11):FindFirstChild(&quot;Owner&quot;).Value and owner == getsquareobject(13):FindFirstChild(&quot;Owner&quot;).Value then
			double = true
		end
	end

	if si == 16 then
		if owner == getsquareobject(18):FindFirstChild(&quot;Owner&quot;).Value and owner == getsquareobject(19):FindFirstChild(&quot;Owner&quot;).Value then
			double = true
		end
	end
	if si == 18 then
		if owner == getsquareobject(16):FindFirstChild(&quot;Owner&quot;).Value and owner == getsquareobject(19):FindFirstChild(&quot;Owner&quot;).Value then
			double = true
		end
	end

	if si == 19 then
		if owner == getsquareobject(16):FindFirstChild(&quot;Owner&quot;).Value and owner == getsquareobject(18):FindFirstChild(&quot;Owner&quot;).Value then
			double = true
		end
	end
	if si == 21 then
		if owner == getsquareobject(23):FindFirstChild(&quot;Owner&quot;).Value and owner == getsquareobject(24):FindFirstChild(&quot;Owner&quot;).Value then
			double = true
		end
	end
	if si == 23 then
		if owner == getsquareobject(21):FindFirstChild(&quot;Owner&quot;).Value and owner == getsquareobject(24):FindFirstChild(&quot;Owner&quot;).Value then
			double = true
		end
	end
	if si == 24 then
		if owner == getsquareobject(21):FindFirstChild(&quot;Owner&quot;).Value and owner == getsquareobject(23):FindFirstChild(&quot;Owner&quot;).Value then
			double = true
		end
	end
	if si == 26 then
		if owner == getsquareobject(27):FindFirstChild(&quot;Owner&quot;).Value and owner == getsquareobject(29):FindFirstChild(&quot;Owner&quot;).Value then
			double = true
		end
	end
	if si == 27 then
		if owner == getsquareobject(26):FindFirstChild(&quot;Owner&quot;).Value and owner == getsquareobject(29):FindFirstChild(&quot;Owner&quot;).Value then
			double = true
		end
	end
	if si == 29 then
		if owner == getsquareobject(26):FindFirstChild(&quot;Owner&quot;).Value and owner == getsquareobject(27):FindFirstChild(&quot;Owner&quot;).Value then
			double = true
		end
	end
	if si == 31 then
		if owner == getsquareobject(32):FindFirstChild(&quot;Owner&quot;).Value and owner == getsquareobject(34):FindFirstChild(&quot;Owner&quot;).Value then
			double = true
		end
	end
	if si == 32 then
		if owner == getsquareobject(31):FindFirstChild(&quot;Owner&quot;).Value and owner == getsquareobject(34):FindFirstChild(&quot;Owner&quot;).Value then
			double = true
		end
	end
	if si == 34 then
		if owner == getsquareobject(31):FindFirstChild(&quot;Owner&quot;).Value and owner == getsquareobject(32):FindFirstChild(&quot;Owner&quot;).Value then
			double = true
		end
	end
	if si == 37 then
		if owner == getsquareobject(39):FindFirstChild(&quot;Owner&quot;).Value then
			double = true
		end
	end
	if si == 39 then
		if owner == getsquareobject(37):FindFirstChild(&quot;Owner&quot;).Value then
			double = true
		end
	end

	if si == 5 or si == 15 or si == 25 or si == 35 then
		railroads = 0
		if owner == getsquareobject(5):FindFirstChild(&quot;Owner&quot;).Value then
			railroads = railroads + 1
		end
		if owner == getsquareobject(15):FindFirstChild(&quot;Owner&quot;).Value then
			railroads = railroads + 1
		end
		if owner == getsquareobject(25):FindFirstChild(&quot;Owner&quot;).Value then
			railroads = railroads + 1
		end
		if owner == getsquareobject(35):FindFirstChild(&quot;Owner&quot;).Value then
			railroads = railroads + 1
		end
		
		if railroads == 1 then
			return 25
		end
		if railroads == 2 then
			return 50
		end
		if railroads == 3 then
			return 100
		end
		if railroads == 4 then
			return 200
		end
	end


	if si == 12 or si == 28 then
		utils = 0
		if owner == getsquareobject(12):FindFirstChild(&quot;Owner&quot;).Value then
			utils = utils + 1
		end
		if owner == getsquareobject(28):FindFirstChild(&quot;Owner&quot;).Value then
			utils = utils + 1
		end
		if utils == 1 then
			return (4 * (math.random(1,6) + math.random(1,6)))
		end
		if utils == 2 then
			return (10 * (math.random(1,6) + math.random(1,6)))
		end
	end

	if double == true then
		return baserent * 2
	end
	if double == false then
		return baserent
	end

	return 0
end

function bankruptcurrentplayer()

	if game.Workspace:FindFirstChild(game.Workspace:FindFirstChild(&quot;CurrentPlayer&quot;).Value) == nil then return end

	playername = game.Workspace:FindFirstChild(&quot;CurrentPlayer&quot;).Value
	cashobject = game.Players:FindFirstChild(playername):FindFirstChild(&quot;leaderstats&quot;):FindFirstChild(&quot;Cash&quot;)
	
	cashobject.Value = 0
	msg = Instance.new(&quot;Message&quot;)
	msg.Text = playername .. &quot; IS BANKRUPT!&quot;
	msg.Parent = game.Workspace
	wait(10)
	msg:Remove()

	msg = Instance.new(&quot;Message&quot;)
	msg.Text = &quot;Game is OVER!&quot;
	msg.Parent = game.Workspace
	wait(4)
	msg:Remove()
		
		players = game.Players:GetChildren()
		highest = 0
		winner = &quot;&quot;
		for i = 1, #players do
			worthobject = game.Players:FindFirstChild(players[i].Name):FindFirstChild(&quot;leaderstats&quot;):FindFirstChild(&quot;Worth&quot;)
			if worthobject.Value &gt; highest then
				highest = worthobject.Value
				winner = players[i].Name
			end
		end

		msg = Instance.new(&quot;Message&quot;)
		msg.Text = &quot;Winner is &quot; .. winner .. &quot; with a worth of $&quot; .. highest
		msg.Parent = game.Workspace
		wait(10)
		msg:Remove()

		msg = Instance.new(&quot;Message&quot;)
		msg.Text = &quot;Game will reset in 15 seconds&quot;
		msg.Parent = game.Workspace
		wait(15)
		msg:Remove()
		running = false
		resetgame()

end

function playerpaysto(player, amount)

	if game.Workspace:FindFirstChild(game.Workspace:FindFirstChild(&quot;CurrentPlayer&quot;).Value) == nil then return end
	if game.Workspace:FindFirstChild(player) == nil then return end

	playername = game.Workspace:FindFirstChild(&quot;CurrentPlayer&quot;).Value
	if playername == player then
		print(playername .. &quot; payed &quot; .. amount .. &quot; rent to himself&quot;)
		return
	end

	result = playerpays(amount)
	if result == true then
		--had the cash, give to player
		cashobject = game.Players:FindFirstChild(player):FindFirstChild(&quot;leaderstats&quot;):FindFirstChild(&quot;Cash&quot;)
		cashobject.Value = cashobject.Value + amount

		msg2 = Instance.new(&quot;Message&quot;)
		msg2.Text = playername .. &quot; paid &quot; .. amount .. &quot; to &quot; .. player
		msg2.Parent = game.Workspace
		wait(2)
		msg2:Remove()

	end
	if result == false then
		if game.Workspace:FindFirstChild(game.Workspace:FindFirstChild(&quot;CurrentPlayer&quot;).Value) == nil then return end
		bankruptcurrentplayer()
	end
end

function dosquare(squareindex)

	if game.Workspace:FindFirstChild(game.Workspace:FindFirstChild(&quot;CurrentPlayer&quot;).Value) == nil then return end

	square = getsquareobject(squareindex)

	if square:FindFirstChild(&quot;Type&quot;).Value == &quot;Property&quot; then
		if square:FindFirstChild(&quot;Owner&quot;).Value == &quot;&quot; then
			choosetobuy(square)
			return
		end
		-- player pays rent
		rent = calculaterent(square)
		playerpaysto(square:FindFirstChild(&quot;Owner&quot;).Value,rent)
		return
	end

	if square:FindFirstChild(&quot;Type&quot;).Value == &quot;Utility&quot; then
		if square:FindFirstChild(&quot;Owner&quot;).Value == &quot;&quot; then
			choosetobuy(square)
			return
		end
		-- player pays rent
		rent = calculaterent(square)
		playerpaysto(square:FindFirstChild(&quot;Owner&quot;).Value,rent)
		return
	end

	if square:FindFirstChild(&quot;Type&quot;).Value == &quot;Railroad&quot; then
		if square:FindFirstChild(&quot;Owner&quot;).Value == &quot;&quot; then
			choosetobuy(square)
			return
		end
		-- player pays rent
		rent = calculaterent(square)
		playerpaysto(square:FindFirstChild(&quot;Owner&quot;).Value,rent)
		return
	end

	if square:FindFirstChild(&quot;Type&quot;).Value == &quot;Community Chest&quot; then
		drawcommunitychest()
		return
	end

	if square:FindFirstChild(&quot;Type&quot;).Value == &quot;Chance&quot; then
		drawchance()
		return
	end


	if square:FindFirstChild(&quot;Type&quot;).Value == &quot;Luxury Tax&quot; then
		msg = &quot;Luxury Tax $75&quot;
		sendmessage(msg,2)
		result = playerpays(75)
		if result == false then
			if game.Workspace:FindFirstChild(game.Workspace:FindFirstChild(&quot;CurrentPlayer&quot;).Value) == nil then return end
			bankruptcurrentplayer()
		end
		return
	end

	if square:FindFirstChild(&quot;Type&quot;).Value == &quot;Income Tax&quot; then

		msg = &quot;Income Tax - Pay $200&quot;
		sendmessage(msg,2)

		result = playerpays(200)
		if result == false then
			if game.Workspace:FindFirstChild(game.Workspace:FindFirstChild(&quot;CurrentPlayer&quot;).Value) == nil then return end
			bankruptcurrentplayer()
		end
		return
	end

--Type (Utility, Railroad, Property, Chance, Community Chest, Jail, Free Parking, Go To Jail, Income Tax, Luxury Tax, Go)
--Type (Chance, Community Chest, Jail, Go To Jail)

end

function drawchance()
	if game.Workspace:FindFirstChild(game.Workspace:FindFirstChild(&quot;CurrentPlayer&quot;).Value) == nil then return end

	playername = game.Workspace:FindFirstChild(&quot;CurrentPlayer&quot;).Value
	cursquare = game.Workspace:FindFirstChild(playername .. &quot;LOC&quot;).Value
	cashobject = game.Players:FindFirstChild(playername):FindFirstChild(&quot;leaderstats&quot;):FindFirstChild(&quot;Cash&quot;)


	msg = &quot;Chance&quot;
	sendmessage(msg,2)

	if game.Workspace:FindFirstChild(game.Workspace:FindFirstChild(&quot;CurrentPlayer&quot;).Value) == nil then return end

	roll = math.random(1,5)
	if roll == 1 then

		msg = &quot;Advance to Go (Collect $200)&quot;
		sendmessage(msg,3)
		game.Workspace:FindFirstChild(&quot;CurrentRoll&quot;).Value = 40 - cursquare
		moveplayer()
	end

	if roll == 2 then
		msg = &quot;Advance to Illinois Ave.&quot;
		sendmessage(msg,3)

		if cursquare &lt; 24 then
			game.Workspace:FindFirstChild(&quot;CurrentRoll&quot;).Value = 24 - cursquare
		end
		if cursquare &gt; 24 or cursquare == 24 then
			game.Workspace:FindFirstChild(&quot;CurrentRoll&quot;).Value = (40 - cursquare) + 24
		end
		moveplayer()
	end

	if roll == 3 then
		msg = &quot;Bank pays you dividend of $50&quot;
		sendmessage(msg,3)

		cashobject.Value = cashobject.Value + 50
	end
	if roll == 4 then
		msg = &quot;Pay poor tax of $15&quot;
		sendmessage(msg,3)
		result = playerpays(15)
		if result == false then
			bankruptcurrentplayer()
		end
	end
	if roll == 5 then
		msg = &quot;Your building and loan matures &#150; collect $150&quot;
		sendmessage(msg,3)
		cashobject.Value = cashobject.Value + 150
	end

--Advance token to nearest Utility. If unowned, you may buy it from the Bank. If owned, throw dice and pay owner a total ten times the amount thrown.
--Advance token to the nearest Railroad and pay owner twice the rental to which he/she is otherwise entitled. If Railroad is unowned, you may buy it from the Bank.
--Advance token to the nearest Railroad and pay owner twice the rental to which he/she is otherwise entitled. If Railroad is unowned, you may buy it from the Bank. [Yes, there are two of these.]
--Advance to St. Charles Place &#150; if you pass Go, collect $200
--Get out of Jail free &#150; this card may be kept until needed, or sold
--Go back 3 spaces
--Go directly to Jail &#150; do not pass Go, do not collect $200
--Make general repairs on all your property &#150; for each house pay $25 &#150; for each hotel $100
--Take a ride on the Reading &#150; if you pass Go collect $200
--Take a walk on the Boardwalk &#150; advance token to Boardwalk
--You have been elected chairman of the board &#150; pay each player $50

end

