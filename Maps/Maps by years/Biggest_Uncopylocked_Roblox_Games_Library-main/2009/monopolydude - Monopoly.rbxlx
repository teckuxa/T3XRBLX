handle.BrickColor = BrickColor.new(199)
handle.TopSurface = 0
handle.BottomSurface = 0
handle.formFactor = 0 --symmetric
handle.Size = Vector3.new(1, 5, 1)
handle.Parent = tool
sc.Parent = tool

-- local guide
