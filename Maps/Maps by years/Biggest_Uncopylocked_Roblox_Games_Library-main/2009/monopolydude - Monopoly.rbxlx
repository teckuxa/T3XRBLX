		<Item class="HopperBin" referent="RBX3564">
			<Properties>
				<token name="BinType">0</token>
				<string name="Name">Nuke</string>
				<Content name="TextureId"><url>rbxasset://Textures\Multirocket.png</url></Content>
				<bool name="archivable">true</bool>
			</Properties>
			<Item class="Script" referent="RBX3565">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Launcher</string>
					<string name="Source">print(&quot;New rocket script loaded&quot;)

bin = script.Parent


function fire(target)
	
	local head = game.Players.LocalPlayer.Character:findFirstChild(&quot;Head&quot;)
	if head == nil then return end

	torso = findNearestTorso(game.Players.LocalPlayer.Character:findFirstChild(&quot;Head&quot;).Position,game.Players.LocalPlayer.Character.Name)
	if torso == nil then
		msg = Instance.new(&quot;Message&quot;)
		msg.Text = &quot;Nobody to nuke!&quot;
		msg.Parent = game.Players.LocalPlayer
		wait(2)
		msg:Remove()
		return
	end

		msg = Instance.new(&quot;Message&quot;)
		msg.Text = &quot;Nuking &quot; .. torso.Parent.Name
		msg.Parent = game.Players.LocalPlayer
		wait(2)
		msg:Remove()
	
	local missile = bin.Rocket:clone()
	local creator_tag = Instance.new(&quot;ObjectValue&quot;)
	creator_tag.Value = game.Players.LocalPlayer
	creator_tag.Name = &quot;creator&quot;
	creator_tag.Parent = missile
	missile:FindFirstChild(&quot;Owner&quot;).Value = game.Players.LocalPlayer.Character.Name
	missile.Parent = game.Workspace
	missile:MakeJoints()
	missile:MoveTo(torso.Position + Vector3.new(0,20,0))

	script.Parent:Remove()

end



function findNearestTorso(pos,owner)
	local list = game.Workspace:GetChildren()
	local torso = nil
	local dist = 0
	local temp = nil
	local human = nil
	local temp2 = nil
	for x = 1, #list do
		temp2 = list[x]
		if (temp2.className == &quot;Model&quot;) and (temp2 ~= script.Parent) then
			temp = temp2:findFirstChild(&quot;Torso&quot;)
			human = temp2:findFirstChild(&quot;Humanoid&quot;)
			if (temp ~= nil) and (human ~= nil) and (human.Health &gt; 0) then
				if (temp.Position - pos).magnitude &gt; dist then
					if temp.Parent.Name ~= owner then
						torso = temp
						dist = (temp.Position - pos).magnitude
					end
				end
			end
		end
	end
	return torso
end

enabled = true

function onButton1Down(mouse)
	if not enabled then
		return
	end

	enabled = false
	mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot;

	-- find the best cf
	local cf = mouse.Hit
	--local v = cf.lookVector
	local target = cf.p


	fire(target)

	wait(1)
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	enabled = true

end

function onSelected(mouse)
	print(&quot;rocket selected&quot;)
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end

bin.Selected:connect(onSelected)
</string>
