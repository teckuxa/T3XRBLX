				<Item class="Script" referent="RBX2457">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<string name="Source">wait(1)  --prevent spawning into them for the touch

function ontouch(part)

	if part.Parent.Name ~= game.Workspace:FindFirstChild(&quot;CurrentPlayer&quot;).Value then return end

	game.Workspace:FindFirstChild(&quot;BuyChoice&quot;).Value = &quot;Buy&quot;
	
	-- flash until removed
	while true do
		for i = 1, 10 do
			wait(.1)
			script.Parent.Reflectance = i * 1
		end
		for i = 10, 1, -1 do
			wait(.1)
			script.Parent.Reflectance = i * 1
		end
	end

end

script.Parent.Touched:connect(ontouch)
</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX2458">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<string name="Source">while true do
			wait(.5)
			script.Parent.Reflectance = 1
			wait(.5)
			script.Parent.Reflectance = 0
		parts = script.Parent.Parent:GetChildren()
		for i = 1, #parts do
			parts[i].BrickColor = BrickColor.new(math.random(1,30))
		end

	
	end
</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
