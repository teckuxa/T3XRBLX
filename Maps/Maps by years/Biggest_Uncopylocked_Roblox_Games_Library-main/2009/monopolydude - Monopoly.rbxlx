		cashobject.Value = cashobject.Value + 25
	end
	if roll == 7 then
		msg = &quot;Xmas fund matures &#150; collect $100&quot;
		sendmessage(msg,2)
		cashobject.Value = cashobject.Value + 100
	end
	if roll == 8 then
		msg = &quot;You have won second prize in a beauty contest &#150; collect $10&quot;
		sendmessage(msg,2)
		cashobject.Value = cashobject.Value + 10
	end
	if roll == 9 then
		msg = &quot;You inherit $100&quot;
		sendmessage(msg,2)
		cashobject.Value = cashobject.Value + 100
	end
	if roll == 10 then
		msg = &quot;Pay hospital $100&quot;
		sendmessage(msg,2)
		result = playerpays(100)
		if result == false then
			bankruptcurrentplayer()
