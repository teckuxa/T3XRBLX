				<Item class="Script" referent="RBX3603">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<string name="Source">debounce = false

function ontouch(part)

	if part.Parent:FindFirstChild(&quot;Humanoid&quot;) == nil then return end

	if debounce == true then return end

	debounce = true

	bucket = Instance.new(&quot;Model&quot;)

	parts = part.Parent:GetChildren()
	for i = 1, #parts do
		if parts[i].className ~= &quot;Script&quot; then
			new = parts[i]:Clone()
			if parts[i].className == &quot;Part&quot; then
				new.Controller = 0
				new.Anchored = true
			end
			new.Parent = bucket
		end
	end
	bucket.Parent = game.Workspace
	bucket:MoveTo(script.Parent.Position + Vector3.new(0,20,0))

	wait(2)

	centerpos = bucket:FindFirstChild(&quot;Torso&quot;).Position

	part = bucket:FindFirstChild(&quot;Left Leg&quot;)
	offset = (centerpos - part.Position) * 5
	part.Position = centerpos - offset
	part.Size = part.Size * 5

	part = bucket:FindFirstChild(&quot;Right Leg&quot;)
	offset = (centerpos - part.Position) * 5
	part.Position = centerpos - offset
	part.Size = part.Size * 5


	part = bucket:FindFirstChild(&quot;Left Arm&quot;)
	offset = (centerpos - part.Position) * 5
	part.Position = centerpos - offset
	part.Size = part.Size * 5
	part = bucket:FindFirstChild(&quot;Right Arm&quot;)
	offset = (centerpos - part.Position) * 5
	part.Position = centerpos - offset
	part.Size = part.Size * 5

	part = bucket:FindFirstChild(&quot;Head&quot;)
	offset = (centerpos - part.Position) * 5
	part.Position = (centerpos - offset) + Vector3.new(0,10,0)
	part.Size = part.Size * 5

	part = bucket:FindFirstChild(&quot;Torso&quot;)
	--offset = (centerpos - part.Position) * 8
	part.Position = part.Position + Vector3.new(0,-10,0)
	part.Size = part.Size * 5

	bucket:FindFirstChild(&quot;Head&quot;).Position = bucket:FindFirstChild(&quot;Head&quot;).Position + Vector3.new(0,-10,0)

	bucket:MakeJoints()

	wait(10)

	debounce = false
end

script.Parent.Touched:connect(ontouch)
