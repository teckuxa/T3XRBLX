							<string name="Name">Counter</string>
							<ProtectedString name="Source">local active = false
local baseParts = {}
local awaiting = 0

-- The argument must be an integer:
function fix(num)
&#9;num = tostring(num)
&#9;num = (num:reverse())
&#9;local newNum = &quot;&quot;
&#9;for i = 1,#num do
&#9;&#9;if ((i%3) == 0) then&#9;-- Modulo trick to determine if a number is divisible by 3
&#9;&#9;&#9;newNum = (newNum .. num:sub(i,i) .. &quot;,&quot;)
&#9;&#9;else
&#9;&#9;&#9;newNum = (newNum .. num:sub(i,i))
&#9;&#9;end
&#9;end
&#9;newNum = newNum:reverse()
&#9;if (newNum:sub(1,1) == &quot;,&quot;) then
&#9;&#9;newNum = newNum:sub(2)&#9;-- Quick-fix to correct a mistake in the loop above
&#9;end
&#9;return newNum&#9;-- Returns a string, NOT a number!
end

function count()
&#9;if (active) then
&#9;&#9;awaiting = (awaiting+1)
&#9;&#9;return
&#9;end
&#9;active = true
&#9;wait()&#9;-- When using &apos;DescendantRemoving,&apos; the brick removing isn&apos;t always gone by the time the function is called, so this gives it some time to be removed
&#9;baseParts = {}&#9;-- Clear table
&#9;local function scan(parent)
&#9;&#9;for _,v in pairs(parent:GetChildren()) do&#9;-- Easiest way to get all parts is to quickly scan through with loops
&#9;&#9;&#9;if (v:IsA(&quot;BasePart&quot;)) then
&#9;&#9;&#9;&#9;table.insert(baseParts,v)
&#9;&#9;&#9;end
&#9;&#9;&#9;if (((#baseParts%1000) == 0) and (#baseParts ~= 0)) then&#9;-- Add in a quick wait every 1k bricks to stop an unneccessary lag-attack
&#9;&#9;&#9;&#9;wait()
&#9;&#9;&#9;end
&#9;&#9;&#9;scan(v)
&#9;&#9;end
&#9;end
&#9;scan(game.Workspace)
&#9;local n = #baseParts
&#9;script.Parent.Count.Text = (fix(n) .. (n == 1 and &quot; Brick&quot; or &quot; Bricks&quot;))&#9;-- Not many people realize what you can do with &apos;and&apos; and &apos;or&apos;
&#9;for i = 1,awaiting do
&#9;&#9;count()
&#9;end
&#9;awaiting = 0
&#9;active = false
end

function setup()&#9;-- Yes, I add pointless functions to capture events. It feels more organized
&#9;count()
&#9;game.Workspace.DescendantAdded:connect(count)
&#9;game.Workspace.DescendantRemoving:connect(count)
end

setup()</ProtectedString>
