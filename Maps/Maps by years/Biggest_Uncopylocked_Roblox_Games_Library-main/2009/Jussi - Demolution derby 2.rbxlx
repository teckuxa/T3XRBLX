		<Item class="Script" referent="RBX2661">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Effects</string>
				<ProtectedString name="Source">script.Bloodshot.Parent = game.StarterGui

game.Workspace.ChildAdded:connect(function(child)

	P = game.Players:GetPlayerFromCharacter(child)
	if P ~= nil then
		if P.Character ~= nil then
			H = P.Character:findFirstChild(&quot;Humanoid&quot;)
			if H ~= nil then
				T = P.Character:findFirstChild(&quot;Torso&quot;)
				-- You need a Torso and Humanoid for this to affect on a person.
				if T ~= nil then
					P.Character.Health:remove()
					giveblood = script.BloodShotS:clone()
					giveblood.Disabled = false
					giveblood.Parent = P.Character
					local part = Instance.new(&quot;Part&quot;)
					local weld = Instance.new(&quot;Weld&quot;)
					weld.Part0 = part
					weld.Part1 = T
					weld.C0 = CFrame.new(0,5,0)
					weld.Parent = T
					part.Name = &quot;Connector&quot;
					float = Instance.new(&quot;BodyForce&quot;)
					float.force = Vector3.new(0,1000,0)
					float.Parent = part
					part.Transparency = 1
					part.CanCollide = false
					part.Parent = T.Parent
					fallingdamage = script.FallingDamage:clone()
					fallingdamage.Disabled = false
					fallingdamage.Parent = P.Character
				end
			end
		end
	end
end)</ProtectedString>
				<bool name="archivable">true</bool>
			</Properties>
			<Item class="Script" referent="RBX2662">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">BloodShotS</string>
					<ProtectedString name="Source">--ipod525&apos;s bloodshot script

local PreviousHealth=100 


function lol(o) 
if script.Parent.Humanoid.Health&lt;=(PreviousHealth-1) then
PreviousHealth = script.Parent.Humanoid.Health 
if script.Parent.Torso == nil then return end
local player = game.Players:playerFromCharacter(script.Parent)
for i = 1,math.random(1,5) do
local p = Instance.new(&quot;Part&quot;)
script.WeldToHit:clone().Parent = p
p.formFactor = 2
p.Size = Vector3.new(1,.4,0)
p.TopSurface = 0
p.BottomSurface = 0
p.BrickColor = BrickColor.new(21)
p.Position = script.Parent.Torso.Position + Vector3.new(math.random(-3,3),math.random(-2,2),math.random(-3,3))
p.Parent = game.Workspace
end 
player.PlayerGui.Bloodshot.Bloodshot.Transparency = script.Parent.Humanoid.Health / 100
while player.PlayerGui.Bloodshot.Bloodshot.Transparency &lt; 1.01 do
player.PlayerGui.Bloodshot.Bloodshot.Transparency = player.PlayerGui.Bloodshot.Bloodshot.Transparency + 0.01
wait(.08)
end
print(PreviousHealth)
end
end

script.Parent.Humanoid.Changed:connect(lol)</ProtectedString>
