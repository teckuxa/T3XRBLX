							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">function onChildAdded(child)
	if child.Name == &quot;SeatWeld&quot; then
		child.C0 = CFrame.new(0,(script.Parent.Size.y/2 + 1.5),0)
		child.C1 = CFrame.new(0, 1.2, 0)
	end
end

script.Parent.ChildAdded:connect(onChildAdded)</ProtectedString>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
					<Item class="Script" referent="RBX1786">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">local car = script.Parent.Parent 

function onTouched(hit) 
local human = hit.Parent:findFirstChild(&quot;Humanoid&quot;) 
if (human ~= nil ) then 
car.Parent = hit.Parent 
end 
end 

script.Parent.Touched:connect(onTouched)
</ProtectedString>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
