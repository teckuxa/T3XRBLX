			<Item class="Script" referent="RBX2666">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">FallingDamage</string>
					<ProtectedString name="Source">local lasthit = false

function fallingdamage(hit)
	local human = script.Parent:findFirstChild(&quot;Humanoid&quot;)
	local torso = script.Parent:findFirstChild(&quot;Torso&quot;)
	if human ~= nil and torso ~= nil and lasthit == false then
		if torso.Velocity.y &lt; -70 then
			human.Health = human.Health - 20
			if torso.Velocity.y &lt; -100 then
				human.Health = human.Health - 40
			end
			lasthit = true
		end
		wait(1)
		lasthit = false
	end
end

script.Parent[&quot;Connector&quot;].Touched:connect(fallingdamage)

		</ProtectedString>
