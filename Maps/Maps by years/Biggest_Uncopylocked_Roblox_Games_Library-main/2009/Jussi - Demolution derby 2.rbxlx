				<string name="Name">Time</string>
				<ProtectedString name="Source">l = game:service(&quot;Lighting&quot;) 

while true do 
-- increment the time of day and then wait for a while 
l:SetMinutesAfterMidnight(l:GetMinutesAfterMidnight()+1) 
wait(.1)
end </ProtectedString>
