			<Item class="Script" referent="RBX3927">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">debounce = false

function onTouch(hit)
	if debounce == false then
	debounce = true
	print(&quot;touch&quot;)
	if hit.Parent ~= script.Parent then
		print(&quot;Not Self&quot;)
			if hit.Name == &quot;Handle&quot; then
			h = hit.Parent.Parent:findFirstChild(&quot;Humanoid&quot;)
		print(hit.Name)
		print(hit.Parent.Parent.Name)
		else
		h = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
		print(hit.Name)
		print(hit.Parent.Name)
		end
		if h ~= nil then
			print(&quot;Humanoid&quot;)
			--Check list for all items
			player = game.Players:findFirstChild(h.Parent.Name)
			if player ~= nil then
				a = player:findFirstChild(&quot;Coin&quot;)
				b = player:findFirstChild(&quot;Cake&quot;)
				c = player:findFirstChild(&quot;Camera&quot;)
				d = player:findFirstChild(&quot;Briguy&quot;)
				if a and b and c and d ~= nil then
					print(&quot;WINVAR!&quot;)
					door = script.Parent
					door.CanCollide = false
					door.Transparency = .6
					wait(2)
					door.CanCollide = true
					door.Transparency = 0
				end
		else
		print(&quot;Not Human&quot;)
		end
	end
	end
	wait(4)
	debounce = false
	end
end

script.Parent.Touched:connect(onTouch)
</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
		</Item>
