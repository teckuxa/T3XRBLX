					<string name="Name">MasterScript</string>
					<ProtectedString name="Source">function Enter()
print(&quot;Entered&quot;)
Input = &quot;&quot;

pad = game.Workspace.FloorMid
BP = pad.BodyPosition

BP.position = Vector3.new(-56, 119, -218)
wait(2)
BP.position = Vector3.new(-56, 119, -232)
wait(15)
BP.position = Vector3.new(-56, 119, -218)
wait(7)
BP.position = Vector3.new(-56, 117, -218)

end

script.Parent.ClickDetector.MouseClick:connect(Enter)</ProtectedString>
