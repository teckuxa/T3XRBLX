			<Item class="Script" referent="RBX32">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">debounce = false

function onTouch(hit)
	if debounce == false then
	debounce = true
	print(&quot;touch&quot;)
	if hit.Parent ~= script.Parent then
		print(&quot;Not Self&quot;)
			if hit.Name == &quot;Handle&quot; then
			h = hit.Parent.Parent:findFirstChild(&quot;Humanoid&quot;)
		print(hit.Name)
		print(hit.Parent.Parent.Name)
		else
		h = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
		print(hit.Name)
		print(hit.Parent.Name)
		end
		if h ~= nil then
			print(&quot;Humanoid&quot;)
			--Check off list and add a confirmation to player
			player = game.Players:findFirstChild(h.Parent.Name)
			if player ~= nil then
				gui = player.PlayerGui.ScavList.Briguy
					-- 102; 255; 102
					gui.BackgroundColor3 = Color3.new((51/255), (204/255), (51/255))
			check = Instance.new(&quot;StringValue&quot;)
			check.Name = &quot;Briguy&quot;
			check.Parent = player
			print(&quot;Finish&quot;)
			end
		else
		print(&quot;Not Human&quot;)
		end
	end
	wait(4)
	debounce = false
	end
end

script.Parent.Torso.Touched:connect(onTouch)

