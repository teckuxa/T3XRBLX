						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">--[[
Launch Star v2.0 by TylerMcBride.
Remade by Bob10110 to work after the update.
Directions:  Scroll to the bottom of the script and edit the small code chunks.
]]

function Launch(char, target, speed)  --Script to fire the RocketPropulsion (Online Mode fix)
char.Torso.BodyPosition.position = target.Position
print(&quot;Loop started.  Target brick: &quot; .. target.Name)
while char.Parent ~= nil do
	if (target.Position - char.Torso.Position).magnitude &lt; 20 then
		print(&quot;Player at target&quot;)
		return
	else
		print((target.Position-char.Torso.Position).unit*speed)
		char.Torso.BodyPosition.maxForce = Vector3.new(
		500*math.abs(((target.Position - char.Torso.Position).unit*speed).x),
		100*math.abs(((target.Position - char.Torso.Position).unit*speed).y),
		500*math.abs(((target.Position - char.Torso.Position).unit*speed).z))
		char.Torso.BodyGyro.cframe = CFrame.new(char.Torso.Position, char.Torso.Position+char.Torso.Velocity)
	end
wait(0.1)
end
end

function MakeWeightless(m)
	local p = m:getChildren()
	for i = 1, #p do
		if p[i].className == &quot;Part&quot; or p[i].className == &quot;Seat&quot; then
		local g = Instance.new(&quot;BodyForce&quot;)
		g.force = Vector3.new(0, p[i]:getMass()*196.2, 0)
		g.Parent = p[i]
		elseif p[i].className == &quot;Model&quot; or p[i].className == &quot;Hat&quot; then
		MakeWeightless(p[i])
		end
	end
end

function RemoveWeightless(m)
	local p = m:getChildren()
	for i = 1, #p do
		if p[i].className == &quot;Part&quot; or p[i].className == &quot;Seat&quot; then
		local g = p[i]:findFirstChild(&quot;BodyForce&quot;)
		if g ~= nil then g:remove() end
		elseif p[i].className == &quot;Model&quot; or p[i].className == &quot;Hat&quot; then
		RemoveWeightless(p[i])
		end
	end
end

function onTouched(part)
local players = game.Players:getChildren()
for i = 1, #players do
	if players[i]:findFirstChild(&quot;Launched&quot;) == nil and players[i].Character ~= nil then
	if players[i].Character:IsAncestorOf(part) then
		local h = players[i].Character:findFirstChild(&quot;Humanoid&quot;)
		if h.Health ~= 0 then
		if players[i].Character:findFirstChild(&quot;Torso&quot;) ~= nil then
local debounce = Instance.new(&quot;IntValue&quot;)
debounce.Name = &quot;Launched&quot;
debounce.Parent = players[i]
MakeWeightless(players[i].Character)
local sp = Instance.new(&quot;Sparkles&quot;)
sp.Parent = h.Parent.Torso
h.Parent.Head.CanCollide = false
h.Parent.Torso.CanCollide = false
local bg = Instance.new(&quot;BodyGyro&quot;)
bg.P = 9001  --  =3
bg.D = 1009
bg.maxTorque = Vector3.new(10000, 10000, 10000)
bg.Parent = h.Parent.Torso
local bp = Instance.new(&quot;BodyPosition&quot;)
bp.P = 10000
bp.D = 5000
bp.Parent = h.Parent.Torso
bp.maxForce = Vector3.new(0, 0, 0)

--Multiple--
local point = game.Workspace.locationa1
local speed = 100 
Launch(players[i].Character, point, speed)

local point = game.Workspace.locationa2
local speed = 100
Launch(players[i].Character, point, speed)

--------------
if players[i].Character ~= nil then
RemoveWeightless(players[i].Character)
bg:remove()
bp:remove()
sp:remove()
h.Parent.Head.CanCollide = true
h.Parent.Torso.CanCollide = true
debounce:remove()
end
		end
		end			
	end
	end
end
end

