						<ProtectedString name="Source">door = script.Parent.Parent.Door

function onClicked()
	for i = 1, 70 do
		door.CFrame = door.CFrame*CFrame.new(0.1, 0, 0)
		wait()
	end
	wait(.3)
	for i = 1, 70 do
		door.CFrame = door.CFrame*CFrame.new(-0.1, 0, 0)
		wait()
	end
end

