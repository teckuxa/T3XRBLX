			<Item class="Script" referent="RBX752">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">currentTime = 10
maxTime = 99
minTime = 01

function setName()
	script.Parent.Name = &quot;&quot;..currentTime..&quot;&quot;
end
setName()

function changeTime(button)
	if button.Name == &quot;Add&quot; then
		if currentTime &lt; maxTime then
			currentTime = currentTime + 1
		end
	elseif button.Name == &quot;Subtract&quot; then
		if currentTime &gt; minTime then
			currentTime = currentTime - 1
		end
	end
	setName()
end

local connect1 = script.Parent.Add.ClickDetector.MouseClick:connect(function() changeTime(script.Parent.Add) end)
local connect2 = script.Parent.Subtract.ClickDetector.MouseClick:connect(function() changeTime(script.Parent.Subtract) end)
function blow(obj)
	for i=1, 10 do
		local x = obj.Position.x
		local y = obj.Position.y
		local z = obj.Position.z

		local rx = math.random(x-10, x+10)
		local ry = math.random(y-10, y+10)
		local rz = math.random(z-10, z+10)

		local ex = Instance.new(&quot;Explosion&quot;)
		ex.BlastPressure = 1000000
		ex.BlastRadius = 10000000
		ex.Position = Vector3.new(rx, ry, rz)
		ex.Parent = workspace
	end
end

function beginBomb()
	connect1:disconnect()
	connect2:disconnect()
	connect3:disconnect()
	while currentTime &gt; 0 do
		wait(1)
		currentTime = currentTime - 1
		setName()
	end
	blow(script.Parent.Body)
	wait(5)
	script.Parent:remove()
end

connect3 = script.Parent.Begin.ClickDetector.MouseClick:connect(beginBomb)</ProtectedString>
