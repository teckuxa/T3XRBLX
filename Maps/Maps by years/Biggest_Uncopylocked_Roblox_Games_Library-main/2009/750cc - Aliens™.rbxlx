			<Item class="Script" referent="RBX9382">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">ProjectileScript</string>
					<ProtectedString name="Source">damage = 25
game:GetService(&quot;Debris&quot;):AddItem(script.Parent, 8)

function onTouched(hit)
	if hit.Parent:findFirstChild(&quot;Zombie&quot;)~=nil then
		hit.Parent[&quot;Zombie&quot;]:TakeDamage(damage)
	end
	wait()
	script.Parent:Remove()
end

script.Parent.Touched:connect(onTouched)</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
				<Item class="StockSound" referent="RBX9383">
					<Properties>
						<bool name="Looped">false</bool>
						<string name="Name">rbxa11</string>
						<float name="Pitch">1</float>
						<int name="PlayCount">-1</int>
						<bool name="PlayOnRemove">false</bool>
						<Content name="SoundId"><null></null></Content>
						<float name="Volume">0.5</float>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
			<Item class="LocalScript" referent="RBX9384">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Local Gui</string>
					<ProtectedString name="Source">local Tool = script.Parent;

enabled = true
function onButton1Down(mouse)
	if not enabled then
		return
	end

	enabled = true

	function Reload()
		if (script.Parent.AmmoScript.Clip.Value == 0) then
			enabled = false
			mouse.Icon = &quot;http://www.roblox.com/asset/?id=2966018&quot;
script.Parent.Handle9.Transparency = 1 
script.Parent.Handle10.Transparency = 1 
script.Parent.Handle11.Transparency = 1 
script.Parent.Handle12.Transparency = 1 

wait(4) 

script.Parent.Handle9.Transparency = 0
script.Parent.Handle10.Transparency = 0 
script.Parent.Handle11.Transparency = 0 
script.Parent.Handle12.Transparency = 0 


			wait(4)
			mouse.Icon = &quot;http://www.roblox.com/asset/?id=2966012&quot;
			enabled = true
		wait(0)
		end
	end

	script.Parent.AmmoScript.Clip.Changed:connect(Reload)

end


function onButton1Up(mouse)
enabled = false
Tool.Enabled = false
wait(0.1)
enabled = true
Tool.Enabled = true
end

function onEquippedLocal(mouse)

	if mouse == nil then
		print(&quot;Mouse not found&quot;)
		return 
	end

	mouse.Icon = &quot;http://www.roblox.com/asset/?id=2966012&quot;
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)	
	mouse.Button1Up:connect(function() onButton1Up(mouse)end)
end


Tool.Equipped:connect(onEquippedLocal)
</ProtectedString>
