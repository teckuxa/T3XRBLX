						<Item class="Script" referent="RBX1876">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Message</string>
								<ProtectedString name="Source">print(&quot;&quot;)

local debounce = false


function onHit(hit)
	local human = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
	if (human ~= nil) and debounce == false then

                debounce = true

local message = Instance.new(&quot;Message&quot;)
message.Text = &quot;&quot;--  Replace &quot;Oxidation&quot; with your messages you want to appear in the top left hand corner of the screen.
message.Parent = game.Players:playerFromCharacter(hit.Parent)
wait(3)--  You can also edit the time it takes for them to appear.
message.Text = &quot;You start to Read the Diary&quot;
wait(3)
message.Text = &quot;Dear Diary&quot;
wait(3)
message.Text = &quot;Today was a Bad Day...Really Bad&quot;
wait(3)
message.Text = &quot;I&apos;m Tring to keep calm&quot;
wait(1)
message.Text = &quot;2 of the guides died because of the zombie outbreak&quot;
wait(2)
message.Text = &quot;I have no Idea what to do...&quot;
wait(5)
message.Text = &quot;I&apos;m Scared&quot;
wait(3)
message.Text = &quot;I have been hearing things...&quot;
wait(3)
message.Text = &quot;I think they are the zombies looking for us.&quot;
wait(3)
message.Text = &quot;We will move tomorrow. I&apos;m gonna leave books around.&quot;
wait(3)
message.Text = &quot;Read all of them please. Help us.&quot;
wait(3)
message.Text = &quot;We are stranded&quot;
wait(3)
message.Text = &quot;We have no food or water...&quot;
wait(3)
message.Text = &quot;Help us&quot;
wait(3)
message.Text = &quot;I hear something. It&apos;s 2:00 AM&quot;
wait(3)
message.Text = &quot;I&apos;m getting out of here&quot;
wait(3)
message.Text = &quot;I am now leaving the book.&quot;
wait(3)
message.Text = &quot;Bye&quot;
wait(3)
message.Text = &quot;DATE LEFT: 5/15/10&quot;
wait(3)

message:Remove ()

                debounce = false
	end
end

script.Parent.Touched:connect(onHit)</ProtectedString>
								<bool name="archivable">true</bool>
							</Properties>
						</Item>
