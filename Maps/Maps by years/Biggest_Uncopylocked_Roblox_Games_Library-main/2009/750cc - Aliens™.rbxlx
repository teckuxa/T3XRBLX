							<ProtectedString name="Source">local Tool = script.Parent;

enabled = true
function onButton1Down(mouse)
	if not enabled then
		return
	end

	enabled = true
end

function KeyReload()
	script.Parent.AmmoScript.Ammo.Value = script.Parent.AmmoScript.Ammo.Value + script.Parent.AmmoScript.Clip.Value
	script.Parent.AmmoScript.Clip.Value = 0
	if (script.Parent.AmmoScript.Clip.Value == 0) and (script.Parent.AmmoScript.Ammo.Value &gt;= 95) then
		wait(3)
		script.Parent.AmmoScript.Clip.Value = 95
		script.Parent.AmmoScript.Ammo.Value = script.Parent.AmmoScript.Ammo.Value - 95
	end
	if (script.Parent.AmmoScript.Clip.Value == 0) and (script.Parent.AmmoScript.Ammo.Value &lt;= 95) then
		wait(2)
		script.Parent.AmmoScript.Clip.Value = script.Parent.AmmoScript.Ammo.Value
		script.Parent.AmmoScript.Ammo.Value = 0
	end
end

enabled = true
function onButton1Down(mouse)
	if not enabled then
		return
	end

	enabled = true

	--wait(.5)
	--mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	--enabled = true
	--mouse.Button1Up:connect(function() onButton1Up(mouse) end)

end

function KeyDown(key)
	key = key:lower()
	if key == &quot;r&quot; then
		KeyReload()
	end
end
function onButton1Up(mouse)
enabled = false
Tool.Enabled = false
wait(0.25)
enabled = true
Tool.Enabled = true
end

function onEquippedLocal(mouse)

	if mouse == nil then
		print(&quot;Mouse not found&quot;)
		return 
	end

	mouse.Icon = &quot;http://www.roblox.com/asset/?id=2966012&quot;
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)	
	mouse.Button1Up:connect(function() onButton1Up(mouse)end)
	mouse.KeyDown:connect(KeyDown)
end


Tool.Equipped:connect(onEquippedLocal)
while true do
	if script.Parent.AmmoScript.Clip.Value == 0 then
		KeyReload()
	end
	wait(0.3) --CPU hogs suck. 0.3 is the magic number.
end
