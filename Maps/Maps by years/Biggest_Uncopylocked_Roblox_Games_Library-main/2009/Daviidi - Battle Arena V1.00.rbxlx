					<string name="Source">Button = script.Parent.Head

normalcolor = Button.BrickColor
othercolor = BrickColor.new(26)

function killall(hit)
	if hit.Parent == nil then return end
	if hit.Parent:findFirstChild(&quot;Humanoid&quot;) == nil then return end
	local pl = game.Players:playerFromCharacter(hit.Parent)
	if pl == nil then return end
	if Button.BrickColor == othercolor then return end
	Button.BrickColor = othercolor
	local m = Instance.new(&quot;Message&quot;)
	m.Text = pl.Name.. &quot; has activated the emergency death by meteor script!&quot;
	m.Parent = workspace
	wait(2)
	m.Text = &quot;Meteors will now randomly fall out of the sky.&quot;
	wait(2)
	m:Remove()
	for _ = 1, 30 do
		wait(0.5)
		local meteor = Instance.new(&quot;Part&quot;)
		meteor.Name = &quot;Meteor&quot;
		meteor.formFactor = &quot;Symmetric&quot;
		meteor.Shape = &quot;Ball&quot;
		meteor.BrickColor = BrickColor.new(21)
		local spark = Instance.new(&quot;Sparkles&quot;)
		spark.Color = Color3.new(1,0,0)
		spark.Parent = meteor
		meteor.Size = Vector3.new(4,4,4)
		meteor.Position = Vector3.new(math.random(-90,90),math.random(150,250),math.random(-90,90))
		meteor.Velocity = Vector3.new(math.random(-80,80),-100,math.random(-80,80))
		local sc = script.Meteor:Clone()
		sc.Disabled = false
		sc.Parent = meteor
		meteor.Parent = workspace
	end

	local name = script.Parent.Name

	for time = 120, 1, -1 do
		script.Parent.Name = name.. &quot; - Recharge: &quot;.. time
		wait(1)
	end

	Button.BrickColor = normalcolor

	script.Parent.Name = name
end

Button.BrickColor = othercolor

Button.BrickColor = normalcolor

Button.Touched:connect(killall)</string>
