						<string name="Name">BurnSCV1</string>
						<string name="Source">-- This script BURNS.

p = script.Parent
color = p.BrickColor
local sp = Instance.new(&quot;Sparkles&quot;)
sp.Color = Color3.new(1,0,0)
sp.Parent = p

function BURN(part)
	if part:findFirstChild(script.Name) ~= nil then return end
	if part.Anchored == true then return end
	script:Clone().Parent = part
end

p.Touched:connect(BURN)

for i = 1, math.random(60, 180) do
	p.BrickColor = color
	wait(0.25)
	p.BrickColor = BrickColor.new(21)
	wait(0.25)
end

local ex = Instance.new(&quot;Explosion&quot;)
ex.BlastPressure = 500000
ex.BlastRadius = 4
ex.Position = p.Position
ex.Parent = workspace

ex.Hit:connect(BURN)

wait(10)

p:Remove()</string>
