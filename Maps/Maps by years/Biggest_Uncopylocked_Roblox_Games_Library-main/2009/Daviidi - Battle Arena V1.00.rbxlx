		<Item class="Script" referent="RBX1821">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">WallRegen</string>
				<string name="Source">regenmod = script.Parent.Walls
walls = regenmod:GetChildren()
backup = {}
nowregen = {}
for i = 1, #walls do
	backup[i] = walls[i]:Clone()
end

m = Instance.new(&quot;Message&quot;)
m.Text = &quot;Regenerating some Wall Parts&quot;

function regen()
	if #nowregen == 0 then
		for i = 1, #walls do
			nowregen[i] = i
		end
	end
	local n = math.random(1, #nowregen)
	local toregen = nowregen[n]
	table.remove(nowregen, n)
	walls[toregen]:Remove()
	walls[toregen] = backup[toregen]:Clone()
	walls[toregen].Parent = regenmod
	walls[toregen]:MakeJoints()
end

function runregen()
	m.Parent = workspace
	wait(4)
	for _ = 1, 4 do
		regen()
	end
	wait(1)
	m.Parent = nil
end

while true do
	wait(90)
	runregen()
end
</string>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
