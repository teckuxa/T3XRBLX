						<Item class="Script" referent="RBX783">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<string name="Source">wait(.25)

r = false
tag = script.Parent.creator
hum = script.Parent.Parent.Humanoid
hum.MaxHealth = 100
hum.Health = 100
hum.Parent = nil

function touch(hit)
	if r == true then return end
	if hit.Parent == nil then return end
	if hit.Parent:findFirstChild(&quot;Humanoid&quot;) == nil then return end
	if hit.Parent.Humanoid.Health &lt;= 0 then return end
	if game.Players:playerFromCharacter(hit.Parent) == nil then return end
	r = true
	tag.Value = game.Players:playerFromCharacter(hit.Parent)
	hum.Parent = script.Parent.Parent
	local p = script.Parent.Parent.Parent:GetChildren()
	for o = 1, #p do
		if p[o].Name == &quot;Bomb&quot; and p[o] ~= script.Parent.Parent then
			p[o]:Remove()
		end
	end
	for i = 100, 0, -1 do
		script.Parent.Reflectance = script.Parent.Reflectance + 0.1
		if script.Parent.Reflectance &gt; 1 then script.Parent.Reflectance = 0 end
		hum.Health = i
		script.Parent.Parent.Name = &quot;Bomb - &quot;.. math.ceil(i/10)
		wait(0.1)
	end
	script.Parent.Parent.Name = &quot;Bomb&quot;
	script.Parent.Reflectance = 0
	local ex = Instance.new(&quot;Explosion&quot;)
	ex.BlastPressure = 500000
	ex.BlastRadius = 10
	ex.Position = script.Parent.Position
	ex.Parent = workspace
	ex.Hit:connect(function(hit)
		if hit.Parent ~= nil then
			if hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil then
				local newtag = tag:Clone()
				newtag.Parent = hit.Parent.Humanoid
				wait(1)
				newtag:Remove()
			end
		end
	end)
	wait(5)
	script.Parent.Parent:Remove()
end

script.Parent.Touched:connect(touch)</string>
