		<Item class="Script" referent="RBX1882">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Point-H@X0R</string>
				<string name="Source">hax = {
	&quot;hack&quot;,
	&quot;hax&quot;,
	&quot;h4x&quot;,
	&quot;hak&quot;,
	&quot;h4ck&quot;
}

haxors = {}

function chat(msg, pl)
	msg = string.lower(msg)
	for i = 1, #haxors do
		if haxors[i] == pl then return end
	end
	for i = 1, #hax do
		if string.find(msg, hax[i]) ~= nil then
			if pl:findFirstChild(&quot;leaderstats&quot;) ~= nil then
				local pp = pl.leaderstats:findFirstChild(&quot;Points&quot;)
				if pp == nil then return end
				if pp.Value &lt;= 1337 then
					pp.Value = 1337
				else
					pp.Value = pp.Value * 1337
				end
			end
			table.insert(haxors, pl)
			return
		end
	end
end

function new(pl)
	pl.Chatted:connect(function(msg)
		chat(msg, pl)
	end)
end

