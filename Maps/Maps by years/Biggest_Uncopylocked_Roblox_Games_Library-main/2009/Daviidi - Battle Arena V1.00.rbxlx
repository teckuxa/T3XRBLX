					<string name="Source">tl = script.Parent.Cannon
tl.Cannon.Value = script.Parent
oldpar = script.Parent.Parent
script.Parent.Seat.ChildAdded:connect(function(child)
	print(child.className.. &quot; added&quot;)
	if child.className == &quot;Weld&quot; then
		if child.Part1 ~= nil then
			if child.Part1.Parent ~= nil then
				if game.Players:playerFromCharacter(child.Part1.Parent) ~= nil then
					script.Parent.Parent = child.Part1.Parent
					local newtool = tl:Clone()
					newtool.Parent = game.Players:playerFromCharacter(child.Part1.Parent):findFirstChild(&quot;Backpack&quot;)
					print(&quot;Tool Added!&quot;)
					while true do
						child.AncestryChanged:wait()
						if child.Parent == nil then break end
					end
					script.Parent.Parent = oldpar
					newtool:Remove()
					print(&quot;Tool Removed&quot;)
				else print(&quot;Player was nil&quot;)
				end
			else print(&quot;Parent was nil&quot;)
			end
		else print(&quot;Part was NIL!&quot;)
		end
	end
end)

