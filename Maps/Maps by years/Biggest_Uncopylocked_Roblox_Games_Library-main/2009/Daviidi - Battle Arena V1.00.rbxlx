						<string name="Source">Model = script.Parent.Parent
Backup = Model:Clone()
Parenty = Model.Parent
Button = script.Parent.Head
Seat = Model.Seat

normalcolor = Button.BrickColor
othercolor = BrickColor.new(26)

function regen(hit)
	if hit.Parent == nil then return end
	if hit.Parent:findFirstChild(&quot;Humanoid&quot;) == nil then return end
	if Button.BrickColor == othercolor then return end
	if #Seat:GetChildren() &gt; 0 then return end -- Don&apos;t regen if the cannon is in use.
	Backup.Parent = Parenty
	Backup:MakeJoints()
	Model:Remove()
end

Button.BrickColor = othercolor

wait(30)

Button.BrickColor = normalcolor

Button.Touched:connect(regen)</string>
