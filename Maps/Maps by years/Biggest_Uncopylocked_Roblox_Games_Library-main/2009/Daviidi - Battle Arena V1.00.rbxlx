					<string name="Name">FLY!</string>
					<string name="Source">Button = script.Parent.Head

normalcolor = Button.BrickColor
othercolor = BrickColor.new(26)

grav = {}

function killall(hit)
	if hit.Parent == nil then return end
	if hit.Parent:findFirstChild(&quot;Humanoid&quot;) == nil then return end
	local pl = game.Players:playerFromCharacter(hit.Parent)
	if pl == nil then return end
	if Button.BrickColor == othercolor then return end
	Button.BrickColor = othercolor
	local m = Instance.new(&quot;Message&quot;)
	m.Text = pl.Name.. &quot; has activated the lightweight script!&quot;
	m.Parent = workspace
	wait(2)
	m.Text = &quot;Anyone alive will be lightweight for 30 seconds.&quot;
	wait(2)
	m:Remove()

	local ppl = game.Players:GetPlayers()
	for i = 1, #ppl do
		if ppl[i].Character ~= nil then
			if ppl[i].Character:findFirstChild(&quot;Humanoid&quot;) ~= nil then
				if ppl[i].Character.Humanoid.Health &gt; 0 then
					local parts = ppl[i].Character:GetChildren()
					for i = 1, #parts do
						if parts[i].className == &quot;Part&quot; then
							local F = Instance.new(&quot;BodyForce&quot;)
							F.force = Vector3.new(0, parts[i]:GetMass() * 140, 0)
							table.insert(grav, F)
							F.Parent = parts[i]
						end
					end
				end
			end
		end
	end

	local name = script.Parent.Name

	for time = 30, 1, -1 do
		script.Parent.Name = name.. &quot; - Recharge: &quot;.. 60 + time
		wait(1)
	end

	for i = 1, #grav do
		grav[i]:Remove()
		grav[i] = nil
	end

	for time = 60, 1, -1 do
		script.Parent.Name = name.. &quot; - Recharge: &quot;.. time
		wait(1)
	end

	Button.BrickColor = normalcolor

	script.Parent.Name = name
end

Button.BrickColor = othercolor

Button.BrickColor = normalcolor

Button.Touched:connect(killall)</string>
