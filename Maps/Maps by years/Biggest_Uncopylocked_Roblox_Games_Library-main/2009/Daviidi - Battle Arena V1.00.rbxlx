			</CoordinateFrame>
			<string name="Name">Workspace</string>
			<Ref name="PrimaryPart">null</Ref>
			<bool name="archivable">true</bool>
		</Properties>
		<Item class="Script" referent="RBX2">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Spree - Transfer</string>
				<string name="Source">function matchteam(a,b)
	if a.Neutral == false and b.Neutral == false and a.TeamColor == b.TeamColor then return true else return false end
end

function died(player, human)
	local playerstats = player:findFirstChild(&quot;leaderstats&quot;)
	if playerstats ~= nil then
		local playerspree = playerstats:findFirstChild(&quot;Spree&quot;)
		local playerpoints = playerstats:findFirstChild(&quot;Points&quot;)
	end
	local killid = human:findFirstChild(&quot;creator&quot;)
	if killid ~= nil then
		local killer = killid.Value
		if killer ~= nil then
			local killerstats = killer:findFirstChild(&quot;leaderstats&quot;)
			if killer ~= player then
				if killerstats ~= nil then
					local killerspree = killerstats:findFirstChild(&quot;Spree&quot;)
					local killerpoints = killerstats:findFirstChild(&quot;Points&quot;)
				end
				if matchteam(killer, player) == false then
					if killerspree ~= nil then
						killerspree.Value = killerspree.Value + 1
						if killerpoints ~= nil then
							killerpoints.Value = killerpoints.Value + killerspree.Value
						end
						if playerspree ~= nil then
							killerspree.Value = killerspree.Value + math.floor(playerspree.Value/2)
						end
					end
				else -- A TKer, perhaps
					m = Instance.new(&quot;Hint&quot;)
					m.Text = killer.Name.. &quot;, you just Team Killed &quot;.. player.Name.. &quot;! You therefore lose 1 Point, If this was an accident please apologize to them. else go to a place where there ARE NO teams.&quot;
					m.Parent = killer
					if killerpoints ~= nil then
						killerpoints = killerpoints - 1 -- for TKing
						if killerpoints &lt; 0 then killerpoints = 0 end
					end
					if playerspree ~= nil then
						playerspree.Value = 0
					end
					wait(10)
					m:Remove()
					return -- we have done everything that needs to be done here.
				end
			end
		end
	end
	if playerspree ~= nil then
		playerspree.Value = 0
	end
end

function respawn(player)
	local hum = player.Character:findFirstChild(&quot;Humanoid&quot;)
	if hum ~= nil then
		hum.Died:connect(function() died(player,hum) end)
	end
end

function newplayer(player)
	local stats = Instance.new(&quot;IntValue&quot;)
	stats.Name = &quot;leaderstats&quot;
	local spree = Instance.new(&quot;IntValue&quot;)
	spree.Name = &quot;Spree&quot;
	local points= Instance.new(&quot;IntValue&quot;)
	points.Name = &quot;Points&quot;
	spree.Parent = stats
	points.Parent = stats
	stats.Parent = player
	player.Changed:connect(function(stat)
		if stat == &quot;Character&quot; then
			if player.Character ~= nil then
				respawn(player)
			end
		end
	end)
end

game.Players.PlayerAdded:connect(newplayer)
--END
