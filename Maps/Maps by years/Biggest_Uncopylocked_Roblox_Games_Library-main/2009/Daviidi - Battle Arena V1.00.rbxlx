					<string name="Source">Button = script.Parent.Head

normalcolor = Button.BrickColor
othercolor = BrickColor.new(26)

function test(p)
	if locked == false then return end
	if p.Parent == nil then return end
	local pl = game.Players:playerFromCharacter(p.Parent)
	if pl == nil then return end
	local s = pl:findFirstChild(&quot;leaderstats&quot;)
	if s == nil then return end
	local po = s:findFirstChild(&quot;Points&quot;)
	if po == nil then return end
	if po.Value &lt; 100 then
		local m = Instance.new(&quot;Hint&quot;)
		m.Text = pl.Name.. &quot;, you are not awesome enough to use this button, come back when you are more awesome.&quot;
		m.Parent = pl
		wait(2)
		m:Remove()
		return
	end
	locked = false
	local m = Instance.new(&quot;Message&quot;)
	m.Text = pl.Name.. &quot; has unlocked an awesome BURN button with their 100+ awesomeness!&quot;
	m.Parent = workspace
	wait(2)
	m:Remove()
end

function killall(hit)
	if hit:findFirstChild(&quot;BurnSCV1&quot;) == nil and hit.Anchored == false then
		local sc = script.BurnSCV1:Clone()
		sc.Disabled = false
		sc.Parent = hit
	end
end

Button.BrickColor = othercolor

name = script.Parent.Name
script.Parent.Name = name.. &quot; - LOCKED&quot;

locked = true

Button.Touched:connect(test)

while locked == true do wait() end

script.Parent.Name = name.. &quot; - EPIC DANGER!&quot;

Button.BrickColor = normalcolor

Button.Touched:connect(killall)</string>
					<bool name="archivable">true</bool>
