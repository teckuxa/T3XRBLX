						<string name="Source">if script.Parent.Parent.className ~= &quot;Backpack&quot; then print(&quot;NB&quot;) wait(math.huge) end

Cannon = script.Parent.Cannon.Value
Seat = Cannon.Seat
Ball = Cannon.CannonBall
Gyro = Cannon.CannonSwivel.Gyro
debounce = false

function computeDirection(vec)
	local lenSquared = vec.magnitude^2
	local invSqrt = 1 / math.sqrt(lenSquared)
	return Vector3.new(vec.x * invSqrt, vec.y * invSqrt, vec.z * invSqrt)
end

function fire(v)
		local dir = v - Ball.Position
		dir = computeDirection(dir)
		local pos = Ball.Position + (dir * 8)
		local p = Ball:Clone()
		p.CFrame = CFrame.new(pos, pos + dir)
		p.Velocity = (Ball.Position - v).unit * -300
		local decay = script.Parent.Decay:Clone()
		decay.Disabled = false
		decay.Parent = p
		local upforce = Instance.new(&quot;BodyForce&quot;)
		upforce.force = Vector3.new(0, p:GetMass() * 100, 0) -- not 196, so we get a slow gravitational pull
		upforce.Parent = p
		local cr = p.creator
		cr.Value = script.Parent.Parent.Parent
		p.Parent = game.Workspace
end

function click(mouse)
	if debounce == true then return end
	debounce = true
	fire(mouse.Hit.p)
	mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot;
	wait(2)
	debounce = false
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
end

function move(mouse)
	--local dir = (mouse.Hit.p - Cannon.CannonSwivel.Position).unit
	--Gyro.cframe = CFrame.new(Cannon.CannonSwivel.Position, Cannon.CannonSwivel.Position + dir)
end

function selected(mouse)
	print(&quot;Selected&quot;)
	if debounce == false then mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot; else mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot; end
	mouse.Move:connect(function() move(mouse) end)
	mouse.Button1Down:connect(function() click(mouse) end)
	move(mouse)
end

script.Parent.Selected:connect(selected)
print(&quot;Ready&quot;)</string>
						<bool name="archivable">true</bool>
