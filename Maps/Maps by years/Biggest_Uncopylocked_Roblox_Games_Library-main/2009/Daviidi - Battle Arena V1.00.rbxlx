				</Item>
				<Item class="Script" referent="RBX1834">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Killer</string>
						<string name="Source">function t(h)
	if h.Parent == nil then return end
	if h.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil then
		script.Parent.creator:Clone().Parent = h.Parent.Humanoid
		h.Parent.Humanoid.Health = 0
	end
	h:BreakJoints()
	if h.Name == script.Parent.Name then return end
	local ex = Instance.new(&quot;Explosion&quot;)
	ex.BlastPressure = 2000000
	ex.BlastRadius = 5
	ex.Position = script.Parent.Position
	ex.Parent = workspace
	ex.Hit:connect(function(p)
		if p.Parent == nil then return end
		if p.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil then
			script.Parent.creator:Clone().Parent = p.Parent.Humanoid
			p.Parent.Humanoid.Health = 0
		end
	end)
end

script.Parent.Touched:connect(t)
</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
