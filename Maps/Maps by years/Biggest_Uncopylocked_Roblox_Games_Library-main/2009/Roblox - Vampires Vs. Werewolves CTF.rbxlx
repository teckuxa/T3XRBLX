			<Item class="Script" referent="RBX4931">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">UnequipScript</string>
					<ProtectedString name="Source">local Tool = script.Parent
local humanoid = nil

function onEquipped()

	humanoid = Tool.Parent:FindFirstChild(&quot;Humanoid&quot;)

end

function onUnequipped()

	if humanoid ~= nil then
		if Tool.DanceObject.Value ~= nil then
			Tool.DanceObject.Value:Stop()
			Tool.DanceObject.Value:remove()
		end
	end

end

Tool.Equipped:connect(onEquipped)
Tool.Unequipped:connect(onUnequipped)
</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="LocalScript" referent="RBX4932">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">ClawScript</string>
					<ProtectedString name="Source">local Tool = script.Parent
local vCharacter = Tool.Parent
local dancer = nil

while (Tool:FindFirstChild(&quot;MakeWolfScript&quot;) == nil) do wait(.5) end

local makeWolf = Tool.MakeWolfScript

local secondSword = nil

local damage = 3

local LeftClawOut = false

Tool.Enabled = true
function onActivated()
	if not Tool.Enabled then return end
      Tool.Enabled = false

	vCharacter = Tool.Parent
	humanoid = vCharacter:FindFirstChild(&quot;Humanoid&quot;)
	if humanoid == nil then Tool.Enabled = true return end
	if vCharacter.Name == &quot;BackPack&quot; then Tool.Enabled = true return end
	if vCharacter:FindFirstChild(&quot;Lycanis&quot;) == nil and vCharacter:FindFirstChild(&quot;Lycanis Noctus&quot;) == nil then Tool.Enabled = true return end

	if humanoid.WalkSpeed == 0 then ToolEnabled = true return end -- don&apos;t use when balled

 -- play sound
	magicSound = Tool.Handle:FindFirstChild(&quot;MagicSound&quot;)
	if magicSound == nil then return end
	magicSound:Play()

-- rest of script
	damage = 16
	if LeftClawOut then
		if dancer ~= nil then 
			dancer:Stop()
			dancer:remove()
		end
		dancer = humanoid:LoadAnimation(Tool.wereslash2)
		Tool.DanceObject.Value = dancer
		dancer:Play()
		wait(.6)
		dancer:Stop()
		dancer:remove()
		LeftClawOut = false
	else
		dancer = humanoid:LoadAnimation(Tool.wereslash1)
		Tool.DanceObject.Value = dancer
		dancer:Play()
		wait(.6)
		dancer:Stop()
		dancer:remove()
		dancer = humanoid:LoadAnimation(Tool.werelefthandhold)
		Tool.DanceObject.Value = dancer
		LeftClawOut = true
		dancer:Play()
	end
	damage = 5
	Tool.Enabled = true
end


function onUnequipped()
	if dancer ~= nil then
		dancer:Stop()
		dancer:remove()
	end
	magicSound = Tool.Handle:FindFirstChild(&quot;MagicSound&quot;)
	if magicSound ~= nil then
		magicSound:Stop()
		magicSound.Parent = nil
	end
	if vCharacter.Name == &quot;Backpack&quot; then return end

	ls = Tool:FindFirstChild(&quot;LeftSlash&quot;)
	--[[lh = vCharacter:FindFirstChild(&quot;Left Arm&quot;)
	if lh ~= nil and ls ~= nil then
	--rh = vCharacter:FindFirstChild(&quot;Right Arm&quot;)
	--if rh ~= nil then
		--scw = lh:FindFirstChild(&quot;SecondClawWeld&quot;)
		--scw = vCharacter:FindFirstChild(&quot;SecondClawWeld&quot;)
		--scw = rh:FindFirstChild(&quot;SecondClawWeld&quot;)
		--scw = Tool.Handle:FindFirstChild(&quot;SecondClawWeld&quot;)
		scw = ls:FindFirstChild(&quot;SecondClawWeld&quot;)
		if scw ~= nil then scw.Parent = nil end
	end]]--
	
	if ls ~= nil then
		ls.Parent = nil
	end
end

sword = Tool.Handle


function blow(hit)
	local humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
	local vCharacter = Tool.Parent
	local vPlayer = game.Players:playerFromCharacter(vCharacter)
	local hum = vCharacter:findFirstChild(&quot;Humanoid&quot;) -- non-nil if tool held by a character
	if humanoid~=nil and humanoid ~= hum and hum ~= nil then
		-- final check, make sure sword is in-hand

		local right_arm = vCharacter:FindFirstChild(&quot;Right Arm&quot;)
		if (right_arm ~= nil) then
			local joint = right_arm:FindFirstChild(&quot;RightGrip&quot;)
			if (joint ~= nil and (joint.Part0 == sword or joint.Part1 == sword)) then
				if (humanoid.Parent:FindFirstChild(&quot;Lycanis&quot;) == nil) and (humanoid.Parent:FindFirstChild(&quot;Lycanis Noctus&quot;) == nil) then -- don&apos;t damage other werewolves!
					if (humanoid.Parent:FindFirstChild(&quot;Vampyrius&quot;) ~= nil) or humanoid.Parent:FindFirstChild(&quot;Vampyrius Maximus&quot;) ~= nil then
						if (humanoid.Parent:FindFirstChild(&quot;SilverDustBottle&quot;) ~= nil) and humanoid.Parent.SilverDustBottle:FindFirstChild(&quot;AntiLycan&quot;) ~= nil then humanoid:TakeDamage(damage/4)
						elseif (humanoid.Parent:FindFirstChild(&quot;SylverDustBottle&quot;) ~= nil) and humanoid.Parent.SylverDustBottle:FindFirstChild(&quot;AntiLycan&quot;) ~= nil then humanoid:TakeDamage(damage/4)	
						else humanoid:TakeDamage(damage) end
					else
						if (humanoid.Parent:FindFirstChild(&quot;SilverDustBottle&quot;) ~= nil) and humanoid.Parent.SilverDustBottle:FindFirstChild(&quot;AntiLycan&quot;) ~= nil then humanoid:TakeDamage(damage/4)	
						elseif (humanoid.Parent:FindFirstChild(&quot;SylverDustBottle&quot;) ~= nil) and humanoid.Parent.SylverDustBottle:FindFirstChild(&quot;AntiLycan&quot;) ~= nil then humanoid:TakeDamage(damage/4)	
						else humanoid:TakeDamage(damage) end
						if humanoid.Health &lt;= 0 then
							game.Players:GetPlayerFromCharacter(humanoid.Parent).TeamColor = BrickColor.new(&quot;Bright green&quot;)

							-- since teamcolor change made locally doesn&apos;t propagate on it&apos;s own to server, we need to run a non-local script with same command as above
							newWolf = makeWolf:Clone()
							newWolf.Parent = humanoid.Parent
							newWolf.Disabled = false
						end
					end
				end
			end
		end


	end
end


function onEquipped()
	vCharacter = Tool.Parent
	if vCharacter.Name == &quot;Backpack&quot; then return end

	secondSword = Tool:FindFirstChild(&quot;LeftSlash&quot;)
	if secondSword == nil then
		secondSword = Tool.Handle:Clone()
		secondSword.Name = &quot;LeftSlash&quot;
		secondSword.Parent = Tool
		secondSword.Touched:connect(blow)
	end

	LeftClawOut = false
	magicSound = Tool.Handle:FindFirstChild(&quot;MagicSound&quot;)
	if magicSound == nil then
		magicSound = Instance.new(&quot;Sound&quot;)
		magicSound.Parent = Tool.Handle
		magicSound.Volume = 1
		magicSound.SoundId = &quot;http://www.roblox.com/asset/?id=35571070&quot;
		magicSound.Name = &quot;MagicSound&quot;
	end
	--[[lh = vCharacter:FindFirstChild(&quot;Left Arm&quot;)
	--rh = vCharacter:FindFirstChild(&quot;Right Arm&quot;)
	if lh ~= nil then
		--scw = lh:FindFirstChild(&quot;SecondClawWeld&quot;)
		--scw = vCharacter:FindFirstChild(&quot;SecondClawWeld&quot;)
		--scw = Tool.Handle:FindFirstChild(&quot;SecondClawWeld&quot;)
		scw = secondSword:FindFirstChild(&quot;SecondClawWeld&quot;)
		if scw == nil then
			scw = Instance.new(&quot;Weld&quot;)
			scw.Name = &quot;SecondClawWeld&quot;
			scw.Part0 = lh
			scw.Part1 = secondSword
			--scw.Parent = lh
			--scw.Parent = vCharacter
			--scw.Parent = rh
			--scw.C1 = CFrame.Angles(0,0,-3*math.pi/4)*CFrame.new(0, 0, 1.2)*CFrame.Angles(math.pi/2, -math.pi/4, 0) -- old
			--scw.C1 = CFrame.Angles(0,-math.pi/2.5,-3*math.pi/4)*CFrame.new(0, 0, 1.2)*CFrame.Angles(math.pi/2, -math.pi/4, 0)  --new
			scw.C1 = CFrame.Angles(0,-math.pi/2.5,-3*math.pi/4)*CFrame.new(-0.2, 0.1, 1.0)*CFrame.Angles(math.pi/2, -math.pi/4, 0)  --newest
			--scw.Parent = Tool.Handle -- game.Workspace
			scw.Parent = secondSword
		end
	end--]]
end

sword.Touched:connect(blow)

Tool.Activated:connect(onActivated)
Tool.Equipped:connect(onEquipped)
Tool.Unequipped:connect(onUnequipped)

</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX4933">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">SecondClawScript</string>
					<ProtectedString name="Source">local Tool = script.Parent
local vCharacter = Tool.Parent

function onUnequipped()
	lh = vCharacter:FindFirstChild(&quot;Left Arm&quot;)
	if lh ~= nil then
	--rh = vCharacter:FindFirstChild(&quot;Right Arm&quot;)
	--if rh ~= nil then
		--scw = lh:FindFirstChild(&quot;SecondClawWeld&quot;)
		--scw = vCharacter:FindFirstChild(&quot;SecondClawWeld&quot;)
		--scw = rh:FindFirstChild(&quot;SecondClawWeld&quot;)
		--scw = Tool.Handle:FindFirstChild(&quot;SecondClawWeld&quot;)
		scw = vCharacter:FindFirstChild(&quot;SecondClawWeld&quot;)
		if scw ~= nil then scw.Parent = nil end
	end
end

function onEquipped()
	vCharacter = Tool.Parent
	lh = vCharacter:FindFirstChild(&quot;Left Arm&quot;)
	--rh = vCharacter:FindFirstChild(&quot;Right Arm&quot;)
	if lh ~= nil then
		--scw = lh:FindFirstChild(&quot;SecondClawWeld&quot;)
		--scw = vCharacter:FindFirstChild(&quot;SecondClawWeld&quot;)
		--scw = Tool.Handle:FindFirstChild(&quot;SecondClawWeld&quot;)
		scw = vCharacter:FindFirstChild(&quot;SecondClawWeld&quot;)
		if scw == nil then
			scw = Instance.new(&quot;Weld&quot;)
			scw.Name = &quot;SecondClawWeld&quot;
			scw.Part0 = lh
			secondSword = Tool:FindFirstChild(&quot;LeftSlash&quot;)
			if secondSword == nil then wait(1) secondSword = Tool:FindFirstChild(&quot;LeftSlash&quot;) end
			if secondSword == nil then return end
			scw.Part1 = secondSword
			--scw.Parent = lh
			--scw.Parent = vCharacter
			--scw.Parent = rh
			--scw.C1 = CFrame.Angles(0,0,-3*math.pi/4)*CFrame.new(0, 0, 1.2)*CFrame.Angles(math.pi/2, -math.pi/4, 0) -- old
			--scw.C1 = CFrame.Angles(0,-math.pi/2.5,-3*math.pi/4)*CFrame.new(0, 0, 1.2)*CFrame.Angles(math.pi/2, -math.pi/4, 0)  --new
			scw.C1 = CFrame.Angles(0,-math.pi/2.5,-3*math.pi/4)*CFrame.new(-0.2, 0.1, 1.0)*CFrame.Angles(math.pi/2, -math.pi/4, 0)  --newest
			--scw.Parent = Tool.Handle -- game.Workspace
			scw.Parent = vCharacter
		end
	end
end


Tool.Equipped:connect(onEquipped)
Tool.Unequipped:connect(onUnequipped)
