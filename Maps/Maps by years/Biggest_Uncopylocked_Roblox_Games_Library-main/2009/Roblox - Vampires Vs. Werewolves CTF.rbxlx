					<string name="Name">PumpkinPatchRegulator</string>
					<ProtectedString name="Source">patch = script.Parent
pumpkinCounter = {}
pumpkinList = {}
cloneList = {}
children = patch:GetChildren()
numBombs = 0
for i = 1, #children do
	if children[i].className == &quot;Tool&quot; then
		numBombs = numBombs + 1
		pumpkinList[numBombs] = children[i]
		cloneList[numBombs] = children[i]:Clone()
		pumpkinCounter[numBombs] = 0
	end
end


function resetItem(i)
	pumpkinList[i] = cloneList[i]
	pumpkinList[i].Parent = patch
	cloneList[i] = pumpkinList[i]:Clone()
end

-- appears that pumpkin[i].Parent doesn&apos;t get set to nil when char dies but rather gets set to some outdated reference; so must use a different test for onPlayerDeathResetItem function!!!
while true do
	print(&quot;running&quot;)
	for i = 1, #pumpkinList do
		--if pumpkinList[i] ~= nil then print(pumpkinList[i].Parent) end
		if pumpkinList[i] == nil or pumpkinList[i].Parent == nil or pumpkinList[i]:FindFirstChild(&quot;Handle&quot;) == nil then
			print(&quot;resetting item&quot;)
			resetItem(i)
		elseif pumpkinList[i].Parent == game.Workspace then
			if (pumpkinCounter[i] &gt; 1) then  -- between 20 and 30 seconds (change to &gt; 1 when done with testing/debugging)
				pumpkinCounter[i] = 0
				print(&quot;in workspace for too long...  starting reset process&quot;)
				pumpkinList[i].Parent = nil
				resetItem(i)
			else
				pumpkinCounter[i] = pumpkinCounter[i] + 1
			end
		else
			humanoid = pumpkinList[i].Parent:FindFirstChild(&quot;Humanoid&quot;)
			
			if pumpkinList[i].Parent.Name == &quot;Backpack&quot; then
				pPlay = pumpkinList[i].Parent.Parent
				if pPlay == nil then
					print(&quot;pPlay nil!&quot;)
					resetItem(i)
				else
					pChar = pPlay.Character
					if pChar == nil then
						print(&quot;pChar nil!&quot;)
						resetItem(i)
					else
						humanoid = pChar:FindFirstChild(&quot;Humanoid&quot;)
						if humanoid == nil or humanoid.Health &lt;= 0 then
							print(&quot;humanoidNil or charDeath!&quot;)
							resetItem(i)
						end
					end
				end
			elseif humanoid ~= nil and (humanoid.Health &lt;= 0) then
				print(&quot;Dead Man!&quot;)
				resetItem(i)
			end
			pumpkinCounter[i] = 0
		end
	end
	wait(10) -- respawns checked for every 10 seconds
end
