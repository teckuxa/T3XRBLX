					<string name="Name">Script</string>
					<ProtectedString name="Source">-- VAMPIRE FACE TEXTURE = 29532363

local Tool = script.Parent


function drinkBottle()
	Tool.GripForward = Vector3.new(0, -.707, -.707)
	Tool.GripPos = Vector3.new(-1.5, -.2, -.6)
	Tool.GripRight = Vector3.new(-1, 0, 0)
	Tool.GripUp = Vector3.new(0, -.707, .707)
end

function lowerBottle()
	Tool.GripForward = Vector3.new(0, -1, 0)
	Tool.GripPos = Vector3.new(0, .3, 0)
	Tool.GripRight = Vector3.new(-1, 0, 0)
	Tool.GripUp = Vector3.new(0, 0, 1)
end


Tool.Enabled = true

function onActivated()
	if not Tool.Enabled then return end
	Tool.Enabled = false
	
	vCharacter = Tool.Parent

	-- if already a super-vamp, do nothing
	vampireTag = vCharacter:FindFirstChild(&quot;Vampyrius Maximus&quot;)
	if vampireTag ~= nil then Tool.Enabled = true return end

	-- Vampyrification :D
	drinkBottle()
	-- make them able to do vampire stuff
	vampireTag = vCharacter:FindFirstChild(&quot;Vampyrius&quot;)
	if vampireTag ~= nil then
		vampireTag.Name = &quot;Vampyrius Maximus&quot;
		vampireTag.Value = 0
	else
		vampireTag = Instance.new(&quot;NumberValue&quot;)
		vampireTag.Name = &quot;Vampyrius&quot;
		vampireTag.Parent = vCharacter
		vampireTag.Value = 0
	end

	-- and can&apos;t be werewolf and vamp at once (can switch between the two if keep drinking potions though)
	wolfTag = vCharacter:FindFirstChild(&quot;Lycanis Noctus&quot;)
	if wolfTag ~= nil then wolfTag.Parent = nil end
	wolfTag = vCharacter:FindFirstChild(&quot;Lycanis&quot;)
	if wolfTag ~= nil then wolfTag.Parent = nil end

	-- play transmogrification sound
	magicSound = Tool.Handle:FindFirstChild(&quot;MagicSound&quot;)
	if magicSound == nil then
		magicSound = Instance.new(&quot;Sound&quot;)
		magicSound.SoundId = &quot;http://www.roblox.com/asset/?id=36431384&quot;
		magicSound.Name = &quot;MagicSound&quot;
		magicSound.Parent = Tool.Handle
		magicSound.Volume = 1
	end
	magicSound:Play()

	-- remove all hats
	charParts = vCharacter:GetChildren()
	for i = 1, #charParts do
		currPart = charParts[i]
		if currPart.className == &quot;Hat&quot; then
			currPart:Remove()
		end
		if currPart.className == &quot;CharacterMesh&quot; then
			if currPart.MeshId == 27130997 or currPart.MeshId == 27131042 or currPart.MeshId == 27131194 or currPart.MeshId == 27128722 or currPart.MeshId == 27131177 then
				currPart:Remove() -- no werewolf body allowed on a vampire!
			end
		end
	end
	
	-- any body stored from lycanthropization should be returned
	headParts = vCharacter.Head:GetChildren()
	for i = 1, #headParts do
		currPart = headParts[i]
		if currPart.className == &quot;CharacterMesh&quot; then
			currPart.Parent = vCharacter
		end
	end

	--It&apos;s like redbull; it gives you WIIIIIINGS
	--this call will cause a &quot;wait&quot; until the data comes back
	-- 23264296 is albino bat vampire
	-- 19399858 is wings
	local root = game:GetService(&quot;InsertService&quot;):LoadAsset(19399858)

	local instances = root:GetChildren()
	if #instances == 0 then
		root:Remove()
		return
	end

	--root = root:FindFirstChild(&quot;Cupcake&quot;)
	root = root:GetChildren()
	if root ~= nil then root = root[1] end
	if root ~= nil then
		-- got wings...  add to char
		--local newWings = root:Clone()
		--newWings.Parent = vCharacter
		root.Handle.Size = Vector3.new(1,1,1)
		root.Parent = vCharacter
	end

	if vampireTag.Name == &quot;Vampyrius Maximus&quot; then
		root2 = game:GetService(&quot;InsertService&quot;):LoadAsset(23264296)
		instances = root2:GetChildren()
		if #instances == 0 then
			root2:Remove()
			return
		end
	
		--root2 = root2:FindFirstChild(&quot;Cupcake&quot;)
		root2 = root2:GetChildren()
		if root2 ~= nil then root2 = root2[1] end
		if root2 ~= nil then
			-- got wings...  add to char
			--local newWings = root2:Clone()
			--newWings.Parent = vCharacter
			root2.Handle.Size = Vector3.new(1,1,1)
			root2.Parent = vCharacter
		end

		vCharacter.Head.Transparency = 1
		face = vCharacter.Head:FindFirstChild(&quot;face&quot;)
		if face ~= nil then face.Parent = nil end
	else
		-- make vampire face
		head = vCharacter.Head
		face = head:FindFirstChild(&quot;face&quot;)
		if face == nil then
			face = Instance.new(&quot;Decal&quot;)
			face.Name = &quot;face&quot;
			face.Parent = head
		end
		face.Texture = &quot;http://www.roblox.com/asset/?id=29532362&quot;
		vCharacter.Head.Transparency = 0
	end

	-- colordrain
	local white = nil
	if vampireTag.Name == &quot;Vampyrius&quot; then white = BrickColor.new(Color3.new(1,1,1))
	else white = BrickColor.new(&quot;Pastel violet&quot;) end

	vCharacter.Head.BrickColor = white
	torso = vCharacter:FindFirstChild(&quot;Torso&quot;)
	rArm = vCharacter:FindFirstChild(&quot;Right Arm&quot;)
	lArm = vCharacter:FindFirstChild(&quot;Left Arm&quot;)
	lLeg = vCharacter:FindFirstChild(&quot;Left Leg&quot;)
	rLeg = vCharacter:FindFirstChild(&quot;Right Leg&quot;)
	if torso ~= nil then torso.BrickColor = white end
	if rArm ~= nil then rArm.BrickColor = white end
	if lArm ~= nil then lArm.BrickColor = white end
	if rLeg ~= nil then rLeg.BrickColor = white end
	if lLeg ~= nil then lLeg.BrickColor = white end

	--vPlayer.TeamColor = &quot;Black&quot;

	wait(1)
	lowerBottle()
	
	local reloadTime = 29
	wait(reloadTime)

	Tool.Enabled = true
end

function onEquipped()
	magicSound = Tool.Handle:FindFirstChild(&quot;MagicSound&quot;)
	if magicSound == nil then
		magicSound = Instance.new(&quot;Sound&quot;)
		magicSound.Parent = Tool.Handle
		magicSound.Volume = 1
		magicSound.SoundId = &quot;http://www.roblox.com/asset/?id=36431384&quot;
		magicSound.Name = &quot;MagicSound&quot;
	end
end

function onUnequipped()
	magicSound = Tool.Handle:FindFirstChild(&quot;MagicSound&quot;)
	if magicSound ~= nil then
		magicSound:Stop()
		magicSound.Parent = nil
	end
end

Tool.Activated:connect(onActivated)
Tool.Equipped:connect(onEquipped)
Tool.Unequipped:connect(onUnequipped)
</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="LocalScript" referent="RBX4861">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Local Gui</string>
					<ProtectedString name="Source">local Tool = script.Parent;
local myMouse = nil


enabled = true
function onButton1Down(mouse)
	if not enabled then
		return
	end
	print(&quot;ending&quot;)
	enabled = false

	while Tool.Enabled do
		wait(.01)
	end

	print(&quot;Setting Mouse To Wait&quot;)
	if myMouse ~= nil then myMouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot; end

	while not Tool.Enabled do
		wait(.01)
	end

	print(&quot;Setting Mouse to Go&quot;)
	if myMouse ~= nil then myMouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot; end

	enabled = true
end

function onEquippedLocal(mouse)

	if mouse == nil then
		print(&quot;Mouse not found&quot;)
		return 
	end

	myMouse = mouse

	if Tool.Enabled then mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	else mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot; end
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end


Tool.Equipped:connect(onEquippedLocal)
