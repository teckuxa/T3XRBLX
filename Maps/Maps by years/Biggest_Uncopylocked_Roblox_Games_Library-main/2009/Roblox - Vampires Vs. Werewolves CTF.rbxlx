					<ProtectedString name="Source">ball = script.Parent

HitSound = Instance.new(&quot;Sound&quot;)
HitSound.Name = &quot;HitSound&quot;
HitSound.SoundId = &quot;http://www.roblox.com/asset/?id=11945266&quot;
HitSound.Parent = ball
HitSound.Volume = 1

print(&quot;DAMAGE: &quot; .. script.Damage.Value)

function onTouched(hit)
	if hit == nil or hit.Parent == nil then return end
	local humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;)

	if humanoid ~= nil then
		if (hit.Parent:FindFirstChild(&quot;Vampyrius&quot;) == nil) and (hit.Parent:FindFirstChild(&quot;Vampyrius Maximus&quot;) == nil) then
			HitSound:Play()
			
			if (hit.Parent:FindFirstChild(&quot;Lycanis&quot;) ~= nil) or (hit.Parent:FindFirstChild(&quot;Lycanis Noctus&quot;) ~= nil) then
				if (humanoid.Parent:FindFirstChild(&quot;GarlicNecklace&quot;) ~= nil) and humanoid.Parent.GarlicNecklace:FindFirstChild(&quot;AntiVamp&quot;) ~= nil then humanoid:TakeDamage(script.Damage.Value/4)	
				elseif (humanoid.Parent:FindFirstChild(&quot;GarlickNecklace&quot;) ~= nil) and humanoid.Parent.GarlickNecklace:FindFirstChild(&quot;AntiVamp&quot;) ~= nil then humanoid:TakeDamage(script.Damage.Value/4)	
				else humanoid:TakeDamage(script.Damage.Value) end
			else
				if (humanoid.Parent:FindFirstChild(&quot;GarlicNecklace&quot;) ~= nil) and humanoid.Parent.GarlicNecklace:FindFirstChild(&quot;AntiVamp&quot;) ~= nil then humanoid:TakeDamage(script.Damage.Value/4)	
				elseif (humanoid.Parent:FindFirstChild(&quot;GarlickNecklace&quot;) ~= nil) and humanoid.Parent.GarlickNecklace:FindFirstChild(&quot;AntiVamp&quot;) ~= nil then humanoid:TakeDamage(script.Damage.Value/4)	
				else humanoid:TakeDamage(script.Damage.Value) end
				if humanoid.Health &lt;= 0 then
					game.Players:GetPlayerFromCharacter(humanoid.Parent).TeamColor = BrickColor.new(&quot;Black&quot;)
				end
			end

			ball.Parent = nil
		end
	else

--	HitSound:Play()
--	ball.Parent = nil
	--print(&quot;Hit Ground At: &quot;)
	--print(ball.Position)
		ball.Parent = nil
	end
end


connection = ball.Touched:connect(onTouched)

wait(5)
ball.Parent = nil
