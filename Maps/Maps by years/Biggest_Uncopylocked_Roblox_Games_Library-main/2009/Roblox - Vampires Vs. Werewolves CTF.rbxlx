					<string name="Name">Script</string>
					<ProtectedString name="Source">local part = script.Parent

part.Touched:connect(function(part)

	local humanoid = part.Parent:FindFirstChild(&quot;Humanoid&quot;)
	if humanoid then
		part.Parent:BreakJoints()
	end

end)</ProtectedString>
