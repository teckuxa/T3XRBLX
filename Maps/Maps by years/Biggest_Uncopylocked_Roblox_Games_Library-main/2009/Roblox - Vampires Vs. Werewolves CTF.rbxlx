						<string name="Name">FlagScript</string>
						<ProtectedString name="Source">flagPiece = script.Parent
Tool = flagPiece.Parent
vCharacter = Tool.Parent
isEquipped = true

function onEquip()
	flagPiece.Transparency = 0
	newBG = flagPiece:FindFirstChild(&quot;FlagGyro&quot;)
	if newBG ~= nil then
		newBG.Parent = nil
	end
	isEquipped = true
end

function onUnequip() -- don&apos;t put in backpack; drop into workspace (as an object, not a tool)
	--Tool.Handle.CanCollide = true
	--flagPiece = Tool.Handle

--	wait(.5)

	newBG = flagPiece:FindFirstChild(&quot;FlagGyro&quot;)
	if newBG == nil then
		newBG = Instance.new(&quot;BodyGyro&quot;)
		newBG.Name = &quot;FlagGyro&quot;
		--newBG.cframe = CFrame.Angles(-math.pi/2,0,0)
		eAngleGuess1, eAngleGuess2, eAngleGuess3 = flagPiece.CFrame:toEulerAnglesXYZ()
		newBG.cframe = CFrame.Angles(-math.pi/2, 0, eAngleGuess3)
		newBG.maxTorque = Vector3.new(100000000,100000000,100000000)
		newBG.Parent = flagPiece
		-- third axis is the one we want free (that&apos;s rotation around z axis)
		--flagPiece.CFrame = CFrame.new(flagPiece.Position.X, flagPiece.Position.Y, flagPiece.Position.Z)*CFrame.Angles(-math.pi/2, 0, 0)
	end

	flagPiece.Position = vCharacter.Torso.Position + vCharacter.Torso.CFrame:vectorToWorldSpace(Vector3.new(0,0,-1)).unit*7 + vCharacter.Torso.CFrame:vectorToWorldSpace(Vector3.new(0,1,0)).unit*7
	flagPiece.Size = Vector3.new(6,1.2,10)
	flagPiece.Parent = game.Workspace.Flags

	wait(.5)

	Tool.Parent = nil -- get rid of FlagTool vessel
	flagPiece.Name = &quot;FlagPiece&quot;
	flagPiece.FlagScript.Disabled = true
	flagPiece.FlagStandScript.Disabled = false

--[[Tool.Handle.Position = vCharacter.Torso.Position + vCharacter.Torso.CFrame:vectorToWorldSpace(Vector3.new(0,0,-1)).unit*7 + vCharacter.Torso.CFrame:vectorToWorldSpace(Vector3.new(0,1,0)).unit*7
	tempFlagScript = Tool.FlagScript
	tempFlagStandScript = Tool.FlagStandScript
	Tool.Handle.Name = &quot;FlagPiece&quot;	
	Tool.Handle.Parent = game.Workspace
	
	
	Tool.Parent = nil
	tempFlagScript.Disabled = false
	--Tool.Parent = game.Workspace
	--rArm = vCharacter:FindFirstChild(&quot;Right Arm&quot;)
	--if rArm ~= nil then
	--	flagWeld = rArm:FindFirstChild(&quot;FlagWeld&quot;)
	--	if flagWeld ~= nil then
	--		flagWeld.Parent = nil
	--	end
	--end]]--

	-- add a bodygyro so flag always drops down straight...  then make sure other team CAN&apos;T pick up flag after it&apos;s dropped (drop flagspawner instead of flag...)
	-- also make sure killing a person just drops the flag, and then after 30 seconds of non-ownership, should be returned to original flagspawner

	print(&quot;UNEQUIPPING&quot;)
	isEquipped = false
end

Tool.Equipped:connect(onEquip)
Tool.Unequipped:connect(onUnequip)

-- check for carrier-death without unequipping
while true do
	if (Tool.Parent:FindFirstChild(&quot;Humanoid&quot;) == nil) and isEquipped then 
		-- player dead, so unequip
		onUnequip() 
	end
	wait(1)
end
