function onPlayerRespawned(player)
-- just added
	if player.Character ~= nil then
		print(&quot;character was not nil&quot;)
		local humanoid = player.Character:FindFirstChild(&quot;Humanoid&quot;)
		if humanoid ~= nil then
			local h = humanoid
			humanoid.Died:connect(function() onHumanoidDied(player, h) end )
		end
	end	
	-- /just added

	-- remove all gear (necessary to allow them to bring in silver dust bottles and garlic necklaces)
	packItems = player.Backpack:GetChildren()
	for i = 1, #packItems do
		if (packItems[i].Name ~= &quot;SilverDustBottle&quot;) and (packItems[i].Name ~= &quot;GarlicNecklace&quot;) then packItems[i]:remove() end
	end

	starterGear = player:FindFirstChild(&quot;StarterGear&quot;)
	if starterGear ~= nil then
	starterItems = player.StarterGear:GetChildren()
	for i = 1, #starterItems do
		if (starterItems[i].Name ~= &quot;SilverDustBottle&quot;) and (starterItems[i].Name ~= &quot;GarlicNecklace&quot;) then starterItems[i]:remove() end
	end
	end

	-- everyone gets reset
	if player.Backpack:FindFirstChild(&quot;Reset&quot;) == nil then
		game.Lighting:FindFirstChild(&quot;Reset&quot;):Clone().Parent = player.Backpack 
	end

	if player.Name == &quot;TudorTown&quot; then
		game.Lighting:FindFirstChild(&quot;Teleport&quot;):Clone().Parent = player.Backpack 
		game.Lighting:FindFirstChild(&quot;SilverDustBottle&quot;):Clone().Parent = player.Backpack
		game.Lighting:FindFirstChild(&quot;GarlicNecklace&quot;):Clone().Parent = player.Backpack
	end


	if player.TeamColor.Name == &quot;White&quot; then
		-- just added
		-- add a &quot;BeastMaster&quot; tag
		bmTag = Instance.new(&quot;NumberValue&quot;)
		bmTag.Value = 0
		bmTag.Name = &quot;BeastKills&quot;
		bmTag.Parent = player.Character
		-- /just added

		-- start only with pitchfork
		if player.Backpack:FindFirstChild(&quot;Pitchfork&quot;) == nil then
			game.Lighting:FindFirstChild(&quot;Pitchfork&quot;):Clone().Parent = player.Backpack
		end
	elseif player.TeamColor.Name == &quot;Black&quot; then
		if player.Backpack:FindFirstChild(&quot;VampirePotion&quot;) == nil then
			game.Lighting:FindFirstChild(&quot;VampirePotion&quot;):Clone().Parent = player.Backpack
		end
		if player.Backpack:FindFirstChild(&quot;Image&quot;) == nil then
			game.Lighting:FindFirstChild(&quot;Image&quot;):Clone().Parent = player.Backpack
		end
		if player.Backpack:FindFirstChild(&quot;Cloak&quot;) == nil then
			game.Lighting:FindFirstChild(&quot;Cloak&quot;):Clone().Parent = player.Backpack
		end
		if player.Backpack:FindFirstChild(&quot;Float&quot;) == nil then
			game.Lighting:FindFirstChild(&quot;Float&quot;):Clone().Parent = player.Backpack
		end
		if player.Backpack:FindFirstChild(&quot;Fire&quot;) == nil then
			game.Lighting:FindFirstChild(&quot;Fire&quot;):Clone().Parent = player.Backpack
		end
		autoVampyrize(player)
	else
		if player.Backpack:FindFirstChild(&quot;WerewolfPotion&quot;) == nil then
			game.Lighting:FindFirstChild(&quot;WerewolfPotion&quot;):Clone().Parent = player.Backpack
		end
		if player.Backpack:FindFirstChild(&quot;Leap&quot;) == nil then
			game.Lighting:FindFirstChild(&quot;Leap&quot;):Clone().Parent = player.Backpack
		end
		if player.Backpack:FindFirstChild(&quot;Slash&quot;) == nil then
			game.Lighting:FindFirstChild(&quot;Slash&quot;):Clone().Parent = player.Backpack
		end
		if player.Backpack:FindFirstChild(&quot;Charge&quot;) == nil then
			game.Lighting:FindFirstChild(&quot;Charge&quot;):Clone().Parent = player.Backpack
		end
		if player.Backpack:FindFirstChild(&quot;Ball&quot;) == nil then
			game.Lighting:FindFirstChild(&quot;Ball&quot;):Clone().Parent = player.Backpack
		end
		autoWolf(player)
	end
end

function resetTeams()
	-- assign everyone back to townsfolk, select vamps and wolves, kill everyone to force respawn

	players = game.Players:GetPlayers()

	for i=1,#players do
		players[i].TeamColor = BrickColor.new(&quot;White&quot;)
	end

	-- make up to 3 vamps and wolves
	for i=1,6 do
		if (#players &gt; 0) then
			local j = math.random(#players)
			
			if (j % 2 == 0) then
				players[j].TeamColor = BrickColor.new(&quot;Black&quot;)
			else
				players[j].TeamColor = BrickColor.new(&quot;Bright green&quot;)
			end
			table.remove(players, j)
		end
	end

	players = game.Players:GetPlayers()

	for i=1,#players do
		if players[i].Character ~= nil then
			local h = players[i].Character:FindFirstChild(&quot;Humanoid&quot;)
			if h ~= nil then
				h.Health = 0
			end
		end
	end
end

function onPlayerEntered(newPlayer)
	numWolves = 0
	numVamps = 0
	playerList = game.Players:GetPlayers()

	for i = 1, #playerList do
		if playerList[i].TeamColor.Name == &quot;Black&quot; then numVamps = numVamps + 1 end
		if playerList[i].TeamColor.Name == &quot;Bright green&quot; then numWolves = numWolves + 1 end
	end



	if numWolves &lt; 3 or numVamps &lt; 3 or time_remaining &lt; 100 then
		if numVamps &lt;= numWolves then
			newPlayer.TeamColor = BrickColor.new(&quot;Black&quot;)
		else
			newPlayer.TeamColor = BrickColor.new(&quot;Bright green&quot;)
		end
	else
		newPlayer.TeamColor = BrickColor.new(&quot;White&quot;)
	end


	local stats = Instance.new(&quot;IntValue&quot;)
	stats.Name = &quot;leaderstats&quot;

	local c = Instance.new(&quot;IntValue&quot;)
	c.Name = &quot;Grabs&quot;
	c.Value = 0
	c.Parent = stats

	local d = Instance.new(&quot;IntValue&quot;)
	d.Name = &quot;Captures&quot;
	d.Value = 0
	d.Parent = stats

	stats.Parent = newPlayer 

	newPlayer.Changed:connect(function (property)
		if (property == &quot;Character&quot;) then
			onPlayerRespawned(newPlayer)
		end
	end)

	wait(1.5)
	-- remove all gear (necessary to allow them to bring in silver dust bottles and garlic necklaces)
	packItems = newPlayer.Backpack:GetChildren()
	for i = 1, #packItems do
		if (packItems[i].Name ~= &quot;SilverDustBottle&quot;) and (packItems[i].Name ~= &quot;GarlicNecklace&quot;) then packItems[i]:remove() end
	end

	starterGear = newPlayer:FindFirstChild(&quot;StarterGear&quot;)
	if starterGear ~= nil then
	starterItems = newPlayer.StarterGear:GetChildren()
	for i = 1, #starterItems do
		if (starterItems[i].Name ~= &quot;SilverDustBottle&quot;) and (starterItems[i].Name ~= &quot;GarlicNecklace&quot;) then starterItems[i]:remove() end
	end
	end

	newPlayer.Character.Head:remove() -- force a respawn so they don&apos;t get extra gear...  is this really the only way we can do this?
end

game.Players.ChildAdded:connect(onPlayerEntered)




while true do
	time_remaining = round_time
	while time_remaining &gt; 0 do
		wait(1)
		time_remaining = time_remaining - 1
		updateGameHUDs(&quot;Time Remaining&quot;, time_remaining ..  &quot; Seconds&quot;)
	end


	-- declare winner

	local vamp_score = 0
	local wolf_score = 0

	local nixVampTeam = false
	local nixWolfTeam = false

	local players = game.Players:GetPlayers()
	for i=1,#players do
		local stats = players[i]:FindFirstChild(&quot;leaderstats&quot;)
		if (stats ~= nil) then
			local caps = stats:FindFirstChild(&quot;Captures&quot;)
			if (caps ~= nil) then
				if (players[i].TeamColor.Name == &quot;Black&quot;) then
					vamp_score = vamp_score + caps.Value
					if caps.Value &gt; 3 then nixVampTeam = true end
				else
					wolf_score = wolf_score + caps.Value
					if caps.Value &gt; 3 then nixWolfTeam = true end
				end
			end
			caps.Value = 0
			local grabs = stats:FindFirstChild(&quot;Grabs&quot;)
			if (grabs ~= nil) then grabs.Value = 0 end
		end
	end

	if (vamp_score &gt; wolf_score) then
		updateGameHUDs(&quot;VAMPIRES WIN!&quot;, &quot;Final score: &quot; .. vamp_score .. &quot; to &quot; .. wolf_score)
		--giveBadges(&quot;Black&quot;)
	end

	if (vamp_score &lt; wolf_score) then
		updateGameHUDs(&quot;WEREWOLVES WIN!&quot;, &quot;Final score: &quot; .. wolf_score .. &quot; to &quot; .. vamp_score)
		--giveBadges(&quot;Bright green&quot;)
	end

	if (vamp_score == wolf_score) then
		updateGameHUDs(&quot;EVERYONE LOSES!&quot;, &quot;Ties are pathetic.&quot;)
	end
	
	if (vamp_score &gt; 5) and not nixVampTeam then
		--giveTeamworkBadges(&quot;Black&quot;)
	end

	if (wolf_score &gt; 5) and not nixWolfTeam then
		--giveTeamworkBadges(&quot;Bright green&quot;)
	end

	--giveBadges(&quot;White&quot;)

	wait(5)

	updateGameHUDs(&quot;Resetting Map&quot;, &quot;You may experience lag&quot;)

	wait(1)

	
	

	-- regen map
	doRegen()

	wait(1)
	updateGameHUDs(&quot;New Teams&quot;, &quot;Randomly assigning teams&quot;)
	wait(1)
	-- reset teams
	resetTeams()

	updateGameHUDs(&quot;GAME ON&quot;, &quot;A new game has started!&quot;)
	wait(5)

	

end

--wait(20)

--ultimateReset()



--[[print(&quot;LinkedLeaderboard script version 5.00 loaded&quot;)

stands = {}
CTF_mode = false


function onHumanoidDied(humanoid, player)
	local stats = player:findFirstChild(&quot;leaderstats&quot;)
	if stats ~= nil then
		local deaths = stats:findFirstChild(&quot;Wipeouts&quot;)
		deaths.Value = deaths.Value + 1

		-- do short dance to try and find the killer

		local killer = getKillerOfHumanoidIfStillInGame(humanoid)

		handleKillCount(humanoid, player)
	end
end

function onPlayerRespawn(property, player)
	-- need to connect to new humanoid
	
	if property == &quot;Character&quot; and player.Character ~= nil then
		local humanoid = player.Character.Humanoid
			local p = player
			local h = humanoid
			humanoid.Died:connect(function() onHumanoidDied(h, p) end )
	end
end

function getKillerOfHumanoidIfStillInGame(humanoid)
	-- returns the player object that killed this humanoid
	-- returns nil if the killer is no longer in the game

	-- check for kill tag on humanoid - may be more than one - todo: deal with this
	local tag = humanoid:findFirstChild(&quot;creator&quot;)

	-- find player with name on tag
	if tag ~= nil then
		
		local killer = tag.Value
		if killer.Parent ~= nil then -- killer still in game
			return killer
		end
	end

	return nil
end

function handleKillCount(humanoid, player)
	local killer = getKillerOfHumanoidIfStillInGame(humanoid)
	if killer ~= nil then
		local stats = killer:findFirstChild(&quot;leaderstats&quot;)
		if stats ~= nil then
			local kills = stats:findFirstChild(&quot;KOs&quot;)
			if killer ~= player then
				kills.Value = kills.Value + 1
				
			else
				kills.Value = kills.Value - 1
				
			end
		end
	end
end


-----------------------------------------------



function findAllFlagStands(root)
	local c = root:children()
	for i=1,#c do
		if (c[i].className == &quot;Model&quot; or c[i].className == &quot;Part&quot;) then
			findAllFlagStands(c[i])
		end
		if (c[i].className == &quot;FlagStand&quot;) then
			table.insert(stands, c[i])
		end
	end
end

function hookUpListeners()
	for i=1,#stands do
		stands[i].FlagCaptured:connect(onCaptureScored)
	end
end

function onPlayerEntered(newPlayer)

	if CTF_mode == true then

		local stats = Instance.new(&quot;IntValue&quot;)
		stats.Name = &quot;leaderstats&quot;

		local captures = Instance.new(&quot;IntValue&quot;)
		captures.Name = &quot;Captures&quot;
		captures.Value = 0


		captures.Parent = stats

		-- VERY UGLY HACK
		-- Will this leak threads?
		-- Is the problem even what I think it is (player arrived before character)?
		while true do
			if newPlayer.Character ~= nil then break end
			wait(5)
		end

		stats.Parent = newPlayer

	else

		local stats = Instance.new(&quot;IntValue&quot;)
		stats.Name = &quot;leaderstats&quot;

		local kills = Instance.new(&quot;IntValue&quot;)
		kills.Name = &quot;KOs&quot;
		kills.Value = 0

		local deaths = Instance.new(&quot;IntValue&quot;)
		deaths.Name = &quot;Wipeouts&quot;
		deaths.Value = 0

		kills.Parent = stats
		deaths.Parent = stats

		-- VERY UGLY HACK
		-- Will this leak threads?
		-- Is the problem even what I think it is (player arrived before character)?
		while true do
			if newPlayer.Character ~= nil then break end
			wait(5)
		end

		local humanoid = newPlayer.Character.Humanoid

		humanoid.Died:connect(function() onHumanoidDied(humanoid, newPlayer) end )

		-- start to listen for new humanoid
		newPlayer.Changed:connect(function(property) onPlayerRespawn(property, newPlayer) end )


		stats.Parent = newPlayer

	end

end


function onCaptureScored(player)

		local ls = player:findFirstChild(&quot;leaderstats&quot;)
		if ls == nil then return end
		local caps = ls:findFirstChild(&quot;Captures&quot;)
		if caps == nil then return end
		caps.Value = caps.Value + 1

end


findAllFlagStands(game.Workspace)
hookUpListeners()
if (#stands &gt; 0) then CTF_mode = true end
game.Players.ChildAdded:connect(onPlayerEntered)


