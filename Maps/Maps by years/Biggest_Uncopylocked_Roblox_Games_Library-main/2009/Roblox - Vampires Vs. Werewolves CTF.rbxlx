			<Item class="Script" referent="RBX4833">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">local Tool = script.Parent

Tool.Enabled = true
function onActivated()
	if not Tool.Enabled then return end
	vCharacter = Tool.Parent
	if vCharacter.Name == &quot;BackPack&quot; then return end
	if vCharacter:FindFirstChild(&quot;Vampyrius&quot;) == nil and vCharacter:FindFirstChild(&quot;Vampyrius Maximus&quot;) == nil then return end
      Tool.Enabled = false
 -- play sound
	magicSound = Tool.Handle:FindFirstChild(&quot;MagicSound&quot;)
	if magicSound == nil then Tool.Enabled = true return end
	magicSound:Play()


	Tool.Handle.Transparency = 1

	myClone = Instance.new(&quot;Model&quot;)
	charChilds = vCharacter:GetChildren()
	velocity = vCharacter.Torso.Velocity
	for i = 1, #charChilds do
		currChild = charChilds[i]
		if (currChild.className ~= &quot;Hat&quot;) then
			if (currChild.Name == &quot;HealthScript v2.0&quot;) then

			elseif (currChild.Name == &quot;Health&quot;) then
			
			elseif (currChild.className == &quot;Tool&quot;) then
			
			elseif (currChild.Name == &quot;Humanoid&quot;) then
				--currChild:Clone().Parent = myClone
			elseif (currChild.className == &quot;Part&quot;) then
				cloneChild = currChild:Clone()
				if cloneChild.Name == &quot;Torso&quot; then
					vampHoverForce = cloneChild:FindFirstChild(&quot;VampyricHoverForce&quot;)
					if vampHoverForce ~= nil then vampHoverForce.Parent = nil end
				end
				--cloneChild.CanCollide = true
				--cloneChild.Anchored = true
				cloneChild.CanCollide = false
				cloneForce = Instance.new(&quot;BodyForce&quot;)
				cloneForce.Name = &quot;Hallucination AntiGrav Force&quot;
				cloneForce.force = Vector3.new(0, currChild:GetMass()*196.194, 0)
				cloneForce.Parent = cloneChild
				cloneChild.RotVelocity = Vector3.new(0,0,0)
				cloneChild.Velocity = velocity
				cloneChild.Parent = myClone
			else
				currChild:Clone().Parent = myClone
			end
		else
			newHat = Instance.new(&quot;Hat&quot;)
			currChild.Handle:Clone().Parent = newHat
			newHat.AttachmentForward = currChild.AttachmentForward
			newHat.AttachmentPos = currChild.AttachmentPos
			newHat.AttachmentUp = currChild.AttachmentUp
			newHat.AttachmentRight = currChild.AttachmentRight
			
			cloneForce = Instance.new(&quot;BodyForce&quot;)
			cloneForce.Name = &quot;Hallucination AntiGrav Force&quot;
			cloneForce.force = Vector3.new(0, currChild.Handle:GetMass()*196.194, 0)
			cloneForce.Parent = newHat.Handle
			newHat.Handle.RotVelocity = Vector3.new(0,0,0)
			newHat.Handle.Velocity = velocity
			newHat.Handle.CanCollide = false
			newHat.Parent = myClone
		end
	end

	--wait(1)
	myClone.Parent = game.Workspace
	
	wait(7)
	myClone.Parent = nil

	Tool.Handle.Transparency = 0

-- rest of script
	--[[ find the parts
	charChilds = vCharacter:GetChildren()
	local partsToHide = {}
	local numPartsToHide = 0
	for i = 1, #charChilds do
		currChild = charChilds[i]
		if currChild.className == &quot;Part&quot; then
			numPartsToHide = numPartsToHide + 1
			partsToHide[numPartsToHide] = currChild
		end
		if currChild.className == &quot;Hat&quot; then
			partsToHide[numPartsToHide] = currChild.Handle
			numPartsToHide = numPartsToHide + 1
		end
	end

	-- facecopy
	myFace = vCharacter.Head:FindFirstChild(&quot;face&quot;)
	if myFace ~= nil then
		myFace:Clone().Parent = fakeHead
	end
	for i = 1, 10 do
		for j = 1, numPartsToHide do
			partsToHide[j].Transparency = i/10
		end
		wait(.5) --.08
	end

	wait(15)

	-- bring them back
	for i = 1, 10 do
		for j = 1, numPartsToHide do
			partsToHide[j].Transparency = (10-i)/10
		end
		wait(.5)
	end

	if myFace ~= nil then
		myFace.Parent = vCharacter.Head
	end

	wait(20)
]]--

	Tool.Enabled = true
end

function onEquipped()
	magicSound = Tool.Handle:FindFirstChild(&quot;MagicSound&quot;)
	if magicSound == nil then
		magicSound = Instance.new(&quot;Sound&quot;)
		magicSound.Parent = Tool.Handle
		magicSound.Volume = 1
		magicSound.SoundId = &quot;http://www.roblox.com/asset/?id=35571070&quot;
		magicSound.Name = &quot;MagicSound&quot;
	end
end


function onUnequipped()
	magicSound = Tool.Handle:FindFirstChild(&quot;MagicSound&quot;)
	if magicSound ~= nil then
		magicSound:Stop()
		magicSound.Parent = nil
	end
end

Tool.Activated:connect(onActivated)
Tool.Equipped:connect(onEquipped)
Tool.Unequipped:connect(onUnequipped)
