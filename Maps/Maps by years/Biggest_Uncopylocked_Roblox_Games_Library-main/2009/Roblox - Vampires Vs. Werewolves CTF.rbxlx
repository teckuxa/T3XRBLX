				<Item class="Script" referent="RBX339">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">FlagStandScript</string>
						<ProtectedString name="Source">local flag = script.Parent
local teamColors = script:GetChildren()
local haveBeenTaken = false

function onTouched(hit)
	-- return if flag is already taken
	if haveBeenTaken then return end
	if hit == nil then return end
	if hit.Parent == nil then return end
	vCharacter = hit.Parent

	-- ignore if not humanoid
	if vCharacter:FindFirstChild(&quot;Humanoid&quot;) == nil then return end

	vPlayer = game.Players:GetPlayerFromCharacter(hit.Parent)

	-- is it on a team that can carry away flag?  (denoted by having a value of that team-color as a child of the script)
	canTake = false
	for i = 1, #teamColors do
		if (teamColors[i].Value == vPlayer.TeamColor) then canTake = true end
	end

	-- return if can&apos;t carry flag
	if not canTake then return end
	if vCharacter:FindFirstChild(&quot;Right Arm&quot;) == nil then return end -- since can&apos;t carry if don&apos;t have right hand
	
	-- dead dudes can&apos;t carry flag
	if vCharacter.Humanoid.Health &lt;= 0 or vCharacter.Humanoid.Health &gt; vCharacter.Humanoid.MaxHealth then return end

	-- check one more time if flag is already taken


	-- now can carry flag, so give it away!! :D

	if vCharacter:FindFirstChild(&quot;Head&quot;) == nil then return end

	if vCharacter:FindFirstChild(&quot;FlagTool&quot;) ~= nil then flag:Remove() end -- kill self if the dude already has a flag

	print(&quot;FLAG CAPTURED!!!&quot;)
--	flag.DebugOutput.Value = &quot;FLAG CAPTURED!!&quot;

	if haveBeenTaken then return end
	haveBeenTaken = true

	if flag.Parent ~= game.Workspace.Flags then
		vPlayer.leaderstats.Grabs.Value = vPlayer.leaderstats.Grabs.Value + 1
	end
	charChilds = vCharacter:GetChildren()
	for i = 1, #charChilds do
		if charChilds[i].className == &quot;Tool&quot; then
			charChilds[i].Parent = vPlayer.Backpack
		end
	end

	-- give flagTool to vCharacter
	flagTool = Instance.new(&quot;Tool&quot;)
	flagTool.Name = &quot;FlagTool&quot;
	flagTool.GripUp = Vector3.new(0, 0, 1)
	flagTool.GripPos = Vector3.new(2, .2, -4)
	flagTool.GripRight = Vector3.new(0, 1, 0)
	flagTool.GripForward = Vector3.new(1, 0, 0)
	flagTool.TextureId = &quot;http://www.roblox.com/asset/?id=36828333&quot;
	
	flag.Name = &quot;Handle&quot;
	flag.Size = Vector3.new(3,1.2,6)
	flag.Parent = flagTool
	flag.Anchored = false
	flag.CanCollide = true
	flag.FlagScript.Disabled = false
	
	--flag.DebugOutput.Value = &quot;Fait Accompli&quot;

	-- do below two lines need to be switched?
	script.Disabled = true
	flagTool.Parent = vCharacter

	--[[
	--flagHat = flag.FlagHat:Clone()
	flagHat = flag.FlagPiece
	flagHat.Anchored = false
	--flag.FlagHat.Transparency = 1
	flagHat.Name = &quot;Handle&quot;
	flagHat.Parent = flagTool
	flagTool.Parent = vCharacter
	flagScript = flag.FlagScript:Clone()
	flagScript.Parent = flagTool
	flagScript.Disabled = false
	flagStandScript = flag.FlagStandScript:Clone()
	flagStandScript.Disabled = true
	--flagStandScript.Parent = flagTool
	flagStandScript.Parent = flagHat

	]]--

	--flagToolWeld = Instance.new(&quot;Weld&quot;)
	--flagToolWeld.Part1 = flagTool.Handle
	--flagToolWeld.Part0 = vCharacter:FindFirstChild(&quot;Right Arm&quot;)  -- need to check for not nil here?!
	--flagToolWeld.Name = &quot;FlagWeld&quot;
	--flagToolWeld.Parent = vCharacter:FindFirstChild(&quot;Right Arm&quot;)

--[[
	-- give hat to vCharacter
	flag.DebugOutput.Value = &quot;Giving hat to character&quot;
	flagHat = flag.FlagHat:Clone()
	flag.DebugOutput.Value = &quot;flagHatCloned&quot;
	flagHat.Anchored = false
	flag.DebugOutput.Value = &quot;flagHatUnanchored&quot;
	flag.FlagHat.Transparency = 1
	flag.DebugOutput.Value = &quot;Flag should be transparent by now... time to weld&quot;

	flagHat.Parent = vCharacter
	flagHatWeld = Instance.new(&quot;Weld&quot;)
	flagHatWeld.Part0 = flagHat
	flagHatWeld.Part1 = vCharacter.Head
	flagHatWeld.Name = &quot;FlagWeld&quot;
	flagHatWeld.Parent = vCharacter.Head
	flag.DebugOutput.Value = &quot;Weld finished, time to disable arm&quot;

	-- also take away their ability to use items/abilities!
	stolenArm = vCharacter:FindFirstChild(&quot;Right Arm&quot;)
	if stolenArm == nil then return end
	stolenArm.Parent = vCharacter.Parent
	--]]

	--flag.DebugOutput.Value = &quot;Fait Accompli&quot;
	--[[humanoid = vCharacter:FindFirstChild(&quot;Humanoid&quot;)
	if humanoid ~= nil then
		humanoid.WalkSpeed = humanoid.WalkSpeed / 2
	end]]--
end

flag.Touched:connect(onTouched)
