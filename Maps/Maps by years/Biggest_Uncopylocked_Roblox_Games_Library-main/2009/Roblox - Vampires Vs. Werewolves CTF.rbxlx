							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">holeFiller = script.Parent
specialTree = holeFiller.Parent
notFinished = true

specialTree.Broomstick.Handle.Anchored = true
specialTree.Broomstick.Handle.CanCollide = false
specialTree.Broomstick.Handle.Transparency = 1
specialTree.Broomstick.Handle.CFrame = holeFiller.CFrame

holeFiller.MyWeld.Part0 = holeFiller
holeFiller.MyWeld.Part1 = specialTree.Trunk

while notFinished do
	if (holeFiller:FindFirstChild(&quot;MyWeld&quot;) == nil) then
		holeFiller.CanCollide = false
		specialTree.Broomstick.Handle.Transparency = 0
		specialTree.Broomstick.Handle.CanCollide = true
		specialTree.Broomstick.Handle.Anchored = false
		notFinished = false
	end
	wait(2)
end
</ProtectedString>
