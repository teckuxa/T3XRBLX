				<Item class="Script" referent="RBX354">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">ScoreZoneScript</string>
						<ProtectedString name="Source">local zone = script.Parent
local teamColors = script:GetChildren()

function onTouched(hit)
	if hit == nil then return end
	if hit.Parent == nil then return end
	vCharacter = hit.Parent

	-- ignore if not humanoid
	if vCharacter:FindFirstChild(&quot;Humanoid&quot;) == nil then return end

	--[[ also ignore if they don&apos;t have a flag!
	charHead = vCharacter:FindFirstChild(&quot;Head&quot;)
	if charHead == nil then return end
	flagHat = vCharacter:FindFirstChild(&quot;FlagHat&quot;)
	if flagHat == nil then return end
	flagWeld = charHead:FindFirstChild(&quot;FlagWeld&quot;)
	if flagWeld == nil then return end]]--
	flagTool = vCharacter:FindFirstChild(&quot;FlagTool&quot;)
	if flagTool == nil then return end

	vPlayer = game.Players:GetPlayerFromCharacter(hit.Parent)

	-- is it on a team that can score points?
	canScore = false
	for i = 1, #teamColors do
		if (teamColors[i].Value == vPlayer.TeamColor) then canScore = true end
	end

	-- return if can&apos;t
	if not canScore then return end

	-- otherwise, time to give team a point! :D
	print(&quot;GOOOOOOOOAAAL!!!&quot;)
	vPlayer.leaderstats.Captures.Value = vPlayer.leaderstats.Captures.Value + 1
	
	-- destroy the evidence (will reset the flag)
	--flagWeld.Parent = nil
	--flagHat.Parent = nil
	flagTool.Handle.Parent = nil
	flagTool.Parent = nil

	-- play a noise or something to let peoples know?
end

zone.Touched:connect(onTouched)
