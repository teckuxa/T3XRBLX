				<Item class="Script" referent="RBX344">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">FlagControlScript</string>
						<ProtectedString name="Source">base = script.Parent
local flagPiece = nil

function spawnNewFlagAtBase()
	-- create new flag
	flagPiece = base.FlagHat:Clone()
	flagPiece.Transparency = 0
	flagPiece.CanCollide = true
	flagPiece.Name = &quot;FlagPiece&quot;
	flagPiece.Parent = base
	
	-- copy flag script to it and activate
	flagStandScript = base.FlagStandScript:Clone()
	flagStandScript.Parent = flagPiece
	flagStandScript.Disabled = false

	flagScript = base.FlagScript:Clone()
	flagScript.Parent = flagPiece
end


spawnNewFlagAtBase()
wait(1) -- to give it time to spawn
local timeBeforeReset = 30 -- 30 seconds before resetting the flag
local count = timeBeforeReset
while true do
	if ((flagPiece == nil) or (flagPiece.Parent == nil)) then
		print(&quot;Respawning flag at base&quot;)
		-- reset flag after 1 second (does this fix the &quot;flag disappears&quot; issue?)
		spawnNewFlagAtBase()
	elseif (flagPiece.Parent == game.Workspace.Flags) then -- loose flag!
		count = count - 1
		if count &lt;= 6 then
			-- make fade out over last 6 seconds
			flagPiece.Transparency = (6-count)/6
		end
		if count &gt; 28 then
			flagPiece.Transparency = 0
		end
		if count &lt;= 0 then
			print(&quot;30 seconds elapsed... resetting flag&quot;)
			-- time to reset!
			flagPiece.Parent = nil
			flagPiece = nil
		end
	else
		--print(&quot;flag is in possession&quot;)
		count = timeBeforeReset -- flag is in possession of someone!
		if (flagPiece.Transparency &gt; 0) then flagPiece.Transparency = 0 end
	end
	
	wait(1)
end
