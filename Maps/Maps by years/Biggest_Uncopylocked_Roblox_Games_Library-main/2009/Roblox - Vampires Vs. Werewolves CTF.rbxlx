function getKillerOfHumanoidIfStillInGame(humanoid)
	cTag = humanoid:FindFirstChild(&quot;creator&quot;)
	vKiller = nil
	if cTag ~= nil then
		vKiller = cTag.Value
	end
	return vKiller
end

function onHumanoidDied(player, humanoid)
	print(&quot;somebody died&quot;)
	-- if dead player is a beast, then...
	if (player.TeamColor.Name ~= &quot;White&quot;) then
		print(&quot;beast died&quot;)
		-- do short dance to try and find the killer
		print(humanoid)
		local killer = getKillerOfHumanoidIfStillInGame(humanoid)
		if killer ~= nil then
			print(&quot;got a killer&quot;)
			-- now we add 1 to their kill count (if townie)  [their kill count will reset when they die, since tag is kept in character]
			bmTag = killer.Character:FindFirstChild(&quot;BeastKills&quot;)
			if bmTag ~= nil then
				bmTag.Value = bmTag.Value + 1
				if bmTag.Value &gt; 4 then
					print(&quot;BEASTMASTER AWARD GOES TO:&quot;)
					print(killer.Name)
					print(&quot;NICE!!&quot;)
					
					--local b = game:GetService(&quot;BadgeService&quot;)
					--local badgeId = 37677129
					--b:AwardBadge(killer.userId, badgeId)
				end
				if bmTag.Value &gt; 9 then
					print(&quot;BEASTSLAYER AWARD GOES TO:&quot;)
					print(killer.Name)
					print(&quot;SNAPPPPP!!!!&quot;)
				
					--local b = game:GetService(&quot;BadgeService&quot;)
					--local badgeId = 37675973
					--b:AwardBadge(killer.userId, badgeId)
				end
			end
		end
	end
end
