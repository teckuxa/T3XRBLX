							<string name="Name">ConfettiBang</string>
							<float name="Pitch">1</float>
							<int name="PlayCount">-1</int>
							<bool name="PlayOnRemove">false</bool>
							<Content name="SoundId"><url>http://www.roblox.com/asset/?id=34365495 </url></Content>
