							<string name="Name">ModelRegenScript</string>
							<ProtectedString name="Source">regenerator = script.Parent
model = regenerator.Parent

local progress = 0

--messageText = &quot;Regenerating Bridge...&quot;
--message = Instance.new(&quot;Message&quot;)
--message.Text = messageText
backup = model:clone()

--message.Parent = game.Workspace
--model:remove()
--wait(script.Parent.RegenerationDelay.Value)

--	model = backup:clone()
	--model.Parent = game.Workspace
	--model:makeJoints()
--	message.Parent = nil


--abridged version:
--model:remove()
--model = backup:clone()
--model.Parent = game.Workspace
--model:makeJoints()



function CreateGUI(vCharacter)
	local p = game.Players:GetPlayerFromCharacter(vCharacter)
	print(&quot;Power for Player: &quot; .. p.Name)
	script.RegenGUI:Clone().Parent = p.PlayerGui
end


function UpdateGUI(vCharacter)
	local pgui = game.Players:GetPlayerFromCharacter(vCharacter).PlayerGui
	local tray = pgui.RegenGUI.Tray

	tray.HealthBar.Size = UDim2.new(0.2, 0, 0.8 * (progress / 100), 0) 
	tray.HealthBar.Position = UDim2.new(0.4, 0, 0.8 * (1-  (progress / 100)) , 0) 
end

function removeGUI(vCharacter)
	pgui = game.Players:GetPlayerFromCharacter(vCharacter).PlayerGui
	RegenGUI = pgui:FindFirstChild(&quot;RegenGUI&quot;)
	if RegenGUI ~= nil then
		RegenGUI.Parent = nil
	end
end

local cantRegen = false


function onTouch(hit)
	if cantRegen then return end
	if hit == nil then return end
	if hit.Parent == nil then return end
	if hit.Parent:FindFirstChild(&quot;Humanoid&quot;) == nil then return end
	cantRegen = true
	vCharacter = hit.Parent
	regenPos = regenerator.Position
	progress = 0
	print(&quot;regenerating...&quot;)
	CreateGUI(vCharacter)
	UpdateGUI(vCharacter)
	while (progress &lt; 100) do
		dPos = vCharacter.PrimaryPart.Position - regenPos
		if (dPos:Dot(dPos) &gt; 50) then
			print(&quot;exited the regen zone&quot;)
			cantRegen = false
			removeGUI(vCharacter)
			return -- strayed too far
		end
		wait(.2)
		progress = progress + 4 -- 5 seconds
		UpdateGUI(vCharacter)
	end
	-- regenerate model
	print(&quot;warping in model&quot;)
	model:remove()
	model = backup:clone()
	model.Parent = game.Workspace
	model:makeJoints()

	cantRegen = false
	removeGUI(vCharacter)
end

regenerator.Touched:connect(onTouch)
</ProtectedString>
