		<Item class="Script" referent="RBX1936">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">LinkedLeaderboard</string>
				<ProtectedString name="Source">local round_time = 600

local time_remaining = round_time

local regens = {}
local temporaries = {}
local flags = game.Workspace.Flags:Clone()

local items = game.Workspace:GetChildren()
for i=1,#items do
	if (items[i].Name == &quot;Regen&quot;) then
		regens[#regens + 1] = items[i]:Clone()
		temporaries[#temporaries + 1] = items[i]
	end
end

function RemoveScripts(root)
	local c = root:GetChildren()
	for i=1,#c do
		RemoveScripts(c[i])
		if (c[i].className == &quot;Script&quot;) then c[i]:Remove() end
	end
end

function RemoveHats(root)
	local c = root:GetChildren()
	for i = 1, #c do
		RemoveHats(c[i])
		if (c[i].className == &quot;Hat&quot;) then c[i]:Remove() end
	end
end

function RemoveVampFire(root)
	local c = root:GetChildren()
	for i = 1, #c do
		if c[i].Name == &quot;VampBlast&quot; then c[i]:Remove() end
	end
end

function doRegen()
	RemoveHats(game.Workspace)
	RemoveVampFire(game.Workspace)

	for i=1,#temporaries do
		temporaries[i]:Remove()
	end

	temporaries = {}
	for i=1,#regens do
		local temp = regens[i]:Clone()
		temporaries[#temporaries + 1] = temp
		temp.Parent = game.Workspace
		temp:makeJoints()
	end

	-- special logic for flags
	RemoveScripts(game.Workspace.Flags)
	wait(.1)
	game.Workspace.Flags:Remove()
	local f = flags:Clone()
	f.Parent = game.Workspace
	f:makeJoints()
end

function giveBadges(teamColor)

	local b = game:GetService(&quot;BadgeService&quot;)

	local players = game.Players:GetPlayers()
	for i=1,#players do
		if (players[i].TeamColor.Name == teamColor) then
			local badgeId = 0
			if (teamColor == &quot;White&quot;) then
				badgeId = 37234064
			end
			if (teamColor == &quot;Bright green&quot;) then
				badgeId = 37234075
			end
			if (teamColor == &quot;Black&quot;) then
				badgeId = 37234048
			end
			b:AwardBadge(players[i].userId, badgeId)
		end
		
	end



end


function giveTeamworkBadges(teamColor)
	local b = game:GetService(&quot;BadgeService&quot;)

	local players = game.Players:GetPlayers()
	for i=1,#players do
		if (players[i].TeamColor.Name == teamColor) then
			--local badgeId = 0
			local badgeId = 37748235
			--if (teamColor == &quot;Bright green&quot;) then
				--badgeId = 37234075
			--end
			--if (teamColor == &quot;Black&quot;) then
				--badgeId = 37234048
			--end

-- below line will award teamwork badge, when we are ready to do so
--			b:AwardBadge(players[i].userId, badgeId)
		end
		
	end
end



function updateGameHUDs(title, caption)
	local players = game.Players:GetPlayers()
	for i = 1,#players do
		if (players[i]:FindFirstChild(&quot;PlayerGui&quot;) ~= nil ) then
			local hud = players[i].PlayerGui:FindFirstChild(&quot;GameHUD&quot;)
			if (hud ~= nil) then
				-- update side icon
				if (players[i].TeamColor.Name == &quot;White&quot;) then
					hud.Frame.Frame.ImageLabel.Image = &quot;http://www.roblox.com/asset/?id=37234063&quot;
				end
				if (players[i].TeamColor.Name == &quot;Black&quot;) then
					hud.Frame.Frame.ImageLabel.Image = &quot;http://www.roblox.com/asset/?id=37234045&quot;
				end
				if (players[i].TeamColor.Name == &quot;Bright green&quot;) then
					hud.Frame.Frame.ImageLabel.Image = &quot;http://www.roblox.com/asset/?id=37234073&quot;
				end

				-- update text
				hud.Frame.Frame.Caption.Text = caption
				hud.Frame.Frame.Title.Text = title

			end
		end
	end
end

function autoVampyrize(player)
	vCharacter = player.Character
	if (vCharacter == nil) then return end
	-- if already a super-vamp, do nothing
	vampireTag = vCharacter:FindFirstChild(&quot;Vampyrius Maximus&quot;)
	if vampireTag ~= nil then return end

	-- Vampyrification :D
	-- make them able to do vampire stuff
	vampireTag = vCharacter:FindFirstChild(&quot;Vampyrius&quot;)
	if vampireTag ~= nil then
		vampireTag.Name = &quot;Vampyrius Maximus&quot;
		vampireTag.Value = 0
	else
		vampireTag = Instance.new(&quot;NumberValue&quot;)
		vampireTag.Name = &quot;Vampyrius&quot;
		vampireTag.Parent = vCharacter
		vampireTag.Value = 0
	end

	-- and can&apos;t be werewolf and vamp at once (can switch between the two if keep drinking potions though)
	wolfTag = vCharacter:FindFirstChild(&quot;Lycanis Noctus&quot;)
	if wolfTag ~= nil then wolfTag.Parent = nil end
	wolfTag = vCharacter:FindFirstChild(&quot;Lycanis&quot;)
	if wolfTag ~= nil then wolfTag.Parent = nil end

	-- remove all hats
	charParts = vCharacter:GetChildren()
	for i = 1, #charParts do
		currPart = charParts[i]
		if currPart.className == &quot;Hat&quot; then
			currPart:Remove()
		end
		if currPart.className == &quot;CharacterMesh&quot; then
			if currPart.MeshId == 27130997 or currPart.MeshId == 27131042 or currPart.MeshId == 27131194 or currPart.MeshId == 27128722 or currPart.MeshId == 27131177 then
				currPart:Remove() -- no werewolf body allowed on a vampire!
			end
		end
	end
	
	-- any body stored from lycanthropization should be returned
	headParts = vCharacter.Head:GetChildren()
	for i = 1, #headParts do
		currPart = headParts[i]
		if currPart.className == &quot;CharacterMesh&quot; then
			currPart.Parent = vCharacter
		end
	end

	--It&apos;s like redbull; it gives you WIIIIIINGS
	--this call will cause a &quot;wait&quot; until the data comes back
	-- 23264296 is albino bat vampire
	-- 19399858 is wings
	local root = game:GetService(&quot;InsertService&quot;):LoadAsset(19399858)

	if (root == nil) then return end

	--root = root:FindFirstChild(&quot;Cupcake&quot;)
	root = root:GetChildren()
	if root ~= nil then root = root[1] end
	if root ~= nil then
		-- got wings...  add to char
		--local newWings = root:Clone()
		--newWings.Parent = vCharacter
		root.Handle.Size = Vector3.new(1,1,1)
		root.Parent = vCharacter
	end

	if vampireTag.Name == &quot;Vampyrius Maximus&quot; then
		root2 = game:GetService(&quot;InsertService&quot;):LoadAsset(23264296)
		instances = root2:GetChildren()
		if root2 == nil then return end
	
		--root2 = root2:FindFirstChild(&quot;Cupcake&quot;)
		root2 = root2:GetChildren()
		if root2 ~= nil then root2 = root2[1] end
		if root2 ~= nil then
			-- got wings...  add to char
			--local newWings = root2:Clone()
			--newWings.Parent = vCharacter
			root2.Handle.Size = Vector3.new(1,1,1)
			root2.Parent = vCharacter
		end

		vCharacter.Head.Transparency = 1
		face = vCharacter.Head:FindFirstChild(&quot;face&quot;)
		if face ~= nil then face.Parent = nil end
	else
		-- make vampire face
		head = vCharacter.Head
		face = head:FindFirstChild(&quot;face&quot;)
		if face == nil then
			face = Instance.new(&quot;Decal&quot;)
			face.Name = &quot;face&quot;
			face.Parent = head
		end
		face.Texture = &quot;http://www.roblox.com/asset/?id=29532362&quot;
		vCharacter.Head.Transparency = 0
	end

	-- colordrain
	local white = nil
	if vampireTag.Name == &quot;Vampyrius&quot; then white = BrickColor.new(Color3.new(1,1,1))
	else white = BrickColor.new(&quot;Pastel violet&quot;) end

	vCharacter.Head.BrickColor = white
	torso = vCharacter:FindFirstChild(&quot;Torso&quot;)
	rArm = vCharacter:FindFirstChild(&quot;Right Arm&quot;)
	lArm = vCharacter:FindFirstChild(&quot;Left Arm&quot;)
	lLeg = vCharacter:FindFirstChild(&quot;Left Leg&quot;)
	rLeg = vCharacter:FindFirstChild(&quot;Right Leg&quot;)
	if torso ~= nil then torso.BrickColor = white end
	if rArm ~= nil then rArm.BrickColor = white end
	if lArm ~= nil then lArm.BrickColor = white end
	if rLeg ~= nil then rLeg.BrickColor = white end
	if lLeg ~= nil then lLeg.BrickColor = white end
end

function autoWolf(player)
	vCharacter = player.Character
	if (vCharacter == nil) then return end
	wolfTag = vCharacter:FindFirstChild(&quot;Lycanis Noctus&quot;)
	if wolfTag ~= nil then Tool.Enabled = true return end

	-- Lycanthropy :D
	-- make them able to do werewolf stuff
	wolfTag = vCharacter:FindFirstChild(&quot;Lycanis&quot;)
	if wolfTag ~= nil then
		wolfTag.Name = &quot;Lycanis Noctus&quot;
		wolfTag.Value = 0
	else
		wolfTag = Instance.new(&quot;NumberValue&quot;)
		wolfTag.Name = &quot;Lycanis&quot;
		wolfTag.Parent = vCharacter
		wolfTag.Value = 0
	end

	-- and can&apos;t be werewolf and vamp at once (can switch between the two if keep drinking potions though)
	vampTag = vCharacter:FindFirstChild(&quot;Vampyrius&quot;)
	if vampTag ~= nil then vampTag.Parent = nil end
	vampTag = vCharacter:FindFirstChild(&quot;Vampyrius Maximus&quot;)
	if vampTag ~= nil then vampTag.Parent = nil end

	-- remove all hats and take away old body (if one exists)
	charParts = vCharacter:GetChildren()
	for i = 1, #charParts do
		currPart = charParts[i]
		if currPart.className == &quot;Hat&quot; then
			currPart:Remove()
		end
		if currPart.className == &quot;CharacterMesh&quot; then
			if currPart.MeshId ~= 27130997 and currPart.MeshId ~= 27131042 and currPart.MeshId ~= 27131194 and currPart.MeshId ~= 27128722 and currPart.MeshId ~= 27131177 then
				currPart.Parent = vCharacter.Head -- move to head for now (so can bring back body if change to vampire)
											--   but don&apos;t move werewolf body, since don&apos;t want to bring that back
			end
		end
	end

	--Dogface!
	--this call will cause a &quot;wait&quot; until the data comes back
	-- 23264296 albino bat vampire
	--21070133 wolven footsoldier
	--15013035 awesome-looking demonic dog warrior

	local root
	if wolfTag.Name == &quot;Lycanis Noctus&quot; then root = game:GetService(&quot;InsertService&quot;):LoadAsset(15013035)
	else root = game:GetService(&quot;InsertService&quot;):LoadAsset(21070133) end

	vCharacter.Head.Transparency = 1
	face = vCharacter.Head:FindFirstChild(&quot;face&quot;)
	if face ~= nil then face.Parent = nil end

	if root == nil then return end

	--local newDogface = nil
	root = root:GetChildren()
	if root ~= nil then root = root[1] end
	if root ~= nil then
		-- puppy!!
		--newDogface = root:Clone()
		--newDogface.Parent = vCharacter
		root.Parent = vCharacter
	end
	
	-- for wolven footsoldier, some resizing is necessary:
	if wolfTag.Name == &quot;Lycanis&quot; then
		--if newDogface ~= nil then
		if root ~= nil then
			--newDogface.Handle.Mesh.Scale = Vector3.new(1,1,.7)
			--newDogface.AttachmentPos = Vector3.new(0,.7,.1)

			root.Handle.Mesh.Scale = Vector3.new(1,1,.7)
			root.AttachmentPos = Vector3.new(0,.7,.1)
		end
	end

	-- add wolf body
	--darkWolfBaseTex = 27127110
	--darkWolfOverTex = 26360262
	darkWolfBaseTex = 36460871
	darkWolfOverTex = 36460898
	albinoWolfBaseTex = 36423997
	albinoWolfOverTex = 36424039

	local wolfBaseTex
	local wolfOverTex
	if wolfTag.Name == &quot;Lycanis Noctus&quot; then 
		wolfBaseTex = darkWolfBaseTex
		wolfOverTex = darkWolfOverTex
	else
		wolfBaseTex = albinoWolfBaseTex
		wolfOverTex = albinoWolfOverTex
	end

	wolfTorso = vCharacter:FindFirstChild(&quot;WolfTorso&quot;)
	wolfLA = vCharacter:FindFirstChild(&quot;WolfLeftArm&quot;)
	wolfRA = vCharacter:FindFirstChild(&quot;WolfRightArm&quot;)
	wolfLL = vCharacter:FindFirstChild(&quot;WolfLeftLeg&quot;)
	wolfRL = vCharacter:FindFirstChild(&quot;WolfRightLeg&quot;)

	if wolfTorso == nil then wolfTorso = Instance.new(&quot;CharacterMesh&quot;) end
	if wolfLA == nil then wolfLA = Instance.new(&quot;CharacterMesh&quot;) end
	if wolfRA == nil then wolfRA = Instance.new(&quot;CharacterMesh&quot;) end
	if wolfLL == nil then wolfLL = Instance.new(&quot;CharacterMesh&quot;) end
	if wolfRL == nil then wolfRL = Instance.new(&quot;CharacterMesh&quot;) end

	wolfTorso.Parent = vCharacter
	wolfTorso.Name = &quot;WolfTorso&quot;
	wolfTorso.BodyPart = &quot;Torso&quot;
	wolfTorso.BaseTextureId = wolfBaseTex
	wolfTorso.OverlayTextureId = wolfOverTex
	wolfTorso.MeshId = 27130997


	wolfLA.Parent = vCharacter
	wolfLA.Name = &quot;WolfLeftArm&quot;
	wolfLA.BodyPart = &quot;LeftArm&quot;
	wolfLA.BaseTextureId = wolfBaseTex
	wolfLA.OverlayTextureId = wolfOverTex
	wolfLA.MeshId = 27131042


	wolfRA.Parent = vCharacter
	wolfRA.Name = &quot;WolfRightArm&quot;
	wolfRA.BodyPart = &quot;RightArm&quot;
	wolfRA.BaseTextureId = wolfBaseTex
	wolfRA.OverlayTextureId = wolfOverTex
	wolfRA.MeshId = 27131194

	
	wolfLL.Parent = vCharacter
	wolfLL.Name = &quot;WolfLeftLeg&quot;
	wolfLL.BodyPart = &quot;LeftLeg&quot;
	wolfLL.BaseTextureId = wolfBaseTex
	wolfLL.OverlayTextureId = wolfOverTex
	wolfLL.MeshId = 27128722

	wolfRL.Parent = vCharacter
	wolfRL.Name = &quot;WolfRightLeg&quot;
	wolfRL.BodyPart = &quot;RightLeg&quot;
	wolfRL.BaseTextureId = wolfBaseTex
	wolfRL.OverlayTextureId = wolfOverTex
	wolfRL.MeshId = 27131177

	--vPlayer.TeamColor = &quot;Orange&quot;
end


