					<Item class="Script" referent="RBX3468">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">controlPanel = script.Parent
gate = controlPanel.Parent

door = gate:FindFirstChild(&quot;Door&quot;)

function doorUp()
	print(&quot;doorUp()&quot;)
	door = gate:FindFirstChild(&quot;Door&quot;)
	if door ~= nil then
		print(&quot;door is not nil&quot;)
		if door:FindFirstChild(&quot;DoorForce&quot;) ~= nil then door.DoorForce.position = Vector3.new(-342, 272, 152) end
	end
	-- 272 is up 252 is down after move
	-- -342, 124, 152
end

function doorDown()
	print(&quot;doorDown()&quot;)
	door = gate:FindFirstChild(&quot;Door&quot;)
	if door ~= nil then
		print(&quot;door is not nil&quot;)
		if door:FindFirstChild(&quot;DoorForce&quot;) ~= nil then door.DoorForce.position = Vector3.new(-342, 252, 152) end 
	end
end

upButton = script.Parent:FindFirstChild(&quot;Up Button&quot;)
downButton = script.Parent:FindFirstChild(&quot;Down Button&quot;)

upButton.ClickDetector.MouseClick:connect(doorUp)
downButton.ClickDetector.MouseClick:connect(doorDown)

print(&quot;got here&quot;)

if (door ~= nil and door.Parent ~= nil) then
	print(&quot;if statement&quot;)
	local centerPos = gate.CenterPart.Position
	door.DoorGyro.cframe = door.CFrame
	while door:FindFirstChild(&quot;DoorForce&quot;) ~= nil and gate:FindFirstChild(&quot;CenterPart&quot;) ~= nil do
		--print(&quot;while loop&quot;)
		dPos = gate.CenterPart.Position - centerPos
		if (dPos:Dot(dPos) &gt; 50) then
			print(&quot;your door asplode&quot;)
			door.DoorForce.Parent = nil
			door.DoorGyro.Parent = nil
		end
		wait(1)
	end
end

-- make door behave like normal brick (destroyed)
-- door.DoorForce.Parent = nil</ProtectedString>
