					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">-- VAMPIRE FACE TEXTURE = 29532363


local Tool = script.Parent

function drinkBottle()
	Tool.GripForward = Vector3.new(0, .707, .707)
	Tool.GripPos = Vector3.new(1.5, .1, 0)
	Tool.GripRight = Vector3.new(1, 0, 0)
	Tool.GripUp = Vector3.new(0, .707, .707)
end

function lowerBottle()
	Tool.GripForward = Vector3.new(0, 1, 0)
	Tool.GripPos = Vector3.new(0, 0, 0)
	Tool.GripRight = Vector3.new(1, 0, 0)
	Tool.GripUp = Vector3.new(0, 0, 1)
end


Tool.Enabled = true

function onActivated()

	if not Tool.Enabled then return end
	Tool.Enabled = false

	vCharacter = Tool.Parent
	-- if already a super wolf, do nothing
	wolfTag = vCharacter:FindFirstChild(&quot;Lycanis Noctus&quot;)
	if wolfTag ~= nil then Tool.Enabled = true return end

	-- Lycanthropy :D
	drinkBottle()
	-- make them able to do werewolf stuff
	wolfTag = vCharacter:FindFirstChild(&quot;Lycanis&quot;)
	if wolfTag ~= nil then
		wolfTag.Name = &quot;Lycanis Noctus&quot;
		wolfTag.Value = 0
	else
		wolfTag = Instance.new(&quot;NumberValue&quot;)
		wolfTag.Name = &quot;Lycanis&quot;
		wolfTag.Parent = vCharacter
		wolfTag.Value = 0
	end

	-- and can&apos;t be werewolf and vamp at once (can switch between the two if keep drinking potions though)
	vampTag = vCharacter:FindFirstChild(&quot;Vampyrius&quot;)
	if vampTag ~= nil then vampTag.Parent = nil end
	vampTag = vCharacter:FindFirstChild(&quot;Vampyrius Maximus&quot;)
	if vampTag ~= nil then vampTag.Parent = nil end

	-- play transmogrification sound
	magicSound = Tool.Handle:FindFirstChild(&quot;MagicSound&quot;)
	if magicSound == nil then
		magicSound = Instance.new(&quot;Sound&quot;)
		magicSound.SoundId = &quot;http://www.roblox.com/asset/?id=36431384&quot;
		magicSound.Name = &quot;MagicSound&quot;
		magicSound.Parent = Tool.Handle
		magicSound.Volume = 1
	end
	magicSound:Play()

	-- remove all hats and take away old body (if one exists)
	charParts = vCharacter:GetChildren()
	for i = 1, #charParts do
		currPart = charParts[i]
		if currPart.className == &quot;Hat&quot; then
			currPart:Remove()
		end
		if currPart.className == &quot;CharacterMesh&quot; then
			if currPart.MeshId ~= 27130997 and currPart.MeshId ~= 27131042 and currPart.MeshId ~= 27131194 and currPart.MeshId ~= 27128722 and currPart.MeshId ~= 27131177 then
				currPart.Parent = vCharacter.Head -- move to head for now (so can bring back body if change to vampire)
											--   but don&apos;t move werewolf body, since don&apos;t want to bring that back
			end
		end
	end

	--Dogface!
	--this call will cause a &quot;wait&quot; until the data comes back
	-- 23264296 albino bat vampire
	--21070133 wolven footsoldier
	--15013035 awesome-looking demonic dog warrior

	local root
	if wolfTag.Name == &quot;Lycanis Noctus&quot; then root = game:GetService(&quot;InsertService&quot;):LoadAsset(15013035)
	else root = game:GetService(&quot;InsertService&quot;):LoadAsset(21070133) end

	vCharacter.Head.Transparency = 1
	face = vCharacter.Head:FindFirstChild(&quot;face&quot;)
	if face ~= nil then face.Parent = nil end

	local instances = root:GetChildren()
	if #instances == 0 then
		root:Remove()
		return
	end

	--local newDogface = nil
	root = root:GetChildren()
	if root ~= nil then root = root[1] end
	if root ~= nil then
		-- puppy!!
		--newDogface = root:Clone()
		--newDogface.Parent = vCharacter
		root.Parent = vCharacter
	end
	
	-- for wolven footsoldier, some resizing is necessary:
	if wolfTag.Name == &quot;Lycanis&quot; then
		--if newDogface ~= nil then
		if root ~= nil then
			--newDogface.Handle.Mesh.Scale = Vector3.new(1,1,.7)
			--newDogface.AttachmentPos = Vector3.new(0,.7,.1)

			root.Handle.Mesh.Scale = Vector3.new(1,1,.7)
			root.AttachmentPos = Vector3.new(0,.7,.1)
		end
	end

	-- add wolf body
	--darkWolfBaseTex = 27127110
	--darkWolfOverTex = 26360262
	darkWolfBaseTex = 36460871
	darkWolfOverTex = 36460898
	albinoWolfBaseTex = 36423997
	albinoWolfOverTex = 36424039

	local wolfBaseTex
	local wolfOverTex
	if wolfTag.Name == &quot;Lycanis Noctus&quot; then 
		wolfBaseTex = darkWolfBaseTex
		wolfOverTex = darkWolfOverTex
	else
		wolfBaseTex = albinoWolfBaseTex
		wolfOverTex = albinoWolfOverTex
	end

	wolfTorso = vCharacter:FindFirstChild(&quot;WolfTorso&quot;)
	wolfLA = vCharacter:FindFirstChild(&quot;WolfLeftArm&quot;)
	wolfRA = vCharacter:FindFirstChild(&quot;WolfRightArm&quot;)
	wolfLL = vCharacter:FindFirstChild(&quot;WolfLeftLeg&quot;)
	wolfRL = vCharacter:FindFirstChild(&quot;WolfRightLeg&quot;)

	if wolfTorso == nil then wolfTorso = Instance.new(&quot;CharacterMesh&quot;) end
	if wolfLA == nil then wolfLA = Instance.new(&quot;CharacterMesh&quot;) end
	if wolfRA == nil then wolfRA = Instance.new(&quot;CharacterMesh&quot;) end
	if wolfLL == nil then wolfLL = Instance.new(&quot;CharacterMesh&quot;) end
	if wolfRL == nil then wolfRL = Instance.new(&quot;CharacterMesh&quot;) end

	wolfTorso.Parent = vCharacter
	wolfTorso.Name = &quot;WolfTorso&quot;
	wolfTorso.BodyPart = &quot;Torso&quot;
	wolfTorso.BaseTextureId = wolfBaseTex
	wolfTorso.OverlayTextureId = wolfOverTex
	wolfTorso.MeshId = 27130997


	wolfLA.Parent = vCharacter
	wolfLA.Name = &quot;WolfLeftArm&quot;
	wolfLA.BodyPart = &quot;LeftArm&quot;
	wolfLA.BaseTextureId = wolfBaseTex
	wolfLA.OverlayTextureId = wolfOverTex
	wolfLA.MeshId = 27131042


	wolfRA.Parent = vCharacter
	wolfRA.Name = &quot;WolfRightArm&quot;
	wolfRA.BodyPart = &quot;RightArm&quot;
	wolfRA.BaseTextureId = wolfBaseTex
	wolfRA.OverlayTextureId = wolfOverTex
	wolfRA.MeshId = 27131194

	
	wolfLL.Parent = vCharacter
	wolfLL.Name = &quot;WolfLeftLeg&quot;
	wolfLL.BodyPart = &quot;LeftLeg&quot;
	wolfLL.BaseTextureId = wolfBaseTex
	wolfLL.OverlayTextureId = wolfOverTex
	wolfLL.MeshId = 27128722

	wolfRL.Parent = vCharacter
	wolfRL.Name = &quot;WolfRightLeg&quot;
	wolfRL.BodyPart = &quot;RightLeg&quot;
	wolfRL.BaseTextureId = wolfBaseTex
	wolfRL.OverlayTextureId = wolfOverTex
	wolfRL.MeshId = 27131177

	--vPlayer.TeamColor = &quot;Orange&quot;

	wait(1)
	lowerBottle()

	local reloadTime = 29

	wait(reloadTime)
	Tool.Enabled = true
end

function onEquipped()
	magicSound = Tool.Handle:FindFirstChild(&quot;MagicSound&quot;)
	if magicSound == nil then
		magicSound = Instance.new(&quot;Sound&quot;)
		magicSound.Parent = Tool.Handle
		magicSound.Volume = 1
		magicSound.SoundId = &quot;http://www.roblox.com/asset/?id=36431384&quot;
		magicSound.Name = &quot;MagicSound&quot;
	end
end

function onUnequipped()
	magicSound = Tool.Handle:FindFirstChild(&quot;MagicSound&quot;)
	if magicSound ~= nil then
		magicSound:Stop()
		magicSound.Parent = nil
	end
end

Tool.Activated:connect(onActivated)
Tool.Equipped:connect(onEquipped)
Tool.Unequipped:connect(onUnequipped)
</ProtectedString>
