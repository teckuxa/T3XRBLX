			<Item class="Script" referent="RBX4848">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">local Tool = script.Parent

Tool.Enabled = true
function onActivated()
	if not Tool.Enabled then return end
      Tool.Enabled = false
	
	vCharacter = Tool.Parent
	if vCharacter.Name == &quot;BackPack&quot; then Tool.Enabled = true return end
	if vCharacter:FindFirstChild(&quot;Vampyrius&quot;) == nil and vCharacter:FindFirstChild(&quot;Vampyrius Maximus&quot;) == nil then Tool.Enabled = true return end
 -- play sound
	magicSound = Tool.Handle:FindFirstChild(&quot;MagicSound&quot;)
	if magicSound == nil then return end
	magicSound:Play()

-- rest of script
	rightHand = vCharacter:FindFirstChild(&quot;Right Arm&quot;)
	if rightHand == nil then Tool.Enabled = true return end
	local spawnPos = rightHand.Position
	
	humanoid = vCharacter:FindFirstChild(&quot;Humanoid&quot;)
	if humanoid == nil then Tool.Enabled = true return end

	Tool.FireMyLazah.Value = false

	missile = Instance.new(&quot;Part&quot;)
	mFire = Instance.new(&quot;Fire&quot;)
	mFire.Parent = missile

--	missile.BottomSurface = 0
--	missile.TopSurface = 0
	missile.Name = &quot;VampBlast&quot;
	missile.Reflectance = 1
	missile.Transparency = 0
	--missile.Transparency = 1
	missile.CanCollide = false
	missile.Shape = 0

	local gravity = 196.1643

	local force = Instance.new(&quot;BodyForce&quot;)
	force.force = Vector3.new(0,gravity*missile:getMass(),0)
	--force.Parent = missile

	local pos = Instance.new(&quot;BodyPosition&quot;)
	pos.maxForce = Vector3.new(10000,10000,10000)

	local creator_tag = Instance.new(&quot;ObjectValue&quot;)
	creator_tag.Value = vPlayer
	creator_tag.Name = &quot;creator&quot;
	creator_tag.Parent = missile

	growth = .5
	local targetPos = humanoid.TargetPoint
	local dPos = targetPos - vCharacter.Head.Position
	missile.Parent = game.Workspace
	missile.Position = spawnPos
	pos.position = spawnPos
	pos.Parent = missile
	while (not Tool.FireMyLazah.Value and growth &lt; 4) do
		targetPos = humanoid.TargetPoint
		dPos = (targetPos - vCharacter.Head.Position)
	
		spawnPos = rightHand.Position
		spawnPos = spawnPos + dPos.unit*6
		--dPos = dPos - dPos.unit * 6
	
		--missile.Position = spawnPos
		pos.position = spawnPos
		missile.Size = Vector3.new(growth,growth,growth)
		mFire.Size = 3*growth
		--mFire.Heat = growth*8 - 2
		force.force = Vector3.new(0,gravity*missile:getMass(),0)
		wait(.1)
		growth = growth + .07
	end
	force.Parent = missile
	pos.Parent = nil
	-- need to set Tool.FireMyLazah.Value to false here?

	targetPos = humanoid.TargetPoint
	--dPos = (targetPos - vCharacter.Head.Position)
	dPos = targetPos - rightHand.Position
	
	spawnPos = rightHand.Position
	spawnPos = spawnPos + dPos.unit*6
	--dPos = dPos - dPos.unit * 6

	missile.Position = spawnPos

	missile.Velocity = (dPos.unit*50) +  (dPos.unit * (growth + .5) * 30)
	missile.CanCollide = true

	--missile.BrickColor = BrickColor.Random()

	local damage = growth*30 + 70
	print(&quot;LAUNCHER DAMAGE: &quot; .. damage)
	local new_script = script.Parent.LaserBlast:clone()
	new_script.Damage.Value = damage
	new_script.Disabled = false
	new_script.Parent = missile

	game.Debris:AddItem(missile, 20)

	wait(.1) -- want relatively short reload time, but can&apos;t make it instantaneous...  maybe 1 or .5 here?

	Tool.Enabled = true
end

function onEquipped()
	magicSound = Tool.Handle:FindFirstChild(&quot;MagicSound&quot;)
	if magicSound == nil then
		magicSound = Instance.new(&quot;Sound&quot;)
		magicSound.Parent = Tool.Handle
		magicSound.Volume = 1
		magicSound.SoundId = &quot;http://www.roblox.com/asset/?id=35571070&quot;
		magicSound.Name = &quot;MagicSound&quot;
	end
end


function onUnequipped()
	magicSound = Tool.Handle:FindFirstChild(&quot;MagicSound&quot;)
	if magicSound ~= nil then
		magicSound:Stop()
		magicSound.Parent = nil
	end
end

Tool.Activated:connect(onActivated)
Tool.Equipped:connect(onEquipped)
Tool.Unequipped:connect(onUnequipped)
