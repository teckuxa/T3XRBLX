				<Item class="Script" referent="RBX461">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">TunnelCloggerScript</string>
						<ProtectedString name="Source">tunnelClogger = script.Parent
tunnelCloggerHumanoid = tunnelClogger.Humanoid

tunnelCloggerHumanoid.Torso = tunnelClogger.Torso
tunnelClogger.Torso.Neck.Part0 = tunnelClogger.Head
tunnelClogger.Torso.Neck.Part1 = tunnelClogger.Torso

tunnelCloggerHumanoid.Health = tunnelCloggerHumanoid.MaxHealth

stillRun = true

function unAnchorParts()
	myChildren = tunnelClogger:GetChildren()
	for i = 1, #myChildren do
		if (myChildren[i].className == &quot;Part&quot;) then
			myChildren[i].Anchored = false
		end
	end
end

while time() &lt; 10 do
	wait(1)
end
if time() &lt; 20 then print(&quot;Happy days&quot;) tunnelCloggerHumanoid.Health = tunnelCloggerHumanoid.MaxHealth tunnelCloggerHumanoid:TakeDamage(1) end

cloggerCopy = tunnelClogger:Clone()
cloggerCopyHumanoid = cloggerCopy.Humanoid
cloggerCopy.Torso.Neck.Part0 = cloggerCopy.Head
cloggerCopy.Torso.Neck.Part1 = cloggerCopy.Torso
cloggerCopy.Parent = game.Lighting
cloggerCopyHumanoid.MaxHealth = tunnelCloggerHumanoid.MaxHealth - 200

while time() &lt; 10 do
	wait(1)
end
if time() &lt; 20 then tunnelCloggerHumanoid.Health = tunnelCloggerHumanoid.MaxHealth end

local oldHealth = tunnelCloggerHumanoid.Health
local tunnelParent = tunnelClogger.Parent
local oldClogger = nil

while stillRun do
	if tunnelCloggerHumanoid.Health &lt;= 0 then
		--see if insta-kill (more than 200 damage in 2 seconds since last check)
		if oldHealth &gt; 200 then --limit damage to only 200 every 2 seconds
			tunnelClogger.Parent = game.Lighting
			oldClogger = tunnelClogger
			--cloggerCopy.Parent = tunnelClogger.Parent
			cloggerCopy.Parent = tunnelParent
			tunnelClogger = cloggerCopy
			tunnelCloggerHumanoid = cloggerCopyHumanoid
			--cloggerCopy = tunnelClogger:Clone()
			tunnelCloggerHumanoid.Health = oldHealth - 200
			--cloggerCopyHumanoid = cloggerCopy.Humanoid
			--cloggerCopy.Torso.Neck.Part0 = cloggerCopy.Head
			--cloggerCopy.Torso.Neck.Part1 = cloggerCopy.Torso
			oldClogger.Parent = nil
			script.Parent = nil
		else
			unAnchorParts()
			stillRun = false
			tunnelClogger.Head:remove()
			tunnelClogger.DisappearingRock:remove()
		end
	end
	oldHealth = tunnelCloggerHumanoid.Health
	tunnelCloggerHumanoid.MaxHealth = 1000
	wait(2)
end
</ProtectedString>
						<bool name="archivable">true</bool>
