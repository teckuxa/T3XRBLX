			<Item class="LocalScript" referent="RBX4815">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">HardeningScript</string>
					<ProtectedString name="Source">local Tool = script.Parent
local dancer = nil

Tool.Enabled = true
function onActivated()
	if not Tool.Enabled then return end
      Tool.Enabled = false

	vCharacter = Tool.Parent
	humanoid = vCharacter:FindFirstChild(&quot;Humanoid&quot;)
	if humanoid == nil then Tool.Enabled = true return end
	if vCharacter.Name == &quot;BackPack&quot; then Tool.Enabled = true return end
	if vCharacter:FindFirstChild(&quot;Lycanis&quot;) == nil and vCharacter:FindFirstChild(&quot;Lycanis Noctus&quot;) == nil then Tool.Enabled = true return end

 -- play sound
	magicSound = Tool.Handle:FindFirstChild(&quot;MagicSound&quot;)
	if magicSound == nil then return end
	magicSound:Play()

-- rest of script
	Tool.Handle.Transparency = 1
	dancer = humanoid:LoadAnimation(Tool.werewolfcurl)
	Tool.DanceObject.Value = dancer
	dancer:Play()
	--oldWalkSpeed = humanoid.WalkSpeed
	oldWalkSpeed = 16 -- set speed to return back to normal, so even if quicksilvered, will still go to normal after hardening
					--  (needed to prevent speedups from stacking)
	oldHealth = humanoid.Health
	humanoid.WalkSpeed = 0

	myVelocity = vCharacter.Torso.Velocity
	newBV = Instance.new(&quot;BodyVelocity&quot;)
	newBV.Name = &quot;HardeningVelocity&quot;
	newBV.velocity = myVelocity
	newBV.maxForce = Vector3.new(500000,0,500000)
	newBV.Parent = vCharacter.Torso

	--Tool.Handle.SongLoop:Play()
	newBG = Instance.new(&quot;BodyGyro&quot;)
	newBG.Name = &quot;HardeningGyro&quot;
	--newBG.maxTorque = Vector3.new(50000, 0, 50000)
	newBG.maxTorque = Vector3.new(50000000, 0, 50000000)
	newBG.Parent = vCharacter.Torso
	rad = 0

	-- negate all damage HERE
	--humanoid.Health

	for i = 1, 30 do -- 30
		humanoid.Health = oldHealth -- lock health into place except for kills faster than .2 seconds
		newBG.cframe = CFrame.Angles(rad, 0, rad)
		wait(.2)
		rad = rad + .4

		if i == 5 then -- after 1 second, remove bg
			newBG.Parent = nil
		end
		if i == 10 then -- after 2 seconds, remove bv
			newBV.Parent = nil
		end
		if i == 15 then
			newBG.Parent = vCharacter.Torso
		end
	end

	newBG.Parent = nil

	-- undo damage negation HERE
	humanoid.Health = oldHealth

	humanoid.WalkSpeed = oldWalkSpeed
	--Tool.Handle.SongLoop:Stop()
	dancer:Stop()
	dancer:remove()
	--root:remove()

	Tool.Handle.Transparency = 0
	Tool.Enabled = true
end

function onEquipped()
	magicSound = Tool.Handle:FindFirstChild(&quot;MagicSound&quot;)
	if magicSound == nil then
		magicSound = Instance.new(&quot;Sound&quot;)
		magicSound.Parent = Tool.Handle
		magicSound.Volume = 1
		magicSound.SoundId = &quot;http://www.roblox.com/asset/?id=35571070&quot;
		magicSound.Name = &quot;MagicSound&quot;
	end
end


function onUnequipped()


	magicSound = Tool.Handle:FindFirstChild(&quot;MagicSound&quot;)
	if magicSound ~= nil then
		magicSound:Stop()
		magicSound.Parent = nil
	end
end

Tool.Activated:connect(onActivated)
Tool.Equipped:connect(onEquipped)
Tool.Unequipped:connect(onUnequipped)

</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="Animation" referent="RBX4816">
				<Properties>
					<Content name="AnimationId"><url>http://www.roblox.com/Asset?ID=42070810</url></Content>
					<string name="Name">werewolfcurl</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX4817">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">UnequipScript</string>
					<ProtectedString name="Source">local Tool = script.Parent
local humanoid = nil

function onEquipped()

	humanoid = Tool.Parent:FindFirstChild(&quot;Humanoid&quot;)

end

function onUnequipped()

	if humanoid ~= nil then
		if Tool.DanceObject.Value ~= nil then
			Tool.DanceObject.Value:Stop()
			Tool.DanceObject.Value:remove()
		end
	end

end

Tool.Equipped:connect(onEquipped)
Tool.Unequipped:connect(onUnequipped)
</ProtectedString>
