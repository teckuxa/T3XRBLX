						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">ButtonScript</string>
						<ProtectedString name="Source">function Clicked()
if script.Parent.Text == &quot;Fact File: The Empire:&quot; then
script.Parent.Text = &quot;Close&quot;
script.Parent.Parent.Frame.Visible = true
elseif script.Parent.Text == &quot;Close&quot; then
script.Parent.Text = &quot;Fact File: The Empire:&quot;
script.Parent.Parent.Frame.Visible = false
end
end


script.Parent.MouseButton1Down:connect(Clicked)</ProtectedString>
