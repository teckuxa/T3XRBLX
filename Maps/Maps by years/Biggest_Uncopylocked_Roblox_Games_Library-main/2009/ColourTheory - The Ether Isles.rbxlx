					<Item class="Script" referent="RBX1062">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">local w = Instance.new(&quot;Weld&quot;)
w.Parent = script.Parent
w.Part0 = script.Parent
w.Part1 = script.Parent.Parent.Move
w.C0 = CFrame.new(0,-1,0)*CFrame.fromEulerAnglesXYZ(0,0,0)</ProtectedString>
						</Properties>
					</Item>
					<Item class="Script" referent="RBX1063">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">script.Parent.Parent.Move.BodyGyro.cframe = CFrame.fromEulerAnglesXYZ(0,3.14,0)
value1 = 0
while true do
wait()
if script.Parent.Throttle== 1 then
if value1 &lt; 41 then value1 = value1+1 end
script.Parent.Parent.Move.BodyVelocity.velocity = script.Parent.Parent.Move.CFrame.lookVector*value1
end
if script.Parent.Throttle == 0 then
value1 = 0
script.Parent.Parent.Move.BodyVelocity.velocity = script.Parent.Parent.Move.CFrame.lookVector*value1
end
if script.Parent.Throttle== -1 then
if value1&lt;31 then value1 = value1+1 end
script.Parent.Parent.Move.BodyVelocity.velocity = script.Parent.Parent.Move.CFrame.lookVector*-value1
end
if script.Parent.Steer == 1 then
script.Parent.Parent.Move.BodyGyro.cframe = script.Parent.Parent.Move.BodyGyro.cframe * CFrame.fromEulerAnglesXYZ(0,-.1,0)
end
if script.Parent.Steer == -1 then
script.Parent.Parent.Move.BodyGyro.cframe = script.Parent.Parent.Move.BodyGyro.cframe * CFrame.fromEulerAnglesXYZ(0,.1,0)
end
end</ProtectedString>
						</Properties>
