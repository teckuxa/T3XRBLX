				<ProtectedString name="Source">adminlist = {&quot;ColourTheory&quot;}--Add in the names of the people you want to be able to use the command script here.

bannedlist = {&quot;mydogthecow&quot;,&quot;SuperDude69&quot;,&quot;LordOptimism&quot;,&quot;SmallTheory&quot;,&quot;88388&quot;,&quot;darkarcane&quot;,&quot;stephen5&quot;,&quot;Ryanr23&quot;,&quot;shadowpurky&quot;,&quot;ethanc&quot;,&quot;TravisGamer&quot;,&quot;Beatlesgirl01234&quot;,&quot;hoot14&quot;,&quot;loljameslol1&quot;,&quot;Philanthropic&quot;,&quot;liavkr104&quot;,&quot;studioscript&quot;,&quot;mason986&quot;,&quot;blasterdud97&quot;,&quot;freefranneh4u&quot;,&quot;xspiky45x&quot;,&quot;joey11746&quot;,&quot;riskyviking&quot;,&quot;013370&quot;,&quot;colbob&quot;,&quot;camo73&quot;,&quot;funguyi&quot;}--If you want someone not to be able to enter your place, put thier name in here.
