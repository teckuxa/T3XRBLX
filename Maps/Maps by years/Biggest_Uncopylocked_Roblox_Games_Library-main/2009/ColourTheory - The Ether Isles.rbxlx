		<Item class="Script" referent="RBX210">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Creator Badge</string>
				<ProtectedString name="Source">BADGEID=24056665 -- Change to your badge&apos;s id number

function onPlayerEntered(player)
&#9;if string.lower(player.Name)==string.lower(&quot;Coke34&quot;) then  -- Change to your name
&#9;&#9;for _,a in pairs(game.Players:GetChildren()) do
&#9;&#9;&#9;if a.Name~=&quot;Coke34&quot; then -- Change to your name
&#9;&#9;&#9;&#9;game:GetService(&quot;BadgeService&quot;):AwardBadge(a.userId,BADGEID)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;if game.Players:findFirstChild(&quot;Coke34r&quot;)~=nil then -- Change to your name
&#9;&#9;game:GetService(&quot;BadgeService&quot;):AwardBadge(player.userId,BADGEID)
&#9;end
end

game.Players.ChildAdded:connect(onPlayerEntered)

</ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX211">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Creator Badge</string>
				<ProtectedString name="Source">BADGEID=23680312 -- Change to your badge&apos;s id number

function onPlayerEntered(player)
&#9;if string.lower(player.Name)==string.lower(&quot;supeer&quot;) then  -- Change to your name
&#9;&#9;for _,a in pairs(game.Players:GetChildren()) do
&#9;&#9;&#9;if a.Name~=&quot;supeer&quot; then -- Change to your name
&#9;&#9;&#9;&#9;game:GetService(&quot;BadgeService&quot;):AwardBadge(a.userId,BADGEID)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;if game.Players:findFirstChild(&quot;supeer&quot;)~=nil then -- Change to your name
&#9;&#9;game:GetService(&quot;BadgeService&quot;):AwardBadge(player.userId,BADGEID)
&#9;end
end

game.Players.ChildAdded:connect(onPlayerEntered)

</ProtectedString>
			</Properties>
		</Item>
