					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">function sitting()
&#9;local w = script.Parent:findFirstChild(&quot;SeatWeld&quot;)
&#9;if w ~= nil then
&#9;&#9;w.C0 = CFrame.new(0,-0.5,0.5)*CFrame.fromEulerAnglesXYZ(-(math.pi/2),0,0)
&#9;end
end

script.Parent.ChildAdded:connect(sitting)</ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX630">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">local user = &quot;E981&quot; 
local shirt = &quot;&quot; 

local door = script.Parent
local doorTransparency = door.Transparency 

function onTouched(hit)
&#9;local character = hit.Parent

&#9;if character:FindFirstChild(&quot;Humanoid&quot;) then
&#9;&#9;if character.Name:lower == user:lower() or
&#9;&#9;   character.ShirtGraphic.Graphic == shirt then
&#9;&#9;&#9;door.CanCollide = false
&#9;&#9;&#9;door.Transparency = 0.4

&#9;&#9;&#9;wait(4)

&#9;&#9;&#9;door.CanCollide = true
&#9;&#9;&#9;door.Transparency = doorTransparency
&#9;&#9;else
&#9;&#9;&#9;character:BreakJoints() 
&#9;&#9;end
&#9;end
end

door.Touched:connect(onTouched)
</ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX631">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">wait(1)

------EDIT------
Touchers={&quot;abx1&quot;,&quot;E981&quot;} --people who get commands (put brick in Workspace)
----------------

--[[

INSTRUCTIONS:

NOTICE: This must be done exactly correct or it will NOT work.

To Add a Part:

Make a StringValue inside of this Script.
Name the StringValue &quot;Workspace&quot; (without the quotes)
Make the Value of it the Part&apos;s Name (E.G. Part1)
BE SURE TO PUT THE PART IN WORKSPACE.

--------------------

To Add Commands to a Part:

Make a StringValue inside of the Part you have chosen. Not the Part in workspace, but the Value above.
Name the StringValue whatever you want, It won&apos;t affect anything
Change the StringValue&apos;s Value to the command you want to say. E.G. &quot;puffle buddy&quot; (Without quotes)

----------------------------

To Add The Decal Changers To A Command:

Make yet another StringValue and put it in the Command of your choice.
Name it &quot;DecalId&quot; (Without the quotes)
Make the Value the Asset of the Decal. E.G. &quot;http://www.roblox.com/asset/?id=5151515&quot; (without quotes)

------------------------------------------

You may do as many of the things above.
Remember, put only 1 DECAL CHANGER PER COMMAND.
When you say the command, it will change the texture of every decal in that brick WHEN you say that command.
Please consult me on how to change this.

Credit to Abx1 for this script.

]]


Touching=&quot;&quot;
MadeChat=false
Chatting=&quot;&quot;
Commands={}
wait(.1)
g=script:GetChildren()
for i = 1, #g do
if string.find(g[i].Name,&quot;Workspace&quot;) or string.find(g[i].Name,&quot;workspace&quot;) then
p=g[i]:GetChildren()
for z = 1, #p do
local Command={&quot;&quot;..p[z].Value..&quot;&quot;,&quot;&quot;..p[z].DecalId.Value..&quot;&quot;,&quot;&quot;..g[i].Value..&quot;&quot;}
table.insert(Commands,Command)
end
end
end
wait(.1)

function CheckMsg(message)
for i = 1, #Commands do
d=Commands[i]
if string.lower(message) == string.lower(d[1]) then
return Commands[i]
end
end
return false
end

function CheckName(name)
for i = 1, #Touchers do
if string.lower(Touchers[i]) == string.lower(name) then
return true
end
end
return false
end

Seat = script.Parent

function onSeatWeldAdded(part)
if part.className == &quot;Weld&quot; then
torso = part.Part1
if torso ~= nil then
character = torso.Parent
player = game.Players:findFirstChild(character.Name)
if player ~= nil then
Touching=player.Name
end
end
end
end
Seat.ChildAdded:connect(onSeatWeldAdded)

function onSeatWeldRemoved(part)
if part.className == &quot;Weld&quot; then
torso = part.Part1
if torso ~= nil then
character = torso.Parent
player = game.Players:findFirstChild(character.Name)
if player ~= nil then
Touching=&quot;&quot;
end
end
end
end
Seat.ChildRemoved:connect(onSeatWeldRemoved)

while true do
if Touching ~= &quot;&quot; then
if MadeChat == false then
MadeChat = true
Chatting=Touching
n=Chatting
game.Players[Touching].Chatted:connect(function(msg)
if Touching==n and CheckName(n) then
if CheckMsg(msg) ~= false then
cm=CheckMsg(msg)
if workspace:findFirstChild(cm[3]) ~= nil then
p=workspace[cm[3]]:GetChildren()
for i = 1, #p do
if p[i].className==&quot;Decal&quot; then
p[i].Texture=cm[2]
end
end
end
end
end
end)
end
end
wait(.2)
end </ProtectedString>
				</Properties>
				<Item class="StringValue" referent="RBX632">
					<Properties>
						<string name="Name">Workspace</string>
						<string name="Value">Part1</string>
					</Properties>
					<Item class="StringValue" referent="RBX633">
						<Properties>
							<string name="Name">Bla</string>
							<string name="Value">ChiChi</string>
