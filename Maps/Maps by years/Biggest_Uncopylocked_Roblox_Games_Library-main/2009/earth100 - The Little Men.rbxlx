				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">wait(0.2)
Build = script.Parent -- Parent shortcut
Parts = {} -- Table to store parts.
Materials = {}
Trans = {}

Sparkles = Instance.new(&quot;Sparkles&quot;)
Sparkles.SparkleColor = Color3.new(0,0.5,0.5)

Healing = true

function CheckHealth(Ally)
&#9;if Ally.Class.Value == &quot;Unit&quot; then
&#9;&#9;for i,v in pairs(game.Lighting:getChildren()) do
&#9;&#9;&#9;if v:findFirstChild(&quot;Class&quot;)~= nil then
&#9;&#9;&#9;&#9;if v.Class.Value == &quot;Unit&quot; then
&#9;&#9;&#9;&#9;&#9;if v.UnitType.Value == Ally.UnitType.Value then
&#9;&#9;&#9;&#9;&#9;&#9;if Ally.Health.Value &gt;= v.Health.Value then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;return false
&#9;&#9;&#9;&#9;&#9;&#9;else 
&#9;&#9;&#9;&#9;&#9;&#9;&#9;return true
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;elseif Ally.Class.Value == &quot;Building&quot; then
&#9;&#9;local v = game.Lighting[Ally.Name]
&#9;&#9;print(v.Name)
&#9;&#9;if Ally.Health.Value &gt;= v.MaxHealth.Value then
&#9;&#9;&#9;return false
&#9;&#9;else 
&#9;&#9;&#9;return true
&#9;&#9;end
&#9;end
end&#9;

function CheckIfAllied(MyTeam,ObjectTeam)
&#9;for i,v in pairs(Workspace.DiplomacyFolder:getChildren()) do
&#9;&#9;if v.Value == MyTeam then
&#9;&#9;&#9;for _,team in pairs(v:getChildren()) do
&#9;&#9;&#9;&#9;if team.Value == ObjectTeam then return true end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;return false
end

for i,v in pairs(Build:getChildren()) do
&#9;if v.Name == &quot;Asthetic&quot; then
&#9;&#9;v.BrickColor = Build.Team.Value -- Color asthetics accordingly
&#9;end
&#9;if v:IsA(&quot;Part&quot;) then
&#9;&#9;table.insert(Parts,v) -- If its a part record it
&#9;&#9;table.insert(Materials,v.Material)
&#9;&#9;table.insert(Trans,v.Transparency)
&#9;end
end 

Build.Health.Value = Build.MaxHealth.Value
Build.Health.Value = Build.MaxHealth.Value
MaxHealth = Build.MaxHealth.Value

Build.Health.Changed:connect(function(Value)
&#9;DamageRep = 1-(Value/MaxHealth) -- Get decimal for damage
&#9;NumberDamaged = math.floor(#Parts*DamageRep)
&#9;for i,v in pairs(Parts) do
&#9;&#9;v.Material = Materials[i] -- reset building
&#9;end
&#9;if NumberDamaged &gt;=1 and NumberDamaged &lt;= #Parts then -- If we have some damage
&#9;&#9;for i=1,NumberDamaged do -- Damage the building
&#9;&#9;&#9;Parts[i].Material = &quot;CorrodedMetal&quot; -- Show it.
&#9;&#9;end
&#9;else -- No damage
&#9;&#9;for i,v in pairs(Parts) do
&#9;&#9;&#9;v.Material = Materials[i] -- reset building
&#9;&#9;end
&#9;end
&#9;if Value &lt;= 0 then
&#9;&#9;for i,v in pairs(Parts) do
&#9;&#9;&#9;v.Anchored = false
&#9;&#9;end
&#9;&#9;e = Instance.new(&quot;Explosion&quot;)
&#9;&#9;e.BlastPressure = 0
&#9;&#9;e.Position = Build.Torso.Position
&#9;&#9;e.Parent = Build
&#9;&#9;Build:BreakJoints()
&#9;&#9;Sparkles:remove() -- die asthetics.
&#9;&#9;wait(3)
&#9;&#9;Build:remove()
&#9;end
end)

function Repair(Ally,Health)
&#9;if Ally:findFirstChild(&quot;Torso&quot;) == nil then return end -- He&apos;s dead D:
&#9;local Ally = Ally
&#9;local Heal = Health
&#9;if Ally.Class.Value == &quot;Unit&quot; then
&#9;&#9;print(&quot;Unit&quot;)
&#9;&#9;for i,v in pairs(game.Lighting:getChildren()) do
&#9;&#9;&#9;if v:findFirstChild(&quot;Class&quot;)~= nil then
&#9;&#9;&#9;&#9;if v.Class.Value == &quot;Unit&quot; then
&#9;&#9;&#9;&#9;&#9;if v.UnitType.Value == Ally.UnitType.Value then
&#9;&#9;&#9;&#9;&#9;&#9;if Ally.Health.Value+Health &gt;= v.Health.Value+Health then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;Heal = 0
&#9;&#9;&#9;&#9;&#9;&#9;&#9;Healing = false
&#9;&#9;&#9;&#9;&#9;&#9;elseif v.Health.Value-Ally.Health.Value &lt;= Health then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;Heal = v.Health.Value-Ally.Health.Value
&#9;&#9;&#9;&#9;&#9;&#9;elseif Ally.Health.Value+Health &lt; v.Health.Value then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;Heal = Health
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;elseif Ally.Class.Value == &quot;Building&quot; then
&#9;&#9;print(&quot;Building&quot;)
&#9;&#9;local v = game.Lighting[Ally.Name]
&#9;&#9;if Ally.Health.Value+Health &gt;= v.MaxHealth.Value+Health then
&#9;&#9;&#9;Heal = 0
&#9;&#9;&#9;Healing = false
&#9;&#9;elseif v.MaxHealth.Value-Ally.Health.Value &lt;= Health then
&#9;&#9;&#9;Heal = v.MaxHealth.Value-Ally.Health.Value
&#9;&#9;elseif Ally.Health.Value+Health &lt; v.MaxHealth.Value then
&#9;&#9;&#9;Heal = Health
&#9;&#9;end&#9;&#9;
&#9;end
&#9;Ally.Health.Value = Ally.Health.Value+Heal
&#9;if Heal&gt;0 then
&#9;&#9;Sparkles.Parent = Shoot.Torso
&#9;end
end


if Build.Built.Value == false then
&#9;for i,v in pairs(Parts) do
&#9;&#9;v.Transparency = v.Transparency+1
&#9;end
&#9;for i,v in pairs(Parts) do
&#9;&#9;v.CFrame = v.CFrame*CFrame.new(0,5,0)
&#9;&#9;for i=1,10 do
&#9;&#9;&#9;v.CFrame = v.CFrame*CFrame.new(0,-0.5,0)
&#9;&#9;&#9;v.Transparency = v.Transparency-0.1
&#9;&#9;&#9;wait()
&#9;&#9;end
&#9;&#9;v.Transparency = Trans[i]
&#9;&#9;wait(Build.BuildingTime.Value)
&#9;end
&#9;Build.Built.Value = true
&#9;s = Instance.new(&quot;Sparkles&quot;)
&#9;s.Parent = Build.Torso
&#9;if Build.Worker.Value ~= nil then
&#9;&#9;Build.Worker.Value.Parent.Torso.Anchored = false
&#9;&#9;Build.Worker.Value.Parent:MoveTo(Build.Torso.Position+Vector3.new(math.random(10,15)*((math.random(0,1)*2)-1),1.75,math.random(10,15)*((math.random(0,1)*2)-1)))
&#9;end
&#9;wait(2)
&#9;s:remove()
end 


waittime = 5
while true do
&#9;wait(waittime)
&#9;Targets = {}
&#9;for i,v in pairs(Workspace:getChildren()) do
&#9;&#9;if v:findFirstChild(&quot;Team&quot;) ~= nil and v.Team.Value ~= Build.Team.Value and CheckIfAllied(Build.Team.Value,v.Team.Value) == false and (v.Torso.Position-Build.Torso.Position).magnitude&lt;=50 then
&#9;&#9;&#9;table.insert(Targets,v) -- Build a table :3
&#9;&#9;end
&#9;end

&#9;if #Targets &lt;= 0 then

&#9;&#9;Targets = {}
&#9;&#9;for i,v in pairs(Workspace:getChildren()) do
&#9;&#9;&#9;if v:findFirstChild(&quot;Team&quot;) ~= nil and (v.Team.Value == Build.Team.Value or CheckIfAllied(Build.Team.Value,v.Team.Value) == true) and v~= Build and CheckHealth(v) == true then
&#9;&#9;&#9;&#9;table.insert(Targets,v) -- Build a table :3
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;Closest = 50 -- Range
&#9;&#9;Shoot = nil
&#9;&#9;Targeted = nil
&#9;&#9;&#9;for i,v in pairs(Targets) do
&#9;&#9;&#9;&#9;if v~= nil and v.Name ~= &quot;Air&quot; and v:FindFirstChild(&quot;Torso&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;if (v.Torso.Position-Build.Torso.Position).magnitude&lt;=Closest then
&#9;&#9;&#9;&#9;&#9;&#9;Targeted = v
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;elseif v~= nil and v.Name == &quot;Air&quot; and v:FindFirstChild(&quot;Torso&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;if (v.AttackPosition.Position-Build.Torso.Position).magnitude&lt;=Closest then
&#9;&#9;&#9;&#9;&#9;&#9;Targeted = v
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;Shoot = Targeted
&#9;&#9;Sparkles = Instance.new(&quot;Sparkles&quot;)
&#9;&#9;ColorSpar = Build.Team.Value
&#9;&#9;Sparkles.SparkleColor = Color3.new(ColorSpar.r,ColorSpar.g,ColorSpar.b)
&#9;&#9;if Shoot~= nil then
&#9;&#9;&#9;while Healing == true and (Shoot.Torso.Position-Build.Torso.Position).magnitude &lt;= 50 do -- While its alive and in range 
&#9;&#9;&#9;&#9;wait(0.5)
&#9;&#9;&#9;&#9;if Shoot.Class.Value == &quot;Building&quot; then
&#9;&#9;&#9;&#9;&#9;Repair(Shoot,5)
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;Repair(Shoot,2)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;Sparkles.Parent = nil
&#9;&#9;&#9;Healing = true
&#9;&#9;&#9;waittime = 0.5
&#9;&#9;else
&#9;&#9;&#9;waittime = 5
&#9;&#9;end
&#9;end
end

&#9;</ProtectedString>
