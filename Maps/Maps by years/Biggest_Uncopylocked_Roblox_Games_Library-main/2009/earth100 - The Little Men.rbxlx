game.Players.PlayerAdded:connect(function (p)
&#9;local p = p
&#9;local waittime = 0
&#9;while p~= nil and p.Character == nil and waittime&lt;=150 do wait(0.1) waittime = waittime+1 end
&#9;if waittime &gt;= 150 then if p ~= nil then p:remove() end return end
&#9;Money = Instance.new(&quot;NumberValue&quot;)
&#9;Money.Name = &quot;Money&quot;
&#9;Money.Value = 300
&#9;Money.Parent = p

&#9;NumberSoldiers = 0
&#9;for i,v in pairs(game.Workspace:getChildren()) do
&#9;&#9;if v:findFirstChild(&quot;Team&quot;) ~= nil and v.Team.Value == p.TeamColor and v.Class.Value == &quot;Unit&quot; and v.Name == &quot;Soldier&quot; then -- NOTE ADD CHECK FOR IS SOLDIER
&#9;&#9;&#9;NumberSoldiers = NumberSoldiers+1
&#9;&#9;end
&#9;end

&#9;TroopC = Instance.new(&quot;NumberValue&quot;)
&#9;TroopC.Name = &quot;Soldier&quot;
&#9;TroopC.Value = NumberSoldiers -- Starting troop #
&#9;TroopC.Parent = p
&#9;
&#9;TroopM = Instance.new(&quot;NumberValue&quot;)
&#9;TroopM.Name = &quot;SoldierMax&quot;
&#9;TroopM.Value = 10
&#9;TroopM.Parent = p

&#9;amnt = 0
&#9;for _,v in pairs(Workspace:getChildren()) do
&#9;&#9;if v:findFirstChild(&quot;Team&quot;) ~= nil and v.Team.Value == p.TeamColor and v:findFirstChild(&quot;PopVal&quot;) ~= nil then
&#9;&#9;&#9;amnt = amnt+v.PopVal.Value
&#9;&#9;end
&#9;end

&#9;TroopC = Instance.new(&quot;NumberValue&quot;)
&#9;TroopC.Name = &quot;Population&quot;
&#9;TroopC.Value = amnt
&#9;TroopC.Parent = p
&#9;
&#9;TroopM = Instance.new(&quot;NumberValue&quot;)
&#9;TroopM.Name = &quot;MaxPopulation&quot;
&#9;TroopM.Value = 40
&#9;TroopM.Parent = p


&#9;Selection = Instance.new(&quot;Model&quot;)
&#9;Selection.Name = &quot;Selection&quot;
&#9;Selection.Parent = p

&#9;TroopM = Instance.new(&quot;StringValue&quot;)
&#9;TroopM.Name = &quot;Command&quot;
&#9;TroopM.Value = &quot;&quot;
&#9;TroopM.Parent = p

&#9;soldiers = 0
&#9;command = nil
&#9;for _,v in pairs(Workspace:GetChildren()) do
&#9;&#9;if v:findFirstChild(&quot;Team&quot;) ~= nil and v:findFirstChild(&quot;Class&quot;) ~= nil then
&#9;&#9;&#9;if v.Team.Value == p.TeamColor and v.Class.Value == &quot;Unit&quot; then
&#9;&#9;&#9;&#9;soldiers = soldiers+1
&#9;&#9;&#9;elseif v.Team.Value == p.TeamColor and v.Name == &quot;CommandCenter&quot; then
&#9;&#9;&#9;&#9;command = v
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;if soldiers &lt;= 0  and command ~= nil then
&#9;&#9;for i=1,3 do
&#9;&#9;&#9;local New = game.Lighting.Soldier:clone()
&#9;&#9;&#9;New.Team.Value = p.TeamColor
&#9;&#9;&#9;New.Parent = Workspace
&#9;&#9;&#9;New:MakeJoints()
&#9;&#9;&#9;New:MoveTo(command.Torso.Position+Vector3.new(math.random(-15,15),New.Height.Value,math.random(-15,15)))&#9;
&#9;&#9;&#9;wait()
&#9;&#9;end
&#9;end

&#9;NumberBuilds = 0
&#9;for i,v in pairs(game.Workspace:getChildren()) do
&#9;&#9;if v:findFirstChild(&quot;Team&quot;) ~= nil and v.Team.Value == p.TeamColor and v.Class.Value == &quot;Building&quot; and v:findFirstChild(&quot;Turret&quot;) == nil then
&#9;&#9;&#9;NumberBuilds = NumberBuilds+1
&#9;&#9;end
&#9;end

&#9;BC = Instance.new(&quot;NumberValue&quot;)
&#9;BC.Name = &quot;Building&quot;
