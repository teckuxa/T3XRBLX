			<Item class="LocalScript" referent="RBX1025">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">LocalScript</string>
					<ProtectedString name="Source">bin = script.Parent
Player = bin.Parent.Parent
TeamColor = Player.TeamColor
Selected = {}
Holder = {}
Modes = {&quot;Command&quot;,&quot;Recruit&quot;,&quot;Building&quot;,&quot;Salvage&quot;,&quot;Diplomacy&quot;,&quot;Interface&quot;}
Modecounter = 1
TechOrders = 0
Mode = Modes[Modecounter]

MouseStatus = &quot;Up&quot;
Dragging = false

SelBox = Instance.new(&quot;Part&quot;)
SelBox.formFactor = 2
SelBox.Transparency = 1
SelBox.TopSurface = 0
SelBox.BottomSurface = 0
SelBox.Size = Vector3.new(1,1,1)
SelBox.Name = &quot;Selection&quot;
SelBox.CanCollide = false
SelBox.Anchored = true
SelBox.Parent = Workspace.CurrentCamera

Marker = Instance.new(&quot;BoolValue&quot;)
Marker.Name = &quot;Terrain&quot;
Marker.Parent = SelBox

function CleanSelected()
&#9;for i,v in pairs(Selected) do
&#9;&#9;if v == nil or v:findFirstChild(&quot;Torso&quot;) == nil then
&#9;&#9;&#9;rawset(Selected,i,Selected[i+1])
&#9;&#9;end
&#9;end
end


function UpdateGui()
&#9;Player.PlayerGui.GameData.Data.TroopPop.Text = &quot;Soldiers: &quot;..Player.Soldier.Value..&quot;/&quot;..Player.SoldierMax.Value
&#9;Player.PlayerGui.GameData.Data.VehiclePop.Text = &quot;Vehicles: &quot;..Player.Vehicle.Value..&quot;/&quot;..Player.VehicleMax.Value
&#9;Player.PlayerGui.GameData.Data.AirPop.Text = &quot;Air Units: &quot;..Player.Air.Value..&quot;/&quot;..Player.AirMax.Value
&#9;Player.PlayerGui.GameData.Data.BuildingNum.Text = &quot;Buildings: &quot;..Player.Building.Value..&quot;/&quot;..Player.BuildingMax.Value
&#9;Player.PlayerGui.GameData.Data.WallNum.Text = &quot;Land Mines: &quot;..Player.Wall.Value..&quot;/&quot;..Player.WallMax.Value
&#9;Player.PlayerGui.GameData.Data.TurretNum.Text = &quot;Turrets: &quot;..Player.Turret.Value..&quot;/&quot;..Player.TurretMax.Value
&#9;if Mode == &quot;Building&quot; then
&#9;&#9;Player.PlayerGui.GameData.BuildMenu.Visible = true
&#9;else
&#9;&#9;Player.PlayerGui.GameData.BuildMenu.Visible = false
&#9;end
&#9;if Mode == &quot;Recruit&quot; then
&#9;&#9;Player.PlayerGui.GameData.RecruitMenu.Visible = true
&#9;else
&#9;&#9;Player.PlayerGui.GameData.RecruitMenu.Visible = false
&#9;end
&#9;if Mode == &quot;Interface&quot; then
&#9;&#9;Player.PlayerGui.GameData.InterfaceData.Visible = true
&#9;else
&#9;&#9;Player.PlayerGui.GameData.InterfaceData.Visible = false
&#9;end
&#9;if Mode ~= &quot;Diplomacy&quot; then
&#9;&#9;Player.PlayerGui.GameData.DiplomacyMenu.Visible = false
&#9;end
end

function March(Position,Alerted)
&#9;CleanSelected()
&#9;for i,v in pairs(Selected) do
&#9;&#9;if v:findFirstChild(&quot;Class&quot;) ~= nil then
&#9;&#9;&#9;if v.Class.Value == &quot;Unit&quot; then
&#9;&#9;&#9;&#9;if Alerted == true then
&#9;&#9;&#9;&#9;&#9;Up = -0.5
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;Up = v.Height.Value
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;v.Target.Value = Vector3.new(Position.x,Position.y+Up,Position.z)
&#9;&#9;&#9;&#9;if v:findFirstChild(&quot;OnAlert&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;v.OnAlert.Value = Alerted
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

function CheckInside(Container,Part)
&#9;Lowerxz = Vector2.new(Container.Position.x-Container.Size.x/2,Container.Position.z-Container.Size.z/2)
&#9;Upperxz = Vector2.new(Container.Position.x+Container.Size.x/2,Container.Position.z+Container.Size.z/2)
&#9;PartPos = Vector2.new(Part.Position.x,Part.Position.z)
&#9;if (PartPos.x&gt;Lowerxz.x and PartPos.x &lt; Upperxz.x) and (PartPos.y&gt;Lowerxz.y and PartPos.y&lt; Upperxz.y) then
&#9;&#9;return true
&#9;else
&#9;&#9;return false
&#9;end
end

LastMousePos = CFrame.new(0,0,0)
bin.Selected:connect(function (mouse)
&#9;--TeamColor = bin.Parent.Parent.TeamColor
&#9;mouse.Button1Down:connect(function()
&#9;&#9;MouseStatus = &quot;Down&quot;
&#9;&#9;LastMousePos = mouse.Hit
&#9;end)
&#9;mouse.Move:connect(function()
&#9;&#9;if Player.PlayerGui.GameData.Preferences.SelectionMode.Value ~= &quot;Drag&quot; then return end
&#9;&#9;if MouseStatus == &quot;Down&quot; then
&#9;&#9;&#9;wait(0.1)
&#9;&#9;&#9;if MouseStatus ~= &quot;Down&quot; then return end
&#9;&#9;&#9;Dragging = true
&#9;&#9;&#9;local Current = CFrame.new(mouse.Hit.x,0,mouse.Hit.z)
&#9;&#9;&#9;local Last = CFrame.new(LastMousePos.x,0,LastMousePos.z)
&#9;&#9;&#9;if math.abs(Current.x-Last.x) &lt;1 or math.abs(Current.z-Last.z) &lt;1 then return end
&#9;&#9;&#9;Sizex = math.ceil(math.abs(Current.x-Last.x))
&#9;&#9;&#9;Sizez = math.ceil(math.abs(Current.z-Last.z))
&#9;&#9;&#9;Position = CFrame.new(Last.x+math.ceil(Current.x-Last.x)/2,LastMousePos.y+0.25,Last.z+math.ceil(Current.z-Last.z)/2)
&#9;&#9;&#9;SelBox.Size = Vector3.new(Sizex,1,Sizez)
&#9;&#9;&#9;SelBox.CFrame = Position
&#9;&#9;&#9;SelBox.Transparency = 0.5
&#9;&#9;end
&#9;end)
&#9;mouse.Button1Up:connect(function()
&#9;&#9;MouseStatus = &quot;Up&quot;
&#9;&#9;if Mode == &quot;Command&quot; then -- Command mode.
&#9;&#9;&#9;Hit = mouse.Target
&#9;&#9;&#9;local Position = mouse.Hit
&#9;&#9;&#9;if Hit == nil then return end -- Yes, thats the sky.
&#9;&#9;&#9;if Dragging == true and Player.PlayerGui.GameData.Preferences.SelectionMode.Value == &quot;Drag&quot; then
&#9;&#9;&#9;&#9;Selected = {}
&#9;&#9;&#9;&#9;for i,v in pairs(Workspace:getChildren()) do
&#9;&#9;&#9;&#9;&#9;if v:findFirstChild(&quot;Team&quot;) ~= nil and v.Team.Value == TeamColor and v.Class.Value == &quot;Unit&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;if CheckInside(SelBox,v.Torso) == true then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;table.insert(Selected,v)
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;SelBox.Transparency = 1
&#9;&#9;&#9;&#9;SelBox.Size = Vector3.new(1,1,1)
&#9;&#9;&#9;end
&#9;&#9;&#9;if Hit.Parent:findFirstChild(&quot;Team&quot;) ~= nil then -- Its a thing.
&#9;&#9;&#9;&#9;if Hit.Parent.Team.Value == TeamColor then -- Is it allied?
&#9;&#9;&#9;&#9;&#9;if Hit.Parent.Class.Value == &quot;Unit&quot; then -- Itsa unit
&#9;&#9;&#9;&#9;&#9;&#9;for i,v in pairs(Selected) do
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if v == Hit.Parent then return end
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;table.insert(Selected,Hit.Parent)
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;else 
&#9;&#9;&#9;&#9;&#9;March(Position,true)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;elseif Hit:findFirstChild(&quot;Terrain&quot;) ~= nil and Dragging == false then
&#9;&#9;&#9;&#9;March(Position,false)
&#9;&#9;&#9;end 
&#9;&#9;&#9;Dragging = false
&#9;&#9;elseif Mode == &quot;Recruit&quot; then -- Recruit mode...
&#9;&#9;&#9;Hit = mouse.Target
&#9;&#9;&#9;local Position = mouse.Hit
&#9;&#9;&#9;if Hit == nil then return end -- Yes, thats the sky.
&#9;&#9;&#9;if Hit.Parent:findFirstChild(&quot;Team&quot;) ~= nil then -- Its a thing.
&#9;&#9;&#9;&#9;if Hit.Parent.Team.Value == TeamColor then -- Is it allied?
&#9;&#9;&#9;&#9;&#9;if Hit.Parent.Class.Value ~= &quot;Building&quot; then return end
&#9;&#9;&#9;&#9;&#9;if Hit.Parent:findFirstChild(&quot;Built&quot;) == nil then return end
&#9;&#9;&#9;&#9;&#9;if Hit.Parent.Built.Value == false then return end


&#9;&#9;&#9;&#9;&#9;if Hit.Parent.Name == &quot;Barracks&quot; then -- Oh ho, a barracks eh?

&#9;&#9;&#9;&#9;&#9;&#9;UnitRequest = Player.PlayerGui.GameData.RecruitMenu.Selection.Value
&#9;&#9;&#9;&#9;&#9;&#9;if UnitRequest ~= &quot;Rifle&quot; and UnitRequest ~= &quot;Rocket&quot; and UnitRequest ~= &quot;Scout&quot; then print(&quot;Not built here&quot;) return end
&#9;&#9;&#9;&#9;&#9;&#9;Choice = nil
&#9;&#9;&#9;&#9;&#9;&#9;for i,v in pairs(game.Lighting:getChildren()) do
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if v:findFirstChild(&quot;UnitType&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;if v.UnitType.Value == UnitRequest then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;Choice = v
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;if Choice == nil then print(&quot;Nonexistant&quot;) return end
&#9;&#9;
&#9;&#9;&#9;&#9;&#9;&#9;---- modifications needed here.

&#9;&#9;&#9;&#9;&#9;&#9;if Player.Soldier.Value &gt;= Player.SoldierMax.Value then return end -- Check count of soldiers
&#9;&#9;&#9;&#9;&#9;&#9;if Player.Money.Value-Choice.Cost.Value &lt; 0 then return end

&#9;&#9;&#9;&#9;&#9;&#9;NewForm = Instance.new(&quot;NumberValue&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;NewForm.Name = UnitRequest
&#9;&#9;&#9;&#9;&#9;&#9;NewForm.Value = Choice.BuildTime.Value
&#9;&#9;&#9;&#9;&#9;&#9;NewForm.Parent = Hit.Parent.RecruitTable
&#9;&#9;&#9;&#9;&#9;&#9;Player.Money.Value = Player.Money.Value-Choice.Cost.Value
&#9;&#9;&#9;&#9;&#9;&#9;Player.Soldier.Value = Player.Soldier.Value+1
&#9;&#9;&#9;&#9;&#9;&#9;UpdateGui()

&#9;&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;&#9;&#9;if Hit.Parent.Name == &quot;WarFactory&quot; then -- Oh ho, a barracks eh?

&#9;&#9;&#9;&#9;&#9;&#9;UnitRequest = Player.PlayerGui.GameData.RecruitMenu.Selection.Value
&#9;&#9;&#9;&#9;&#9;&#9;if UnitRequest ~= &quot;Tank&quot; and UnitRequest ~= &quot;SAM&quot; and UnitRequest ~= &quot;Artillery&quot; then print(&quot;Not built here&quot;) return end
&#9;&#9;&#9;&#9;&#9;&#9;Choice = nil
&#9;&#9;&#9;&#9;&#9;&#9;for i,v in pairs(game.Lighting:getChildren()) do
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if v:findFirstChild(&quot;UnitType&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;if v.UnitType.Value == UnitRequest then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;Choice = v
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;if Choice == nil then print(&quot;Nonexistant&quot;) return end
&#9;&#9;
&#9;&#9;&#9;&#9;&#9;&#9;---- modifications needed here.

&#9;&#9;&#9;&#9;&#9;&#9;if Player.Vehicle.Value &gt;= Player.VehicleMax.Value then return end -- Check count of soldiers
&#9;&#9;&#9;&#9;&#9;&#9;if Player.Money.Value-Choice.Cost.Value &lt; 0 then return end

&#9;&#9;&#9;&#9;&#9;&#9;NewForm = Instance.new(&quot;NumberValue&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;NewForm.Name = UnitRequest
&#9;&#9;&#9;&#9;&#9;&#9;NewForm.Value = Choice.BuildTime.Value
&#9;&#9;&#9;&#9;&#9;&#9;NewForm.Parent = Hit.Parent.RecruitTable
&#9;&#9;&#9;&#9;&#9;&#9;Player.Money.Value = Player.Money.Value-Choice.Cost.Value
&#9;&#9;&#9;&#9;&#9;&#9;Player.Vehicle.Value = Player.Vehicle.Value+1
&#9;&#9;&#9;&#9;&#9;&#9;UpdateGui()

&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;if Hit.Parent.Name == &quot;Airfield&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;UnitRequest = Player.PlayerGui.GameData.RecruitMenu.Selection.Value
&#9;&#9;&#9;&#9;&#9;&#9;if UnitRequest ~= &quot;Heli&quot; and UnitRequest ~= &quot;HeavyHeli&quot; and UnitRequest ~= &quot;TransportHeli&quot; then print(&quot;Not built here&quot;) return end
&#9;&#9;&#9;&#9;&#9;&#9;Choice = nil
&#9;&#9;&#9;&#9;&#9;&#9;for i,v in pairs(game.Lighting:getChildren()) do
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if v:findFirstChild(&quot;UnitType&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;if v.UnitType.Value == UnitRequest then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;Choice = v
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;if Choice == nil then print(&quot;Nonexistant&quot;) return end
&#9;&#9;
&#9;&#9;&#9;&#9;&#9;&#9;---- modifications needed here.

&#9;&#9;&#9;&#9;&#9;&#9;if Player.Air.Value &gt;= Player.AirMax.Value then return end -- Check count of soldiers
&#9;&#9;&#9;&#9;&#9;&#9;if Player.Money.Value-Choice.Cost.Value &lt; 0 then return end

&#9;&#9;&#9;&#9;&#9;&#9;NewForm = Instance.new(&quot;NumberValue&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;NewForm.Name = UnitRequest
&#9;&#9;&#9;&#9;&#9;&#9;NewForm.Value = Choice.BuildTime.Value
&#9;&#9;&#9;&#9;&#9;&#9;NewForm.Parent = Hit.Parent.RecruitTable
&#9;&#9;&#9;&#9;&#9;&#9;Player.Money.Value = Player.Money.Value-Choice.Cost.Value
&#9;&#9;&#9;&#9;&#9;&#9;Player.Air.Value = Player.Air.Value+1
&#9;&#9;&#9;&#9;&#9;&#9;UpdateGui()
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;elseif Mode == &quot;Building&quot; then
&#9;&#9;&#9;local Hit = mouse.Target
&#9;&#9;&#9;local Position = mouse.Hit
&#9;&#9;&#9;Choice = Player.PlayerGui.GameData.BuildMenu.Selection.Value
&#9;&#9;&#9;if Choice == &quot;None&quot; then return end -- No choice.
&#9;&#9;&#9;if Choice ~= &quot;SteamPlant&quot; then
&#9;&#9;&#9;&#9;if Hit:findFirstChild(&quot;Buildable&quot;) == nil then return end-- Construction good.
&#9;&#9;&#9;&#9;if Choice ~= &quot;Turret&quot; and Choice ~= &quot;HeavyTurret&quot; and Choice ~= &quot;AirTurret&quot; and Choice ~= &quot;Wall&quot; and Choice ~= &quot;Connector&quot; then -- Normal building
&#9;&#9;&#9;&#9;&#9;if Player.Building.Value&gt;= Player.BuildingMax.Value then return end -- Check #
&#9;&#9;&#9;&#9;elseif Choice ~= &quot;Wall&quot; and Choice ~= &quot;Connector&quot; then
&#9;&#9;&#9;&#9;&#9;if Player.Turret.Value &gt;= Player.TurretMax.Value then return end -- Turret
&#9;&#9;&#9;&#9;elseif Choice == &quot;Wall&quot; then
&#9;&#9;&#9;&#9;&#9;if Player.Wall.Value &gt;= Player.WallMax.Value then return end&#9;-- Wall piece.
&#9;&#9;&#9;&#9;&#9;for i,v in pairs(Workspace:getChildren()) do
&#9;&#9;&#9;&#9;&#9;&#9;if v:findFirstChild(&quot;Class&quot;) ~= nil and v.Class.Value == &quot;Unit&quot; and v.Team.Value ~= Player.TeamColor and v:findFirstChild(&quot;Torso&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if (v.Torso.Position-Vector3.new(Position.x,Position.y,Position.z)).magnitude &lt;= 30 then return end
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;&#9;Building = game.Lighting:findFirstChild(Choice)
&#9;&#9;&#9;&#9;if Choice == nil then print(&quot;Building not found&quot;) return end

&#9;&#9;&#9;&#9;if Player.Money.Value-Building.Cost.Value &lt; 0 then return end

&#9;&#9;&#9;&#9;Place = Vector3.new(Position.x,Position.y,Position.z)
&#9;&#9;&#9;&#9;Close = false
&#9;&#9;&#9;&#9;for i,v in pairs(Workspace:GetChildren()) do 
&#9;&#9;&#9;&#9;&#9;if v:findFirstChild(&quot;Team&quot;) ~= nil and v.Team.Value == TeamColor and v:findFirstChild(&quot;Class&quot;)~= nil and v.Class.Value == &quot;Building&quot; and (v.Name == &quot;CommandCenter&quot; or v.Name == &quot;SteamPlant&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;OtherBuilding = v.Torso.Position
&#9;&#9;&#9;&#9;&#9;&#9;if (Place-OtherBuilding).magnitude &lt; 45 and v.Built.Value == true then -- If its close and built. 
&#9;&#9;&#9;&#9;&#9;&#9;&#9;Close = true
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;if Close == false then return end


&#9;&#9;&#9;&#9;New = Building:clone()
&#9;&#9;&#9;&#9;New.Team.Value = TeamColor
&#9;&#9;&#9;&#9;if Choice == &quot;WarFactory&quot; then
&#9;&#9;&#9;&#9;&#9;Record = New.Script
&#9;&#9;&#9;&#9;&#9;Record.Parent = nil
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;New.Parent = Workspace
&#9;&#9;&#9;&#9;New:MakeJoints()
&#9;&#9;&#9;&#9;New:MoveTo(Vector3.new(Position.x,Position.y,Position.z))
&#9;&#9;&#9;&#9;Base = nil
&#9;&#9;&#9;&#9;for i,v in pairs(New:getChildren()) do
&#9;&#9;&#9;&#9;&#9;if v:findFirstChild(&quot;Base&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;Base = v
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;if New:findFirstChild(&quot;Turret&quot;) == nil and New.Name ~= &quot;Wall&quot; then
&#9;&#9;&#9;&#9;&#9;Player.Building.Value = Player.Building.Value+1
&#9;&#9;&#9;&#9;elseif New.Name ~= &quot;Wall&quot; then
&#9;&#9;&#9;&#9;&#9;Player.Turret.Value = Player.Turret.Value+1
&#9;&#9;&#9;&#9;elseif New.Name == &quot;Wall&quot; then
&#9;&#9;&#9;&#9;&#9;Player.Wall.Value = Player.Wall.Value+1
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;if Base == nil then print(&quot;ERROR NO BASE&quot;) return end
&#9;&#9;&#9;&#9;IdealPlane = Hit.Position.y+(Hit.Size.y/2)+Base.Size.y
&#9;&#9;&#9;&#9;ActualPlane = Base.Position.y+(Base.Size.y/2)
&#9;&#9;&#9;&#9;Okay = true
&#9;&#9;&#9;&#9;if (ActualPlane+0.1&lt; IdealPlane or ActualPlane-0.1 &gt; IdealPlane) then
&#9;&#9;&#9;&#9;&#9;print(IdealPlane..&quot; ---------&quot;..ActualPlane)
&#9;&#9;&#9;&#9;&#9;New:remove()
&#9;&#9;&#9;&#9;&#9;Okay = false
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;if Okay == true then
&#9;&#9;&#9;&#9;&#9;Player.Money.Value = Player.Money.Value-Building.Cost.Value -- If its successfully placed and built then pay up buddy.&#9;
&#9;&#9;&#9;&#9;&#9;wait(0.2)
&#9;&#9;&#9;&#9;&#9;if Choice == &quot;WarFactory&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;Record.Parent = New
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;UpdateGui()
&#9;&#9;&#9;elseif Choice == &quot;SteamPlant&quot; then -- Steamplants are special.
&#9;&#9;&#9;&#9;if Hit.Parent.Name == &quot;VolcanicArea&quot; and Hit.Parent.Occupied.Value == false then
&#9;&#9;&#9;&#9;&#9;Close = false
&#9;&#9;&#9;&#9;&#9;for i,v in pairs(Workspace:GetChildren()) do
&#9;&#9;&#9;&#9;&#9;&#9;if v:findFirstChild(&quot;Class&quot;) ~= nil and v.Class.Value == &quot;Unit&quot; and v.Team.Value == TeamColor then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if (v.Torso.Position-Hit.Position).magnitude &lt;= 10 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;Close = true
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;if Close == false then return end
&#9;&#9;&#9;&#9;&#9;if Player.Money.Value-50 &lt; 0 then return end
&#9;&#9;&#9;&#9;&#9;Player.Money.Value = Player.Money.Value-50
&#9;&#9;&#9;&#9;&#9;Construction = Instance.new(&quot;Model&quot;)
&#9;&#9;&#9;&#9;&#9;Construction.Name = &quot;SteamPlant&quot;
&#9;&#9;&#9;&#9;&#9;_Main = Instance.new(&quot;Part&quot;)
&#9;&#9;&#9;&#9;&#9;_Main.formFactor = 2
&#9;&#9;&#9;&#9;&#9;_Main.Size = Vector3.new(2,3,2)
&#9;&#9;&#9;&#9;&#9;_Main.TopSurface = 0
&#9;&#9;&#9;&#9;&#9;_Main.BottomSurface = 0
&#9;&#9;&#9;&#9;&#9;_Main.CFrame = Hit.Parent.Lava1.CFrame*CFrame.new(0,1,0)
&#9;&#9;&#9;&#9;&#9;_Main.Anchored = true
&#9;&#9;&#9;&#9;&#9;_Main.Name = &quot;Torso&quot;
&#9;&#9;&#9;&#9;&#9;_Main.Parent = Construction

&#9;&#9;&#9;&#9;&#9;for i=1,2 do 
&#9;&#9;&#9;&#9;&#9;&#9;_Second = Instance.new(&quot;Part&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;_Second.formFactor = &quot;Plate&quot;
&#9;&#9;&#9;&#9;&#9;&#9;_Second.Size = Vector3.new(2,0,2)
&#9;&#9;&#9;&#9;&#9;&#9;_Second.TopSurface = 0
&#9;&#9;&#9;&#9;&#9;&#9;_Second.BottomSurface = 0
&#9;&#9;&#9;&#9;&#9;&#9;_Second.Position = _Main.Position+Vector3.new(0,(_Main.Size.y/2)+(0.2*i),0)
&#9;&#9;&#9;&#9;&#9;&#9;if i == 1 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;_Second.Name = &quot;Asthetic&quot;
&#9;&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;&#9;_Second.Name = &quot;Part&quot;
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;_Second.Anchored = true
&#9;&#9;&#9;&#9;&#9;&#9;_Second.Parent = Construction
&#9;&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;&#9;&#9;for i=2,3 do
&#9;&#9;&#9;&#9;&#9;&#9;_Tube = Instance.new(&quot;Part&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;_Tube.formFactor = 2
&#9;&#9;&#9;&#9;&#9;&#9;_Tube.Size = Vector3.new(2,2,2)
&#9;&#9;&#9;&#9;&#9;&#9;_Tube.Position = Hit.Parent[&quot;Lava&quot;..i].Position+Vector3.new(0,(Hit.Parent[&quot;Lava&quot;..i].Size.y/2)+1,0)
&#9;&#9;&#9;&#9;&#9;&#9;_Tube.Anchored = true
&#9;&#9;&#9;&#9;&#9;&#9;_Tube.TopSurface = 0
&#9;&#9;&#9;&#9;&#9;&#9;_Tube.BottomSurface = 0
&#9;&#9;&#9;&#9;&#9;&#9;_Tube.Reflectance = 0.2
&#9;&#9;&#9;&#9;&#9;&#9;_Tube.Name = &quot;HoldingTank&quot;
&#9;&#9;&#9;&#9;&#9;&#9;_Tube.BrickColor = BrickColor.new(&quot;Dark stone grey&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;_Mesh = Instance.new(&quot;CylinderMesh&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;_Mesh.Parent = _Tube
&#9;&#9;&#9;&#9;&#9;&#9;_Tube.Parent = Construction
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;for i,v in pairs(Construction:getChildren()) do
&#9;&#9;&#9;&#9;&#9;&#9;if v.Name == &quot;HoldingTank&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;local Shot = Instance.new(&quot;Part&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;Shot.Name = &quot;Shot&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;Shot.TopSurface = 0
&#9;&#9;&#9;&#9;&#9;&#9;&#9;Shot.BottomSurface = 0
&#9;&#9;&#9;&#9;&#9;&#9;&#9;Shot.Size = Vector3.new(1,1,(v.Position-_Main.Position).magnitude)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;Shot.CFrame = CFrame.new(v.Position,_Main.Position)*CFrame.new(0,0,-1*Shot.Size.z/2)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;Shot.Anchored = true
&#9;&#9;&#9;&#9;&#9;&#9;&#9;Mesh = Instance.new(&quot;SpecialMesh&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;Mesh.MeshType = &quot;Brick&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;Mesh.Scale = Vector3.new(0.1,0.1,1)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;Mesh.Parent = Shot
&#9;&#9;&#9;&#9;&#9;&#9;&#9;Shot.Parent = Construction
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;for i,v in pairs(script.Parent.ConstructionPack:getChildren()) do
&#9;&#9;&#9;&#9;&#9;&#9;if v.Name == &quot;Team&quot; then v.Value = TeamColor end
&#9;&#9;&#9;&#9;&#9;&#9;if v.Name == &quot;Built&quot; then v.Value = false end
&#9;&#9;&#9;&#9;&#9;&#9;if v.className ~= &quot;Script&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;v:clone().Parent = Construction
&#9;&#9;&#9;&#9;&#9;&#9;end 
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;Construction.Occupying.Value = Hit.Parent.Lava1
&#9;&#9;&#9;&#9;&#9;Construction.Parent = Workspace
&#9;&#9;&#9;&#9;&#9;wait(0.1)
&#9;&#9;&#9;&#9;&#9;_Han = script.Parent.ConstructionPack.Script:clone()
&#9;&#9;&#9;&#9;&#9;_Han.Disabled = false
&#9;&#9;&#9;&#9;&#9;_Han.Parent = Construction
&#9;&#9;&#9;&#9;&#9;Hit.Parent.Occupied.Value = true
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;elseif Mode == &quot;Salvage&quot; then
&#9;&#9;&#9;Hit = mouse.Target
&#9;&#9;&#9;local Position = mouse.Hit
&#9;&#9;&#9;if Hit == nil then return end -- Yes, thats the sky.
&#9;&#9;&#9;if Hit.Parent:findFirstChild(&quot;Team&quot;) == nil then return end-- Its a thing.
&#9;&#9;&#9;if Hit.Parent.Team.Value ~= TeamColor then return end -- Is it allied?
&#9;&#9;&#9;if Hit.Parent.Health.Value &lt;= 0 then return end -- Is it dead?
&#9;&#9;&#9;Player.PlayerGui.GameData.Selling.Selection.Value = Hit
&#9;&#9;elseif Mode == &quot;Diplomacy&quot; then
&#9;&#9;&#9;Hit = mouse.Target
&#9;&#9;&#9;local Position = mouse.Hit
&#9;&#9;&#9;if Hit == nil then return end -- Yes, thats the sky.
&#9;&#9;&#9;if Hit.Parent:findFirstChild(&quot;Team&quot;) == nil then return end-- Its a thing.
&#9;&#9;&#9;if Hit.Parent.Team.Value == TeamColor then return end -- Is it My Team
&#9;&#9;&#9;Player.PlayerGui.GameData.DiplomacyMenu.Selection.Value = Hit.Parent.Team.Value
&#9;&#9;elseif Mode == &quot;Interface&quot; then
&#9;&#9;&#9;local Hit = mouse.Target
&#9;&#9;&#9;if Hit == nil then return end -- Yes, thats the sky.
&#9;&#9;&#9;if Hit.Parent:findFirstChild(&quot;Team&quot;) == nil then return end-- Its a thing.
&#9;&#9;&#9;if Hit.Parent.Team.Value ~= TeamColor then return end -- Is it My Team

&#9;&#9;&#9;Player.PlayerGui.GameData.InterfaceData.Selection.Value = Hit
&#9;&#9;&#9;if Hit.Parent.Name == &quot;ResearchCenter&quot; then
&#9;&#9;&#9;&#9;if Player.Money.Value-150 &lt; 0 then return end
&#9;&#9;&#9;&#9;TechOrders = TechOrders+1
&#9;&#9;&#9;&#9;local CurrentTech = TechOrders
&#9;&#9;&#9;&#9;Player.PlayerGui.GameData.TechMenu.Visible = true

&#9;&#9;&#9;&#9;Player.PlayerGui.GameData.TechMenu.TechType.Changed:connect(function(val)
&#9;&#9;&#9;&#9;&#9;if val ~= &quot;None&quot; and CurrentTech == TechOrders then
&#9;&#9;&#9;&#9;&#9;&#9;local TForm = Instance.new(&quot;NumberValue&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;TForm.Name = val
&#9;&#9;&#9;&#9;&#9;&#9;TForm.Value = game.Lighting.TechnologyTimes[val].Value
&#9;&#9;&#9;&#9;&#9;&#9;TForm.Parent = Hit.Parent.TechTable
&#9;&#9;&#9;&#9;&#9;&#9;Player.Money.Value = Player.Money.Value-150
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end)
&#9;mouse.KeyDown:connect(function(key)
&#9;&#9;local key = string.lower(key)
&#9;&#9;if key == &quot;t&quot; then -- T clears the selection table.
&#9;&#9;&#9;Selected = {}
&#9;&#9;&#9;print&quot;Cleared&quot;
&#9;&#9;elseif key == &quot;q&quot; then
&#9;&#9;&#9;if Modecounter &lt;= 1 then
&#9;&#9;&#9;&#9;Modecounter = #Modes -- Don&apos;t go to low, we start at the top
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;Modecounter = Modecounter-1 -- go down the modes
&#9;&#9;&#9;end
&#9;&#9;&#9;Mode = Modes[Modecounter] -- set new mode
&#9;&#9;&#9;bin.Parent.Parent.PlayerGui.GameData.Data.ModeShower.Text = &quot;Current Mode: &quot;..Mode
&#9;&#9;&#9;print(Mode)
&#9;&#9;&#9;UpdateGui()
&#9;&#9;elseif key == &quot;e&quot; then
&#9;&#9;&#9;if Modecounter &gt;= # Modes then
&#9;&#9;&#9;&#9;Modecounter = 1
&#9;&#9;&#9;else 
&#9;&#9;&#9;&#9;Modecounter = Modecounter+1 -- go up the modes
&#9;&#9;&#9;end
&#9;&#9;&#9;Mode = Modes[Modecounter] -- Set new mode
&#9;&#9;&#9;bin.Parent.Parent.PlayerGui.GameData.Data.ModeShower.Text = &quot;Current Mode: &quot;..Mode
&#9;&#9;&#9;print(Mode)
&#9;&#9;&#9;UpdateGui()
&#9;&#9;end
&#9;end)
end)

Workspace.ChildRemoved:connect(function (Child)
&#9;if Child:findFirstChild(&quot;Team&quot;) ~= nil then
&#9;&#9;if Child.Team.Value == TeamColor then
&#9;&#9;&#9;if Child.Name == &quot;Soldier&quot; and Child.Cleaning.Value == false then
&#9;&#9;&#9;&#9;Player.Soldier.Value = Player.Soldier.Value-1
&#9;&#9;&#9;&#9;UpdateGui()
&#9;&#9;&#9;elseif Child.Class.Value == &quot;Building&quot; and Child.Cleaning.Value == false and Child.Name ~= &quot;SteamPlant&quot; then
&#9;&#9;&#9;&#9;if Child:findFirstChild(&quot;Turret&quot;) == nil and Child.Name ~= &quot;Wall&quot; and Child.Name ~= &quot;Connector&quot; then
&#9;&#9;&#9;&#9;&#9;Player.Building.Value = Player.Building.Value-1
&#9;&#9;&#9;&#9;elseif Child.Name ~= &quot;Wall&quot; and Child.Name ~= &quot;Connector&quot; then
&#9;&#9;&#9;&#9;&#9;Player.Turret.Value = Player.Turret.Value-1
&#9;&#9;&#9;&#9;elseif Child.Name == &quot;Wall&quot; or Child.Name == &quot;Connector&quot; then
&#9;&#9;&#9;&#9;&#9;Player.Wall.Value = Player.Wall.Value-1
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;UpdateGui()
&#9;&#9;&#9;elseif Child.Name == &quot;Vehicle&quot; and Child.Cleaning.Value == false then
&#9;&#9;&#9;&#9;Player.Vehicle.Value = Player.Vehicle.Value-1
&#9;&#9;&#9;&#9;UpdateGui()
&#9;&#9;&#9;elseif Child.Name == &quot;Air&quot; and Child.Cleaning. Value == false then
&#9;&#9;&#9;&#9;Player.Air.Value = Player.Air.Value-1
&#9;&#9;&#9;&#9;UpdateGui()
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end)</ProtectedString>
