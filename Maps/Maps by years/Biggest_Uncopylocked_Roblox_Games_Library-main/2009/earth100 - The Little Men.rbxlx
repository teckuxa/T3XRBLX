									<YS>0</YS>
									<YO>60</YO>
								</UDim2>
								<token name="SizeConstraint">0</token>
								<string name="Text">Welcome to &quot;The Little men. In this game you will attempt to lead your army to victory over five opposing colors. You should try and find your base. Your base is usually a building or two, and some soldiers. </string>
								<Color3 name="TextColor3">4294967040</Color3>
								<bool name="TextScaled">false</bool>
								<Color3 name="TextStrokeColor3">4278190080</Color3>
