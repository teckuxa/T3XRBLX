&#9;VA.Value = 5
&#9;VA.Parent = p

&#9;NumberT = 0
&#9;for i,v in pairs(game.Workspace:getChildren()) do
&#9;&#9;if v:findFirstChild(&quot;Team&quot;) ~= nil and v.Team.Value == p.TeamColor and v.Class.Value == &quot;Building&quot; and v.Name == &quot;Wall&quot;  then
&#9;&#9;&#9;NumberT = NumberT+1
&#9;&#9;end
&#9;end

&#9;BC = Instance.new(&quot;NumberValue&quot;)
&#9;BC.Name = &quot;Wall&quot;
