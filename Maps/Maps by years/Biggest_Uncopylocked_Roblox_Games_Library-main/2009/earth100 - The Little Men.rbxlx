								<XS>1</XS>
								<XO>0</XO>
								<YS>0</YS>
								<YO>60</YO>
							</UDim2>
							<token name="SizeConstraint">0</token>
							<string name="Text">GAME PLAY: Select the game tool. Do NOT deselect this. In the bottom right of your screen you should see a box, listing things suchas the current mode, soldier count, and how much money you have. Use Q, or E to cycle the current mode. </string>
							<Color3 name="TextColor3">4294967040</Color3>
