&#9;Attack = &quot;http://www.roblox.com/asset/?id=52620079&quot;,
&#9;Salvage = &quot;http://www.roblox.com/asset/?id=52218827&quot;,
&#9;SetRally = &quot;http://www.roblox.com/asset/?id=53044472&quot;,
&#9;Deploy = &quot;http://www.roblox.com/asset/?id=53117856&quot;
}

function findByTag(tag)
&#9;for _,v in pairs(game.Lighting:getChildren()) do
&#9;&#9;if v:findFirstChild(&quot;Tag&quot;) ~= nil and v.Tag.Value == tag then
&#9;&#9;&#9;return v
&#9;&#9;end
&#9;end
&#9;return nil
end


function select(object,command) -- this handles all the commands. object recieves the command, command is a string that is the command...
&#9;print(&quot;running commands&quot;)
&#9;if string.sub(command,1,7) == &quot;Recruit&quot; then -- gives the recruitform to the building.

&#9;&#9;local form = Instance.new(&quot;IntValue&quot;) 
&#9;&#9;for _,v in pairs(game.Lighting:getChildren()) do
&#9;&#9;&#9;if v:findFirstChild(&quot;Tag&quot;) ~= nil then
&#9;&#9;&#9;&#9;if string.sub(command,8) == v.Tag.Value then
&#9;&#9;&#9;&#9;&#9;if (player.Money.Value-v.Cost.Value) &lt; 0 then return end
&#9;&#9;&#9;&#9;&#9;if player.Population.Value+v.PopVal.Value &gt; player.MaxPopulation.Value then return end
&#9;&#9;&#9;&#9;&#9;player.Money.Value = player.Money.Value-v.Cost.Value
&#9;&#9;&#9;&#9;&#9;player.Population.Value = player.Population.Value+v.PopVal.Value

&#9;&#9;&#9;&#9;&#9;form.Name = v.UnitType.Value
&#9;&#9;&#9;&#9;&#9;form.Value = v.BuildTime.Value
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;form.Parent = object.RecruitTable
&#9;elseif command == &quot;Salvage&quot; then -- no tool interaction needed.
&#9;&#9;if object.Health.Value &gt; 0 then
&#9;&#9;&#9;returnamnt = object.Cost.Value *0.20
&#9;&#9;&#9;object.Health.Value = 0
&#9;&#9;&#9;player.Money.Value = player.Money.Value+returnamnt
&#9;&#9;end
&#9;elseif command == &quot;Stop&quot; then
&#9;&#9;for _,x in pairs(player.Selection:getChildren()) do
&#9;&#9;&#9;v = x.Value.Parent
&#9;&#9;&#9;if v:findFirstChild(&quot;Target&quot;) ~= nil and v:findFirstChild(&quot;Torso&quot;) ~= nil then -- stops moving units
&#9;&#9;&#9;&#9;v.Target.Value = v.Torso.Position
&#9;&#9;&#9;end
&#9;&#9;end
&#9;elseif command == &quot;Deploy&quot; then
&#9;&#9;for _,x in pairs(player.Selection:getChildren()) do
&#9;&#9;&#9;v = x.Value.Parent
&#9;&#9;&#9;if v:findFirstChild(&quot;Online&quot;) ~= nil then 
&#9;&#9;&#9;&#9;v.Online.Value = not v.Online.Value
&#9;&#9;&#9;end
&#9;&#9;end
&#9;elseif string.sub(command,1,5) == &quot;Build&quot; then
&#9;&#9;if lastbuildcommand+0.25 &gt; tick() then return end
&#9;&#9;lastbuildcommand = tick()
&#9;&#9;Building = nil
&#9;&#9;for _,v in pairs(game.Lighting:getChildren()) do
&#9;&#9;&#9;if v:findFirstChild(&quot;Tag&quot;) ~= nil and v.Tag.Value == string.sub(command,6) then
&#9;&#9;&#9;&#9;Building = v
&#9;&#9;&#9;end
&#9;&#9;end

&#9;&#9;if Building == nil then print(&quot;building not found&quot;) return end
&#9;&#9;&#9;
&#9;&#9;local Place = object.Torso.Position -- Location

&#9;&#9;for i,v in pairs(Workspace:getChildren()) do
&#9;&#9;&#9;if v:findFirstChild(&quot;Class&quot;) ~= nil and v.Class.Value == &quot;Unit&quot; and v.Team.Value ~= player.TeamColor and v:findFirstChild(&quot;Torso&quot;) ~= nil then
&#9;&#9;&#9;&#9;if (v.Torso.Position-Place).magnitude &lt;= 30 then return end
&#9;&#9;&#9;end
&#9;&#9;end -- removes too close buildings.

&#9;&#9;if player.Money.Value-Building.Cost.Value &lt; 0 then return end -- must have the money.

&#9;&#9;workerplace = object.Torso.Position
&#9;&#9;object:MoveTo(Vector3.new(math.random(100000,500000),math.random(100000,500000),math.random(100000,500000)))
&#9;&#9;wait(0.1)
&#9;&#9;object.Torso.Anchored = true

&#9;&#9;local bscript = nil
&#9;&#9;local New = Building:clone()
&#9;&#9;if New.Name == &quot;WarFactory&quot; then
&#9;&#9;&#9;bscript = New.Script
&#9;&#9;&#9;bscript.Parent = nil
&#9;&#9;end

&#9;&#9;if New.Name == &quot;SteamPlant&quot; then
&#9;&#9;&#9;plant = nil
&#9;&#9;&#9;for _, v in pairs(Workspace:getChildren()) do
&#9;&#9;&#9;&#9;if v:findFirstChild(&quot;VolcanicArea&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;for _,x in pairs(v:getChildren()) do
&#9;&#9;&#9;&#9;&#9;&#9;if x.Name == &quot;VolcanicArea&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if (x.Lava1.Position-workerplace).magnitude &lt;15 and x.Occupied.Value == false then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;plant = x
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;if plant ~= nil then
&#9;&#9;&#9;&#9;New.SteamZone.Value = plant[&quot;Lava1&quot;]
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;object.Torso.Anchored = false
&#9;&#9;&#9;&#9;object:MoveTo(workerplace)
&#9;&#9;&#9;&#9;New:remove()
&#9;&#9;&#9;&#9;return nil
&#9;&#9;&#9;end
&#9;&#9;end

&#9;&#9;New.Team.Value = player.TeamColor
&#9;&#9;New.Parent = Workspace
&#9;&#9;New:MakeJoints()
&#9;&#9;New:MoveTo(Place-Vector3.new(0,object.Height.Value,0))
&#9;&#9;New.Worker.Value = object.Torso -- record the worker.
&#9;&#9;if New.Name ~= &quot;SteamPlant&quot; then
&#9;&#9;&#9;Base = nil
&#9;&#9;&#9;for i,v in pairs(New:getChildren()) do
&#9;&#9;&#9;&#9;if v:findFirstChild(&quot;Base&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;Base = v
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;if Base == nil then print(&quot;ERROR NO BASE&quot;) return end&#9;
&#9;&#9;&#9;IdealPlane = (workerplace.y-object.Height.Value)+Base.Size.y
&#9;&#9;&#9;ActualPlane = Base.Position.y+(Base.Size.y/2)
&#9;&#9;&#9;if (ActualPlane+0.1&lt; IdealPlane or ActualPlane-0.1 &gt; IdealPlane) then
&#9;&#9;&#9;&#9;print(IdealPlane..&quot; ---------&quot;..ActualPlane)
&#9;&#9;&#9;&#9;object.Torso.Anchored = false
&#9;&#9;&#9;&#9;object:MoveTo(workerplace)
&#9;&#9;&#9;&#9;New:remove()
&#9;&#9;&#9;&#9;return nil-- not okay so lets exit out.
&#9;&#9;&#9;end
&#9;&#9;&#9;if string.find(New.Name,&quot;Turret&quot;) ~= nil then
&#9;&#9;&#9;&#9;if player.Population.Value+New.PopVal.Value &gt; player.MaxPopulation.Value then
&#9;&#9;&#9;&#9;&#9;object.Torso.Anchored = false
&#9;&#9;&#9;&#9;&#9;object:MoveTo(workerplace)
&#9;&#9;&#9;&#9;&#9;New:remove()
&#9;&#9;&#9;&#9;&#9;return nil-- not okay so lets exit out.
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;player.Population.Value = player.Population.Value+New.PopVal.Value
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end

&#9;&#9;player.Money.Value = player.Money.Value-Building.Cost.Value -- If its successfully placed and built then pay up buddy.
&#9;&#9;if New.Name == &quot;WarFactory&quot; then
&#9;&#9;&#9;wait(0.5)
&#9;&#9;&#9;bscript.Parent = New
&#9;&#9;end
&#9;else
&#9;&#9;player.Command.Value = command -- this requires the tool to participate.
&#9;end
end


-- this section holds the commands for all units. This changes based on what unit is selected, so we each unit has a model that tells this script what its commands are.
function updategui()
&#9;print(&quot;Generating commands&quot;)
&#9;if #player.Selection:getChildren() &lt; 1 then
&#9;&#9;bin.CommandCard.Visible = false
&#9;else
&#9;&#9;for _,v in pairs(bin.CommandCard:getChildren()) do
&#9;&#9;&#9;v:remove() -- remove all old command buttons
&#9;&#9;end
&#9;&#9;
&#9;&#9;selection = player.Selection:getChildren()[1].Value.Parent -- first object...
&#9;&#9;if selection:findFirstChild(&quot;Commands&quot;) == nil then return end

&#9;&#9;rcolumn = 10
&#9;&#9;rrow = -25
&#9;&#9;
&#9;&#9;row = 2
&#9;&#9;column = 10
&#9;&#9;AbsoluteSize = 600 -- size of the box


&#9;&#9;for _,v in pairs(selection.Commands:getChildren()) do
&#9;&#9;&#9;local v = v
&#9;&#9;&#9;if string.sub(v.Name,1,7) == &quot;Recruit&quot; then
&#9;&#9;&#9;&#9;local newButton = bin.Parent.ButtonEX:clone()
&#9;&#9;&#9;&#9;newButton.Name = &quot;RecruitButton&quot;
&#9;&#9;&#9;&#9;local unit = findByTag(string.sub(v.Name,8))
&#9;&#9;&#9;&#9;if unit == nil then
&#9;&#9;&#9;&#9;&#9;newButton.Description.Value = &quot;Recruit this Unit&quot;
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;newButton.Description.Value = unit.ID.Value..&quot;: $&quot;..unit.Cost.Value
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;newButton.ButtonDisplay.Image = images[string.sub(v.Name,8)] -- recruiting button sare different.
&#9;&#9;&#9;&#9;newButton.Position = UDim2.new(0,rcolumn,1,-50)

&#9;&#9;&#9;&#9;newButton.Clicked.Changed:connect(function()
&#9;&#9;&#9;&#9;&#9;select(selection,v.Name)
&#9;&#9;&#9;&#9;end)

&#9;&#9;&#9;&#9;newButton.Visible = true
&#9;&#9;&#9;&#9;newButton.Parent = bin.CommandCard

&#9;&#9;&#9;&#9;rcolumn = rcolumn+50
&#9;&#9;&#9;elseif string.sub(v.Name,1,5) == &quot;Build&quot; then

&#9;&#9;&#9;&#9;local newButton = bin.Parent.ButtonEX:clone()
&#9;&#9;&#9;&#9;newButton.Name = &quot;RecruitButton&quot;

&#9;&#9;&#9;&#9;local unit = findByTag(string.sub(v.Name,6))
&#9;&#9;&#9;&#9;if unit == nil then
&#9;&#9;&#9;&#9;&#9;newButton.Description.Value = &quot;Build &quot;..string.sub(v.Name,6)
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;newButton.Description.Value = unit.ID.Value..&quot;: $&quot;..unit.Cost.Value
&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;&#9;newButton.ButtonDisplay.Image = images[string.sub(v.Name,6)] -- recruiting button sare different.
&#9;&#9;&#9;&#9;newButton.Position = UDim2.new(0,rcolumn,1,rrow)

&#9;&#9;&#9;&#9;newButton.Clicked.Changed:connect(function()
&#9;&#9;&#9;&#9;&#9;select(selection,v.Name)
&#9;&#9;&#9;&#9;end)

&#9;&#9;&#9;&#9;newButton.Visible = true
&#9;&#9;&#9;&#9;newButton.Parent = bin.CommandCard

&#9;&#9;&#9;&#9;rcolumn = rcolumn+50
&#9;&#9;&#9;&#9;if rcolumn &gt; 350 then
&#9;&#9;&#9;&#9;&#9;rrow = rrow+-45
&#9;&#9;&#9;&#9;&#9;rcolumn = 10
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;local newButton = bin.Parent.ButtonEX:clone()
&#9;&#9;&#9;&#9;newButton.Name = &quot;CommandButton&quot;
&#9;&#9;&#9;&#9;newButton.Description.Value = v.Name
&#9;&#9;&#9;&#9;newButton.ButtonDisplay.Image = images[v.Name]
&#9;&#9;&#9;&#9;newButton.Position = UDim2.new(0,column,0,row)

&#9;&#9;&#9;&#9;newButton.Clicked.Changed:connect(function()
&#9;&#9;&#9;&#9;&#9;select(selection,v.Name)
&#9;&#9;&#9;&#9;end)

&#9;&#9;&#9;&#9;newButton.Visible = true
&#9;&#9;&#9;&#9;newButton.Parent = bin.CommandCard
&#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;if column+50 &gt; AbsoluteSize then
&#9;&#9;&#9;&#9;&#9;row = row+50
&#9;&#9;&#9;&#9;&#9;column = 10
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;column = column+50
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end

&#9;&#9;bin.CommandCard.Visible = true -- all ready.
&#9;end
end



player.Selection.ChildAdded:connect(updategui)
player.Selection.ChildRemoved:connect(updategui)





