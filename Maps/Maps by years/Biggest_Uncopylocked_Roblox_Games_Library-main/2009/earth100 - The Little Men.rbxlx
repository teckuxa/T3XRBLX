						<ProtectedString name="Source">wait(2)

bin = script.Parent
player = script.Parent.Parent.Parent.Parent

bin.MenuButton.MouseButton1Up:connect(function()
&#9;bin.MenuButton.Visible = false
&#9;bin.Parent.Menu.Visible = true
end)

-- Money code
player.Money.Changed:connect(function(val)
&#9;bin.Money.Value.Text = &quot;$ &quot;..val
end)

-- Population code

player.Population.Changed:connect(function(val)
&#9;bin.Population.Value.Text = player.Population.Value..&quot;/&quot;..player.MaxPopulation.Value
&#9;if player.Population.Value &gt; player.MaxPopulation.Value then 
&#9;&#9;bin.Population.Label.TextColor3 = Color3.new(1,51/255,0)
&#9;elseif player.Population.Value+5 &gt; player.MaxPopulation.Value then
&#9;&#9;bin.Population.Label.TextColor3 = Color3.new(1,1,0)
&#9;else
&#9;&#9;bin.Population.Label.TextColor3 = Color3.new(51/255,204/255,51/255)
&#9;end
end)

-- Alliance code

data = nil -- this player&apos;s diplomacy data
for _,v in pairs(Workspace.DiplomacyFolder:getChildren()) do
&#9;if v.Value == player.TeamColor then
&#9;&#9;data = v
&#9;end
end

teamindex = 1
for _,v in pairs(bin.AllyChoser:getChildren()) do -- shipment of an alliance request.
&#9;if v.Name == &quot;Selecter&quot; then
&#9;&#9;local v = v
&#9;&#9;v.MouseButton1Up:connect(function()
&#9;&#9;&#9;color = v.Team.Value
&#9;&#9;&#9;if color == data.Value then return end
&#9;&#9;&#9;if #data:getChildren() ~= 0 then return end
&#9;&#9;&#9;for _,x in pairs(Workspace.DiplomacyFolder:getChildren()) do
&#9;&#9;&#9;&#9;if x.Value == color then
&#9;&#9;&#9;&#9;&#9;if #x:getChildren() ~= 0 then return end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;for _,pl in pairs(game.Players:GetChildren()) do
&#9;&#9;&#9;&#9;if pl.TeamColor == color and pl:findFirstChild(&quot;PlayerGui&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;pl.PlayerGui.GameGui.Left.AllyRequest.Requester.Value = player.TeamColor
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;bin.AllyChoser.Visible = false
&#9;&#9;end)
&#9;&#9;v.Team.Value = game.Teams:getChildren()[teamindex].TeamColor
&#9;&#9;v.BackgroundColor3 = Color3.new(v.Team.Value.r,v.Team.Value.g,v.Team.Value.b)
&#9;&#9;teamindex = teamindex+1
&#9;end
end


bin.Ally.MouseButton1Up:connect(function()
&#9;if #data:getChildren() ~= 0 then return end -- no multi-allies.
&#9;bin.AllyChoser.Visible = not bin.AllyChoser.Visible
end)

data.ChildAdded:connect(function(c)
&#9;if c.Name == &quot;Ally&quot; then
&#9;&#9;bin.Ally.BackgroundColor3 = Color3.new(c.Value.r,c.Value.g,c.Value.b)
&#9;end
end)

bin.AllyRequest.Requester.Changed:connect(function() -- updates the requester.
&#9;local color = bin.AllyRequest.Requester.Value
&#9;teamname = &quot;______&quot;
&#9;for _,v in pairs(game.Teams:GetChildren()) do
&#9;&#9;if v.TeamColor == color then
&#9;&#9;&#9;teamname = v.Name
&#9;&#9;end
&#9;end
&#9;bin.AllyRequest.Description.Text = &quot;Do you want to ally &quot;..teamname..&quot;?&quot;
&#9;bin.AllyRequest.Description.TextColor3 = Color3.new(color.r,color.g,color.b)
&#9;bin.AllyRequest.Visible = true
end)

bin.AllyRequest.Yes.MouseButton1Up:connect(function()
&#9;if #data:getChildren() ~= 0 then return end
&#9;color = bin.AllyRequest.Requester.Value
&#9;for _,x in pairs(Workspace.DiplomacyFolder:getChildren()) do
&#9;&#9;if x.Value == color then
&#9;&#9;&#9;if #x:getChildren() ~= 0 then return end
&#9;&#9;end
&#9;end
&#9;good = false
&#9;for _, v in pairs(game.Players:getChildren()) do
&#9;&#9;if v.TeamColor == color then
&#9;&#9;&#9;good = true -- non-existant player
&#9;&#9;end
&#9;end
&#9;if good == false then return end
&#9;for _,x in pairs(Workspace.DiplomacyFolder:getChildren()) do
&#9;&#9;if x.Value == color then
&#9;&#9;&#9;new = Instance.new(&quot;BrickColorValue&quot;)
&#9;&#9;&#9;new.Name = &quot;Ally&quot;
&#9;&#9;&#9;new.Value = player.TeamColor
&#9;&#9;&#9;new.Parent = x
&#9;&#9;&#9;
&#9;&#9;&#9;new = Instance.new(&quot;BrickColorValue&quot;)
&#9;&#9;&#9;new.Name = &quot;Ally&quot;
&#9;&#9;&#9;new.Value = color
&#9;&#9;&#9;new.Parent = data
&#9;&#9;end
&#9;end
&#9;bin.AllyRequest.Visible = false
end)


bin.AllyRequest.No.MouseButton1Up:connect(function()
&#9;bin.AllyRequest.Visible = false
end)</ProtectedString>
