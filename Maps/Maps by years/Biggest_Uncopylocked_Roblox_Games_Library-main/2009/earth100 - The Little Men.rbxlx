						<ProtectedString name="Source">Last = nil

for i,v in pairs(script.Parent:GetChildren()) do
&#9;if v.className == &quot;TextButton&quot; then -- WILL HAVE TO CHANGE
&#9;&#9;local v = v
&#9;&#9;v.MouseButton1Up:connect(function()
&#9;&#9;&#9;if Last ~= nil then
&#9;&#9;&#9;&#9;Last.BorderColor3 = Color3.new(41/255,41/255,41/255)
&#9;&#9;&#9;end 
&#9;&#9;&#9;v.BorderColor3 = Color3.new(1,1,102/205)
&#9;&#9;&#9;script.Parent.Selection.Value = v.Name
&#9;&#9;&#9;Last = v
&#9;&#9;end)
&#9;end
end 

script.Parent.Selection.Changed:connect(function(Val)
&#9;for i,v in pairs(game.Lighting:getChildren()) do
&#9;&#9;if v:findFirstChild(&quot;UnitType&quot;) ~= nil and v.UnitType.Value == Val then
&#9;&#9;&#9;&#9;script.Parent.CostData.Text = &quot;Cost: &quot;..v.Cost.Value
&#9;&#9;end
&#9;end
end)</ProtectedString>
