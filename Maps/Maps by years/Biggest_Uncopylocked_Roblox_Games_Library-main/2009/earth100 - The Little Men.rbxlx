Timeout = false
function LaunchTimer()
&#9;local Curround = round
&#9;for i=12,0,-1 do
&#9;&#9;if Curround == round then 
&#9;&#9;&#9;wait(60*5)
&#9;&#9;&#9;local M = Instance.new(&quot;Message&quot;)
&#9;&#9;&#9;M.Text = (i*5)..&quot; minutes remain in the battle!&quot;
&#9;&#9;&#9;M.Parent = Workspace
&#9;&#9;&#9;wait(4)
&#9;&#9;&#9;M:remove()
&#9;&#9;end
&#9;end
&#9;if Curround == round then
&#9;&#9;Timeout = true
&#9;&#9;Highest = 0
&#9;&#9;Winner = nil
&#9;&#9;for i,v in pairs(game.Players:getChildren()) do
&#9;&#9;&#9;if v:findFirstChild(&quot;Money&quot;) ~= nil then
&#9;&#9;&#9;&#9;if v.Money.Value &gt;= Highest then
&#9;&#9;&#9;&#9;&#9;Winner = v
&#9;&#9;&#9;&#9;&#9;Highest = v.Money.Value
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;if Winner ~= nil  then
&#9;&#9;&#9;if Workspace:findFirstChild(&quot;WinText&quot;) == nil then
&#9;&#9;&#9;&#9;local m = Instance.new(&quot;Message&quot;)
&#9;&#9;&#9;&#9;m.Text = Winner.Name..&quot; wins the battle, due to time, with &quot;..Highest..&quot; money!&quot;
&#9;&#9;&#9;&#9;m.Name = &quot;WinText&quot;
&#9;&#9;&#9;&#9;m.Parent = Workspace
&#9;&#9;&#9;&#9;wait(4)
&#9;&#9;&#9;&#9;m:remove()
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;RESPAWNGAME()
&#9;end
end

Map = nil
CurrentMap = 1
function RESPAWNGAME()
&#9;Teams = {&quot;Camo&quot;,&quot;Bright red&quot;,&quot;Br. yellowish orange&quot;,&quot;Bright violet&quot;,&quot;Black&quot;,&quot;Deep blue&quot;}
&#9;TeamDefeats = {false,false,false,false,false,false}
&#9;for i,v in pairs(Workspace:getChildren()) do
&#9;&#9;if v:findFirstChild(&quot;Class&quot;) ~= nil then
&#9;&#9;&#9;v.Cleaning.Value = true
&#9;&#9;&#9;v:remove()
&#9;&#9;end
&#9;end
&#9;
&#9;for i,v in pairs(game.Players:getChildren()) do
&#9;&#9;if v.Character~= nil and v.Character:findFirstChild(&quot;Torso&quot;) ~= nil then
&#9;&#9;&#9;v.Character.Torso.CFrame = Workspace.HoldingBox.Floor.CFrame*CFrame.new(math.random(-10,10),10,math.random(-10,10))
&#9;&#9;end
&#9;end

&#9;wait(math.random(#game.Players:getChildren(),#game.Players:getChildren()*1.5))

&#9;NextMap = math.random(1,#game.Lighting.Maps:getChildren()) 
&#9;while NextMap == CurrentMap do
&#9;&#9;NextMap = math.random(1,#game.Lighting.Maps:getChildren()) 
&#9;&#9;wait()
&#9;end
&#9;CurrentMap = NextMap -- Chooses new random map, can not be the same map.
&#9;
&#9;Workspace.Spawn.Position = Workspace.HoldingBox.Floor.Position -- Shift thespawn
&#9;if Map ~= nil then
&#9;&#9;Map:remove() -- Clean old maps.
&#9;end
&#9;Map = game.Lighting.Maps:getChildren()[CurrentMap]:clone() -- Get map.
&#9;Map.Parent = Workspace
&#9;Map:MakeJoints()
&#9;
&#9;Map:MoveTo(Vector3.new(0)) -- Place map and reset spawn
&#9;Workspace.Spawn.Position = Map.SpawnLoc.Position

&#9;CurrentCommand = 1
&#9;for i,v in pairs(Map:getChildren()) do
&#9;&#9;if v.Name == &quot;CommandStart&quot; then
&#9;&#9;&#9;New = game.Lighting.CommandCenter:clone()
&#9;&#9;&#9;New.Starter.Value = true
&#9;&#9;&#9;New.Team.Value = BrickColor.new(Teams[CurrentCommand])
&#9;&#9;&#9;New.Parent = Workspace
&#9;&#9;&#9;New:MakeJoints()
&#9;&#9;&#9;New:MoveTo(v.Position)
&#9;&#9;&#9;CurrentCommand = CurrentCommand+1
&#9;&#9;end
&#9;end
&#9;for i,v in pairs(Workspace:getChildren()) do
&#9;&#9;if v.Name == &quot;CommandCenter&quot; then
&#9;&#9;&#9;for _=1,3 do 
&#9;&#9;&#9;&#9;New = game.Lighting.Soldier:clone()
&#9;&#9;&#9;&#9;New.Team.Value = v.Team.Value
&#9;&#9;&#9;&#9;New.Parent = Workspace
&#9;&#9;&#9;&#9;New:MakeJoints()
&#9;&#9;&#9;&#9;New:MoveTo(v.Torso.Position+Vector3.new(math.random(-15,15),New.Height.Value,math.random(-15,15)))&#9;
&#9;&#9;&#9;&#9;wait()
&#9;&#9;&#9;end
&#9;&#9;elseif v.Name == &quot;VolcanicArea&quot; then
&#9;&#9;&#9;v.Occupied.Value = false
&#9;&#9;end
&#9;end 
&#9;for i,v in pairs(game.Players:getChildren()) do
&#9;&#9;if v:findFirstChild(&quot;Soldier&quot;) ~= nil then
&#9;&#9;&#9;v.Soldier.Value = 3
&#9;&#9;&#9;v.Vehicle.Value = 0
&#9;&#9;&#9;v.SoldierMax.Value = 10
&#9;&#9;&#9;v.VehicleMax.Value = 5
&#9;&#9;&#9;v.AirMax.Value = 5
&#9;&#9;&#9;v.Doctrine.Value = &quot;None&quot;
&#9;&#9;&#9;v.Air.Value = 0
&#9;&#9;&#9;v.Building.Value = 1
&#9;&#9;&#9;v.Money.Value = 300
&#9;&#9;&#9;for _,x in pairs(v.Technology:getChildren()) do
&#9;&#9;&#9;&#9;x.Value = 0
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;for i,v in pairs(Workspace.DiplomacyFolder:getChildren()) do
&#9;&#9;if v:findFirstChild(&quot;Ally&quot;) ~= nil then v.Ally:remove() end 
&#9;end
&#9;wait(1)
&#9;for i,v in pairs(Workspace:getChildren()) do
&#9;&#9;if v.Name == &quot;WinText&quot; then
&#9;&#9;&#9;v:remove()
&#9;&#9;end
&#9;end
&#9;Timeout = false
&#9;round = round+1
&#9;local An = Instance.new(&quot;Message&quot;) -- Announce name of map
&#9;An.Text = &quot;The new map is &quot;..Map.Name
&#9;An.Name = &quot;MapAnnounce&quot;
&#9;An.Parent = Workspace
&#9;wait(4)
&#9;An:remove()
&#9;for i,v in pairs(game.Players:getChildren()) do
&#9;&#9;if v.Character~= nil and v.Character:findFirstChild(&quot;Torso&quot;) ~= nil then
&#9;&#9;&#9;v.Character.Torso.CFrame = Workspace.Spawn.CFrame*CFrame.new(math.random(-10,10),10,math.random(-10,10))
&#9;&#9;end
&#9;end
&#9;LaunchTimer()
end


&#9;



game.Workspace.ChildAdded:connect(function(c)
&#9;if c.className == &quot;Script&quot; or (c:findFirstChild(&quot;Humanoid&quot;) ~= nil and game.Players:getPlayerFromCharacter(c) == nil) then -- or (c:findFirstChild(&quot;Class&quot;) == nil and c:findFirstChild(&quot;Humanoid&quot;) == nil and c:findFirstChild(&quot;SpawnLoc&quot;) == nil and c.className~=&quot;Message&quot;)then -- Hello exploiters.
&#9;&#9;print(c.Name)
&#9;&#9;c:remove()
&#9;&#9;local Exploit = Instance.new(&quot;Message&quot;)
&#9;&#9;Exploit.Text = &quot;Exploit detected. &quot;
&#9;&#9;Exploit.Parent = Workspace
&#9;&#9;wait(3)
&#9;&#9;Exploit:remove()
&#9;end
&#9;if Timeout == true then return end
&#9;if c:findFirstChild(&quot;Team&quot;) ~= nil and c:findFirstChild(&quot;Class&quot;) ~= nil then
&#9;&#9;for i,v in pairs(game.Players:GetChildren()) do
&#9;&#9;&#9;if v.TeamColor == c.Team.Value then
&#9;&#9;&#9;&#9;if c.Name == &quot;Wall&quot; then
&#9;&#9;&#9;&#9;&#9;c.Range.Value = 4+(2*v.Technology[&quot;Mine Range&quot;].Value)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;if v:findFirstChild(&quot;Doctrine&quot;) == nil then return end
&#9;&#9;&#9;&#9;if v.Doctrine.Value == c.Name then
&#9;&#9;&#9;&#9;&#9;c.DoctrineStrength.Value = 0.25
&#9;&#9;&#9;&#9;&#9;c.DamageMultiplier.Value = 1+c.DoctrineStrength.Value+c.TechStrength.Value
&#9;&#9;&#9;&#9;&#9;c.SpeedMultiplier.Value = 1+v.Technology[c.Name..&quot; Speed&quot;].Value/10
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;if c.Name == &quot;Soldier&quot; then
&#9;&#9;&#9;&#9;&#9;c.TechStrength.Value = v.Technology.SoldierStrength.Value/10
&#9;&#9;&#9;&#9;&#9;c.DamageMultiplier.Value = 1+c.DoctrineStrength.Value+c.TechStrength.Value
&#9;&#9;&#9;&#9;elseif c.Name == &quot;Vehicle&quot; then
&#9;&#9;&#9;&#9;&#9;c.TechStrength.Value = v.Technology.VehicleStrength.Value/10
&#9;&#9;&#9;&#9;&#9;c.DamageMultiplier.Value = 1+c.DoctrineStrength.Value+c.TechStrength.Value
&#9;&#9;&#9;&#9;elseif c.Name == &quot;Air&quot; then
&#9;&#9;&#9;&#9;&#9;c.TechStrength.Value = v.Technology.AirStrength.Value/10
&#9;&#9;&#9;&#9;&#9;c.DamageMultiplier.Value = 1+c.DoctrineStrength.Value+c.TechStrength.Value
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end)

function CheckForFinish()
&#9;if Timeout == true then return end
&#9;Remaining = 0
&#9;RemTeams = {}
&#9;for i,v in pairs(TeamDefeats) do
&#9;&#9;if v == false then
&#9;&#9;&#9;Remaining = Remaining+1
&#9;&#9;&#9;table.insert(RemTeams,Teams[i])
&#9;&#9;end
&#9;end
&#9;print(Remaining)
&#9;if Remaining == 1 then
&#9;&#9;if Timeout == true or Workspace:findFirstChild(&quot;WinText&quot;) ~= nil then print(&quot;Times over&quot;) return end
&#9;&#9;Team = &quot; &quot;
&#9;&#9;for i,v in pairs(game.Teams:getChildren()) do
&#9;&#9;&#9;if v.TeamColor == BrickColor.new(RemTeams[1]) then
&#9;&#9;&#9;&#9;Team = v.Name
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;local m = Instance.new(&quot;Message&quot;)
&#9;&#9;m.Text = &quot;WinText&quot;
&#9;&#9;m.Text = Team..&quot; has conquered the battlefield!&quot;
&#9;&#9;m.Parent = Workspace
&#9;&#9;wait(4)
&#9;&#9;m:Remove()
&#9;&#9;RESPAWNGAME()
&#9;elseif Remaining == 2 then
&#9;&#9;if Timeout == true or Workspace:findFirstChild(&quot;WinText&quot;) ~= nil then print(&quot;Times over&quot;) return end
&#9;&#9;Examine = {}
&#9;&#9;for i,v in pairs(TeamDefeats) do
&#9;&#9;&#9;if v == false then
&#9;&#9;&#9;&#9;table.insert(Examine,BrickColor.new(Teams[i]))
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;Won = false
&#9;&#9;for i,v in pairs(Workspace.DiplomacyFolder:getChildren()) do
&#9;&#9;&#9;if v.Value == Examine[1] then
&#9;&#9;&#9;&#9;if v:findFirstChild(&quot;Ally&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;if v.Ally.Value == Examine[2] then
&#9;&#9;&#9;&#9;&#9;&#9;Won = true
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;if Won == true then
&#9;&#9;&#9;Team1 = &quot; &quot;
&#9;&#9;&#9;Team2 = &quot; &quot;
&#9;&#9;&#9;for i,v in pairs(game.Teams:getChildren()) do
&#9;&#9;&#9;&#9;if v.TeamColor == Examine[1] then
&#9;&#9;&#9;&#9;&#9;Team1 = v.Name
&#9;&#9;&#9;&#9;elseif v.TeamColor == Examine[2] then
&#9;&#9;&#9;&#9;&#9;Team2 = v.Name
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;local m = Instance.new(&quot;Message&quot;)
&#9;&#9;&#9;m.Text = &quot;WinText&quot;
&#9;&#9;&#9;m.Text = &quot; The alliance of &quot;..Team1..&quot; and &quot;..Team2..&quot; has conquered the battlefield!&quot;
&#9;&#9;&#9;m.Parent = Workspace
&#9;&#9;&#9;wait(4)
&#9;&#9;&#9;m:Remove()
&#9;&#9;&#9;RESPAWNGAME()&#9;
&#9;&#9;end
&#9;end
end

game.Workspace.ChildRemoved:connect(function(c)
&#9;buicount = 0

&#9;if c:findFirstChild(&quot;Team&quot;) ~= nil then
&#9;&#9;color = c.Team.Value
&#9;&#9;local player = nil
&#9;&#9;for _,v in pairs(game.Players:getChildren()) do
&#9;&#9;&#9;if v.TeamColor == color then
&#9;&#9;&#9;&#9;player = v
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;if player ~= nil and c:findFirstChild(&quot;PopVal&quot;) ~= nil then
&#9;&#9;&#9;player.Population.Value = player.Population.Value-c.PopVal.Value
&#9;&#9;end
&#9;end


&#9;if c:findFirstChild(&quot;Team&quot;) ~= nil and c:findFirstChild(&quot;Class&quot;) ~= nil then
&#9;&#9;if c:findFirstChild(&quot;Cleaning&quot;) ~= nil then if c.Cleaning.Value == true then return end end
&#9;&#9;if c.Class.Value == &quot;Building&quot; then
&#9;&#9;&#9;print(&quot;Building dead&quot;)
&#9;&#9;&#9;for i,v in pairs(Workspace:getChildren()) do
&#9;&#9;&#9;&#9;if v:findFirstChild(&quot;Team&quot;) ~= nil and v.Team.Value == c.Team.Value and v:findFirstChild(&quot;Class&quot;) ~= nil and v.Class.Value == &quot;Building&quot; then
&#9;&#9;&#9;&#9;&#9;buicount = buicount+1
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end&#9;
&#9;&#9;&#9;print(buicount)
&#9;&#9;&#9;if buicount &lt;=0 then
&#9;&#9;&#9;&#9;for i,v in pairs(Teams) do
&#9;&#9;&#9;&#9;&#9;if c.Team.Value == BrickColor.new(v) then -- right team
&#9;&#9;&#9;&#9;&#9;&#9;TeamDefeats[i] = true
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;CheckForFinish()
&#9;&#9;&#9;end
&#9;&#9;end&#9;
&#9;end

end)

function isBanned(player)
&#9;for _,v in pairs(bannedlist) do
&#9;&#9;if v[1] == string.lower(player.Name) then
&#9;&#9;&#9;&#9;return true
&#9;&#9;end
&#9;end
&#9;return false
end

function messageReason(player)
&#9;for _,v in pairs(bannedlist) do
&#9;&#9;if v[1] == string.lower(player.Name) then
&#9;&#9;&#9;&#9;reason = reasons[v[2]]
&#9;&#9;end
&#9;end
&#9;m = Instance.new(&quot;Message&quot;)
&#9;m.Text = &quot;You have been banned for: &quot;..reason
&#9;m.Parent = player
end

game.Players.PlayerRemoving:connect(function(p)
&#9;local p = p
&#9;if p:findFirstChild(&quot;Dead&quot;) ~= nil then return end
&#9;if p:findFirstChild(&quot;Voted&quot;) ~= nil then ShutDownVotes = ShutDownVotes-1 end
&#9;for i,v in pairs(Workspace:getChildren()) do
&#9;&#9;if v:findFirstChild(&quot;Team&quot;) ~= nil and v.Team.Value == p.TeamColor and v:findFirstChild(&quot;Class&quot;) ~= nil then
&#9;&#9;&#9;if v.Class.Value == &quot;Unit&quot; then
&#9;&#9;&#9;&#9;v:remove()
&#9;&#9;&#9;elseif v.Class.Value == &quot;Building&quot; and v:findFirstChild(&quot;RecruitTable&quot;) ~= nil then
&#9;&#9;&#9;&#9;for _,req in pairs(v.RecruitTable:getChildren()) do
&#9;&#9;&#9;&#9;&#9;req:remove()
&#9;&#9;&#9;&#9;end&#9;
&#9;&#9;&#9;end
&#9;&#9;end 
&#9;end
&#9;ally = BrickColor.new(&quot;White&quot;)
&#9;for _,v in pairs(Workspace.DiplomacyFolder:getChildren()) do
&#9;&#9;if v.Value == p.TeamColor then
&#9;&#9;&#9;if v:findFirstChild(&quot;Ally&quot;) ~= nil then
&#9;&#9;&#9;&#9;ally = v.Ally.Value
&#9;&#9;&#9;&#9;v.Ally:remove()
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;for _,v in pairs(Workspace.DiplomacyFolder:getChildren()) do
&#9;&#9;if v.Value == ally then
&#9;&#9;&#9;if v:findFirstChild(&quot;Ally&quot;) ~= nil then
&#9;&#9;&#9;&#9;v.Ally:remove()
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end)

game.Players.PlayerAdded:connect(function(p)
&#9;local p=p
&#9;if #game.Players:getChildren() &gt; 6 then
&#9;&#9;local Dead = Instance.new(&quot;BoolValue&quot;)
&#9;&#9;Dead.Name = &quot;Dead&quot;
&#9;&#9;Dead.Parent = p
&#9;&#9;p:remove()
&#9;end
&#9;if isBanned(p) then
&#9;&#9;messageReason(p)
&#9;&#9;local Dead = Instance.new(&quot;BoolValue&quot;)
&#9;&#9;Dead.Name = &quot;Dead&quot;
&#9;&#9;Dead.Parent = p
&#9;&#9;p:remove()
&#9;end
end)



script.Launch.Changed:connect(function()
&#9;while true do
&#9;&#9;wait(20)
&#9;&#9;print(&quot;Check&quot;)
&#9;&#9;for i,v in pairs(Workspace:getChildren()) do
&#9;&#9;&#9;if v.Name == &quot;SteamPlant&quot; and v.Built.Value == true then
&#9;&#9;&#9;&#9;for _,Player in pairs(game.Players:getChildren()) do
&#9;&#9;&#9;&#9;&#9;if Player.TeamColor == v.Team.Value then
&#9;&#9;&#9;&#9;&#9;&#9;if Player:findFirstChild(&quot;Money&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if Player.Technology[&quot;Steam Plant Power&quot;].Value == 1 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;Player.Money.Value = Player.Money.Value+(3*v.UpgradeLevel.Value)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;Player.Money.Value = Player.Money.Value+(2*v.UpgradeLevel.Value)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;print(&quot;Paid&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;for _,Player in pairs(game.Players:getChildren()) do
&#9;&#9;&#9;if Player:findFirstChild(&quot;Money&quot;) ~= nil then
&#9;&#9;&#9;&#9;Player.Money.Value = Player.Money.Value+10
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end)

game.Workspace[&quot;_GamePackets&quot;].ChildAdded:connect(function(Packet)
&#9;if Packet.Value == &quot;Ally&quot; then
&#9;&#9;wait(0.2)
&#9;&#9;if Packet:findFirstChild(&quot;Team1&quot;) ~= nil then print(&quot;Ya it exists&quot;) end
&#9;&#9;myTeam = Packet:findFirstChild(&quot;Team1&quot;).Value
&#9;&#9;otherTeam = Packet:findFirstChild(&quot;Team2&quot;).Value
&#9;&#9;for i,v in pairs(game.Players:getChildren()) do
&#9;&#9;&#9;if v.TeamColor == otherTeam and v:findFirstChild(&quot;PlayerGui&quot;) ~= nil and v.PlayerGui:findFirstChild(&quot;GameData&quot;) ~= nil then
&#9;&#9;&#9;&#9;print(&quot;Found&quot;)
&#9;&#9;&#9;&#9;if v.PlayerGui.GameData:findFirstChild(&quot;Request&quot;) ~= nil and v.PlayerGui.GameData.Request.Visible == false then
&#9;&#9;&#9;&#9;&#9;print(&quot;Sent&quot;)
&#9;&#9;&#9;&#9;&#9;if v.PlayerGui.GameData.Request:findFirstChild(&quot;Requester&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;v.PlayerGui.GameData.Request.Requester.Value = myTeam
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;elseif Packet.Value == &quot;Tribute&quot; then
&#9;&#9;wait(0.2)
&#9;&#9;if Packet:findFirstChild(&quot;Team1&quot;) ~= nil then print(&quot;Ya it exists&quot;) end
&#9;&#9;print(Packet.Amount.Value)
&#9;&#9;myTeam = Packet:findFirstChild(&quot;Team1&quot;).Value
&#9;&#9;otherTeam = Packet:findFirstChild(&quot;Team2&quot;).Value
&#9;&#9;Good = nil
&#9;&#9;for i,v in pairs(game.Players:getChildren()) do
&#9;&#9;&#9;if v.TeamColor == myTeam then 
&#9;&#9;&#9;&#9;if v.Money.Value-Packet.Amount.Value &gt;= 0 then
&#9;&#9;&#9;&#9;&#9;Good = v
&#9;&#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;if Good == nil then return end
&#9;&#9;for i,v in pairs(game.Players:getChildren()) do
&#9;&#9;&#9;if v.TeamColor == otherTeam then 
&#9;&#9;&#9;&#9;v.Money.Value = v.Money.Value+Packet.Amount.Value
&#9;&#9;&#9;&#9;Good.Money.Value = Good.Money.Value-Packet.Amount.Value
&#9;&#9;&#9;end
&#9;&#9;end
&#9;elseif Packet.Value == &quot;Message&quot; then
&#9;&#9;wait(0.1)
&#9;&#9;local player = nil
&#9;&#9;for _,v in pairs(game.Players:getChildren()) do
&#9;&#9;&#9;if v.TeamColor == Packet.Sender.Value then
&#9;&#9;&#9;&#9;player = v
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;if player == nil then print(&quot;No player&quot;) return end
&#9;&#9;local sys = player.PlayerGui.GameData.MessageSystem
&#9;&#9;local TeamColor = player.TeamColor
&#9;&#9;local Recipient = nil
&#9;&#9;for i,v in pairs(Workspace.DiplomacyFolder:getChildren()) do
&#9;&#9;&#9;if v.Value == TeamColor then
&#9;&#9;&#9;&#9;if v:findFirstChild(&quot;Ally&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;for _,ally in pairs(game.Players:getChildren()) do
&#9;&#9;&#9;&#9;&#9;&#9;if ally.TeamColor == v.Ally.Value then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;Recipient = ally
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;if Recipient == nil then print(&quot;No recipient&quot;) return end 
&#9;&#9;if Recipient.PlayerGui:findFirstChild(&quot;GameData&quot;) == nil then return end
&#9;&#9;Recipient.PlayerGui.GameData.MessageSystem.Inbox.Text = sys.Outbox.Text
&#9;&#9;sys.Outbox.Text= &quot; &quot;
&#9;end
&#9;print(&quot;Finished with packet&quot;)
&#9;Packet:remove()
end)

for i,v in pairs(game.Workspace.DiplomacyFolder:getChildren()) do
&#9;local v = v
&#9;v.ChildAdded:connect(function(Other)
&#9;&#9;if Workspace:findFirstChild(&quot;AllianceAnnounce&quot;) ~= nil then return end
