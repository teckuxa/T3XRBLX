							<ProtectedString name="Source">debris = game:getService(&quot;Debris&quot;)

script.Parent.Requester.Changed:connect(function (Val)
&#9;if Val ~= BrickColor.new(&quot;White&quot;) then 
&#9;script.Parent.OtherParty.BackgroundColor3 = Color3.new(Val.r,Val.g,Val.b)
&#9;script.Parent.Visible = true
&#9;end
end)

script.Parent.Yes.MouseButton1Up:connect(function()
&#9;for i,v in pairs(Workspace.DiplomacyFolder:getChildren()) do
&#9;&#9;if v.Value == script.Parent.Parent.Parent.Parent.TeamColor then
&#9;&#9;&#9;Me = v
&#9;&#9;elseif v.Value == script.Parent.Requester.Value then
&#9;&#9;&#9;Other = v
&#9;&#9;end
&#9;end
&#9;if #Me:getChildren() &gt;=1 or #Other:getChildren() &gt;=1 then return end-- One ally only!
&#9;New = Instance.new(&quot;BrickColorValue&quot;) 
&#9;New.Name = &quot;Ally&quot;
&#9;New.Value = Other.Value
&#9;New.Parent = Me

&#9;New = Instance.new(&quot;BrickColorValue&quot;) 
&#9;New.Name = &quot;Ally&quot;
&#9;New.Value = Me.Value
&#9;New.Parent = Other
&#9;script.Parent.Visible = false

&#9;script.Parent.Requester.Value = BrickColor.new(&quot;White&quot;)
end)

script.Parent.No.MouseButton1Up:connect(function()
&#9;script.Parent.Requester.Value = BrickColor.new(&quot;White&quot;)
&#9;script.Parent.Visible = false
end)


