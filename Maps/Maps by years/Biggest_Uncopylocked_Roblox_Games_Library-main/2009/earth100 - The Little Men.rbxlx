							<ProtectedString name="Source">function RequestA(myTeam,otherTeam)
&#9;Packet = Instance.new(&quot;StringValue&quot;)
&#9;Packet.Name = &quot;AllyPacket&quot;
&#9;Packet.Value = &quot;Ally&quot;
&#9;
&#9;Team1 = Instance.new(&quot;BrickColorValue&quot;)
&#9;Team1.Name = &quot;Team1&quot;
&#9;Team1.Value = myTeam
&#9;
&#9;Team2 = Instance.new(&quot;BrickColorValue&quot;)
&#9;Team2.Name = &quot;Team2&quot;
&#9;Team2.Value = otherTeam
&#9;
&#9;Team1.Parent = Packet
&#9;Team2.Parent = Packet
&#9;wait()
&#9;Packet.Parent = Workspace[&quot;_GamePackets&quot;]
end

function SendMoney(myTeam,otherTeam,Amount)
&#9;Packet = Instance.new(&quot;StringValue&quot;)
&#9;Packet.Name = &quot;MoneyPacket&quot; -- lol
&#9;Packet.Value = &quot;Tribute&quot;
&#9;
&#9;Team1 = Instance.new(&quot;BrickColorValue&quot;)
&#9;Team1.Name = &quot;Team1&quot;
&#9;Team1.Value = myTeam -- Sender
&#9;
&#9;Team2 = Instance.new(&quot;BrickColorValue&quot;)
&#9;Team2.Name = &quot;Team2&quot;
&#9;Team2.Value = otherTeam -- Reciever

&#9;AmountV = Instance.new(&quot;NumberValue&quot;)
&#9;AmountV.Value = Amount
&#9;AmountV.Name = &quot;Amount&quot; -- Duh.
&#9;
&#9;Team1.Parent = Packet
&#9;Team2.Parent = Packet
&#9;AmountV.Parent = Packet
&#9;wait()
&#9;Packet.Parent = Workspace[&quot;_GamePackets&quot;]
end

script.Parent.Selection.Changed:connect(function (Val)
&#9;if Val ~= BrickColor.new(&quot;White&quot;) then
&#9;&#9;script.Parent.Visible = true -- Reveal diplomacy.
&#9;&#9;script.Parent.UpperBoard.OtherParty.BackgroundColor3 = Color3.new(Val.r,Val.g,Val.b)
&#9;end
end)

script.Parent.DealType.Changed:connect(function(Val)
&#9;if Val ~= &quot;None&quot; then -- Cleans out the deal type.
&#9;&#9;script.Parent.Confirmation.Visible = true
&#9;&#9;script.Parent.Confirmation.Talk.Text = &quot;Are you SURE you want to &quot;..Val..&quot; with this team?&quot;
&#9;end
end)

script.Parent.Confirmation.Yes.MouseButton1Up:connect(function()
&#9;print(&quot;Up&quot;)
&#9;if script.Parent.DealType.Value == &quot;Ally&quot; then
&#9;&#9;print(&quot;Ally request&quot;)
&#9;&#9;OtherTeam = script.Parent.Selection.Value
&#9;&#9;MyTeam = script.Parent.Parent.Parent.Parent.TeamColor
&#9;&#9;RequestA(MyTeam,OtherTeam)
&#9;elseif script.Parent.DealType.Value == &quot;Tribute 50&quot; then
&#9;&#9;OtherTeam = script.Parent.Selection.Value
&#9;&#9;MyTeam = script.Parent.Parent.Parent.Parent.TeamColor
&#9;&#9;SendMoney(MyTeam,OtherTeam,50)
&#9;elseif script.Parent.DealType.Value == &quot;Tribute 100&quot; then
&#9;&#9;OtherTeam = script.Parent.Selection.Value
&#9;&#9;MyTeam = script.Parent.Parent.Parent.Parent.TeamColor
&#9;&#9;SendMoney(MyTeam,OtherTeam,100)
&#9;elseif script.Parent.DealType.Value == &quot;Tribute 500&quot; then
&#9;&#9;OtherTeam = script.Parent.Selection.Value
&#9;&#9;MyTeam = script.Parent.Parent.Parent.Parent.TeamColor
&#9;&#9;SendMoney(MyTeam,OtherTeam,500)
&#9;end
&#9;wait(0.1)&#9;
&#9;print(&quot;Hide&quot;)

&#9;script.Parent.Confirmation.Visible = false
&#9;script.Parent.Selection.Value = BrickColor.new(&quot;White&quot;)
&#9;script.Parent.Visible = false
&#9;script.Parent.DealType.Value = &quot;None&quot;
end)

script.Parent.Confirmation.No.MouseButton1Up:connect(function()
&#9;script.Parent.Confirmation.Visible = false
&#9;script.Parent.Selection.Value = BrickColor.new(&quot;White&quot;)
&#9;script.Parent.Visible = false
&#9;script.Parent.DealType.Value = &quot;None&quot;
end)
&#9;&#9;
for _,x in pairs(script.Parent:getChildren()) do
&#9;if x.className == &quot;TextButton&quot; then
&#9;&#9;local x = x
&#9;&#9;x.MouseButton1Up:connect(function()
&#9;&#9;&#9;script.Parent.DealType.Value = x.Name -- buttons connected
&#9;&#9;end)
&#9;end
end
&#9;

wait(1)
print(&quot;Diplomacy Booted&quot;)</ProtectedString>
