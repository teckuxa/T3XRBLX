bin = script.Parent
player = script.Parent.Parent.Parent.Parent
lastbuildcommand = tick()

images = {
&#9;CommandCenter = &quot;http://www.roblox.com/asset/?id=52396402&quot;,
&#9;Mine = &quot;http://www.roblox.com/asset/?id=52122610&quot;,
&#9;Scout = &quot;http://www.roblox.com/asset/?id=52122597&quot;,
&#9;WhaleTransport = &quot;http://www.roblox.com/asset/?id=52122147&quot;,
