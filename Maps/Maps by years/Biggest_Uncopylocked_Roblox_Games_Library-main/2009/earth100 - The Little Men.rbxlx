&#9;&#9;if v:findFirstChild(&quot;Team&quot;) ~= nil and v.Team.Value == p.TeamColor and v.Class.Value == &quot;Unit&quot; and v.Name == &quot;Vehicle&quot; then -- NOTE ADD CHECK FOR IS SOLDIER
&#9;&#9;&#9;NumberV = NumberV+1
&#9;&#9;end
&#9;end

&#9;VC = Instance.new(&quot;NumberValue&quot;)
