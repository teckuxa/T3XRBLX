&#9;VM.Value = 5
&#9;VM.Parent = p

&#9;NumberA = 0
&#9;for i,v in pairs(game.Workspace:getChildren()) do
&#9;&#9;if v:findFirstChild(&quot;Team&quot;) ~= nil and v.Team.Value == p.TeamColor and v.Class.Value == &quot;Unit&quot; and v.Name == &quot;Air&quot; then -- NOTE ADD CHECK FOR IS SOLDIER
&#9;&#9;&#9;NumberA = NumberA+1
&#9;&#9;end
&#9;end

&#9;VA = Instance.new(&quot;NumberValue&quot;)
