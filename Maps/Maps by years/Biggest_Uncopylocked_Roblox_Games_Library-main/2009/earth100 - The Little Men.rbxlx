				<string name="Name">Info</string>
				<Ref name="PrimaryPart">null</Ref>
			</Properties>
			<Item class="StringValue" referent="RBX7128">
				<Properties>
					<string name="Name">Air</string>
					<string name="Value">Air: Fastest units in the game, also the most mobile.</string>
				</Properties>
			</Item>
			<Item class="StringValue" referent="RBX7129">
				<Properties>
					<string name="Name">Soldier</string>
					<string name="Value">Soldiers: Basic, middle mobility.</string>
				</Properties>
			</Item>
			<Item class="StringValue" referent="RBX7130">
				<Properties>
					<string name="Name">Vehicle</string>
					<string name="Value">Vehicle: Strong for tearing down bases, lowest mobility</string>
				</Properties>
			</Item>
			<Item class="StringValue" referent="RBX7131">
				<Properties>
					<string name="Name">Building</string>
					<string name="Value">Building: Solid constructions, form your base</string>
				</Properties>
			</Item>
			<Item class="StringValue" referent="RBX7132">
				<Properties>
					<string name="Name">Heli</string>
					<string name="Value">Viper Strike: Strong against infantry and air units. Weak vs Buildings and vehicles. Fastest unit in the game.</string>
				</Properties>
			</Item>
			<Item class="StringValue" referent="RBX7133">
				<Properties>
					<string name="Name">HeavyHeli</string>
					<string name="Value">Heavy Heli: Strong vs: Buildings, Vehicles. Weak vs: Soldiers, Air. Useful for quick strikes on fortified steam plants, or other vital buildings.</string>
				</Properties>
			</Item>
			<Item class="StringValue" referent="RBX7134">
				<Properties>
					<string name="Name">SAM</string>
					<string name="Value">SAM: Longest range of any unit. Strong Vs: Buildings, Air. Weak vs: Soldiers, Vehicles.  A large group of sams can demolish a base in under a minute.</string>
				</Properties>
			</Item>
			<Item class="StringValue" referent="RBX7135">
				<Properties>
					<string name="Name">Rifle</string>
					<string name="Value">Soldier: Strong vs other soldiers. Cheapest unit in the game. Masses of soldiers can easily turn battles.</string>
				</Properties>
			</Item>
			<Item class="StringValue" referent="RBX7136">
				<Properties>
					<string name="Name">Rocket</string>
					<string name="Value">Rocket men: Powerful against buildings, vehicles and air, but horrifically weak against soldiers and they are the slowest units.</string>
				</Properties>
			</Item>
			<Item class="StringValue" referent="RBX7137">
				<Properties>
					<string name="Name">Tank</string>
					<string name="Value">Stryker Tank: Does fairly equal damage to all units and objects. Important for equalizing your force.</string>
				</Properties>
			</Item>
			<Item class="StringValue" referent="RBX7138">
				<Properties>
					<string name="Name">Barracks</string>
					<string name="Value">Produces: Soldiers, Rocket men. Cheapest unit construction building.</string>
				</Properties>
			</Item>
			<Item class="StringValue" referent="RBX7139">
				<Properties>
					<string name="Name">Airfield</string>
					<string name="Value">Produces: Viper strike helicopters, Heavy assault helicopters. Most expensive unit construction building.</string>
				</Properties>
			</Item>
			<Item class="StringValue" referent="RBX7140">
				<Properties>
					<string name="Name">WarFactory</string>
					<string name="Value">Produces: Stryker tanks, SAMS. Medium cost.</string>
				</Properties>
			</Item>
			<Item class="StringValue" referent="RBX7141">
				<Properties>
					<string name="Name">Artillery</string>
					<string name="Value">Artillery: MUST BE DEPLOYED TO FIRE. Click the deply button to activate undeployed artillery, click it again to allow it to move. DEPLOYED ARTILLERY CAN NOT MOVE. Longest range of anything in the game.</string>
				</Properties>
			</Item>
			<Item class="StringValue" referent="RBX7142">
				<Properties>
					<string name="Name">Scout</string>
					<string name="Value">Scout: Fast and mobile. Weak in a fire fight</string>
				</Properties>
			</Item>
			<Item class="StringValue" referent="RBX7143">
				<Properties>
					<string name="Name">UnitedColors</string>
					<string name="Value">A wonder, hold it for 10 minutes and you win the game!</string>
				</Properties>
			</Item>
		</Item>
