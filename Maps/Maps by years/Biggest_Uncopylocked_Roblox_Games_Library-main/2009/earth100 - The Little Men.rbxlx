		<Item class="Script" referent="RBX227">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">ShutDown</string>
				<ProtectedString name="Source">Yes = 0
No = 0
-- Tallies.

function TallyScores()
&#9;Yes = 0
&#9;No = 0
&#9;for i,v in pairs(script:getChildren()) do
&#9;&#9;if v.Value == &quot;Yes&quot; then
&#9;&#9;&#9;Yes = Yes+1
&#9;&#9;elseif v.Value == &quot;No&quot; then
&#9;&#9;&#9;No = No+1
&#9;&#9;end
&#9;end
end

script.ChildAdded:connect(function(c) -- New vote
&#9;local c =c -- Record.
&#9;for _,marker in pairs(script:getChildren()) do
&#9;&#9;if marker.Name == c.Name and marker~=c and marker.Value == c.Value then c:remove() return end -- Can&apos;t vote twice.
&#9;end
&#9;if game.Players:findFirstChild(c.Name) == nil then return end -- Security.
&#9;
&#9;for _,marker in pairs(script:getChildren()) do
&#9;&#9;if marker.Name == c.Name and marker~=c and marker.Value ~= c.Value then 
&#9;&#9;&#9;marker:remove()
&#9;&#9;end
&#9;end
&#9;local connection = nil&#9;
&#9;if c.className == &quot;StringValue&quot; then -- Just checking
&#9;&#9;TallyScores() -- A vote for yes
&#9;&#9;local connection = game.Players:findFirstChild(c.Name).AncestryChanged:connect(function()
&#9;&#9;&#9;c:remove()
&#9;&#9;&#9;TallyScores() -- One less vote.
&#9;&#9;end)
&#9;end
&#9;local changeCon = nil
&#9;local changeCon = c.AncestryChanged:connect(function()
&#9;&#9;if changeCon ~= nil then
&#9;&#9;&#9;changeCon:disconnect()
&#9;&#9;end
&#9;&#9;if connection~= nil then
&#9;&#9;&#9;connection:disconnect()
&#9;&#9;end
&#9;&#9;TallyScores()
&#9;end)

&#9;for _,v in pairs(game.Players:GetChildren()) do
&#9;&#9;if v:findFirstChild(&quot;PlayerGui&quot;) ~= nil and v.PlayerGui:findFirstChild(&quot;GameData&quot;) ~= nil then
&#9;&#9;&#9;v.PlayerGui.GameData.ShutdownVote.Votes.Text = &quot;Votes: Yes: &quot;..tostring(Yes)..&quot; No: &quot;..tostring(No)
&#9;&#9;end
&#9;end
&#9;if Yes&gt;No and Yes&gt;math.floor(#game.Players:getChildren()*(3/4)) then -- If 3/4 of players vote yes...
&#9;&#9;print(tostring(Yes)..&quot; to &quot;..tostring(No))
&#9;&#9;for i,v in pairs(game.Players:getChildren()) do
&#9;&#9;&#9;v:Remove()
&#9;&#9;end
&#9;&#9;game.Players.PlayerAdded:connect(function(p)
&#9;&#9;&#9;p:remove()
&#9;&#9;end)&#9;
&#9;&#9;game.NetworkServer:remove()
&#9;end
end)</ProtectedString>
			</Properties>
		</Item>
