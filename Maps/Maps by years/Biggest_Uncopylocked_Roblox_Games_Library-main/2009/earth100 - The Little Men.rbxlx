							<ProtectedString name="Source">connection= nil
connection2 = nil
Model =  nil
tcon1 = nil
tcon2 = nil
player = script.Parent.Parent.Parent.Parent

function updatereadout(text)
&#9;script.Parent.UpgradeSteamPlant.Text = text
end

function UpdateHealth(Val)
&#9;script.Parent.HealthActual.Text = Model.Health.Value..&quot;/&quot;..Model.MaxHealth.Value
&#9;script.Parent.HealthOver.Size = UDim2.new(0,150*(Model.Health.Value/Model.MaxHealth.Value),0,20)
end

script.Parent.DeployArtillery.MouseButton1Up:connect(function()
&#9;if Model == nil then return end -- check
&#9;if Model.UnitType.Value ~= &quot;Artillery&quot; then return end -- is not artillery.
&#9;Model.Online.Value = not Model.Online.Value 
end)

Showing = false
markers = {}

script.Parent.ViewOwnMines.MouseButton1Up:connect(function()
&#9;if Showing == true then return end
&#9;Showing = true
&#9;if Model == nil then return end -- check
&#9;if Model.Name ~= &quot;CommandCenter&quot; then return end
&#9;for i,v in pairs(markers) do
&#9;&#9;v:remove()
&#9;end
&#9;markers = {}
&#9;for i,v in pairs(Workspace:getChildren()) do&#9;
&#9;&#9;if v.Name == &quot;Wall&quot; and v:findFirstChild(&quot;Team&quot;) ~= nil and v.Team.Value == game.Players.LocalPlayer.TeamColor then
&#9;&#9;&#9;Rep = Instance.new(&quot;SelectionBox&quot;)
&#9;&#9;&#9;Rep.Color = game.Players.LocalPlayer.TeamColor
&#9;&#9;&#9;Rep.Adornee = v.Torso
&#9;&#9;&#9;Rep.Parent = script.Parent
&#9;&#9;&#9;table.insert(markers,Rep)
&#9;&#9;end
&#9;end
&#9;wait(3)
&#9;for i,v in pairs(markers) do
&#9;&#9;v:remove()
&#9;end&#9;
&#9;Showing = false
end)
&#9;
mines = {}
Detecting = false
script.Parent.MineSweep.MouseButton1Up:connect(function()
&#9;if Detecting == true then return end
&#9;Detecting = true
&#9;if Model == nil then return end -- check
&#9;if Model.Name ~= &quot;CommandCenter&quot; then return end

&#9;if game.Players.LocalPlayer:findFirstChild(&quot;Money&quot;) == nil then return end
&#9;if game.Players.LocalPlayer.Money.Value-50&lt; 0 then return end
&#9;game.Players.LocalPlayer.Money.Value = game.Players.LocalPlayer.Money.Value-50

&#9;local Scan = Instance.new(&quot;Part&quot;)
&#9;Scan.TopSurface = 0
&#9;Scan.BottomSurface = 0
&#9;Scan.Transparency = 0.6
&#9;Scan.Anchored = true
&#9;Scan.CanCollide = false
&#9;Scan.formFactor = 2
&#9;Scan.Size = Vector3.new(1,0.4,0)
&#9;Scan.CFrame = game.Players.LocalPlayer.Character.Torso.CFrame+Vector3.new(0,-2.5,0)
&#9;Scan.BrickColor = BrickColor.new(&quot;Bright bluish green&quot;)
&#9;Scan.Parent = game.Workspace.CurrentCamera
&#9;&#9;
&#9;Mesh = Instance.new(&quot;CylinderMesh&quot;)
&#9;Mesh.Parent = Scan
&#9;for i=0,35,1 do
&#9;&#9;Mesh.Scale = Vector3.new(i,1,i)
&#9;&#9;wait()
&#9;end
&#9;for i=35,0,-1 do
&#9;&#9;Mesh.Scale = Vector3.new(i,1,i)
&#9;&#9;wait()
&#9;end
&#9;Scan:remove()

&#9;for i,v in pairs(mines) do
&#9;&#9;v:remove()
&#9;end
&#9;mines = {}

&#9;for i,v in pairs(Workspace:getChildren()) do&#9;
&#9;&#9;if v.Name == &quot;Wall&quot; and v:findFirstChild(&quot;Team&quot;) ~= nil then
&#9;&#9;&#9;if (v.Torso.Position-game.Players.LocalPlayer.Character.Torso.Position).magnitude &lt;= 35 then
&#9;&#9;&#9;&#9;Rep = Instance.new(&quot;SelectionBox&quot;)
&#9;&#9;&#9;&#9;Rep.Color = v.Torso.BrickColor
&#9;&#9;&#9;&#9;Rep.Adornee = v.Torso
&#9;&#9;&#9;&#9;Rep.Parent = script.Parent
&#9;&#9;&#9;&#9;table.insert(mines,Rep)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;wait(15)
&#9;for i,v in pairs(mines) do
&#9;&#9;v:remove()
&#9;end&#9;
&#9;Detecting = false
end)


function UpdateTransport()
&#9;if Model == nil then return end
&#9;&#9;local Carrying = 0
&#9;&#9;for _,tag in pairs(Model.Transporting:getChildren()) do
&#9;&#9;&#9;if tag.className == &quot;ObjectValue&quot; then 
&#9;&#9;&#9;&#9;if tag.Value.Parent.Name == &quot;Soldier&quot; then
&#9;&#9;&#9;&#9;&#9;Carrying = Carrying+1
&#9;&#9;&#9;&#9;elseif tag.Value.Parent.Name == &quot;Vehicle&quot; then
&#9;&#9;&#9;&#9;&#9;Carrying = Carrying+2
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;script.Parent.TransportData.Text = &quot;Transporting: &quot;..Carrying..&quot;/8&quot;
end

script.Parent.SetRallyPoint.MouseButton1Up:connect(function()
&#9;if Model == nil then return end
&#9;if Model:findFirstChild(&quot;RallyPoint&quot;) == nil then return end
&#9;Model.RallyPoint.Value = game.Players.LocalPlayer.Character.Torso.Position
&#9;local mark = Instance.new(&quot;Part&quot;)
&#9;mark.TopSurface = 0
&#9;mark.BottomSurface = 0
&#9;mark.formFactor = 0
&#9;mark.Size = Vector3.new(1,1,1)
&#9;mark.CFrame = game.Players.LocalPlayer.Character.Torso.CFrame
&#9;mark.BrickColor = game.Players.LocalPlayer.TeamColor
&#9;mark.Anchored = true
&#9;mark.CanCollide = false
&#9;mark.Parent = Workspace.CurrentCamera
&#9;
&#9;local mesh = Instance.new(&quot;SpecialMesh&quot;)
&#9;mesh.MeshType = &quot;Sphere&quot;
&#9;mesh.Scale = Vector3.new(0,0,0)
&#9;mesh.Parent = mark
&#9;
&#9;for i=0,3,0.25 do
&#9;&#9;mesh.Scale = Vector3.new(i,i,i)
&#9;&#9;wait()
&#9;end
&#9;for i=3,0,-0.25 do
&#9;&#9;mesh.Scale = Vector3.new(i,i,i)
&#9;&#9;wait()
&#9;end&#9;
&#9;mark:remove()
end)

script.Parent.LoadUnit.MouseButton1Up:connect(function()
&#9;if Model == nil then return end
&#9;TeamColor = Model.Team.Value
&#9;loaded = false
&#9;for i,v in pairs(Workspace:getChildren()) do
&#9;&#9;if loaded == false and v:findFirstChild(&quot;Transporting&quot;) ~= nil and v:findFirstChild(&quot;Team&quot;) ~= nil and v.Team.Value == TeamColor then
&#9;&#9;&#9;if v.Name == &quot;Air&quot; then 
&#9;&#9;&#9;&#9;if (v.AttackPosition.Position - Model.Torso.Position).magnitude &lt;= 15 then
&#9;&#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;&#9;local Carrying = 0
&#9;&#9;&#9;&#9;&#9;for _,tag in pairs(v.Transporting:getChildren()) do
&#9;&#9;&#9;&#9;&#9;&#9;if tag.className == &quot;ObjectValue&quot; then 
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if tag.Value.Parent.Name == &quot;Soldier&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;Carrying = Carrying+1
&#9;&#9;&#9;&#9;&#9;&#9;&#9;elseif tag.Value.Parent.Name == &quot;Vehicle&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;Carrying = Carrying+2
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;local weight = 1
&#9;&#9;&#9;&#9;&#9;if Model.Name == &quot;Soldier&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;weight = 1
&#9;&#9;&#9;&#9;&#9;elseif Model.Name == &quot;Vehicle&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;weight = 2
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;if Carrying+weight &lt;= 8 then
&#9;&#9;&#9;&#9;&#9;&#9;loaded = true
&#9;&#9;&#9;&#9;&#9;&#9;local mark = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;mark.Name = &quot;Transported&quot;
&#9;&#9;&#9;&#9;&#9;&#9;mark.Value = Model.Torso
&#9;&#9;&#9;&#9;&#9;&#9;mark.Parent = v.Transporting
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;if (v.Torso.Position-Model.Torso.Position).magnitude &lt;= 15 then
&#9;&#9;&#9;&#9;&#9;local mark = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;&#9;&#9;&#9;mark.Name = &quot;Transported&quot;
&#9;&#9;&#9;&#9;&#9;mark.Value = Model.Torso
&#9;&#9;&#9;&#9;&#9;mark.Parent = v.Transporting
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end)

script.Parent.Unload.MouseButton1Up:connect(function()
&#9;if Model == nil then return end
&#9;if Model:findFirstChild(&quot;Unload&quot;) == nil then print(&quot;Error: not transport&quot;) return end
&#9;Model.Unload.Value = not Model.Unload.Value
end)

script.Parent.UpgradeSteamPlant.MouseButton1Up:connect(function()
&#9;if Model == nil then return end
&#9;if Model.UpgradeLevel.Value &gt;= 10 then return end
&#9;if Model.Upgrading.Value == true then return end
&#9;
&#9;if player.Money.Value &gt;= 20 then
&#9;&#9;player.Money.Value = player.Money.Value -20
&#9;&#9;Model.Upgrading.Value = true
&#9;&#9;connection2 = Model.StatusReadout.Changed:connect(updatereadout)
&#9;end
end)


script.Parent.Selection.Changed:connect(function(NewObject)
&#9;Model = NewObject.Parent
&#9;if Model:findFirstChild(&quot;Class&quot;) == nil then return end

&#9;if Model.Class.Value == &quot;Building&quot; then
&#9;&#9;script.Parent.UnitName.Text = Model.Name
&#9;elseif Model.Class.Value == &quot;Unit&quot; then
&#9;&#9;script.Parent.UnitName.Text = Model.UnitType.Value..&quot; &quot;..Model.Name
&#9;end&#9;
&#9;-- Name located
&#9;if connection~= nil then
&#9;&#9;connection:disconnect()
&#9;end
&#9;if connection2~= nil then
&#9;&#9;connection2:disconnect()
&#9;end&#9;

&#9;connection = Model.Health.Changed:connect(UpdateHealth)
&#9;UpdateHealth(Model.Health.Value)
&#9;
&#9;if Model.Class.Value == &quot;Building&quot; then
&#9;&#9;script.Parent.ClassInfo.Text = game.Lighting.Info.Building.Value
&#9;elseif Model.Class.Value == &quot;Unit&quot; then
&#9;&#9;script.Parent.ClassInfo.Text = game.Lighting.Info[Model.Name].Value
&#9;end

&#9;if Model.Class.Value == &quot;Building&quot; then
&#9;&#9;if game.Lighting.Info:findFirstChild(Model.Name) ~= nil then
&#9;&#9;&#9;script.Parent.UnitInfo.Text = game.Lighting.Info[Model.Name].Value
&#9;&#9;else
&#9;&#9;&#9;script.Parent.UnitInfo.Text = &quot;[No building information]&quot;
&#9;&#9;end
&#9;elseif Model.Class.Value == &quot;Unit&quot; then
&#9;&#9;if game.Lighting.Info:findFirstChild(Model.UnitType.Value) ~= nil then
&#9;&#9;&#9;script.Parent.UnitInfo.Text = game.Lighting.Info[Model.UnitType.Value].Value
&#9;&#9;else
&#9;&#9;&#9;script.Parent.UnitInfo.Text = &quot;[No unit information]&quot;
&#9;&#9;end
&#9;end

&#9;if Model:findFirstChild(&quot;RecruitTable&quot;) ~= nil then
&#9;&#9;script.Parent.SetRallyPoint.Visible = true
&#9;else
&#9;&#9;script.Parent.SetRallyPoint.Visible = false
&#9;end
&#9;
&#9;if Model.Class.Value == &quot;Unit&quot; and Model.UnitType.Value == &quot;Artillery&quot; then
&#9;&#9;script.Parent.DeployArtillery.Visible = true
&#9;else
&#9;&#9;script.Parent.DeployArtillery.Visible = false
&#9;end

&#9;if Model.Name == &quot;CommandCenter&quot; then
&#9;&#9;script.Parent.ViewOwnMines.Visible = true
&#9;&#9;script.Parent.MineSweep.Visible = true
&#9;else
&#9;&#9;script.Parent.ViewOwnMines.Visible = false
&#9;&#9;script.Parent.MineSweep.Visible = false
&#9;end
&#9;
&#9;if Model.Name == &quot;SteamPlant&quot; then
&#9;&#9;script.Parent.UpgradeSteamPlant.Visible = true
&#9;&#9;if Model.Upgrading.Value == true then
&#9;&#9;&#9;script.Parent.UpgradeSteamPlant.Text = Model.StatusReadout.Value
&#9;&#9;elseif Model.UpgradeLevel.Value &lt; 10 then
&#9;&#9;&#9;script.Parent.UpgradeSteamPlant.Text = &quot;Upgrade steam plant to level &quot;..(Model.UpgradeLevel.Value+1)..&quot; for $20&quot;
&#9;&#9;elseif Model.UpgradeLevel.Value &gt;= 10 then
&#9;&#9;&#9;script.Parent.UpgradeSteamPlant.Text = &quot;Steam plant at max level [level 10]&quot;
&#9;&#9;end
&#9;else
&#9;&#9;script.Parent.UpgradeSteamPlant.Visible = false
&#9;end

&#9;if Model:findFirstChild(&quot;Transporting&quot;) ~= nil then
&#9;&#9;if tcon1 ~= nil then
&#9;&#9;&#9;tcon1:disconnect()
&#9;&#9;&#9;tcon2:disconnect()
&#9;&#9;end
&#9;&#9;script.Parent.Unload.Visible = true
&#9;&#9;script.Parent.TransportData.Visible = true
&#9;&#9;UpdateTransport()

&#9;&#9;tcon1 = Model.Transporting.ChildAdded:connect(UpdateTransport)
&#9;&#9;tcon2 = Model.Transporting.ChildRemoved:connect(UpdateTransport)

&#9;else
&#9;&#9;script.Parent.Unload.Visible = false
&#9;&#9;script.Parent.TransportData.Visible = false
&#9;end
&#9;
&#9;if Model.Class.Value == &quot;Unit&quot; and Model:findFirstChild(&quot;Transporting&quot;) == nil and Model.Name ~= &quot;Air&quot; then -- Is a unit, non transport and non air. Air doesn&apos;t transport &gt;_&lt;.
&#9;&#9;script.Parent.LoadUnit.Visible = true
&#9;else
&#9;&#9;script.Parent.LoadUnit.Visible = false
&#9;end
end)
&#9;</ProtectedString>
						</Properties>
					</Item>
				</Item>
