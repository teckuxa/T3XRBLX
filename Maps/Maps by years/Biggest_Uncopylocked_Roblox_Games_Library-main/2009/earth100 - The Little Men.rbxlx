					<Item class="Script" referent="RBX173">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">BuildMenuScript</string>
							<ProtectedString name="Source">Player = script.Parent.Parent.Parent.Parent
Last = nil

Player.Doctrine.Changed:connect(function(Val)
&#9;script.Parent.Selection.Value = Val
&#9;if Last ~= nil then
&#9;&#9;Last.BorderColor3 = Color3.new(41/255,41/255,41/255)
&#9;end 
end)

script.Parent.Selection.Changed:connect(function(Value)
&#9;if Player.Doctrine.Value == &quot;None&quot; then
&#9;&#9;Player.Doctrine.Value = Value
&#9;end
end)

for _,x in pairs(script.Parent:getChildren()) do
&#9;if x.className == &quot;TextButton&quot; then
&#9;&#9;local x = x
&#9;&#9;x.MouseButton1Up:connect(function()
&#9;&#9;&#9;if script.Parent.Selection.Value == &quot;None&quot; then
&#9;&#9;&#9;&#9;script.Parent.Selection.Value = x.Name -- buttons connected
&#9;&#9;&#9;&#9;if Last ~= nil then
&#9;&#9;&#9;&#9;&#9;Last.BorderColor3 = Color3.new(41/255,41/255,41/255)
&#9;&#9;&#9;&#9;end 
&#9;&#9;&#9;&#9;x.BorderColor3 = Color3.new(1,1,102/205)
&#9;&#9;&#9;&#9;Last = x
&#9;&#9;&#9;end
&#9;&#9;end)
&#9;end
end </ProtectedString>
						</Properties>
					</Item>
				</Item>
