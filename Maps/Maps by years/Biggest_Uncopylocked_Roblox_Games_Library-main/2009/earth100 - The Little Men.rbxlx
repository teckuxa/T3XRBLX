				<Item class="Script" referent="RBX7396">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">LocalScript</string>
						<ProtectedString name="Source">script.Parent.Close.MouseButton1Up:connect(function()
&#9;if script.Parent.SelectionMode.Value == &quot;Drag&quot; then
&#9;&#9;script.Parent.SelectionMode.Value  = &quot;Click&quot;
&#9;elseif script.Parent.SelectionMode.Value == &quot;Click&quot; then
&#9;&#9;script.Parent.SelectionMode.Value = &quot;Drag&quot;
&#9;end
&#9;script.Parent.Close.Text = &quot;Selection Mode: &quot;..script.Parent.SelectionMode.Value
end)

for i,v in pairs(Workspace.DiplomacyFolder:getChildren()) do
&#9;if v.Value == script.Parent.Parent.Parent.Parent.TeamColor then
&#9;&#9;v.ChildAdded:connect(function(Val)
&#9;&#9;&#9;New = Val.Value
&#9;&#9;&#9;script.Parent.AllyRep.BackgroundColor3 = Color3.new(New.r,New.g,New.b)
&#9;&#9;end)
&#9;&#9;v.ChildRemoved:connect(function(l)
&#9;&#9;&#9;script.Parent.AllyRep.BackgroundColor3 = Color3.new(1,1,1)
&#9;&#9;end)
&#9;&#9;if v:findFirstChild(&quot;Ally&quot;) ~= nil then
&#9;&#9;&#9;New = v.Ally.Value
&#9;&#9;&#9;script.Parent.AllyRep.BackgroundColor3 = Color3.new(New.r,New.g,New.b)
&#9;&#9;end
&#9;end
end </ProtectedString>
					</Properties>
				</Item>
			</Item>
