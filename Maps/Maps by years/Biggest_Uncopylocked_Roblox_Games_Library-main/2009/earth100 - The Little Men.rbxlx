							<ProtectedString name="Source">script.Parent.TechType.Changed:connect(function()
&#9;wait(0.1)
&#9;script.Parent.Visible = false
&#9;script.Parent.TechType.Value = &quot;None&quot;
end)

script.Parent.Changed:connect(function()
&#9;if script.Parent.Visible == true then
&#9;&#9;for i,v in pairs(game.Players.LocalPlayer.Technology:GetChildren()) do
&#9;&#9;&#9;if script.Parent:findFirstChild(v.Name) ~= nil then
&#9;&#9;&#9;&#9;script.Parent:findFirstChild(v.Name).Text = (v.Name..&quot;:   &quot;..v.Value..&quot;/&quot;..v.Max.Value)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end)

script.Parent.CloseWindow.MouseButton1Up:connect(function()
&#9;script.Parent.Visible = false
&#9;script.Parent.TechType.Value = &quot;None&quot;
end)
&#9;&#9;
for _,x in pairs(script.Parent:getChildren()) do
&#9;if x.className == &quot;TextButton&quot; and x.Name ~= &quot;CloseWindow&quot; then
&#9;&#9;local x = x
&#9;&#9;x.MouseButton1Up:connect(function()
&#9;&#9;&#9;script.Parent.TechType.Value = x.Name -- buttons connected
&#9;&#9;end)
&#9;end
end

wait(1)
print(&quot;TechBooted&quot;)</ProtectedString>
