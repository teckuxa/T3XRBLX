bin = script.Parent
mouseisin = false

mouseStatus = {
&#9;mousedown = &quot;http://www.roblox.com/asset/?id=52161015&quot;,
&#9;mouseout = &quot;http://www.roblox.com/asset/?id=52123224&quot;,
&#9;mousein = &quot;http://www.roblox.com/asset/?id=52162665&quot;
}


bin.ButtonDisplay.MouseEnter:connect(function() 
&#9;mouseisin = true -- mark for description display
&#9;bin.ButtonStatus.Image = mouseStatus.mousein -- change to hovering image
&#9;coroutine.resume(coroutine.create(function()
&#9;&#9;wait(1) 
&#9;&#9;if mouseisin == true then  -- are we still in the button?
&#9;&#9;&#9;bin.Label.Text = bin.Description.Value
&#9;&#9;&#9;bin.Label.Size = UDim2.new(0,15*15,0,20*math.ceil(#bin.Description.Value/20)) 
&#9;&#9;&#9;bin.Label.Position = UDim2.new(1,0,1,-10)
&#9;&#9;&#9;bin.Label.Visible = true -- Display the description
&#9;&#9;end
&#9;end))
end)

bin.ButtonDisplay.MouseLeave:connect(function()
&#9;mouseisin = false -- we aren&apos;t in the button
&#9;bin.Label.Visible = false -- hide the description if it sout there
&#9;bin.ButtonStatus.Image = mouseStatus.mouseout -- reset button image
end)

bin.ButtonDisplay.MouseButton1Down:connect(function()
&#9;bin.ButtonStatus.Image = mouseStatus.mousedown -- show the change
end)

bin.ButtonDisplay.MouseButton1Up:connect(function()
&#9;bin.Clicked.Value = not bin.Clicked.Value -- ping the clicked for outside scripts to detect
&#9;bin.ButtonStatus.Image = mouseStatus.mousein -- show the change.
end)</ProtectedString>
