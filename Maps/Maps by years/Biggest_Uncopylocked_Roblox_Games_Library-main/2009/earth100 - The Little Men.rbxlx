				<string name="Name">BuildingHandler</string>
				<ProtectedString name="Source">function AlertPlayer(color) -- BrickColor, the player&apos;s teamcolor.
&#9;for _,v in pairs(game.Players:getChildren()) do
&#9;&#9;if v.TeamColor == color then
&#9;&#9;&#9;if v:findFirstChild(&quot;PlayerGui&quot;) == nil then return end
&#9;&#9;&#9;if v.PlayerGui:findFirstChild(&quot;GameData&quot;) == nil then return end
&#9;&#9;&#9;v.PlayerGui.GameData.Warning.Alert.Value = not v.PlayerGui.GameData.Warning.Alert.Value -- toggle the alert.
&#9;&#9;end
&#9;end
end

function hookup(model) -- Model, makes necessary connections.
&#9;local building = model
&#9;
&#9;-- Alert connection:
&#9;local lasthealth = building.Health.Value
&#9;print(&quot;HealthConnection&quot;)

&#9;building.Health.Changed:connect(function(value)
&#9;&#9;print(value)
&#9;&#9;print(lasthealth)
&#9;&#9;if (lasthealth-value) &gt;0 then -- Building is hurt.
&#9;&#9;&#9;AlertPlayer(building.Team.Value)
&#9;&#9;end
&#9;&#9;lasthealth = building.Health.Value
&#9;end)
end

Workspace.ChildAdded:connect(function(c)
&#9;print(&quot;Child&quot;)
&#9;wait()
&#9;if c:findFirstChild(&quot;Class&quot;) ~= nil then
&#9;&#9;print(&quot;Class&quot;)
&#9;&#9;if c.Class.Value == &quot;Building&quot; then
&#9;&#9;&#9;print(&quot;Building&quot;)
&#9;&#9;&#9;hookup(c) -- Is a building.
&#9;&#9;end
&#9;end
end)


wait(2)
print(&quot;I&apos;m here!&quot;)

