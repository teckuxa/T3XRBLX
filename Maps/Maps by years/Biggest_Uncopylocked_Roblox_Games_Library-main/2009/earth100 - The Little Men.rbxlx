			<Item class="Script" referent="RBX1599">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Weld</string>
					<ProtectedString name="Source">Figure = script.Parent
Speed = 7
Damage = 4
Firing = false
Canceled = true
Found = false

ClassTable = {&quot;Building&quot;,&quot;Rifle&quot;,&quot;Rocket&quot;,&quot;Tank&quot;,&quot;Heli&quot;,&quot;HeavyHeli&quot;,&quot;SAM&quot;,&quot;Scout&quot;,&quot;Artillery&quot;}
DamageTable = {0.5,3,3,1,2.5,4,1,3,1} -- Damage applied to these units

function CheckIfAllied(MyTeam,ObjectTeam)
&#9;for i,v in pairs(Workspace.DiplomacyFolder:getChildren()) do
&#9;&#9;if v.Value == MyTeam then
&#9;&#9;&#9;for _,team in pairs(v:getChildren()) do
&#9;&#9;&#9;&#9;if team.Value == ObjectTeam then return true end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;return false
end


for i,v in pairs(Figure:getChildren()) do
&#9;if v.Name == &quot;Asthetic&quot; then 
&#9;&#9;v.BrickColor = Figure.Team.Value -- Color the character
&#9;end
end
function Weld(x, y) -- The classic weld function.
&#9;weld = Instance.new(&quot;Weld&quot;) 
&#9;weld.Part0 = x
&#9;weld.Part1 = y
&#9;local HitPos = x.Position
&#9;local CJ = CFrame.new(HitPos) 
&#9;local C0 = x.CFrame:inverse() *CJ 
&#9;local C1 = y.CFrame:inverse() * CJ 
&#9;weld.C0 = C0 
&#9;weld.C1 = C1 
&#9;weld.Parent = y 
end 

for i,v in pairs(Figure:getChildren()) do 
&#9;if v.Name ~=&quot;Torso&quot; and v.className == &quot;Part&quot; then
&#9;&#9;Weld(Figure.Torso,v)
&#9;end
&#9;if v.className == &quot;Part&quot; then
&#9;&#9;v.Anchored = false
&#9;end
end 

--Arms attached.


Aim = Instance.new(&quot;BodyGyro&quot;)
Aim.maxTorque = Vector3.new(99999999999999999999999999999999999999999999999999999999999999999999999,99999999999999999999999999999999999999999999999999999999999999999999999,99999999999999999999999999999999999999999999999999999999999999999999999)
Aim.Name = &quot;Aim&quot;
Aim.Parent = Figure.Torso

-- Aimer added.

Floater = Instance.new(&quot;BodyPosition&quot;)
Floater.maxForce = Vector3.new(0,999999999999999999999999999999999999999999999999999999,0)
Floater.position = Vector3.new(0,18,0)
Floater.Parent = Figure.Torso

Floater.position = Vector3.new(0,18,0)



Engine = Instance.new(&quot;BodyVelocity&quot;)
Engine.Name = &quot;Engine&quot;
Engine.velocity = Vector3.new(0,-10,0)
Engine.Parent = Figure.Torso

-- Engine for power.
MoveCommand = 1
Current = 0
Figure.Target.Changed:connect(function (Value)
&#9;Firing = false
&#9;MoveCommand = MoveCommand+1
&#9;local Current = MoveCommand
&#9;wait(0.5)
&#9;local Value = Vector3.new(Value.x,Figure.Torso.Position.y,Value.z)
&#9;Aim.cframe = CFrame.new(Figure.Torso.Position,Value)
&#9;while (Figure.Torso.Position.x+1&lt; Value.x or Figure.Torso.Position.x-1 &gt; Value.x) or  (Figure.Torso.Position.z+1&lt; Value.z or Figure.Torso.Position.z-1 &gt; Value.z)  do
&#9;&#9;if Current ~= MoveCommand then return end
&#9;&#9;Power = Aim.cframe.lookVector*Speed*Figure.SpeedMultiplier.Value
&#9;&#9;Engine.velocity = Vector3.new(Power.x,Engine.velocity.y,Power.z)
&#9;&#9;Aim.cframe = CFrame.new(Figure.Torso.Position,Value)
&#9;&#9;wait(0.1)
&#9;end
&#9;Engine.velocity = Vector3.new(0)
end)

for i,v in pairs(Figure:GetChildren()) do
&#9;if v.Name == &quot;Leg&quot; or v.Name == &quot;Arm&quot; or v.Name == &quot;Weapon&quot; then
&#9;&#9;local v = v
&#9;&#9;v.Touched:connect(function (hit)
&#9;&#9;&#9;if hit:findFirstChild(&quot;Terrain&quot;) ~= nil then
&#9;&#9;&#9;&#9;print(&quot;Try to jump!&quot;)
&#9;&#9;&#9;&#9;while (hit.Position.y+(hit.Size.y/2)) &gt; (v.Position.y-(v.Size.y/2))+0.05 do
&#9;&#9;&#9;&#9;&#9;Engine.velocity = Vector3.new(Engine.velocity.x,75,Engine.velocity.z)
&#9;&#9;&#9;&#9;&#9;wait(0.1)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;Engine.velocity = Vector3.new(Engine.velocity.x,-10,Engine.velocity.z)
&#9;&#9;&#9;end
&#9;&#9;end)
&#9;end
end 

function Attack(Enemy)
&#9;if Enemy:findFirstChild(&quot;Torso&quot;) == nil then Firing = false return end -- He&apos;s dead D:

&#9;for i=1,3 do
&#9;&#9;local Shot = Instance.new(&quot;Part&quot;)
&#9;&#9;Shot.Name = &quot;Shot&quot;
&#9;&#9;Shot.TopSurface = 0
&#9;&#9;Shot.BottomSurface = 0
&#9;&#9;Offset = Vector3.new(math.random(-1,1),math.random(-1,1),math.random(-1,1))
&#9;&#9;Shot.Size = Vector3.new(1,1,(Enemy.Torso.Position+Offset-Figure.Weapon.Position).magnitude)
&#9;&#9;Shot.CFrame = CFrame.new(Enemy.Torso.Position+Offset,Figure.Weapon.Position)*CFrame.new(0,0,-1*Shot.Size.z/2)
&#9;&#9;Shot.Transparency = 0
&#9;&#9;Shot.Anchored = true
&#9;&#9;Shot.CanCollide = false
&#9;&#9;Mesh = Instance.new(&quot;SpecialMesh&quot;)
&#9;&#9;Mesh.MeshType = &quot;Brick&quot;
&#9;&#9;Mesh.Scale = Vector3.new(0.1,0.1,1)
&#9;&#9;Mesh.Parent = Shot
&#9;&#9;Shot.Parent = Figure
&#9;&#9;Damage = 2
&#9;&#9;for i,v in pairs(Enemy:getChildren()) do
&#9;&#9;&#9;if v:findFirstChild(&quot;UnitType&quot;) ~= nil then
&#9;&#9;&#9;&#9;for _,x in pairs(ClassTable) do
&#9;&#9;&#9;&#9;&#9;if x == v.UnitType.Value then
&#9;&#9;&#9;&#9;&#9;&#9;Damage = DamageTable[_] -- Find Correct damage
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;if Enemy.Class.Value == &quot;Building&quot; then
&#9;&#9;&#9;Damage = DamageTable[1] -- Damage to buildings
&#9;&#9;end

&#9;&#9;Enemy.Health.Value = Enemy.Health.Value - Damage*Figure.DamageMultiplier.Value
&#9;&#9;if Enemy.Health.Value &lt;= 0 then 
&#9;&#9;&#9;print(&quot;Stop Firing&quot;)
&#9;&#9;&#9;Firing = false
&#9;&#9;end 
&#9;&#9;for i=0,1,0.25 do
&#9;&#9;&#9;Shot.Transparency = i
&#9;&#9;&#9;wait()
&#9;&#9;end
&#9;&#9;Shot:remove()
&#9;&#9;wait()
&#9;end
end


Targets = {}
FireCount = 0
lastfire = tick()

Figure.OnAlert.Changed:connect(function(Val)
&#9;if Val == false then return Canceled == true end
&#9;if Firing == true then print(&quot;Firing already&quot;) return end

&#9;FireCount = FireCount+1
&#9;local thisFire = FireCount
&#9;Canceled = false
&#9;for i,v in pairs(Workspace:GetChildren()) do
&#9;&#9;if v:findFirstChild(&quot;Team&quot;) ~= nil and v.Team.Value ~= Figure.Team.Value and CheckIfAllied(Figure.Team.Value,v.Team.Value) == false then
&#9;&#9;&#9;table.insert(Targets,v)
&#9;&#9;end
&#9;end
&#9;for i,v in pairs(Targets) do
&#9;&#9;if v~= nil and v:FindFirstChild(&quot;Torso&quot;) ~= nil then
&#9;&#9;&#9;if (v.Torso.Position-Figure.Torso.Position).magnitude&lt;=Figure.Range.Value*1.5 then
&#9;&#9;&#9;&#9;--Figure.OnAlert.Value = true
&#9;&#9;&#9;&#9;Found = true
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;if Found == false then Figure.OnAlert.Value = false  return end
&#9;Targeted = nil
&#9;Closest = Figure.Range.Value
&#9;while Figure.OnAlert.Value == true and Canceled == false and FireCount == thisFire do
&#9;&#9;Targeted = nil
&#9;&#9;for i,v in pairs(Targets) do
&#9;&#9;&#9;if v~= nil and v:FindFirstChild(&quot;Torso&quot;) ~= nil then
&#9;&#9;&#9;&#9;if (v.Torso.Position-Figure.Torso.Position).magnitude&lt;=Closest then
&#9;&#9;&#9;&#9;&#9;Targeted = v
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;if Targeted ~= nil and lastfire+1.5 &lt; tick() then
&#9;&#9;&#9;lastfire = tick()
&#9;&#9;&#9;Firing = true
&#9;&#9;&#9;Attack(Targeted)
&#9;&#9;end
&#9;&#9;wait(1.5)
&#9;end
end)




Build = script.Parent -- Parent shortcut
Parts = {} -- Table to store parts.
Materials = {}

for i,v in pairs(Build:getChildren()) do
&#9;if v:IsA(&quot;Part&quot;) then
&#9;&#9;table.insert(Parts,v) -- If its a part record it
&#9;&#9;table.insert(Materials,v.Material)
&#9;end
end 

MaxHealth = Build.Health.Value
LastHealth = MaxHealth

Build.Health.Changed:connect(function(Value)
&#9;DamageRep = 1-(Value/MaxHealth) -- Get decimal for damage
&#9;NumberDamaged = math.floor(#Parts*DamageRep)
&#9;for i,v in pairs(Parts) do
&#9;&#9;v.Material = Materials[i] -- reset building
&#9;end
&#9;if NumberDamaged &gt;=1 and NumberDamaged &lt;= #Parts then -- If we have some damage
&#9;&#9;for i=1,NumberDamaged do -- Damage the building
&#9;&#9;&#9;Parts[i].Material = &quot;CorrodedMetal&quot; -- Show it.
&#9;&#9;end
&#9;else -- No damage
&#9;&#9;for i,v in pairs(Parts) do
&#9;&#9;&#9;v.Material = Materials[i] -- reset building
&#9;&#9;end
&#9;end
&#9;if Value &lt;= 0 then
&#9;&#9;for i,v in pairs(Parts) do
&#9;&#9;&#9;v.Anchored = false
&#9;&#9;end
&#9;&#9;e = Instance.new(&quot;Explosion&quot;)
&#9;&#9;e.BlastPressure = 0
&#9;&#9;e.Position = Build.Torso.Position
&#9;&#9;e.Parent = Build
&#9;&#9;Build:BreakJoints()
&#9;&#9;wait(3)
&#9;&#9;Build:remove()
&#9;end
&#9;if Value &lt; LastHealth then
&#9;&#9;wait(0.5)
&#9;&#9;Figure.OnAlert.Value = true -- HEY WE TOOK DAMAGE!
&#9;end
&#9;LastHealth = Value
end)
