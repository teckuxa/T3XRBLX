function CheckIfAllied(MyTeam,ObjectTeam)
&#9;for i,v in pairs(Workspace.DiplomacyFolder:getChildren()) do
&#9;&#9;if v.Value == MyTeam then
&#9;&#9;&#9;for _,team in pairs(v:getChildren()) do
