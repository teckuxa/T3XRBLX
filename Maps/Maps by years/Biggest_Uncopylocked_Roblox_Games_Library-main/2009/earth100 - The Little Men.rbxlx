			<Item class="Script" referent="RBX1431">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">wait(0.2)
Build = script.Parent -- Parent shortcut
Parts = {} -- Table to store parts.
Materials = {}
Trans = {}

ClassTable = {&quot;Building&quot;,&quot;Rifle&quot;,&quot;Rocket&quot;,&quot;Tank&quot;,&quot;Heli&quot;,&quot;HeavyHeli&quot;,&quot;SAM&quot;,&quot;Scout&quot;,&quot;Artillery&quot;}
DamageTable = {15,4,4,25,5,5,25,4,25} -- Damage applied to these units

function CheckIfAllied(MyTeam,ObjectTeam)
&#9;for i,v in pairs(Workspace.DiplomacyFolder:getChildren()) do
&#9;&#9;if v.Value == MyTeam then
&#9;&#9;&#9;for _,team in pairs(v:getChildren()) do
&#9;&#9;&#9;&#9;if team.Value == ObjectTeam then return true end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;return false
end

for i,v in pairs(Build:getChildren()) do
&#9;if v.Name == &quot;Asthetic&quot; then
&#9;&#9;v.BrickColor = Build.Team.Value -- Color asthetics accordingly
&#9;end
&#9;if v:IsA(&quot;Part&quot;) then
&#9;&#9;table.insert(Parts,v) -- If its a part record it
&#9;&#9;table.insert(Materials,v.Material)
&#9;&#9;table.insert(Trans,v.Transparency)
&#9;end
end 

Build.Health.Value = Build.MaxHealth.Value
MaxHealth = Build.MaxHealth.Value

Build.Health.Changed:connect(function(Value)
&#9;DamageRep = 1-(Value/MaxHealth) -- Get decimal for damage
&#9;NumberDamaged = math.floor(#Parts*DamageRep)
&#9;for i,v in pairs(Parts) do
&#9;&#9;v.Material = Materials[i] -- reset building
&#9;end
&#9;if NumberDamaged &gt;=1 and NumberDamaged &lt;= #Parts then -- If we have some damage
&#9;&#9;for i=1,NumberDamaged do -- Damage the building
&#9;&#9;&#9;Parts[i].Material = &quot;CorrodedMetal&quot; -- Show it.
&#9;&#9;end
&#9;else -- No damage
&#9;&#9;for i,v in pairs(Parts) do
&#9;&#9;&#9;v.Material = Materials[i] -- reset building
&#9;&#9;end
&#9;end
&#9;if Value &lt;= 0 then
&#9;&#9;for i,v in pairs(Parts) do
&#9;&#9;&#9;v.Anchored = false
&#9;&#9;end
&#9;&#9;e = Instance.new(&quot;Explosion&quot;)
&#9;&#9;e.BlastPressure = 0
&#9;&#9;e.Position = Build.Torso.Position
&#9;&#9;e.Parent = Build
&#9;&#9;Build:BreakJoints()
&#9;&#9;wait(3)
&#9;&#9;Build:remove()
&#9;end
end)
function Attack(Enemy,Damage)
&#9;if Enemy:findFirstChild(&quot;Torso&quot;) == nil then return end -- He&apos;s dead D:

&#9;Build.Weapon.CFrame = CFrame.new(Build.Torso.Position,Enemy.Torso.Position)*CFrame.Angles(math.rad(90),0,0)*CFrame.new(0,-1.5*(Build.Weapon.Size.y),0)
&#9;local Shot = Instance.new(&quot;Part&quot;)
&#9;Shot.Name = &quot;Shot&quot;
&#9;Shot.TopSurface = 0
&#9;Shot.BottomSurface = 0
&#9;Shot.formFactor = 2
&#9;Shot.Size = Vector3.new(1,1,1)
&#9;Shot.CFrame = Enemy.Torso.CFrame*CFrame.new(math.random(-2.5,2.5),math.random(-2.5,2.5),math.random(-2.5,2.5))
&#9;Shot.Transparency = 0
&#9;Shot.Anchored = true
&#9;Shot.CanCollide = false
&#9;Shot.BrickColor = BrickColor.new(&quot;Bright red&quot;)
&#9;Mesh = Instance.new(&quot;SpecialMesh&quot;)
&#9;Mesh.MeshType = &quot;Sphere&quot;
&#9;Mesh.Scale = Vector3.new(1,1,1)
&#9;Mesh.Parent = Shot
&#9;Shot.Parent = Build
&#9;Damage = 2
&#9;for i,v in pairs(Enemy:getChildren()) do
&#9;&#9;if v:findFirstChild(&quot;UnitType&quot;) ~= nil then
&#9;&#9;&#9;for _,x in pairs(ClassTable) do
&#9;&#9;&#9;&#9;if x == v.UnitType.Value then
&#9;&#9;&#9;&#9;&#9;Damage = DamageTable[_] -- Find Correct damage
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;if Enemy.Class.Value == &quot;Building&quot; then
&#9;&#9;Damage = DamageTable[1] -- Damage to buildings
&#9;end

&#9;Enemy.Health.Value = Enemy.Health.Value - Damage
&#9;if Enemy.Health.Value &lt;= 0 then 
&#9;&#9;print(&quot;Stop Firing&quot;)
&#9;&#9;Firing = false
&#9;end 
&#9;for i=0,1,0.1 do
&#9;&#9;Shot.Transparency = i
&#9;&#9;Shot.Mesh.Scale = Shot.Mesh.Scale+Vector3.new(0.1,0.1,0.1)
&#9;&#9;wait()
&#9;end
&#9;Shot:remove()
end


if Build.Built.Value == false then
&#9;for i,v in pairs(Parts) do
&#9;&#9;v.Transparency = v.Transparency+1
&#9;end
&#9;for i,v in pairs(Parts) do
&#9;&#9;v.CFrame = v.CFrame*CFrame.new(0,5,0)
&#9;&#9;for i=1,10 do
&#9;&#9;&#9;v.CFrame = v.CFrame*CFrame.new(0,-0.5,0)
&#9;&#9;&#9;v.Transparency = v.Transparency-0.1
&#9;&#9;&#9;wait()
&#9;&#9;end
&#9;&#9;v.Transparency = Trans[i]
&#9;&#9;wait(Build.BuildingTime.Value)
&#9;end
&#9;Build.Built.Value = true
&#9;s = Instance.new(&quot;Sparkles&quot;)
&#9;s.Parent = Build.Torso
&#9;if Build.Worker.Value ~= nil then
&#9;&#9;Build.Worker.Value.Parent.Torso.Anchored = false
&#9;&#9;Build.Worker.Value.Parent:MoveTo(Build.Torso.Position+Vector3.new(math.random(10,15)*((math.random(0,1)*2)-1),1.75,math.random(10,15)*((math.random(0,1)*2)-1)))
&#9;end
&#9;wait(2)
&#9;s:remove()
end 


waittime = 5
while true do
&#9;wait(waittime)
&#9;Targets = {}
&#9;for i,v in pairs(Workspace:getChildren()) do
&#9;&#9;if v:findFirstChild(&quot;Team&quot;) ~= nil and v.Team.Value ~= Build.Team.Value and CheckIfAllied(Build.Team.Value,v.Team.Value) == false then
&#9;&#9;&#9;table.insert(Targets,v) -- Build a table :3
&#9;&#9;end
&#9;end
&#9;Closest = 30 -- Range
&#9;Shoot = nil
&#9;Targeted = nil
&#9;&#9;for i,v in pairs(Targets) do
&#9;&#9;&#9;if v~= nil and v.Name ~= &quot;Air&quot; and v:FindFirstChild(&quot;Torso&quot;) ~= nil then
&#9;&#9;&#9;&#9;if (v.Torso.Position-Build.Torso.Position).magnitude&lt;=Closest then
&#9;&#9;&#9;&#9;&#9;Targeted = v
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;elseif v~= nil and v.Name == &quot;Air&quot; and v:FindFirstChild(&quot;Torso&quot;) ~= nil then
&#9;&#9;&#9;&#9;if (v.AttackPosition.Position-Build.Torso.Position).magnitude&lt;=Closest then
&#9;&#9;&#9;&#9;&#9;Targeted = v
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;Shoot = Targeted
&#9;if Shoot~= nil then
&#9;&#9;while Shoot.Health.Value &gt;= 0 and (Shoot.Torso.Position-Build.Torso.Position).magnitude &lt;= 30 do -- While its alive and in range 
&#9;&#9;&#9;wait(1)
&#9;&#9;&#9;Attack(Shoot,1)
&#9;&#9;end
&#9;&#9;waittime = 0.5
&#9;else
&#9;&#9;waittime = 5
&#9;end
end

