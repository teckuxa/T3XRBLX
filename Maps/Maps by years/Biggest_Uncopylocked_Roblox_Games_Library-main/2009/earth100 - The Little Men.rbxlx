					<Item class="Script" referent="RBX144">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Instrctions</string>
							<ProtectedString name="Source">Last = nil
wait(0.1)
script.Parent.Visible = true
print(&quot;BOOTED&quot;)

for i,v in pairs(script.Parent:GetChildren()) do
&#9;if v.className == &quot;TextButton&quot; and v.Name ~= &quot;Close&quot; then -- WILL HAVE TO CHANGE
&#9;&#9;local v = v
&#9;&#9;v.MouseButton1Up:connect(function()
&#9;&#9;&#9;script.Parent.Selection.Value = v.Name
&#9;&#9;end)
&#9;end
end 

script.Parent.Selection.Changed:connect(function(Val)
&#9;for i,v in pairs(script.Parent:getChildren()) do
&#9;&#9;if v.className == &quot;Frame&quot; and v.Name ~= &quot;Framer&quot; then
&#9;&#9;&#9;if Val == v.Name then
&#9;&#9;&#9;&#9;v.Visible = true
&#9;&#9;&#9;else 
&#9;&#9;&#9;&#9;v.Visible = false
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end)

Open = true
script.Parent.Close.MouseButton1Up:connect(function()
&#9;if Open == true then
&#9;&#9;Open = false
&#9;&#9;script.Parent.Position = script.Parent.Position-UDim2.new(0,0,0.5,240)
&#9;&#9;script.Parent.Close.Text = &quot;OPEN INSTRUCTIONS&quot;
&#9;elseif Open == false then
&#9;&#9;Open = true 
&#9;&#9;script.Parent.Position = script.Parent.Position+UDim2.new(0,0,0.5,240)
&#9;&#9;script.Parent.Close.Text = &quot;CLOSE INSTRUCTIONS&quot;
&#9;end
end)</ProtectedString>
						</Properties>
					</Item>
