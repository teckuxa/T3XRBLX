function updateHealthBar(healthbar,meter,max) -- healthbar is a gui health bar as seen in OneSelection. meter is a number value,max is an int value
&#9;local meter = meter
&#9;local max = max
&#9;local healthbar = healthbar

&#9;meter.Changed:connect(function(val)
&#9;&#9;print(&quot;Health: &quot;..val)
&#9;&#9;healthbar.Amnt.Size = UDim2.new(meter.Value/max.Value,0,1,0)
&#9;&#9;healthbar.Amnt.Position = UDim2.new(1-(meter.Value/max.Value),0,0,0)
&#9;&#9;healthbar.HealthDisplay.Text = val..&quot;/&quot;..max.Value
&#9;end)
end

function select(selection) -- selection is a viable game object that will become the only selection in the player&apos;s selection
&#9;for _,v in pairs(player.Selection:getChildren()) do
&#9;&#9;if v.Value.Parent ~= selection then
&#9;&#9;&#9;v:remove()
&#9;&#9;end
&#9;end
end



function updateGui() -- updates the gui.
&#9;if (#player.Selection:getChildren() == 0) then

&#9;&#9;bin.MultiSelection.Visible = false
&#9;&#9;bin.OneSelection.Visible = false -- ensure they don&apos;t show.

&#9;elseif (#player.Selection:getChildren() == 1) then

&#9;&#9;bin.MultiSelection.Visible = false -- hide multi incase its up
&#9;&#9;local object = player.Selection:getChildren()[1].Value.Parent -- OBJECTVALUE
&#9;&#9;bin.OneSelection.Image.Image = images[object.Tag.Value]
&#9;&#9;bin.OneSelection.ID.Text = object.ID.Value
&#9;&#9;
&#9;&#9;if healthconnection ~= nil then
&#9;&#9;&#9;healthconnection:disconnect()
&#9;&#9;end
&#9;&#9;healthconnection = object.Health.Changed:connect(function()
&#9;&#9;&#9;updateHealthBar(bin.OneSelection.Health,object.Health,object.MaxHealth)
&#9;&#9;end)
&#9;&#9;&#9;
&#9;&#9;bin.OneSelection.Visible = true -- all ready!
&#9;else

&#9;&#9;bin.OneSelection.Visible = false -- hide oneselection incase its up
&#9;&#9;for _,v in pairs(bin.MultiSelection:getChildren()) do
&#9;&#9;&#9;v:remove() -- clear out old selections
&#9;&#9;end
&#9;&#9;row = 0
&#9;&#9;column = 10
&#9;&#9;AbsoluteSize = 300 -- size of the box

&#9;&#9;for _,v in pairs(player.Selection:GetChildren()) do
&#9;&#9;&#9;local selection = v.Value.Parent -- OBJECTVALUE
&#9;&#9;&#9;local newButton = bin.Parent.ButtonEX:clone()
&#9;&#9;&#9;newButton.Name = &quot;SelectionButton&quot;
&#9;&#9;&#9;newButton.Description.Value = selection.ID.Value
&#9;&#9;&#9;newButton.ButtonDisplay.Image = images[selection.Tag.Value]
&#9;&#9;&#9;newButton.Position = UDim2.new(0,column,0,row)

&#9;&#9;&#9;newButton.Clicked.Changed:connect(function()
&#9;&#9;&#9;&#9;select(selection)
&#9;&#9;&#9;end)

&#9;&#9;&#9;newButton.Visible = true
&#9;&#9;&#9;newButton.Parent = bin.MultiSelection

&#9;&#9;&#9;
&#9;&#9;&#9;if column+50 &gt; AbsoluteSize then
&#9;&#9;&#9;&#9;row = row+50
&#9;&#9;&#9;&#9;column = 10
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;column = column+50
&#9;&#9;&#9;end
&#9;&#9;end

&#9;&#9;bin.MultiSelection.Visible = true -- all ready!

&#9;end
end

player.Selection.ChildAdded:connect(updateGui)
player.Selection.ChildRemoved:connect(updateGui)</ProtectedString>
