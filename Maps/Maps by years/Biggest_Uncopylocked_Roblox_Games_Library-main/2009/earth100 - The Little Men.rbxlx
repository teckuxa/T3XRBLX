			<Item class="Script" referent="RBX1345">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">Build = script.Parent -- Parent shortcut
Parts = {} -- Table to store parts.
Materials = {}
Trans = {}

for i,v in pairs(Build:getChildren()) do
&#9;if v.Name == &quot;Asthetic&quot; then
&#9;&#9;v.BrickColor = Build.Team.Value -- Color asthetics accordingly
&#9;end
&#9;if v:IsA(&quot;Part&quot;) then
&#9;&#9;table.insert(Parts,v) -- If its a part record it
&#9;&#9;table.insert(Materials,v.Material)
&#9;&#9;table.insert(Trans,v.Transparency)
&#9;end
end 

Build.Health.Value = Build.MaxHealth.Value

Build.Health.Value = Build.MaxHealth.Value
MaxHealth = Build.MaxHealth.Value

Build.Health.Changed:connect(function(Value)
&#9;DamageRep = 1-(Value/MaxHealth) -- Get decimal for damage
&#9;NumberDamaged = math.floor(#Parts*DamageRep)
&#9;for i,v in pairs(Parts) do
&#9;&#9;v.Material = Materials[i] -- reset building
&#9;end
&#9;if NumberDamaged &gt;=1 and NumberDamaged &lt;= #Parts then -- If we have some damage
&#9;&#9;for i=1,NumberDamaged do -- Damage the building
&#9;&#9;&#9;Parts[i].Material = &quot;CorrodedMetal&quot; -- Show it.
&#9;&#9;end
&#9;else -- No damage
&#9;&#9;for i,v in pairs(Parts) do
&#9;&#9;&#9;v.Material = Materials[i] -- reset building
&#9;&#9;end
&#9;end
&#9;if Value &lt;= 0 then
&#9;&#9;for i,v in pairs(Parts) do
&#9;&#9;&#9;v.Anchored = false
&#9;&#9;end
&#9;&#9;e = Instance.new(&quot;Explosion&quot;)
&#9;&#9;e.BlastPressure = 0
&#9;&#9;e.Position = Build.Torso.Position
&#9;&#9;e.Parent = Build
&#9;&#9;Build:BreakJoints()
&#9;&#9;wait(3)
&#9;&#9;player = nil
&#9;&#9;for i,v in pairs(game.Players:getChildren()) do
&#9;&#9;&#9;if v.TeamColor == Build.Team.Value then
&#9;&#9;&#9;&#9;player = v
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;if player ~= nil then
&#9;&#9;&#9;for i,v in pairs(Build.RecruitTable:getChildren()) do
&#9;&#9;&#9;&#9;local type = v.Name -- Get the actual name of unit
&#9;&#9;&#9;&#9;for _,obj in pairs(game.Lighting:GetChildren()) do
&#9;&#9;&#9;&#9;&#9;if obj:findFirstChild(&quot;UnitType&quot;) ~= nil then -- check if its a unit
&#9;&#9;&#9;&#9;&#9;&#9;if obj.UnitType.Value == type then -- Is the actual type the same?
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if player:findFirstChild(obj.Name) ~= nil then -- We&apos;re looking at it&apos;s name now
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;player[obj.Name].Value = player[obj.Name].Value-1 -- Found the counter, removing 1.
&#9;&#9;&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;print(&quot;Class not found.&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end&#9;&#9;&#9;
&#9;&#9;Build:remove()
&#9;end
end)


Building = false

function Recruit(Form)
&#9;Building = true
&#9;Time = Form.Value
&#9;Type = Form.Name

&#9;--------------------------------------- BARRACKS CONSTRUCTION REPRESENTATION!!!!!!!!!!!!!
&#9;for i=1,Time do
&#9;&#9;for _=1,144 do
&#9;&#9;&#9;Build.Radar.CFrame = Build.Radar.CFrame*CFrame.Angles(0,math.rad(2.5),0)
&#9;&#9;&#9;wait()
&#9;&#9;end
&#9;end
&#9;Unit = nil
&#9;for i,v in pairs(game.Lighting:GetChildren()) do 
&#9;&#9;if v:findFirstChild(&quot;UnitType&quot;) ~= nil then
&#9;&#9;&#9;if v.UnitType.Value == Type then
&#9;&#9;&#9;&#9;Unit = v
&#9;&#9;&#9;end
&#9;&#9;&#9;print(v.UnitType.Value..&quot; -- &quot;..Type)
&#9;&#9;end
&#9;end
&#9;if Unit == nil then 
&#9;&#9;Form:remove() 
&#9;&#9;print(&quot;Not Found Unit&quot;) 
&#9;&#9;if #Build.RecruitTable:getChildren() &gt;= 1 then
&#9;&#9;&#9;return Recruit(Build.RecruitTable:getChildren()[1]) -- Build next one.
&#9;&#9;end
&#9;end
&#9;New = Unit:clone()
&#9;New.Team.Value = Build.Team.Value
&#9;New.Parent = Workspace
&#9;New:MakeJoints()
&#9;wait()
&#9;New:MoveTo(Build.Torso.Position+Vector3.new(math.random(-5,5)*2,New.Height.Value,math.random(-5,5)*2))
&#9;wait()
&#9;if Build.RallyPoint.Value ~= Vector3.new(0,-1000,0) then
&#9;&#9;desired = CFrame.new(Build.Torso.Position,Build.RallyPoint.Value)*CFrame.new(0,0,-5)
&#9;&#9;New:MoveTo(Vector3.new(desired.x,desired.y,desired.z))
&#9;&#9;New.Target.Value = Build.RallyPoint.Value
&#9;end

&#9;Form:remove()
&#9;Building = false
&#9;if #Build.RecruitTable:getChildren() &gt;= 1 then
&#9;&#9;return Recruit(Build.RecruitTable:getChildren()[1]) -- Build next one.
&#9;end
end
&#9;&#9;
&#9;
if Build.Built.Value == false then
&#9;for i,v in pairs(Parts) do
&#9;&#9;v.Transparency = v.Transparency+1
&#9;end
&#9;for i,v in pairs(Parts) do
&#9;&#9;v.CFrame = v.CFrame*CFrame.new(0,5,0)
&#9;&#9;for i=1,10 do
&#9;&#9;&#9;v.CFrame = v.CFrame*CFrame.new(0,-0.5,0)
&#9;&#9;&#9;v.Transparency = v.Transparency-0.1
&#9;&#9;&#9;wait()
&#9;&#9;end
&#9;&#9;v.Transparency = Trans[i]
&#9;&#9;wait(Build.BuildingTime.Value)
&#9;end
&#9;
&#9;Build.RecruitTable.ChildAdded:connect(function(c)
&#9;&#9;if Building == false then
&#9;&#9;&#9;Recruit(c)
&#9;&#9;end
&#9;end)
&#9;Build.Built.Value = true
&#9;s = Instance.new(&quot;Sparkles&quot;)
&#9;s.Parent = Build.Torso
&#9;if Build.Worker.Value ~= nil then
&#9;&#9;Build.Worker.Value.Parent.Torso.Anchored = false
&#9;&#9;Build.Worker.Value.Parent:MoveTo(Build.Torso.Position+Vector3.new(math.random(10,15)*((math.random(0,1)*2)-1),1.75,math.random(10,15)*((math.random(0,1)*2)-1)))
&#9;end
&#9;wait(2)
&#9;s:remove()
end 
</ProtectedString>
