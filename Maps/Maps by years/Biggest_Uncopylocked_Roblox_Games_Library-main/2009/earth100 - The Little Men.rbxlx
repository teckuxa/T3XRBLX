				<Item class="LocalScript" referent="RBX7388">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">ToolHandler</string>
						<ProtectedString name="Source">bin = script.Parent
mouse = nil
player = nil

MouseStatus = &quot;Up&quot;
Dragging = false
LastMousePos = Vector3.new(0,0,0)

SelBox = Instance.new(&quot;Part&quot;) -- used to show box selection
SelBox.formFactor = 2
SelBox.Transparency = 1
SelBox.TopSurface = 0
SelBox.BottomSurface = 0
SelBox.Size = Vector3.new(1,1,1)
SelBox.Name = &quot;Selection&quot;
SelBox.CanCollide = false
SelBox.Anchored = true
SelBox.Parent = Workspace.CurrentCamera

function alreadySelected(object) -- checks to see if an object is already selected
&#9;for _, v in pairs(player.Selection:getChildren()) do
&#9;&#9;if v.Value.Parent == object then
&#9;&#9;&#9;return true
&#9;&#9;end
&#9;end
&#9;return false
end


function CheckInside(Container,Part) -- checks to see if an object is within the container&apos;s x and y dimensions
&#9;Lowerxz = Vector2.new(Container.Position.x-Container.Size.x/2,Container.Position.z-Container.Size.z/2)
&#9;Upperxz = Vector2.new(Container.Position.x+Container.Size.x/2,Container.Position.z+Container.Size.z/2)
&#9;PartPos = Vector2.new(Part.Position.x,Part.Position.z)
&#9;return (PartPos.x&gt;Lowerxz.x and PartPos.x &lt; Upperxz.x) and (PartPos.y&gt;Lowerxz.y and PartPos.y&lt; Upperxz.y)
end

function setUp(mouse)

&#9;mouse = mouse
&#9;player = game.Players.LocalPlayer
&#9;if player:findFirstChild(&quot;PlayerGui&quot;)~= nil and player.PlayerGui.GameGui:findFirstChild(&quot;Blocker&quot;) ~= nil then
&#9;&#9;player.PlayerGui.GameGui.Blocker:remove()
&#9;end
&#9;mouse.Button1Down:connect(function()
&#9;&#9;MouseStatus = &quot;Down&quot;
&#9;&#9;LastMousePos = mouse.Hit
&#9;end)
&#9;mouse.Move:connect(function()
&#9;&#9;if MouseStatus == &quot;Down&quot; then
&#9;&#9;&#9;wait(0.1)
&#9;&#9;&#9;if MouseStatus ~= &quot;Down&quot; then return end -- Yep you&apos;re dragging.
&#9;&#9;&#9;Dragging = true
&#9;&#9;&#9;local Current = CFrame.new(mouse.Hit.x,0,mouse.Hit.z)
&#9;&#9;&#9;local Last = CFrame.new(LastMousePos.x,0,LastMousePos.z)
&#9;&#9;&#9;if math.abs(Current.x-Last.x) &lt;1 or math.abs(Current.z-Last.z) &lt;1 then return end
&#9;&#9;&#9;Sizex = math.ceil(math.abs(Current.x-Last.x))
&#9;&#9;&#9;Sizez = math.ceil(math.abs(Current.z-Last.z))
&#9;&#9;&#9;Position = CFrame.new(Last.x+math.ceil(Current.x-Last.x)/2,LastMousePos.y+0.25,Last.z+math.ceil(Current.z-Last.z)/2)
&#9;&#9;&#9;SelBox.Size = Vector3.new(Sizex,1,Sizez)
&#9;&#9;&#9;SelBox.CFrame = Position
&#9;&#9;&#9;SelBox.Transparency = 0.5
&#9;&#9;end
&#9;end)

&#9;mouse.Button1Up:connect(function()
&#9;&#9;MouseStatus = &quot;Up&quot;
&#9;&#9;if Dragging == true then
&#9;&#9;&#9;for i,v in pairs(Workspace:getChildren()) do
&#9;&#9;&#9;&#9;if v:findFirstChild(&quot;Team&quot;) ~= nil and v.Team.Value == player.TeamColor and v.Class.Value == &quot;Unit&quot; and v:findFirstChild(&quot;Torso&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;if CheckInside(SelBox,v.Torso) == true and alreadySelected(v) == false then
&#9;&#9;&#9;&#9;&#9;&#9;marker = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;marker.Value = v:GetChildren()[1]
&#9;&#9;&#9;&#9;&#9;&#9;marker.Parent = player.Selection
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;SelBox.Transparency = 1
&#9;&#9;&#9;SelBox.Size = Vector3.new(1,1,1)
&#9;&#9;end
&#9;end)

&#9;mouse.Button1Down:connect(function()
&#9;&#9;obj = mouse.Target.Parent
&#9;&#9;selecting = false
&#9;&#9;if obj:findFirstChild(&quot;Team&quot;) ~= nil then
&#9;&#9;&#9;if obj.Team.Value == player.TeamColor and alreadySelected(obj) == false then -- add it to the selection!
&#9;&#9;&#9;&#9;selecting = true
&#9;&#9;&#9;&#9;marker = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;&#9;&#9;marker.Value = obj:GetChildren()[1]
&#9;&#9;&#9;&#9;marker.Parent = player.Selection
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;if selecting == true then return end -- less confusion

&#9;&#9;command = player.Command.Value
&#9;&#9;if command == &quot;Move&quot; then
&#9;&#9;&#9;hit = mouse.Hit
&#9;&#9;&#9;for _,x in pairs(player.Selection:getChildren()) do
&#9;&#9;&#9;&#9;v = x.Value.Parent
&#9;&#9;&#9;&#9;if v:findFirstChild(&quot;Target&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;v.Target.Value = Vector3.new(hit.x,hit.y,hit.z)
&#9;&#9;&#9;&#9;end&#9;
&#9;&#9;&#9;end
&#9;&#9;elseif command == &quot;Attack&quot; then
&#9;&#9;&#9;-- Modifications needed to this
&#9;&#9;&#9;hit = mouse.Hit
&#9;&#9;&#9;for _,x in pairs(player.Selection:getChildren()) do
&#9;&#9;&#9;&#9;v = x.Value.Parent
&#9;&#9;&#9;&#9;if v:findFirstChild(&quot;Target&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;v.OnAlert.Value = true
&#9;&#9;&#9;&#9;&#9;v.Target.Value = Vector3.new(hit.x,hit.y,hit.z)
&#9;&#9;&#9;&#9;end&#9;
&#9;&#9;&#9;end
&#9;&#9;elseif command == &quot;SetRally&quot; then
&#9;&#9;&#9;for _,x in pairs(player.Selection:getChildren()) do
&#9;&#9;&#9;&#9;v = x.Value.Parent
&#9;&#9;&#9;&#9;if v:findFirstChild(&quot;RallyPoint&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;v.RallyPoint.Value = Vector3.new(hit.x,hit.y,hit.z)
&#9;&#9;&#9;&#9;end&#9;
&#9;&#9;&#9;end
&#9;&#9;else
&#9;&#9;&#9; -- default action :D is move
&#9;&#9;&#9;hit = mouse.Hit
&#9;&#9;&#9;target = mouse.Target
&#9;&#9;&#9;attack = false
&#9;&#9;&#9;if target.Parent:findFirstChild(&quot;Team&quot;) ~= nil and target.Parent.Team.Value ~= player.TeamColor then
&#9;&#9;&#9;&#9;attack = true
&#9;&#9;&#9;end
&#9;&#9;&#9;for _,x in pairs(player.Selection:getChildren()) do
&#9;&#9;&#9;&#9;v = x.Value.Parent
&#9;&#9;&#9;&#9;if v:findFirstChild(&quot;Target&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;v.Target.Value = Vector3.new(hit.x,hit.y,hit.z)
&#9;&#9;&#9;&#9;end&#9;
&#9;&#9;&#9;&#9;if v:findFirstChild(&quot;OnAlert&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;v.OnAlert.Value = attack
&#9;&#9;&#9;&#9;end&#9;
&#9;&#9;&#9;end
&#9;&#9;end

&#9;&#9;player.Command.Value = &quot;&quot; -- clear out old commands
&#9;end)
&#9;


&#9;mouse.KeyDown:connect(function(key)
&#9;&#9;if string.lower(key) == &quot;t&quot; then -- t is clear selection.
&#9;&#9;&#9;for _,v in pairs(player.Selection:getChildren()) do
&#9;&#9;&#9;&#9;v:remove()
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end)
&#9;bin.Parent = game.Players.LocalPlayer.PlayerGui
end


bin.Selected:connect(setUp)</ProtectedString>
					</Properties>
				</Item>
			</Item>
		</Item>
