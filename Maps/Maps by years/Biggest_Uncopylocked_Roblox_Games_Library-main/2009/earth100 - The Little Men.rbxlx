&#9;BM.Value = 5
&#9;BM.Parent = p

&#9;local D = Instance.new(&quot;StringValue&quot;)
&#9;D.Name = &quot;Doctrine&quot;
&#9;D.Value = &quot;None&quot;
&#9;D.Parent = p
&#9;


&#9;local Tech = script.Technology:clone()
&#9;Tech.Parent = p

&#9;Tech[&quot;Mine Number&quot;].Changed:connect(function(Val)
&#9;&#9;p.WallMax.Value = 5+Val
&#9;end)

&#9;Tech.SoldierStrength.Changed:connect(function(Val)
&#9;&#9;for i,v in pairs(game.Workspace:getChildren()) do
&#9;&#9;&#9;if v.Name == &quot;Soldier&quot; and v.Team.Value == p.TeamColor then
&#9;&#9;&#9;&#9;v.TechStrength.Value = Val/10
&#9;&#9;&#9;&#9;v.DamageMultiplier.Value = 1+v.DoctrineStrength.Value+v.TechStrength.Value
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end)
&#9;Tech.VehicleStrength.Changed:connect(function(Val)
&#9;&#9;for i,v in pairs(game.Workspace:getChildren()) do
&#9;&#9;&#9;if v.Name == &quot;Vehicle&quot; and v.Team.Value == p.TeamColor then
&#9;&#9;&#9;&#9;v.TechStrength.Value = Val/10
&#9;&#9;&#9;&#9;v.DamageMultiplier.Value = 1+v.DoctrineStrength.Value+v.TechStrength.Value
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end)
&#9;Tech.AirStrength.Changed:connect(function(Val)
&#9;&#9;for i,v in pairs(game.Workspace:getChildren()) do
&#9;&#9;&#9;if v.Name == &quot;Air&quot; and v.Team.Value == p.TeamColor then
&#9;&#9;&#9;&#9;v.TechStrength.Value = Val/10
&#9;&#9;&#9;&#9;v.DamageMultiplier.Value = 1+v.DoctrineStrength.Value+v.TechStrength.Value
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end)

&#9;Tech[&quot;Mine Range&quot;].Changed:connect(function(Val)
&#9;&#9;for i,v in pairs(game.Workspace:getChildren()) do
&#9;&#9;&#9;if v.Name == &quot;Wall&quot; and v.Team.Value == p.TeamColor then
&#9;&#9;&#9;&#9;v.Range.Value = 4+(2*Val)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end)

&#9;Tech[&quot;Soldier Speed&quot;].Changed:connect(function(Val)
&#9;&#9;for i,v in pairs(game.Workspace:getChildren()) do
&#9;&#9;&#9;if v.Name == &quot;Soldier&quot; and v.Team.Value == p.TeamColor then
&#9;&#9;&#9;&#9;v.SpeedMultiplier.Value = 1+Val/10&#9;&#9;&#9;
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end)
&#9;Tech[&quot;Vehicle Speed&quot;].Changed:connect(function(Val)
&#9;&#9;for i,v in pairs(game.Workspace:getChildren()) do
&#9;&#9;&#9;if v.Name == &quot;Vehicle&quot; and v.Team.Value == p.TeamColor then
&#9;&#9;&#9;&#9;v.SpeedMultiplier.Value = 1+Val/10
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end)
&#9;Tech[&quot;Air Speed&quot;].Changed:connect(function(Val)
&#9;&#9;for i,v in pairs(game.Workspace:getChildren()) do
&#9;&#9;&#9;if v.Name == &quot;Air&quot; and v.Team.Value == p.TeamColor then
&#9;&#9;&#9;&#9;v.SpeedMultiplier.Value = 1+Val/10
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end)



&#9;D.Changed:connect(function(Value)
&#9;&#9;if Value == &quot;Soldier&quot; then
&#9;&#9;&#9;p.SoldierMax.Value = 15
&#9;&#9;elseif Value == &quot;Vehicle&quot; then
&#9;&#9;&#9;p.VehicleMax.Value = 10
