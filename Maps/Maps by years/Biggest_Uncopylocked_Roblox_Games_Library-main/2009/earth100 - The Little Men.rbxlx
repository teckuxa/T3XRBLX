						<string name="Name">ChatHandler</string>
						<ProtectedString name="Source">bin = script.Parent
chat = bin.Chat:clone()
script.Name = &quot;ChatHandler&quot;


sizeper = 20
across = 28

function pushGui(amnt) -- pushes all chat up by amnt and clears out those above it.
&#9;for index,v in pairs(bin:getChildren()) do
&#9;&#9;if v.Name == &quot;Chat&quot; then
&#9;&#9;&#9;v.Position = v.Position+UDim2.new(0,0,0,-1*amnt) -- up that amount
&#9;&#9;&#9;if v.Position.Y.Offset*-1 &gt; bin.Size.Y.Offset then
&#9;&#9;&#9;&#9;v:remove()
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

function AddChat(player,text)
&#9;text = player.Name..&quot;: &quot;..string.sub(text,1,(across*3)-#player.Name-2)
&#9;local newC = chat:clone()
&#9;newC.Text = text -- max three rows.
&#9;length = sizeper*(math.ceil(#text/across))
&#9;newC.Size = UDim2.new(1,0,0,length)
&#9;newC.Position = UDim2.new(0,0,1,-1*length)
&#9;pushGui(length)
&#9;newC.Visible = true
&#9;newC.BackgroundColor3 = Color3.new(player.TeamColor.r,player.TeamColor.g,player.TeamColor.b)

&#9;newC.Parent = bin
end

for _,v in pairs(game.Players:GetChildren()) do
&#9;local v = v
&#9;v.Chatted:connect(function(c)
&#9;&#9;AddChat(v,c)
&#9;end)
end

game.Players.PlayerAdded:connect(function(p)
&#9;local p = p
&#9;p.Chatted:connect(function(c)
&#9;&#9;AddChat(p,c)
&#9;end)
end)



