						<ProtectedString name="Source">bin = script.Parent

images = {
&#9;&quot;http://www.roblox.com/asset/?id=53111361&quot;,
&#9;&quot;http://www.roblox.com/asset/?id=53111848&quot;, -- select this
&#9;&quot;http://www.roblox.com/asset/?id=53111399&quot;, -- expl of gui
&#9;&quot;http://www.roblox.com/asset/?id=53111416&quot;,
&#9;&quot;http://www.roblox.com/asset/?id=53111428&quot;,-- soldier selection
&#9;&quot;http://www.roblox.com/asset/?id=53111443&quot;,
&#9;&quot;http://www.roblox.com/asset/?id=53111879&quot;,
&#9;&quot;http://www.roblox.com/asset/?id=53111892&quot;,
&#9;&quot;http://www.roblox.com/asset/?id=53111905&quot;,
&#9;&quot;http://www.roblox.com/asset/?id=53111909&quot;,
&#9;&quot;http://www.roblox.com/asset/?id=53111919&quot;,
&#9;&quot;http://www.roblox.com/asset/?id=53111929&quot;,
&#9;&quot;http://www.roblox.com/asset/?id=53111946&quot;,
&#9;&quot;http://www.roblox.com/asset/?id=53111958&quot;,
&#9;&quot;http://www.roblox.com/asset/?id=53111971&quot;, -- bulding rax
&#9;&quot;http://www.roblox.com/asset/?id=53111991&quot;, -- steamplant1
&#9;&quot;http://www.roblox.com/asset/?id=53112008&quot;, -- steam plant built
&#9;&quot;http://www.roblox.com/asset/?id=53112018&quot;, -- moving units
&#9;&quot;http://www.roblox.com/asset/?id=53112041&quot;, -- attacking
&#9;&quot;http://www.roblox.com/asset/?id=53112060&quot; -- building damage
}

point = 1

bin.Close.MouseButton1Up:connect(function()
&#9;bin.Visible = false
&#9;bin.Parent.Menu.Visible = true
end)

bin.Next.MouseButton1Up:connect(function()
&#9;if point+1 &gt; #images then return end
&#9;point = point+1
&#9;bin.Image.Image = images[point]

&#9;bin.Last.Visible = true
&#9;if point == #images then
&#9;&#9;bin.Next.Visible = false
&#9;end
end)

bin.Last.MouseButton1Up:connect(function()
&#9;if point-1 &lt; 1 then return end
&#9;point = point-1
&#9;bin.Image.Image = images[point]

&#9;bin.Next.Visible = true
&#9;if point == 1 then
&#9;&#9;bin.Last.Visible = false
&#9;end 
end)</ProtectedString>
