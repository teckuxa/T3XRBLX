					<Item class="Script" referent="RBX218">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">GameMenu</string>
							<ProtectedString name="Source">sys = script.Parent
help = sys.Parent.Help

moving = false
last = &quot;up&quot;
-- Close and open connections:
sys.Close.MouseButton1Up:connect(function() -- close
&#9;if last == &quot;up&quot; then return end
&#9;if moving == true then return end
&#9;last = &quot;up&quot;
&#9;moving = true
&#9;for i=0.5,-0.5,-0.1 do
&#9;&#9;sys.Position = sys.Position+UDim2.new(0,0,-0.1,0)
&#9;&#9;wait()
&#9;end
&#9;moving = false
end)

sys.Parent.Menu.MouseButton1Up:connect(function() -- open
&#9;if last == &quot;down&quot; then return end
&#9;if moving == true then return end
&#9;last = &quot;down&quot;
&#9;moving = true
&#9;for i=-0.5,0.5,0.1 do
&#9;&#9;sys.Position = sys.Position+UDim2.new(0,0,0.1,0)
&#9;&#9;wait()
&#9;end
&#9;moving = false
end)

sys.Instructions.MouseButton1Up:connect(function()
&#9;help.Position = UDim2.new(0.5, -200, 0.5, -200)
end)</ProtectedString>
