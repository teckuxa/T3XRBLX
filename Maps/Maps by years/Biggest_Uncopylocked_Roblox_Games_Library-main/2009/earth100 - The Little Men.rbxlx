&#9;ResearchCenter = &quot;http://www.roblox.com/asset/?id=52122090&quot;,
&#9;RepairBay = &quot;http://www.roblox.com/asset/?id=52122078&quot;,
&#9;Barracks = &quot;http://www.roblox.com/asset/?id=52122072&quot;,
&#9;HeavyTurret = &quot;http://www.roblox.com/asset/?id=52122059&quot;,
&#9;HeavyCopter = &quot;http://www.roblox.com/asset/?id=52122044&quot;,
&#9;Artillery = &quot;http://www.roblox.com/asset/?id=52122011&quot;,
