							<string name="Name">BuildMenuScript</string>
							<ProtectedString name="Source">script.Parent.Yes.MouseButton1Up:connect(function()
&#9;Model = script.Parent.Selection.Value.Parent
&#9;if Model == nil or Model.Parent == nil then return end
&#9;for i,v in pairs(game.Players:getChildren()) do
&#9;&#9;if v.TeamColor == Model.Team.Value then
&#9;&#9;&#9;v.Money.Value = v.Money.Value + math.ceil(game.Lighting[Model.Name].Cost.Value*0.2)
&#9;&#9;end
&#9;end
&#9;Model.Health.Value = -10
&#9;script.Parent.Visible = false
end)

