bf:remove()
end end end end end end

if string.sub(msg,1,7) == &quot;unlock/&quot; then
local player = findplayer(string.sub(msg,8),speaker)
if player ~= 0 then
for i = 1,#player do
if player[i].Character ~= nil then
local c = player[i].Character:GetChildren()
