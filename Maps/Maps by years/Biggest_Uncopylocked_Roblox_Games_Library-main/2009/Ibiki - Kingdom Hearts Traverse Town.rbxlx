						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">function click()
if script.Parent.Parent.Parent:findFirstChild(&quot;Tutorial.&quot;) ~= nil then
script.Parent.Parent.Parent:findFirstChild(&quot;Tutorial.&quot;):remove()
script.Tutorialized.Value = script.Tutorialized.Value + 1
script.Parent.Parent.Parent.Parent:WaitForDataReady()
script.Parent.Parent.Parent.Parent:SaveNumber(&quot;Tutor&quot;, script.Tutorialized.Value)
else
end
end
script.Parent.Category1.MouseButton1Down:connect(click)
script.Parent.Category2.MouseButton1Down:connect(click)
script.Parent.Category3.MouseButton1Down:connect(click)
script.Parent.Category4.MouseButton1Down:connect(click)
script.Parent.Category5.MouseButton1Down:connect(click)
script.Parent.Category6.MouseButton1Down:connect(click)</ProtectedString>
