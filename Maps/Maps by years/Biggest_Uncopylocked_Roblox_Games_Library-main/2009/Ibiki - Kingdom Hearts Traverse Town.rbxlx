			<Item class="Script" referent="RBX181">
				<Properties>
					<bool name="Archivable">true</bool>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">spawn = script.Parent

while true do
p = Instance.new(&quot;Part&quot;)
p.Size = Vector3.new(1,1,1)
p.BrickColor = BrickColor.()
p.formFactor = 2
p.TopSurface = 0
p.Locked = true
p.BottomSurface = 0
p.Transparency = 0
p.CanCollide = false
c=script.P:clone()
c.Parent = p
c.Disabled = false
p.Name = &quot;Snowflake&quot;
p.CFrame = spawn.CFrame + Vector3.new(math.random(-60,60),0,math.random(-60,60))
p.Parent = game.Workspace
v = Instance.new(&quot;BodyVelocity&quot;)
v.maxForce = Vector3.new(math.huge,math.huge,math.huge)
v.velocity = Vector3.new(math.random(-2,2),math.random(-10,-2),math.random(-2,2))
v.Parent = p
a = Instance.new(&quot;BodyAngularVelocity&quot;)
a.angularvelocity = Vector3.new(math.random(-5,5),math.random(-5,5),math.random(-5,5))
a.Parent = p
wait(0.4)
end
</ProtectedString>
				</Properties>
				<Item class="Script" referent="RBX182">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">P</string>
						<ProtectedString name="Source">function Touch(hit)
if hit.Name == &quot;Roof&quot; or &quot;Wall&quot; or &quot;Base&quot;then 
script.Parent:remove()
end
end
script.Parent.Touched:connect(Touch)</ProtectedString>
					</Properties>
				</Item>
