								<string name="Name">Script</string>
								<ProtectedString name="Source">local a = game.Workspace.CharTele:GetChildren()
local Me = script.Parent.Parent.Parent.Parent.Parent.Parent.Character
local Weapon = game.Lighting:findFirstChild(&quot;Sitar&quot;):clone()
local Weapon2 = game.Lighting:findFirstChild(&quot;Run (50)&quot;):clone()
function Click(mouse)
if Me:findFirstChild(&quot;Humanoid&quot;)~=nil then
if Me:findFirstChild(&quot;Pants&quot;) ~= nil then
Me.Pants:remove()
end
if Me:findFirstChild(&quot;Shirt&quot;) ~= nil then
Me.Shirt:remove()
end
z=Instance.new(&quot;Pants&quot;)
x=Instance.new(&quot;Shirt&quot;)
x.Parent = Me
z.Parent = Me
x.ShirtTemplate = &quot;http://www.roblox.com/asset/?id=24470162&quot;
z.PantsTemplate = &quot;http://www.roblox.com/asset/?id=24470191&quot;
Weapon.Parent = script.Parent.Parent.Parent.Parent.Parent.Parent.Backpack
Weapon2.Parent = script.Parent.Parent.Parent.Parent.Parent.Parent.Backpack
script.Parent.Parent.Parent.Parent.Parent.Characterinfo:remove()
m = a[math.random(1, #a)]
Me.Torso.CFrame = m.CFrame
script.Parent.Parent.Parent.Parent:remove()
end
end
script.Parent.MouseButton1Down:connect(Click)


script.Parent.MouseEnter:connect(function(mouse) 
script.Parent.Parent.Parent.Parent.Parent.Characterinfo.Frame.Charpic.Image = &quot;http://www.roblox.com/asset/?id=33136030&quot;
