								<ProtectedString name="Source">local a = game.Workspace.CharTele:GetChildren()
local Me = script.Parent.Parent.Parent.Parent.Parent.Parent.Character
local Weapon = game.Lighting:findFirstChild(&quot;Dice&quot;):clone()
