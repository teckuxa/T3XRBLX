				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Script</string>
				<ProtectedString name="Source">function onEnt(Peopleders)

Peopleders:WaitForDataReady()
a=game.Lighting:findFirstChild(&quot;Tutorial.&quot;):clone()

z=Peopleders:LoadNumber(&quot;Tutor&quot;)
if z ~= 0 then
else
a.Parent = Peopleders.PlayerGui

end
end
game.Players.PlayerAdded:connect(onEnt)</ProtectedString>
