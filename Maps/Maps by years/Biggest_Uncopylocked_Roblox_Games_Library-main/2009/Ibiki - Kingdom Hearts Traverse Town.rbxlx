		<Item class="Script" referent="RBX205">
			<Properties>
				<bool name="Archivable">true</bool>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">ONENTER LOAD</string>
				<ProtectedString name="Source">function onPlayerEntered(newPlayer)
	while true do
		if newPlayer.Character:findFirstChild(&quot;Head&quot;)~=nil then break end
		wait()
	end
	local c = game.Lighting.Load:Clone()
	c.Parent = newPlayer.PlayerGui

end 

game.Players.PlayerAdded:connect(onPlayerEntered)</ProtectedString>
			</Properties>
		</Item>
