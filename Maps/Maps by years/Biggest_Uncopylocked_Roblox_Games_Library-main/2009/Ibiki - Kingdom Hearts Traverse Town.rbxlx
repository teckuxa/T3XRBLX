						<string name="Name">Script</string>
						<ProtectedString name="Source">fireTrue = false

function onTouched(hit)
	find = hit:FindFirstChild(&quot;Fire&quot;)
	if (find ~= nil) then
		fireTrue = true
	end
	if (fireTrue == false) then
		if (hit.Name ~= &quot;Base&quot;) then
			F = Instance.new(&quot;Fire&quot;)
			F.Parent = hit
			script:Clone().Parent = hit
			script.Parent.Deteriate:Clone().Parent = hit
		end
	end
	fireTrue = false
end

script.Parent.Touched:connect(onTouched)

-- Created by catcorn2</ProtectedString>
