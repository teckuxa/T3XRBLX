							<string name="Name">Script</string>
							<ProtectedString name="Source">function onButtonClicked()
if script.Parent.Parent.credits.Position == UDim2.new(-1.70000005,0,0.600000024,0) then
for i = 1,19 do
script.Parent.Parent.credits.Position = script.Parent.Parent.credits.Position + UDim2.new(0.1,0,0,0)
wait(0.1)
end
elseif script.Parent.Parent.credits.Position == UDim2.new(0.200000197,0,0.600000024,0) then
for i = 1,19 do
script.Parent.Parent.credits.Position = script.Parent.Parent.credits.Position + UDim2.new(-0.1,0,0,0)
wait(0.1)
end
end
end
script.Parent.MouseButton1Click:connect(onButtonClicked)</ProtectedString>
