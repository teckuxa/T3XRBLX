			<Item class="Script" referent="RBX8054">
				<Properties>
					<bool name="Archivable">true</bool>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">HeadShot</string>
					<ProtectedString name="Source">damage = 50
local headshot = Instance.new(&quot;Sound&quot;)
headshot.SoundId = &quot;a486994e6ff9237acd5c540e45cbe8d5&quot;
headshot.Parent = script.Parent
headshot.Volume = .5
game:GetService(&quot;Debris&quot;):AddItem(script.Parent, 8)
function onTouched(hit)
if (hit.Name==&quot;CrossbowBolt&quot;) then return end 
if (hit.Name==&quot;Head&quot;) then
if hit.Parent:findFirstChild(&quot;Humanoid&quot;)~=nil then
headshot:play()
hit.Parent[&quot;Humanoid&quot;]:TakeDamage(damage)
end
end
wait()script.Parent:remove()
end
script.Parent.Touched:connect(onTouched)</ProtectedString>
