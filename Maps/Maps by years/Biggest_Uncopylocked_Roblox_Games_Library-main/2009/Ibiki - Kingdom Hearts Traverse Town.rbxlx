			<Item class="Script" referent="RBX8102">
				<Properties>
					<bool name="Archivable">true</bool>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Fire</string>
					<ProtectedString name="Source">local Tool = script.Parent -- The Tool

enabled = true -- Debouncer

function fire(v) -- The Fun Part

	local vCharacter = Tool.Parent -- The Player&apos;s Model
	local vPlayer = game.Players:playerFromCharacter(vCharacter) -- Find the player in the players section
	local Torso = vCharacter.Torso -- Find the Player&apos;s Torso

	Tool.Handle.Fire:play()
        

	local spawnPos = Torso.Position -- Where to spawn the Bullet
	


	spawnPos  = spawnPos + (v * 8) -- Move the bullet so it doesn&apos;t hit the gun itself or the Player firing

	local missile = Instance.new(&quot;Part&quot;) -- Make a new bullet

	missile.Position = spawnPos -- Move the bullet to the spawn location
	missile.Size = Vector3.new(1,1,1) -- Size of Bullet
	missile.Velocity = v * 200 -- Speed of the Bullet ( 200 is a decent speed so the touched events can be picked up
	missile.BrickColor = BrickColor.new(&quot;Bright red&quot;) -- Color of the Bullet
	missile.Shape = &quot;Ball&quot; -- Shape of the Bullet
	missile.BottomSurface = &quot;Smooth&quot; -- Top surface of the bullet
	missile.TopSurface = &quot;Smooth&quot; -- Bottom Surface of the bullet
	missile.Name = &quot;Bullet&quot; -- Name of the bullet
	missile.Elasticity = 0 -- Bouncyness of the bullet
	missile.Reflectance = 0 -- Reflectance of the bullet
	missile.Friction = .9 -- Friction of the bullet
	missile.Parent = game.Workspace -- bullet&apos;s Parent

	local DmgScript = script.Parent.BulletDamage:Clone() -- The damage script clone
	DmgScript.Disabled = false --Enable the clone of it
	DmgScript.Parent = missile --Put it into the bullet

	local Delay = script.Parent.DelayedRemover:Clone() --The timed remover script clone
	Delay.Disabled = false --Enable the clone of it
	Delay.Parent = missile -- Put it into the bullet

	local force = Instance.new(&quot;BodyForce&quot;) -- Adds more force to the bullet to give it its height
	force.force = Vector3.new(0,100,0) -- 100 is perfect. its a mostly straight shot
	force.Parent = missile -- Put the force into the bullet

end -- close the function

function onActivate() -- When you click to use it...
	if enabled == true then -- check to see if you can use it
		enabled = false --disable it to &quot;reload&quot;

		local character = Tool.Parent -- The Player&apos;s model
		local humanoid = character.Humanoid -- The Player&apos;s humanoid


		local targetPos = humanoid.TargetPoint -- Find where the humanoid is targeting
		local lookAt = (targetPos - character.Head.Position).unit -- Find where the humanoid is targeting

		fire(lookAt) -- Run the fire function with the value from lookAt replacing v

		wait(2) -- wait 2 seconds
		enabled = true -- renable it
	end -- End the if

end -- end the function

script.Parent.Activated:connect(onActivate) -- the connection

-- Hope you understand the gun a little more! --

--~~~~~robotic321~~~~~~

--CODE = 3DRU73Z &lt;----- DO NOT REMOVE. IT IS VITAL</ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX8103">
				<Properties>
					<bool name="Archivable">true</bool>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">DelayedRemover</string>
					<ProtectedString name="Source">wait(30) -- After 30 seconds....
script.Parent:Remove() -- remove the bullet

--- This really does nothing but to remove the bullet if it is still in the game

--~~~~~~robotic321~~~~~~--

--CODE = 3DRU73Z --------- DO NOT REMOVE! IT IS VITAL</ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX8104">
				<Properties>
					<bool name="Archivable">true</bool>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">BulletDamage</string>
					<ProtectedString name="Source">local ToLookFor = &quot;Humanoid&quot; -- If you want it to damage something other than Players
local Damage = 25 -- Amount of damage to do

function OnTouched(hit) -- When the bullet is touched...
	local h = hit.Parent:findFirstChild(ToLookFor) -- find ToLookFor in the thing that was hit
	if h ~= nil then -- If it is there...
		h.Health = h.Health - Damage -- Deal damage
		script.Parent:Remove() -- remove the bullet
	end --end the if
	if h == nil then -- if there is no ToLookFor in the thing that was hit....
		script.Parent:Remove() -- remove the bullet
	end -- end the if
end -- end the function

script.Parent.Touched:connect(OnTouched) -- Connect the OnTouched function to the bullet.

-- Hope you understand the bullet script a little now. 

--~~~~~~ robotic321 ~~~~~~-- 

--CODE = 3DRU73Z ------------DO NOT REMOVE! IT IS VITAL</ProtectedString>
