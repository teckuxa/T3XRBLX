							<ProtectedString name="Source">local L = script.Parent.Parent.Parent.Lives
local Pro = script.Parent.Parent.Parent.Progression
local L1 = script.Parent.Life1
local L2 = script.Parent.Life2
local L3 = script.Parent.Life3

L.Changed:connect(function()
&#9;if L.Value == 3 then
&#9;&#9;L1.Visible = true
&#9;&#9;L2.Visible = true
&#9;&#9;L3.Visible = true

&#9;&#9;else if L.Value == 2 then
&#9;&#9;&#9;L1.Visible = true
&#9;&#9;&#9;L2.Visible = true
&#9;&#9;&#9;L3.Visible = false

&#9;&#9;&#9;else if L.Value == 1 then
&#9;&#9;&#9;&#9;L1.Visible = true
&#9;&#9;&#9;&#9;L2.Visible = false
&#9;&#9;&#9;&#9;L3.Visible = false

&#9;&#9;&#9;&#9;else if L.Value &lt;= 0 then
&#9;&#9;&#9;&#9;&#9;local Hum = script.Parent.Parent.Parent.Parent.Parent.Character:findFirstChild(&quot;Humanoid&quot;)
&#9;&#9;&#9;&#9;&#9;L1.Visible = false
&#9;&#9;&#9;&#9;&#9;L2.Visible = false
&#9;&#9;&#9;&#9;&#9;L3.Visible = false
&#9;&#9;&#9;&#9;&#9;Hum.Health = 0
&#9;&#9;&#9;&#9;&#9;--script.Parent.Parent.Failed.Visible = true
&#9;&#9;&#9;&#9;&#9;Pro.Value = 0
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end)

while true do
&#9;wait()
&#9;local Hum = script.Parent.Parent.Parent.Parent.Parent.Character:findFirstChild(&quot;Humanoid&quot;)
&#9;if Hum ~= nil and Hum.Health &lt; 1 then
&#9;&#9;script.Parent.Parent.Failed.Visible = true
&#9;end
end
