							<ProtectedString name="Source">while true do
&#9;wait()
&#9;if script.Parent.Parent.Button.Reflectance &gt; 0 then
&#9;&#9;for i = 1,16 do
&#9;&#9;&#9;script.Parent.CFrame = script.Parent.CFrame * CFrame.new(0, 0.4, 0)
&#9;&#9;&#9;wait(0.05)
&#9;&#9;end 
&#9;&#9;wait(2.7)
&#9;&#9;for i = 1,16 do
&#9;&#9;&#9;script.Parent.CFrame = script.Parent.CFrame * CFrame.new(0, -0.4, 0)
&#9;&#9;&#9;wait(0.05)
&#9;&#9;end 
&#9;end
end
</ProtectedString>
