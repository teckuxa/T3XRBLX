				<Item class="Script" referent="RBX4079">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">player=script.Parent.Parent.Parent.Parent

print(&quot;running...&quot;)

Normal_C=Color3.new(1,1,1)
OOC_C=Color3.new(0,0,1)
RP_C=Color3.new(1,0,0)
NN_C=Color3.new(0,1,0) -- Green
PP_C=Color3.new(0,1,1)
LL_C=Color3.new(1,1,0)
TT_C=Color3.new(1,0,1)

function getM(txt,spk)
mode=&quot;normal&quot;
if txt:sub(1,3)==&quot;/1 &quot; then
mode=&quot;ooc&quot;
elseif txt:sub(1,3)==&quot;/2 &quot; then
mode=&quot;me&quot;
elseif txt:sub(1,3)==&quot;/3 &quot; then
mode=&quot;nn&quot;
elseif txt:sub(1,3)==&quot;/4 &quot; then
mode=&quot;pp&quot;
elseif txt:sub(1,3)==&quot;/5 &quot; then
mode=&quot;ll&quot;
elseif txt:sub(1,3)==&quot;/6 &quot; then
mode=&quot;tt&quot;
end
--------break
if spk:len()&gt;3 then
if mode==&quot;normal&quot; then return spk..&quot;: &quot;..txt,Normal_C
elseif mode==&quot;ooc&quot; then return (&quot;&quot;..spk..&quot;: &quot;..txt:sub(4)..&quot;&quot;),OOC_C
elseif mode==&quot;me&quot; then return &quot;&quot;..spk.. &quot;: &quot; ..txt:sub(4)..&quot;&quot;,RP_C
elseif mode==&quot;nn&quot; then return &quot;&quot;..spk.. &quot;: &quot; ..txt:sub(4)..&quot;&quot;,NN_C
elseif mode==&quot;pp&quot; then return &quot;&quot;..spk.. &quot;: &quot; ..txt:sub(4)..&quot;&quot;,PP_C
elseif mode==&quot;ll&quot; then return &quot;&quot;..spk.. &quot;: &quot; ..txt:sub(4)..&quot;&quot;,LL_C
elseif mode==&quot;tt&quot; then return &quot;&quot;..spk.. &quot;: &quot; ..txt:sub(4)..&quot;&quot;,TT_C
end
end
end

function update_line(raw,thing)
msg=raw.Message1.Value
spkname=raw.Speaker1.Value
newt,newc=getM(msg,spkname)
if newt==nil then return end
if newc==nil then return end
thing.Message1.Text=newt
thing.Message1.TextColor3=newc
end

function update_panel()
update_line(workspace.Chats.Line1,script.Parent.Line1)
update_line(workspace.Chats.Line2,script.Parent.Line2)
update_line(workspace.Chats.Line3,script.Parent.Line3)
update_line(workspace.Chats.Line4,script.Parent.Line4)
update_line(workspace.Chats.Line5,script.Parent.Line5)
update_line(workspace.Chats.Line6,script.Parent.Line6)
update_line(workspace.Chats.Line7,script.Parent.Line7)
end

while true do
update_panel()
wait(.1)
end


