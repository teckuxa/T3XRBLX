					<Item class="Script" referent="RBX2397">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">DetectInteraction</string>
							<ProtectedString name="Source">Xmain = script.Parent.Position.X

function onChanged() 
&#9;if script.Parent.Interact.Value == true then
&#9;&#9;script.Parent.Reflectance = 1
&#9;&#9;script.Parent.CFrame = CFrame.new(Xmain-0.2,script.Parent.Position.Y,script.Parent.Position.Z)
&#9;&#9;wait(3)
&#9;&#9;script.Parent.Ping.Pitch = 3 
&#9;&#9;script.Parent.Ping:Play()
&#9;&#9;script.Parent.Reflectance = 0.7
&#9;&#9;wait(0.2)
&#9;&#9;script.Parent.Ping.Pitch = 2 
&#9;&#9;script.Parent.Ping:Play()
&#9;&#9;script.Parent.Reflectance = 1
&#9;&#9;wait(0.6)
&#9;&#9;script.Parent.Ping.Pitch = 3 
&#9;&#9;script.Parent.Ping:Play()
&#9;&#9;script.Parent.Reflectance = 0.7
&#9;&#9;wait(0.2)
&#9;&#9;script.Parent.Ping.Pitch = 2 
&#9;&#9;script.Parent.Ping:Play()
&#9;&#9;script.Parent.Reflectance = 1
&#9;&#9;wait(0.6)
&#9;&#9;script.Parent.Ping.Pitch = 0.5 
&#9;&#9;script.Parent.Ping:Play()
&#9;&#9;wait(0.2)
&#9;&#9;script.Parent.Reflectance = 0
&#9;&#9;script.Parent.CFrame = CFrame.new(Xmain,script.Parent.Position.Y,script.Parent.Position.Z)
&#9;&#9;script.Parent.Interact.Value = false
&#9;end
end 

script.Parent.Interact.Changed:connect(onChanged) 
</ProtectedString>
						</Properties>
					</Item>
