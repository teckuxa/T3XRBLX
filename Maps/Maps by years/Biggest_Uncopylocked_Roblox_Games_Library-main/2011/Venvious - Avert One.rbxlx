				</Properties>
				<Item class="Script" referent="RBX2327">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Lesson</string>
						<ProtectedString name="Source">while true do
&#9;wait()
&#9;local p = game.Players:GetChildren()
&#9;for i = 1,#p do
&#9;&#9;if p[i].Character ~= nil then
&#9;&#9;&#9;local torso = p[i].Character:findFirstChild(&quot;Torso&quot;)
&#9;&#9;&#9;if torso ~= nil then
&#9;&#9;&#9;&#9;Com = p[i]:findFirstChild(&quot;PlayerGui&quot;):findFirstChild(&quot;ScreenGui&quot;):findFirstChild(&quot;MainInterface&quot;):findFirstChild(&quot;ComPanel&quot;)
&#9;&#9;&#9;&#9;if (p[i].Character.Torso.Position - script.Parent.Position).magnitude &lt; 8 and Com:findFirstChild(&quot;LessonsLearned&quot;).Value &lt; 1 then
&#9;&#9;&#9;&#9;&#9;Com:findFirstChild(&quot;LessonsLearned&quot;).Value = 1
&#9;&#9;&#9;&#9;&#9;LS = script:findFirstChild(&quot;LessonScript&quot;):clone()
&#9;&#9;&#9;&#9;&#9;LS.Parent = Com
&#9;&#9;&#9;&#9;&#9;LS.Disabled = false
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end
&#9;</ProtectedString>
					</Properties>
					<Item class="Script" referent="RBX2328">
						<Properties>
							<bool name="Disabled">true</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">LessonScript</string>
							<ProtectedString name="Source">script.Parent.Parent.Parent.Parent.Parent.Character:findFirstChild(&quot;Humanoid&quot;).WalkSpeed = 0
script.Parent.Parent.Parent.Parent.Parent.Character:findFirstChild(&quot;Torso&quot;).Anchored = true
ComScn = script.Parent

for i = 1,10 do
&#9;ComScn.Size = UDim2.new(0.15625+(0.034375*i), 0, 0.15625+(0.034375*i), 0)
&#9;ComScn.Position = UDim2.new(0+(0.025*i), 0, 0.5-(0.025*i), 0)
&#9;wait()
end
script.Parent.ComImage.Visible = true
script.Parent.ComName.Text = &quot;???:&quot;
script.Parent.ComText.Text = &quot;Incoming communication...&quot;

script.Parent.ComImage.Image = &quot;http://www.roblox.com/asset/?id=73827825&quot;
wait(1)
script.Parent.ComImage.Image = &quot;http://www.roblox.com/asset/?id=73827775&quot;
wait(0.5)
script.Parent.ComImage.Image = &quot;http://www.roblox.com/asset/?id=73827812&quot;
wait(0.5)

script.Parent.ComName.Text = &quot;Mr. Hauteur:&quot;
script.Parent.ComText.Text = &quot;Alright, looks we are going to start simple, just stand on the number 1 opposite of the light.&quot;
time = 0
firstchatdone = false
secondchatdone = false

script.Parent.ComNextButton.MouseButton1Click:connect(function(oc)
&#9;script.Parent.ComNextButton.Visible = false
&#9;time = 0
&#9;if firstchatdone == true and secondchatdone == true then
&#9;&#9;script.Parent.ComText.Text = &quot;&quot;
&#9;&#9;script.Parent.ComName.Text = &quot;&quot;
&#9;&#9;script.Parent.ComImage.Visible = false
&#9;&#9;script.Parent.Parent.Parent.Parent.Parent.Character:findFirstChild(&quot;Humanoid&quot;).WalkSpeed = 16
&#9;&#9;script.Parent.Parent.Parent.Parent.Parent.Character:findFirstChild(&quot;Torso&quot;).Anchored = false
&#9;&#9;for i = 1,10 do
&#9;&#9;&#9;ComScn.Size = UDim2.new(0.5-(0.034375*i), 0, 0.5-(0.034375*i), 0)
&#9;&#9;&#9;ComScn.Position = UDim2.new(0.25-(0.025*i), 0, 0.25+(0.025*i), 0)
&#9;&#9;&#9;wait()
&#9;&#9;end
&#9;&#9;script:remove()

&#9;&#9;else if firstchatdone == false then
&#9;&#9;&#9;script.Parent.ComText.Text = &quot;Then all you need to do is shoot the grapple hook at that number 2 across the ravine.&quot;
&#9;&#9;&#9;firstchatdone = true

&#9;&#9;&#9;else if firstchatdone == true and secondchatdone == false then
&#9;&#9;&#9;&#9;script.Parent.ComText.Text = &quot;Also, it may be good to aim just a little higher than the number, the hook does lob.&quot;
&#9;&#9;&#9;&#9;secondchatdone = true
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end)

while true do
&#9;wait()
&#9;if time &gt;= 5 and script.Parent.ComNextButton.Visible == false then
&#9;&#9;script.Parent.ComNextButton.Visible = true
&#9;end
&#9;script.Parent.ComImage.Image = &quot;http://www.roblox.com/asset/?id=73822001&quot;
&#9;wait(0.1)
&#9;script.Parent.ComImage.Image = &quot;http://www.roblox.com/asset/?id=73822018&quot;
&#9;wait(0.1)
&#9;script.Parent.ComImage.Image = &quot;http://www.roblox.com/asset/?id=73822032&quot;
&#9;wait(0.1)
&#9;time = time+1
end
</ProtectedString>
						</Properties>
					</Item>
				</Item>
			</Item>
		</Item>
