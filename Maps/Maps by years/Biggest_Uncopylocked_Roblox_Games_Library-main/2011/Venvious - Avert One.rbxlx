							<Item class="LocalScript" referent="RBX3598">
								<Properties>
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">LocalScript</string>
									<ProtectedString name="Source">local LLn = script.Parent.Parent.Parent.Parent:findFirstChild(&quot;ScreenGui&quot;):findFirstChild(&quot;MainInterface&quot;):findFirstChild(&quot;ComPanel&quot;):findFirstChild(&quot;LessonsLearned&quot;)
local Hea = script.Parent.Parent.Parent.Parent:findFirstChild(&quot;ScreenGui&quot;):findFirstChild(&quot;Health&quot;)
local Lve = script.Parent.Parent.Parent.Parent:findFirstChild(&quot;ScreenGui&quot;):findFirstChild(&quot;Lives&quot;)
local Pro = script.Parent.Parent.Parent.Parent:findFirstChild(&quot;ScreenGui&quot;):findFirstChild(&quot;Progression&quot;)
local Tor = script.Parent.Parent.Parent.Parent.Parent.Character:findFirstChild(&quot;Torso&quot;)
local Humanoid = script.Parent.Parent.Parent.Parent.Parent.Character:findFirstChild(&quot;Humanoid&quot;)
local Camera = game.Workspace.CurrentCamera

function click()
&#9;script.Parent.Text = &quot;Restarting&quot;
&#9;LLn.Value = 6
&#9;Hea.Value = 6
&#9;Lve.Value = 3
&#9;Pro.Value = 0
&#9;script.Parent.Parent.Parent.MouseLockImage.Active = false
&#9;script.Parent.Parent.Parent.MouseLockImage.Visible = false
&#9;Camera.CameraSubject = Humanoid
&#9;Camera.CameraType = &quot;Custom&quot;
&#9;Humanoid.WalkSpeed = 16
&#9;Tor.CFrame = CFrame.new(game.Workspace:findFirstChild(&quot;CheckPoint0&quot;).Averter.Position)+Vector3.new(0,4,0)
&#9;Tor.Anchored = false
&#9;Camera:findFirstChild(&quot;Message&quot;):remove()
&#9;script.Parent.Parent:remove()
end

script.Parent.MouseButton1Click:connect(click)
</ProtectedString>
								</Properties>
							</Item>
						</Item>
						<Item class="LocalScript" referent="RBX3599">
							<Properties>
								<bool name="Disabled">true</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">LaserScript</string>
								<ProtectedString name="Source">local Enemy = script.Parent.Enemy.Value
local Laser = Enemy.Parent:findFirstChild(&quot;Averter&quot;)

function onTouched(hit)
&#9;if hit.Name == &quot;Right Arm&quot; or hit.Name == &quot;Left Arm&quot; then
&#9;&#9;local Health = game.Players:findFirstChild(hit.Parent.Name..&quot;&quot;):findFirstChild(&quot;PlayerGui&quot;):findFirstChild(&quot;ScreenGui&quot;):findFirstChild(&quot;Health&quot;)
&#9;&#9;if (Health ~= nil) and (hit.Parent:findFirstChild(&quot;Invincible&quot;) == nil) and (hit.Parent:findFirstChild(&quot;Invisible&quot;) == nil) and (script.Parent.Parent.Parent.Parent.Character:findFirstChild(&quot;Torso&quot;).Anchored == false) then
&#9;&#9;&#9;Laser.Transparency = 0.2&#9;
&#9;&#9;&#9;Health.Value = Health.Value - 1
&#9;&#9;&#9;wait(0.2)
&#9;&#9;&#9;Laser.Transparency = 0.7
&#9;&#9;&#9;else if (Health ~= nil) and (hit.Parent:findFirstChild(&quot;Invincible&quot;) ~= nil) and (hit.Parent:findFirstChild(&quot;Invisible&quot;) == nil) then
&#9;&#9;&#9;&#9;Laser.Transparency = 0.2&#9;&#9;
&#9;&#9;&#9;&#9;wait(0.2)
&#9;&#9;&#9;&#9;Laser.Transparency = 0.7
&#9;&#9;&#9;&#9;else if (Health ~= nil) and (hit.Parent:findFirstChild(&quot;Invisible&quot;) ~= nil) then
&#9;&#9;&#9;&#9;&#9;Laser.CanCollide = false&#9;
&#9;&#9;&#9;&#9;&#9;wait(0.3)
&#9;&#9;&#9;&#9;&#9;Laser.CanCollide = true
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

Laser.Touched:connect(onTouched)

while true do
&#9;wait()
&#9;Laser.CFrame = CFrame.new(Laser.Position.X-0.4,Laser.Position.Y,Laser.Position.Z)*CFrame.Angles(0,math.rad(90),0)
end
</ProtectedString>
							</Properties>
						</Item>
						<Item class="LocalScript" referent="RBX3600">
							<Properties>
								<bool name="Disabled">true</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">CloneLaser</string>
								<ProtectedString name="Source">local Enemy = script.Parent.Enemy.Value
local Progress = script.Parent:findFirstChild(&quot;BossProgress&quot;)
local Laser = Enemy.Parent:findFirstChild(&quot;Laser&quot;)

while true do
&#9;wait()
&#9;if Progress.Value &lt; 4 and (script.Parent.Parent.Parent.Parent.Character:findFirstChild(&quot;Torso&quot;).Anchored == false) then
&#9;&#9;wait(1)
&#9;&#9;Beam = Laser.Averter:clone()
&#9;&#9;Beam.Parent = Enemy.Parent
&#9;&#9;script.Parent.LaserScript.Disabled = false
&#9;&#9;wait(10)
&#9;&#9;script.Parent.LaserScript.Disabled = true
&#9;&#9;Beam.Parent = nil
&#9;end
end

</ProtectedString>
							</Properties>
						</Item>
					</Item>
				</Item>
			</Item>
