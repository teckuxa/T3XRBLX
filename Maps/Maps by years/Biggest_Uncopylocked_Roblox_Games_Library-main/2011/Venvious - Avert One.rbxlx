								<string name="Name">DetectInteraction</string>
								<ProtectedString name="Source">local Enemy = script.Parent.Enemy.Value

local Laser = Enemy.Parent:findFirstChild(&quot;Laser&quot;)

local Button1 = game.Workspace:findFirstChild(&quot;BossButons&quot;):findFirstChild(&quot;Button1&quot;):findFirstChild(&quot;Button&quot;)
local Button2 = game.Workspace:findFirstChild(&quot;BossButons&quot;):findFirstChild(&quot;Button2&quot;):findFirstChild(&quot;Button&quot;)
local Button3 = game.Workspace:findFirstChild(&quot;BossButons&quot;):findFirstChild(&quot;Button3&quot;):findFirstChild(&quot;Button&quot;)
local Button4 = game.Workspace:findFirstChild(&quot;BossButons&quot;):findFirstChild(&quot;Button4&quot;):findFirstChild(&quot;Button&quot;)

local Avert1 = Enemy.Parent:findFirstChild(&quot;Button1&quot;):findFirstChild(&quot;Averter&quot;)
local Avert2 = Enemy.Parent:findFirstChild(&quot;Button2&quot;):findFirstChild(&quot;Averter&quot;)
local Avert3 = Enemy.Parent:findFirstChild(&quot;Button3&quot;):findFirstChild(&quot;Averter&quot;)
local Avert4 = Enemy.Parent:findFirstChild(&quot;Button4&quot;):findFirstChild(&quot;Averter&quot;)

local RButton1 = Enemy.Parent:findFirstChild(&quot;Button1&quot;):findFirstChild(&quot;RealButton&quot;)
local RButton2 = Enemy.Parent:findFirstChild(&quot;Button2&quot;):findFirstChild(&quot;RealButton&quot;)
local RButton3 = Enemy.Parent:findFirstChild(&quot;Button3&quot;):findFirstChild(&quot;RealButton&quot;)
local RButton4 = Enemy.Parent:findFirstChild(&quot;Button4&quot;):findFirstChild(&quot;RealButton&quot;)

local Plat1 = Enemy.Parent:findFirstChild(&quot;Power&quot;):findFirstChild(&quot;Power1&quot;)
local Plat2 = Enemy.Parent:findFirstChild(&quot;Power&quot;):findFirstChild(&quot;Power2&quot;)
local Plat3 = Enemy.Parent:findFirstChild(&quot;Power&quot;):findFirstChild(&quot;Power3&quot;)
local Plat4 = Enemy.Parent:findFirstChild(&quot;Power&quot;):findFirstChild(&quot;Power4&quot;)

local Progress = script.Parent:findFirstChild(&quot;BossProgress&quot;)

local Main1 = Enemy.Parent:findFirstChild(&quot;Power&quot;):findFirstChild(&quot;MainPower1&quot;):findFirstChild(&quot;Averter&quot;)
local Main2 = Enemy.Parent:findFirstChild(&quot;Power&quot;):findFirstChild(&quot;MainPower2&quot;):findFirstChild(&quot;Averter&quot;)

local S1 = Enemy.Parent:findFirstChild(&quot;Power&quot;):findFirstChild(&quot;PowerStrip&quot;):findFirstChild(&quot;S1&quot;)
local S2 = Enemy.Parent:findFirstChild(&quot;Power&quot;):findFirstChild(&quot;PowerStrip&quot;):findFirstChild(&quot;S2&quot;)
local S3 = Enemy.Parent:findFirstChild(&quot;Power&quot;):findFirstChild(&quot;PowerStrip&quot;):findFirstChild(&quot;S3&quot;)
local S4 = Enemy.Parent:findFirstChild(&quot;Power&quot;):findFirstChild(&quot;PowerStrip&quot;):findFirstChild(&quot;S4&quot;)

function onChanged1() 
&#9;if Button1:findFirstChild(&quot;Interact&quot;).Value == true and Progress.Value == 0 then
&#9;&#9;Button1:findFirstChild(&quot;Interact&quot;).Value = false
&#9;&#9;RButton1.Reflectance = 1
&#9;&#9;RButton1.CFrame = CFrame.new(RButton1.Position.X+0.2,RButton1.Position.Y,RButton1.Position.Z)

&#9;&#9;Plat1.BrickColor = BrickColor.new(&quot;Lime green&quot;)
&#9;&#9;Main1:findFirstChild(&quot;Mesh&quot;).VertexColor = Vector3.new(0.5, 1, 0)
&#9;&#9;S1.BrickColor = BrickColor.new(&quot;Lime green&quot;)
&#9;&#9;Progress.Value = 1

&#9;&#9;RButton2.CFrame = CFrame.new(RButton2.Position.X,RButton2.Position.Y,RButton2.Position.Z-3) 
&#9;&#9;Avert2.CFrame = CFrame.new(Avert2.Position.X,Avert2.Position.Y,Avert2.Position.Z-3)
&#9;end
end 

function onChanged2() 
&#9;if Button2:findFirstChild(&quot;Interact&quot;).Value == true and Progress.Value == 1 then
&#9;&#9;Button2:findFirstChild(&quot;Interact&quot;).Value = false
&#9;&#9;RButton2.Reflectance = 1
&#9;&#9;RButton2.CFrame = CFrame.new(RButton2.Position.X,RButton2.Position.Y,RButton2.Position.Z+0.2)

&#9;&#9;Plat2.BrickColor = BrickColor.new(&quot;Lime green&quot;)
&#9;&#9;Main1:findFirstChild(&quot;Mesh&quot;).VertexColor = Vector3.new(0, 1, 0)
&#9;&#9;S2.BrickColor = BrickColor.new(&quot;Lime green&quot;)
&#9;&#9;Progress.Value = 2
&#9;end
end 

function onChanged3() 
&#9;if Button3:findFirstChild(&quot;Interact&quot;).Value == true and Progress.Value == 2 then
&#9;&#9;Button3:findFirstChild(&quot;Interact&quot;).Value = false
&#9;&#9;Progress.Value = 3
&#9;&#9;RButton3.Reflectance = 1
&#9;&#9;RButton3.CFrame = CFrame.new(RButton3.Position.X,RButton3.Position.Y,RButton3.Position.Z-0.2)

&#9;&#9;Plat3.BrickColor = BrickColor.new(&quot;Lime green&quot;)
&#9;&#9;Main2:findFirstChild(&quot;Mesh&quot;).VertexColor = Vector3.new(0.5, 1, 0)
&#9;&#9;S3.BrickColor = BrickColor.new(&quot;Lime green&quot;)

&#9;&#9;RButton4.CFrame = CFrame.new(RButton4.Position.X-5,RButton4.Position.Y,RButton4.Position.Z) 
&#9;&#9;Avert4.CFrame = CFrame.new(Avert4.Position.X-5,Avert4.Position.Y,Avert4.Position.Z)
&#9;end
end 

function onChanged4() 
&#9;if Button4:findFirstChild(&quot;Interact&quot;).Value == true and Progress.Value == 3 then
&#9;&#9;Button4:findFirstChild(&quot;Interact&quot;).Value = false
&#9;&#9;RButton4.Reflectance = 1
&#9;&#9;RButton4.CFrame = CFrame.new(RButton4.Position.X+0.2,RButton4.Position.Y,RButton4.Position.Z)

&#9;&#9;Plat4.BrickColor = BrickColor.new(&quot;Lime green&quot;)
&#9;&#9;Main2:findFirstChild(&quot;Mesh&quot;).VertexColor = Vector3.new(0, 1, 0)
&#9;&#9;S4.BrickColor = BrickColor.new(&quot;Lime green&quot;)
&#9;&#9;Progress.Value = 4
&#9;end
end 

Button4:findFirstChild(&quot;Interact&quot;).Changed:connect(onChanged4) 
Button3:findFirstChild(&quot;Interact&quot;).Changed:connect(onChanged3) 
Button2:findFirstChild(&quot;Interact&quot;).Changed:connect(onChanged2) 
Button1:findFirstChild(&quot;Interact&quot;).Changed:connect(onChanged1) 

while true do
&#9;wait()
&#9;if Progress.Value == 2 then
&#9;&#9;RButton3.CFrame = CFrame.new(Button3.Position.X,Button3.Position.Y,Button3.Position.Z-0.4) 
&#9;&#9;Avert3.CFrame = CFrame.new(Button3.Position.X,Button3.Position.Y,Button3.Position.Z-0.8) 
&#9;end
&#9;if Progress.Value == 4 then
&#9;&#9;Main2.CFrame = CFrame.new(Main2.Position.X-0.2,Main2.Position.Y,Main2.Position.Z-0.2)*CFrame.Angles(math.rad(-90),0,0)
&#9;&#9;Main1.CFrame = CFrame.new(Main1.Position.X-0.2,Main1.Position.Y,Main1.Position.Z-0.2)*CFrame.Angles(math.rad(-90),0,0)
&#9;&#9;Plat1.BrickColor = BrickColor.new(&quot;Bright green&quot;)
&#9;&#9;Plat2.BrickColor = BrickColor.new(&quot;Bright green&quot;)
&#9;&#9;Plat3.BrickColor = BrickColor.new(&quot;Bright green&quot;)
&#9;&#9;Plat4.BrickColor = BrickColor.new(&quot;Bright green&quot;)
&#9;&#9;wait()
&#9;&#9;Main2.CFrame = CFrame.new(Main2.Position.X+0.2,Main2.Position.Y,Main2.Position.Z-0.2)*CFrame.Angles(math.rad(-90),0,0)
&#9;&#9;Main1.CFrame = CFrame.new(Main1.Position.X+0.2,Main1.Position.Y,Main1.Position.Z-0.2)*CFrame.Angles(math.rad(-90),0,0)
&#9;&#9;Plat1.BrickColor = BrickColor.new(&quot;Lime green&quot;)
&#9;&#9;Plat2.BrickColor = BrickColor.new(&quot;Lime green&quot;)
&#9;&#9;Plat3.BrickColor = BrickColor.new(&quot;Lime green&quot;)
&#9;&#9;Plat4.BrickColor = BrickColor.new(&quot;Lime green&quot;)
&#9;&#9;wait()
&#9;&#9;Main2.CFrame = CFrame.new(Main2.Position.X+0.2,Main2.Position.Y,Main2.Position.Z+0.2)*CFrame.Angles(math.rad(-90),0,0)
&#9;&#9;Main1.CFrame = CFrame.new(Main1.Position.X+0.2,Main1.Position.Y,Main1.Position.Z+0.2)*CFrame.Angles(math.rad(-90),0,0)
&#9;&#9;Plat1.BrickColor = BrickColor.new(&quot;Bright green&quot;)
&#9;&#9;Plat2.BrickColor = BrickColor.new(&quot;Bright green&quot;)
&#9;&#9;Plat3.BrickColor = BrickColor.new(&quot;Bright green&quot;)
&#9;&#9;Plat4.BrickColor = BrickColor.new(&quot;Bright green&quot;)
&#9;&#9;wait()
&#9;&#9;Main2.CFrame = CFrame.new(Main2.Position.X-0.2,Main2.Position.Y,Main2.Position.Z+0.2)*CFrame.Angles(math.rad(-90),0,0)
&#9;&#9;Main1.CFrame = CFrame.new(Main1.Position.X-0.2,Main1.Position.Y,Main1.Position.Z+0.2)*CFrame.Angles(math.rad(-90),0,0)
&#9;&#9;Plat1.BrickColor = BrickColor.new(&quot;Lime green&quot;)
&#9;&#9;Plat2.BrickColor = BrickColor.new(&quot;Lime green&quot;)
&#9;&#9;Plat3.BrickColor = BrickColor.new(&quot;Lime green&quot;)
&#9;&#9;Plat4.BrickColor = BrickColor.new(&quot;Lime green&quot;)
&#9;&#9;wait()
&#9;end
end

