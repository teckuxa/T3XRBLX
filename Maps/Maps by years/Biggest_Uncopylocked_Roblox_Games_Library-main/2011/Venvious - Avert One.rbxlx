					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">GuiScript</string>
					<ProtectedString name="Source">local Tool = script.Parent
local gui = script.ToolGui

function e(mouse)
&#9;player = game.Players:findFirstChild(Tool.Parent.Name..&quot;&quot;)
&#9;if player ~= nil then
&#9;&#9;ToolGui = gui:Clone()
&#9;&#9;ToolGui.Frame.Visible = true
&#9;&#9;ToolGui.Frame.UpdateGunStats.Disabled = false
&#9;&#9;ToolGui.Parent = player.PlayerGui
&#9;end
end

function ue(mouse)
&#9;if ToolGui ~= nil then
&#9;&#9;ToolGui:remove()
&#9;end
end

Tool.Equipped:connect(e)
Tool.Unequipped:connect(ue)
</ProtectedString>
