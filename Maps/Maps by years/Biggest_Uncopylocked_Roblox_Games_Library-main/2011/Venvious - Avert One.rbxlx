				<Item class="LocalScript" referent="RBX4091">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">LocalScript</string>
						<ProtectedString name="Source">repeat wait() until game.Workspace.CurrentCamera ~= nil and script.Parent.Parent.Parent.Parent.Character ~= nil

local Humanoid = script.Parent.Parent.Parent.Parent.Character:findFirstChild(&quot;Humanoid&quot;)
local Camera = game.Workspace.CurrentCamera
local CamPan = false
local fade = script.Parent:findFirstChild(&quot;BlackScreen&quot;)

function click()
&#9;script.Parent.Begin:remove()

&#9;if fade.BackgroundTransparency &lt; 1 then
&#9;&#9;fade.BackgroundTransparency = 1
&#9;end

&#9;CamPan = false

&#9;Camera:findFirstChild(&quot;Message&quot;):remove()
 
----------------

&#9;local LocalParts = Instance.new(&quot;Message&quot;, Camera)

&#9;CameraPoint = game.Teams.CameraPoint1:clone()
&#9;CameraPoint.Parent = LocalParts

&#9;b1 = Instance.new(&quot;Part&quot;, LocalParts)
&#9;b1.Name = &quot;CameraPart&quot;
&#9;b1.Anchored = true
&#9;b1.CanCollide = false
&#9;b1.Transparency = 1
&#9;b1.formFactor = &quot;Symmetric&quot;
&#9;b1.Size = Vector3.new(1,1,1)
&#9;b1.CFrame = CameraPoint.CameraLookVector.CFrame+Vector3.new(-10,10,0)
&#9;Camera.CameraSubject = CameraPoint.CameraLookVector
&#9;Camera.CameraType = &quot;Attach&quot;
&#9;Camera.CoordinateFrame = CFrame.new(b1.Position)

-----------------

&#9;script.Parent.Parent.MouseLockImage.Visible = true
&#9;script.Parent.Parent.MouseLockImage.Active = true

&#9;local time = 0
&#9;local img = script.Parent:findFirstChild(&quot;ImageLabel&quot;)

&#9;while time &lt;= 200 do
&#9;&#9;img.Size = UDim2.new(1+(0.005*time), 0, 1+(0.005*time), 0)
&#9;&#9;img.Position = UDim2.new(0-(0.005*time), 0, 0, 0)
&#9;&#9;Camera.CoordinateFrame = CFrame.new(b1.Position.x,b1.Position.y,(b1.Position.z+(0.1*time)))
&#9;&#9;time = time+1
&#9;&#9;wait(0.05)
&#9;end

&#9;for i = 1,20 do
&#9;&#9;fade.BackgroundTransparency = fade.BackgroundTransparency - 0.05
&#9;&#9;wait()
&#9;end

&#9;fade.GameObjective.Text = &quot;::Detective, where have they all gone?::&quot;

&#9;for i = 1,20 do
&#9;&#9;fade.GameObjective.Transparency = fade.GameObjective.Transparency - 0.05
&#9;&#9;wait()
&#9;end

&#9;wait(3)

&#9;for i = 1,20 do
&#9;&#9;fade.GameObjective.Transparency = fade.GameObjective.Transparency + 0.05
&#9;&#9;wait()
&#9;end

&#9;fade.GameObjective.Text = &quot;::Where are all the people?::&quot;

&#9;for i = 1,20 do
&#9;&#9;fade.GameObjective.Transparency = fade.GameObjective.Transparency - 0.05
&#9;&#9;wait()
&#9;end

&#9;wait(3)

&#9;for i = 1,20 do
&#9;&#9;fade.GameObjective.Transparency = fade.GameObjective.Transparency + 0.05
&#9;&#9;wait()
&#9;end

&#9;fade.GameObjective.Text = &quot;&quot;

&#9;local Humanoid = script.Parent.Parent.Parent.Parent.Character:findFirstChild(&quot;Humanoid&quot;)

&#9;Camera.CameraSubject = Humanoid
&#9;if LocalParts~= nil then
&#9;&#9;LocalParts:remove()
&#9;end

&#9;Camera.CameraType = &quot;Custom&quot;
&#9;Humanoid.WalkSpeed = 16

&#9;script.Parent.Parent.MouseLockImage.Active = false
&#9;script.Parent.Parent.MouseLockImage.Visible = false

&#9;script.Parent.Parent:findFirstChild(&quot;Post&quot;).Visible = true
&#9;script.Parent.Parent:findFirstChild(&quot;SpaceFiller&quot;).Visible = true
&#9;script.Parent.Parent:findFirstChild(&quot;ChatBox&quot;).Visible = true
&#9;script.Parent.Parent:findFirstChild(&quot;InputText&quot;).Visible = true

&#9;script.Parent.Parent.Parent:findFirstChild(&quot;ScreenGui&quot;):findFirstChild(&quot;MainInterface&quot;).Visible = true

&#9;img.Visible = false

--------------------------------------------------------------------------------------------------Give Player Grapple Gun
&#9;local Grpl = game.Lighting:findFirstChild(&quot;GrappleGun&quot;):clone()
&#9;Grpl.Parent = script.Parent.Parent.Parent.Parent:findFirstChild(&quot;Backpack&quot;)
&#9;Grpl:findFirstChild(&quot;GuiScript&quot;).Disabled = false
&#9;Grpl:findFirstChild(&quot;BackupWeld&quot;).Disabled = false
&#9;Grpl:findFirstChild(&quot;Local Gui&quot;).Disabled = false

&#9;for i = 1,20 do
&#9;&#9;fade.BackgroundTransparency = fade.BackgroundTransparency + 0.05
&#9;&#9;wait()
&#9;end

--------------------------------------------------------------------------------------------------Let The Game Begin
&#9;script.Parent:remove()

end

script.Parent.Begin.MouseButton1Click:connect(click)

if Camera:findFirstChild(&quot;Message&quot;) ~= nil then
&#9;Camera:findFirstChild(&quot;Message&quot;):remove()
end

local LocalParts = Instance.new(&quot;Message&quot;, Camera)

CameraPoint = game.Teams.CameraPoint1:clone()
CameraPoint.Parent = LocalParts

b1 = Instance.new(&quot;Part&quot;, LocalParts)
b1.Name = &quot;CameraPart&quot;
b1.Anchored = true
b1.CanCollide = false
b1.Transparency = 1
b1.formFactor = &quot;Symmetric&quot;
b1.Size = Vector3.new(1,1,1)
b1.CFrame = CameraPoint.CameraLookVector.CFrame+Vector3.new(-10,10,0)
Camera.CameraSubject = CameraPoint.CameraLookVector
Camera.CameraType = &quot;Attach&quot;
Camera.CoordinateFrame = CFrame.new(b1.Position)

-----------------

script.Parent.Parent.MouseLockImage.Visible = true
script.Parent.Parent.MouseLockImage.Active = true

CamPan = true

fade.GameObjective.Text = &quot;::Loading::&quot;

for i = 1,4 do

&#9;for i = 1,20 do
&#9;&#9;fade.GameObjective.Transparency = fade.GameObjective.Transparency - 0.05
&#9;&#9;wait()
&#9;end

&#9;wait(1)

&#9;for i = 1,20 do
&#9;&#9;fade.GameObjective.Transparency = fade.GameObjective.Transparency + 0.05
&#9;&#9;wait()
&#9;end

end

fade.GameObjective.Text = &quot;&quot;

for i = 1,20 do
&#9;fade.BackgroundTransparency = fade.BackgroundTransparency + 0.05
&#9;wait()
end

while CamPan == true do
&#9;Camera.CoordinateFrame = CFrame.new(b1.Position.x,b1.Position.y,b1.Position.z)
&#9;wait()
end
</ProtectedString>
