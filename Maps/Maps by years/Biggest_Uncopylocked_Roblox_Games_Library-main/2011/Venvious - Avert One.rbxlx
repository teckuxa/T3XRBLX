							<ProtectedString name="Source">local Lesson = script.Parent.Parent:findFirstChild(&quot;ComPanel&quot;):findFirstChild(&quot;LessonsLearned&quot;)

Char = script.Parent.Parent.Parent.Parent.Parent.Character:findFirstChild(&quot;Torso&quot;)

if Lesson.Value == 7 then
&#9;MessageBoss = game.Workspace.CurrentCamera:findFirstChild(&quot;Message&quot;):remove()
&#9;GUIBoss = script.Parent.Parent.Parent.Parent:findFirstChild(&quot;GameGui&quot;):findFirstChild(&quot;BossGui&quot;):remove()
