					<Item class="Script" referent="RBX4113">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">HealthScript</string>
							<ProtectedString name="Source">local H = script.Parent.Parent.Parent.Health
local H1 = script.Parent.Health1
local H2 = script.Parent.Health2
local H3 = script.Parent.Health3
local H4 = script.Parent.Health4
local H5 = script.Parent.Health5
local H6 = script.Parent.Health6
local Pro = script.Parent.Parent.Parent.Progression
local Lesson = script.Parent.Parent:findFirstChild(&quot;ComPanel&quot;):findFirstChild(&quot;LessonsLearned&quot;)
local respawn = false
local dead = false

H.Changed:connect(function()
&#9;if H.Value == 6 then
&#9;&#9;H1.Visible = true
&#9;&#9;H2.Visible = true
&#9;&#9;H3.Visible = true
&#9;&#9;H4.Visible = true
&#9;&#9;H5.Visible = true
&#9;&#9;H6.Visible = true

&#9;&#9;else if H.Value == 5 then
&#9;&#9;&#9;H1.Visible = true
&#9;&#9;&#9;H2.Visible = true
&#9;&#9;&#9;H3.Visible = true
&#9;&#9;&#9;H4.Visible = true
&#9;&#9;&#9;H5.Visible = true
&#9;&#9;&#9;H6.Visible = false

&#9;&#9;&#9;else if H.Value == 4 then
&#9;&#9;&#9;&#9;H1.Visible = true
&#9;&#9;&#9;&#9;H2.Visible = true
&#9;&#9;&#9;&#9;H3.Visible = true
&#9;&#9;&#9;&#9;H4.Visible = true
&#9;&#9;&#9;&#9;H5.Visible = false
&#9;&#9;&#9;&#9;H6.Visible = false

&#9;&#9;&#9;&#9;else if H.Value == 3 then
&#9;&#9;&#9;&#9;&#9;H1.Visible = true
&#9;&#9;&#9;&#9;&#9;H2.Visible = true
&#9;&#9;&#9;&#9;&#9;H3.Visible = true
&#9;&#9;&#9;&#9;&#9;H4.Visible = false
&#9;&#9;&#9;&#9;&#9;H5.Visible = false
&#9;&#9;&#9;&#9;&#9;H6.Visible = false

&#9;&#9;&#9;&#9;&#9;else if H.Value == 2 then
&#9;&#9;&#9;&#9;&#9;&#9;H1.Visible = true
&#9;&#9;&#9;&#9;&#9;&#9;H2.Visible = true
&#9;&#9;&#9;&#9;&#9;&#9;H3.Visible = false
&#9;&#9;&#9;&#9;&#9;&#9;H4.Visible = false
&#9;&#9;&#9;&#9;&#9;&#9;H5.Visible = false
&#9;&#9;&#9;&#9;&#9;&#9;H6.Visible = false

&#9;&#9;&#9;&#9;&#9;&#9;else if H.Value == 1 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;H1.Visible = true
&#9;&#9;&#9;&#9;&#9;&#9;&#9;H2.Visible = false
&#9;&#9;&#9;&#9;&#9;&#9;&#9;H3.Visible = false
&#9;&#9;&#9;&#9;&#9;&#9;&#9;H4.Visible = false
&#9;&#9;&#9;&#9;&#9;&#9;&#9;H5.Visible = false
&#9;&#9;&#9;&#9;&#9;&#9;&#9;H6.Visible = false

&#9;&#9;&#9;&#9;&#9;&#9;&#9;else if H.Value &lt;= 0 and respawn ~= true then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;respawn = true
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;fade()
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;respawn = false
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end)

function fade()
&#9;local fade = script.Parent.Parent.BlackScreen
&#9;if script.Parent.Parent.Parent.Lives.Value &lt; 2 then
&#9;&#9;dead = true
&#9;end
&#9;if dead == false then
&#9;&#9;fade.BackgroundTransparency = 0
&#9;end
&#9;H1.Visible = false
&#9;H2.Visible = false
&#9;H3.Visible = false
