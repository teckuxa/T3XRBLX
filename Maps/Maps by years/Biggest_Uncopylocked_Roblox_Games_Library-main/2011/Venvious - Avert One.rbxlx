				<Item class="Script" referent="RBX7">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">CheckPoint</string>
						<ProtectedString name="Source">while true do
&#9;wait()
&#9;local p = game.Players:GetChildren()
&#9;for i = 1,#p do
&#9;&#9;if p[i].Character ~= nil then
&#9;&#9;&#9;local torso = p[i].Character:findFirstChild(&quot;Torso&quot;)
&#9;&#9;&#9;if torso ~= nil then
&#9;&#9;&#9;&#9;if (p[i].Character.Torso.Position - script.Parent.Position).magnitude &lt; 6 then
&#9;&#9;&#9;&#9;&#9;PG = p[i]:findFirstChild(&quot;PlayerGui&quot;):findFirstChild(&quot;ScreenGui&quot;):findFirstChild(&quot;Progression&quot;)
&#9;&#9;&#9;&#9;&#9;CPV = script.Parent:findFirstChild(&quot;CheckPointValue&quot;)
&#9;&#9;&#9;&#9;&#9;if PG.Value &lt; CPV.Value then
&#9;&#9;&#9;&#9;&#9;&#9;PG.Value = CPV.Value
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end
&#9;</ProtectedString>
					</Properties>
				</Item>
