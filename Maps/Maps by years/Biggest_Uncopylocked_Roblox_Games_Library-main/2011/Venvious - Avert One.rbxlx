		<Item class="Script" referent="RBX56">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Leaderboard</string>
				<ProtectedString name="Source">function onPlayerEntered(newPlayer) 
&#9;repeat wait() until newPlayer.PlayerGui:findFirstChild(&quot;ScreenGui&quot;) ~= nil and newPlayer.Character:findFirstChild(&quot;Head&quot;) ~= nil
&#9;local stats = Instance.new(&quot;IntValue&quot;) 
&#9;stats.Name = &quot;leaderstats&quot;

&#9;local Val = Instance.new(&quot;IntValue&quot;)
&#9;Val.Name = &quot;Progress&quot; 
&#9;Val.Value = 0
&#9;Val.Parent = stats 
&#9;stats.Parent = newPlayer 

&#9;local Ping = game.Lighting:findFirstChild(&quot;GuiExtras&quot;):findFirstChild(&quot;Splash&quot;):clone()
&#9;Ping.Parent = newPlayer.Character:findFirstChild(&quot;Head&quot;)
&#9;Ping:Play()

&#9;newPlayer.Changed:connect(function (property)
&#9;&#9;if (property == &quot;Character&quot;) then
&#9;&#9;&#9;onPlayerRespawned(newPlayer)
&#9;&#9;end
&#9;end)

end 

function onPlayerRespawned(player)
&#9;repeat wait() until player.PlayerGui:findFirstChild(&quot;ScreenGui&quot;) ~= nil and player.Character:findFirstChild(&quot;Head&quot;) ~= nil

&#9;local Pro = player:findFirstChild(&quot;leaderstats&quot;):findFirstChild(&quot;Progress&quot;)
&#9;Pro.Value = 0

&#9;local Ping = game.Lighting:findFirstChild(&quot;GuiExtras&quot;):findFirstChild(&quot;Splash&quot;):clone()
&#9;Ping.Parent = player.Character:findFirstChild(&quot;Head&quot;)
&#9;Ping:Play()

&#9;player.Changed:connect(function (property)
&#9;&#9;if (property == &quot;Character&quot;) then
&#9;&#9;&#9;onPlayerRespawned(player)
&#9;&#9;end
&#9;end)

end

game.Players.ChildAdded:connect(onPlayerEntered) 
</ProtectedString>
