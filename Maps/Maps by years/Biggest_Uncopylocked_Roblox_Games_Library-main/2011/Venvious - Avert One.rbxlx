					<ProtectedString name="Source">T = script.Parent:findFirstChild(&quot;GrappleGun&quot;)
if T == nil then
&#9;T = game.Players:findFirstChild(script.Parent.Name..&quot;&quot;):findFirstChild(&quot;Backpack&quot;):findFirstChild(&quot;GrappleGun&quot;)
end
T:findFirstChild(&quot;Local Gui&quot;):findFirstChild(&quot;reloadTime&quot;).Value = T:findFirstChild(&quot;Local Gui&quot;):findFirstChild(&quot;reloadTime&quot;).Value/2

wait(30)

T = script.Parent:findFirstChild(&quot;GrappleGun&quot;)
if T == nil then
&#9;T = game.Players:findFirstChild(script.Parent.Name..&quot;&quot;):findFirstChild(&quot;Backpack&quot;):findFirstChild(&quot;GrappleGun&quot;)
end
T:findFirstChild(&quot;Local Gui&quot;):findFirstChild(&quot;reloadTime&quot;).Value = T:findFirstChild(&quot;Local Gui&quot;):findFirstChild(&quot;reloadTime&quot;).Value*2

script:remove()
