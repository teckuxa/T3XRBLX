				<Item class="SpecialMesh" referent="RBX4384">
					<Properties>
						<token name="LODX">2</token>
						<token name="LODY">2</token>
						<Content name="MeshId"><url>http://www.roblox.com/asset/?id=33393806</url></Content>
						<token name="MeshType">5</token>
