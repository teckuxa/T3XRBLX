				<Item class="Script" referent="RBX3802">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">PowerUp</string>
						<ProtectedString name="Source">YPos = script.Parent.Position.Y

function onTouched(hit)
&#9;if hit.Name == &quot;Torso&quot; then
&#9;&#9;local human = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;&#9;if (human ~= nil) and (human.Health &gt; 0) and (hit.Parent:findFirstChild(&quot;Deadly&quot;) == nil) and (human.Parent:findFirstChild(&quot;maxDistance&quot;) == nil) then
&#9;&#9;&#9;S = game.Lighting.PowerUps:findFirstChild(&quot;maxDistance&quot;):clone()
&#9;&#9;&#9;S.Parent = human.Parent
&#9;&#9;&#9;S.Disabled = false
&#9;&#9;&#9;script.Parent.CFrame = CFrame.new(script.Parent.Position.X,0,script.Parent.Position.Z)
&#9;&#9;&#9;wait(5)
&#9;&#9;&#9;script.Parent.CFrame = CFrame.new(script.Parent.Position.X,YPos,script.Parent.Position.Z)
&#9;&#9;end
&#9;end
end

script.Parent.Touched:connect(onTouched)

while true do
&#9;wait()
&#9;turn = 1
&#9;for i = 1,60 do
&#9;&#9;script.Parent.CFrame = CFrame.new(script.Parent.Position.x,script.Parent.Position.y,script.Parent.Position.z)*CFrame.Angles(0,math.rad(0+6*turn),0)
&#9;&#9;turn = turn + 1
&#9;&#9;wait(0.05)
&#9;end
end
</ProtectedString>
					</Properties>
				</Item>
			</Item>
