								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">DetectInteraction</string>
								<ProtectedString name="Source">Xmain = script.Parent.Position.X
BParts = script.Parent.Parent.Parent
BParts.BPart1.Averter.CFrame = CFrame.new(-181,BParts.BPart1.Averter.Position.Y,BParts.BPart1.Averter.Position.Z)
BParts.BPart2.Averter.CFrame = CFrame.new(-181,BParts.BPart2.Averter.Position.Y,BParts.BPart2.Averter.Position.Z)
BParts.BPart3.Averter.CFrame = CFrame.new(-181,BParts.BPart3.Averter.Position.Y,BParts.BPart3.Averter.Position.Z)
BParts.BPart4.Averter.CFrame = CFrame.new(-181,BParts.BPart4.Averter.Position.Y,BParts.BPart4.Averter.Position.Z)
BParts.BPart5.Averter.CFrame = CFrame.new(-181,BParts.BPart5.Averter.Position.Y,BParts.BPart5.Averter.Position.Z)
BParts.BPart6.Averter.CFrame = CFrame.new(-181,BParts.BPart6.Averter.Position.Y,BParts.BPart6.Averter.Position.Z)

function onChanged() 
&#9;if script.Parent.Interact.Value == true then
&#9;&#9;script.Parent.Reflectance = 1
&#9;&#9;script.Parent.CFrame = CFrame.new(Xmain+0.2,script.Parent.Position.Y,script.Parent.Position.Z)

&#9;&#9;for i = 1,40 do
&#9;&#9;&#9;BParts.BPart1.Averter.CFrame = CFrame.new(BParts.BPart1.Averter.Position.X-0.4,BParts.BPart1.Averter.Position.Y,BParts.BPart1.Averter.Position.Z)
&#9;&#9;&#9;wait()
&#9;&#9;end
&#9;&#9;for i = 1,40 do
&#9;&#9;&#9;BParts.BPart2.Averter.CFrame = CFrame.new(BParts.BPart2.Averter.Position.X-0.4,BParts.BPart2.Averter.Position.Y,BParts.BPart2.Averter.Position.Z)
&#9;&#9;&#9;wait()
&#9;&#9;end
&#9;&#9;for i = 1,40 do
&#9;&#9;&#9;BParts.BPart3.Averter.CFrame = CFrame.new(BParts.BPart3.Averter.Position.X-0.4,BParts.BPart3.Averter.Position.Y,BParts.BPart3.Averter.Position.Z)
&#9;&#9;&#9;wait()
&#9;&#9;end
&#9;&#9;for i = 1,40 do
&#9;&#9;&#9;BParts.BPart4.Averter.CFrame = CFrame.new(BParts.BPart4.Averter.Position.X-0.4,BParts.BPart4.Averter.Position.Y,BParts.BPart4.Averter.Position.Z)
&#9;&#9;&#9;wait()
&#9;&#9;end
&#9;&#9;for i = 1,40 do
&#9;&#9;&#9;BParts.BPart5.Averter.CFrame = CFrame.new(BParts.BPart5.Averter.Position.X-0.4,BParts.BPart5.Averter.Position.Y,BParts.BPart5.Averter.Position.Z)
&#9;&#9;&#9;wait()
&#9;&#9;end
&#9;&#9;for i = 1,40 do
&#9;&#9;&#9;BParts.BPart6.Averter.CFrame = CFrame.new(BParts.BPart6.Averter.Position.X-0.4,BParts.BPart6.Averter.Position.Y,BParts.BPart6.Averter.Position.Z)
&#9;&#9;&#9;wait()
&#9;&#9;end

&#9;&#9;wait(2.2)
&#9;&#9;script.Parent.Ping.Pitch = 3 
&#9;&#9;script.Parent.Ping:Play()
&#9;&#9;script.Parent.Reflectance = 0.7
&#9;&#9;wait(0.2)
&#9;&#9;script.Parent.Ping.Pitch = 2 
&#9;&#9;script.Parent.Ping:Play()
&#9;&#9;script.Parent.Reflectance = 1
&#9;&#9;wait(0.6)
&#9;&#9;script.Parent.Ping.Pitch = 3 
&#9;&#9;script.Parent.Ping:Play()
&#9;&#9;script.Parent.Reflectance = 0.7
&#9;&#9;wait(0.2)
&#9;&#9;script.Parent.Ping.Pitch = 2 
&#9;&#9;script.Parent.Ping:Play()
&#9;&#9;script.Parent.Reflectance = 1
&#9;&#9;wait(0.6)
&#9;&#9;script.Parent.Ping.Pitch = 0.5 
&#9;&#9;script.Parent.Ping:Play()
&#9;&#9;wait(0.2)

&#9;&#9;for i = 1,40 do
