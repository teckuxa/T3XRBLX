		<Item class="Script" referent="RBX3605">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">AntiFall</string>
				<ProtectedString name="Source">while true do
&#9;wait()
&#9;local p = game.Players:GetChildren()
&#9;for i = 1,#p do
&#9;&#9;if p[i].Character ~= nil then
&#9;&#9;&#9;local torso = p[i].Character:findFirstChild(&quot;Torso&quot;)
&#9;&#9;&#9;if torso ~= nil then
&#9;&#9;&#9;&#9;if (p[i].Character.Torso.Position.Y &lt; 240) then
&#9;&#9;&#9;&#9;&#9;local Pro = p[i]:findFirstChild(&quot;leaderstats&quot;):findFirstChild(&quot;Progress&quot;)
&#9;&#9;&#9;&#9;&#9;local Health = p[i]:findFirstChild(&quot;PlayerGui&quot;):findFirstChild(&quot;ScreenGui&quot;):findFirstChild(&quot;Health&quot;)
&#9;&#9;&#9;&#9;&#9;local Lives = p[i]:findFirstChild(&quot;PlayerGui&quot;):findFirstChild(&quot;ScreenGui&quot;):findFirstChild(&quot;Lives&quot;)
&#9;&#9;&#9;&#9;&#9;if Pro ~= nil and Health ~= nil and Lives ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;if Lives.Value &lt;= 1 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;hum = p[i].Character:findFirstChild(&quot;Humanoid&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if hum ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;hum.Health = 0
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;Health.Value = Health.Value - 6
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;&#9;&#9;&#9;&#9;else if Lives.Value &gt; 1 then&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;Health.Value = Health.Value - 6
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;wait(0.1)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;if torso ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;torso.CFrame = CFrame.new(game.Workspace:findFirstChild(&quot;CheckPoint&quot;..Pro.Value).Averter.Position)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end
&#9;</ProtectedString>
			</Properties>
