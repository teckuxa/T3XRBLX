						<Item class="LocalScript" referent="RBX3588">
							<Properties>
								<bool name="Disabled">true</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">BodyCFrame</string>
								<ProtectedString name="Source">local Enemy = script.Parent:findFirstChild(&quot;Enemy&quot;).Value
local Progress = script.Parent:findFirstChild(&quot;BossProgress&quot;)

local RA = Enemy:findFirstChild(&quot;Right Arm&quot;)
local LA = Enemy:findFirstChild(&quot;Left Arm&quot;)
local TM = Enemy:findFirstChild(&quot;Torso&quot;)

local Tx = Vector3.FromNormalId(Enum.NormalId.Front).x
local Ty = Vector3.FromNormalId(Enum.NormalId.Front).y
local Tz = Vector3.FromNormalId(Enum.NormalId.Front).z

RA.CFrame = (TM.CFrame * CFrame.new(Tx+0.5, Ty, Tz+1.5))*CFrame.Angles(math.rad(-20),0,math.rad(-40))
LA.CFrame = (TM.CFrame * CFrame.new(Tx-0.5, Ty, Tz+1.5))*CFrame.Angles(math.rad(-20),0,math.rad(40))
wait(1)

------------------------Arms to the Side
for i = 1,40 do
&#9;RA.CFrame = (TM.CFrame * CFrame.new(Tx+(0.5+(0.025*i)), Ty, Tz+(1.5-(0.0125*i)))*CFrame.Angles(math.rad(-20+(0.5*i)),0,math.rad(-40+(1.25*i))))
&#9;LA.CFrame = (TM.CFrame * CFrame.new(Tx-(0.5+(0.025*i)), Ty, Tz+(1.5-(0.0125*i)))*CFrame.Angles(math.rad(-20+(0.5*i)),0,math.rad(40-(1.25*i))))
&#9;wait()
end

RA.CFrame = (TM.CFrame * CFrame.new(Tx+1.5, Ty, Tz+1))*CFrame.Angles(0,0,math.rad(10))
LA.CFrame = (TM.CFrame * CFrame.new(Tx-1.5, Ty, Tz+1))*CFrame.Angles(0,0,math.rad(-10))

wait(1)

------------------------Right Arm Up
for i = 1,40 do
&#9;RA.CFrame = (TM.CFrame * CFrame.new(Tx+1.5, Ty+(0.0125*i), Tz+(1-(0.0125*i))))*CFrame.Angles(math.rad(2.25*i),0,math.rad(10-(0.25*i)))
&#9;wait()
end

------------------------Right Arm Up/Down
for i = 1,4 do
&#9;for i = 1,10 do
&#9;&#9;RA.CFrame = (TM.CFrame * CFrame.new(Tx+1.5, Ty+(0.5+(0.02*i)), Tz+0.5))*CFrame.Angles(math.rad(90+(1*i)),0,math.rad(0))
&#9;&#9;wait()
&#9;end

&#9;for i = 1,10 do
&#9;&#9;RA.CFrame = (TM.CFrame * CFrame.new(Tx+1.5, Ty+(0.7-(0.02*i)), Tz+0.5))*CFrame.Angles(math.rad(100-(1*i)),0,math.rad(0))
&#9;&#9;wait()
&#9;end
&#9;wait()
end

------------------------Right Arm Down
for i = 1,40 do
&#9;RA.CFrame = (TM.CFrame * CFrame.new(Tx+1.5, Ty+(0.5-(0.0125*i)), Tz+(0.5+(0.0125*i))))*CFrame.Angles(math.rad(90-(2.25*i)),0,math.rad(0+(0.25*i)))
&#9;wait()
end

RA.CFrame = (TM.CFrame * CFrame.new(Tx+1.5, Ty, Tz+1))*CFrame.Angles(0,0,math.rad(10))
LA.CFrame = (TM.CFrame * CFrame.new(Tx-1.5, Ty, Tz+1))*CFrame.Angles(0,0,math.rad(-10))

repeat wait() until Progress.Value == 2

wait(0.5)

------------------------Arms Up
for i = 1,40 do
&#9;RA.CFrame = (TM.CFrame * CFrame.new(Tx+1.5, Ty+(0.0125*i), Tz+(1-(0.0125*i))))*CFrame.Angles(math.rad(2.25*i),0,math.rad(10))
&#9;LA.CFrame = (TM.CFrame * CFrame.new(Tx-1.5, Ty+(0.0125*i), Tz+(1-(0.0125*i))))*CFrame.Angles(math.rad(2.25*i),0,math.rad(-10))
&#9;wait()
end

wait(0.5)

------------------------Arms Down
for i = 1,40 do
&#9;RA.CFrame = (TM.CFrame * CFrame.new(Tx+1.5, Ty+(0.5-(0.0125*i)), Tz+(0.5+(0.0125*i))))*CFrame.Angles(math.rad(90-(2.25*i)),0,math.rad(10))
&#9;LA.CFrame = (TM.CFrame * CFrame.new(Tx-1.5, Ty+(0.5-(0.0125*i)), Tz+(0.5+(0.0125*i))))*CFrame.Angles(math.rad(90-(2.25*i)),0,math.rad(-10))
&#9;wait()
end

repeat wait() until Progress.Value == 4

wait(1)

------------------------Arms Up
for i = 1,40 do
&#9;RA.CFrame = (TM.CFrame * CFrame.new(Tx+(1.5-0.005*i), Ty+(0.025*i), Tz+(1-(0.0125*i))))*CFrame.Angles(math.rad(4.5*i),0,math.rad(10-(0.5*i)))
&#9;LA.CFrame = (TM.CFrame * CFrame.new(Tx-(1.5-0.005*i), Ty+(0.025*i), Tz+(1-(0.0125*i))))*CFrame.Angles(math.rad(4.5*i),0,math.rad(-10+(0.5*i)))
&#9;wait()
end




</ProtectedString>
