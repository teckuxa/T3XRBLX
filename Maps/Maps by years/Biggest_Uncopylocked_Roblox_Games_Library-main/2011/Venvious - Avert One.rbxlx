						</Item>
						<Item class="LocalScript" referent="RBX3589">
							<Properties>
								<bool name="Disabled">true</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">LocalScript</string>
								<ProtectedString name="Source">repeat wait() until game.Workspace.CurrentCamera ~= nil and script.Parent.Parent.Parent.Parent.Character ~= nil

local Progress = script.Parent:findFirstChild(&quot;BossProgress&quot;)
local Humanoid = script.Parent.Parent.Parent.Parent.Character:findFirstChild(&quot;Humanoid&quot;)
local Camera = game.Workspace.CurrentCamera
local wideScreen1 = script.Parent:findFirstChild(&quot;WideScreen1&quot;)
local wideScreen2 = script.Parent:findFirstChild(&quot;WideScreen2&quot;)
local BossText = script.Parent:findFirstChild(&quot;BossText&quot;)

--[[oldMsg = Camera:findFirstChild(&quot;Message&quot;)
if oldmsg ~= nil then 
&#9;oldmsg.Parent = nil
end]]

wideScreen1:TweenPosition(UDim2.new(0, 0, 0, 0), &quot;Out&quot;, &quot;Quad&quot;, 1.5, true)
wideScreen2:TweenPosition(UDim2.new(0, 0, 0.875, 0), &quot;Out&quot;, &quot;Quad&quot;, 1.5, true)

BossText.Text = &quot;::Oh, hello Detective, did you find the people?::&quot;

local LocalParts = Instance.new(&quot;Message&quot;, Camera)

CameraPoint = game.Teams.CameraPoint2:clone()
CameraPoint.Parent = LocalParts

b1 = Instance.new(&quot;Part&quot;, LocalParts)
b1.Name = &quot;CameraPart&quot;
b1.Anchored = true
b1.CanCollide = false
b1.Transparency = 1
b1.formFactor = &quot;Symmetric&quot;
b1.Size = Vector3.new(1,1,1)
b1.CFrame = CameraPoint.CameraLookVector.CFrame+Vector3.new(0,-4,26)
Camera.CameraSubject = CameraPoint.CameraLookVector
Camera.CameraType = &quot;Attach&quot;
Camera.CoordinateFrame = CFrame.new(b1.Position)

script.Parent:findFirstChild(&quot;Enemy&quot;).Value = CameraPoint:findFirstChild(&quot;Hubris Hauteur&quot;)
script.Parent:findFirstChild(&quot;BodyCFrame&quot;).Disabled = false

script.Parent.Parent.MouseLockImage.Visible = true
script.Parent.Parent.MouseLockImage.Active = true

local time = 0

while time &lt;= 150 do
&#9;Camera.CoordinateFrame = CFrame.new(b1.Position.x,b1.Position.y,(b1.Position.z+(-0.1*time)))
&#9;time = time+1
&#9;wait(0.05)
end

local Humanoid = script.Parent.Parent.Parent.Parent.Character:findFirstChild(&quot;Humanoid&quot;)
local torso = script.Parent.Parent.Parent.Parent.Character:findFirstChild(&quot;Torso&quot;)

if torso == nil or Humanoid == nil then return end

torso.CFrame = CFrame.new(-355.5, 341.4, 209)
Camera.CameraSubject = Humanoid

Camera.CameraType = &quot;Custom&quot;
Humanoid.WalkSpeed = 16

script.Parent.Parent.MouseLockImage.Active = false
script.Parent.Parent.MouseLockImage.Visible = false

script.Parent:findFirstChild(&quot;DetectInteraction&quot;).Disabled = false

BossText.Text = &quot;&quot;

wideScreen1:TweenPosition(UDim2.new(0, 0, -0.125, 0), &quot;Out&quot;, &quot;Quad&quot;, 1.5, true)
wideScreen2:TweenPosition(UDim2.new(0, 0, 1, 0), &quot;Out&quot;, &quot;Quad&quot;, 1.5, true)

script.Parent:findFirstChild(&quot;CloneLaser&quot;).Disabled = false

repeat wait() until Progress.Value == 2

if torso == nil or Humanoid == nil then return end

torso.Anchored = true
Humanoid.WalkSpeed = 0
--torso.CFrame = CFrame.new(torso.Position.X,torso.Position.Y,torso.Position.Z)

wideScreen1:TweenPosition(UDim2.new(0, 0, 0, 0), &quot;Out&quot;, &quot;Quad&quot;, 1.5, true)
wideScreen2:TweenPosition(UDim2.new(0, 0, 0.875, 0), &quot;Out&quot;, &quot;Quad&quot;, 1.5, true)

BossText.Text = &quot;::What are you doing Detective? Turning all the generators green is unstable!::&quot;

b1.CFrame = CameraPoint.CameraLookVector.CFrame+Vector3.new(0,-4,8)
Camera.CameraSubject = CameraPoint.CameraLookVector
Camera.CameraType = &quot;Attach&quot;
Camera.CoordinateFrame = CFrame.new(b1.Position)

local time = 0

script.Parent.Parent.MouseLockImage.Visible = true
script.Parent.Parent.MouseLockImage.Active = true

while time &lt;= 30 do
&#9;Camera.CoordinateFrame = CFrame.new(b1.Position.x,b1.Position.y,b1.Position.z)
&#9;time = time+1
&#9;wait(0.05)
end

local time = 0

while time &lt;= 41 do
&#9;CameraPoint.CameraLookVector.CFrame = CFrame.new(CameraPoint.CameraLookVector.Position.x-(time/20),CameraPoint.CameraLookVector.Position.y,CameraPoint.CameraLookVector.Position.z)*CFrame.Angles(0,math.rad(time/2),0)
&#9;b1.CFrame = CameraPoint.CameraLookVector.CFrame+Vector3.new(0,-4,8+time/4)
&#9;Camera.CoordinateFrame = CFrame.new(b1.Position.x,b1.Position.y,b1.Position.z)
&#9;time = time+1
&#9;wait(0.05)
end

smoke = Instance.new(&quot;Smoke&quot;, script.Parent:findFirstChild(&quot;Enemy&quot;).Value.Parent:findFirstChild(&quot;Power&quot;):findFirstChild(&quot;MainPower1&quot;):findFirstChild(&quot;Averter&quot;))
smoke.Color = Color3.new(102/255,51/255,0)
smoke.Size = 3

local time = 0

while time &lt;= 60 do
&#9;Camera.CoordinateFrame = CFrame.new(b1.Position.x,b1.Position.y,b1.Position.z)
&#9;time = time+1
&#9;wait(0.05)
end

if torso == nil or Humanoid == nil then return end

Camera.CameraSubject = Humanoid

Camera.CameraType = &quot;Custom&quot;
Humanoid.WalkSpeed = 16
torso.Anchored = false

script.Parent.Parent.MouseLockImage.Active = false
script.Parent.Parent.MouseLockImage.Visible = false

BossText.Text = &quot;&quot;

wideScreen1:TweenPosition(UDim2.new(0, 0, -0.125, 0), &quot;Out&quot;, &quot;Quad&quot;, 1.5, true)
wideScreen2:TweenPosition(UDim2.new(0, 0, 1, 0), &quot;Out&quot;, &quot;Quad&quot;, 1.5, true)

repeat wait() until Progress.Value == 4

if torso == nil or Humanoid == nil then return end

torso.Anchored = true
Humanoid.WalkSpeed = 0

wideScreen1:TweenPosition(UDim2.new(0, 0, 0, 0), &quot;Out&quot;, &quot;Quad&quot;, 1.5, true)
wideScreen2:TweenPosition(UDim2.new(0, 0, 0.875, 0), &quot;Out&quot;, &quot;Quad&quot;, 1.5, true)

BossText.Text = &quot;::DETECTIVE! THIS WHOLE PLACE IS GOING DOWN!::&quot;

b1.CFrame = CameraPoint.CameraLookVector2.CFrame+Vector3.new(0,-4,8)
Camera.CameraSubject = CameraPoint.CameraLookVector2
Camera.CameraType = &quot;Attach&quot;
Camera.CoordinateFrame = CFrame.new(b1.Position)

script.Parent.Parent.MouseLockImage.Visible = true
script.Parent.Parent.MouseLockImage.Active = true

for d = 1,20 do
