				<Item class="Script" referent="RBX74">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">VenChange</string>
						<ProtectedString name="Source">while true do
&#9;wait()
&#9;if script.Parent.Message1.Value ~= &quot;/2 &quot;..script.Parent.VenLine.Value then
&#9;&#9;if script.Parent.Speaker1.Value == &quot;Venvious&quot; then
&#9;&#9;&#9;script.Parent.VenLine.Value = script.Parent.Message1.Value..&quot;&quot;
&#9;&#9;&#9;if script.Parent.Message1.Value ~= &quot;/2 &quot;..script.Parent.VenLine.Value then
&#9;&#9;&#9;&#9;script.Parent.Message1.Value = &quot;/2 &quot;..script.Parent.VenLine.Value
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end

&#9;if script.Parent.Speaker1.Value ~= &quot;Lord &quot;..script.Parent.SpeakerName.Value then
&#9;&#9;if script.Parent.Speaker1.Value == &quot;Venvious&quot; then
&#9;&#9;&#9;script.Parent.SpeakerName.Value = script.Parent.Speaker1.Value..&quot;&quot;
&#9;&#9;&#9;if script.Parent.Speaker1.Value ~= &quot;Lord &quot;..script.Parent.SpeakerName.Value then
&#9;&#9;&#9;&#9;script.Parent.Speaker1.Value = &quot;Lord &quot;..script.Parent.SpeakerName.Value
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end

&#9;if script.Parent.Message1.Value ~= &quot;/3 &quot;..script.Parent.VenLine.Value then
&#9;&#9;if script.Parent.Speaker1.Value == &quot;NicklesRox&quot; then
&#9;&#9;&#9;script.Parent.VenLine.Value = script.Parent.Message1.Value..&quot;&quot;
&#9;&#9;&#9;if script.Parent.Message1.Value ~= &quot;/3 &quot;..script.Parent.VenLine.Value then
&#9;&#9;&#9;&#9;script.Parent.Message1.Value = &quot;/3 &quot;..script.Parent.VenLine.Value
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end

&#9;if script.Parent.Speaker1.Value ~= &quot;Sir &quot;..script.Parent.SpeakerName.Value then
&#9;&#9;if script.Parent.Speaker1.Value == &quot;NicklesRox&quot; then
&#9;&#9;&#9;script.Parent.SpeakerName.Value = script.Parent.Speaker1.Value..&quot;&quot;
&#9;&#9;&#9;if script.Parent.Speaker1.Value ~= &quot;Sir &quot;..script.Parent.SpeakerName.Value then
&#9;&#9;&#9;&#9;script.Parent.Speaker1.Value = &quot;Sir &quot;..script.Parent.SpeakerName.Value
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end

&#9;if script.Parent.Message1.Value ~= &quot;/1 &quot;..script.Parent.VenLine.Value then
&#9;&#9;if script.Parent.Speaker1.Value == &quot;MoneySays&quot; then
&#9;&#9;&#9;script.Parent.VenLine.Value = script.Parent.Message1.Value..&quot;&quot;
&#9;&#9;&#9;if script.Parent.Message1.Value ~= &quot;/1 &quot;..script.Parent.VenLine.Value then
&#9;&#9;&#9;&#9;script.Parent.Message1.Value = &quot;/1 &quot;..script.Parent.VenLine.Value
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end

end
</ProtectedString>
