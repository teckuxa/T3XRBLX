						<Item class="Script" referent="RBX350">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">BodyCFrame</string>
								<ProtectedString name="Source">local RA = script.Parent:findFirstChild(&quot;Right Arm&quot;)
local LA = script.Parent:findFirstChild(&quot;Left Arm&quot;)
local TM = script.Parent:findFirstChild(&quot;Torso&quot;)
local HM = script.Parent:findFirstChild(&quot;Head&quot;)
local GH = script.Parent:findFirstChild(&quot;Hair&quot;)
local CT = script.Parent:findFirstChild(&quot;CheckeredTie&quot;)
local PS = script.Parent:findFirstChild(&quot;PaperStack&quot;)

local Tx = Vector3.FromNormalId(Enum.NormalId.Front).x
local Ty = Vector3.FromNormalId(Enum.NormalId.Front).y
local Tz = Vector3.FromNormalId(Enum.NormalId.Front).z

while true do
&#9;wait()
&#9;RA.CFrame = (TM.CFrame * CFrame.new(Tx+1.5, Ty, Tz+1))*CFrame.Angles(0,0,math.rad(15))
&#9;LA.CFrame = (TM.CFrame * CFrame.new(Tx-1.25, Ty+0.49, Tz+0.3))*CFrame.Angles(math.rad(90),0,math.rad(15))
&#9;GH.CFrame = (TM.CFrame * CFrame.new(Tx, Ty+1.8, Tz+1))
&#9;HM.CFrame = (TM.CFrame * CFrame.new(Tx, Ty+1.5, Tz+1))
&#9;PS.CFrame = (TM.CFrame * CFrame.new(Tx-3, Ty+0.5, Tz))
&#9;wait(2)

&#9;------------------------Left Arm Get Paper
&#9;for i = 1,36 do
&#9;&#9;LA.CFrame = (TM.CFrame * CFrame.new(Tx-(1.25+0.014*(i)), Ty+0.49, Tz+(0.3+0.005*(i))))*CFrame.Angles(math.rad(90),0,math.rad(15-2*(i)))
&#9;&#9;HM.CFrame = (TM.CFrame * CFrame.new(Tx, Ty+1.5, Tz+1))*CFrame.Angles(0,math.rad(0.5*i),0)
&#9;&#9;GH.CFrame = (TM.CFrame * CFrame.new(Tx, Ty+1.8, Tz+1))*CFrame.Angles(0,math.rad(0.5*i),0)
&#9;&#9;wait()
&#9;end

&#9;for i = 1,36 do
&#9;&#9;LA.CFrame = (TM.CFrame * CFrame.new(Tx-(1.25+0.014*(36-i)), Ty+0.49, Tz+(0.3+0.005*(36-i))))*CFrame.Angles(math.rad(90),0,math.rad(15-2*(36-i)))
&#9;&#9;HM.CFrame = (TM.CFrame * CFrame.new(Tx, Ty+1.5, Tz+1))*CFrame.Angles(0,math.rad(0.5*(36-i)),0)
&#9;&#9;GH.CFrame = (TM.CFrame * CFrame.new(Tx, Ty+1.8, Tz+1))*CFrame.Angles(0,math.rad(0.5*(36-i)),0)
&#9;&#9;PS.CFrame = (TM.CFrame * CFrame.new(Tx-(3-0.068*(i)), Ty+0.5, Tz-(0.035*(i))))
&#9;&#9;wait()
&#9;end

&#9;------------------------Right Arm Up
&#9;for i = 1,36 do
&#9;&#9;RA.CFrame = (TM.CFrame * CFrame.new(Tx+1.5-(0.02*i), Ty+(0.018*i), Tz+(1-0.04*i)))*CFrame.Angles(math.rad(2.5*i),0,math.rad(15-(1.4*i)))
&#9;&#9;LA.CFrame = (TM.CFrame * CFrame.new(Tx-1.25, Ty+0.49, Tz+(0.3-0.006*i)))*CFrame.Angles(math.rad(90),0,math.rad(15))
&#9;&#9;wait()
&#9;end

&#9;------------------------Paper Lift
&#9;for i = 1,8 do
&#9;&#9;RA.CFrame = (TM.CFrame * CFrame.new(Tx+1.5-(0.02*36), Ty+((0.018*36)+0.02*i), Tz+(1-0.04*36)))*CFrame.Angles(math.rad((2.5*36)+1*i),0,math.rad(15-(1.4*36)))
&#9;&#9;LA.CFrame = (TM.CFrame * CFrame.new(Tx-1.25, Ty+(0.49+0.02*i), Tz+(0.3-0.006*36)))*CFrame.Angles(math.rad(90+1*i),0,math.rad(15))
&#9;&#9;PS.CFrame = (TM.CFrame * CFrame.new(Tx-(3-0.068*(36)), Ty+(0.5+0.04*i), Tz-(0.035*(36))))
&#9;&#9;wait()
&#9;end

&#9;for i = 1,8 do
&#9;&#9;RA.CFrame = (TM.CFrame * CFrame.new(Tx+1.5-(0.02*36), Ty+((0.018*36)+0.02*(8-i)), Tz+(1-0.04*36)))*CFrame.Angles(math.rad((2.5*36)+1*(8-i)),0,math.rad(15-(1.4*36)))
&#9;&#9;LA.CFrame = (TM.CFrame * CFrame.new(Tx-1.25, Ty+(0.49+0.02*(8-i)), Tz+(0.3-0.006*36)))*CFrame.Angles(math.rad(90+1*(8-i)),0,math.rad(15))
&#9;&#9;PS.CFrame = (TM.CFrame * CFrame.new(Tx-(3-0.068*(36)), Ty+(0.5+0.04*(8-i)), Tz-(0.035*(36))))
&#9;&#9;wait()
&#9;end

&#9;for i = 1,8 do
&#9;&#9;RA.CFrame = (TM.CFrame * CFrame.new(Tx+1.5-(0.02*36), Ty+((0.018*36)+0.02*i), Tz+(1-0.04*36)))*CFrame.Angles(math.rad((2.5*36)+1*i),0,math.rad(15-(1.4*36)))
&#9;&#9;LA.CFrame = (TM.CFrame * CFrame.new(Tx-1.25, Ty+(0.49+0.02*i), Tz+(0.3-0.006*36)))*CFrame.Angles(math.rad(90+1*i),0,math.rad(15))
&#9;&#9;PS.CFrame = (TM.CFrame * CFrame.new(Tx-(3-0.068*(36)), Ty+(0.5+0.04*i), Tz-(0.035*(36))))
&#9;&#9;wait()
&#9;end

&#9;for i = 1,8 do
&#9;&#9;RA.CFrame = (TM.CFrame * CFrame.new(Tx+1.5-(0.02*36), Ty+((0.018*36)+0.02*(8-i)), Tz+(1-0.04*36)))*CFrame.Angles(math.rad((2.5*36)+1*(8-i)),0,math.rad(15-(1.4*36)))
&#9;&#9;LA.CFrame = (TM.CFrame * CFrame.new(Tx-1.25, Ty+(0.49+0.02*(8-i)), Tz+(0.3-0.006*36)))*CFrame.Angles(math.rad(90+1*(8-i)),0,math.rad(15))
&#9;&#9;PS.CFrame = (TM.CFrame * CFrame.new(Tx-(3-0.068*(36)), Ty+(0.5+0.04*(8-i)), Tz-(0.035*(36))))
&#9;&#9;wait()
&#9;end

&#9;for i = 1,8 do
&#9;&#9;RA.CFrame = (TM.CFrame * CFrame.new(Tx+1.5-(0.02*36), Ty+((0.018*36)+0.02*i), Tz+(1-0.04*36)))*CFrame.Angles(math.rad((2.5*36)+1*i),0,math.rad(15-(1.4*36)))
&#9;&#9;LA.CFrame = (TM.CFrame * CFrame.new(Tx-1.25, Ty+(0.49+0.02*i), Tz+(0.3-0.006*36)))*CFrame.Angles(math.rad(90+1*i),0,math.rad(15))
&#9;&#9;PS.CFrame = (TM.CFrame * CFrame.new(Tx-(3-0.068*(36)), Ty+(0.5+0.04*i), Tz-(0.035*(36))))
&#9;&#9;wait()
&#9;end

&#9;for i = 1,8 do
&#9;&#9;RA.CFrame = (TM.CFrame * CFrame.new(Tx+1.5-(0.02*36), Ty+((0.018*36)+0.02*(8-i)), Tz+(1-0.04*36)))*CFrame.Angles(math.rad((2.5*36)+1*(8-i)),0,math.rad(15-(1.4*36)))
&#9;&#9;LA.CFrame = (TM.CFrame * CFrame.new(Tx-1.25, Ty+(0.49+0.02*(8-i)), Tz+(0.3-0.006*36)))*CFrame.Angles(math.rad(90+1*(8-i)),0,math.rad(15))
&#9;&#9;PS.CFrame = (TM.CFrame * CFrame.new(Tx-(3-0.068*(36)), Ty+(0.5+0.04*(8-i)), Tz-(0.035*(36))))
&#9;&#9;wait()
&#9;end

&#9;------------------------Right Arm Down
&#9;for i = 1,36 do
&#9;&#9;RA.CFrame = (TM.CFrame * CFrame.new(Tx+1.5-(0.02*(36-i)), Ty+(0.018*(36-i)), Tz+(1-0.04*(36-i))))*CFrame.Angles(math.rad(2.5*(36-i)),0,math.rad(15-(1.4*(36-i))))
&#9;&#9;LA.CFrame = (TM.CFrame * CFrame.new(Tx-1.25, Ty+0.49, Tz+(0.3-0.006*(36-i))))*CFrame.Angles(math.rad(90),0,math.rad(15))
&#9;&#9;wait()
&#9;end

&#9;------------------------Left Arm Put Away Paper

&#9;for i = 1,36 do
&#9;&#9;LA.CFrame = (TM.CFrame * CFrame.new(Tx-(1.25+0.014*(i)), Ty+0.49, Tz+(0.3+0.005*(i))))*CFrame.Angles(math.rad(90),0,math.rad(15-2*(i)))
&#9;&#9;HM.CFrame = (TM.CFrame * CFrame.new(Tx, Ty+1.5, Tz+1))*CFrame.Angles(0,math.rad(0.5*(i)),0)
&#9;&#9;GH.CFrame = (TM.CFrame * CFrame.new(Tx, Ty+1.8, Tz+1))*CFrame.Angles(0,math.rad(0.5*(i)),0)
&#9;&#9;PS.CFrame = (TM.CFrame * CFrame.new(Tx-(3-0.068*(36-i)), Ty+0.5, Tz-(0.035*(36-i))))
&#9;&#9;wait()
&#9;end

&#9;for i = 1,36 do
&#9;&#9;LA.CFrame = (TM.CFrame * CFrame.new(Tx-(1.25+0.014*(36-i)), Ty+0.49, Tz+(0.3+0.005*(36-i))))*CFrame.Angles(math.rad(90),0,math.rad(15-2*(36-i)))
&#9;&#9;HM.CFrame = (TM.CFrame * CFrame.new(Tx, Ty+1.5, Tz+1))*CFrame.Angles(0,math.rad(0.5*(36-i)),0)
&#9;&#9;GH.CFrame = (TM.CFrame * CFrame.new(Tx, Ty+1.8, Tz+1))*CFrame.Angles(0,math.rad(0.5*(36-i)),0)
&#9;&#9;wait()
&#9;end

&#9;wait(2)

&#9;------------------------Right Arm Up
&#9;for i = 1,36 do
&#9;&#9;RA.CFrame = (TM.CFrame * CFrame.new(Tx+1.5-(0.01*i), Ty+(0.036*i), Tz+1))*CFrame.Angles(math.rad(5*i),0,math.rad(15-(0.83*i)))
&#9;&#9;wait()
&#9;end

&#9;------------------------Right Arm Head Scratch
&#9;for i = 1,4 do
&#9;&#9;RA.CFrame = (TM.CFrame * CFrame.new(Tx+1.5-(0.01*(36)), Ty+(0.036*(36)), Tz+1))*CFrame.Angles(math.rad(5*(36+i)),0,math.rad(15-(0.83*(36))))
&#9;&#9;wait()
&#9;end

&#9;for i = 1,4 do
&#9;&#9;RA.CFrame = (TM.CFrame * CFrame.new(Tx+1.5-(0.01*(36)), Ty+(0.036*(36)), Tz+1))*CFrame.Angles(math.rad(5*(40-i)),0,math.rad(15-(0.83*(36))))
&#9;&#9;wait()
&#9;end

&#9;for i = 1,4 do
&#9;&#9;RA.CFrame = (TM.CFrame * CFrame.new(Tx+1.5-(0.01*(36)), Ty+(0.036*(36)), Tz+1))*CFrame.Angles(math.rad(5*(36-i)),0,math.rad(15-(0.83*(36))))
&#9;&#9;wait()
&#9;end

&#9;for i = 1,4 do
&#9;&#9;RA.CFrame = (TM.CFrame * CFrame.new(Tx+1.5-(0.01*(36)), Ty+(0.036*(36)), Tz+1))*CFrame.Angles(math.rad(5*(32+i)),0,math.rad(15-(0.83*(36))))
&#9;&#9;wait()
&#9;end

&#9;for i = 1,4 do
&#9;&#9;RA.CFrame = (TM.CFrame * CFrame.new(Tx+1.5-(0.01*(36)), Ty+(0.036*(36)), Tz+1))*CFrame.Angles(math.rad(5*(36+i)),0,math.rad(15-(0.83*(36))))
&#9;&#9;wait()
&#9;end

&#9;for i = 1,4 do
&#9;&#9;RA.CFrame = (TM.CFrame * CFrame.new(Tx+1.5-(0.01*(36)), Ty+(0.036*(36)), Tz+1))*CFrame.Angles(math.rad(5*(40-i)),0,math.rad(15-(0.83*(36))))
&#9;&#9;wait()
&#9;end

&#9;for i = 1,4 do
&#9;&#9;RA.CFrame = (TM.CFrame * CFrame.new(Tx+1.5-(0.01*(36)), Ty+(0.036*(36)), Tz+1))*CFrame.Angles(math.rad(5*(36-i)),0,math.rad(15-(0.83*(36))))
&#9;&#9;wait()
&#9;end

&#9;for i = 1,4 do
&#9;&#9;RA.CFrame = (TM.CFrame * CFrame.new(Tx+1.5-(0.01*(36)), Ty+(0.036*(36)), Tz+1))*CFrame.Angles(math.rad(5*(32+i)),0,math.rad(15-(0.83*(36))))
&#9;&#9;wait()
&#9;end
&#9;
&#9;for i = 1,4 do
&#9;&#9;RA.CFrame = (TM.CFrame * CFrame.new(Tx+1.5-(0.01*(36)), Ty+(0.036*(36)), Tz+1))*CFrame.Angles(math.rad(5*(36+i)),0,math.rad(15-(0.83*(36))))
&#9;&#9;wait()
&#9;end

&#9;for i = 1,4 do
&#9;&#9;RA.CFrame = (TM.CFrame * CFrame.new(Tx+1.5-(0.01*(36)), Ty+(0.036*(36)), Tz+1))*CFrame.Angles(math.rad(5*(40-i)),0,math.rad(15-(0.83*(36))))
&#9;&#9;wait()
&#9;end

&#9;------------------------Right Arm Down
&#9;for i = 1,36 do
&#9;&#9;RA.CFrame = (TM.CFrame * CFrame.new(Tx+1.5-(0.01*(36-i)), Ty+(0.036*(36-i)), Tz+1))*CFrame.Angles(math.rad(5*(36-i)),0,math.rad(15-(0.83*(36-i))))
&#9;&#9;wait()
&#9;end

&#9;wait(1)

&#9;------------------------Head Turn
&#9;for i = 1,36 do
&#9;&#9;HM.CFrame = (TM.CFrame * CFrame.new(Tx, Ty+1.5, Tz+1))*CFrame.Angles(0,math.rad(1*i),0)
&#9;&#9;GH.CFrame = (TM.CFrame * CFrame.new(Tx, Ty+1.8, Tz+1))*CFrame.Angles(0,math.rad(1*i),0)
&#9;&#9;wait()
&#9;end

&#9;for i = 1,36 do
&#9;&#9;HM.CFrame = (TM.CFrame * CFrame.new(Tx, Ty+1.5, Tz+1))*CFrame.Angles(0,math.rad(1*(36-i)),0)
&#9;&#9;GH.CFrame = (TM.CFrame * CFrame.new(Tx, Ty+1.8, Tz+1))*CFrame.Angles(0,math.rad(1*(36-i)),0)
&#9;&#9;wait()
&#9;end

&#9;for i = 1,36 do
&#9;&#9;HM.CFrame = (TM.CFrame * CFrame.new(Tx, Ty+1.5, Tz+1))*CFrame.Angles(0,math.rad(-1*i),0)
&#9;&#9;GH.CFrame = (TM.CFrame * CFrame.new(Tx, Ty+1.8, Tz+1))*CFrame.Angles(0,math.rad(-1*i),0)
&#9;&#9;wait()
&#9;end

&#9;for i = 1,36 do
&#9;&#9;HM.CFrame = (TM.CFrame * CFrame.new(Tx, Ty+1.5, Tz+1))*CFrame.Angles(0,math.rad(-1*(36-i)),0)
&#9;&#9;GH.CFrame = (TM.CFrame * CFrame.new(Tx, Ty+1.8, Tz+1))*CFrame.Angles(0,math.rad(-1*(36-i)),0)
&#9;&#9;wait()
&#9;end

end
</ProtectedString>
