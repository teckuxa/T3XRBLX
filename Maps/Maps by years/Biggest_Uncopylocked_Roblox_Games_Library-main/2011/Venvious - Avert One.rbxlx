			<Item class="Script" referent="RBX4179">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">BigJump</string>
					<ProtectedString name="Source">local Force = Instance.new(&quot;BodyForce&quot;)
Force.Parent = script.Parent
time = 0

while true do
&#9;wait(0.2)
&#9;time = time + 1

&#9;if script.Parent.Parent:findFirstChild(&quot;GrappleGun&quot;) ~= nil then
&#9;&#9;Force.force = Vector3.new(0,0,0)
&#9;&#9;FT = script.Parent.Parent:GetChildren()
&#9;&#9;for i=1,#FT do
&#9;&#9;&#9;if FT[i].ClassName == &quot;Part&quot; then
&#9;&#9;&#9;&#9;Force.force = Force.force+Vector3.new(0, FT[i]:getMass()*140, 0)
&#9;&#9;&#9;end
&#9;&#9;&#9;if FT[i].ClassName == &quot;Hat&quot; then
&#9;&#9;&#9;&#9;Force.force = Force.force+Vector3.new(0, FT[i].Handle:getMass()*140, 0)
&#9;&#9;&#9;end
&#9;&#9;&#9;if FT[i].ClassName == &quot;Tool&quot; then
&#9;&#9;&#9;&#9;FTT = FT[i]:GetChildren()
&#9;&#9;&#9;&#9;for i=1,#FTT do
&#9;&#9;&#9;&#9;&#9;if FTT.ClassName == &quot;Part&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;Force.force = Force.force+Vector3.new(0, FTT[i]:getMass()*140, 0)
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;wait()
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;wait()
&#9;&#9;end
&#9;end

&#9;if script.Parent.Parent:findFirstChild(&quot;GrappleGun&quot;) == nil then
&#9;&#9;Force.force = Vector3.new(0,0,0)
&#9;&#9;FT = script.Parent.Parent:GetChildren()
&#9;&#9;for i=1,#FT do
&#9;&#9;&#9;if FT[i].ClassName == &quot;Part&quot; then
&#9;&#9;&#9;&#9;Force.force = Force.force+Vector3.new(0, FT[i]:getMass()*140, 0)
&#9;&#9;&#9;end
&#9;&#9;&#9;if FT[i].ClassName == &quot;Hat&quot; then
&#9;&#9;&#9;&#9;Force.force = Force.force+Vector3.new(0, FT[i].Handle:getMass()*140, 0)
&#9;&#9;&#9;end
&#9;&#9;&#9;wait()
&#9;&#9;end
&#9;end

&#9;if time == 150 then
&#9;&#9;Force:remove()
&#9;&#9;script:remove()
&#9;end

end
