&#9;&#9;&#9;&#9;&#9;script.Parent.CanCollide = false&#9;
&#9;&#9;&#9;&#9;&#9;wait(0.3)
&#9;&#9;&#9;&#9;&#9;script.Parent.CanCollide = true
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
