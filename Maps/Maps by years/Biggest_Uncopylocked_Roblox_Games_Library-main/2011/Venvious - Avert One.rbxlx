				<Item class="Script" referent="RBX2884">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">LavaScript</string>
						<ProtectedString name="Source">--script.Parent.CFrame = CFrame.new(script.Parent.Position.x,script.Parent.Position.y+0.4,script.Parent.Position.z)

function onTouched(hit)
&#9;if hit.Name == &quot;Right Leg&quot; then
&#9;&#9;local Health = game.Players:findFirstChild(hit.Parent.Name..&quot;&quot;):findFirstChild(&quot;PlayerGui&quot;):findFirstChild(&quot;ScreenGui&quot;):findFirstChild(&quot;Health&quot;)
&#9;&#9;if (Health ~= nil) and (hit.Parent:findFirstChild(&quot;Invincible&quot;) == nil) then
&#9;&#9;&#9;if (Health.Value &lt; 1) then return end
&#9;&#9;&#9;Ping = game.Lighting:findFirstChild(&quot;GuiExtras&quot;):findFirstChild(&quot;Splash&quot;):clone()
&#9;&#9;&#9;Ping.Parent = hit
&#9;&#9;&#9;Ping:Play()
&#9;&#9;&#9;Ping:Play()
&#9;&#9;&#9;wait(0.4)
&#9;&#9;&#9;Ping:remove()
&#9;&#9;&#9;Health.Value = Health.Value - 6
&#9;&#9;end
&#9;end
end

script.Parent.Touched:connect(onTouched)

while true do
&#9;for i = 1,40 do
&#9;&#9;script.Parent.CFrame = script.Parent.CFrame * CFrame.new(0, 0.05, 0)
&#9;&#9;wait()
&#9;end 
&#9;for i = 1,40 do
&#9;&#9;script.Parent.CFrame = script.Parent.CFrame * CFrame.new(0, -0.05, 0)
&#9;&#9;wait()
&#9;end 
end
</ProtectedString>
					</Properties>
				</Item>
			</Item>
