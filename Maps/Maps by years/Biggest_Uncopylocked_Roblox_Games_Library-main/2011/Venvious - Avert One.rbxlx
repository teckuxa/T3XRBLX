						<string name="Name">Script</string>
						<ProtectedString name="Source">function click()
&#9;wait(0.03)

&#9;if script.Parent.Parent.InputText.Box.Text == &quot;&quot; or script.Parent.Parent.InputText.Box.Text == &quot;Type text here and click post to send a message.&quot; then return end

&#9;if script.Parent.Parent.InputText.Box.Text == game.Workspace.Chats.Line1.Message1.Value..&quot;&quot; --[[and script.Parent.Parent.Parent.Parent.Name == game.Workspace.Chats.Line1.Speaker1.Value..&quot;&quot;]] then return end

&#9;if script.Parent.Parent.InputText.Box.Text == game.Workspace.Chats.Line2.Message1.Value..&quot;&quot; --[[and script.Parent.Parent.Parent.Parent.Name == game.Workspace.Chats.Line2.Speaker1.Value..&quot;&quot;]] then return end

&#9;if script.Parent.Parent.InputText.Box.Text == game.Workspace.Chats.Line3.Message1.Value..&quot;&quot; --[[and script.Parent.Parent.Parent.Parent.Name == game.Workspace.Chats.Line3.Speaker1.Value..&quot;&quot;]] then return end

&#9;if script.Parent.Parent.InputText.Box.Text == game.Workspace.Chats.Line4.Message1.Value..&quot;&quot; --[[and script.Parent.Parent.Parent.Parent.Name == game.Workspace.Chats.Line4.Speaker1.Value..&quot;&quot;]] then return end

&#9;if script.Parent.Parent.InputText.Box.Text == game.Workspace.Chats.Line5.Message1.Value..&quot;&quot; --[[and script.Parent.Parent.Parent.Parent.Name == game.Workspace.Chats.Line5.Speaker1.Value..&quot;&quot;]] then return end

&#9;if script.Parent.Parent.InputText.Box.Text == game.Workspace.Chats.Line6.Message1.Value..&quot;&quot; --[[and script.Parent.Parent.Parent.Parent.Name == game.Workspace.Chats.Line6.Speaker1.Value..&quot;&quot;]] then return end

&#9;if script.Parent.Parent.InputText.Box.Text == game.Workspace.Chats.Line7.Message1.Value..&quot;&quot; --[[and script.Parent.Parent.Parent.Parent.Name == game.Workspace.Chats.Line7.Speaker1.Value..&quot;&quot;]] then return end

&#9;script.Parent.Visible = false

&#9;for i=7,2,-1 do
&#9;&#9;game.Workspace.Chats[&quot;Line&quot;..i].Speaker1.Value = game.Workspace.Chats[&quot;Line&quot;..i-1].Speaker1.Value
&#9;&#9;game.Workspace.Chats[&quot;Line&quot;..i].Message1.Value = game.Workspace.Chats[&quot;Line&quot;..i-1].Message1.Value
&#9;end
&#9;game.Workspace.Chats.Line1.Speaker1.Value = script.Parent.Parent.Parent.Parent.Name
&#9;game.Workspace.Chats.Line1.Message1.Value = script.Parent.Parent.InputText.Box.Text..&quot;&quot;

&#9;script.Parent.Parent.InputText.Box.Text =&#9;&quot;Type text here and click post to send a message.&quot;

&#9;wait(3)
&#9;script.Parent.Visible = true
end
script.Parent.MouseButton1Click:connect(click)
</ProtectedString>
					</Properties>
				</Item>
