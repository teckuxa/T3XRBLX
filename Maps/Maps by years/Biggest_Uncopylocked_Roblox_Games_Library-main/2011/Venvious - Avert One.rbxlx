				<Item class="Script" referent="RBX2438">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">EnemyScript</string>
						<ProtectedString name="Source">local enemy = script.Parent
Hit = false

function Towards()
&#9;enemy.Velocity = lookAt * 16
&#9;if enemy then 
&#9;&#9;lookAt = (tor.Position - enemy.Position).unit 
&#9;&#9;distance = (tor.Position - enemy.Position).magnitude 
&#9;end 
end

function Away()
&#9;enemy.Velocity = lookAt * -16
&#9;if enemy then 
&#9;&#9;lookAt = (tor.Position - enemy.Position).unit 
&#9;&#9;distance = (tor.Position - enemy.Position).magnitude 
&#9;end 
end

function Stay()
&#9;enemy.Velocity = Vector3.new(0,0,0)
&#9;if enemy then 
&#9;&#9;lookAt = (tor.Position - enemy.Position).unit 
&#9;&#9;distance = (tor.Position - enemy.Position).magnitude 
&#9;end 
end

function getTor()
&#9;local p = game.Players:GetChildren()
&#9;for i = 1,#p do
&#9;&#9;if p[i].Character ~= nil then
&#9;&#9;&#9;local torso = p[i].Character:findFirstChild(&quot;Torso&quot;)
&#9;&#9;&#9;if torso ~= nil then
&#9;&#9;&#9;&#9;if (p[i].Character.Torso.Position - script.Parent.Position).magnitude &lt; 30 and (p[i].Character:findFirstChild(&quot;Invisible&quot;) == nil) then
&#9;&#9;&#9;&#9;&#9;tor = p[i].Character.Torso
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;if (p[i].Character.Torso.Position - script.Parent.Position).magnitude &gt;= 30 then
&#9;&#9;&#9;&#9;&#9;tor = nil
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

function onTouched(hit)
&#9;if hit.Name == &quot;Torso&quot; or hit.Name == &quot;Right Arm&quot; or hit.Name == &quot;Left Arm&quot; then
&#9;&#9;local Health = game.Players:findFirstChild(hit.Parent.Name..&quot;&quot;):findFirstChild(&quot;PlayerGui&quot;):findFirstChild(&quot;ScreenGui&quot;):findFirstChild(&quot;Health&quot;)
&#9;&#9;if (Health ~= nil) and (hit.Parent:findFirstChild(&quot;Invincible&quot;) == nil) and (hit.Parent:findFirstChild(&quot;Invisible&quot;) == nil) then
&#9;&#9;&#9;if (Health.Value &lt; 1) then return end
&#9;&#9;&#9;Health.Value = Health.Value - 1
&#9;&#9;&#9;Hit = true
&#9;&#9;&#9;wait(2)
&#9;&#9;&#9;Hit = false
&#9;&#9;&#9;else if (Health ~= nil) and (hit.Parent:findFirstChild(&quot;Invincible&quot;) ~= nil) and (hit.Parent:findFirstChild(&quot;Invisible&quot;) == nil) then
&#9;&#9;&#9;&#9;Hit = true
&#9;&#9;&#9;&#9;wait(2)
&#9;&#9;&#9;&#9;Hit = false
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;else if hit.Name == &quot;Bolt&quot; then
&#9;&#9;&#9;Hit = true
&#9;&#9;&#9;wait(2)
&#9;&#9;&#9;Hit = false
&#9;&#9;end
&#9;end
end

script.Parent.Touched:connect(onTouched)

while enemy do 
&#9;getTor()
&#9;if tor ~= nil then
&#9;&#9;distance = (enemy.Position - tor.Position).magnitude 
&#9;&#9;lookAt = (tor.Position - enemy.Position).unit 
&#9;&#9;if Hit == true and distance &lt; 20 then
&#9;&#9;&#9;Away()
&#9;&#9;end
&#9;&#9;if Hit == false then
&#9;&#9;&#9;Towards()
&#9;&#9;end&#9;
&#9;&#9;if Hit == true and distance &gt;= 20 then
&#9;&#9;&#9;Stay()
&#9;&#9;end 
&#9;end
&#9;wait() 
end 
</ProtectedString>
					</Properties>
				</Item>
			</Item>
