				<Item class="Script" referent="RBX3434">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">GirderScript</string>
						<ProtectedString name="Source">local P = script.Parent:GetChildren()

while true do
&#9;for i = 1,80 do
&#9;&#9;for g = 1,#P do
&#9;&#9;&#9;if P[g].ClassName == &quot;Part&quot; then
&#9;&#9;&#9;&#9;P[g].CFrame = P[g].CFrame * CFrame.new(0, -0.019, 0)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;wait()
&#9;end 
&#9;wait(0.5)
&#9;for i = 1,80 do
&#9;&#9;for g = 1,#P do
&#9;&#9;&#9;if P[g].ClassName == &quot;Part&quot; then
&#9;&#9;&#9;&#9;P[g].CFrame = P[g].CFrame * CFrame.new(0, 0.019, 0)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;wait()
&#9;end 
&#9;wait(0.5)
end
</ProtectedString>
					</Properties>
