			<Item class="Script" referent="RBX3547">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">TeleScript</string>
					<ProtectedString name="Source">function onTouched(hit)
&#9;if hit.Name == &quot;Right Leg&quot; then
&#9;&#9;tor = hit.Parent:findFirstChild(&quot;Torso&quot;)
