							<ProtectedString name="Source">function onTouched(hit)
&#9;if hit.Name == &quot;Torso&quot; or hit.Name == &quot;Right Leg&quot; or hit.Name == &quot;Left Leg&quot; then
&#9;&#9;local Health = game.Players:findFirstChild(hit.Parent.Name..&quot;&quot;):findFirstChild(&quot;PlayerGui&quot;):findFirstChild(&quot;ScreenGui&quot;):findFirstChild(&quot;Health&quot;)
&#9;&#9;if (Health ~= nil) and (hit.Parent:findFirstChild(&quot;Invincible&quot;) == nil) then
&#9;&#9;&#9;if (Health.Value &lt; 1) then return end
&#9;&#9;&#9;Health.Value = Health.Value - 1
&#9;&#9;end
&#9;end
end

script.Parent.Touched:connect(onTouched)

while true do
&#9;wait(3)
&#9;for i = 1,20,1 do
&#9;&#9;script.Parent.CFrame = script.Parent.CFrame * CFrame.new(0, -0.25, 0)
&#9;&#9;wait()
&#9;end 
&#9;wait(3)
&#9;for i = 1,20,1 do
&#9;&#9;script.Parent.CFrame = script.Parent.CFrame * CFrame.new(0, 0.25, 0)
&#9;&#9;wait()
&#9;end 
end
</ProtectedString>
