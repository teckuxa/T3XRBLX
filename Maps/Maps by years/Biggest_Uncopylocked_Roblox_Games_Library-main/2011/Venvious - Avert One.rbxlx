			<Item class="Script" referent="RBX4181">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Shield</string>
					<ProtectedString name="Source">local Hat = Instance.new(&quot;Hat&quot;)
Hat.AttachmentPos = Vector3.new(0, 1.2, 3.1)
Hat.Name = &quot;Shield&quot;
local Handle = Instance.new(&quot;Part&quot;)
Handle.FormFactor = &quot;Custom&quot;
Handle.BottomSurface = 0
Handle.TopSurface = 0
Handle.Size = Vector3.new(4,3.8,3)
Handle.Transparency = 0.9
Handle.BrickColor = BrickColor.new(&quot;Lime green&quot;)
Handle.Name = &quot;Handle&quot;
Handle.Position = script.Parent:findFirstChild(&quot;Head&quot;).Position
Handle.Parent = Hat
local Mesh = Instance.new(&quot;SpecialMesh&quot;)
Mesh.Parent = Handle
Mesh.Scale = Vector3.new(1,1,0.05)
Mesh.MeshType = &quot;Brick&quot;
Hat.Parent = script.Parent

function onTouched(hit)
&#9;if (hit.Name == &quot;Averter&quot;) and (hit.BodyVelocity ~= nil) then
&#9;&#9;Handle.Transparency = 0.85
&#9;&#9;wait(0.05)
&#9;&#9;Handle.Transparency = 0.8
&#9;&#9;wait(0.05)
&#9;&#9;Handle.Transparency = 0.85
&#9;&#9;wait(0.05)
&#9;&#9;Handle.Transparency = 0.9
&#9;end
end

Handle.Touched:connect(onTouched)


wait(30)

Hat:remove()
script:remove()
</ProtectedString>
