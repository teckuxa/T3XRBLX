								<ProtectedString name="Source">Zmain = script.Parent.Position.Z

function onChanged() 
&#9;if script.Parent.Interact.Value == true then
&#9;&#9;script.Parent.Reflectance = 1
&#9;&#9;script.Parent.CFrame = CFrame.new(script.Parent.Position.X,script.Parent.Position.Y,Zmain+0.2)
&#9;&#9;wait(3.5)
&#9;&#9;script.Parent.Ping.Pitch = 3 
&#9;&#9;script.Parent.Ping:Play()
&#9;&#9;script.Parent.Reflectance = 0.7
&#9;&#9;wait(0.2)
&#9;&#9;script.Parent.Ping.Pitch = 2 
&#9;&#9;script.Parent.Ping:Play()
&#9;&#9;script.Parent.Reflectance = 1
&#9;&#9;wait(0.6)
&#9;&#9;script.Parent.Ping.Pitch = 3 
&#9;&#9;script.Parent.Ping:Play()
&#9;&#9;script.Parent.Reflectance = 0.7
&#9;&#9;wait(0.2)
&#9;&#9;script.Parent.Ping.Pitch = 2 
&#9;&#9;script.Parent.Ping:Play()
&#9;&#9;script.Parent.Reflectance = 1
&#9;&#9;wait(0.6)
&#9;&#9;script.Parent.Ping.Pitch = 0.5 
&#9;&#9;script.Parent.Ping:Play()
&#9;&#9;wait(0.2)
&#9;&#9;script.Parent.Reflectance = 0
&#9;&#9;script.Parent.CFrame = CFrame.new(script.Parent.Position.X,script.Parent.Position.Y,Zmain)
&#9;&#9;script.Parent.Interact.Value = false
&#9;end
end 

script.Parent.Interact.Changed:connect(onChanged) 
</ProtectedString>
