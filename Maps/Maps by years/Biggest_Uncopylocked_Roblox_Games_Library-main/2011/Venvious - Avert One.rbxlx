						<string name="Name">Scene</string>
						<ProtectedString name="Source">while true do
&#9;wait()
&#9;local p = game.Players:GetChildren()
&#9;for i = 1,#p do
&#9;&#9;if p[i].Character ~= nil then
&#9;&#9;&#9;local torso = p[i].Character:findFirstChild(&quot;Torso&quot;)
&#9;&#9;&#9;if torso ~= nil then
&#9;&#9;&#9;&#9;Com = p[i]:findFirstChild(&quot;PlayerGui&quot;):findFirstChild(&quot;ScreenGui&quot;):findFirstChild(&quot;MainInterface&quot;):findFirstChild(&quot;ComPanel&quot;)
&#9;&#9;&#9;&#9;GG = p[i]:findFirstChild(&quot;PlayerGui&quot;):findFirstChild(&quot;GameGui&quot;)
&#9;&#9;&#9;&#9;if (p[i].Character.Torso.Position - script.Parent.Position).magnitude &lt; 8 and Com:findFirstChild(&quot;LessonsLearned&quot;).Value &lt; 7 then
&#9;&#9;&#9;&#9;&#9;Com:findFirstChild(&quot;LessonsLearned&quot;).Value = 7
&#9;&#9;&#9;&#9;&#9;LS = script:findFirstChild(&quot;BossGui&quot;):clone()
&#9;&#9;&#9;&#9;&#9;LS.Parent = GG
&#9;&#9;&#9;&#9;&#9;LS.Visible = true
&#9;&#9;&#9;&#9;&#9;LS:findFirstChild(&quot;LocalScript&quot;).Disabled = false
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end
