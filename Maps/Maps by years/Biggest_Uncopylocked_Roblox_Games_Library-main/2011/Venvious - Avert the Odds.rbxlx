&#9;LAweld.C1 = CFrame.new(-0.35, 1.1, 1) * CFrame.fromEulerAnglesXYZ(math.rad(290), -0.15, math.rad(-90))
&#9;RAweld.C1 = CFrame.new(-0.6, 0.5, 0.46) * CFrame.fromEulerAnglesXYZ(math.rad(-120), math.rad(-15), 0)
&#9;wait(0.08/rSpeed)
----------------------------------------------------------------------- Remove Clip
&#9;for i = 1,10 do
&#9;&#9;LAweld.C1 = CFrame.new(-0.35, 1.1, 1) * CFrame.fromEulerAnglesXYZ(math.rad(290), (-0.15)-(0.05*i), math.rad(-90))
&#9;&#9;wait(0.08/rSpeed)
&#9;end
&#9;LAweld.C1 = CFrame.new(-0.35, 1.1, 1) * CFrame.fromEulerAnglesXYZ(math.rad(290), -0.7, math.rad(-90))
&#9;wait(0.08/rSpeed)
&#9;for i = 1,10 do
&#9;&#9;LAweld.C1 = CFrame.new(-0.35, 1.1, 1) * CFrame.fromEulerAnglesXYZ(math.rad(290), (-0.7)+(0.05*i), math.rad(-90))
&#9;&#9;wait(0.08/rSpeed)
&#9;end
----------------------------------------------------------------------- 
&#9;LAweld.C1 = CFrame.new(-0.35, 1.1, 1) * CFrame.fromEulerAnglesXYZ(math.rad(290), -0.15, math.rad(-90))
