							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">UpgradeMenuScript</string>
							<ProtectedString name="Source">local Val1 = script.Parent:findFirstChild(&quot;WepSlots&quot;)
local Val2 = script.Parent:findFirstChild(&quot;Strength&quot;)
local Val3 = script.Parent:findFirstChild(&quot;Intelligence&quot;)
local Val4 = script.Parent:findFirstChild(&quot;UPs&quot;)

local Txt1 = script.Parent:findFirstChild(&quot;WepSlotsText&quot;)
local Txt2 = script.Parent:findFirstChild(&quot;StrengthText&quot;)
local Txt3 = script.Parent:findFirstChild(&quot;IntelligenceText&quot;)
local Txt4 = script.Parent:findFirstChild(&quot;UpgradesText&quot;)

Val1.changed:connect(function(oc)
&#9;Txt1.Text = &quot;Weapon Slots: &quot;..Val1.Value
end)
Val2.changed:connect(function(oc)
&#9;Txt2.Text = &quot;Strength: &quot;..Val2.Value
end)
Val3.changed:connect(function(oc)
&#9;Txt3.Text = &quot;Intelligence: &quot;..Val3.Value
end)
Val4.changed:connect(function(oc)
&#9;Txt4.Text = &quot;Upgrade Points: &quot;..Val4.Value
end)
</ProtectedString>
						</Properties>
