								<string name="Name">SpawnScript</string>
								<ProtectedString name="Source">local GF = script.Parent.Parent.Parent

local Char
local Player
local Tor
local FakeHum
local Heath
local MaxHealth

local Main = script.Parent

local ClickS = Main.Parent:findFirstChild(&quot;ClickScript&quot;)

local Sp1 = Main:findFirstChild(&quot;Spawn1&quot;)
local Sp2 = Main:findFirstChild(&quot;Spawn2&quot;)
local Sp3 = Main:findFirstChild(&quot;Spawn3&quot;)
local Sp4 = Main:findFirstChild(&quot;Spawn4&quot;)
local EGW = Main.Parent:findFirstChild(&quot;EnterGameWarning&quot;)

local CSP = EGW:findFirstChild(&quot;CurSpawnPos&quot;)
local BackB = EGW:findFirstChild(&quot;BackButton&quot;)
local OkayB = EGW:findFirstChild(&quot;OkayButton&quot;)
local UpdateWeps = EGW:findFirstChild(&quot;UpdateWeapons&quot;)
local AmountWeps = EGW:findFirstChild(&quot;AmountWeapons&quot;)
local ButtonWeps = EGW:findFirstChild(&quot;WepList&quot;)

Sp1.MouseButton1Click:connect(function(oc)
&#9;ClickS.Disabled = true
&#9;CSP.Value =  Vector3.new(127, 58, 188)
&#9;UpdateWeps.Value = true
&#9;EGW.Visible = true
&#9;wait(0.1)
&#9;UpdateWeps.Value = false
end)
Sp2.MouseButton1Click:connect(function(oc)
&#9;ClickS.Disabled = true
&#9;CSP.Value =  Vector3.new(40, 46, 195)
&#9;UpdateWeps.Value = true
&#9;EGW.Visible = true
&#9;wait(0.1)
&#9;UpdateWeps.Value = false
end)
Sp3.MouseButton1Click:connect(function(oc)
&#9;ClickS.Disabled = true
&#9;CSP.Value =  Vector3.new(185, 58, 62)
&#9;UpdateWeps.Value = true
&#9;EGW.Visible = true
&#9;wait(0.1)
&#9;UpdateWeps.Value = false
end)
Sp4.MouseButton1Click:connect(function(oc)
&#9;ClickS.Disabled = true
&#9;CSP.Value =  Vector3.new(100, 46, 75)
&#9;UpdateWeps.Value = true
&#9;EGW.Visible = true
&#9;wait(0.1)
&#9;UpdateWeps.Value = false
end)

BackB.MouseButton1Click:connect(function(oc)
&#9;EGW.Visible = false
&#9;ClickS.Disabled = false
end)
OkayB.MouseButton1Click:connect(function(oc)
&#9;if AmountWeps.Value &gt; 3 or AmountWeps.Value &lt; 1 then return end
&#9;Player = GF.Parent.Parent.Parent
&#9;Char = GF.Parent.Parent.Parent.Character
&#9;Tor = Char:findFirstChild(&quot;Torso&quot;)
&#9;FakeHum = Char:findFirstChild(&quot;FakeHumanoid&quot;)
&#9;Health = FakeHum:findFirstChild(&quot;Health&quot;)
&#9;MaxHealth = FakeHum:findFirstChild(&quot;MaxHealth&quot;)
&#9;if not Player or not Char or not Tor or not FakeHum or not Health or not MaxHealth then return end
&#9;local FF = Instance.new(&quot;ForceField&quot;)
&#9;local RemoveS = Main.Parent:findFirstChild(&quot;RemoveScript&quot;):clone()
&#9;RemoveS.Parent = FF
&#9;RemoveS.Disabled = false
&#9;FF.Parent = Char
&#9;local PWeps = ButtonWeps:GetChildren()
&#9;for pw = 1,#PWeps do
&#9;&#9;if PWeps[pw].ClassName == &quot;TextButton&quot; then
&#9;&#9;&#9;if PWeps[pw].TextColor3 == OkayB.BorderColor3 then
&#9;&#9;&#9;&#9;GF:findFirstChild(&quot;PlayerWeps&quot;):findFirstChild(&quot;&quot;..PWeps[pw].Name):clone().Parent = Player:findFirstChild(&quot;Backpack&quot;)&#9;&#9;
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;Health.Value = MaxHealth.Value
&#9;EGW.Visible = false
&#9;ClickS.Disabled = false
&#9;Tor.CFrame = CFrame.new(CSP.Value)
&#9;Main.Visible = false
&#9;GF.Visible = false
&#9;script.Disabled = true
end)</ProtectedString>
