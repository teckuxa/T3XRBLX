				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Leaderboard</string>
				<ProtectedString name="Source">local Time = script:findFirstChild(&quot;StageTime&quot;)
local NewGame = script:findFirstChild(&quot;NewGame&quot;)
local StageNum = script:findFirstChild(&quot;StageNumber&quot;)
local StyleNum = script:findFirstChild(&quot;StyleNumber&quot;)

local GM = nil

local NumberOfMaps = 8
local StageMin = 5

function onPlayerEntered(newPlayer) 
&#9;repeat wait() until newPlayer.PlayerGui:findFirstChild(&quot;GameGui&quot;) ~= nil
&#9;local stats = Instance.new(&quot;IntValue&quot;) 
&#9;stats.Name = &quot;leaderstats&quot;

&#9;local Val1 = Instance.new(&quot;IntValue&quot;)
&#9;Val1.Name = &quot;KOs&quot; 
&#9;Val1.Value = 0

&#9;local Val2 = Instance.new(&quot;IntValue&quot;)
&#9;Val2.Name = &quot;WOs&quot; 
&#9;Val2.Value = 0

&#9;Val2.Parent = stats 
&#9;Val1.Parent = stats 
&#9;stats.Parent = newPlayer 

&#9;newPlayer.Changed:connect(function (property)
&#9;&#9;if (property == &quot;Character&quot;) then
&#9;&#9;&#9;onPlayerRespawned(newPlayer)
&#9;&#9;end
&#9;end)
end 

function onPlayerRespawned(player)
&#9;repeat wait() until player.PlayerGui:findFirstChild(&quot;GameGui&quot;) ~= nil

&#9;player.Changed:connect(function (property)
&#9;&#9;if (property == &quot;Character&quot;) then
&#9;&#9;&#9;onPlayerRespawned(player)
&#9;&#9;end
&#9;end)
end

game.Players.ChildAdded:connect(onPlayerEntered) 

function getMode()
&#9;g = math.random(1,3)
&#9;if g == 1 or g == 2 then
&#9;&#9;StyleNum.Value = 1
&#9;&#9;local Tm = game.Teams:GetChildren()
&#9;&#9;for t = 1,#Tm do
&#9;&#9;&#9;if Tm[t].ClassName == &quot;Team&quot; then
&#9;&#9;&#9;&#9;Tm[t]:remove()
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;local Team1 = Instance.new(&quot;Team&quot;)
&#9;&#9;Team1.TeamColor = BrickColor.new(&quot;Bright yellow&quot;)
&#9;&#9;Team1.AutoAssignable = false
&#9;&#9;Team1.AutoColorCharacters = false
&#9;&#9;Team1.Name = &quot;X&quot;
&#9;&#9;Team1.Parent = game.Teams
&#9;&#9;local Team2 = Instance.new(&quot;Team&quot;)
&#9;&#9;Team2.TeamColor = BrickColor.new(&quot;Bright red&quot;)
&#9;&#9;Team2.AutoAssignable = false
&#9;&#9;Team2.AutoColorCharacters = false
&#9;&#9;Team2.Name = &quot;Z&quot;
&#9;&#9;Team2.Parent = game.Teams

&#9;elseif g == 3 then
&#9;&#9;StyleNum.Value = 2
&#9;&#9;local Tm = game.Teams:GetChildren()
&#9;&#9;for t = 1,#Tm do
&#9;&#9;&#9;if Tm[t].ClassName == &quot;Team&quot; then
&#9;&#9;&#9;&#9;Tm[t]:remove()
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

function runStage()
&#9;local min = StageMin
&#9;local sec = 0
&#9;for i = 1, (sec + (min * 60) + 1) do
&#9;&#9;Time.Value = Vector3.new(0,min,sec)
&#9;&#9;wait(1)
&#9;&#9;if sec &gt; 0 then
&#9;&#9;&#9;sec = sec - 1
&#9;&#9;elseif sec == 0 and min ~= 0 then
&#9;&#9;&#9;sec = 59
&#9;&#9;&#9;min = min - 1
&#9;&#9;elseif sec == 0 and min == 0 then
&#9;&#9;&#9;print(&quot;Ended&quot;)
&#9;&#9;end
&#9;end
end

while true do
&#9;wait()
----------------------------------------------------------------------- Maps
&#9;for i = 1,NumberOfMaps do
&#9;&#9;NewGame.Value = true
&#9;&#9;local min = 0
&#9;&#9;local sec = 8
&#9;&#9;Time.Value = Vector3.new(0,min,sec)
&#9;&#9;wait(1)
&#9;&#9;sec = 7
&#9;&#9;Time.Value = Vector3.new(0,min,sec)
&#9;&#9;wait(1)
&#9;&#9;sec = 6
&#9;&#9;Time.Value = Vector3.new(0,min,sec)
&#9;&#9;wait(1)
&#9;&#9;sec = 5
&#9;&#9;Time.Value = Vector3.new(0,min,sec)
&#9;&#9;wait(1)
&#9;&#9;sec = 4
&#9;&#9;Time.Value = Vector3.new(0,min,sec)
&#9;&#9;wait(1)
&#9;&#9;sec = 3
&#9;&#9;Time.Value = Vector3.new(0,min,sec)
&#9;&#9;wait(1)
&#9;&#9;if GM ~= nil then
&#9;&#9;&#9;GM:remove()
&#9;&#9;end
&#9;&#9;StageNum.Value = i
&#9;&#9;sec = 2
&#9;&#9;Time.Value = Vector3.new(0,min,sec)
&#9;&#9;wait(1)
&#9;&#9;GM = game.Lighting:findFirstChild(&quot;GameMaps&quot;):findFirstChild(&quot;GameMap&quot;..StageNum.Value):clone()
&#9;&#9;GM.Parent = Game.Workspace
&#9;&#9;sec = 1
&#9;&#9;Time.Value = Vector3.new(0,min,sec)
&#9;&#9;getMode()
&#9;&#9;wait(1)
&#9;&#9;sec = 0
&#9;&#9;Time.Value = Vector3.new(0,min,sec)
&#9;&#9;NewGame.Value = false
&#9;&#9;runStage()
&#9;end
end
