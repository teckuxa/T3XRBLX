							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Paintball</string>
							<ProtectedString name="Source">local ball = script.Parent
local damage = script.Parent:findFirstChild(&quot;Damage&quot;)
local isHit = false
local FakeHum
local EnemyPlayer

function onTouched(hit)
&#9;if hit.Parent.ClassName == &quot;Tool&quot; or isHit == true or hit.Name == &quot;Bullet&quot; then return end
&#9;isHit = true
&#9;ball.Velocity = Vector3.new(0,0,0)
&#9;if hit.Parent.ClassName == &quot;Hat&quot; then
&#9;&#9;FakeHum = hit.Parent.Parent:findFirstChild(&quot;FakeHumanoid&quot;)
&#9;else
&#9;&#9;FakeHum = hit.Parent:findFirstChild(&quot;FakeHumanoid&quot;)
&#9;end
&#9;if FakeHum ~= nil then
&#9;&#9;if hit.Parent.ClassName == &quot;Hat&quot; then
&#9;&#9;&#9;EnemyPlayer = game.Players:findFirstChild(hit.Parent.Parent.Name..&quot;&quot;)
&#9;&#9;else
&#9;&#9;&#9;EnemyPlayer = game.Players:findFirstChild(hit.Parent.Name..&quot;&quot;)
&#9;&#9;end
&#9;&#9;local LocalPlayer = ball:findFirstChild(&quot;creator&quot;).Value
&#9;&#9;local FF = FakeHum.Parent:findFirstChild(&quot;ForceField&quot;)
&#9;&#9;if EnemyPlayer ~= nil and LocalPlayer ~= nil and FF == nil then
&#9;&#9;&#9;if EnemyPlayer.Neutral == true or EnemyPlayer.TeamColor ~= LocalPlayer.TeamColor then
&#9;&#9;&#9;&#9;tagFakeHum(FakeHum)
&#9;&#9;&#9;&#9;FakeHum:findFirstChild(&quot;Health&quot;).Value = (FakeHum:findFirstChild(&quot;Health&quot;).Value - damage.Value)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;if hit.Name == &quot;Glass&quot; then
&#9;&#9;breakGlass(hit)
&#9;end
&#9;connection:disconnect()
&#9;ball:remove()
end

function tagFakeHum(FakeHum)
&#9;if FakeHum ~= nil then 
&#9;&#9;local oldTag = FakeHum:findFirstChild(&quot;creator&quot;)
&#9;&#9;if oldTag ~= nil then
&#9;&#9;&#9;oldTag:remove()
&#9;&#9;end
&#9;&#9;local tag = ball:findFirstChild(&quot;creator&quot;)
&#9;&#9;if tag ~= nil then
&#9;&#9;&#9;local creatorTag = tag:clone()
&#9;&#9;&#9;creatorTag.Parent = FakeHum
&#9;&#9;end&#9;
&#9;end
end

function breakGlass(hit)
&#9;local hBC = hit.BrickColor
&#9;local hRF = hit.Reflectance 
&#9;local hTR = hit.Transparency
&#9;local hPX = hit.Position.X
&#9;local hPY = hit.Position.Y
&#9;local hPZ = hit.Position.Z
&#9;local hSX = hit.Size.X
&#9;local hSY = hit.Size.Y
&#9;local hSZ = hit.Size.Z
&#9;local a, b, c = hit.CFrame:toEulerAnglesXYZ()
&#9;local RotVal = Vector3.new(math.deg(a), math.deg(b), math.deg(c))
&#9;hit:remove()
&#9;for i1 = 0, hit.Size.X-1 do
&#9;&#9;for i2 = 0, hit.Size.Y-1 do
&#9;&#9;&#9;for i3 = 0, hit.Size.Z-1 do
&#9;&#9;&#9;&#9;local NP = Instance.new(&quot;Part&quot;)
&#9;&#9;&#9;&#9;NP.FormFactor = 0
&#9;&#9;&#9;&#9;NP.Size = Vector3.new(1,1,1)
&#9;&#9;&#9;&#9;NP.Velocity = Vector3.new(math.random(-40,40),math.random(-40,40),math.random(-40,40))
&#9;&#9;&#9;&#9;NP.BrickColor = hBC 
&#9;&#9;&#9;&#9;NP.Shape = 1
&#9;&#9;&#9;&#9;NP.BottomSurface = 0
&#9;&#9;&#9;&#9;NP.TopSurface = 0
&#9;&#9;&#9;&#9;NP.Reflectance = hRF
&#9;&#9;&#9;&#9;NP.Transparency = hTR
&#9;&#9;&#9;&#9;NP.CanCollide = false
&#9;&#9;&#9;&#9;NP.CFrame = CFrame.new((hPX-((hSX-1)/2)+i1),(hPY-((hSY-1)/2)+i2),(hPZ-((hSZ-1)/2)+i3)) * CFrame.fromEulerAnglesXYZ(math.rad(RotVal.x), math.rad(RotVal.y), math.rad(RotVal.z))
&#9;&#9;&#9;&#9;NP.Parent = game.Workspace
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

connection = ball.Touched:connect(onTouched)

wait(0.5)
ball:remove()

--Venvious[Based From Roblox&apos;s Original Script]--</ProtectedString>
