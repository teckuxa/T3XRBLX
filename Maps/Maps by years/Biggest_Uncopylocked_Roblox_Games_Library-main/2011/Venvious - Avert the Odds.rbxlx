					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">ConnectChat</string>
					<ProtectedString name="Source">function shift(newspeaker,newmsg)
for i=7,2,-1 do
script.Parent[&quot;Line&quot;..i].Speaker1.Value=script.Parent[&quot;Line&quot;..i-1].Speaker1.Value
script.Parent[&quot;Line&quot;..i].Message1.Value=script.Parent[&quot;Line&quot;..i-1].Message1.Value
end
script.Parent.Line1.Speaker1.Value=newspeaker.Name
script.Parent.Line1.Message1.Value=newmsg
end

function onChatted(msg,speaker)
print(speaker.Name..&quot; said: &quot;..msg)
if msg == &quot;/EndGame&quot; then
if speaker.Name == &quot;Venvious&quot; then
local p = game.Players:GetChildren()
for i = 1,#p do
p[i]:remove()
end
end
end
shift(speaker,msg)
end

game.Players.PlayerAdded:connect(function(player)
player.Chatted:connect(function(msg)
onChatted(msg, player) 
end)
player.CharacterAdded:connect(function()
repeat wait() until player:findFirstChild(&quot;PlayerGui&quot;)
gu=script.Parent.ChatGui:clone()
gu.Parent=player.PlayerGui
end)
end)</ProtectedString>
