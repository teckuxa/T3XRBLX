				<Item class="Script" referent="RBX538">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Respawn</string>
						<ProtectedString name="Source">repeat wait() until script.Parent.Parent.Parent.Parent.Character:findFirstChild(&quot;FakeHumanoid&quot;) ~= nil

local Char = script.Parent.Parent.Parent.Parent.Character
local Player = script.Parent.Parent.Parent.Parent
local Tor = Char:findFirstChild(&quot;Torso&quot;)
local Hum = Char:findFirstChild(&quot;FakeHumanoid&quot;)
local Health1 = Hum:findFirstChild(&quot;Health&quot;)
local Health2 = Hum:findFirstChild(&quot;MaxHealth&quot;)
local Marker = game.Lighting:findFirstChild(&quot;GameParts&quot;):findFirstChild(&quot;DeathMarker&quot;):findFirstChild(&quot;Marker&quot;)
local Reset = script.Parent:findFirstChild(&quot;Reset&quot;)

local GF = script.Parent.Parent:findFirstChild(&quot;GameFiles&quot;)
local GStats = GF:findFirstChild(&quot;GameStats&quot;)
local GWOs = GStats:findFirstChild(&quot;WOs&quot;)
local GKOs = GStats:findFirstChild(&quot;KOs&quot;)

local LStats = Player:findFirstChild(&quot;leaderstats&quot;)
local LWOs = LStats:findFirstChild(&quot;WOs&quot;)
local LKOs = LStats:findFirstChild(&quot;KOs&quot;)

Reset.MouseButton1Click:connect(function(oc)
&#9;if GF.Visible == false then
&#9;&#9;Health1.Value = 0
&#9;end
end)

function resetPlayer()
&#9;LWOs.Value = LWOs.Value + 1
&#9;GWOs.Value = GWOs.Value + 1
&#9;OldMarker = Char:findFirstChild(&quot;Marker&quot;)
&#9;if OldMarker ~= nil then
&#9;&#9;OldMarker:remove()
&#9;end
&#9;NMarker = Marker:clone()
&#9;NMarker.Parent = Char 
&#9;NMarker.DogTags.Head.CFrame = Tor.CFrame * CFrame.new(0,-2,0)
&#9;NMarker.DogTags.Head.RotateScript.Disabled = false
&#9;NMarker.DogTags.Name = &quot;[&quot;..Char.Name..&quot;DeathMarker]&quot;&#9;&#9;
----------------------------------------------------------------------- Back to the Lobby
&#9;Tor.CFrame = CFrame.new(math.random(84,96), 6.5, math.random(122,134))

----------------------------------------------------------------------- Take Weapons Away Check 1
&#9;local P = Char:GetChildren()
&#9;for i = 1,#P do
&#9;&#9;if P[i].ClassName == &quot;Tool&quot; then
&#9;&#9;&#9;P[i].Parent = Player.Backpack
&#9;&#9;end
&#9;end
&#9;wait()
&#9;local G = Player.Backpack:GetChildren()
&#9;for j = 1,#G do
&#9;&#9;if G[j].ClassName == &quot;Tool&quot; then
&#9;&#9;&#9;G[j].Parent = nil
&#9;&#9;end
&#9;end

----------------------------------------------------------------------- Reset Interface/Health
&#9;GF:findFirstChild(&quot;GameFile1&quot;).Visible = true
&#9;GF:findFirstChild(&quot;GameFile2&quot;).Visible = false
&#9;GF:findFirstChild(&quot;GameFile3&quot;).Visible = false
&#9;GF.Visible = true
&#9;wait(0.5)
&#9;Health1.Value = Health2.Value

----------------------------------------------------------------------- Take Weapons Away Check 2
&#9;local P = Char:GetChildren()
&#9;for i = 1,#P do
&#9;&#9;if P[i].ClassName == &quot;Tool&quot; then
&#9;&#9;&#9;P[i].Parent = Player.Backpack
&#9;&#9;end
&#9;end
&#9;wait()
&#9;local G = Player.Backpack:GetChildren()
&#9;for j = 1,#G do
&#9;&#9;if G[j].ClassName == &quot;Tool&quot; then
&#9;&#9;&#9;G[j].Parent = nil
&#9;&#9;end
&#9;end
end

while true do
&#9;wait()
&#9;if Health1.Value &gt;= 1 then
&#9;&#9;Char:findFirstChild(&quot;Humanoid&quot;).Health = 100*(Health1.Value/Health2.Value)

&#9;&#9;else if Health1.Value &lt; 1 then
&#9;&#9;&#9;Char:findFirstChild(&quot;Humanoid&quot;).Health = 1
----------------------------------------------------------------------- Find Killer
&#9;&#9;&#9;local tag = Hum:findFirstChild(&quot;creator&quot;)
&#9;&#9;&#9;if tag ~= nil then
&#9;&#9;&#9;&#9;local killer = tag.Value
&#9;&#9;&#9;&#9;if killer ~= nil then
&#9;&#9;&#9;&#9;&#9;local eLKOs = killer:findFirstChild(&quot;leaderstats&quot;):findFirstChild(&quot;KOs&quot;)
&#9;&#9;&#9;&#9;&#9;local eGKOs = killer:findFirstChild(&quot;PlayerGui&quot;):findFirstChild(&quot;GameGui&quot;):findFirstChild(&quot;GameFiles&quot;):findFirstChild(&quot;GameStats&quot;):findFirstChild(&quot;KOs&quot;)
&#9;&#9;&#9;&#9;&#9;if eLKOs ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;eLKOs.Value = eLKOs.Value + 1
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;if eGKOs ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;eGKOs.Value = eGKOs.Value + 1
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;tag:remove()
&#9;&#9;&#9;end
&#9;&#9;&#9;resetPlayer()
&#9;&#9;end
&#9;end
end
</ProtectedString>
					</Properties>
				</Item>
				<Item class="LocalScript" referent="RBX539">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">GameValues</string>
						<ProtectedString name="Source">repeat wait() until script.Parent.Parent.Parent.Parent.Character:findFirstChild(&quot;FakeHumanoid&quot;) ~= nil

local Char = script.Parent.Parent.Parent.Parent.Character
local Hum = Char:findFirstChild(&quot;FakeHumanoid&quot;)
local Health1 = Hum:findFirstChild(&quot;Health&quot;)
local Health2 = Hum:findFirstChild(&quot;MaxHealth&quot;)
local GotTool = false
local CurTul 
local Ammo1
local Ammo2

local Bar1 = script.Parent:findFirstChild(&quot;Bar1Top&quot;)
local Bar2 = script.Parent:findFirstChild(&quot;Bar2Top&quot;)
local Text1 = script.Parent:findFirstChild(&quot;TextLabel1&quot;)
local Text2 = script.Parent:findFirstChild(&quot;TextLabel2&quot;)

while true do
&#9;wait()

----------------------------------------------------------------------- Display Health
&#9;Bar1.Size = UDim2.new((0.8*(Health1.Value/Health2.Value)),0,0.35,0)
&#9;Text1.Text = &quot;Health: [&quot;..Health1.Value..&quot;/&quot;..Health2.Value..&quot;]&quot;

----------------------------------------------------------------------- Display Ammo
&#9;local P = Char:GetChildren()
&#9;for i = 1,#P do
&#9;&#9;if P[i].ClassName == &quot;Tool&quot; then
&#9;&#9;&#9;CurTul = P[i]
&#9;&#9;&#9;GotTool = true
&#9;&#9;else
&#9;&#9;&#9;Text2.Text = &quot;Ammo&quot;
&#9;&#9;end
&#9;end
&#9;if CurTul ~= nil and GotTool == true then
&#9;&#9;Ammo1 = CurTul:findFirstChild(&quot;Ammo&quot;)
&#9;&#9;Ammo2 = CurTul:findFirstChild(&quot;MaxAmmo&quot;)
&#9;&#9;Bar2.Size = UDim2.new((0.8*(Ammo1.Value/Ammo2.Value)),0,0.35,0)
&#9;&#9;Text2.Text = &quot;Ammo: [&quot;..Ammo1.Value..&quot;/&quot;..Ammo2.Value..&quot;]&quot;
&#9;&#9;GotTool = false
&#9;end
end
</ProtectedString>
