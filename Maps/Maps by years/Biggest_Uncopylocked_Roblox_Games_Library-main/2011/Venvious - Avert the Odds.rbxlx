					<Item class="Script" referent="RBX315">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">ClickScript</string>
							<ProtectedString name="Source">local MF = script.Parent

local GF3 = MF.Parent.GameFile3
local B = MF:findFirstChild(&quot;TextButton1&quot;)
local GF1 = MF.Parent.GameFile1
local B3 = MF:findFirstChild(&quot;TextButton3&quot;)
local NGame = game.Workspace:findFirstChild(&quot;Leaderboard&quot;):findFirstChild(&quot;NewGame&quot;)
local StageNum = game.Workspace:findFirstChild(&quot;Leaderboard&quot;):findFirstChild(&quot;StageNumber&quot;)
local Wait = MF.Parent.PleaseWait

B.MouseButton1Click:connect(function(oc)
&#9;GF1.Visible = true
&#9;B.TextStrokeTransparency = 0.5
&#9;MF.Visible = false
end)

B.MouseEnter:connect(function ()
&#9;B.TextStrokeTransparency = 0
end)

B.MouseLeave:connect(function ()
&#9;B.TextStrokeTransparency = 0.5
end)

B3.MouseButton1Click:connect(function(oc)
&#9;if NGame.Value == false then
&#9;&#9;NumberOfMaps = 8
&#9;&#9;for i = 1,NumberOfMaps do
&#9;&#9;&#9;GF3:findFirstChild(&quot;SpawnMap&quot;..i).Visible = false
&#9;&#9;&#9;GF3:findFirstChild(&quot;SpawnMap&quot;..i):findFirstChild(&quot;SpawnScript&quot;).Disabled = true
&#9;&#9;end
&#9;&#9;GF3:findFirstChild(&quot;SpawnMap&quot;..StageNum.Value).Visible = true
&#9;&#9;GF3:findFirstChild(&quot;SpawnMap&quot;..StageNum.Value):findFirstChild(&quot;SpawnScript&quot;).Disabled = false
&#9;&#9;GF3.Visible = true
&#9;&#9;B3.TextStrokeTransparency = 0.5
&#9;&#9;MF.Visible = false
&#9;else
&#9;&#9;Wait.Visible = true
&#9;end
end)

B3.MouseEnter:connect(function ()
&#9;B3.TextStrokeTransparency = 0
end)

B3.MouseLeave:connect(function ()
&#9;B3.TextStrokeTransparency = 0.5
end)
</ProtectedString>
						</Properties>
					</Item>
