								<string name="Name">WeaponInserter</string>
								<ProtectedString name="Source">local Main = script.Parent
local GF = Main.Parent.Parent

local Char
local Player
local Tor
local FakeHum
local Heath
local MaxHealth

local WepList = Main:findFirstChild(&quot;WepList&quot;)
local WepInfo = WepList:findFirstChild(&quot;WeaponInfo&quot;):findFirstChild(&quot;WeaponInfoText2&quot;)
local Val1 = Main:findFirstChild(&quot;UpdateWeapons&quot;)
local Val2 = Main:findFirstChild(&quot;AmountWeapons&quot;)
local B01 = WepList:findFirstChild(&quot;Pistol&quot;)
local B02 = WepList:findFirstChild(&quot;MachinePistol&quot;)
local B03 = WepList:findFirstChild(&quot;Revolver&quot;)
local B04 = WepList:findFirstChild(&quot;Shotgun&quot;)
local B05 = WepList:findFirstChild(&quot;CombatRifle&quot;)
local B06 = WepList:findFirstChild(&quot;HeavyRifle&quot;)
local B07 = WepList:findFirstChild(&quot;Bazooka&quot;)
local B08 = WepList:findFirstChild(&quot;PlasmaPistol&quot;)
local B09 = WepList:findFirstChild(&quot;PlasmaRifle&quot;)

Val1.changed:connect(function(oc)
&#9;if Val1.Value == true then
&#9;&#9;Player = GF.Parent.Parent.Parent
&#9;&#9;Char = GF.Parent.Parent.Parent.Character
&#9;&#9;Tor = Char:findFirstChild(&quot;Torso&quot;)
&#9;&#9;FakeHum = Char:findFirstChild(&quot;FakeHumanoid&quot;)
&#9;&#9;if not Player or not Char or not Tor or not FakeHum then return end
&#9;&#9;local PWeps = GF:findFirstChild(&quot;PlayerWeps&quot;):GetChildren()
&#9;&#9;for pw = 1,#PWeps do
&#9;&#9;&#9;if PWeps[pw].ClassName == &quot;Tool&quot; then
&#9;&#9;&#9;&#9;local WButton = WepList:findFirstChild(&quot;&quot;..PWeps[pw].Name)
&#9;&#9;&#9;&#9;if WButton ~= nil then
&#9;&#9;&#9;&#9;&#9;if WButton.TextColor3 == WButton.BackgroundColor3 then
&#9;&#9;&#9;&#9;&#9;&#9;WButton.TextColor3 = Color3.new(1,1,0)
&#9;&#9;&#9;&#9;&#9;&#9;WButton.Style = &quot;RobloxButtonDefault&quot;
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end)

Val2.changed:connect(function(oc)
&#9;WepInfo.Text = &quot;Weapon Amount: [&quot;..Val2.Value..&quot;/3]&quot;
end)

B01.MouseButton1Click:connect(function(oc)
&#9;if B01.TextColor3 == B01.TextStrokeColor3 then
&#9;&#9;if Val2.Value &lt; 3 then
&#9;&#9;&#9;Val2.Value = Val2.Value + 1
&#9;&#9;&#9;B01.TextColor3 = Color3.new(1,0,0)
&#9;&#9;end
&#9;elseif B01.TextColor3 == B01.BorderColor3 then
&#9;&#9;if Val2.Value &gt; 1 then
&#9;&#9;&#9;Val2.Value = Val2.Value - 1
&#9;&#9;&#9;B01.TextColor3 = Color3.new(1,1,0)
&#9;&#9;end
&#9;end
end)

