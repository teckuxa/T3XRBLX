							<string name="Name">ToolMain</string>
							<ProtectedString name="Source">--Shotgun--
local Tool = script.Parent;
local reloading = false


local arms = nil
local torso = nil
local RAweld = nil -- RightArm
local LAweld = nil -- LeftArm
local welds = {}
local canzoom = 2
local inbetweenTime = 0.6
local knifeDamage = 12
local isHit = false

local chAim
local rSpeed
local vPlayer
local vCharacter

function fire(v)
&#9;Tool.Handle.Fire:play()
&#9;
&#9;Tool.Pump.Mesh.Offset = Vector3.new(0,0.5,0)

&#9;local vCharacter = Tool.Parent
&#9;local vPlayer = game.Players:playerFromCharacter(vCharacter)

&#9;for i = 1,math.random(4,6) do
&#9;&#9;local missile = Instance.new(&quot;Part&quot;)

&#9;&#9;local spawnPos = Vector3.new(vCharacter.PrimaryPart.Position.x+(0.1*math.random(-4,4)),vCharacter.PrimaryPart.Position.y+(0.1*math.random(-4,4)),vCharacter.PrimaryPart.Position.z+(0.1*math.random(-4,4)))
&#9;
&#9;&#9;spawnPos  = spawnPos + (v * 6)

&#9;&#9;missile.Position = spawnPos
&#9;&#9;missile.FormFactor = 0
&#9;&#9;missile.Size = Vector3.new(1,1,1)
&#9;&#9;missile.Velocity = v * 250
&#9;&#9;missile.BrickColor = BrickColor.new(&quot;Bright red&quot;)
&#9;&#9;missile.Shape = 1
&#9;&#9;missile.BottomSurface = 0
&#9;&#9;missile.TopSurface = 0
&#9;&#9;missile.Name = &quot;Bullet&quot;
&#9;&#9;missile.Elasticity = 0
&#9;&#9;missile.Reflectance = 0
&#9;&#9;missile.Transparency = 0.1
&#9;&#9;missile.Friction = .3
&#9;&#9;missile.CanCollide = false

&#9;&#9;local mesh = Instance.new(&quot;SpecialMesh&quot;)
&#9;&#9;mesh.Scale = Vector3.new(0.2,0.2,0.2)
&#9;&#9;mesh.MeshType = &quot;Sphere&quot;
&#9;&#9;mesh.Parent = missile

&#9;&#9;local force = Instance.new(&quot;BodyForce&quot;)
&#9;&#9;force.force = Vector3.new(math.random(-40,40),missile:getMass() * 196,math.random(-40,40))
&#9;&#9;force.Parent = missile

&#9;&#9;local new_Damage = Tool.Damage:clone()
&#9;&#9;new_Damage.Parent = missile

&#9;&#9;local new_script = Tool.Paintball:clone()
&#9;&#9;new_script.Disabled = false
&#9;&#9;new_script.Parent = missile

&#9;&#9;local creator_tag = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;creator_tag.Value = vPlayer
&#9;&#9;creator_tag.Name = &quot;creator&quot;
&#9;&#9;creator_tag.Parent = missile

&#9;&#9;missile.Parent = game.Workspace
&#9;end
&#9;wait(0.1)

&#9;Tool.Pump.Mesh.Offset = Vector3.new(0,0,0)
end

function slice()
&#9;if reloading == true then return end
&#9;reloading = true
&#9;Tool.Enabled = false
&#9;wait()
&#9;LAweld.C1 = CFrame.new(-0.3, 0.8, 0.7) * CFrame.fromEulerAnglesXYZ(math.rad(230), 0, math.rad(-90))
&#9;RAweld.C1 = CFrame.new(-1, 0.2, 0.3) * CFrame.fromEulerAnglesXYZ(math.rad(-100), math.rad(-0), 0)
&#9;vCharacter = Tool.Parent
&#9;vPlayer = game.Players:playerFromCharacter(vCharacter)
&#9;local knife = Instance.new(&quot;Part&quot;)
&#9;knife.Name = &quot;Knife&quot;
&#9;knife.BrickColor = BrickColor.new(&quot;Really black&quot;)
&#9;knife.FormFactor = 3
&#9;knife.CanCollide = false
&#9;knife.Size = Vector3.new(1,1.6,1)
&#9;knife.Parent = Tool
&#9;local creatortag = Instance.new(&quot;ObjectValue&quot;)
&#9;creatortag.Value = vPlayer
&#9;creatortag.Name = &quot;creator&quot;
&#9;creatortag.Parent = knife
&#9;local knifeweld = Instance.new(&quot;Weld&quot;)
&#9;knifeweld.Parent = knife
&#9;knifeweld.Part0 = knife
&#9;knifeweld.Part1 = Tool.Parent:findFirstChild(&quot;Left Arm&quot;)
&#9;knifeweld.C0 = CFrame.new(0.8, 0.5, 0.7) * CFrame.fromEulerAnglesXYZ(math.rad(0), math.rad(.1), -1)
&#9;local mesh = Tool.Knifemesh:clone()
&#9;mesh.Parent = knife
&#9;connection = knife.Touched:connect(blow)
&#9;wait()
&#9;LAweld.C1 = CFrame.new(-0.3, 0.8, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(250), 0, math.rad(-90))
&#9;RAweld.C1 = CFrame.new(-1, 0.2, 0.3) * CFrame.fromEulerAnglesXYZ(math.rad(-105), math.rad(-10), 0)
&#9;wait()
&#9;LAweld.C1 = CFrame.new(-0.3, 0.8, 0.55) * CFrame.fromEulerAnglesXYZ(math.rad(260), 0, math.rad(-90))
&#9;RAweld.C1 = CFrame.new(-1, 0.2, 0.3) * CFrame.fromEulerAnglesXYZ(math.rad(-110), math.rad(-5), 0)
&#9;wait()
&#9;LAweld.C1 = CFrame.new(-0.3, 0.8, 0.5) * CFrame.fromEulerAnglesXYZ(math.rad(270), 0, math.rad(-90))
&#9;RAweld.C1 = CFrame.new(-1, 0.2, 0.3) * CFrame.fromEulerAnglesXYZ(math.rad(-115), math.rad(0), 0)
&#9;wait()
&#9;LAweld.C1 = CFrame.new(-0.3, 0.8, 0.45) * CFrame.fromEulerAnglesXYZ(math.rad(280), 0, math.rad(-90))
&#9;RAweld.C1 = CFrame.new(-1, 0.2, 0.3) * CFrame.fromEulerAnglesXYZ(math.rad(-120), math.rad(5), 0)
&#9;wait()
&#9;LAweld.C1 = CFrame.new(-0.3, 0.8, 0.4) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0, math.rad(-90))
&#9;RAweld.C1 = CFrame.new(-1, 0.2, 0.3) * CFrame.fromEulerAnglesXYZ(math.rad(-120), math.rad(5), 0)
&#9;wait()
&#9;LAweld.C1 = CFrame.new(-0.3, 0.8, 0.3) * CFrame.fromEulerAnglesXYZ(math.rad(310), 0, math.rad(-90))
&#9;RAweld.C1 = CFrame.new(-1, 0.2, 0.3) * CFrame.fromEulerAnglesXYZ(math.rad(-120), math.rad(5), 0)
&#9;wait()
&#9;LAweld.C1 = CFrame.new(-0.3, 0.8, 0.3) * CFrame.fromEulerAnglesXYZ(math.rad(320), 0, math.rad(-90))
&#9;RAweld.C1 = CFrame.new(-1, 0.2, 0.3) * CFrame.fromEulerAnglesXYZ(math.rad(-120), math.rad(5), 0)
&#9;wait()
&#9;RAweld.C1 = CFrame.new(-0.3, 0.8, 0.3)  * CFrame.fromEulerAnglesXYZ(math.rad(330), 0, math.rad(-90))
&#9;RAweld.C1 = CFrame.new(-1, 0.2, 0.3) * CFrame.fromEulerAnglesXYZ(math.rad(-120), math.rad(5), 0)
&#9;wait()
&#9;LAweld.C1 = CFrame.new(-0.3, 0.8, 0.3) * CFrame.fromEulerAnglesXYZ(math.rad(340), 0, math.rad(-90))
&#9;RAweld.C1 = CFrame.new(-1, 0.2, 0.3) * CFrame.fromEulerAnglesXYZ(math.rad(-120), math.rad(5), 0)
&#9;wait()
&#9;LAweld.C1 = CFrame.new(-0.3, 0.8, 0.3)  * CFrame.fromEulerAnglesXYZ(math.rad(350), 0, math.rad(-90))
&#9;RAweld.C1 = CFrame.new(-1, 0.2, 0.3) * CFrame.fromEulerAnglesXYZ(math.rad(-120), math.rad(5), 0)
&#9;wait()
&#9;LAweld.C1 = CFrame.new(-0.3, 0.8, 0.3) * CFrame.fromEulerAnglesXYZ(math.rad(360), 0, math.rad(-90))
&#9;RAweld.C1 = CFrame.new(-1, 0.2, 0.3) * CFrame.fromEulerAnglesXYZ(math.rad(-115), math.rad(5), 0)
&#9;wait()
&#9;LAweld.C1 = CFrame.new(-0.3, 0.8, 0.4)  * CFrame.fromEulerAnglesXYZ(math.rad(350), 0, math.rad(-90))
&#9;RAweld.C1 = CFrame.new(-1, 0.2, 0.3) * CFrame.fromEulerAnglesXYZ(math.rad(-110), math.rad(5), 0)
&#9;wait()
&#9;LAweld.C1 = CFrame.new(-0.3, 0.8, 0.45) * CFrame.fromEulerAnglesXYZ(math.rad(340), 0, math.rad(-90))
&#9;RAweld.C1 = CFrame.new(-1, 0.2, 0.3) * CFrame.fromEulerAnglesXYZ(math.rad(-105), math.rad(5), 0)
&#9;wait()
&#9;LAweld.C1 = CFrame.new(-0.3, 0.8, 0.5)  * CFrame.fromEulerAnglesXYZ(math.rad(330), 0, math.rad(-90))
&#9;RAweld.C1 = CFrame.new(-1, 0.2, 0.3) * CFrame.fromEulerAnglesXYZ(math.rad(-100), math.rad(0), 0)
&#9;wait()
&#9;LAweld.C1 = CFrame.new(-0.3, 0.8, 0.6)  * CFrame.fromEulerAnglesXYZ(math.rad(330), 0, math.rad(-90))
&#9;RAweld.C1 = CFrame.new(-1, 0.2, 0.3) * CFrame.fromEulerAnglesXYZ(math.rad(-95), math.rad(-5), 0)
&#9;wait()
&#9;LAweld.C1 = CFrame.new(-0.3, 0.8, 0.7)  * CFrame.fromEulerAnglesXYZ(math.rad(320), 0, math.rad(-90))
&#9;RAweld.C1 = CFrame.new(-1, 0.2, 0.3) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-10), 0)
&#9;wait()
&#9;connection:disconnect()
&#9;knife:remove()
&#9;LAweld.C1 = CFrame.new(-0.35, 1.2, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0, math.rad(-90))
&#9;RAweld.C1 = CFrame.new(-0.75, 0.25, 0.38) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-15), 0)
&#9;wait()
&#9;reloading = false
&#9;Tool.Enabled = true
end

function blow(hit)
&#9;local ball = script.Parent:findFirstChild(&quot;Knife&quot;)
&#9;if ball == nil or hit.Parent.ClassName == &quot;Tool&quot; or isHit == true or hit.Name == &quot;Bullet&quot; then return end
&#9;isHit = true
&#9;if hit.Parent.ClassName == &quot;Hat&quot; then
&#9;&#9;FakeHum = hit.Parent.Parent:findFirstChild(&quot;FakeHumanoid&quot;)
&#9;else
&#9;&#9;FakeHum = hit.Parent:findFirstChild(&quot;FakeHumanoid&quot;)
&#9;end
&#9;if FakeHum ~= nil then
&#9;&#9;if hit.Parent.ClassName == &quot;Hat&quot; then
&#9;&#9;&#9;EnemyPlayer = game.Players:findFirstChild(hit.Parent.Parent.Name..&quot;&quot;)
&#9;&#9;else
&#9;&#9;&#9;EnemyPlayer = game.Players:findFirstChild(hit.Parent.Name..&quot;&quot;)
&#9;&#9;end
&#9;&#9;local FF = FakeHum.Parent:findFirstChild(&quot;ForceField&quot;)
&#9;&#9;if EnemyPlayer ~= nil and vPlayer ~= nil and FF == nil then
&#9;&#9;&#9;if EnemyPlayer.Neutral == true or EnemyPlayer.TeamColor ~= vPlayer.TeamColor then
&#9;&#9;&#9;&#9;if FakeHum ~= nil then 
&#9;&#9;&#9;&#9;&#9;local oldTag = FakeHum:findFirstChild(&quot;creator&quot;)
&#9;&#9;&#9;&#9;&#9;if oldTag ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;oldTag:remove()
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;local tag = ball:findFirstChild(&quot;creator&quot;)
&#9;&#9;&#9;&#9;&#9;if tag ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;local creatorTag = tag:clone()
&#9;&#9;&#9;&#9;&#9;&#9;creatorTag.Parent = FakeHum
&#9;&#9;&#9;&#9;&#9;end&#9;
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;FakeHum:findFirstChild(&quot;Health&quot;).Value = (FakeHum:findFirstChild(&quot;Health&quot;).Value - knifeDamage)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;isHit = false
end

function ReloadSequence() -- As always. A huge pain.
&#9;rSpeed = Tool.Parent:findFirstChild(&quot;FakeHumanoid&quot;):findFirstChild(&quot;ReloadSpeed&quot;).Value
&#9;if not rSpeed then return end
&#9;RAweld.C1 = CFrame.new(-0.75, 0.25, 0.38) * CFrame.fromEulerAnglesXYZ(math.rad(-92.5), math.rad(-15), math.rad(2.5))
&#9;wait(0.08/rSpeed)
&#9;RAweld.C1 = CFrame.new(-0.75, 0.25, 0.38) * CFrame.fromEulerAnglesXYZ(math.rad(-95), math.rad(-15), math.rad(5))
&#9;wait(0.08/rSpeed)
&#9;for i = 1,(Tool.MaxAmmo.Value) do
&#9;&#9;LAweld.C1 = CFrame.new(-0.35, 1.1, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), -0.1, math.rad(-90))
&#9;&#9;wait(0.1/rSpeed)
&#9;&#9;LAweld.C1 = CFrame.new(-0.35, 1, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), -.3, math.rad(-90))
&#9;&#9;wait(0.1/rSpeed)
&#9;&#9;LAweld.C1 = CFrame.new(-0.35, 1, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), -.6, math.rad(-90))
&#9;&#9;wait(0.1/rSpeed)
&#9;&#9;LAweld.C1 = CFrame.new(-0.35, 1, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), -.9, math.rad(-90))
&#9;&#9;wait(0.1/rSpeed)
&#9;&#9;LAweld.C1 = CFrame.new(-0.35, .8, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), -.6, math.rad(-90))
&#9;&#9;wait(0.1/rSpeed)
&#9;&#9;LAweld.C1 = CFrame.new(-0.35, .6, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), -.3, math.rad(-90))
&#9;&#9;wait(0.1/rSpeed)
&#9;&#9;LAweld.C1 = CFrame.new(-0.35, .8, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0, math.rad(-90))
&#9;&#9;wait(0.1/rSpeed)
&#9;&#9;LAweld.C1 = CFrame.new(-0.35, 1, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0, math.rad(-90))
&#9;&#9;wait(0.1/rSpeed)
&#9;&#9;LAweld.C1 = CFrame.new(-0.35, 1.2, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0, math.rad(-90))
&#9;end
&#9;wait(0.12/rSpeed)
&#9;RAweld.C1 = CFrame.new(-0.75, 0.25, 0.38) * CFrame.fromEulerAnglesXYZ(math.rad(-92.5), math.rad(-15), math.rad(2.5))
&#9;wait(0.12/rSpeed)
&#9;RAweld.C1 = CFrame.new(-0.75, 0.25, 0.38) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-15), 0)
&#9;wait(0.2/rSpeed)
end

function Reload()
&#9;if Tool.Ammo.Value &lt; Tool.MaxAmmo.Value and reloading == false then
&#9;&#9;reloading = true
&#9;&#9;unzoom()
&#9;&#9;Tool.Ammo.Value = 0
&#9;&#9;ReloadSequence()
&#9;&#9;Tool.Ammo.Value = Tool.MaxAmmo.Value
&#9;&#9;reloading = false
&#9;end
end

function KeyDownFunctions(key)
&#9;if key == &quot;r&quot; then
&#9;&#9;Reload()
&#9;elseif key == &quot;q&quot; and canzoom ~= 0 and reloading == false then&#9;
&#9;&#9;local cam = game.Workspace.CurrentCamera
&#9;&#9;if cam ~= nil then
&#9;&#9;&#9;local zoomed = math.floor(cam.FieldOfView + 0.5)
&#9;&#9;&#9;if zoomed == 70 and canzoom &gt;= 1 then
&#9;&#9;&#9;&#9;cam.FieldOfView = 50
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;unzoom()
&#9;&#9;&#9;end
&#9;&#9;end
&#9;elseif key == &quot;e&quot; then
&#9;&#9;if reloading == false then
&#9;&#9;&#9;slice()
&#9;&#9;end
&#9;end
end

function unzoom()
&#9;local cam = game.Workspace.CurrentCamera
&#9;if cam then
&#9;&#9;cam.FieldOfView = 70
&#9;end
end

Tool.Enabled = true
function onButton1Down(mouse)
&#9;if not Tool.Enabled then
&#9;&#9;return
&#9;end

&#9;Tool.Enabled = false

&#9;chAim = Tool.Parent:findFirstChild(&quot;FakeHumanoid&quot;):findFirstChild(&quot;Aim&quot;).Value
&#9;if not chAim then return end

&#9;local character = Tool.Parent;
&#9;local humanoid = character.Humanoid
&#9;local fakeHum = character.FakeHumanoid
&#9;if humanoid == nil or fakeHum == nil then
&#9;&#9;print(&quot;Humanoid not found&quot;)
&#9;&#9;return 
&#9;end
----------------------------------------------------------------------- Check Ammo And Fire
&#9;local ammo = Tool.Ammo
&#9;local maxammo = Tool.MaxAmmo
&#9;if reloading == false and fakeHum.Health.Value &gt;= 1 then
&#9;&#9;if ammo.Value &gt;= 1 then
&#9;&#9;&#9;ammo.Value = ammo.Value - 1
&#9;&#9;&#9;local targetPos = humanoid.TargetPoint
&#9;&#9;&#9;local lookAt = (targetPos - character.Head.Position).unit
&#9;&#9;&#9;if chAim == 2 then 
&#9;&#9;&#9;&#9;mouse.Icon = &quot;http://www.roblox.com/asset/?id=79099777&quot;
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;mouse.Icon = &quot;http://www.roblox.com/asset/?id=79099731&quot;
&#9;&#9;&#9;end
&#9;&#9;&#9;fire(lookAt)
&#9;&#9;&#9;wait(inbetweenTime)
&#9;&#9;else
&#9;&#9;&#9;Reload()
&#9;&#9;end
&#9;end
-----------------------------------------------------------------------
&#9;wait(0.05)
&#9;if chAim == 2 then 
&#9;&#9;mouse.Icon = &quot;http://www.roblox.com/asset/?id=79099756&quot;
&#9;else
&#9;&#9;mouse.Icon = &quot;http://www.roblox.com/asset/?id=79099710&quot;
&#9;end
&#9;Tool.Enabled = true
end

function onEquipped(mouse)
&#9;wait()
&#9;vCharacter = Tool.Parent
&#9;vPlayer = game.Players:playerFromCharacter(vCharacter)
&#9;arms = {Tool.Parent:FindFirstChild(&quot;Left Arm&quot;), Tool.Parent:FindFirstChild(&quot;Right Arm&quot;)}
&#9;torso = Tool.Parent:FindFirstChild(&quot;Torso&quot;)
&#9;if arms ~= nil and torso ~= nil then
&#9;&#9;local sh = {torso:FindFirstChild(&quot;Left Shoulder&quot;), torso:FindFirstChild(&quot;Right Shoulder&quot;)}
&#9;&#9;if sh ~= nil then
&#9;&#9;&#9;local yes = true
&#9;&#9;&#9;if yes then
&#9;&#9;&#9;&#9;yes = false
&#9;&#9;&#9;&#9;sh[1].Part1 = nil
&#9;&#9;&#9;&#9;sh[2].Part1 = nil
&#9;&#9;&#9;&#9;falsearm1 = arms[1]:clone()

&#9;&#9;&#9;&#9;local mesh1 = Instance.new(&quot;SpecialMesh&quot;)
&#9;&#9;&#9;&#9;mesh1.MeshType = &quot;Brick&quot;
&#9;&#9;&#9;&#9;mesh1.Scale = Vector3.new(.8,.9,.8)
&#9;&#9;&#9;&#9;mesh1.Parent = falsearm1

&#9;&#9;&#9;&#9;local armweld1 = Instance.new(&quot;Weld&quot;)
&#9;&#9;&#9;&#9;falsearm1.Transparency = 0.5
&#9;&#9;&#9;&#9;falsearm1.Parent = Tool
&#9;&#9;&#9;&#9;armweld1.Parent = falsearm1
&#9;&#9;&#9;&#9;armweld1.Part0 = falsearm1
&#9;&#9;&#9;&#9;armweld1.Part1 = arms[1]
&#9;&#9;&#9;&#9;falsearm2 = arms[2]:clone()

&#9;&#9;&#9;&#9;local mesh2 = Instance.new(&quot;SpecialMesh&quot;)
&#9;&#9;&#9;&#9;mesh2.MeshType = &quot;Brick&quot;
&#9;&#9;&#9;&#9;mesh2.Scale = Vector3.new(.8,.9,.8)
&#9;&#9;&#9;&#9;mesh2.Parent = falsearm2

&#9;&#9;&#9;&#9;local armweld2 = Instance.new(&quot;Weld&quot;)
&#9;&#9;&#9;&#9;falsearm2.Transparency = 0.5
&#9;&#9;&#9;&#9;falsearm2.Parent = Tool
&#9;&#9;&#9;&#9;armweld2.Parent = falsearm2
&#9;&#9;&#9;&#9;armweld2.Part0 = falsearm2
&#9;&#9;&#9;&#9;armweld2.Part1 = arms[2]

&#9;&#9;&#9;&#9;local weld1 = Instance.new(&quot;Weld&quot;) -- LeftArm
&#9;&#9;&#9;&#9;LAweld = weld1
&#9;&#9;&#9;&#9;weld1.Part0 = torso
&#9;&#9;&#9;&#9;weld1.Parent = torso
&#9;&#9;&#9;&#9;weld1.Part1 = arms[1]
&#9;&#9;&#9;&#9;weld1.C1 = CFrame.new(-0.35, 1.2, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0, math.rad(-90))
&#9;&#9;&#9;&#9;welds[1] = weld1

&#9;&#9;&#9;&#9;local weld2 = Instance.new(&quot;Weld&quot;) -- RightArm
&#9;&#9;&#9;&#9;RAweld = weld2
&#9;&#9;&#9;&#9;weld2.Part0 = torso
&#9;&#9;&#9;&#9;weld2.Parent = torso
&#9;&#9;&#9;&#9;weld2.Part1 = arms[2]
&#9;&#9;&#9;&#9;weld2.C1 = CFrame.new(-0.75, 0.25, 0.38) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-15), 0)
&#9;&#9;&#9;&#9;welds[2] = weld2

&#9;&#9;&#9;&#9;if vPlayer.Neutral == false then
&#9;&#9;&#9;&#9;&#9;falsearm1.BrickColor = vPlayer.TeamColor
&#9;&#9;&#9;&#9;&#9;falsearm2.BrickColor = vPlayer.TeamColor
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;else
&#9;&#9;&#9;print(&quot;sh&quot;)
&#9;&#9;end
&#9;else
&#9;&#9;print(&quot;arms&quot;)
&#9;end
end

local legs = nil
local torso2 = nil
local welds2 = {}
local bodyforce = nil

function onUnquipped(mouse)
&#9;unzoom()
&#9;if arms ~= nil and torso ~= nil then
&#9;&#9;local sh = {torso:FindFirstChild(&quot;Left Shoulder&quot;), torso:FindFirstChild(&quot;Right Shoulder&quot;)}
&#9;&#9;if sh ~= nil then
&#9;&#9;&#9;local yes = true
&#9;&#9;&#9;if yes then
&#9;&#9;&#9;&#9;yes = false
&#9;&#9;&#9;&#9;sh[1].Part1 = arms[1]
&#9;&#9;&#9;&#9;sh[2].Part1 = arms[2]
&#9;&#9;&#9;&#9;welds[1].Parent = nil
&#9;&#9;&#9;&#9;welds[2].Parent = nil
&#9;&#9;&#9;&#9;falsearm1:remove()
&#9;&#9;&#9;&#9;falsearm2:remove()
&#9;&#9;&#9;end
&#9;&#9;else
&#9;&#9;&#9;print(&quot;sh&quot;)
&#9;&#9;end
&#9;else
&#9;&#9;print(&quot;arms&quot;)
&#9;end
end

function onEquippedLocal(mouse)

&#9;if mouse == nil then
&#9;&#9;print(&quot;Mouse not found&quot;)
&#9;&#9;return 
&#9;end

&#9;chAim = Tool.Parent:findFirstChild(&quot;FakeHumanoid&quot;):findFirstChild(&quot;Aim&quot;).Value
&#9;if not chAim then return end
&#9;if chAim == 2 then 
&#9;&#9;mouse.Icon = &quot;http://www.roblox.com/asset/?id=79099756&quot;
&#9;else
&#9;&#9;mouse.Icon = &quot;http://www.roblox.com/asset/?id=79099710&quot;
&#9;end
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
&#9;mouse.KeyDown:connect(KeyDownFunctions)
end

Tool.Equipped:connect(onEquipped)
Tool.Unequipped:connect(onUnquipped)
Tool.Equipped:connect(onEquippedLocal)
