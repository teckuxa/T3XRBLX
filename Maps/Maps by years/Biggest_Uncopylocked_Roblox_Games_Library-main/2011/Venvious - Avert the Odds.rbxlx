							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">AutoWeld</string>
							<ProtectedString name="Source">local prev 
local P = script.Parent:GetChildren() 

for i = 1,#P do 
&#9;if (P[i].className == &quot;Part&quot;) or (P[i].className == &quot;Seat&quot;) then 
&#9;&#9;P[i].Anchored = false
&#9;&#9;if (prev ~= nil)then 
&#9;&#9;&#9;local weld = Instance.new(&quot;Weld&quot;) 
&#9;&#9;&#9;weld.Part0 = prev 
&#9;&#9;&#9;weld.Part1 = P[i] 
&#9;&#9;&#9;weld.C0 = prev.CFrame:inverse() 
&#9;&#9;&#9;weld.C1 = P[i].CFrame:inverse() 
&#9;&#9;&#9;weld.Parent = prev 
&#9;&#9;&#9;weld.Name = prev.Name ..&quot; &quot;.. P[i].Name ..&quot; Weld&quot;
&#9;&#9;end 
&#9;&#9;prev = P[i] 
&#9;end 
end
