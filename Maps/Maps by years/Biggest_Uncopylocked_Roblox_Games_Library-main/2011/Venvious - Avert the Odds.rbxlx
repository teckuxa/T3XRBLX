						<ProtectedString name="Source">repeat wait() until script.Parent.Parent.Parent.Parent.Character ~= nil
repeat wait() until script.Parent.Parent.Parent.Parent:findFirstChild(&quot;leaderstats&quot;) ~= nil

local MF = script.Parent
local OH = script.Parent.Parent:findFirstChild(&quot;OverHeadGui&quot;)
local GF = script.Parent.Parent:findFirstChild(&quot;GameFiles&quot;)
local B = script.Parent:findFirstChild(&quot;Begin&quot;)
local IP = script.Parent:findFirstChild(&quot;InstructionsPanel&quot;)
local IPveils = IP:findFirstChild(&quot;Veils&quot;)
local Player = script.Parent.Parent.Parent.Parent
local Char = Player.Character

local Leaderboard = script.Parent.Parent.Parent.Parent:findFirstChild(&quot;leaderstats&quot;)
local GameStatsKOs = GF:findFirstChild(&quot;GameStats&quot;):findFirstChild(&quot;KOs&quot;)
local GameStatsWOs = GF:findFirstChild(&quot;GameStats&quot;):findFirstChild(&quot;WOs&quot;)

local Pic = script.Parent:findFirstChild(&quot;Picture&quot;)
local Veil = Pic:findFirstChild(&quot;Veil&quot;)
local BVeil = script.Parent:findFirstChild(&quot;ButtonVeil&quot;)
local Title = Pic:findFirstChild(&quot;Title&quot;)
local Load = script.Parent:findFirstChild(&quot;Loading&quot;)

local Hum = game.Lighting:findFirstChild(&quot;GameParts&quot;):findFirstChild(&quot;HumanoidStuff&quot;):findFirstChild(&quot;FakeHumanoid&quot;)

GF:findFirstChild(&quot;GameFile1&quot;).Visible = true
GF:findFirstChild(&quot;GameFile2&quot;).Visible = true
GF:findFirstChild(&quot;GameFile3&quot;).Visible = true
wait(2)
Load.Text = &quot;::::[LOADING]::::&quot;
C = Char:GetChildren()
for i=1, #C do
&#9;if C[i].ClassName == &quot;CharacterMesh&quot; then
&#9;&#9;C[i]:remove()
&#9;end
&#9;if C[i].ClassName == &quot;Script&quot; and C[i].Name == &quot;Health&quot; then
&#9;&#9;C[i]:remove()
&#9;end
end
GF:findFirstChild(&quot;GameFile2&quot;).Visible = false
GF:findFirstChild(&quot;GameFile3&quot;).Visible = false
wait(1)
Load.Text = &quot;::::::[LOADING]::::::&quot;
local LeaderboardKOs = Leaderboard:findFirstChild(&quot;KOs&quot;)
local LeaderboardWOs = Leaderboard:findFirstChild(&quot;WOs&quot;)
wait(1)
Load.Text = &quot;::::::::[LOADING]::::::::&quot;
GameStatsKOs.Value = LeaderboardKOs.Value
GameStatsWOs.Value = LeaderboardWOs.Value
wait(1)
Load.Text = &quot;::::::::::[LOADING]::::::::::&quot;
Player.CameraMode = Enum.CameraMode.LockFirstPerson
wait(1)
Load.Text = &quot;::::::::::::[LOADING]::::::::::::&quot;
Player.CameraMode = Enum.CameraMode.Classic 
wait(0.1)
Load.Text = &quot;::::::::::::[LOA-ING]::::::::::::&quot;
Player.CameraMode = Enum.CameraMode.LockFirstPerson
wait(0.1)
Load.Text = &quot;::::::::::::[LO---NG]::::::::::::&quot;
wait(0.1)
Load.Text = &quot;::::::::::::[L-----G]::::::::::::&quot;
wait(0.1)
Load.Text = &quot;::::::::::::[-------]::::::::::::&quot;
wait(0.1)
