&#9;&#9;&#9;Tool:findFirstChild(&quot;Inject2&quot;).Mesh.Offset = Vector3.new(0,-0.05,0)
&#9;&#9;&#9;RAweld.C1 = CFrame.new(-1, 0.3, 0.46) * CFrame.fromEulerAnglesXYZ(math.rad(-100), 0, 0)
&#9;&#9;&#9;LAweld.C1 = CFrame.new(-0.35, 1, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(305), 0, math.rad(-100))
