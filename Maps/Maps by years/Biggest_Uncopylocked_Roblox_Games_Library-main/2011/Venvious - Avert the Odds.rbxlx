				<Item class="Script" referent="RBX583">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">BreakScript</string>
						<ProtectedString name="Source">repeat wait() until script.Parent.Parent.Parent.Parent.Character:findFirstChild(&quot;FakeHumanoid&quot;) ~= nil
wait(6)

local Char = script.Parent.Parent.Parent.Parent.Character
local Player = script.Parent.Parent.Parent.Parent
local Tor = Char:findFirstChild(&quot;Torso&quot;)
local Hum = Char:findFirstChild(&quot;FakeHumanoid&quot;)
local Health1 = Hum:findFirstChild(&quot;Health&quot;)
local Health2 = Hum:findFirstChild(&quot;MaxHealth&quot;)

local ETime = script.Parent.Parent:findFirstChild(&quot;EndTimeGui&quot;)
local BTime = script.Parent:findFirstChild(&quot;StageTime&quot;)
local BTitle = script.Parent:findFirstChild(&quot;BreakTitle&quot;)
local STitle = script.Parent:findFirstChild(&quot;StyleTitle&quot;)
local BInfo = script.Parent:findFirstChild(&quot;InfoTitle&quot;)
local STime = game.Workspace:findFirstChild(&quot;Leaderboard&quot;):findFirstChild(&quot;StageTime&quot;)
local NGame = game.Workspace:findFirstChild(&quot;Leaderboard&quot;):findFirstChild(&quot;NewGame&quot;)
local GStyle = game.Workspace:findFirstChild(&quot;Leaderboard&quot;):findFirstChild(&quot;StyleNumber&quot;)
local GF = script.Parent.Parent:findFirstChild(&quot;GameFiles&quot;)
local GStats = GF:findFirstChild(&quot;GameStats&quot;)
local UPs = GStats:findFirstChild(&quot;UPs&quot;)
local TText = script.Parent.Parent:findFirstChild(&quot;TeamLabel&quot;):findFirstChild(&quot;TeamText&quot;)

local RBLXTM = Char:findFirstChild(&quot;RobloxTeam&quot;)
if RBLXTM ~= nil then
&#9;RBLXTM:remove()
end

local CharParts = Char:GetChildren()

if GStyle.Value == 1 then
&#9;STitle.Text = &quot;[TEAM]&quot;
&#9;local BY = 0&#9;
&#9;local BR = 0
&#9;local Team1 = game.Teams:findFirstChild(&quot;X&quot;)
&#9;local Team2 = game.Teams:findFirstChild(&quot;Z&quot;)
&#9;local GPlayers = game.Players:GetChildren()
&#9;if Team1 ~= nil and Team2 ~= nil then
&#9;&#9;for GP = 1,#GPlayers do
&#9;&#9;&#9;if GPlayers[GP].TeamColor == Team1.TeamColor and GPlayers[GP] ~= Player then
&#9;&#9;&#9;&#9;BY = BY + 1
&#9;&#9;&#9;elseif GPlayers[GP].TeamColor == Team2.TeamColor and GPlayers[GP] ~= Player then
&#9;&#9;&#9;&#9;BR = BR + 1
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;if BY &gt; BR then
&#9;&#9;Player.TeamColor = BrickColor.new(&quot;Bright red&quot;)
&#9;&#9;TText.BackgroundColor3 = Color3.new(153/255,0,0)
&#9;&#9;TText.Text = &quot;TEAM Z&quot;
&#9;elseif BY &lt; BR then
&#9;&#9;Player.TeamColor = BrickColor.new(&quot;Bright yellow&quot;)
&#9;&#9;TText.BackgroundColor3 = Color3.new(204/255,204/255,0)
&#9;&#9;TText.Text = &quot;TEAM X&quot;
&#9;else
&#9;&#9;rm = math.random(1,2)
&#9;&#9;if rm == 1 then
&#9;&#9;&#9;Player.TeamColor = BrickColor.new(&quot;Bright yellow&quot;)
&#9;&#9;&#9;TText.BackgroundColor3 = Color3.new(204/255,204/255,0)
&#9;&#9;&#9;TText.Text = &quot;TEAM X&quot;
&#9;&#9;elseif rm == 2 then
&#9;&#9;&#9;Player.TeamColor = BrickColor.new(&quot;Bright red&quot;)
&#9;&#9;&#9;TText.BackgroundColor3 = Color3.new(153/255,0,0)
&#9;&#9;&#9;TText.Text = &quot;TEAM Z&quot;
&#9;&#9;end
&#9;end
&#9;Player.Neutral = false
elseif GStyle.Value == 2 then
&#9;Player.TeamColor = BrickColor.new(&quot;White&quot;)
&#9;TText.BackgroundColor3 = Color3.new(1,1,1)
&#9;TText.Text = &quot;FREE FOR ALL&quot;
end

NGame.changed:connect(function()
&#9;if NGame.Value == false then
&#9;&#9;if GStyle.Value == 1 then
&#9;&#9;&#9;wait(0.05*math.random(1,10))
&#9;&#9;&#9;STitle.Text = &quot;[TEAM]&quot;
&#9;&#9;&#9;local BY = 0&#9;
&#9;&#9;&#9;local BR = 0
&#9;&#9;&#9;local Team1 = game.Teams:findFirstChild(&quot;X&quot;)
&#9;&#9;&#9;local Team2 = game.Teams:findFirstChild(&quot;Z&quot;)
&#9;&#9;&#9;local GPlayers = game.Players:GetChildren()
&#9;&#9;&#9;if Team1 ~= nil and Team2 ~= nil then
&#9;&#9;&#9;&#9;for GP = 1,#GPlayers do
&#9;&#9;&#9;&#9;&#9;if GPlayers[GP].TeamColor == Team1.TeamColor and GPlayers[GP] ~= Player then
&#9;&#9;&#9;&#9;&#9;&#9;BY = BY + 1
&#9;&#9;&#9;&#9;&#9;elseif GPlayers[GP].TeamColor == Team2.TeamColor and GPlayers[GP] ~= Player then
&#9;&#9;&#9;&#9;&#9;&#9;BR = BR + 1
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;if BY &gt; BR then
&#9;&#9;&#9;&#9;Player.TeamColor = BrickColor.new(&quot;Bright red&quot;)
&#9;&#9;&#9;&#9;TText.BackgroundColor3 = Color3.new(153/255,0,0)
&#9;&#9;&#9;&#9;TText.Text = &quot;TEAM Z&quot;
&#9;&#9;&#9;elseif BY &lt; BR then
&#9;&#9;&#9;&#9;Player.TeamColor = BrickColor.new(&quot;Bright yellow&quot;)
&#9;&#9;&#9;&#9;TText.BackgroundColor3 = Color3.new(204/255,204/255,0)
&#9;&#9;&#9;&#9;TText.Text = &quot;TEAM X&quot;
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;rm = math.random(1,2)
&#9;&#9;&#9;&#9;if rm == 1 then
&#9;&#9;&#9;&#9;&#9;Player.TeamColor = BrickColor.new(&quot;Bright yellow&quot;)
&#9;&#9;&#9;&#9;&#9;TText.BackgroundColor3 = Color3.new(204/255,204/255,0)
&#9;&#9;&#9;&#9;&#9;TText.Text = &quot;TEAM X&quot;
&#9;&#9;&#9;&#9;elseif rm == 2 then
&#9;&#9;&#9;&#9;&#9;Player.TeamColor = BrickColor.new(&quot;Bright red&quot;)
&#9;&#9;&#9;&#9;&#9;TText.BackgroundColor3 = Color3.new(153/255,0,0)
&#9;&#9;&#9;&#9;&#9;TText.Text = &quot;TEAM Z&quot;
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;Player.Neutral = false
&#9;&#9;elseif GStyle.Value == 2 then
&#9;&#9;&#9;STitle.Text = &quot;[SOLO]&quot;
&#9;&#9;&#9;Player.Neutral = true
&#9;&#9;&#9;Player.TeamColor = BrickColor.new(&quot;White&quot;)
&#9;&#9;&#9;TText.BackgroundColor3 = Color3.new(1,1,1)
&#9;&#9;&#9;TText.Text = &quot;FREE FOR ALL&quot;
&#9;&#9;end
&#9;end
end)

while true do
&#9;wait()
&#9;if&#9;STime.Value.Z &gt;= 10 and NGame.Value == false then
&#9;&#9;BTitle.Text = &quot;[GAME]&quot;
&#9;&#9;BTime.Text = &quot;0&quot;..STime.Value.Y..&quot;:&quot;..STime.Value.Z
&#9;elseif STime.Value.Z &lt; 10 and NGame.Value == false then
&#9;&#9;BTitle.Text = &quot;[GAME]&quot;
&#9;&#9;BTime.Text = &quot;0&quot;..STime.Value.Y..&quot;:0&quot;..STime.Value.Z
&#9;elseif NGame.Value == true then
----------------------------------------------------------------------- NewGame
&#9;&#9;BTitle.Text = &quot;[BREAK]&quot;
&#9;&#9;BInfo.Visible = true
&#9;&#9;ETime.Visible = true
&#9;&#9;GF:findFirstChild(&quot;GameFile1&quot;).Visible = true
&#9;&#9;GF:findFirstChild(&quot;GameFile2&quot;).Visible = false
&#9;&#9;GF:findFirstChild(&quot;GameFile3&quot;).Visible = false
&#9;&#9;GF:findFirstChild(&quot;GameFile3&quot;):findFirstChild(&quot;EnterGameWarning&quot;).Visible = false
&#9;&#9;GF:findFirstChild(&quot;GameFile3&quot;).ClickScript.Disabled = false

----------------------------------------------------------------------- Take Weapons Away Check 1
&#9;&#9;local P = Char:GetChildren()
&#9;&#9;for i = 1,#P do
&#9;&#9;&#9;if P[i].ClassName == &quot;Tool&quot; then
&#9;&#9;&#9;&#9;P[i].Parent = Player.Backpack
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;wait()
&#9;&#9;local G = Player.Backpack:GetChildren()
&#9;&#9;for j = 1,#G do
&#9;&#9;&#9;if G[j].ClassName == &quot;Tool&quot; then
&#9;&#9;&#9;&#9;G[j].Parent = nil
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;wait(2)

----------------------------------------------------------------------- Take Weapons Away Check 2
&#9;&#9;local P = Char:GetChildren()
&#9;&#9;for i = 1,#P do
&#9;&#9;&#9;if P[i].ClassName == &quot;Tool&quot; then
&#9;&#9;&#9;&#9;P[i].Parent = Player.Backpack
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;wait()
&#9;&#9;local G = Player.Backpack:GetChildren()
&#9;&#9;for j = 1,#G do
&#9;&#9;&#9;if G[j].ClassName == &quot;Tool&quot; then
&#9;&#9;&#9;&#9;G[j].Parent = nil
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;wait(1)

----------------------------------------------------------------------- Back to the Lobby
&#9;&#9;ETime.Visible = false
&#9;&#9;UPs.Value = UPs.Value + 4

&#9;&#9;Tor.CFrame = CFrame.new(math.random(84,96), 6.5, math.random(122,134))

&#9;&#9;GF.Visible = true
&#9;&#9;Health1.Value = Health2.Value

&#9;&#9;repeat wait() until NGame.Value == false
&#9;&#9;BInfo.Visible = false
&#9;end
end
</ProtectedString>
