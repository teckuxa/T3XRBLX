							<Item class="Script" referent="RBX185">
								<Properties>
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">GunUpgradeScript</string>
									<ProtectedString name="Source">local GF = script.Parent.Parent.Parent.Parent
local Stats = GF:findFirstChild(&quot;GameStats&quot;)
local PWeps = GF:findFirstChild(&quot;PlayerWeps&quot;)

local Ival
local Sval
local Uval
local Wval
local KOs

local B1UpMax = 3
local B2UpMax = 3

local StrngR = 1
local IntelR = 1
local KOsR = 2

local BuyWep = game.Lighting:findFirstChild(&quot;GameParts&quot;):findFirstChild(&quot;Weapons&quot;):findFirstChild(&quot;MachinePistol&quot;)

local B1 = script.Parent:findFirstChild(&quot;UpgradeButton1&quot;)
local B2 = script.Parent:findFirstChild(&quot;UpgradeButton2&quot;)
local CurB1 = script.Parent:findFirstChild(&quot;CurrentDamage&quot;)
local CurB2 = script.Parent:findFirstChild(&quot;CurrentAmmo&quot;)
local Buy = script.Parent:findFirstChild(&quot;Buy&quot;)
local NotEnough = script.Parent.Parent:findFirstChild(&quot;NotEnough&quot;)
local UpButton = script.Parent.Parent:findFirstChild(&quot;UpgradeButton2&quot;)

Buy.MouseButton1Click:connect(function(oc)
&#9;Ival = Stats:findFirstChild(&quot;Intelligence&quot;)
&#9;Sval = Stats:findFirstChild(&quot;Strength&quot;)
&#9;KOs = Stats:findFirstChild(&quot;KOs&quot;)
&#9;Wval = Stats:findFirstChild(&quot;WepSlots&quot;)
&#9;if Wval.Value &gt;= 1 and Sval.Value &gt;= StrngR and Ival.Value &gt;= IntelR and KOs.Value &gt;= KOsR then
&#9;&#9;Buy.Visible = false
&#9;&#9;Wval.Value = Wval.Value - 1
&#9;&#9;newWep = BuyWep:clone()
&#9;&#9;newWep.Parent = PWeps
&#9;&#9;UpButton.Text = BuyWep.Name..&quot; - [Owned]&quot;
&#9;&#9;UpButton.TextColor3 = Color3.new(1,1,0)
&#9;&#9;script.Parent:findFirstChild(&quot;CostFrame&quot;):remove()
&#9;&#9;B1.Active = true
&#9;&#9;B2.Active = true
&#9;else
&#9;&#9;NotEnough.Visible = true
&#9;end
end)
B1.MouseButton1Click:connect(function(oc)
&#9;if B1.Active == false then return end
&#9;local CurWep = PWeps:findFirstChild(BuyWep.Name..&quot;&quot;)
&#9;Uval = Stats:findFirstChild(&quot;UPs&quot;)&#9;
&#9;if CurWep ~= nil and B1UpMax &gt;= 1 and Uval.Value &gt;= 1 then
&#9;&#9;B1UpMax = B1UpMax - 1
&#9;&#9;Uval.Value = Uval.Value - 1
&#9;&#9;DmgeUpgrade = CurWep:findFirstChild(&quot;Damage&quot;)
&#9;&#9;DmgeUpgrade.Value = math.floor(DmgeUpgrade.Value+3)
&#9;&#9;CurB1.Text = &quot;Current Damage: &quot;..DmgeUpgrade.Value
&#9;&#9;if B1UpMax == 0 then
&#9;&#9;&#9;B1.Text = &quot;Fully Upgraded&quot;
&#9;&#9;end
&#9;elseif Uval.Value &lt; 1 and B1UpMax &gt;= 1 then
&#9;&#9;NotEnough.Visible = true
&#9;end
end)
B2.MouseButton1Click:connect(function(oc)
&#9;if B2.Active == false then return end
&#9;local CurWep = PWeps:findFirstChild(BuyWep.Name..&quot;&quot;)
&#9;Uval = Stats:findFirstChild(&quot;UPs&quot;)&#9;
&#9;if CurWep ~= nil and B2UpMax &gt;= 1 and Uval.Value &gt;= 1 then
&#9;&#9;B2UpMax = B2UpMax - 1
&#9;&#9;Uval.Value = Uval.Value - 1
&#9;&#9;AmmoUpgrade = CurWep:findFirstChild(&quot;MaxAmmo&quot;)
&#9;&#9;AmmoUpgrade.Value = math.floor(AmmoUpgrade.Value+4)
&#9;&#9;AmmoUpgrade2 = CurWep:findFirstChild(&quot;Ammo&quot;)
&#9;&#9;AmmoUpgrade2.Value = AmmoUpgrade.Value
&#9;&#9;CurB2.Text = &quot;Current Clip Size: &quot;..AmmoUpgrade.Value
&#9;&#9;if B2UpMax == 0 then
&#9;&#9;&#9;B2.Text = &quot;Fully Upgraded&quot;
&#9;&#9;end
&#9;elseif Uval.Value &lt; 1 and B2UpMax &gt;= 1 then
&#9;&#9;NotEnough.Visible = true
&#9;end
end)
Buy.MouseEnter:connect(function ()
&#9;script.Parent:findFirstChild(&quot;CostFrame&quot;).Visible = true
end)
Buy.MouseLeave:connect(function ()
&#9;script.Parent:findFirstChild(&quot;CostFrame&quot;).Visible = false
end)
</ProtectedString>
								</Properties>
							</Item>
