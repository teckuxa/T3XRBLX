local B9 = script.Parent:findFirstChild(&quot;UpgradeButton9&quot;)

B1.MouseButton1Click:connect(function(oc)
&#9;if Up1.Visible == false then
&#9;&#9;open(Up1,Up2,Up3,Up4,Up5,Up6,Up7,Up8,Up9)
&#9;&#9;else if Up1.Visible == true then
&#9;&#9;&#9;close(Up1)
&#9;&#9;end
&#9;end
end)
