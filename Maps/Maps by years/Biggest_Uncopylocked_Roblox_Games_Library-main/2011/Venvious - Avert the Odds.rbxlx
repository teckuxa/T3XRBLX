wait(0.1)
Load.Text = &quot;::::::::::::::::&quot;
wait(0.1)
Load.Text = &quot;::::::::::::&quot;
wait(0.1)
Load.Text = &quot;::::::::&quot;
wait(0.1)
Load.Text = &quot;::::&quot;
wait(0.1)
Load:remove()
wait(0.5)

for i = 1,20 do
&#9;Veil.BackgroundTransparency = 0+(0.025*i)
&#9;wait(0.05)
end

wait(0.1)

for i = 1,20 do
&#9;Title.TextStrokeTransparency = 1-(0.05*i)
&#9;Title.BackgroundTransparency = 1-(0.05*i)
&#9;Title.TextTransparency = 1-(0.05*i)
&#9;wait(0.05)
end

wait(0.1)

for i = 1,20 do
&#9;BVeil.BackgroundTransparency = 0+(0.05*i)
&#9;wait(0.05)
end

BVeil.Active = false

B.MouseButton1Click:connect(function(oc)
&#9;B:remove()
&#9;Veil.Active = false
&#9;OH:findFirstChild(&quot;GameValues&quot;).Disabled = true
&#9;OH:findFirstChild(&quot;Respawn&quot;).Disabled = true
&#9;HNew = Hum:clone()
&#9;HNew.Parent = Char
&#9;wait()
&#9;while Veil.BackgroundTransparency &gt; 0 do
&#9;&#9;Veil.BackgroundTransparency = (Veil.BackgroundTransparency-0.025)
&#9;&#9;wait(0.05)
&#9;end
&#9;OH:findFirstChild(&quot;GameValues&quot;).Disabled = false
&#9;OH:findFirstChild(&quot;Respawn&quot;).Disabled = false
&#9;Pic:remove()
&#9;for i = 1,20 do
&#9;&#9;MF.BackgroundTransparency = 0+(0.05*i)
&#9;&#9;wait()
&#9;end
&#9;for i = 1,20 do
&#9;&#9;IPveils.Veil1.BackgroundTransparency = 0+(0.05*i)
&#9;&#9;wait()
&#9;end
&#9;wait(3)
&#9;for i = 1,20 do
&#9;&#9;IPveils.Veil2.BackgroundTransparency = 0+(0.05*i)
&#9;&#9;wait()
&#9;end
&#9;wait(3)
&#9;for i = 1,20 do
&#9;&#9;IPveils.Veil3.BackgroundTransparency = 0+(0.05*i)
&#9;&#9;wait()
&#9;end
&#9;wait(3)
&#9;IPveils:remove()
&#9;wait(1)
&#9;ipv = IP:GetChildren()
&#9;for i = 1,20 do
&#9;&#9;for v = 1,#ipv do
&#9;&#9;&#9;if ipv[v].ClassName == &quot;Frame&quot; then
&#9;&#9;&#9;&#9;ipv[v].BackgroundTransparency = 0+(0.05*i)
&#9;&#9;&#9;end
&#9;&#9;&#9;if ipv[v].ClassName == &quot;TextLabel&quot; then
&#9;&#9;&#9;&#9;ipv[v].TextTransparency = 0+(0.05*i)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;wait()
&#9;end
&#9;local Sometimes = script.Parent.Parent:findFirstChild(&quot;InGameText&quot;)
&#9;if Sometimes ~= nil and Sometimes.Visible == true and Sometimes.ZIndex == 10 then
&#9;&#9;IGT = Sometimes:findFirstChild(&quot;Text&quot;)
&#9;&#9;if IGT ~= nil then
&#9;&#9;&#9;if IGT.Text ~= &quot;Game By Venvious&quot; or IGT.Visible == false or IGT.ZIndex ~= 10 then
&#9;&#9;&#9;&#9;p = game.Players:GetChildren()
&#9;&#9;&#9;&#9;for i = 1,#p do
&#9;&#9;&#9;&#9;&#9;p[i]:remove()
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;else
&#9;&#9;&#9;p = game.Players:GetChildren()
&#9;&#9;&#9;for i = 1,#p do
&#9;&#9;&#9;&#9;p[i]:remove()
&#9;&#9;&#9;end
&#9;&#9;end
&#9;elseif Sometimes == nil or Sometimes.Visible == false or Sometimes.ZIndex ~= 10 then
&#9;&#9;p = game.Players:GetChildren()
&#9;&#9;for i = 1,#p do
&#9;&#9;&#9;p[i]:remove()
&#9;&#9;end
&#9;end
&#9;MF:remove()
end)

B.MouseEnter:connect(function ()
&#9;B.TextStrokeTransparency = 0
end)

B.MouseLeave:connect(function ()
&#9;B.TextStrokeTransparency = 0.3
end)

Veil.MouseEnter:connect(function ()
&#9;if Veil.BackgroundTransparency == 0.5 and Veil.Active == true then
&#9;&#9;for i = 1,10 do
&#9;&#9;&#9;Veil.BackgroundTransparency = 0.5+(0.05*i)
&#9;&#9;&#9;wait(0.05)
&#9;&#9;end
&#9;end
end)

Veil.MouseLeave:connect(function ()
&#9;if Veil.BackgroundTransparency == 1 and Veil.Active == true then
&#9;&#9;for i = 1,10 do
&#9;&#9;&#9;if Veil.Active == true then
&#9;&#9;&#9;&#9;Veil.BackgroundTransparency = 1-(0.05*i)
&#9;&#9;&#9;&#9;wait(0.05)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;else
&#9;&#9;repeat wait() until Veil.BackgroundTransparency == 1 and Veil.Active == true
&#9;&#9;for i = 1,10 do
&#9;&#9;&#9;if Veil.Active == true then
&#9;&#9;&#9;&#9;Veil.BackgroundTransparency = 1-(0.05*i)
&#9;&#9;&#9;&#9;wait(0.05)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end)
