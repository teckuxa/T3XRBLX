							<Item class="Script" referent="RBX96">
								<Properties>
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">UpgradeScript</string>
									<ProtectedString name="Source">local GF = script.Parent.Parent.Parent.Parent
local Stats = GF:findFirstChild(&quot;GameStats&quot;)

local Char
local Player
local FakeHum
local Human

local Uval
local MaxHealth
local Health

local B1UpMax = 16
local B2UpMax = 5
local B1UpAmnt = 40

local NotEnough = script.Parent.Parent:findFirstChild(&quot;NotEnough&quot;)

local B1 = script.Parent:findFirstChild(&quot;ImageButton1&quot;)
local B2 = script.Parent:findFirstChild(&quot;ImageButton2&quot;)

local V1 = script.Parent:findFirstChild(&quot;Veil1&quot;)
local V2 = script.Parent:findFirstChild(&quot;Veil2&quot;)

local In1 = script.Parent:findFirstChild(&quot;Info1&quot;)
local In2 = script.Parent:findFirstChild(&quot;Info2&quot;)

B1.MouseButton1Click:connect(function(oc)
&#9;if B1.Active == false then return end
&#9;Player = GF.Parent.Parent.Parent
&#9;Char = Player.Character
&#9;FakeHum = Char:findFirstChild(&quot;FakeHumanoid&quot;)
&#9;MaxHealth = FakeHum:findFirstChild(&quot;MaxHealth&quot;)
&#9;Health = FakeHum:findFirstChild(&quot;Health&quot;)
&#9;Uval = Stats:findFirstChild(&quot;UPs&quot;)&#9;
&#9;if Char ~= nil and FakeHum ~= nil and MaxHealth ~= nil and Health ~= nil and B1UpMax &gt;= 1 and Uval.Value &gt;= 1 then
&#9;&#9;B1UpMax = B1UpMax - 1
&#9;&#9;Uval.Value = Uval.Value - 1
&#9;&#9;MaxHealth.Value = MaxHealth.Value+B1UpAmnt
&#9;&#9;Health.Value = Health.Value+B1UpAmnt
&#9;&#9;B1UpAmnt = B1UpAmnt - 2
&#9;&#9;if B1UpMax == 0 then
&#9;&#9;&#9;In1.Text = &quot;Health [MAXED] Making pesky flying pieces of metal a little less dangerous.&quot;
&#9;&#9;else
&#9;&#9;&#9;In1.Text = &quot;Health [+&quot;..B1UpAmnt..&quot;] Making pesky flying pieces of metal a little less dangerous.&quot;
&#9;&#9;end
&#9;elseif Uval.Value &lt; 1 and B1UpMax &gt;= 1 then
&#9;&#9;NotEnough.Visible = true
&#9;end
end)
B2.MouseButton1Click:connect(function(oc)
&#9;if B2.Active == false then return end
&#9;Player = GF.Parent.Parent.Parent
&#9;Char = Player.Character
&#9;Intel = Stats:findFirstChild(&quot;WepSlots&quot;)
&#9;Uval = Stats:findFirstChild(&quot;UPs&quot;)&#9;
&#9;if Char ~= nil and Intel ~= nil and B2UpMax &gt;= 1 and Uval.Value &gt;= 1 then
&#9;&#9;B2UpMax = B2UpMax - 1
&#9;&#9;Uval.Value = Uval.Value - 1
&#9;&#9;Intel.Value = Intel.Value+1
&#9;&#9;if B2UpMax == 0 then
&#9;&#9;&#9;In2.Text = &quot;Weapon Slots [MAXED] Buy weapon slots in order to purchase more weapons.&quot;
&#9;&#9;end
&#9;elseif Uval.Value &lt; 1 and B2UpMax &gt;= 1 then
&#9;&#9;NotEnough.Visible = true
&#9;end
end)
B1.MouseEnter:connect(function ()
if B1.Active == false then return end
V1.Transparency = 1
In1.Visible = true
end)
B1.MouseLeave:connect(function ()
V1.Transparency  = 0.8
In1.Visible = false
end)
B2.MouseEnter:connect(function ()
if B2.Active == false then return end
V2.Transparency = 1
In2.Visible = true
end)
B2.MouseLeave:connect(function ()
if B2.Active == false then return end
V2.Transparency  = 0.8
In2.Visible = false
end)
</ProtectedString>
								</Properties>
