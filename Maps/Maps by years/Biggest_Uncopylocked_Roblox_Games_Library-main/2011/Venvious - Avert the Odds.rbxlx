&#9;&#9;&#9;end
&#9;&#9;end
&#9;elseif key == &quot;e&quot; then
&#9;&#9;if reloading == false then
&#9;&#9;&#9;slice()
&#9;&#9;end
&#9;end
end

function unzoom()
