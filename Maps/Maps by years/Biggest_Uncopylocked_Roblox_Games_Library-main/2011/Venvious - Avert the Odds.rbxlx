							<Item class="Script" referent="RBX6612">
								<Properties>
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">TeleportScript</string>
									<ProtectedString name="Source">local tele = script.Parent
local tele2 = tele.Parent.Parent:findFirstChild(&quot;ClawDevice1&quot;):findFirstChild(&quot;Teleport&quot;)

function onTouched(hit)
&#9;if hit.Name ~= &quot;Torso&quot; then return end
&#9;if hit.Parent.ClassName == &quot;Hat&quot; then
&#9;&#9;FakeHum = hit.Parent.Parent:findFirstChild(&quot;FakeHumanoid&quot;)
&#9;else
&#9;&#9;FakeHum = hit.Parent:findFirstChild(&quot;FakeHumanoid&quot;)
&#9;end
&#9;if FakeHum ~= nil then
&#9;&#9;tor = FakeHum.Parent:findFirstChild(&quot;Torso&quot;)
&#9;&#9;if tor ~= nil then
&#9;&#9;&#9;tor.CFrame = CFrame.new((tele2.Position.x+math.random(-2,2)),(tele2.Position.y+math.random(-2,2)),(tele2.Position.z+math.random(-2,2)))
&#9;&#9;end
&#9;end
end

tele.Touched:connect(onTouched)
</ProtectedString>
								</Properties>
							</Item>
						</Item>
