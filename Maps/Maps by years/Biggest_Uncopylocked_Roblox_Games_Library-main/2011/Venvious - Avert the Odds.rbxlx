					<Item class="Script" referent="RBX1201">
						<Properties>
							<bool name="Disabled">true</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Paintball</string>
							<ProtectedString name="Source">local ball = script.Parent
local damage = script.Parent:findFirstChild(&quot;Damage&quot;)
local isHit = false
local wall = 1
local FakeHum
local EnemyPlayer

function onTouched(hit)
&#9;if hit.Parent.ClassName == &quot;Tool&quot; or isHit == true or hit.Name == &quot;Bullet&quot; or hit.Name == &quot;LaserShot&quot; then return end
&#9;wall = wall + 1
&#9;if wall &gt; 2 then
&#9;&#9;isHit = true
&#9;&#9;ball.Velocity = Vector3.new(0,0,0)
&#9;end
&#9;if hit.Parent.ClassName == &quot;Hat&quot; then
&#9;&#9;FakeHum = hit.Parent.Parent:findFirstChild(&quot;FakeHumanoid&quot;)
&#9;else
&#9;&#9;FakeHum = hit.Parent:findFirstChild(&quot;FakeHumanoid&quot;)
&#9;end
&#9;if FakeHum ~= nil then
&#9;&#9;if hit.Parent.ClassName == &quot;Hat&quot; then
&#9;&#9;&#9;EnemyPlayer = game.Players:findFirstChild(hit.Parent.Parent.Name..&quot;&quot;)
&#9;&#9;else
&#9;&#9;&#9;EnemyPlayer = game.Players:findFirstChild(hit.Parent.Name..&quot;&quot;)
&#9;&#9;end
&#9;&#9;local LocalPlayer = ball:findFirstChild(&quot;creator&quot;).Value
&#9;&#9;local FF = FakeHum.Parent:findFirstChild(&quot;ForceField&quot;)
&#9;&#9;if EnemyPlayer ~= nil and LocalPlayer ~= nil and FF == nil then
&#9;&#9;&#9;if EnemyPlayer.Neutral == true or EnemyPlayer.TeamColor ~= LocalPlayer.TeamColor then
&#9;&#9;&#9;&#9;tagFakeHum(FakeHum)
&#9;&#9;&#9;&#9;FakeHum:findFirstChild(&quot;Health&quot;).Value = (FakeHum:findFirstChild(&quot;Health&quot;).Value - damage.Value)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;explosion = Instance.new(&quot;Explosion&quot;)
&#9;explosion.BlastRadius = 0
&#9;explosion.BlastPressure = 10 -- these are really wussy units
&#9;explosion.Position = script.Parent.Position
&#9;explosion.Parent = game.Workspace
&#9;if wall &gt; 2 then
&#9;&#9;connection:disconnect()
&#9;&#9;ball:remove()
&#9;end
end

function tagFakeHum(FakeHum)
&#9;if FakeHum ~= nil then 
&#9;&#9;local oldTag = FakeHum:findFirstChild(&quot;creator&quot;)
&#9;&#9;if oldTag ~= nil then
&#9;&#9;&#9;oldTag:remove()
&#9;&#9;end
&#9;&#9;local tag = ball:findFirstChild(&quot;creator&quot;)
&#9;&#9;if tag ~= nil then
&#9;&#9;&#9;local creatorTag = tag:clone()
&#9;&#9;&#9;creatorTag.Parent = FakeHum
&#9;&#9;end&#9;
&#9;end
end

connection = ball.Touched:connect(onTouched)

local BallTime = 0
local LPart = ball:findFirstChild(&quot;LaserShot&quot;)

while BallTime &lt; 18 do 
&#9;wait()
&#9;LPart.Size = Vector3.new(1,1,(ball.CurGun.Value.Barrel.Position - ball.Position).magnitude)
&#9;LPart.CFrame = CFrame.new(((ball.Position + ball.CurGun.Value.Barrel.Position)/2) + 1 * (ball.CurGun.Value.Barrel.Position - ball.Position).unit, ball.CurGun.Value.Barrel.Position)
&#9;BallTime = BallTime + 1
end
for v = 1,2 do
&#9;LPart.Transparency = LPart.Transparency + 0.25
&#9;wait()
end
ball:remove()

--Venvious[Based From Roblox&apos;s Original Script]--</ProtectedString>
