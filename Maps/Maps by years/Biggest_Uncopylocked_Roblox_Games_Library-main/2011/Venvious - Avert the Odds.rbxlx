								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">UpgradeMenuScript</string>
								<ProtectedString name="Source">local Up1 = script.Parent:findFirstChild(&quot;UpgradePanel1&quot;)
local Up2 = script.Parent:findFirstChild(&quot;UpgradePanel2&quot;)
local Up3 = script.Parent:findFirstChild(&quot;UpgradePanel3&quot;)
local Up4 = script.Parent:findFirstChild(&quot;UpgradePanel4&quot;)

local B1 = script.Parent:findFirstChild(&quot;UpgradeButton1&quot;)
local B2 = script.Parent:findFirstChild(&quot;UpgradeButton2&quot;)
local B3 = script.Parent:findFirstChild(&quot;UpgradeButton3&quot;)
local B4 = script.Parent:findFirstChild(&quot;UpgradeButton4&quot;)

B1.MouseButton1Click:connect(function(oc)
&#9;if Up1.Visible == false then
&#9;&#9;open(Up1,Up2,Up3,Up4)
&#9;&#9;else if Up1.Visible == true then
&#9;&#9;&#9;close(Up1)
&#9;&#9;end
&#9;end
end)
B2.MouseButton1Click:connect(function(oc)
&#9;if Up2.Visible == false then
&#9;&#9;open(Up2,Up3,Up4,Up1)
&#9;&#9;else if Up2.Visible == true then
&#9;&#9;&#9;close(Up2)
&#9;&#9;end
&#9;end
end)
B3.MouseButton1Click:connect(function(oc)
&#9;if Up3.Visible == false then
&#9;&#9;open(Up3,Up4,Up1,Up2)
&#9;&#9;else if Up3.Visible == true then
&#9;&#9;&#9;close(Up3)
&#9;&#9;end
&#9;end
end)
B4.MouseButton1Click:connect(function(oc)
&#9;if Up4.Visible == false then
&#9;&#9;open(Up4,Up1,Up2,Up3)
&#9;&#9;else if Up4.Visible == true then
&#9;&#9;&#9;close(Up4)
&#9;&#9;end
&#9;end
end)
B1.MouseEnter:connect(function ()
B1.TextStrokeTransparency = 0
end)
B1.MouseLeave:connect(function ()
B1.TextStrokeTransparency = 0.5
end)
B2.MouseEnter:connect(function ()
B2.TextStrokeTransparency = 0
end)
B2.MouseLeave:connect(function ()
B2.TextStrokeTransparency = 0.5
end)
B3.MouseEnter:connect(function ()
B3.TextStrokeTransparency = 0
end)
B3.MouseLeave:connect(function ()
B3.TextStrokeTransparency = 0.5
end)
B4.MouseEnter:connect(function ()
B4.TextStrokeTransparency = 0
end)
B4.MouseLeave:connect(function ()
B4.TextStrokeTransparency = 0.5
end)

function open(i1,i2,i3,i4)
&#9;i1.Visible = true
&#9;for s = 1,17 do
&#9;&#9;i1.Size = UDim2.new(0.17, 0, 0+(0.01*s), 0)
&#9;&#9;if i2.Visible == true then
&#9;&#9;&#9;i2.Size = UDim2.new(0.17, 0, 0.17-(0.01*s), 0)
&#9;&#9;end
&#9;&#9;if i3.Visible == true then
&#9;&#9;&#9;i3.Size = UDim2.new(0.17, 0, 0.17-(0.01*s), 0)
&#9;&#9;end
&#9;&#9;if i4.Visible == true then
&#9;&#9;&#9;i4.Size = UDim2.new(0.17, 0, 0.17-(0.01*s), 0)
&#9;&#9;end
&#9;&#9;wait()
&#9;end
&#9;i2.Visible = false
&#9;i3.Visible = false
&#9;i4.Visible = false
end

function close(i1)
&#9;for s = 1,17 do
&#9;&#9;i1.Size = UDim2.new(0.17, 0, 0.17-(0.01*s), 0)
&#9;&#9;wait()
&#9;end
&#9;i1.Visible = false
end
</ProtectedString>
