		<Item class="Script" referent="RBX3075">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Styx</string>
				<ProtectedString name="Source">roboto = game.Workspace.MrRoboto:clone()
wait(2)
game.Workspace.MrRoboto:remove()

local list = {}

function addRoboto()
	local mr = roboto:clone()
	mr.Parent = game.Workspace
	mr:makeJoints()
	mr:MoveTo(Vector3.new(0,100,0))
	table.insert(list, mr)
end


function killRobotos()
	for i = 1, #list do
		list[i]:remove()
	end
	list = {}
end

while true do
	for i = 1, 5 do
		wait(10)
		addRoboto()
	end
	wait(20)
	killRobotos()
end


