			<Item class="Script" referent="RBX686">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">CapturePointScript</string>
					<ProtectedString name="Source">function waitForChild(parent, instance)
&#9;while parent:FindFirstChild(instance) == nil do 
&#9;&#9;wait()
&#9;end
end 

-- CTP St00f -- 
local capturePointsModel
if game.Workspace:FindFirstChild(&quot;CapturePointsModel&quot;) == nil then 
&#9;capturePointsModel = Instance.new(&quot;Model&quot;)
&#9;capturePointsModel.Name = &quot;CapturePointsModel&quot;
&#9;capturePointsModel.Parent = game.Workspace
else 
&#9;capturePointsModel = game.Workspace.CapturePointsModel
end 

local alreadyRegistered = false 
local children = capturePointsModel:GetChildren()
for i = 1, #children do 
&#9;if children[i] and children[i].Value then 
&#9;&#9;if children[i].Value == script.Parent then 
&#9;&#9;&#9;alreadyRegistered = true
&#9;&#9;end 
&#9;end 
end
if alreadyRegistered == false then
&#9;local registerValue = Instance.new(&quot;ObjectValue&quot;)
&#9;registerValue.Value = script.Parent 
&#9;registerValue.Name = script.Parent.Name --.. #capturePointsModel:GetChildren()
&#9;registerValue.Parent = capturePointsModel
end 
-- 

local captureRadius = 8&#9;&#9;--distance from flag to start capturing.
local timeToCapture = 10&#9;--time it takes to capture in seconds.
local captureRate = 1/30&#9;--make this a higher number to decrease animation quality, but &quot;lag&quot; less.
local radiusType = 0&#9;&#9;&#9;--if radius type is 0 then the radius will be 2d, and 3d if radius type is 1.
local colors = {}
local capturePoint = script.Parent
local beamHeight = capturePoint.Height.Size.Y

if _G[&quot;CapturePointsTable&quot;] == nil then 
&#9;_G[&quot;CapturePointsTable&quot;] = {}
end 

_G[&quot;CapturePointsTable&quot;][script.Parent] = {}

while game.Workspace:FindFirstChild(&quot;GameScript&quot;) == nil do 
&#9;wait()
end

while game.Workspace.GameScript:FindFirstChild(&quot;Regening&quot;) == nil do 
&#9;wait()
end

local regening = game.Workspace.GameScript.Regening 
regening.Changed:connect(function ()
&#9;regening = game.Workspace.GameScript:FindFirstChild(&quot;Regening&quot;)
&#9;if regening and regening.Value == true then&#9;&#9;&#9;
&#9;&#9;n = 1
&#9;&#9;local beam = script.Parent
&#9;&#9;beam.Highlight.CFrame = CFrame.new(beam.ColorPad.Position) + Vector3.new(0, beamHeight/2, 0)
&#9;&#9;beam.Highlight.Mesh.Scale = Vector3.new((beam.ColorPad.Size.X) * 5.0, beamHeight, (beam.ColorPad.Size.X) * 5) 
&#9;&#9;beam.Highlight.BrickColor = BrickColor.new(&quot;White&quot;)
&#9;&#9;beam.ColorPad.BrickColor = BrickColor.new(&quot;White&quot;)
&#9;end
end)

capturePoint.AncestryChanged:connect(function()
&#9;
end)
local n = 1
waitForChild(capturePoint, &quot;Highlight&quot;)
waitForChild(capturePoint, &quot;Height&quot;)
waitForChild(capturePoint, &quot;ColorPad&quot;)
capturePoint.Highlight.CFrame = CFrame.new(capturePoint.ColorPad.Position)+Vector3.new(0,beamHeight/2,0)
capturePoint.Highlight.Mesh.Scale = Vector3.new((n*capturePoint.ColorPad.Size.x)*5,beamHeight,(n*capturePoint.ColorPad.Size.x)*5)

capturePoint.Height.Transparency = 1.0


function gotCaptured(newColor, players)
&#9;if #_G[&quot;CapturePointsTable&quot;][script.Parent] &lt; 1 then
&#9;&#9;_G[&quot;CapturePointsTable&quot;][script.Parent] = {}
&#9;&#9;_G[&quot;CapturePointsTable&quot;][script.Parent] = players
&#9;&#9;capturePoint.ColorPad.BrickColor = newColor
&#9;&#9;capturePoint.Highlight.BrickColor = newColor
&#9;&#9;for i5, v5 in ipairs(capturePoint:GetChildren()) do
&#9;&#9;&#9;if v5.className == &quot;SpawnLocation&quot; then
&#9;&#9;&#9;&#9;v5.TeamColor = newColor
&#9;&#9;&#9;&#9;v5.BrickColor = newColor
&#9;&#9;&#9;elseif v5.Name == &quot;ColorMe&quot; then
&#9;&#9;&#9;&#9;v5.BrickColor = newColor
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

function findColor(color)
&#9;for i2, v2 in ipairs(colors) do
&#9;&#9;if v2[1] == color then
&#9;&#9;&#9;return v2
&#9;&#9;end
&#9;end
&#9;return nil
end

while true do
&#9;colors = {}
&#9;local players = {}
&#9;for i, player in ipairs(game.Players:GetChildren()) do
&#9;&#9;local character = player.Character
&#9;&#9;if character ~= nil then
&#9;&#9;&#9;local torso  = character:FindFirstChild(&quot;Torso&quot;)
&#9;&#9;&#9;local humanoid = character:FindFirstChild(&quot;Humanoid&quot;)
&#9;&#9;&#9;if torso  ~= nil and humanoid ~= nil then
&#9;&#9;&#9;&#9;if humanoid.Health &gt; 0 then
&#9;&#9;&#9;&#9;&#9;local pos1 = torso.Position * Vector3.new(1, radiusType, 1)
&#9;&#9;&#9;&#9;&#9;local pos2 = capturePoint.ColorPad.Position * Vector3.new(1, radiusType, 1)
&#9;&#9;&#9;&#9;&#9;if (pos1 - pos2).magnitude &lt; captureRadius then
&#9;&#9;&#9;&#9;&#9;&#9;local colorFound = findColor(player.TeamColor)
&#9;&#9;&#9;&#9;&#9;&#9;if colorFound ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;colorFound[2] = colorFound[2]+1
&#9;&#9;&#9;&#9;&#9;&#9;&#9;table.insert(players, player)
&#9;&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;&#9;table.insert(colors, {player.TeamColor, 1})
&#9;&#9;&#9;&#9;&#9;&#9;&#9;table.insert(players, player)
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;if #colors &gt; 1 then
&#9;&#9;colors2 = {}
&#9;&#9;for i, v in ipairs(colors) do
&#9;&#9;&#9;inserted = false
&#9;&#9;&#9;for i3, v3 in ipairs(colors2) do
&#9;&#9;&#9;&#9;if v[2] &gt; v3[2] then
&#9;&#9;&#9;&#9;&#9;table.insert(colors2, i3, v)
&#9;&#9;&#9;&#9;&#9;inserted = true
&#9;&#9;&#9;&#9;&#9;break
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;if not inserted then
&#9;&#9;&#9;&#9;table.insert(colors2, v)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;else
&#9;&#9;colors2 = colors
&#9;end
&#9;changed = false
&#9;if #colors2 &gt;= 2 then
&#9;&#9;if colors2[1][2] &gt; colors2[2][2] then
&#9;&#9;&#9;if colors2[1][1] == capturePoint.ColorPad.BrickColor then
&#9;&#9;&#9;&#9;if n &lt; 1 then
&#9;&#9;&#9;&#9;&#9;n = n + ((captureRate/timeToCapture) * (colors2[1][2] - colors2[2][2]))
&#9;&#9;&#9;&#9;&#9;changed = true
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;n = n - ((captureRate/timeToCapture) * (colors2[1][2] - colors2[2][2]))
&#9;&#9;&#9;&#9;if n &lt;= 0 then
&#9;&#9;&#9;&#9;&#9;n = (captureRate/timeToCapture) * (colors2[1][2] - colors2[2][2])
&#9;&#9;&#9;&#9;&#9;gotCaptured(colors2[1][1], players)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;changed = true
&#9;&#9;&#9;end
&#9;&#9;end
&#9;elseif #colors2 &gt;= 1 then
&#9;&#9;if colors2[1][1] == capturePoint.ColorPad.BrickColor then
&#9;&#9;&#9;if n &lt; 1 then
&#9;&#9;&#9;&#9;n = n + ((captureRate/timeToCapture) * colors2[1][2])
&#9;&#9;&#9;&#9;if n &gt; 1 then
&#9;&#9;&#9;&#9;&#9;n = 1
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;changed = true
&#9;&#9;&#9;end
&#9;&#9;else
&#9;&#9;&#9;n = n - ((captureRate/timeToCapture) * colors2[1][2])
&#9;&#9;&#9;if n &lt;= 0 then
&#9;&#9;&#9;&#9;n = ((captureRate/timeToCapture) * colors2[1][2])
&#9;&#9;&#9;&#9;gotCaptured(colors2[1][1], players)
&#9;&#9;&#9;end
&#9;&#9;&#9;changed = true
&#9;&#9;end
&#9;end
&#9;if changed then
&#9;&#9;capturePoint.Highlight.Mesh.Scale = Vector3.new((n * capturePoint.ColorPad.Size.X) * 5, beamHeight,(n * capturePoint.ColorPad.Size.X) * 5)
&#9;end
&#9;wait(captureRate)
end




</ProtectedString>
				</Properties>
