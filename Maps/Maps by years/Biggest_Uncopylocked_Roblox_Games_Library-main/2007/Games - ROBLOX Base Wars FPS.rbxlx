		<Item class="ScreenGui" referent="RBX2231">
			<Properties>
				<string name="Name">GameGui</string>
			</Properties>
			<Item class="Frame" referent="RBX2232">
				<Properties>
					<bool name="Active">false</bool>
					<Color3 name="BackgroundColor3">4288914085</Color3>
					<float name="BackgroundTransparency">1</float>
					<Color3 name="BorderColor3">4279970357</Color3>
					<int name="BorderSizePixel">1</int>
					<bool name="ClipsDescendants">false</bool>
					<bool name="Draggable">false</bool>
					<string name="Name">ScoreFrame</string>
					<UDim2 name="Position">
						<XS>0.5</XS>
						<XO>-200</XO>
						<YS>0</YS>
						<YO>0</YO>
					</UDim2>
					<UDim2 name="Size">
						<XS>0</XS>
						<XO>400</XO>
						<YS>0</YS>
						<YO>200</YO>
					</UDim2>
					<token name="SizeConstraint">0</token>
					<token name="Style">0</token>
					<bool name="Visible">true</bool>
					<int name="ZIndex">1</int>
				</Properties>
				<Item class="LocalScript" referent="RBX2233">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Game Gui</string>
						<ProtectedString name="Source">local frame = script.Parent
local gui = frame.Parent 
local debris = game:GetService(&quot;Debris&quot;)

local rbxGui = LoadLibrary(&quot;RbxGui&quot;)

function waitForChild(parent, instance)
&#9;while parent:FindFirstChild(instance) == nil do 
&#9;&#9;print(parent, &quot; .. waiting for .. &quot;, instance) 
&#9;&#9;wait()
&#9;end
end

waitForChild(game, &quot;Teams&quot;)
waitForChild(game.Teams, &quot;Red&quot;)
waitForChild(game.Teams, &quot;Blue&quot;) 
waitForChild(game.Workspace, &quot;GameScript&quot;)

waitForChild(gui, &quot;WinnerFrame&quot;) 
local winnerFrame = gui.WinnerFrame 
waitForChild(winnerFrame, &quot;Winners&quot;)
local winnerImg = winnerFrame.Winners

waitForChild(gui, &quot;IntroFrame&quot;)
local introFrame = gui.IntroFrame

waitForChild(gui, &quot;AnnouncementFrame&quot;)
local announcementFrame = gui.AnnouncementFrame
--waitForChild(announcementFrame, &quot;PlayerName&quot;) 
--local playerName = announcementFrame.PlayerName

local playerGui = gui.Parent 
local vPlayer = playerGui.Parent 

waitForChild(vPlayer, &quot;CName&quot;)
waitForChild(vPlayer, &quot;Health&quot;)
waitForChild(vPlayer, &quot;Speed&quot;)

local className = vPlayer.CName 
while className.Value == nil do wait() end
local classHealth = vPlayer.Health
while classHealth.Value == nil do wait() end 
local classSpeed = vPlayer.Speed
while classSpeed.Value == nil do wait() end 

while vPlayer.Character == nil do 
&#9;wait()
end 

local vCharacter = vPlayer.Character
waitForChild(vCharacter, &quot;Humanoid&quot;) &#9;
local myHumanoid  = vCharacter.Humanoid

waitForChild(vPlayer, &quot;Backpack&quot;)
local backpack = vPlayer.Backpack

waitForChild(script, &quot;Swoosh&quot;)
waitForChild(script, &quot;Boom&quot;)

local swooshSound = script.Swoosh
local boomSound = script.Boom

swooshSound.Parent = vCharacter 
boomSound.Parent = vCharacter 

local classAttributes = {}
classAttributes[&quot;Trooper&quot;] = {115, 24} --{115, 20} 
classAttributes[&quot;Assault&quot;] = {90, 29} -- {90, 24} 
classAttributes[&quot;Sniper&quot;] = {95, 20} -- {95, 17} 
classAttributes[&quot;Brute&quot;] = {175, 18} --{175, 16} 
classAttributes[&quot;Support&quot;] = {130, 25}--{130, 22} 

------ SHIRTS --------------------------

local shirtAssets = {}
shirtAssets[&quot;Assault&quot;] = {72048056, 72048067}
shirtAssets[&quot;Trooper&quot;] = {72048086, 72048096}
shirtAssets[&quot;Brute&quot;] = {72048110, 72048123}
shirtAssets[&quot;Support&quot;] = {72048145, 72048150}
shirtAssets[&quot;Sniper&quot;] = {72048160, 72048163}

coroutine.resume(coroutine.create(function()
&#9;waitForChild(vCharacter, &quot;Shirt&quot;)
&#9;while tostring(vPlayer.TeamColor) ~= &quot;Bright blue&quot; and tostring(vPlayer.TeamColor) ~= &quot;Bright red&quot; do &#9;&#9;
&#9;&#9;wait()
&#9;end
&#9;print(className.Value, shirtAssets[className.Value])
&#9;if className and className.Value and shirtAssets[className.Value] then 
&#9;&#9;print(&quot;ONOES&quot;)
&#9;&#9;if tostring(vPlayer.TeamColor) == &quot;Bright blue&quot; then 
&#9;&#9;&#9;print(&quot;OYUS&quot;)
&#9;&#9;&#9;vCharacter.Shirt.ShirtTemplate = &quot;http://www.roblox.com/asset/?id=&quot; .. shirtAssets[className.Value][1]
&#9;&#9;else
&#9;&#9;&#9;print(&quot;OYUS&quot;)
&#9;&#9;&#9;vCharacter.Shirt.ShirtTemplate = &quot;http://www.roblox.com/asset/?id=&quot; .. shirtAssets[className.Value][2]
&#9;&#9;end 
&#9;end 
end)) 

----------------------------------------
&#9;
if myHumanoid then 
&#9;print(&quot;Found Humanoid&quot;)
&#9;for i, v in pairs(classAttributes) do 
&#9;&#9;if className and i == className.Value then 
&#9;&#9;&#9;print(&quot;Found class&quot;, i)
&#9;&#9;&#9;print(&quot;Setting the attributes&quot;)
&#9;&#9;&#9;print(v[1], v[2])
&#9;&#9;&#9;myHumanoid.WalkSpeed = v[2]  
&#9;&#9;&#9;print(&quot;WalkSpeed - &quot;, myHumanoid.WalkSpeed)  
&#9;&#9;&#9;
&#9;&#9;&#9;while myHumanoid.MaxHealth ~= v[1] do 
&#9;&#9;&#9;&#9;myHumanoid.MaxHealth = v[1]
&#9;&#9;&#9;&#9;wait()
&#9;&#9;&#9;end
&#9;&#9;&#9;while myHumanoid.Health ~= v[1] do 
&#9;&#9;&#9;&#9;myHumanoid.Health = v[1]
&#9;&#9;&#9;&#9;wait()
&#9;&#9;&#9;end&#9;&#9;&#9;
&#9;&#9;end 
&#9;end

&#9;wait(1.0)
&#9;
&#9;if game.Lighting:FindFirstChild(className.Value) then 
&#9;&#9;local classN = game.Lighting:FindFirstChild(className.Value)
&#9;&#9;local classNChildren = classN:GetChildren()
&#9;&#9;for i = 1, #classNChildren do 
&#9;&#9;&#9;classNChildren[i]:Clone().Parent = backpack 
&#9;&#9;end 
&#9;end 

&#9;myHumanoid.NameOcclusion = Enum.NameOcclusion.EnemyOcclusion
end 

local gameScript = game.Workspace.GameScript

waitForChild(gameScript, &quot;Time Remaining&quot;)
waitForChild(gameScript, &quot;Regening&quot;)
waitForChild(gameScript, &quot;Winners&quot;)
waitForChild(gameScript, &quot;IntroScreen&quot;)
waitForChild(gameScript, &quot;BlueTeamCaptures&quot;)
waitForChild(gameScript, &quot;RedTeamCaptures&quot;)
waitForChild(gameScript, &quot;Announcement&quot;)
waitForChild(frame, &quot;RedScore&quot;)
waitForChild(frame, &quot;BlueScore&quot;)
waitForChild(gameScript, &quot;FreezeCharacters&quot;)
waitForChild(gameScript, &quot;CaptureFeed&quot;)

local freezeCharacters = gameScript.FreezeCharacters 
if freezeCharacters and freezeCharacters.Value == true then &#9;
&#9;myHumanoid.WalkSpeed = 0.0
else 
&#9;print(&quot;Freeze Characters - failed hard&quot;) 
end 

freezeCharacters.Changed:connect(function()
&#9;if freezeCharacters then 
&#9;&#9;if freezeCharacters.Value == true then &#9;&#9;&#9;
&#9;&#9;&#9;if myHumanoid then myHumanoid.WalkSpeed = 0.0 end
&#9;&#9;else 
&#9;&#9;&#9;for i, v in pairs(classAttributes) do &#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;if className and className.Value == i and myHumanoid then &#9;&#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;&#9;myHumanoid.WalkSpeed = v[2]&#9;&#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;end 
&#9;&#9;&#9;end 
&#9;&#9;end 
&#9;end 
end)

local announcement = gameScript.Announcement 
announcement.Changed:connect(function()
&#9;announcement = gameScript:FindFirstChild(&quot;Announcement&quot;)
