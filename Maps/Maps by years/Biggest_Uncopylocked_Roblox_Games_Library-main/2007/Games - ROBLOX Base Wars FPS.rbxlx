						<Z>0</Z>
					</Vector3>
					<token name="formFactorRaw">3</token>
					<token name="shape">1</token>
					<Vector3 name="size">
						<X>8</X>
						<Y>0.200000003</Y>
						<Z>8</Z>
					</Vector3>
				</Properties>
				<Item class="Decal" referent="RBX738">
					<Properties>
						<token name="Face">1</token>
						<string name="Name">Decal</string>
						<float name="Shiny">20</float>
						<float name="Specular">0</float>
						<Content name="Texture"><url>http://www.roblox.com/asset?id=69824474</url></Content>
						<float name="Transparency">0</float>
					</Properties>
				</Item>
			</Item>
		</Item>
		<Item class="Script" referent="RBX739">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">GameScript</string>
				<ProtectedString name="Source">--[[
&#9;// File: GameScript.lua 
&#9;// Description: Contains most of the server side logic for the ROBLOX Base Wars game, with the exception of Capture Points and Admin Script 
&#9;//&#9;This file is written functionally in order, and adding a module should be straight forward 
&#9;//&#9;For any questions/bugs PM Sorcus on ROBLOX or @Canavus on twitter 
]]


-- Some global stuff
local debugMode = false -- Set this true to see the prints littered across the code 

function waitForChild(parent, instance)
&#9;while parent:FindFirstChild(instance) == nil do 
&#9;&#9;if debugMode then 
&#9;&#9;&#9;print(parent.Name .. &quot; waiting for &quot; .. instance)
&#9;&#9;end 
&#9;&#9;wait()
&#9;end
&#9;return parent:FindFirstChild(instance)
end

local RBX_Debris = game:GetService(&quot;Debris&quot;)
local RBX_BadgeService = game:GetService(&quot;BadgeService&quot;)

local debug = Instance.new(&quot;StringValue&quot;)
debug.Name = &quot;Debug&quot;
debug.Parent = game.Workspace
debug.Value = &quot;Debugging&quot; 

local msg = Instance.new(&quot;Message&quot;)
msg.Parent = game.Workspace 
msg.Text = &quot;&quot;

if debug then debug.Value = &quot;Variables done&quot; end 
-- End global stuff

--[[
&#9;// This is our Lua side game object that contains all the variables and functions necessary for the game&#9;
&#9;// Variables are suffixed _Type to show that they are RBX C-side objects and not in script objects
&#9;// Exception to this rule, is the _Bool variable and _List table. Might change in the future though
]] 

local myGame = {
&#9;&#9;&#9;&#9;&#9;-- Class vars
&#9;&#9;&#9;&#9;&#9;waitForChild(game, &quot;Teams&quot;),
&#9;&#9;&#9;&#9;&#9;RemainingTime_IntValue = waitForChild(script, &quot;Time Remaining&quot;),
&#9;&#9;&#9;&#9;&#9;Regening_BoolValue = waitForChild(script, &quot;Regening&quot;),
&#9;&#9;&#9;&#9;&#9;Winners_StringValue = waitForChild(script, &quot;Winners&quot;),
&#9;&#9;&#9;&#9;&#9;IntroScreen_BoolValue = waitForChild(script, &quot;IntroScreen&quot;),
&#9;&#9;&#9;&#9;&#9;Announcement_StringValue = waitForChild(script, &quot;Announcement&quot;), 
&#9;&#9;&#9;&#9;&#9;RoundDuration_IntValue = waitForChild(script, &quot;Round Duration&quot;)  ,
&#9;&#9;&#9;&#9;&#9;CapturePoints_Model = waitForChild(game.Workspace, &quot;CapturePointsModel&quot;),
&#9;&#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;&#9;PlayerAdded_ObjectValue = waitForChild(script, &quot;PlayerAddedVal&quot;),
&#9;&#9;&#9;&#9;&#9;PlayerRemoved_ObjectValue = waitForChild(script, &quot;PlayerRemovedVal&quot;),
&#9;&#9;&#9;&#9;&#9;TriggerVictoryScreen_BoolValue = waitForChild(script, &quot;TriggerVictoryScreen&quot;),
&#9;&#9;&#9;&#9;&#9;KillFeed_StringValue = waitForChild(script, &quot;Feed&quot;),
&#9;&#9;&#9;&#9;&#9;MVP_ObjectValue = waitForChild(script, &quot;MVP&quot;),
&#9;&#9;&#9;&#9;&#9;FreezeCharacters_BoolValue = waitForChild(script, &quot;FreezeCharacters&quot;),
&#9;&#9;&#9;&#9;&#9;CaptureFeed_StringValue = waitForChild(script, &quot;CaptureFeed&quot;),
&#9;&#9;&#9;&#9;&#9;BlueSpawnParts_Model = waitForChild(game.Workspace, &quot;BlueSpawnParts&quot;),
&#9;&#9;&#9;&#9;&#9;RedSpawnParts_Model = waitForChild(game.Workspace, &quot;RedSpawnParts&quot;),
&#9;&#9;&#9;&#9;&#9;Diagnostics_Model = waitForChild(game.Workspace, &quot;Diagnostics&quot;),

&#9;&#9;&#9;&#9;&#9;NumPlayers = 0, 
&#9;&#9;&#9;&#9;&#9;GameTime = 0,
&#9;&#9;&#9;&#9;&#9;MinPlayers = 1, 
&#9;&#9;&#9;&#9;&#9;Regening_Bool = false,
&#9;&#9;&#9;&#9;&#9;PlayerScores = {}, -- List to store the player scores of Base Wars
&#9;&#9;&#9;&#9;&#9;TeamCount = {}, &#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;&#9;Teams = {},
&#9;&#9;&#9;&#9;&#9;TeamScores = {},
&#9;&#9;&#9;&#9;&#9;Appearance = {},
&#9;&#9;&#9;&#9;&#9;CapturePoints = {}, 
&#9;&#9;&#9;&#9;&#9;[&quot;BlueTeamCharacter&quot;] = {&quot;http://www.roblox.com/Asset/CharacterFetch.ashx?userId=22931356&quot;},
&#9;&#9;&#9;&#9;&#9;[&quot;RedTeamCharacter&quot;] = {&quot;http://www.roblox.com/Asset/CharacterFetch.ashx?userId=22931253&quot;},
&#9;&#9;&#9;&#9;&#9;CapturePointStatuses_List = {},

&#9;&#9;&#9;&#9;&#9;ShirtAssets = {
&#9;&#9;&#9;&#9;&#9;&#9;[&quot;Assault&quot;] = {72048056, 72048067},
&#9;&#9;&#9;&#9;&#9;&#9;[&quot;Trooper&quot;] = {72048086, 72048096},
&#9;&#9;&#9;&#9;&#9;&#9;[&quot;Brute&quot;] = {72048110, 72048123},
&#9;&#9;&#9;&#9;&#9;&#9;[&quot;Support&quot;] = {72048145, 72048150},
&#9;&#9;&#9;&#9;&#9;&#9;[&quot;Sniper&quot;] = {72048160, 72048163}&#9;&#9;&#9;&#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;&#9;},

&#9;&#9;&#9;&#9;&#9;Badges_List = {
&#9;&#9;&#9;&#9;&#9;&#9;[&quot;Assault&quot;] = {&#9;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;[&quot;MVP&quot;]&#9;= {76050945}
&#9;&#9;&#9;&#9;&#9;&#9;},
&#9;&#9;&#9;&#9;&#9;&#9;[&quot;Trooper&quot;] = {
&#9;&#9;&#9;&#9;&#9;&#9;&#9;[&quot;MVP&quot;]&#9;= {76050945}
&#9;&#9;&#9;&#9;&#9;&#9;},
&#9;&#9;&#9;&#9;&#9;&#9;[&quot;Brute&quot;] = {
&#9;&#9;&#9;&#9;&#9;&#9;&#9;[&quot;MVP&quot;]&#9;= {76050945}
&#9;&#9;&#9;&#9;&#9;&#9;},
&#9;&#9;&#9;&#9;&#9;&#9;[&quot;Support&quot;]&#9;= {
&#9;&#9;&#9;&#9;&#9;&#9;&#9;[&quot;MVP&quot;]&#9;= {76050945}
&#9;&#9;&#9;&#9;&#9;&#9;},
&#9;&#9;&#9;&#9;&#9;&#9;[&quot;Sniper&quot;] = {
&#9;&#9;&#9;&#9;&#9;&#9;&#9;[&quot;MVP&quot;]&#9;= {76050945} 
&#9;&#9;&#9;&#9;&#9;&#9;},
&#9;&#9;&#9;&#9;&#9;&#9;[&apos;Win&apos;] = 95352177
&#9;&#9;&#9;&#9;&#9;}
&#9;&#9;&#9;&#9;}&#9;

--[[
&#9;// To initialize all game related stuff before we commence the game
&#9;// Sort of like the constructor 
]] 

function myGame:Init()&#9;
&#9;myGame:PopulateTeamStuff()
&#9;myGame:PopulateCapturePointStuff()&#9;
&#9;myGame.CapturePoints_Model.ChildAdded:connect(function(capturePoint) myGame:PopulateCapturePointStuff(capturePoint) end)
&#9;myGame.GameTime = myGame.RoundDuration_IntValue.Value &#9;
end 

-- Need a string value for each team, might be used by the GUI script on the client side 
function myGame:PopulateTeamStuff()
&#9;local teamsInGame = game.Teams:GetChildren()
&#9;for i = 1, #teamsInGame do 
&#9;&#9;table.insert(myGame.Teams, teamsInGame[i])
&#9;&#9;local teamScore = Instance.new(&quot;IntValue&quot;)
&#9;&#9;teamScore.Name = teamsInGame[i].Name .. &quot;TeamCaptures&quot;
&#9;&#9;teamScore.Parent = script 
&#9;&#9;teamScore.Value = 0 -- remove this ASAP
&#9;&#9;myGame.TeamScores[teamsInGame[i]] = math.random(1, 33)
&#9;end 
end 
--[[
&#9;// The Capture points poll into the CapturePointsModel that is Workspace
&#9;// Take those and add them to our List and also add a value for each
&#9;// Capture point so that the Client side stuff can take that into account
]]
function myGame:PopulateCapturePointStuff(capturePoint)
&#9;if not capturePoint then
&#9;&#9;local capturePointsInWorkspace = myGame.CapturePoints_Model:GetChildren()
&#9;&#9;for i = 1, #capturePointsInWorkspace do 
&#9;&#9;&#9;if capturePointsInWorkspace[i] and capturePointsInWorkspace[i].Value and not script:FindFirstChild(capturePointsInWorkspace[i].Value.Name .. &quot;Status&quot;) then 
&#9;&#9;&#9;&#9;table.insert(myGame.CapturePoints, capturePointsInWorkspace[i].Value)&#9;&#9;
&#9;&#9;&#9;&#9;local capturePointStatus = Instance.new(&quot;IntValue&quot;)
&#9;&#9;&#9;&#9;capturePointStatus.Name = capturePointsInWorkspace[i].Value.Name .. &quot;Status&quot;
&#9;&#9;&#9;&#9;capturePointStatus.Value = 0 
&#9;&#9;&#9;&#9;capturePointStatus.Parent = script 
&#9;&#9;&#9;&#9;table.insert(myGame.CapturePointStatuses_List, capturePointStatus)
&#9;&#9;&#9;end 
&#9;&#9;end 
&#9;else 
&#9;&#9;while capturePoint.Value == nil do 
&#9;&#9;&#9;wait() 
&#9;&#9;&#9;if debugMode then print(&quot;Waiting on CP value&quot;)  end 
&#9;&#9;end 
&#9;&#9;if not script:FindFirstChild(capturePoint.Value.Name .. &quot;Status&quot;) then
&#9;&#9;&#9;table.insert(myGame.CapturePoints, capturePoint.Value)&#9;&#9;&#9;
&#9;&#9;&#9;local capturePointStatus = Instance.new(&quot;IntValue&quot;)
&#9;&#9;&#9;capturePointStatus.Name = capturePoint.Value.Name .. &quot;Status&quot;
&#9;&#9;&#9;capturePointStatus.Value = 0 
&#9;&#9;&#9;capturePointStatus.Parent = script 
&#9;&#9;&#9;table.insert(myGame.CapturePointStatuses_List, capturePointStatus)
&#9;&#9;end 
&#9;end 
end

--[[
&#9;// Creates the floating numbers above capture points to showcase the scores earned at capture points
]]
function myGame:CreateFloatingIcon(pos, icon, suspension, speed)
&#9;local p = Instance.new(&quot;Part&quot;)   
&#9;p.FormFactor = &quot;Custom&quot;
&#9;p.Size = Vector3.new(0.2, 0.2, 0.2)
&#9;p.Transparency = 1
&#9;p.CanCollide = false
&#9;p.CFrame = CFrame.new(pos)

&#9;local bf = Instance.new(&quot;BodyForce&quot;)
&#9;bf.force = Vector3.new(0, speed * (196.0 * p:GetMass()), 0)

&#9;local bbGui = Instance.new(&quot;BillboardGui&quot;)
&#9;bbGui.Size = UDim2.new(2, 0, 2,0 )
&#9;bbGui.Adornee = p
&#9;
&#9;local imageLabel = Instance.new(&quot;ImageLabel&quot;)
&#9;imageLabel.Size = UDim2.new(1, 0, 1, 0)
&#9;imageLabel.BackgroundTransparency = 1
&#9;imageLabel.Image = icon

&#9;imageLabel.Parent = bbGui
&#9;bbGui.Parent = p
&#9;bf.Parent = p
&#9;p.Parent = game.Workspace
&#9;RBX_Debris:AddItem(p, suspension) 
end

--[[
&#9;// Awards badge for each achievement&#9;
]]
function myGame:AwardBadges(badgeType, player)
&#9;if badgeType == &quot;MVP&quot; and player then 
&#9;&#9;if player:FindFirstChild(&quot;CName&quot;) then 
&#9;&#9;&#9;if myGame.Badges_List[player.CName.Value] and myGame.Badges_List[player.CName.Value][badgeType] then 
&#9;&#9;&#9;&#9;RBX_BadgeService:AwardBadge(player.userId, myGame.Badges_List[player.CName.Value][badgeType][1])
&#9;&#9;&#9;end 
&#9;&#9;end 
&#9;end 
end 

function myGame:ShuffleTeams()
&#9;myGame.TeamCount = {} -- free the table for garbage collection
&#9;for i = 1, #myGame.Teams do 
&#9;&#9;if myGame.Teams[i] then 
&#9;&#9;&#9;myGame.TeamCount[myGame.Teams[i]] = 0 
&#9;&#9;end
&#9;end 

&#9;local players = game.Players:GetPlayers()
&#9;local count = 1
&#9;local numberOfPlayers = #players 

&#9;while myGame.TeamCount[myGame.Teams[1]] &lt; numberOfPlayers/2 and count &lt;= numberOfPlayers do 
&#9;&#9;tick()
&#9;&#9;if (math.random(1, 2)== 1 or myGame.TeamCount[myGame.Teams[2]] &gt; numberOfPlayers/2) then 
&#9;&#9;&#9;if players[count] then
&#9;&#9;&#9;&#9;myGame.TeamCount[myGame.Teams[1]] = myGame.TeamCount[myGame.Teams[1]] + 1
&#9;&#9;&#9;&#9;players[count].TeamColor = myGame.Teams[1].TeamColor&#9;
&#9;&#9;&#9;&#9;if myGame[myGame.Teams[1].Name .. &quot;TeamCharacter&quot;] then 
&#9;&#9;&#9;&#9;&#9;players[count].CharacterAppearance = myGame[myGame.Teams[1].Name .. &quot;TeamCharacter&quot;][1]
&#9;&#9;&#9;&#9;end 
&#9;&#9;&#9;end
&#9;&#9;else &#9;
&#9;&#9;&#9;if players[count] then
&#9;&#9;&#9;&#9;myGame.TeamCount[myGame.Teams[2]] = myGame.TeamCount[myGame.Teams[2]] + 1
&#9;&#9;&#9;&#9;players[count].TeamColor = myGame.Teams[2].TeamColor&#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;if myGame[myGame.Teams[2].Name .. &quot;TeamCharacter&quot;] then 
&#9;&#9;&#9;&#9;&#9;players[count].CharacterAppearance = myGame[myGame.Teams[2].Name .. &quot;TeamCharacter&quot;][1]
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;count = count + 1
&#9;end
&#9;
&#9;for i = count, numberOfPlayers do 
&#9;&#9;if players[i] then
&#9;&#9;&#9;myGame.TeamCount[myGame.Teams[2]] = myGame.TeamCount[myGame.Teams[2]] + 1
&#9;&#9;&#9;players[i].TeamColor = myGame.Teams[2].TeamColor&#9;&#9;
&#9;&#9;&#9;if myGame[myGame.Teams[2].Name .. &quot;TeamCharacter&quot;] then 
&#9;&#9;&#9;&#9;players[count].CharacterAppearance = myGame[myGame.Teams[2].Name .. &quot;TeamCharacter&quot;][1]
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

function myGame:Update()
&#9;local count = 0 
&#9;while myGame.GameTime &gt; 0 do 
&#9;&#9;local duration = 5 
&#9;&#9;for i = 1, duration do 
&#9;&#9;&#9;myGame.GameTime = myGame.GameTime - 1 
&#9;&#9;&#9;if myGame.RemainingTime_IntValue then 
&#9;&#9;&#9;&#9;myGame.RemainingTime_IntValue.Value = myGame.GameTime
&#9;&#9;&#9;end 
&#9;&#9;&#9;wait(1.0)
&#9;&#9;end 
&#9;&#9;for i = 1, #myGame.CapturePoints do 
&#9;&#9;&#9;local teamColor = &quot;&quot;
&#9;&#9;&#9;if myGame.CapturePoints[i]:FindFirstChild(&quot;Highlight&quot;) and myGame.CapturePoints[i].Highlight:FindFirstChild(&quot;Mesh&quot;) and myGame.CapturePoints[i]:FindFirstChild(&quot;ColorPad&quot;) then 
&#9;&#9;&#9;&#9;for j = 1, #myGame.Teams do 
&#9;&#9;&#9;&#9;&#9;if tostring(myGame.CapturePoints[i].Highlight.BrickColor) == tostring(myGame.Teams[j].TeamColor) then 
&#9;&#9;&#9;&#9;&#9;&#9;if tostring(myGame.Teams[j].TeamColor) == &quot;Bright red&quot; then 
&#9;&#9;&#9;&#9;&#9;&#9;&#9;myGame:CreateFloatingIcon(myGame.CapturePoints[i].ColorPad.Position + Vector3.new(0, 5, 0), &quot;http://www.roblox.com/asset/?id=69449152&quot;, 2.5, 1.025)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if script:FindFirstChild(myGame.CapturePoints[i].Name .. &quot;Status&quot;) then 
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;script[myGame.CapturePoints[i].Name .. &quot;Status&quot;].Value = 1 -- Might change this to a string in the future, which is less arkane&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;teamColor = &quot;Bright red&quot; 
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end 
&#9;&#9;&#9;&#9;&#9;&#9;else 
&#9;&#9;&#9;&#9;&#9;&#9;&#9;myGame:CreateFloatingIcon(myGame.CapturePoints[i].ColorPad.Position + Vector3.new(0, 5, 0), &quot;http://www.roblox.com/asset/?id=69449149&quot;, 2.5, 1.025)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if script:FindFirstChild(myGame.CapturePoints[i].Name .. &quot;Status&quot;) then 
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;script[myGame.CapturePoints[i].Name .. &quot;Status&quot;].Value = 2&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;teamColor = &quot;Bright blue&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end 
&#9;&#9;&#9;&#9;&#9;&#9;end 
&#9;&#9;&#9;&#9;&#9;&#9;myGame.Teams[j].Score = myGame.Teams[j].Score + 1
&#9;&#9;&#9;&#9;&#9;&#9;myGame.TeamScores[myGame.Teams[j]] = myGame.TeamScores[myGame.Teams[j]] + 1
&#9;&#9;&#9;&#9;&#9;end 
&#9;&#9;&#9;&#9;end 
&#9;&#9;&#9;end 
&#9;&#9;&#9;if _G[&quot;CapturePointsTable&quot;][myGame.CapturePoints[i]] then 
&#9;&#9;&#9;&#9;--------------------- Might change the protocol for this one -------------------
&#9;&#9;&#9;&#9;local captureFeedString = teamColor .. &quot;-&quot;
&#9;&#9;&#9;&#9;local foundAtleastOnePlayer = false
&#9;&#9;&#9;&#9;for index, player in pairs(_G[&quot;CapturePointsTable&quot;][myGame.CapturePoints[i]]) do 
&#9;&#9;&#9;&#9;&#9;-- Formulate the string that will be parsed by the Client side GUI 
&#9;&#9;&#9;&#9;&#9;captureFeedString = captureFeedString .. player.Name .. &quot;,&quot;  
&#9;&#9;&#9;&#9;&#9;foundAtleastOnePlayer = true 
&#9;&#9;&#9;&#9;end 
&#9;&#9;&#9;&#9;if myGame.CaptureFeed_StringValue and captureFeedString ~= &quot;-&quot; and foundAtleastOnePlayer then &#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;&#9;myGame.CaptureFeed_StringValue.Value = captureFeedString&#9;&#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;end 
&#9;&#9;&#9;&#9;--------------------------------------------------------------------------------

&#9;&#9;&#9;&#9;for index, player in pairs(_G[&quot;CapturePointsTable&quot;][myGame.CapturePoints[i]]) do 
&#9;&#9;&#9;&#9;&#9;if myGame.PlayerScores[player] then 
&#9;&#9;&#9;&#9;&#9;&#9;myGame.PlayerScores[player] = myGame.PlayerScores[player] + 3
&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;-- This is unlikely, but just to make sure 
&#9;&#9;&#9;&#9;&#9;&#9;myGame.PlayerScores[player] = 3 
&#9;&#9;&#9;&#9;&#9;end 
&#9;&#9;&#9;&#9;&#9;if player:FindFirstChild(&quot;leaderstats&quot;) then 
&#9;&#9;&#9;&#9;&#9;&#9;if player.leaderstats:FindFirstChild(&quot;Score&quot;) then 
&#9;&#9;&#9;&#9;&#9;&#9;&#9;player.leaderstats.Score.Value = player.leaderstats.Score.Value + 3 &#9;&#9;&#9;&#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;if player.leaderstats:FindFirstChild(&quot;Captures&quot;) then 
&#9;&#9;&#9;&#9;&#9;&#9;&#9;player.leaderstats.Captures.Value = player.leaderstats.Captures.Value + 1
&#9;&#9;&#9;&#9;&#9;&#9;end 
&#9;&#9;&#9;&#9;&#9;end 
&#9;&#9;&#9;&#9;end 
&#9;&#9;&#9;end 
&#9;&#9;&#9;-- Free the table for garbage collection 
&#9;&#9;&#9;_G[&quot;CapturePointsTable&quot;][myGame.CapturePoints[i]] = {} 
&#9;&#9;end  
&#9;end 
end

function myGame:Regen()
&#9;if debug then debug.Value = &quot;Regening&quot; end 
&#9;local duration = 8 -- Takes 8 seconds to regen the level 
&#9;myGame.Regening_Bool = true &#9;
&#9;--if myGame.Regening_BoolValue then myGame.Regening_BoolValue.Value = true end  -- To tell the clients that the game is regening
&#9;myGame:ShuffleTeams() -- Shuffle the teams 

&#9;for i = duration, 1, -1 do 
&#9;&#9;msg.Text = &quot;Next round starts in &quot; .. i .. &quot; seconds&quot;&#9;&#9;
&#9;end 
&#9;msg.Text = &quot; &quot;
&#9;if myGame.RoundDuration_IntValue then 
&#9;&#9;myGame.GameTime = myGame.RoundDuration_IntValue.Value
&#9;end
&#9;myGame.PlayerScores = {} 
&#9;local players = game.Players:GetPlayers()
&#9;for i = 1, #players do 
&#9;&#9;if players[i] and players[i]:FindFirstChild(&quot;leaderstats&quot;) and players[i].leaderstats:FindFirstChild(&quot;Score&quot;) then
&#9;&#9;&#9;players[i].leaderstats.Score.Value = 0
&#9;&#9;&#9;myGame.PlayerScores[players[i]] = 0
&#9;&#9;end  
&#9;end 
&#9;
&#9;wait(2.0) 
&#9;if myGame.Announcement_StringValue then myGame.Announcement_StringValue.Value = &quot;&quot; end 
&#9;if debug then debug.Value = &quot;Regen done&quot; end &#9;
&#9;if myGame.MVP_ObjectValue then myGame.MVP_ObjectValue.Value = nil end 
&#9;--[[
&#9;&#9;// Do the capture points status reset here 
&#9;]]
&#9;for i = 1, #myGame.CapturePointStatuses_List do 
&#9;&#9;if myGame.CapturePointStatuses_List[i] then 
&#9;&#9;&#9;myGame.CapturePointStatuses_List[i].Value = 0 
&#9;&#9;end 
&#9;end 
&#9;players = game.Players:GetPlayers() -- Maybe a new player got in, in the 2 seconds wait
&#9;for i = 1, #players do 
&#9;&#9;if players[i] and players[i].Character then 
&#9;&#9;&#9;players[i].Character:BreakJoints() 
&#9;&#9;end 
&#9;end &#9;
&#9;wait(2.0) -- Total Regen time, 12 seconds
&#9;if myGame.Regening_BoolValue then &#9;&#9;
&#9;&#9;myGame.Regening_BoolValue.Value = true 
&#9;end  -- To tell the capture points to reset&#9;
&#9;for i = 1, #myGame.Teams do 
&#9;&#9;myGame.Teams[i].Score = 0
&#9;end
end

function myGame:Start()
&#9;if debugMode then print(&quot;Starting&quot;) end 
&#9;local count = -1 
&#9;--[[
&#9;&#9;// Nullifying player scores, this might be moved somewhere else in the future 
&#9;]]
&#9;local players = game.Players:GetPlayers()
&#9;for i = 1, #players do 
&#9;&#9;if players[i]:FindFirstChild(&quot;leaderstats&quot;) then
&#9;&#9;&#9;if players[i].leaderstats:FindFirstChild(&quot;Captures&quot;) then 
&#9;&#9;&#9;&#9;players[i].leaderstats.Captures.Value = 0 
&#9;&#9;&#9;end 
&#9;&#9;&#9;if players[i].leaderstats:FindFirstChild(&quot;Score&quot;) then 
&#9;&#9;&#9;&#9;players[i].leaderstats.Score.Value = 0
&#9;&#9;&#9;end 
&#9;&#9;end 
&#9;end 

&#9;if myGame.FreezeCharacters_BoolValue then 
&#9;&#9;myGame.FreezeCharacters_BoolValue.Value = true 
&#9;end 

&#9;while #game.Players:GetPlayers() &lt; myGame.MinPlayers do 
&#9;&#9;if msg then 
&#9;&#9;&#9;if count &lt; 0 then 
&#9;&#9;&#9;&#9;msg.Text = &quot;Waiting for &quot; .. (myGame.MinPlayers - #game.Players:GetPlayers()) .. &quot;  more player(s)&quot;
&#9;&#9;&#9;else 
&#9;&#9;&#9;&#9;msg.Text = &quot;&quot;
&#9;&#9;&#9;end 
&#9;&#9;end 
&#9;&#9;wait(1.0)
&#9;end 
&#9;if debugMode then print(&quot;Starting 1&quot;) end 
&#9;msg.Text = &quot;BEGIN!&quot;
&#9;wait(1.5)
&#9;msg.Text = &quot;&quot;
&#9;if myGame.FreezeCharacters_BoolValue then myGame.FreezeCharacters_BoolValue.Value = false end 
&#9;myGame.Regening_Bool = false 
&#9;if myGame.Regening_BoolValue then myGame.Regening_BoolValue.Value = false end 
&#9;players = game.Players:GetPlayers()
&#9;for i = 1, #players do 
&#9;&#9;if players[i] and players[i].Character and players[i].Character:FindFirstChild(&quot;Humanoid&quot;) and players[i].Character:FindFirstChild(&quot;Torso&quot;) then 
&#9;&#9;&#9;if players[i] then players[i].Character.Torso.Anchored = false end &#9;&#9;&#9;&#9;&#9;&#9;
&#9;&#9;end 
&#9;end  
&#9;if debugMode then print(&quot;Starting 2&quot;) end 
&#9;myGame:Update()
&#9;if msg then 
&#9;&#9;msg.Text = &quot;Round over&quot;
&#9;&#9;wait(1.0)
&#9;&#9;msg.Text = &quot;&quot;
&#9;end &#9;
&#9;if myGame.FreezeCharacters_BoolValue then &#9;
&#9;&#9;myGame.FreezeCharacters_BoolValue.Value = true 
&#9;&#9;--------------------- This is another unnecessary hax, the client should just freeze your character ------------------
&#9;&#9;players = game.Players:GetPlayers()
&#9;&#9;for i = 1, #players do 
&#9;&#9;&#9;if players[i] and players[i].Character and players[i].Character:FindFirstChild(&quot;Humanoid&quot;) then 
&#9;&#9;&#9;&#9;players[i].Character.Humanoid.WalkSpeed = 0.0 
&#9;&#9;&#9;end 
&#9;&#9;end 
&#9;&#9;----------------------------------------------------------------------------------------------------------------------
&#9;end 
&#9;print(&apos;NEW DEBUG&apos;, myGame.Winners_StringValue)

&#9;if myGame.Winners_StringValue then 
&#9;&#9;print(&apos;Entering the dead zone&apos;)
&#9;&#9;local winningTeam = nil 
&#9;&#9;local winningScore = 0 
&#9;&#9;for team, teamScore in pairs(myGame.TeamScores) do 
&#9;&#9;&#9;print(team, teamScore)
&#9;&#9;&#9;if teamScore ~= 0 then -- If its 0 then don&apos;t consider it
&#9;&#9;&#9;&#9;if teamScore &gt; winningScore then 
&#9;&#9;&#9;&#9;&#9;winningTeam = team 
&#9;&#9;&#9;&#9;&#9;winningScore = teamScore
&#9;&#9;&#9;&#9;else 
&#9;&#9;&#9;&#9;&#9;if teamScore == winningScore then 
&#9;&#9;&#9;&#9;&#9;&#9;winningTeam = team 
&#9;&#9;&#9;&#9;&#9;&#9;winningScore = teamScore
&#9;&#9;&#9;&#9;&#9;end 
&#9;&#9;&#9;&#9;end 
&#9;&#9;&#9;end 
&#9;&#9;end 
&#9;&#9;print(winningTeam, &apos;BE WINNING&apos;) 
&#9;&#9;if winningTeam then 
&#9;&#9;&#9;-- This is terrible 
&#9;&#9;&#9;for _, player in pairs(Game.Players:GetPlayers()) do 
&#9;&#9;&#9;&#9;if player.TeamColor == winningTeam.TeamColor then 
&#9;&#9;&#9;&#9;&#9;RBX_BadgeService:AwardBadge(player.userId, myGame.Badges_List[&apos;Win&apos;])
&#9;&#9;&#9;&#9;end 
&#9;&#9;&#9;end 
&#9;&#9;end 
&#9;&#9;if debug then debug.Value = &quot;Awarding MVP&quot; end 
&#9;&#9;local maxScore = 0 
&#9;&#9;local mvpPlayer = nil 
&#9;&#9;if #game.Players:GetPlayers() &gt;= 10 then
&#9;&#9;&#9;if game.Workspace:FindFirstChild(&quot;MVP&quot;) then game.Workspace.MVP.Value = &quot;Finding MVP&quot; end 
&#9;&#9;&#9;for player, playerScore in pairs(myGame.PlayerScores) do 
&#9;&#9;&#9;&#9;if playerScore &gt; maxScore then 
&#9;&#9;&#9;&#9;&#9;mvpPlayer = player 
&#9;&#9;&#9;&#9;&#9;maxScore = playerScore
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;if playerScore == maxScore and playerScore ~= 0 then 
&#9;&#9;&#9;&#9;&#9;&#9;if game.Workspace:FindFirstChild(&quot;MVP&quot;) then game.Workspace.MVP.Value = &quot;Two people had the same score &quot; ..  playerScore end 
&#9;&#9;&#9;&#9;&#9;&#9;mvpPlayer = nil
&#9;&#9;&#9;&#9;&#9;end 
&#9;&#9;&#9;&#9;end 
&#9;&#9;&#9;end 
&#9;&#9;end 
&#9;&#9;if mvpPlayer then 
&#9;&#9;&#9;if myGame.MVP_ObjectValue then 
&#9;&#9;&#9;&#9;myGame.MVP_ObjectValue.Value = mvpPlayer 
&#9;&#9;&#9;&#9;myGame:AwardBadges(&quot;MVP&quot;, mvpPlayer)
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;if game.Workspace:FindFirstChild(&quot;MVP&quot;) then game.Workspace.MVP.Value = &quot;NO MVP&quot; end 
&#9;&#9;&#9;end 
&#9;&#9;end
&#9;&#9;if debug then debug.Value = &quot;Awarded MVP&quot; end &#9;&#9;
&#9;end 
&#9;if myGame.TriggerVictoryScreen_BoolValue then myGame.TriggerVictoryScreen_BoolValue.Value = true end &#9;
&#9;wait(15.0)
&#9;if myGame.TriggerVictoryScreen_BoolValue then myGame.TriggerVictoryScreen_BoolValue.Value = false end 
&#9;if debugMode then print(&quot;Starting 3&quot;) end 
&#9;-- Regen the round now
&#9;if debug then debug.Value = &quot;Regening&quot; end 
&#9;myGame:Regen()
&#9;if debug then debug.Value = &quot;Regen done&quot; end 
&#9;myGame:Start() &#9;
end 

if debug then debug.Value = &quot;After Start&quot; end 

function myGame:CountScore(humanoid)
&#9;if humanoid then 
&#9;&#9;local woPlayer = game.Players:GetPlayerFromCharacter(humanoid.Parent)
&#9;&#9;local tag = humanoid:FindFirstChild(&quot;creator&quot;)
&#9;&#9;if tag and tag.Value then 
&#9;&#9;&#9;local koPlayer = tag.Value 
&#9;&#9;&#9;if koPlayer and koPlayer:FindFirstChild(&quot;leaderstats&quot;) and koPlayer.leaderstats:FindFirstChild(&quot;Score&quot;) then 
&#9;&#9;&#9;&#9;if woPlayer and koPlayer == woPlayer then 
&#9;&#9;&#9;&#9;&#9;koPlayer.leaderstats.Score.Value = koPlayer.leaderstats.Score.Value - 1
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;koPlayer.leaderstats.Score.Value = koPlayer.leaderstats.Score.Value + 1
&#9;&#9;&#9;&#9;end 
&#9;&#9;&#9;end 
&#9;&#9;&#9;if myGame.PlayerScores[koPlayer] then 
&#9;&#9;&#9;&#9;if woPlayer and koPlayer == woPlayer then 
&#9;&#9;&#9;&#9;&#9;myGame.PlayerScores[koPlayer] = myGame.PlayerScores[koPlayer] - 1
&#9;&#9;&#9;&#9;else   
&#9;&#9;&#9;&#9;&#9;myGame.PlayerScores[koPlayer] = myGame.PlayerScores[koPlayer] + 1&#9;&#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;end 
&#9;&#9;&#9;else 
&#9;&#9;&#9;&#9;if woPlayer and koPlayer and woPlayer == koPlayer then 
&#9;&#9;&#9;&#9;&#9;myGame.PlayerScores[koPlayer] = -1
&#9;&#9;&#9;&#9;else 
&#9;&#9;&#9;&#9;&#9;myGame.PlayerScores[koPlayer] = 1
&#9;&#9;&#9;&#9;end 
&#9;&#9;&#9;end 
&#9;&#9;&#9;if koPlayer and koPlayer:IsA(&quot;Player&quot;) then
&#9;&#9;&#9;&#9;print(&quot;Counting 1&quot;)
&#9;&#9;&#9;&#9;for i = 1, #myGame.Teams do 
&#9;&#9;&#9;&#9;&#9;if tostring(koPlayer.TeamColor) == tostring(myGame.Teams[i].TeamColor) then 
&#9;&#9;&#9;&#9;&#9;&#9;myGame.Teams[i].Score = myGame.Teams[i].Score + 1
&#9;&#9;&#9;&#9;&#9;&#9;myGame.TeamScores[myGame.Teams[i]] = myGame.Teams[i].Score 
&#9;&#9;&#9;&#9;&#9;end &#9;&#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;end 
&#9;&#9;&#9;&#9;if woPlayer and myGame.KillFeed_StringValue then 
&#9;&#9;&#9;&#9;&#9;print(&quot;Counting 2&quot;)
&#9;&#9;&#9;&#9;&#9;waitForChild(tag, &quot;WeaponTag&quot;)
&#9;&#9;&#9;&#9;&#9;myGame.KillFeed_StringValue.Value = koPlayer.Name .. &quot;-&quot; .. woPlayer.Name .. &quot;,&quot; .. tag.WeaponTag.Value &#9;&#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;end 
&#9;&#9;&#9;end 
&#9;&#9;end 
&#9;end 
end 

function myGame:DressPlayerCharacter(character, teamColor, player)
&#9;if player and character and teamColor then 
&#9;&#9;if tostring(teamColor) == &quot;Bright blue&quot; then 
&#9;&#9;&#9;player.CharacterAppearance = myGame[&quot;BlueTeamCharacter&quot;][1]
&#9;&#9;else 
&#9;&#9;&#9;player.CharacterAppearance = myGame[&quot;RedTeamCharacter&quot;][1] 
&#9;&#9;end 

&#9;&#9;coroutine.resume(coroutine.create(function()&#9;&#9;&#9;
&#9;&#9;&#9;waitForChild(character, &quot;Shirt&quot;)
&#9;&#9;&#9;while tostring(player.TeamColor) ~= &quot;Bright blue&quot; and tostring(player.TeamColor) ~= &quot;Bright red&quot; do &#9;&#9;
&#9;&#9;&#9;&#9;wait()
&#9;&#9;&#9;end

&#9;&#9;&#9;waitForChild(player, &quot;CName&quot;)
&#9;&#9;&#9;local className = player.CName
&#9;&#9;&#9;if className and className.Value and myGame.ShirtAssets[className.Value] then &#9;&#9;&#9;
&#9;&#9;&#9;&#9;if tostring(player.TeamColor) == &quot;Bright blue&quot; then &#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;&#9;character.Shirt.ShirtTemplate = &quot;http://www.roblox.com/asset/?id=&quot; .. myGame.ShirtAssets[className.Value][1]
&#9;&#9;&#9;&#9;else&#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;&#9;character.Shirt.ShirtTemplate = &quot;http://www.roblox.com/asset/?id=&quot; .. myGame.ShirtAssets[className.Value][2]
&#9;&#9;&#9;&#9;end 
&#9;&#9;&#9;end
&#9;&#9;end))
&#9;end 
end



function myGame:OnCharacterAdded(character, newPlayer)
&#9;local thisHumanoid = waitForChild(character, &quot;Humanoid&quot;)
&#9;thisHumanoid.Died:connect(function() myGame:CountScore(thisHumanoid) end)
&#9;myGame:DressPlayerCharacter(character, newPlayer.TeamColor, newPlayer) -- Dress this guy! 
&#9;local thisTorso = waitForChild(character, &quot;Torso&quot;)
&#9;local teamColor = tostring(newPlayer.TeamColor)

&#9;if newPlayer and newPlayer:FindFirstChild(&quot;ShowIntro&quot;) and newPlayer.ShowIntro.Value == true then 
&#9;&#9;-- Do nothing, we are showing him intro, otherwise teleport him
&#9;else
&#9;&#9;-- This is a massive hack, setting the CFrame has issues, Why? 
&#9;&#9;if teamColor == &quot;Bright blue&quot; then &#9;&#9;&#9;&#9;&#9;&#9;
&#9;&#9;&#9;local bCh = myGame.BlueSpawnParts_Model:GetChildren() 
&#9;&#9;&#9;local eww = bCh[math.random(1, #bCh)].CFrame + Vector3.new(0, 5, 0)
&#9;&#9;&#9;while thisTorso.CFrame ~= CFrame.new(eww.p) do 
&#9;&#9;&#9;&#9;thisTorso.CFrame = CFrame.new(eww.p)
&#9;&#9;&#9;&#9;wait()
&#9;&#9;&#9;end 
&#9;&#9;else&#9;&#9;&#9;&#9;&#9;&#9;
&#9;&#9;&#9;local rCh = myGame.RedSpawnParts_Model:GetChildren()
&#9;&#9;&#9;local eww = rCh[math.random(1, #rCh)].CFrame + Vector3.new(0, 5, 0)
&#9;&#9;&#9;while thisTorso.CFrame ~= CFrame.new(eww.p) do 
&#9;&#9;&#9;&#9;thisTorso.CFrame = CFrame.new(eww.p) 
&#9;&#9;&#9;&#9;wait()
&#9;&#9;&#9;end 
&#9;&#9;end 
&#9;end

&#9;if myGame.Regening_Bool then 
&#9;&#9;thisHumanoid.WalkSpeed = 0.0
&#9;&#9;if myGame.FreezeCharacters_BoolValue then 
&#9;&#9;&#9;myGame.FreezeCharacters_BoolValue.Value = true 
&#9;&#9;end 
&#9;end 

&#9;waitForChild(character, &quot;Health&quot;)
&#9;waitForChild(character, &quot;HealthScript v3.1&quot;)
&#9;character.Health:Destroy()
&#9;character[&quot;HealthScript v3.1&quot;]:Destroy() 
&#9;game.Lighting.Health:Clone().Parent = character 
&#9;game.Lighting[&quot;HealthScript v3.1&quot;]:Clone().Parent = character 

&#9;local playerGui = waitForChild(newPlayer, &quot;PlayerGui&quot;)
&#9;playerGui.ChildAdded:connect(function(child) 
&#9;&#9;if child.Name == &quot;HealthGUI&quot; then 
&#9;&#9;&#9;child:Destroy() 
&#9;&#9;end 
&#9;end)
&#9;if playerGui:FindFirstChild(&quot;HealthGUI&quot;) then 
&#9;&#9;playerGui.HealthGUI:Destroy()     
&#9;end 

&#9;while newPlayer:FindFirstChild(&quot;Health&quot;) == nil or newPlayer:FindFirstChild(&quot;Speed&quot;) == nil do 
&#9;&#9;wait()
&#9;end 

&#9;-- Apply the class attributes, need to soldify this by doing it only on the server or the client, not both
&#9;if thisHumanoid then 
&#9;&#9;thisHumanoid.NameOcclusion = Enum.NameOcclusion.EnemyOcclusion
&#9;&#9;thisHumanoid.WalkSpeed = newPlayer.Speed.Value
&#9;&#9;thisHumanoid.MaxHealth = newPlayer.Health.Value
&#9;&#9;while thisHumanoid.Health ~= newPlayer.Health.Value do 
&#9;&#9;&#9;thisHumanoid.Health = newPlayer.Health.Value
&#9;&#9;&#9;wait()
&#9;&#9;end
&#9;end 
end 

function myGame:OnPlayerAdded(newPlayer)

&#9;-------------------------Show Intro upon Entry-----------------------------
&#9;if newPlayer:FindFirstChild(&quot;ShowIntro&quot;) == nil then 
&#9;&#9;local showIntro = Instance.new(&quot;BoolValue&quot;)
&#9;&#9;showIntro.Name = &quot;ShowIntro&quot;
&#9;&#9;showIntro.Value = true
&#9;&#9;showIntro.Parent = newPlayer&#9;&#9;&#9;&#9;
&#9;end 
&#9;---------------------------------------------------------------------------

&#9;local players = game.Players:GetPlayers()
&#9;myGame.TeamCount = {}
&#9;for i = 1, #myGame.Teams do 
&#9;&#9;if myGame.Teams[i] then &#9;&#9;&#9;
&#9;&#9;&#9;myGame.TeamCount[myGame.Teams[i]] = 0
&#9;&#9;end 
&#9;end

&#9;for i = 1, #players do 
&#9;&#9;for team, numPlayers in pairs(myGame.TeamCount) do 
&#9;&#9;&#9;if players[i].TeamColor == team.TeamColor then 
&#9;&#9;&#9;&#9;myGame.TeamCount[team] = myGame.TeamCount[team] + 1
&#9;&#9;&#9;end 
&#9;&#9;end 
&#9;end 

&#9;for team, num in pairs(myGame.TeamCount) do 
&#9;&#9;print(team, num)
&#9;end 

&#9;local teamWithMinPlayers = nil 
&#9;local teamCount = math.huge

&#9;for team, count in pairs(myGame.TeamCount) do 
&#9;&#9;if count &lt; teamCount then 
&#9;&#9;&#9;teamCount = count 
&#9;&#9;&#9;teamWithMinPlayers = team
&#9;&#9;&#9;print(&quot;TeamCount &quot; .. team.Name)
&#9;&#9;end 
&#9;end

&#9;if teamWithMinPlayers then 
&#9;&#9;print(newPlayer.TeamColor, teamWithMinPlayers, teamWithMinPlayers.TeamColor)
&#9;&#9;newPlayer.TeamColor = teamWithMinPlayers.TeamColor
&#9;&#9;myGame.TeamCount[teamWithMinPlayers] = myGame.TeamCount[teamWithMinPlayers] + 1
&#9;end 

&#9;newPlayer.CharacterAdded:connect(function(character) myGame:OnCharacterAdded(character, newPlayer) end) -- Capture the player variable, always useful 

&#9;&#9;-- leaderstats
&#9;if newPlayer:FindFirstChild(&quot;leaderstats&quot;) == nil then 
&#9;&#9;local leaderstats = Instance.new(&quot;IntValue&quot;)
&#9;&#9;leaderstats.Parent = newPlayer
&#9;&#9;leaderstats.Name = &quot;leaderstats&quot;
&#9;
&#9;&#9;local score = Instance.new(&quot;IntValue&quot;)
&#9;&#9;score.Parent = leaderstats
&#9;&#9;score.Name = &quot;Score&quot;
&#9;&#9;score.Value = 0

&#9;&#9;local captures = Instance.new(&quot;IntValue&quot;)
&#9;&#9;captures.Parent = leaderstats 
&#9;&#9;captures.Name = &quot;Captures&quot;
&#9;&#9;captures.Value = 0
&#9;&#9;
&#9;&#9;-- To crash the default Player List 
&#9;&#9;local haxStr = Instance.new(&quot;StringValue&quot;)
&#9;&#9;haxStr.Parent = leaderstats 
&#9;end
&#9;-- &#9;

&#9;while newPlayer.Character == nil do wait() end
&#9;while newPlayer.Character:FindFirstChild(&quot;Torso&quot;) == nil do wait() end
&#9;while newPlayer.Character:FindFirstChild(&quot;Humanoid&quot;) == nil do wait() end

&#9;if newPlayer:FindFirstChild(&quot;CName&quot;) == nil then &#9;&#9;
&#9;&#9;local className = Instance.new(&quot;StringValue&quot;)
&#9;&#9;className.Name = &quot;CName&quot;
&#9;&#9;className.Value = &quot;Trooper&quot;
&#9;&#9;className.Parent = newPlayer

&#9;&#9;local health = Instance.new(&quot;IntValue&quot;)&#9;&#9;
&#9;&#9;health.Name = &quot;Health&quot;
&#9;&#9;health.Value = 115
&#9;&#9;health.Parent = newPlayer

&#9;&#9;local speed = Instance.new(&quot;IntValue&quot;)&#9;&#9;
&#9;&#9;speed.Name = &quot;Speed&quot;
&#9;&#9;speed.Value = 24
&#9;&#9;speed.Parent = newPlayer
&#9;end 

&#9;if myGame.PlayerAdded_ObjectValue then 
&#9;&#9;myGame.PlayerAdded_ObjectValue.Value = newPlayer
&#9;end 

&#9;if newPlayer.CameraMode then 
&#9;&#9;newPlayer.CameraMode = Enum.CameraMode.LockFirstPerson
&#9;end 
end

function myGame:OnPlayerRemoved(player)
&#9;if myGame.PlayerRemoved_ObjectValue then 
&#9;&#9;myGame.PlayerRemoved_ObjectValue.Value = player 
&#9;end 
&#9;myGame.NumPlayers = #game.Players:GetChildren()
&#9;if myGame.PlayerScores[player] then myGame.PlayerScores[player] = nil end 
&#9;for teamColor, count in pairs(myGame.TeamCount) do 
&#9;&#9;if tostring(player.TeamColor) == tostring(teamColor) then 
&#9;&#9;&#9;myGame.TeamCount[teamColor] = myGame.TeamCount[teamColor] - 1 
&#9;&#9;end 
&#9;end 
end


-- RBX Event Listeners required for the game
game.Players.PlayerAdded:connect(function(newPlayer) myGame:OnPlayerAdded(newPlayer) end)
game.Players.PlayerRemoving:connect(function(player) myGame:OnPlayerRemoved(player) end)
-- 

myGame:Init() -- Initialize all necessary stuff for the game to start
if debug then debug.Value = &quot;Game Initialized&quot; end 
myGame:Start() -- Start the game! 

