		<Item class="LocalScript" referent="RBX2226">
			<Properties>
				<bool name="Disabled">true</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">AutoEquip</string>
				<ProtectedString name="Source">--Made by Stickmasterluke


local plr=game.Players.LocalPlayer

while true do
&#9;wait()
&#9;local chr=plr.Character
&#9;local backpack=plr:FindFirstChild(&quot;Backpack&quot;)
&#9;if chr and backpack then
&#9;&#9;local primary = backpack:FindFirstChild(&quot;PaintballGun&quot;)
&#9;&#9;if primary then
&#9;&#9;&#9;local toolfound =false
&#9;&#9;&#9;for i,v in ipairs(chr:GetChildren()) do
&#9;&#9;&#9;&#9;if v.ClassName == &quot;Tool&quot; then
&#9;&#9;&#9;&#9;&#9;toolfound=true
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;if not toolfound then&#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;primary.Handle.Anchored = true
&#9;&#9;&#9;&#9;primary.Parent = chr
&#9;&#9;&#9;&#9;wait()
&#9;&#9;&#9;&#9;primary.Handle.Anchored = false 
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end
</ProtectedString>
			</Properties>
		</Item>
