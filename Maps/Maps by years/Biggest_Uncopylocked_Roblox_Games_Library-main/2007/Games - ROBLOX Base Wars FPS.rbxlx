							</Vector3>
							<Content name="TextureId"><url>http://www.roblox.com/asset/?id=72012859</url></Content>
							<Vector3 name="VertexColor">
								<X>2</X>
								<Y>2</Y>
								<Z>2</Z>
							</Vector3>
						</Properties>
					</Item>
					<Item class="Fire" referent="RBX2625">
						<Properties>
							<Color3 name="Color">4280624426</Color3>
							<bool name="Enabled">false</bool>
							<string name="Name">Fire</string>
							<Color3 name="SecondaryColor">4278190080</Color3>
