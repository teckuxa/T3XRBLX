						<string name="Name">ZoomGui</string>
					</Properties>
					<Item class="ImageLabel" referent="RBX2601">
						<Properties>
							<bool name="Active">false</bool>
							<Color3 name="BackgroundColor3">4278190080</Color3>
							<float name="BackgroundTransparency">1</float>
							<Color3 name="BorderColor3">4279970357</Color3>
							<int name="BorderSizePixel">1</int>
							<bool name="ClipsDescendants">false</bool>
							<bool name="Draggable">false</bool>
							<Content name="Image"><url>http://www.roblox.com/asset/?id=72002022</url></Content>
							<string name="Name">Scope</string>
							<UDim2 name="Position">
								<XS>0.5</XS>
								<XO>-10</XO>
								<YS>0</YS>
								<YO>-10</YO>
							</UDim2>
							<UDim2 name="Size">
								<XS>0</XS>
								<XO>20</XO>
								<YS>0</YS>
								<YO>20</YO>
							</UDim2>
							<token name="SizeConstraint">0</token>
							<bool name="Visible">true</bool>
