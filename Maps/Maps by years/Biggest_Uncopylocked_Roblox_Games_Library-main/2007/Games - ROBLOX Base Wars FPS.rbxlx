				</Item>
			</Item>
			<Item class="Tool" referent="RBX2551">
				<Properties>
					<bool name="CanBeDropped">false</bool>
					<bool name="Enabled">true</bool>
					<CoordinateFrame name="Grip">
						<X>-1</X>
						<Y>-0.75</Y>
						<Z>0.25</Z>
						<R00>0</R00>
						<R01>0</R01>
						<R02>1</R02>
						<R10>0</R10>
						<R11>1</R11>
						<R12>-0</R12>
						<R20>-1</R20>
						<R21>0</R21>
						<R22>-0</R22>
					</CoordinateFrame>
					<string name="Name">Rocket Launcher</string>
					<Content name="TextureId"><null></null></Content>
					<string name="ToolTip"></string>
				</Properties>
				<Item class="Script" referent="RBX2552">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">--Stickmasterluke


sp=script.Parent


rocketspeed=60
blastradius=8
blastdamage=70
explosiontype=0


function waitfor(a,b)
&#9;while a:FindFirstChild(b)==nil do
&#9;&#9;wait()
&#9;end
end
waitfor(sp,&quot;Aim&quot;)
waitfor(sp,&quot;Handle&quot;)
local debris=game:GetService(&quot;Debris&quot;)

function findplr()
&#9;if sp.Parent~=nil then
&#9;&#9;if sp.Parent.Name==&quot;Backpack&quot; then
&#9;&#9;&#9;plr=sp.Parent.Parent
&#9;&#9;else
&#9;&#9;&#9;plr=game.Players:GetPlayerFromCharacter(sp.Parent)
&#9;&#9;end
&#9;end
&#9;if plr then
&#9;&#9;if plr.ClassName==&quot;Player&quot; then
&#9;&#9;&#9;return plr
&#9;&#9;end
&#9;end
&#9;return
end

function rayignorecheck(hit3)
&#9;if hit3 then
&#9;&#9;if hit3.Transparency&gt;=1 or string.lower(hit3.Name)==&quot;water&quot; or hit3.Name==&quot;Effect&quot; or hit3.Name==&quot;Rocket&quot; or hit3.Name==&quot;Handle&quot; or hit3:IsDescendantOf(sp.Parent) then
&#9;&#9;&#9;return true
&#9;&#9;end
&#9;end
&#9;return false
end

function tagHumanoid(humanoid,player,didheadshot)
&#9;if humanoid and player then 
&#9;&#9;for i,v in ipairs(humanoid:GetChildren()) do
&#9;&#9;&#9;if v and v.Parent~=nil then
&#9;&#9;&#9;&#9;if v.Name==&quot;creator&quot; then
&#9;&#9;&#9;&#9;&#9;v:remove()
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;local creatortag=Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;creatortag.Value=player
&#9;&#9;creatortag.Name=&quot;creator&quot;
&#9;&#9;local weapontag=Instance.new(&quot;StringValue&quot;)
&#9;&#9;weapontag.Name=&quot;WeaponTag&quot;
&#9;&#9;weapontag.Value=sp.Name
&#9;&#9;weapontag.Parent=creatortag
&#9;&#9;if didheadshot then
&#9;&#9;&#9;local headshottag=Instance.new(&quot;BoolValue&quot;)
&#9;&#9;&#9;headshottag.Name=&quot;HeadshotTag&quot;
&#9;&#9;&#9;headshottag.Value=true
&#9;&#9;&#9;headshottag.Parent=creatortag
&#9;&#9;end
&#9;&#9;creatortag.Parent=humanoid&#9;
&#9;&#9;debris:AddItem(creatortag,2)
&#9;end
end

function explode(bpos,brad,bdam)
&#9;local e=Instance.new(&quot;Explosion&quot;)
&#9;e.BlastPressure=0
&#9;e.BlastRadius=blastradius
&#9;e.Position=bpos
&#9;e.Parent=game.Workspace
&#9;local plr=findplr()
&#9;if plr then
&#9;&#9;for i,v in ipairs(game.Players:GetChildren()) do
&#9;&#9;&#9;local chr=v.Character
&#9;&#9;&#9;if chr then
&#9;&#9;&#9;&#9;local t=chr:FindFirstChild(&quot;Torso&quot;)
&#9;&#9;&#9;&#9;local h=chr:FindFirstChild(&quot;Humanoid&quot;)
&#9;&#9;&#9;&#9;if t and h then
&#9;&#9;&#9;&#9;&#9;if plr==nil or v==plr or v.TeamColor~=plr.TeamColor or v.Neutral or plr.Neutral then
&#9;&#9;&#9;&#9;&#9;&#9;if (t.Position-bpos).magnitude&lt;=brad and h.Health&gt;=1 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;tagHumanoid(h,findplr(),false)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;h:TakeDamage(bdam)
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;if h.Health&lt;=0 then
&#9;&#9;&#9;&#9;&#9;&#9;for i2,v2 in ipairs(chr:GetChildren()) do
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if v2.ClassName==&quot;Part&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;v2.Velocity=v2.Velocity+(t.Position-bpos).unit*100
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

function fire()
&#9;if sp.Parent~=nil then
&#9;&#9;local mh=sp.Parent:FindFirstChild(&quot;Humanoid&quot;)
&#9;&#9;if mh and mh.Health&gt;0 then
&#9;&#9;&#9;local r=Instance.new(&quot;Part&quot;)
&#9;&#9;&#9;r.Name=&quot;Rocket&quot;
&#9;&#9;&#9;r.Anchored=false
&#9;&#9;&#9;r.CanCollide=false
&#9;&#9;&#9;r.Locked=true
&#9;&#9;&#9;r.formFactor=&quot;Custom&quot;
&#9;&#9;&#9;r.Size=Vector3.new(.75,.75,4)
&#9;&#9;&#9;r.TopSurface=&quot;Smooth&quot;
&#9;&#9;&#9;r.BottomSurface=&quot;Smooth&quot;
&#9;&#9;&#9;r.BrickColor=BrickColor.new(&quot;Medium stone grey&quot;)
&#9;&#9;&#9;local plr=findplr()
&#9;&#9;&#9;if plr then
&#9;&#9;&#9;&#9;if not plr.Neutral then
&#9;&#9;&#9;&#9;&#9;r.BrickColor=plr.TeamColor
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end

&#9;&#9;&#9;local s1=Instance.new(&quot;Sound&quot;)
&#9;&#9;&#9;s1.Name=&quot;SwooshSound&quot;
&#9;&#9;&#9;s1.SoundId=&quot;rbxasset://sounds/Rocket whoosh 01.wav&quot;
&#9;&#9;&#9;s1.Volume=.5
&#9;&#9;&#9;s1.Looped=true
&#9;&#9;&#9;s1.PlayOnRemove=false
&#9;&#9;&#9;s1.Parent=r

&#9;&#9;&#9;local s2=Instance.new(&quot;Sound&quot;)
&#9;&#9;&#9;s2.Name=&quot;ExplosionSound&quot;
&#9;&#9;&#9;s2.SoundId=&quot;rbxasset://sounds/collide.wav&quot;
&#9;&#9;&#9;s2.Volume=1
&#9;&#9;&#9;s2.Looped=false
&#9;&#9;&#9;s2.PlayOnRemove=false
&#9;&#9;&#9;s2.Parent=r
&#9;&#9;&#9;s2:Stop()

&#9;&#9;&#9;local m=Instance.new(&quot;SpecialMesh&quot;)
&#9;&#9;&#9;m.MeshId=&quot;http://www.roblox.com/asset/?id=2251534&quot;
&#9;&#9;&#9;m.Scale=Vector3.new(.35,.35,.25)
&#9;&#9;&#9;m.Parent=r

&#9;&#9;&#9;local f=Instance.new(&quot;Fire&quot;)
&#9;&#9;&#9;f.Heat=5
&#9;&#9;&#9;f.Size=1
&#9;&#9;&#9;f.Parent=r

&#9;&#9;&#9;local bf=Instance.new(&quot;BodyForce&quot;)
&#9;&#9;&#9;bf.force=Vector3.new(0,r:GetMass()*196.1,0)
&#9;&#9;&#9;bf.Parent=r

&#9;&#9;&#9;local startpos=(sp.Handle.CFrame*CFrame.new(-2,0,0)).p
&#9;&#9;&#9;local vec=(sp.Aim.Value-startpos).unit
&#9;&#9;&#9;r.Velocity=vec*rocketspeed

&#9;&#9;&#9;r.Touched:connect(function(hit)
&#9;&#9;&#9;&#9;if hit and hit.Parent~=nil and r and r.Parent~=nil and r.Transparency==0 and not rayignorecheck(hit) then
&#9;&#9;&#9;&#9;&#9;continue=true
&#9;&#9;&#9;&#9;&#9;local plr=findplr()
&#9;&#9;&#9;&#9;&#9;if plr then
&#9;&#9;&#9;&#9;&#9;&#9;local hum=hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;if hum then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;local tplr=game.Players:GetPlayerFromCharacter(hit.Parent)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if tplr then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;if tplr.TeamColor==plr.TeamColor then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;continue=false
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;if hit.Name~=&quot;Handle&quot; and continue then
&#9;&#9;&#9;&#9;&#9;&#9;local swooshsound=r:FindFirstChild(&quot;SwooshSound&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;if swooshsound then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;swooshsound:Stop()
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;explode(r.Position,blastradius,blastdamage)
&#9;&#9;&#9;&#9;&#9;&#9;local explosionsound=r:FindFirstChild(&quot;ExplosionSound&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;if explosionsound then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;explosionsound:Play()
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;if r and r.Parent then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;r.Anchored=true
&#9;&#9;&#9;&#9;&#9;&#9;&#9;r.Transparency=1
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;if r and r.Parent~=nil then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;r:Remove()
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end)

&#9;&#9;&#9;r.CFrame=CFrame.new(startpos,sp.Aim.Value)
&#9;&#9;&#9;r.Parent=game.Workspace
&#9;&#9;&#9;s1:Play()
&#9;&#9;&#9;debris:AddItem(r,20)
&#9;&#9;end
&#9;end
end

sp.Aim.Changed:connect(fire)

</ProtectedString>
					</Properties>
				</Item>
