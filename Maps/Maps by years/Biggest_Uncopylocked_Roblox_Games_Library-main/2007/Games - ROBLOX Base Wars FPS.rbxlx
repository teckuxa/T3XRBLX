function changeClass(newClass)
&#9;if vPlayer then 
&#9;&#9;local className = vPlayer:FindFirstChild(&quot;CName&quot;) 
&#9;&#9;if className and newClass and className.Value ~= newClass.Name then 
&#9;&#9;&#9;className.Value = newClass.Name&#9;&#9;&#9;
&#9;&#9;&#9;if currentClassLabel then 
&#9;&#9;&#9;&#9;currentClassLabel.Parent = newClass 
&#9;&#9;&#9;end 
&#9;&#9;&#9;if classesFrame then 
&#9;&#9;&#9;&#9;classesFrame.Visible = false 
&#9;&#9;&#9;end &#9;&#9;&#9;
&#9;&#9;&#9;if classHealth then 
&#9;&#9;&#9;&#9;if newClass:FindFirstChild(&quot;HealthValue&quot;) then 
&#9;&#9;&#9;&#9;&#9;classHealth.Value = tonumber(newClass.HealthValue.Text)
&#9;&#9;&#9;&#9;end 
&#9;&#9;&#9;end 
&#9;&#9;&#9;if classSpeed then 
&#9;&#9;&#9;&#9;if newClass:FindFirstChild(&quot;SpeedValue&quot;) then 
&#9;&#9;&#9;&#9;&#9;classSpeed.Value = tonumber(newClass.SpeedValue.Text)
&#9;&#9;&#9;&#9;end 
&#9;&#9;&#9;end 
&#9;&#9;&#9;if vCharacter then vCharacter:BreakJoints() end 
&#9;&#9;end &#9;&#9;
&#9;end 
end 

