local serverFeed = gameScript.Feed
local killFeedFrame = gui.KillFeedFrame 

local feedTable = {}

local feedWeaponAssets = {}
feedWeaponAssets[&quot;Assault Rifle&quot;] = 72046571 
feedWeaponAssets[&quot;Dagger&quot;] = 72046577 
feedWeaponAssets[&quot;Baton&quot;] = 72046588 
feedWeaponAssets[&quot;Rocket Launcher&quot;] = 72046605 
feedWeaponAssets[&quot;Shotgun&quot;] = 72046613 
feedWeaponAssets[&quot;Pistol&quot;] = 72046615 
feedWeaponAssets[&quot;Sniper&quot;] = 72046620 
feedWeaponAssets[&quot;Automender&quot;] = 72046631 
feedWeaponAssets[&quot;Sub Machine Gun&quot;] = 72046645 
feedWeaponAssets[&quot;Sword&quot;] = 72046662 

for name, assetId in pairs(feedWeaponAssets) do 
&#9;game:GetService(&quot;ContentProvider&quot;):Preload(&quot;http://www.roblox.com/asset/?id=&quot; .. assetId)
end 

local feedTextLabel = Instance.new(&quot;TextLabel&quot;)
feedTextLabel.BackgroundTransparency = 1.0
feedTextLabel.Size = UDim2.new(0, 50, 0, 20)
feedTextLabel.Visible = true 
feedTextLabel.ZIndex = 1
feedTextLabel.FontSize = Enum.FontSize.Size14
feedTextLabel.Font = Enum.Font.Legacy
feedTextLabel.TextColor3 = Color3.new(221/255, 221/255, 221/255)
feedTextLabel.TextXAlignment = Enum.TextXAlignment.Left
feedTextLabel.TextYAlignment = Enum.TextYAlignment.Top

local weaponFeedIcon = Instance.new(&quot;ImageLabel&quot;)
weaponFeedIcon.Name = &quot;Weapon&quot;
weaponFeedIcon.BackgroundTransparency = 1
weaponFeedIcon.Image = &quot;http://www.roblox.com/asset/?id=70458124&quot;
weaponFeedIcon.Size = UDim2.new(0, 50, 0.2, 0)
weaponFeedIcon.ZIndex = 1 

serverFeed.Changed:connect(function()
&#9;if serverFeed and serverFeed.Value then 
&#9;&#9;local delimiter = string.find(serverFeed.Value, &quot;-&quot;)
&#9;&#9;local weaponDelimiter = string.find(serverFeed.Value, &quot;,&quot;)
&#9;&#9;local firstPlayerName = string.sub(serverFeed.Value, 1, delimiter - 1)
&#9;&#9;local secondPlayerName = string.sub(serverFeed.Value, delimiter + 1, weaponDelimiter - 1) 
&#9;&#9;local weaponName = string.sub(serverFeed.Value, weaponDelimiter + 1, string.len(serverFeed.Value))
&#9;&#9;
&#9;&#9;local firstPlayer = game.Players:FindFirstChild(firstPlayerName)
&#9;&#9;local secondPlayer = game.Players:FindFirstChild(secondPlayerName)&#9;&#9;
&#9;&#9;
&#9;&#9;if firstPlayer and secondPlayer then 
&#9;&#9;&#9;for i = 1, #feedTable do 
&#9;&#9;&#9;&#9;if feedTable[i] then 
&#9;&#9;&#9;&#9;&#9;for j = 1, #feedTable[i] do 
&#9;&#9;&#9;&#9;&#9;&#9;if feedTable[i] and feedTable[i][j] then 
&#9;&#9;&#9;&#9;&#9;&#9;&#9;feedTable[i][j].Position = feedTable[i][j].Position + UDim2.new(0, 0, -0.2, 0) 
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if feedTable[i][j].Position.Y.Scale &lt; -0.2 then 
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;feedTable[i][j]:Destroy() 
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end 
&#9;&#9;&#9;&#9;&#9;&#9;end 
&#9;&#9;&#9;&#9;&#9;end 
&#9;&#9;&#9;&#9;end 
&#9;&#9;&#9;end 

&#9;&#9;&#9;local feed = {}
&#9;&#9;&#9;local fpText = feedTextLabel:Clone()
&#9;&#9;&#9;fpText.Size = UDim2.new(0, 10 * string.len(firstPlayerName), 0.2, 0)
&#9;&#9;&#9;fpText.Position = UDim2.new(0, 0, 0.8, 0)
&#9;&#9;&#9;fpText.TextColor3 = firstPlayer.TeamColor.Color 
&#9;&#9;&#9;fpText.Text = firstPlayerName
&#9;&#9;&#9;fpText.Parent = killFeedFrame &#9;&#9;&#9;

&#9;&#9;&#9;local weaponIcon = weaponFeedIcon:Clone()
&#9;&#9;&#9;weaponIcon.Position = UDim2.new(0, fpText.Size.X.Offset + 20, 0.8, 0)
&#9;&#9;&#9;weaponIcon.Parent = killFeedFrame
&#9;&#9;&#9;
&#9;&#9;&#9;if weaponName then 
&#9;&#9;&#9;&#9;--[[for name, assetId in pairs(feedWeaponAssets) do 
&#9;&#9;&#9;&#9;&#9;if weaponName == name then
&#9;&#9;&#9;&#9;&#9;&#9;weaponIcon.Image = &quot;http://www.roblox.com/asset/?id=70458420&quot;
&#9;&#9;&#9;&#9;&#9;end 
&#9;&#9;&#9;&#9;end]]
&#9;&#9;&#9;&#9;if feedWeaponAssets[weaponName] then 
&#9;&#9;&#9;&#9;&#9;weaponIcon.Image = &quot;http://www.roblox.com/asset/?id=&quot; .. feedWeaponAssets[weaponName]
&#9;&#9;&#9;&#9;end 
&#9;&#9;&#9;end 
&#9;
&#9;&#9;&#9;local spText = feedTextLabel:Clone()
&#9;&#9;&#9;spText.Size = UDim2.new(0, 12 * string.len(secondPlayerName), 0.2, 0) 
&#9;&#9;&#9;spText.Position = UDim2.new(0, weaponIcon.Position.X.Offset + weaponIcon.Size.X.Offset + 20,  0.8, 0) 
&#9;&#9;&#9;spText.TextColor3 = secondPlayer.TeamColor.Color
&#9;&#9;&#9;spText.Text = secondPlayerName
&#9;&#9;&#9;spText.Parent = killFeedFrame &#9;
&#9;&#9;&#9;
&#9;&#9;&#9;table.insert(feed, fpText) 
&#9;&#9;&#9;table.insert(feed, spText)
&#9;&#9;&#9;table.insert(feed, weaponIcon) 
&#9;&#9;&#9;table.insert(feedTable, feed)&#9;

&#9;&#9;&#9;debris:AddItem(fpText, 30)
&#9;&#9;&#9;debris:AddItem(weaponIcon, 30)
&#9;&#9;&#9;debris:AddItem(spText, 30)
&#9;&#9;end 
&#9;end 
end) 

-------------------------------------------------------------------------------------------

while true do &#9;
&#9;if rTeam and bTeam then &#9;&#9;
&#9;&#9;if rTeam.Score ~= rPrev then 
&#9;&#9;&#9;rNum = {}
&#9;&#9;&#9;-- Update score
&#9;&#9;&#9;local score = rTeam.Score 
&#9;&#9;&#9;rPrev = score 
&#9;&#9;&#9;while score &gt;= 1 do 
&#9;&#9;&#9;&#9;local remainder = score%10 
&#9;&#9;&#9;&#9;score = (score - remainder)/10
&#9;&#9;&#9;&#9;table.insert(rNum, remainder)
&#9;&#9;&#9;end
&#9;&#9;&#9;if rNum[1] then 
&#9;&#9;&#9;&#9;rUnits.Image = &quot;http://www.roblox.com/asset/?id=&quot; .. redNumberImages[rNum[1] + 1] 
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;rUnits.Image = &quot;http://www.roblox.com/asset/?id=69446386&quot;
&#9;&#9;&#9;end

&#9;&#9;&#9;if rNum[2] then 
&#9;&#9;&#9;&#9;rTens.Image = &quot;http://www.roblox.com/asset/?id=&quot; .. redNumberImages[rNum[2] + 1] 
&#9;&#9;&#9;else 
&#9;&#9;&#9;&#9;rTens.Image = &quot;http://www.roblox.com/asset/?id=69446386&quot;
&#9;&#9;&#9;end 

&#9;&#9;&#9;if rNum[3] then 
&#9;&#9;&#9;&#9;rHundreds.Image = &quot;http://www.roblox.com/asset/?id=&quot; .. redNumberImages[rNum[3] + 1] 
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;rHundreds.Image = &quot;http://www.roblox.com/asset/?id=69446386&quot;
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;if bTeam.Score ~= bPrev then 
&#9;&#9;&#9;-- Update score
&#9;&#9;&#9;bNum = {}
&#9;&#9;&#9;local score = bTeam.Score 
&#9;&#9;&#9;bPrev = score 
&#9;&#9;&#9;while score &gt;= 1 do 
&#9;&#9;&#9;&#9;local remainder = score%10
&#9;&#9;&#9;&#9;score = (score - remainder)/10
&#9;&#9;&#9;&#9;table.insert(bNum, remainder)
&#9;&#9;&#9;end
&#9;&#9;&#9;if bNum[1] then 
&#9;&#9;&#9;&#9;bUnits.Image = &quot;http://www.roblox.com/asset/?id=&quot; .. blueNumberImages[bNum[1] + 1] 
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;bUnits.Image = &quot;http://www.roblox.com/asset/?id=69406937&quot;
&#9;&#9;&#9;end

&#9;&#9;&#9;if bNum[2] then 
&#9;&#9;&#9;&#9;bTens.Image = &quot;http://www.roblox.com/asset/?id=&quot; .. blueNumberImages[bNum[2] + 1] 
&#9;&#9;&#9;else 
&#9;&#9;&#9;&#9;bTens.Image = &quot;http://www.roblox.com/asset/?id=69406937&quot;
&#9;&#9;&#9;end 

&#9;&#9;&#9;if bNum[3] then 
&#9;&#9;&#9;&#9;bHundreds.Image = &quot;http://www.roblox.com/asset/?id=&quot; .. blueNumberImages[bNum[3] + 1] 
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;bHundreds.Image = &quot;http://www.roblox.com/asset/?id=69406937&quot;
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;if regening and regening.Value == false and remainingTime then
&#9;&#9;&#9;if tPrev ~= remainingTime.Value then&#9;&#9;&#9;
&#9;&#9;&#9;&#9;timeFrame.Visible = true
&#9;&#9;&#9;&#9;local currentTime = remainingTime.Value 
&#9;&#9;&#9;&#9;tPrev = currentTime
&#9;&#9;&#9;&#9;tNum = {}
&#9;&#9;&#9;&#9;local minutes = math.floor(currentTime/60)&#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;currentTime = currentTime - (minutes * 60)&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;while currentTime &gt;= 1 do 
&#9;&#9;&#9;&#9;&#9;local remainder = currentTime%10
&#9;&#9;&#9;&#9;&#9;currentTime = (currentTime -  remainder)/10
&#9;&#9;&#9;&#9;&#9;table.insert(tNum, remainder)
&#9;&#9;&#9;&#9;end&#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;if tNum[1] then 
&#9;&#9;&#9;&#9;&#9;tUnits.Image = &quot;http://www.roblox.com/asset/?id=&quot; .. timeNumberImages[tNum[1] + 1]
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;tUnits.Image = &quot;http://www.roblox.com/asset/?id=69406674&quot;
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;if tNum[2] then 
&#9;&#9;&#9;&#9;&#9;tTens.Image = &quot;http://www.roblox.com/asset/?id=&quot; ..timeNumberImages[tNum[2] + 1]
&#9;&#9;&#9;&#9;else 
&#9;&#9;&#9;&#9;&#9;tTens.Image = &quot;http://www.roblox.com/asset/?id=69406674&quot;
&#9;&#9;&#9;&#9;end&#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;if minutes then 
&#9;&#9;&#9;&#9;&#9;tHundreds.Image = &quot;http://www.roblox.com/asset/?id=&quot; .. timeNumberImages[minutes + 1]
&#9;&#9;&#9;&#9;else 
&#9;&#9;&#9;&#9;&#9;tHundreds.Image = &quot;http://www.roblox.com/asset/?id=69406674&quot;
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;else &#9;&#9;
&#9;&#9;&#9;timeFrame.Visible = false
&#9;&#9;end
&#9;end
&#9;if miniPlayer and mapFrame then 
&#9;&#9;if vPlayer and vPlayer.Character then 
&#9;&#9;&#9;local torso = vPlayer.Character:FindFirstChild(&quot;Torso&quot;)
&#9;&#9;&#9;if torso then &#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;miniPlayer.Position = UDim2.new(1 - ((506 + torso.Position.Z)/1012) + (0.05 * ((506 + torso.Position.Z)/1012)), -4, (506 + torso.Position.X)/1048 - (0.08 * (524 + torso.Position.X)/1048) , -4)
&#9;&#9;&#9;end 
&#9;&#9;end 
&#9;end 
&#9;wait() 
end

 


