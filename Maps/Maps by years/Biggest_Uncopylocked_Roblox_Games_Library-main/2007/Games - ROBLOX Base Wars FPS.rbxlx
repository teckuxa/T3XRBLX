&#9;&#9;else 
&#9;&#9;&#9;-- Blue Team has it 
&#9;&#9;&#9;ctpImg.Image = &quot;http://www.roblox.com/asset/?id=69449316&quot;
&#9;&#9;end 
&#9;end 
end 

