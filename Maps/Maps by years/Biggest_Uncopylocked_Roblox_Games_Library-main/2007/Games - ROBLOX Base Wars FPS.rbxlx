local inactiveIconSize = UDim2.new(0, 49, 0, 58)
local activeIconSize = UDim2.new(0, 66, 0, 88)
local originIconPos = UDim2.new(0, 33, 1, -88)

local redTeamThumbnailImages = {72049258, 72049274, 72049281, 72049290, 72049299} 

function scrollClassesFrame(myClassFrame, index)
&#9;local median
&#9;local iconSpacing = &quot;Center&quot;
&#9;if classesTable and myClassFrame then
&#9;&#9;if classesTable[index] and classesTable[index].Name == myClassFrame.Name then
&#9;&#9;&#9;if index &gt; 1 and index &lt; #classesTable then 
&#9;&#9;&#9;&#9;median = index - 1 
&#9;&#9;&#9;&#9;iconSpacing = &quot;Center&quot;
&#9;&#9;&#9;elseif index == 1 then 
&#9;&#9;&#9;&#9;median = index 
&#9;&#9;&#9;&#9;iconSpacing = &quot;Right&quot;
&#9;&#9;&#9;elseif index == #classesTable then &#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;median = index - 2
&#9;&#9;&#9;&#9;iconSpacing = &quot;Left&quot;
&#9;&#9;&#9;end
&#9;&#9;&#9;print(#classesTable)
&#9;&#9;&#9;for m = 1, #classesTable do 
&#9;&#9;&#9;&#9;print(classesTable[m])
&#9;&#9;&#9;end 
&#9;&#9;&#9;for i = 1, #classesTable do 
&#9;&#9;&#9;&#9;local diff = i - median&#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;classesTable[i]:TweenPosition(originClassFramePos + UDim2.new(0.320 * diff, 0, 0, 0), 1, 3, 1, true )
&#9;&#9;&#9;end 
&#9;&#9;&#9;
&#9;&#9;&#9;for j = 1, #classesIconTable do 
&#9;&#9;&#9;&#9;if iconSpacing == &quot;Center&quot; and (j == index-1 or j == index or j == index + 1) then 
&#9;&#9;&#9;&#9;&#9;classesIconTable[j].Size = activeIconSize 
&#9;&#9;&#9;&#9;&#9;classesIconTable[j].ActiveLabel.Visible = true 
&#9;&#9;&#9;&#9;elseif iconSpacing == &quot;Right&quot; and (j == index + 1 or j == index or j == index + 2) then 
&#9;&#9;&#9;&#9;&#9;classesIconTable[j].Size = activeIconSize 
&#9;&#9;&#9;&#9;&#9;classesIconTable[j].ActiveLabel.Visible = true 
&#9;&#9;&#9;&#9;elseif iconSpacing == &quot;Left&quot; and (j == index or  j == index - 1 or j == index - 2) then 
&#9;&#9;&#9;&#9;&#9;classesIconTable[j].Size = activeIconSize 
&#9;&#9;&#9;&#9;&#9;classesIconTable[j].ActiveLabel.Visible = true 
&#9;&#9;&#9;&#9;else 
&#9;&#9;&#9;&#9;&#9;classesIconTable[j].Size = inactiveIconSize &#9;&#9;
&#9;&#9;&#9;&#9;&#9;classesIconTable[j].ActiveLabel.Visible = false
&#9;&#9;&#9;&#9;end 
&#9;&#9;&#9;&#9;if classesIconTable[j-1]  then 
&#9;&#9;&#9;&#9;&#9;print(classesIconTable[j].ClassName)
&#9;&#9;&#9;&#9;&#9;classesIconTable[j].Position = UDim2.new(0, classesIconTable[j-1].Position.X.Offset + classesIconTable[j-1].Size.X.Offset + 8, 1, -classesIconTable[j].Size.Y.Offset)
&#9;&#9;&#9;&#9;else 
&#9;&#9;&#9;&#9;&#9;classesIconTable[j].Position = UDim2.new(0, 33, 1, -classesIconTable[j].Size.Y.Offset)
&#9;&#9;&#9;&#9;end 
&#9;&#9;&#9;end 
&#9;&#9;end 
 &#9;end &#9;
end 

for i = 1, #classesIconTable do 
&#9;waitForChild(classesIconTable[i], &quot;Icon&quot;)
&#9;local myClass = classesIconTable[i]
&#9;classesIconTable[i].Icon.MouseEnter:connect(function() scrollClassesFrame(myClass, i) end)&#9;
end 

