&#9;&#9;&#9;&#9;&#9;captureCPName2.Parent = captureFeedFrame
&#9;&#9;&#9;&#9;&#9;captureCPName2.Visible = true
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;debris:AddItem(captureText, 30)
