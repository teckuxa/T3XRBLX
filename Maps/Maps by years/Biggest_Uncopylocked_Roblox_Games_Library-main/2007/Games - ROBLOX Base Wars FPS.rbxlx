				<Item class="Script" referent="RBX2472">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">BangScript</string>
						<ProtectedString name="Source">--Stickmasterluke


sp=script.Parent

smoke=false
flash=true


sp.Touched:connect(function(hit)
&#9;if hit and hit.Parent~=nil then
&#9;&#9;if hit.Name~=&quot;Handle&quot; and hit.Parent:FindFirstChild(&quot;Humanoid&quot;)==nil then
&#9;&#9;&#9;sp.Velocity=sp.Velocity*.75
&#9;&#9;end
&#9;end
end)

local HitSound=Instance.new(&quot;Sound&quot;)
HitSound.SoundId=&quot;http://www.roblox.com/asset/?id=16976189&quot;
HitSound.Parent=sp
HitSound.Volume=1

wait(2)

sp.Anchored=true
sp.CanCollide=false
sp.Transparency=1
sp.CFrame=CFrame.new(sp.Position)
HitSound:Play()
if flash then
&#9;local plrtag=sp:FindFirstChild(&quot;creator&quot;)
&#9;if plrtag then
&#9;&#9;plr=plrtag.Value
&#9;&#9;if plr then
&#9;&#9;&#9;teamcolor=plr.TeamColor
&#9;&#9;end
&#9;end
&#9;for i,v in ipairs(game.Players:GetChildren()) do
&#9;&#9;local chr=v.Character
&#9;&#9;local gui=v:FindFirstChild(&quot;PlayerGui&quot;)
&#9;&#9;if chr and gui then
&#9;&#9;&#9;if teamcolor==nil or v.TeamColor~=teamcolor or v.Neutral or (plr and plr==v) then
&#9;&#9;&#9;&#9;local flashgui=Instance.new(&quot;ScreenGui&quot;)
&#9;&#9;&#9;&#9;flashgui.Name=&quot;FlashGui&quot;
&#9;&#9;&#9;&#9;local cover=Instance.new(&quot;Frame&quot;)
&#9;&#9;&#9;&#9;cover.Name=&quot;Cover&quot;
&#9;&#9;&#9;&#9;cover.Visible=false
&#9;&#9;&#9;&#9;cover.BackgroundColor3=Color3.new(1,1,1)
&#9;&#9;&#9;&#9;cover.Size=UDim2.new(1,20,1,20)
&#9;&#9;&#9;&#9;cover.Position=UDim2.new(0,-10,0,-10)
&#9;&#9;&#9;&#9;cover.Parent=flashgui
&#9;&#9;&#9;&#9;local bangpos=Instance.new(&quot;Vector3Value&quot;)
&#9;&#9;&#9;&#9;bangpos.Name=&quot;BangPos&quot;
&#9;&#9;&#9;&#9;bangpos.Value=sp.Position
&#9;&#9;&#9;&#9;bangpos.Parent=flashgui
&#9;&#9;&#9;&#9;local flashscript=script.FlashScript:Clone()
&#9;&#9;&#9;&#9;flashscript.Parent=flashgui
&#9;&#9;&#9;&#9;flashscript.Disabled=false
&#9;&#9;&#9;&#9;flashgui.Parent=gui
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end
if smoke then
&#9;local s=Instance.new(&quot;Smoke&quot;)
&#9;s.RiseVelocity=10
&#9;s.Opacity=.75
&#9;s.Size=100
&#9;s.Parent=sp
&#9;wait(20)
&#9;sp.Parent=nil
else
&#9;wait(1)
&#9;sp.Parent=nil
end
</ProtectedString>
					</Properties>
					<Item class="LocalScript" referent="RBX2473">
						<Properties>
							<bool name="Disabled">true</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">FlashScript</string>
							<ProtectedString name="Source">--Stickmasterluke


sp=script.Parent

blindtime=5
flashrange=100

rate=1/30

function rayignorecheck(hit3)
&#9;if hit3 and hit3.Parent then
&#9;&#9;if hit3.Transparency&gt;=1 or string.lower(hit3.Name)==&quot;water&quot; or hit3.Name==&quot;Effect&quot; or hit3.Name==&quot;Handle&quot; or hit3.Parent:FindFirstChild(&quot;Humanoid&quot;) then
&#9;&#9;&#9;return true
&#9;&#9;end
&#9;end
&#9;return false
end

function raycast(spos,vec,dist)
&#9;local hit2,pos2=game.Workspace:FindPartOnRay(Ray.new(spos+(vec*.01),vec*dist),sp)
&#9;if hit2~=nil and pos2 then
&#9;&#9;local dist2=dist-(pos2-spos).magnitude
&#9;&#9;if rayignorecheck(hit2) and dist2&gt;0 then
&#9;&#9;&#9;return raycast(pos2,vec,dist2)
&#9;&#9;end
&#9;end
&#9;return hit2,pos2
end

function waitfor(a,b)
&#9;local c=a:FindFirstChild(b)
&#9;while c==nil do
&#9;&#9;wait()
&#9;end
&#9;return c
end

pos=waitfor(sp,&quot;BangPos&quot;)
cover=waitfor(sp,&quot;Cover&quot;)

plr=game.Players.LocalPlayer
while plr==nil do
&#9;wait()
&#9;plr=game.Players.LocalPlayer
end

local chr=plr.Character
if chr then
&#9;local cam=game.Workspace.CurrentCamera
&#9;if cam then
&#9;&#9;local dist=(cam.CoordinateFrame.p-pos.Value).magnitude
&#9;&#9;if dist&lt;=flashrange then
&#9;&#9;&#9;local v1=(cam.CoordinateFrame.p-pos.Value).unit
&#9;&#9;&#9;local hit,pos=raycast(pos.Value,v1,dist)
&#9;&#9;&#9;if hit==nil then
&#9;&#9;&#9;&#9;if v1:Dot(-cam.CoordinateFrame.lookVector.unit)&gt;math.cos(math.rad(104/2)) then
&#9;&#9;&#9;&#9;&#9;cover.Visible=true
&#9;&#9;&#9;&#9;&#9;wait(blindtime)
&#9;&#9;&#9;&#9;&#9;local frames=blindtime/rate
&#9;&#9;&#9;&#9;&#9;for frame=1,frames do
&#9;&#9;&#9;&#9;&#9;&#9;cover.BackgroundTransparency=frame/frames
&#9;&#9;&#9;&#9;&#9;&#9;wait(rate)
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end
sp:remove()

</ProtectedString>
						</Properties>
					</Item>
				</Item>
				<Item class="LocalScript" referent="RBX2474">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Local Gui</string>
						<ProtectedString name="Source">--Stickmasterluke


sp=script.Parent

ammo=1


ready=true
loaded=true
equipped=false

function waitfor(a,b)
&#9;while a:FindFirstChild(b)==nil do
&#9;&#9;wait()
&#9;end
end

waitfor(sp,&quot;Handle&quot;)

local g=sp.Handle:Clone()

function checkammo()
&#9;if ammo&lt;=0 then
&#9;&#9;sp:remove()
&#9;end
end

function randomnumber()
&#9;return (math.random()*2)-1
end

function fire(v)
&#9;local t=sp.Parent:FindFirstChild(&quot;Torso&quot;)
&#9;local h=sp.Parent:FindFirstChild(&quot;Humanoid&quot;)
&#9;local handle=sp:FindFirstChild(&quot;Handle&quot;)
&#9;if equipped and t and h and h.Health&gt;0 and handle then
&#9;&#9;t[&quot;Right Shoulder&quot;].MaxVelocity=0.7
&#9;&#9;t[&quot;Right Shoulder&quot;].DesiredAngle=3.6
&#9;&#9;wait(.1)
&#9;&#9;local t=sp.Parent:FindFirstChild(&quot;Torso&quot;)
&#9;&#9;local h=sp.Parent:FindFirstChild(&quot;Humanoid&quot;)
&#9;&#9;if equipped and t and h and h.Health&gt;0 then
&#9;&#9;&#9;t[&quot;Right Shoulder&quot;].MaxVelocity=10
&#9;&#9;&#9;sp.Handle.Transparency=1
&#9;&#9;&#9;sp.Handle.Fire:play()
&#9;&#9;&#9;local head=sp.Parent:findFirstChild(&quot;Head&quot;)
&#9;&#9;&#9;if head==nil then return end
&#9;&#9;&#9;ammo=ammo-1
&#9;&#9;&#9;local launch=handle.CFrame.p+(v*3)--head.Position+5*v
&#9;&#9;&#9;local missile=g:Clone()
&#9;&#9;&#9;missile.CFrame=CFrame.new(launch,launch+v)
&#9;&#9;&#9;missile.Velocity=v*80
&#9;&#9;&#9;missile.RotVelocity=Vector3.new(randomnumber()*10,randomnumber()*10,randomnumber()*10)
&#9;&#9;&#9;local force=Instance.new(&quot;BodyForce&quot;)
&#9;&#9;&#9;force.force=Vector3.new(0,30,0)
&#9;&#9;&#9;force.Parent=missile
&#9;&#9;&#9;local ps=sp.BangScript:Clone()
&#9;&#9;&#9;ps.Parent=missile
&#9;&#9;&#9;ps.Disabled=false
&#9;&#9;&#9;local creator_tag=Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;&#9;creator_tag.Value=game.Players.LocalPlayer
&#9;&#9;&#9;creator_tag.Name=&quot;creator&quot;
&#9;&#9;&#9;creator_tag.Parent=missile
&#9;&#9;&#9;missile.Parent=game.Workspace
&#9;&#9;&#9;checkammo()
&#9;&#9;end
&#9;end
end

function clicked()
&#9;if ready then
&#9;&#9;ready=false
&#9;&#9;local character=sp.Parent;
&#9;&#9;local humanoid=character:FindFirstChild(&quot;Humanoid&quot;)
&#9;&#9;if humanoid==nil then
&#9;&#9;&#9;return 
&#9;&#9;end
&#9;&#9;local targetPos=humanoid.TargetPoint
&#9;&#9;local lookAt=(targetPos-character.Head.Position).unit
&#9;&#9;fire(lookAt)
&#9;&#9;wait(3)
&#9;&#9;if sp and sp.Parent~=nil then
&#9;&#9;&#9;local t=sp.Parent:FindFirstChild(&quot;Torso&quot;)
&#9;&#9;&#9;local h=sp.Parent:FindFirstChild(&quot;Humanoid&quot;)
&#9;&#9;&#9;if equipped and t and h and h.Health&gt;0 then
&#9;&#9;&#9;&#9;t[&quot;Right Shoulder&quot;].MaxVelocity=10
&#9;&#9;&#9;&#9;t[&quot;Right Shoulder&quot;].DesiredAngle=0
&#9;&#9;&#9;end
&#9;&#9;&#9;wait(.1)
&#9;&#9;&#9;sp.Handle.Transparency=0
&#9;&#9;&#9;ready=true
&#9;&#9;end
&#9;end
end

function onEquipped(mouse)
&#9;checkammo()
&#9;equipped=true
&#9;if mouse~=nil then
&#9;&#9;mouse.Icon=&quot;rbxasset://textures\\GunCursor.png&quot;
&#9;&#9;mouse.Button1Down:connect(clicked)
&#9;end
&#9;local t=sp.Parent:FindFirstChild(&quot;Torso&quot;)
&#9;local h=sp.Parent:FindFirstChild(&quot;Humanoid&quot;)
&#9;if t and h and h.Health&gt;0 then
&#9;&#9;t[&quot;Right Shoulder&quot;].MaxVelocity=10
&#9;&#9;t[&quot;Right Shoulder&quot;].DesiredAngle=0
&#9;end
end

function onUnequipped()
&#9;equipped=false
end

sp.Equipped:connect(onEquipped)
sp.Unequipped:connect(onUnequipped)

</ProtectedString>
					</Properties>
