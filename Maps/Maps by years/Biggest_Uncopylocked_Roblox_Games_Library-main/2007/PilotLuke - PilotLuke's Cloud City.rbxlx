					<string name="Name">Script</string>
					<string name="Source">local brick = script.Parent&#13;&#10;&#13;&#10;while true do&#13;&#10;&#13;&#10;&#9;wait(math.random(2, 5))&#13;&#10;&#9;&#9;brick.Transparency = 0.1&#13;&#10;&#9;wait(0.1)&#13;&#10;&#9;&#9;brick.Transparency = 0.2&#13;&#10;&#9;wait(0.1)&#13;&#10;&#9;&#9;brick.Transparency = 0.3&#13;&#10;&#9;wait(0.1)&#13;&#10;&#9;&#9;brick.Transparency = 0.4&#13;&#10;&#9;wait(0.1)&#13;&#10;&#9;&#9;brick.Transparency = 0.5&#13;&#10;&#9;wait(0.1)&#13;&#10;&#9;&#9;brick.Transparency = 0.6&#13;&#10;&#9;wait(0.1)&#13;&#10;&#9;&#9;brick.Transparency = 0.7&#13;&#10;&#9;wait(0.1)&#13;&#10;&#9;&#9;brick.Transparency = 0.8&#13;&#10;&#9;wait(0.1)&#13;&#10;&#9;&#9;brick.Transparency = 0.9&#13;&#10;&#9;wait(0.1)&#13;&#10;&#9;&#9;brick.Transparency = 1&#13;&#10;&#9;&#9;brick.CanCollide = false&#13;&#10;&#9;wait(3)&#13;&#10;&#9;&#9;brick.Transparency = 0.9&#13;&#10;&#9;wait(0.1)&#13;&#10;&#9;&#9;brick.Transparency = 0.8&#13;&#10;&#9;wait(0.1)&#13;&#10;&#9;&#9;brick.Transparency = 0.7&#13;&#10;&#9;wait(0.1)&#13;&#10;&#9;&#9;brick.Transparency = 0.6&#13;&#10;&#9;wait(0.1)&#13;&#10;&#9;&#9;brick.Transparency = 0.5&#13;&#10;&#9;wait(0.1)&#13;&#10;&#9;&#9;brick.Transparency = 0.4&#13;&#10;&#9;wait(0.1)&#13;&#10;&#9;&#9;brick.Transparency = 0.3&#13;&#10;&#9;wait(0.1)&#13;&#10;&#9;&#9;brick.Transparency = 0.2&#13;&#10;&#9;wait(0.1)&#13;&#10;&#9;&#9;brick.Transparency = 0.1&#13;&#10;&#9;wait(0.1)&#13;&#10;&#9;&#9;brick.Transparency = 0&#13;&#10;&#9;&#9;brick.CanCollide = true&#13;&#10;end </string>
