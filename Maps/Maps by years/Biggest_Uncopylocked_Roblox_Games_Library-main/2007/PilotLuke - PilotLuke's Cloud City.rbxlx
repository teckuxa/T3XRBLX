		<Item class="Script" referent="RBX2847">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Script</string>
				<string name="Source">print(&quot;Day/Night Script running!&quot;)&#13;&#10;&#13;&#10;Lighting = game.Lighting.TimeOfDay&#13;&#10;&#13;&#10;while true do&#13;&#10;&#13;&#10;wait (15)&#13;&#10;&#13;&#10;Lighting = Lighting +(&quot;1:00:00&quot;)&#13;&#10;&#13;&#10;end </string>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX2848">
			<Properties>
				<bool name="Disabled">true</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Timeofday Changer</string>
				<string name="Source">l = game:service(&quot;Lighting&quot;) &#13;&#10;while true do &#13;&#10;-- increment the time of day and then wait for a while &#13;&#10;l:SetMinutesAfterMidnight(l:GetMinutesAfterMidnight()+1) &#13;&#10;wait(.5) &#13;&#10;end </string>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
