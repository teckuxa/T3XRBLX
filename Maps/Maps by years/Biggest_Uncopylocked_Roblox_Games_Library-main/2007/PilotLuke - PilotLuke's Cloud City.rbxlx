						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<string name="Source">print(&quot;Simple Secret Door Script Loaded&quot;) &#13;&#10;&#13;&#10;Door = script.Parent.Parent.ButtonDoor &#13;&#10;Button = script.Parent&#13;&#10;&#13;&#10;local debounce = false &#13;&#10;&#13;&#10;function onTouched(hit)&#13;&#10;&#9;local humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;)&#13;&#10;&#9;if humanoid~=nil and debounce == false then&#13;&#10;&#13;&#10;debounce = true&#13;&#10;&#13;&#10;print(&quot;Door Hit&quot;) &#13;&#10;Door.Transparency = 0 &#13;&#10;Door.CanCollide = true &#13;&#10;wait(.1) &#13;&#10;Door.Transparency = .1 &#13;&#10;Door.CanCollide = true &#13;&#10;wait(.1) &#13;&#10;Door.Transparency = .2 &#13;&#10;Door.CanCollide = true &#13;&#10;wait(.1) &#13;&#10;Door.Transparency = .3 &#13;&#10;Door.CanCollide = true &#13;&#10;wait(.1) &#13;&#10;Door.Transparency = .4 &#13;&#10;Door.CanCollide = true &#13;&#10;wait(.1) &#13;&#10;Door.Transparency = .5 &#13;&#10;Door.CanCollide = true &#13;&#10;wait(.1) &#13;&#10;Door.Transparency = .6 &#13;&#10;Door.CanCollide = true &#13;&#10;wait(.1) &#13;&#10;Door.Transparency = .7 &#13;&#10;Door.CanCollide = true &#13;&#10;wait(.1) &#13;&#10;Door.Transparency = .8 &#13;&#10;Door.CanCollide = true &#13;&#10;wait(.1) &#13;&#10;Door.Transparency = .9 &#13;&#10;Door.CanCollide = true &#13;&#10;wait(.1) &#13;&#10;Door.Transparency = 1 &#13;&#10;Door.CanCollide = false &#13;&#10;wait(3) &#13;&#10;Door.Transparency = .9 &#13;&#10;Door.CanCollide = true &#13;&#10;wait(.1) &#13;&#10;Door.Transparency = .8 &#13;&#10;Door.CanCollide = true &#13;&#10;wait(.1) &#13;&#10;Door.Transparency = .7 &#13;&#10;Door.CanCollide = true &#13;&#10;wait(.1) &#13;&#10;Door.Transparency = .6 &#13;&#10;Door.CanCollide = true &#13;&#10;wait(.1) &#13;&#10;Door.Transparency = .5 &#13;&#10;Door.CanCollide = true &#13;&#10;wait(.1) &#13;&#10;Door.Transparency = .4 &#13;&#10;Door.CanCollide = true &#13;&#10;wait(.1) &#13;&#10;Door.Transparency = .3 &#13;&#10;Door.CanCollide = true &#13;&#10;wait(.1) &#13;&#10;Door.Transparency = .2 &#13;&#10;Door.CanCollide = true &#13;&#10;wait(.1) &#13;&#10;Door.Transparency = .1 &#13;&#10;Door.CanCollide = true &#13;&#10;wait(.1) &#13;&#10;Door.Transparency = 0 &#13;&#10;Door.CanCollide = true &#13;&#10;&#13;&#10;debounce = false&#13;&#10;&#13;&#10;end &#13;&#10;end&#13;&#10;&#13;&#10;connection = Button.Touched:connect(onTouched) &#13;&#10;</string>
						<bool name="archivable">true</bool>
					</Properties>
