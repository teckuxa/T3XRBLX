				<Item class="Script" referent="RBX2953">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<string name="Source">print(&quot;The moneybox is running&quot;)&#13;&#10;&#13;&#10;function onTouch(part)&#13;&#10;&#9;print(&quot;Object has touched bottom of box&quot;)&#13;&#10;&#9;if part.Parent:findFirstChild(&quot;Humanoid&quot;) then return end&#13;&#10;&#9;print(&quot;Not a humanoid either&quot;)&#13;&#10;&#9;&#9;local username = game.Players:findFirstChild(part.Parent.Name)&#13;&#10;&#9;if username ~= nil then&#13;&#10;&#9;&#9;print(&quot;Money registered is &quot; .. part.Parent.Name ..&quot;&apos;s&quot;)&#13;&#10;&#9;&#9;local leader = username:findFirstChild(&quot;leaderstats&quot;)&#13;&#10;&#9;&#9;if leader ~= nil then&#13;&#10;&#9;&#9;local cash = leader:findFirstChild(&quot;Cash&quot;)&#13;&#10;&#9;&#9;if cash ~= nil then&#13;&#10;&#9;&#9;&#9;cash.Value = cash.Value +1&#13;&#10;&#9;&#9;print(&quot;User has gotten money&quot;)&#13;&#10;&#9;&#9;part.Parent:remove()&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;end&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#13;&#10;script.Parent.Touched:connect(onTouch)&#13;&#10;</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
