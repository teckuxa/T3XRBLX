			<Item class="Script" referent="RBX2443">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">OpenDoor</string>
					<string name="Source">bin = script.Parent&#13;&#10;&#13;&#10;work=game.Workspace&#13;&#10;model1 = work.DoorWay&#13;&#10;backup1=model1:clone()&#13;&#10;&#13;&#10;hold=false&#13;&#10;function onTouch(part)&#13;&#10;&#9;local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)&#13;&#10;&#9;if (h~=nil and hold~=true) then&#13;&#10;&#9;&#9;hold=true&#13;&#10;&#9;&#9;local name=h.Parent.Name&#13;&#10;&#9;&#9;if (bin.Rebels:findFirstChild(name)~=nil) then&#13;&#10;&#9;&#9;&#9;model1:remove()&#13;&#10;&#9;&#9;&#9;wait(1)&#13;&#10;&#9;&#9;&#9;model1 = backup1:clone()&#13;&#10;&#9;&#9;&#9;model1.Parent = work&#13;&#10;&#9;&#9;&#9;model1:makeJoints()&#13;&#10;&#9;&#9;end&#13;&#10;&#9;&#9;wait(0.1)&#13;&#10;&#9;&#9;hold=false&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;bin.Button.Touched:connect(onTouch)&#13;&#10;</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
