			<Item class="Script" referent="RBX2868">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<string name="Source">print(&quot;HoverTank v2.0 working!&quot;)&#13;&#10;&#13;&#10;connection = nil&#13;&#10;humanoid = nil&#13;&#10;rot = CFrame.new(0, 0, 0, 0, 0, 1, 0, 1, 0, -1, 0, 0)&#13;&#10;&#13;&#10;function attach(h)&#13;&#10;&#9;if h==humanoid then&#13;&#10;&#9;&#9;return&#13;&#10;&#9;end&#13;&#10;&#13;&#10;&#9;print(&quot;attaching to &quot; .. h.Name)&#13;&#10;&#9;humanoid = h&#13;&#10;&#9;if connection~=nil then&#13;&#10;&#9;&#9;connection:disconnect()&#13;&#10;&#9;end&#13;&#10;&#13;&#10;&#9;local torso = h.Parent.Torso&#13;&#10;&#13;&#10;&#9;script.Parent.Cockpit.CFrame = torso.CFrame * CFrame.new(Vector3.new(0,1,1)) * rot&#13;&#10;end&#13;&#10;&#13;&#10;function onTouched(part)&#13;&#10;&#9;local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)&#13;&#10;&#9;if h~=nil then&#13;&#10;&#9;&#9;attach(h)&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#13;&#10;script.Parent.Cockpit.Touched:connect(OnTouched)&#13;&#10;</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
		</Item>
