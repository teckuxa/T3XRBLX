			<Item class="Script" referent="RBX2753">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<string name="Source">function onTouched(part)&#13;&#10;&#9;if part.Parent ~= nil then&#13;&#10;&#9;&#9;local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)&#13;&#10;&#9;&#9;&#9;if h~=nil then&#13;&#10;&#9;&#9;&#9;&#9;if cantouch~=0 then&#13;&#10;&#9;&#9;&#9;&#9;&#9;--if h.Parent.Name==&quot;miked&quot; then&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;cantouch=0&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;local lleg=h.Parent:findFirstChild(&quot;Left Leg&quot;)&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;local rleg=h.Parent:findFirstChild(&quot;Right Leg&quot;)&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;local larm=h.Parent:findFirstChild(&quot;Left Arm&quot;)&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;local rarm=h.Parent:findFirstChild(&quot;Right Arm&quot;)&#13;&#10;--[[&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;h.Parent.Torso.Anchored=true&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;h.Parent.Head.Anchored=true&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;lleg.CanCollide=true&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;rleg.CanCollide=true&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;larm.Anchored=true&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;rarm.Anchored=true&#13;&#10;--]]&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;h.Parent.Torso.Size=Vector3.new(20,20,10)&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;--h.Parent.Torso.Velocity=Vector3.new(0,0,0)&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;h.Parent.Torso.CFrame=CFrame.new(41.5, 30.4, 169,-1,0,0,0,1,0,0,0,-1)&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;h.Parent.Head.Size=Vector3.new(10,10,10)&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;--h.Parent.Head.Velocity=Vector3.new(0,0,0)&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;h.Parent.Head.CFrame=CFrame.new(41.5, 45.4, 169,-1,0,0,0,1,0,0,0,-1)&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;h.Parent.Head:makeJoints(); h.Parent.Torso:makeJoints()&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;lleg.Size=Vector3.new(10, 20, 10)&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;--lleg.Velocity=Vector3.new(0,0,0)&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;lleg.CFrame=CFrame.new(46.5, 10.4, 169,-1,0,0,0,1,0,0,0,-1)&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;lleg:makeJoints(); h.Parent.Torso:makeJoints()&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;rleg.Size=Vector3.new(10, 20, 10)&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;--rleg.Velocity=Vector3.new(0,0,0)&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;rleg.CFrame=CFrame.new(36.5, 10.4, 169,-1,0,0,0,1,0,0,0,-1)&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;rleg:makeJoints(); h.Parent.Torso:makeJoints()&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;larm.Size=Vector3.new(10, 20, 10)&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;--larm.Velocity=Vector3.new(0,0,0)&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;larm.CFrame=CFrame.new(56.5, 30.4, 169,-1,0,0,0,1,0,0,0,-1)&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;larm:makeJoints(); h.Parent.Torso:makeJoints()&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;rarm.Size=Vector3.new(10, 20, 10)&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;--rarm.Velocity=Vector3.new(0,0,0)&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;rarm.CFrame=CFrame.new(26.5, 30.4, 169,-1,0,0,0,1,0,0,0,-1)&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;rarm:makeJoints(); h.Parent.Torso:makeJoints()&#9;&#9;&#9;&#9;&#9;&#9;&#13;&#10;&#13;&#10;&#9;&#9;&#9;&#9;&#9;--lleg:makeJoints()&#13;&#10;&#9;&#9;&#9;&#9;--rleg:makeJoints()&#13;&#10;&#9;&#9;&#9;--larm:makeJoints()&#13;&#10;&#9;&#9;--rarm:makeJoints()&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;h.Parent.Humanoid.MaxHealth=1000&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;h.Parent.Humanoid.Health=1000&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;wait(5)&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;cantouch=1&#13;&#10;&#9;&#9;&#9;&#9;&#9;--end&#13;&#10;&#9;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#13;&#10;script.Parent.Touched:connect(onTouched)&#13;&#10;</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
		</Item>
