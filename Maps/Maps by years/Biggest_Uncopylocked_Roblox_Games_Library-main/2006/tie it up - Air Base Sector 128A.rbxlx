		<Item class="HopperBin">
			<Properties>
				<string name="Command">ScriptHopper</string>
				<string name="Name">M&amp;J</string>
				<string name="TextureName"></string>
			</Properties>
			<Item class="Script">
				<Properties>
					<bool name="Disabled">true</bool>
					<string name="Name">FireShot</string>
					<string name="Source">&#13;&#10;fire = script.Parent&#13;&#10;damage = 100&#13;&#10;&#13;&#10;function onTouched(hit)&#13;&#10;&#9;local humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;)&#13;&#10;&#9;if humanoid~=nil then&#13;&#10;&#9;&#9;tagHumanoid(humanoid)&#13;&#10;&#9;&#9;humanoid.Health = humanoid.Health - damage&#13;&#10;&#9;&#9;wait(2)&#13;&#10;&#9;&#9;untagHumanoid(humanoid)&#13;&#10;&#9;&#9;connection:disconnect()&#13;&#10;&#9;else&#13;&#10;&#9;&#9;damage = damage / 2&#13;&#10;&#9;&#9;if damage &lt; 0.1 then&#13;&#10;&#9;&#9;&#9;connection:disconnect()&#13;&#10;&#9;&#9;end&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#13;&#10;function tagHumanoid(humanoid)&#13;&#10;&#9;-- todo: make tag expire&#13;&#10;&#9;local tag = fire:findFirstChild(&quot;creator&quot;)&#13;&#10;&#9;if tag ~= nil then&#13;&#10;&#9;&#9;local new_tag = tag:clone()&#13;&#10;&#9;&#9;new_tag.Parent = humanoid&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#13;&#10;&#13;&#10;function untagHumanoid(humanoid)&#13;&#10;&#9;if humanoid ~= nil then&#13;&#10;&#9;&#9;local tag = humanoid:findFirstChild(&quot;creator&quot;)&#13;&#10;&#9;&#9;if tag ~= nil then&#13;&#10;&#9;&#9;&#9;tag.Parent = nil&#13;&#10;&#9;&#9;end&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#13;&#10;connection = fire.Touched:connect(onTouched)&#13;&#10;&#13;&#10;r = game:service(&quot;RunService&quot;)&#13;&#10;t, s = r.Stepped:wait()&#13;&#10;d = t + 2.0 - s&#13;&#10;madeGrey = false&#13;&#10;while t &lt; d do&#13;&#10;&#9;t = r.Stepped:wait()&#13;&#10;&#9;if madeGrey == false and d-t &lt; .7 then&#13;&#10;&#9;&#9;madeGrey = true&#13;&#10;&#9;&#9;fire.BrickColor = BrickColor.new(.4,.4,.4)&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#13;&#10;fire.Parent = nil</string>
				</Properties>
			</Item>
			<Item class="Script">
				<Properties>
					<bool name="Disabled">false</bool>
					<string name="Name">ThrowerScript</string>
					<string name="Source">print(&quot;Flamethrower script loaded&quot;)&#13;&#10;&#13;&#10;bin = script.Parent&#13;&#10;&#13;&#10;shooting = false&#13;&#10;reloadtime = 0&#13;&#10;&#13;&#10;colors = {171; 173; 172} &#13;&#10;&#13;&#10;local player_name = game.Players.LocalPlayer.Name&#13;&#10;&#13;&#10;if player_name = (&quot;mattigreenplant&quot;)(&quot;creamsoda70&quot;)&#13;&#10;&#9;then function fire(v)&#13;&#10;&#13;&#10;&#9;&#9;sound = Instance.new(&quot;Sound&quot;)&#13;&#10;&#9;&#9;sound.SoundId = &quot;rbxasset://sounds\\Launching rocket.wav&quot;&#13;&#10;&#9;&#9;sound.Parent = script.Parent&#13;&#10;&#9;&#9;sound:play()&#13;&#10;&#13;&#10;&#9;&#9;local missile = Instance.new(&quot;Part&quot;)&#13;&#10;&#13;&#10;&#9;&#9;local spawnPos = game.Players.LocalPlayer.Character.PrimaryPart.Position&#13;&#10;&#9;&#9;spawnPos  = spawnPos + (v * 7)&#13;&#10;&#13;&#10;&#9;&#9;missile.Name = &quot;Fire&quot;&#13;&#10;&#13;&#10;&#9;&#9;local dx = (math.random() - .5) * 100&#13;&#10;&#9;&#9;local dy = (math.random() - .5) * 100&#13;&#10;&#9;&#9;local dz = (math.random() - .5) * 100&#13;&#10;&#13;&#10;&#9;&#9;missile.CFrame = CFrame.new(spawnPos, Vector3.new(dx,dy,dz))&#13;&#10;&#9;&#9;missile.Size = Vector3.new(1,1,1)&#13;&#10;&#9;&#9;missile.Velocity = v * 400&#13;&#10;&#9;&#9;missile.BrickColor = BrickColor.new(colors[math.random(1, 11)])&#13;&#10;&#9;&#9;missile.Shape = 2&#13;&#10;&#13;&#10;&#9;&#9;local new_script = script.Parent.FireShot:clone()&#13;&#10;&#9;&#9;new_script.Disabled = false&#13;&#10;&#9;&#9;new_script.Parent = missile&#13;&#10;&#13;&#10;&#9;&#9;local creator_tag = Instance.new(&quot;ObjectValue&quot;)&#13;&#10;&#9;&#9;creator_tag.Value = game.Players.LocalPlayer&#13;&#10;&#9;&#9;creator_tag.Name = &quot;creator&quot;&#13;&#10;&#9;&#9;creator_tag.Parent = missile&#13;&#10;&#9;&#13;&#10;&#9;&#9;missile.Parent = game.Workspace&#13;&#10;&#13;&#10;&#9;end&#13;&#10;end if&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;function onButton1Down(mouse)&#13;&#10;&#9;if humaniod.name = &quot;tie it up&quot; or &quot;spifire&quot; then&#13;&#10;&#9;&#9;if reloadtime &gt; 0 then return end&#13;&#10;&#9;&#9;if shooting == true then return end&#13;&#10;&#9;&#9;print(&quot;start shooting&quot;)&#13;&#10;&#9;&#9;reloadtime = 8.0&#13;&#10;&#9;&#9;shooting = true&#13;&#10;&#13;&#10;&#9;&#9;local time = 0&#13;&#10;&#9;&#9;while shooting == true do&#13;&#10;&#9;&#9;&#13;&#10;&#13;&#10;&#9;&#9;&#9;local cf = mouse.Hit&#13;&#10;&#9;&#9;&#9;local v = cf.lookVector&#13;&#10;&#9;&#9;&#9;local dx = (math.random() - .5) * .2&#13;&#10;&#9;&#9;&#9;local dy = (math.random() - .5) * .2&#13;&#10;&#9;&#9;&#9;local dz = (math.random() - .5) * .2&#13;&#10;&#9;&#13;&#10;&#9;&#9;&#9;fire(Vector3.new(v.x + dx, v.y + dy, v.z + dz))&#13;&#10;&#9;&#9;&#9;wait(.05)&#13;&#10;&#9;&#9;&#9;time = time + .1&#13;&#10;&#9;&#9;&#9;if time &gt; 2.0 then shooting = false end&#13;&#10;&#9;&#9;end&#13;&#10;&#13;&#10;&#9;&#9;mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot;&#13;&#10;&#9;&#9;wait(reloadtime)&#13;&#10;&#9;&#9;reloadtime = 0&#13;&#10;&#9;&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#13;&#10;function onButton1Up(mouse)&#13;&#10;&#9;shooting = false&#13;&#10;end&#13;&#10;&#13;&#10;function onSelected(mouse)&#13;&#10;&#9;print(&quot;flamethrower selected&quot;)&#13;&#10;&#9;if reloadtime &gt; 0 then&#13;&#10;&#9;&#9;mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot;&#13;&#10;&#9;else&#13;&#10;&#9;&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;&#13;&#10;&#9;end&#13;&#10;&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)&#13;&#10;&#9;mouse.Button1Up:connect(function() onButton1Up(mouse) end)&#13;&#10;end&#13;&#10;&#13;&#10;bin.Selected:connect(onSelected)&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;</string>
				</Properties>
			</Item>
		</Item>
	</Item>
