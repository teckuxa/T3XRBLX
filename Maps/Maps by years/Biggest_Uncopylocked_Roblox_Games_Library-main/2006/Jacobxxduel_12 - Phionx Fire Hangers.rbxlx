					<string name="Name">Script</string>
					<string name="Source">function attach(h)&#13;&#10;&#9;if h==humanoid then&#13;&#10;&#9;&#9;return&#13;&#10;&#9;end&#13;&#10;&#13;&#10;&#9;print(&quot;attaching to &quot; .. h.Name)&#13;&#10;&#9;humanoid = h&#13;&#10;&#9;if connection~=nil then&#13;&#10;&#9;&#9;connection:disconnect()&#13;&#10;&#9;end&#13;&#10;&#9;connection = h.Jumping:connect(onJump)&#13;&#10;&#13;&#10;&#9;local torso = h.Parent.Torso&#13;&#10;&#9;script.Parent.P1.CFrame = torso.CFrame * CFrame.new(Vector3.new(0,1,1)) * rot&#13;&#10;&#9;--script.Parent.P2:makeJoints()&#13;&#10;&#9;&#13;&#10;&#13;&#10;&#9;script.Parent.P1.CanCollide = false&#13;&#10;&#9;script.Parent.P2.CanCollide = false&#13;&#10;end&#13;&#10;&#13;&#10;</string>
